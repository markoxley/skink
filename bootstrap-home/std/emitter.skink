// LLVM IR emitter for Skink, written in Skink.
//
// This module translates a fully-typed Skink AST into LLVM IR text.
// It is a port of the Go code generator in skink-lang/compiler/codegen,
// adapted to use the self-hosted AST (std/ast) and self-hosted type
// checker (std/checker).
//
// The output is LLVM IR text that can be compiled to object code by
// llc and linked into an executable.

module emitter

import "std/ast"
import "std/str"
import "std/strconv"
import "std/checker"
import "std/fs"

// === Constants ===
// Type kind constants are imported from checker module (checker.TK_*)

// === Helper Types ===

// ArrayMeta records element-type information the emitter needs for a slice value.
pub struct ArrayMeta {
    length:     int  // the length
    elemType:   string  // the element type
    heapAlloc:  bool  // the heap allocation
}

// StructLayout maps a struct's field names to their LLVM struct indices and types.
pub struct StructLayout {
    llType:          string  // the LLVM type
    fields:          []string  // the fields
    fieldTypes:      []string  // the field types
    fieldSkinkTypes: []string  // the Skink field type names (preserves []T vs *T)
    fieldTags:       []string  // the field tags ([attr] annotations, space-joined)
    isUnsigned:      []bool  // whether unsigned
    size:            int  // the size
    alignment:       int  // the alignment
    offsets:         []int  // the offsets
    dtorFn:          string  // the destructor function
}

// LoopLabel holds the LLVM basic-block labels a loop uses for break and continue.
pub struct LoopLabel {
    continueLabel: string  // the continue label
    endLabel:       string  // the end label
    // scopeDepth is the scope depth at push time — break must release all
    // scopes deeper than this before branching to endLabel, since the
    // branch bypasses the popScope calls that would otherwise release
    // them. continueDepth is the depth of the loop that owns
    // continueLabel — for pass-through constructs (switch/select) it is
    // the enclosing loop's depth, not this statement's.
    scopeDepth:     int
    continueDepth:  int  // the continue depth
}

// ScopeVar records an in-scope variable's LLVM storage pointer, type, and ownership state.
pub struct ScopeVar {
    alloca:     string  // the alloca
    llType:     string  // the LLVM type
    isUnsigned: bool  // whether unsigned
    synType:    checker.TType  // the syn type
    borrowed:   bool  // the borrowed
    // Escaped variables (whose address is taken via `&` anywhere in the
    // function) are boxed: the value lives in an RC-managed heap block and
    // heapSlot is an alloca holding the block pointer (type llType*). All
    // value accesses must go through varValuePtr, which loads heapSlot for
    // boxed variables. Closure capture views set heapSlot with
    // borrowed=true and escaped=false (the env block owns the reference).
    escaped:    bool
    heapSlot:   string  // the heap slot
}

// ScopeV wraps a map of variable bindings for a single scope.
// Used because Skink doesn't support []map[string]X directly.
pub struct ScopeV {
    vars:  map[string]ScopeVar  // the vars
    names: []string  // the names
}

// scopeVMake creates an empty ScopeV with an initialized variable map.
fn scopeVMake() -> ScopeV {
    s := ScopeV{}
    s.vars = make(map[string]ScopeVar)
    s.names = []string{}
    return s
}

// scopeVSet sets a variable binding in a scope, tracking insertion order.
fn scopeVSet(s: *ScopeV, name: string, v: ScopeVar) {
    if name == "" {
        return
    }
    // Check if name already exists
    existing := s.vars[name]
    if str.Len(existing.llType) == 0 {
        s.names = append(s.names, name)
    }
    s.vars[name] = v
}

// scopeVGet returns the ScopeVar bound to name in a scope.
fn scopeVGet(s: *ScopeV, name: string) -> ScopeVar {
    return s.vars[name]
}

// scopeVHas reports whether a scope contains a binding for name.
fn scopeVHas(s: *ScopeV, name: string) -> bool {
    v := s.vars[name]
    return str.Len(v.llType) > 0
}

// === CodeGen Struct ===

// CodeGen carries the emitter's state while lowering a checked program to LLVM IR.
pub struct CodeGen {
    // Debug info support (LLVM DWARF metadata emission)
    dbgEnabled:        bool
    dbgDefaultLoc:     string  // the dbg default loc
    // Output buffers (using strings, rebuilt on demand)
    moduleHeader:  str.Builder
    stringGlobals: str.Builder  // the string globals
    out:           str.Builder  // the out
    spawnThunks:   str.Builder  // the spawn thunks
    anonFns:       str.Builder  // the anon fns
    // Names of functions that already have a closure-conversion thunk
    // and constant handle block emitted (emitClosureValue).
    closureThunks: map[string]bool
    arrayDtorFns:  str.Builder  // the array destructor fns
    metadata:      str.Builder  // the metadata
    // Alloca buffer: collected per-function, emitted at entry block start
    // to ensure all allocas dominate their uses (LLVM requirement).
    allocaBuffer:  str.Builder

    // Counters
    regCounter:        int
    labelCounter:      int  // the label counter
    strCounter:        int  // the string counter
    spawnThunkCounter: int  // the spawn thunk counter
    anonFnCounter:     int  // the anon function counter

    // Scoping
    // scopeVars is a growable stack of scopes; scopeDepth is the index of
    // the currently active (top) scope. We never shrink scopeVars itself
    // (slice re-slicing to truncate length does not adjust the backing
    // array's length header in the current codegen, so `s = s[0:n]` is
    // not usable for popping scopes) — instead popScope only decrements
    // scopeDepth, and pushScope reuses (by overwriting via index
    // assignment) or grows the backing array as needed.
    scopeVars:          []ScopeV
    scopeDepth:         int  // the scope depth
    terminated:         bool  // the terminated
    currentFnRetType:   string  // the current function return value type
    currentFnRetTypes:  []string  // the current function return value types
    currentFnRetNames:  []string  // the current function return value names
    tempBindingTypes:   map[string]string  // the temp binding types

    // Type and function metadata
    fnRetTypes:    map[string][]string
    fnParamTypes:  map[string][]string  // the function param types
    arraySizes:    map[string]ArrayMeta  // the array sizes
    structLayouts: map[string]StructLayout  // the struct layouts
    structDecls:   map[string]ast.Decl  // the struct decls
    structLLNames: map[string]string  // the struct LLVM names
    structDtors:   map[string]string  // the struct dtors
    arrayDtors:    map[string]string  // the array dtors
    enumDtors:     map[string]string  // the enum dtors
    fnVariadic:    map[string]bool  // the function variadic
    consts:        map[string]ast.Expr  // the consts
    constFiles:    map[string]string  // the const files
    globalVarTypes: map[string]string  // the global var types

    // Control flow
    loopLabels:      []LoopLabel
    loopLabelDepth:  int  // the loop label depth
    deferred:        []ast.Stmt  // the deferred
    errors:          []string  // the errors

    // Advanced features
    services:           map[string]bool
    rulesets:           map[string]bool  // the rulesets
    currentFnName:      string  // the current function name
    hasMainWrapper:     bool  // whether main wrapper
    mainRetType:        string  // the main return value type
    runtimeHelpersEmitted: bool  // the runtime helpers emitted
    mapTypes:           map[string]bool  // the map types
    setTypes:           map[string]bool  // the set types
    rulesetWrappers:    map[string]bool  // the ruleset wrappers
    aliases:            map[string]checker.TType  // the aliases
    taggedUnions:       map[string]ast.Decl  // the tagged unions
    tuVariantDecl:      map[string]ast.Decl   // variant name -> enum decl
    tuVariantIdx:       map[string]int        // variant name -> variant index
    fnAliasLLTypes:     map[string]string  // the function alias LLVM types
    cudaKernels:        []string  // the cuda kernels
    importAliases:      map[string]string  // the import aliases
    currentModule:      string  // the current module
    importsStdTensor:   bool  // the imports std tensor
    declaredExterns:    map[string]bool  // the declared externs
    // Names of extern (C ABI) functions, keyed by their emitted symbol
    // name. Used to decide whether a call result is an owned reference:
    // externs return borrowed or aliased pointers (e.g. memcpy returns
    // dest), so their results must not be released as temporaries.
    externFns:          map[string]bool

    // Panic/recover support
    hasDefer:         bool
    needPanicLanding: bool  // the need panic landing
    panicLandingLabel: string  // the panic landing label
    normalEntryLabel:  string  // the normal entry label

    // Runtime defer stack (comp_error.md #41/#42). A defer inside a loop
    // must register once per executed iteration, and its arguments are
    // evaluated where the defer statement runs — a compile-time list of
    // AST statements can express neither. deferQueueAlloca is the alloca
    // of the current function's %__defer_node* stack head ("" when the
    // function has no defer); each executed defer pushes a node holding
    // a pre-compiled thunk handle, and every exit path — return,
    // fall-through, error propagation, panic unwind — drains the stack
    // LIFO. deferTmpCounter numbers the hidden temporaries that hold
    // deferred call arguments evaluated at the defer point;
    // deferNodeTypeEmitted guards the one-time node type header.
    deferQueueAlloca:     string
    deferTmpCounter:      int  // the defer temporary counter
    deferNodeTypeEmitted: bool  // the defer node type emitted

    // String interning: maps string values to their LLVM global names
    // so that identical string literals share the same address. This
    // ensures pointer equality works for string literals in generic
    // contexts where type erasure prevents content-based comparison.
    stringIntern:    map[string]string

    // Checker reference for type info
    checker: *checker.Checker

    // Debug info support (LLVM DWARF metadata emission)
    dbgMetaCounter:      int
    dbgMetadata:         []string  // the dbg metadata
    dbgFiles:            map[string]string  // the dbg files
    dbgFilePaths:        []string  // the dbg file paths
    dbgCompileUnit:      string  // the dbg compile unit
    dbgCurrentFile:      string  // the dbg current file
    dbgCurrentSubprogram: string  // the dbg current subprogram
    dbgCurrentLoc:       string  // the dbg current loc
    dbgCurrentLine:      int  // the dbg current line
    dbgCurrentCol:       int  // the dbg current column
    dbgTypes:            map[string]string  // the dbg types
    dbgStructTypes:      map[string]string  // the dbg struct types
    currentFilePath:     string  // the current file path
    currentStmtLine:     int  // the current statement line
    currentStmtCol:      int  // the current statement column

    // Global variable initializers: collected during emission and
    // initialized in a _skink_global_init function called before main.
    globalInits:         []ast.Stmt

    // Embed declarations (`embed "dir"`): collected during emission and
    // baked into the binary as data globals registered by
    // @_skink_embed_init before main runs.
    embeds:              []embedSpec

    // Function literal counter for generating unique names
    fnLitCounter:        int

    // Temporary-expression tracking: anonymous temporaries produced by
    // owned-value expressions (call results, constructors, concat, etc.)
    // are registered in the current scope so they are released at scope
    // exit. fnBodyActive gates this so temporaries are only tracked while
    // emitting a normal function body (not global init or ruleset code).
    tempCounter:         int
    fnBodyActive:        bool  // the function body active

    // appendSelfVar holds an lValueKey ("x" or "t.vals") when emitting the
    // RHS of the `x = append(x, ...)` self-assignment idiom. Only that idiom proves the
    // appended-from backing array's sole reference is dead (the assign
    // releases it right after), which is the only case where geometric
    // in-place growth via Skink_slice_ensure is safe: refcount==1 on a live
    // variable just means the variable itself is the sole owner, and growing
    // in place would corrupt it. The flag is consumed (cleared) by the
    // outermost emitAppendCall/emitSpreadAppend so nested append calls cannot
    // claim it. "" means no self-append is in flight.
    appendSelfVar:       string

    // escapedVars holds the names of local variables in the function
    // currently being emitted whose address is taken via `&` anywhere in
    // the body (found by the collectEscapedVars pre-scan). Such variables
    // are boxed into an RC heap block at declaration time so the pointer
    // stays valid after the frame returns. Saved/restored per function.
    escapedVars:         map[string]bool

    // capturedVars holds the names of local variables in the function
    // currently being emitted that occur inside any function-literal
    // body (found by the collectCapturedVars pre-scan). Such variables
    // must be boxed at DECLARATION time: promoting them lazily at the
    // literal's evaluation site would emit the box allocation inside
    // whatever control flow encloses the literal — inside a loop body it
    // re-boxes every iteration, re-zeroing the source alloca so the
    // captured box reads 0 (comp_error.md #39). Saved/restored per
    // function.
    capturedVars:        map[string]bool
    // hasModuleMainEntry is true when the program's module main declares
    // `fn main`; entryMainEmitted records that a lone library `fn main`
    // already claimed the @_skink_main entry symbol (#116).
    hasModuleMainEntry:   bool
    entryMainEmitted:     bool  // the entry main emitted

    // Error propagation support: the current function's return label
    // (for `?` operator early-return) and return value allocas
    fnReturnLabel:       string
    fnReturnAlloca:      string  // the function return alloca
}

// === Constructor ===

// newCodeGen creates and initializes a CodeGen instance for IR emission.
pub fn newCodeGen(c: *checker.Checker, dbgEnabled: bool) -> CodeGen {
    cg := CodeGen{}
    cg.moduleHeader = str.NewBuilder(4096)
    cg.stringGlobals = str.NewBuilder(4096)
    cg.out = str.NewBuilder(4096)
    cg.spawnThunks = str.NewBuilder(1024)
    cg.anonFns = str.NewBuilder(4096)
    cg.arrayDtorFns = str.NewBuilder(4096)
    cg.closureThunks = make(map[string]bool)
    cg.metadata = str.NewBuilder(1024)
    cg.allocaBuffer = str.NewBuilder(4096)
    cg.scopeVars = []ScopeV{}
    cg.scopeVars = append(cg.scopeVars, scopeVMake())
    cg.scopeDepth = 0
    cg.tempBindingTypes = make(map[string]string)
    cg.fnRetTypes = make(map[string][]string)
    cg.fnParamTypes = make(map[string][]string)
    cg.arraySizes = make(map[string]ArrayMeta)
    cg.structLayouts = make(map[string]StructLayout)
    cg.structDecls = make(map[string]ast.Decl)
    cg.structLLNames = make(map[string]string)
    cg.structDtors = make(map[string]string)
    cg.arrayDtors = make(map[string]string)
    cg.enumDtors = make(map[string]string)
    cg.fnVariadic = make(map[string]bool)
    cg.consts = make(map[string]ast.Expr)
    cg.constFiles = make(map[string]string)
    cg.globalVarTypes = make(map[string]string)
    cg.loopLabels = []LoopLabel{}
    cg.loopLabelDepth = 0
    cg.deferred = []ast.Stmt{}
    cg.errors = []string{}
    cg.services = make(map[string]bool)
    cg.rulesets = make(map[string]bool)
    cg.mapTypes = make(map[string]bool)
    cg.setTypes = make(map[string]bool)
    cg.rulesetWrappers = make(map[string]bool)
    cg.aliases = make(map[string]checker.TType)
    cg.taggedUnions = make(map[string]ast.Decl)
    cg.tuVariantDecl = make(map[string]ast.Decl)
    cg.tuVariantIdx = make(map[string]int)
    cg.fnAliasLLTypes = make(map[string]string)
    cg.cudaKernels = []string{}
    cg.importAliases = make(map[string]string)
    cg.currentModule = ""
    cg.importsStdTensor = false
    cg.stringIntern = make(map[string]string)
    cg.declaredExterns = make(map[string]bool)
    cg.externFns = make(map[string]bool)
    cg.escapedVars = make(map[string]bool)
    cg.capturedVars = make(map[string]bool)
    cg.fnLitCounter = 0
    cg.currentFnRetTypes = []string{}
    cg.currentFnRetNames = []string{}
    cg.checker = c
    cg.dbgEnabled = dbgEnabled
    cg.dbgMetaCounter = 0
    cg.dbgMetadata = []string{}
    cg.dbgFiles = make(map[string]string)
    cg.dbgFilePaths = []string{}
    cg.dbgTypes = make(map[string]string)
    cg.dbgStructTypes = make(map[string]string)
    return cg
}

// === Output Helpers ===

// emit appends a string to the function-body IR buffer.
fn emit(cg: *CodeGen, s: string) {
    cg.out.Write(s)
}

// emitln appends a string followed by a newline.
// When debug info is active and a DILocation is set, instructions (lines
// starting with 2-space indent) automatically get ", !dbg !N" appended.
fn emitln(cg: *CodeGen, s: string) {
    if cg.dbgEnabled && str.Len(cg.dbgCurrentSubprogram) > 0 && str.StartsWith(s, "  ") {
        loc := cg.dbgCurrentLoc
        if str.Len(loc) == 0 {
            // Use a default line-0 location so all instructions in a debug
            // function have a !dbg attachment (required by LLVM verifier).
            loc = getOrCreateDefaultLoc(cg)
        }
        cg.out.Write(s)
        cg.out.Write(str.Concat(", !dbg ", loc))
    } else {
        cg.out.Write(s)
    }
    cg.out.WriteByte(10)
}

// emitHeader appends to the module header buffer.
fn emitHeader(cg: *CodeGen, s: string) {
    cg.moduleHeader.Write(s)
}

// emitHeaderLn appends a line to the module header buffer.
fn emitHeaderLn(cg: *CodeGen, s: string) {
    cg.moduleHeader.Write(s)
    cg.moduleHeader.WriteByte(10)
}

// emitStringGlobal appends to the string globals buffer.
fn emitStringGlobal(cg: *CodeGen, s: string) {
    cg.stringGlobals.Write(s)
}

// emitSpawnThunk appends to the spawn thunks buffer.
fn emitSpawnThunk(cg: *CodeGen, s: string) {
    cg.spawnThunks.Write(s)
}

// emitAnonFn appends to the anonymous functions buffer.
fn emitAnonFn(cg: *CodeGen, s: string) {
    cg.anonFns.Write(s)
}

// emitMetadata appends to the metadata buffer.
fn emitMetadata(cg: *CodeGen, s: string) {
    cg.metadata.Write(s)
}

// === Debug Info Helpers ===

// nextDbgMeta allocates the next debug metadata node ID.
fn nextDbgMeta(cg: *CodeGen) -> string {
    id := str.Concat("!", strconv.Itoa(cg.dbgMetaCounter))
    cg.dbgMetaCounter = cg.dbgMetaCounter + 1
    cg.dbgMetadata = append(cg.dbgMetadata, "")
    return id
}

// setDbgMeta stores a debug metadata definition by its numeric ID.
fn setDbgMeta(cg: *CodeGen, id: string, def: string) {
    numStr := str.Substr(id, 1, str.Len(id) - 1)
    n, ok := strconv.ParseInt(numStr)
    if ok {
        cg.dbgMetadata[n] = def
    }
}

// getOrCreateDIFile returns (or creates) a DIFile metadata node for a path.
fn getOrCreateDIFile(cg: *CodeGen, filePath: string) -> string {
    existing := cg.dbgFiles[filePath]
    if str.Len(existing) > 0 {
        return existing
    }
    id := nextDbgMeta(cg)
    cg.dbgFiles[filePath] = id
    cg.dbgFilePaths = append(cg.dbgFilePaths, filePath)
    filename := filePath
    directory := ""
    slash := str.LastIndexOf(filePath, "/")
    if slash >= 0 {
        filename = str.Substr(filePath, slash + 1, str.Len(filePath) - slash - 1)
        directory = str.Substr(filePath, 0, slash)
    }
    def := str.Concat(str.Concat(str.Concat(str.Concat(
        id, " = !DIFile(filename: \""), filename), "\", directory: \""),
        str.Concat(directory, "\")"))
    setDbgMeta(cg, id, def)
    return id
}

// dbgType maps an LLVM type string to a DWARF debug type metadata node.
fn dbgType(cg: *CodeGen, llType: string) -> string {
    cached := cg.dbgTypes[llType]
    if str.Len(cached) > 0 {
        return cached
    }
    if str.Equal(llType, "i32") {
        id := nextDbgMeta(cg)
        setDbgMeta(cg, id, str.Concat(id, " = !DIBasicType(name: \"int\", size: 32, encoding: DW_ATE_signed)"))
        cg.dbgTypes[llType] = id
        return id
    }
    if str.Equal(llType, "i64") {
        id := nextDbgMeta(cg)
        setDbgMeta(cg, id, str.Concat(id, " = !DIBasicType(name: \"int64\", size: 64, encoding: DW_ATE_signed)"))
        cg.dbgTypes[llType] = id
        return id
    }
    if str.Equal(llType, "i16") {
        id := nextDbgMeta(cg)
        setDbgMeta(cg, id, str.Concat(id, " = !DIBasicType(name: \"int16\", size: 16, encoding: DW_ATE_signed)"))
        cg.dbgTypes[llType] = id
        return id
    }
    if str.Equal(llType, "i8") {
        id := nextDbgMeta(cg)
        setDbgMeta(cg, id, str.Concat(id, " = !DIBasicType(name: \"byte\", size: 8, encoding: DW_ATE_signed)"))
        cg.dbgTypes[llType] = id
        return id
    }
    if str.Equal(llType, "i1") {
        id := nextDbgMeta(cg)
        setDbgMeta(cg, id, str.Concat(id, " = !DIBasicType(name: \"bool\", size: 1, encoding: DW_ATE_boolean)"))
        cg.dbgTypes[llType] = id
        return id
    }
    if str.Equal(llType, "double") {
        id := nextDbgMeta(cg)
        setDbgMeta(cg, id, str.Concat(id, " = !DIBasicType(name: \"float\", size: 64, encoding: DW_ATE_float)"))
        cg.dbgTypes[llType] = id
        return id
    }
    if str.Equal(llType, "void") {
        id := nextDbgMeta(cg)
        setDbgMeta(cg, id, str.Concat(id, " = !DIBasicType(name: \"void\", size: 0, encoding: DW_ATE_unsigned)"))
        cg.dbgTypes[llType] = id
        return id
    }
    if str.EndsWith(llType, "*") {
        baseType := str.Substr(llType, 0, str.Len(llType) - 1)
        baseDbg := dbgType(cg, baseType)
        id := nextDbgMeta(cg)
        setDbgMeta(cg, id, str.Concat(str.Concat(str.Concat(
            id, " = !DIDerivedType(tag: DW_TAG_pointer_type, baseType: "),
            baseDbg), ", size: 64)"))
        cg.dbgTypes[llType] = id
        return id
    }
    if str.StartsWith(llType, "%") {
        return dbgStructType(cg, llType)
    }
    id := nextDbgMeta(cg)
    setDbgMeta(cg, id, str.Concat(id, " = !DIBasicType(name: \"opaque\", size: 0, encoding: DW_ATE_unsigned)"))
    cg.dbgTypes[llType] = id
    return id
}

// dbgStructType maps a struct LLVM type to a DICompositeType metadata node.
fn dbgStructType(cg: *CodeGen, llType: string) -> string {
    cached := cg.dbgStructTypes[llType]
    if str.Len(cached) > 0 {
        return cached
    }
    structName := llType
    if str.StartsWith(structName, "%struct.") {
        structName = str.Substr(structName, 8, str.Len(structName) - 8)
    } else if str.StartsWith(structName, "%") {
        structName = str.Substr(structName, 1, str.Len(structName) - 1)
    }
    layout := cg.structLayouts[structName]
    hasLayout := str.Len(layout.llType) > 0
    id := nextDbgMeta(cg)
    cg.dbgStructTypes[llType] = id
    if hasLayout {
        // Build element list
        elemDefs := []string{}
        i := 0
        for i < len(layout.fieldTypes) {
            fieldDbg := dbgType(cg, layout.fieldTypes[i])
            fieldName := ""
            if i < len(layout.fields) {
                fieldName = layout.fields[i]
            }
            offset := 0
            if i < len(layout.offsets) {
                offset = layout.offsets[i]
            }
            elemId := nextDbgMeta(cg)
            fieldBits := llTypeSizeBits(layout.fieldTypes[i])
            elemDef := str.Concat(str.Concat(str.Concat(str.Concat(str.Concat(str.Concat(str.Concat(
                elemId, " = !DIDerivedType(tag: DW_TAG_member, name: \""), fieldName),
                "\", baseType: "), fieldDbg), ", size: "), strconv.Itoa(fieldBits)), str.Concat(", offset: ", str.Concat(strconv.Itoa(offset), ")")))
            setDbgMeta(cg, elemId, elemDef)
            elemDefs = append(elemDefs, elemId)
            i = i + 1
        }
        elemListId := nextDbgMeta(cg)
        elemListDef := str.Concat(elemListId, " = !{")
        j := 0
        for j < len(elemDefs) {
            if j > 0 {
                elemListDef = str.Concat(elemListDef, ", ")
            }
            elemListDef = str.Concat(elemListDef, elemDefs[j])
            j = j + 1
        }
        elemListDef = str.Concat(elemListDef, "}")
        setDbgMeta(cg, elemListId, elemListDef)
        sizeBits := layout.size * 8
        alignBits := layout.alignment * 8
        setDbgMeta(cg, id, str.Concat(str.Concat(str.Concat(str.Concat(str.Concat(str.Concat(str.Concat(str.Concat(str.Concat(
            id, " = !DICompositeType(tag: DW_TAG_structure_type, name: \""),
            structName), "\", size: "), strconv.Itoa(sizeBits)), ", align: "), strconv.Itoa(alignBits)),
            ", elements: "), elemListId), ")"))
        return id
    }
    // Opaque struct (no layout info)
    setDbgMeta(cg, id, str.Concat(str.Concat(str.Concat(
        id, " = !DICompositeType(tag: DW_TAG_structure_type, name: \""),
        structName), "\", size: 0, flags: DIFlagFwdDecl)"))
    return id
}

// emitDbgLocation emits a !DILocation annotation for the current source line.
fn emitDbgLocation(cg: *CodeGen, line: int, col: int) {
    if cg.dbgEnabled {
        if str.Len(cg.dbgCurrentSubprogram) > 0 {
            if line > 0 {
                id := nextDbgMeta(cg)
                def := str.Concat(id, " = !DILocation(line: ")
                def = str.Concat(def, strconv.Itoa(line))
                def = str.Concat(def, ", column: ")
                def = str.Concat(def, strconv.Itoa(col))
                def = str.Concat(def, ", scope: ")
                def = str.Concat(def, cg.dbgCurrentSubprogram)
                def = str.Concat(def, ")")
                setDbgMeta(cg, id, def)
                cg.dbgCurrentLoc = id
                cg.dbgCurrentLine = line
                cg.dbgCurrentCol = col
            }
        }
    }
}

// clearDbgLocation resets the current debug location to the default.
fn clearDbgLocation(cg: *CodeGen) {
    cg.dbgCurrentLoc = ""
}

// getOrCreateDefaultLoc returns a line-0 DILocation for the current subprogram,
// creating it once and caching it. Used as a fallback so every instruction in
// a debug-info function has a !dbg attachment.
fn getOrCreateDefaultLoc(cg: *CodeGen) -> string {
    if str.Len(cg.dbgDefaultLoc) > 0 {
        return cg.dbgDefaultLoc
    }
    id := nextDbgMeta(cg)
    def := str.Concat(id, " = !DILocation(line: 0, scope: ")
    def = str.Concat(def, cg.dbgCurrentSubprogram)
    def = str.Concat(def, ")")
    setDbgMeta(cg, id, def)
    cg.dbgDefaultLoc = id
    return id
}

// errorf records a recoverable codegen error.
fn errorf(cg: *CodeGen, msg: string) {
    if str.Len(cg.currentFilePath) > 0 {
        prefix := str.Concat(str.Concat(cg.currentFilePath, " "), str.Concat(str.Concat(strconv.Itoa(cg.currentStmtLine), ":"), str.Concat(strconv.Itoa(cg.currentStmtCol), ": ")))
        msg = str.Concat(prefix, msg)
    }
    cg.errors = append(cg.errors, msg)
}

// Errors returns all recoverable errors collected during codegen.
pub fn Errors(cg: *CodeGen) -> []string {
    return cg.errors
}

// String returns the complete generated IR in correct order.
pub fn String(cg: *CodeGen) -> string {
    parts := []string{}
    parts = append(parts, str.BuilderValue(cg.moduleHeader))
    parts = append(parts, str.BuilderValue(cg.stringGlobals))
    parts = append(parts, str.BuilderValue(cg.out))
    parts = append(parts, str.BuilderValue(cg.spawnThunks))
    parts = append(parts, str.BuilderValue(cg.anonFns))
    parts = append(parts, str.BuilderValue(cg.arrayDtorFns))
    parts = append(parts, str.BuilderValue(cg.metadata))
    return concatMany(parts)
}

// === SSA Register / Label Generation ===

// nextReg generates the next unique SSA register name.
fn nextReg(cg: *CodeGen) -> string {
    cg.regCounter = cg.regCounter + 1
    return str.Concat("%r", strconv.Itoa(cg.regCounter))
}

// nextLabel generates the next unique basic block label.
fn nextLabel(cg: *CodeGen) -> string {
    cg.labelCounter = cg.labelCounter + 1
    return str.Concat("L", strconv.Itoa(cg.labelCounter))
}

// nextStrGlobal generates the next unique string global name.
fn nextStrGlobal(cg: *CodeGen) -> string {
    cg.strCounter = cg.strCounter + 1
    return str.Concat("@str.", strconv.Itoa(cg.strCounter))
}

// === Variable Scoping ===

// pushScope pushes a new variable scope onto the scope stack.
fn pushScope(cg: *CodeGen) {
    cg.scopeDepth = cg.scopeDepth + 1
    if cg.scopeDepth >= len(cg.scopeVars) {
        cg.scopeVars = append(cg.scopeVars, scopeVMake())
    } else {
        // Reuse a previously-popped slot in the backing array (overwriting
        // via index assignment, not slice re-slicing — see the scopeVars
        // field comment for why re-slicing doesn't work here).
        cg.scopeVars[cg.scopeDepth] = scopeVMake()
    }
}

// popScope pops the current scope, releasing its heap-allocated variables.
fn popScope(cg: *CodeGen) {
    if cg.scopeDepth > 0 {
        // If the current block already terminated (e.g. via an early
        // return, which itself deallocates all active scopes), the rest
        // of this block is unreachable: emitting more instructions here
        // would create dead code that doesn't get a fresh label, which
        // LLVM's verifier rejects (values defined in a preceding
        // conditional block wouldn't dominate this dangling code).
        if !cg.terminated {
            emitDeallocationsForScope(cg, cg.scopeDepth)
        }
        cg.scopeDepth = cg.scopeDepth - 1
    }
}

// dropScope pops the current scope without releasing its variables.
fn dropScope(cg: *CodeGen) {
    if cg.scopeDepth > 0 {
        cg.scopeDepth = cg.scopeDepth - 1
    }
}

// pushLoopLabel pushes break/continue labels for the current loop.
fn pushLoopLabel(cg: *CodeGen, continueLabel: string, endLabel: string) {
    ll := LoopLabel{continueLabel: continueLabel, endLabel: endLabel,
        scopeDepth: cg.scopeDepth, continueDepth: cg.scopeDepth}
    total := len(cg.loopLabels)
    if cg.loopLabelDepth < total {
        cg.loopLabels[cg.loopLabelDepth] = ll
    } else {
        cg.loopLabels = append(cg.loopLabels, ll)
    }
    cg.loopLabelDepth = cg.loopLabelDepth + 1
}

// popLoopLabel pops the current loop's break/continue labels.
fn popLoopLabel(cg: *CodeGen) {
    if cg.loopLabelDepth > 0 {
        cg.loopLabelDepth = cg.loopLabelDepth - 1
    }
}

// currentLoopLabel returns the innermost loop's break/continue labels.
fn currentLoopLabel(cg: *CodeGen) -> (LoopLabel, bool) {
    if cg.loopLabelDepth > 0 {
        idx := cg.loopLabelDepth - 1
        return cg.loopLabels[idx], true
    }
    return LoopLabel{}, false
}

// declareVar registers a variable in the current scope with its alloca and type.
fn declareVar(cg: *CodeGen, name: string, allocaReg: string, llType: string, synType: checker.TType) {
    if name == "" {
        return
    }
    sv := ScopeVar{}
    sv.alloca = allocaReg
    sv.llType = llType
    sv.synType = synType
    scopeVSet(&cg.scopeVars[cg.scopeDepth], name, sv)
    // Variables whose address is taken anywhere in this function are boxed
    // into an RC heap block so the pointer survives the frame.
    promoteEscapedVar(cg, name, sv)
    if cg.dbgEnabled && str.Len(cg.dbgCurrentSubprogram) > 0 {
        varId := nextDbgMeta(cg)
        varDef := str.Concat(varId, " = !DILocalVariable(name: \"")
        varDef = str.Concat(varDef, name)
        varDef = str.Concat(varDef, "\", scope: ")
        varDef = str.Concat(varDef, cg.dbgCurrentSubprogram)
        varDef = str.Concat(varDef, ", type: ")
        varDef = str.Concat(varDef, dbgType(cg, llType))
        varDef = str.Concat(varDef, ")")
        setDbgMeta(cg, varId, varDef)
        locId := cg.dbgCurrentLoc
        if str.Len(locId) == 0 {
            locId = nextDbgMeta(cg)
            setDbgMeta(cg, locId, str.Concat(str.Concat(
                locId, " = !DILocation(line: 0, scope: "), str.Concat(cg.dbgCurrentSubprogram, ")")))
        }
        // Use emit+WriteByte directly to avoid emitln appending !dbg
        dbgLine := str.Concat("  #dbg_declare(ptr ", allocaReg)
        dbgLine = str.Concat(dbgLine, ", ")
        dbgLine = str.Concat(dbgLine, varId)
        dbgLine = str.Concat(dbgLine, ", !DIExpression(), ")
        dbgLine = str.Concat(dbgLine, locId)
        dbgLine = str.Concat(dbgLine, ")")
        cg.out.Write(dbgLine)
        cg.out.WriteByte(10)
    }
}

// lookupVar searches all scopes for a variable, returning its binding.
fn lookupVar(cg: *CodeGen, name: string) -> (ScopeVar, bool) {
    i := cg.scopeDepth
    for i >= 0 {
        v := scopeVGet(&cg.scopeVars[i], name)
        if str.Len(v.llType) > 0 {
            return v, true
        }
        i = i - 1
    }
    return ScopeVar{}, false
}

// markBorrowed marks a variable as borrowed (its address was taken via &var
// or it was passed by pointer to another function). Borrowed variables are
// not released at scope exit to avoid use-after-free.
fn markBorrowed(cg: *CodeGen, name: string) {
    i := cg.scopeDepth
    for i >= 0 {
        v := scopeVGet(&cg.scopeVars[i], name)
        if str.Len(v.llType) > 0 {
            v.borrowed = true
            scopeVSet(&cg.scopeVars[i], name, v)
            return
        }
        i = i - 1
    }
}

// === Escape analysis ===
//
// `&x` on a stack-allocated local hands out a pointer that may outlive the
// frame (stored into heap structs, sent to spawned threads, returned).
// Without escape handling the pointer dangles and later reads/writes hit
// dead stack memory (issue: self.ctx.Done() through a *Context field read
// garbage and recursed on a corrupt parent until the stack overflowed).
//
// A per-function pre-scan (collectEscapedVars) collects the names of
// locals whose address is taken. When such a variable is declared,
// boxVarAtScope boxes it: the value is moved into an RC-managed heap
// block and the variable's heapSlot alloca holds the block pointer. All
// value accesses then go through varValuePtr, which loads the block
// pointer for escaped variables. `&x` itself returns the block pointer, so
// the address is stable and survives the frame; releasing the variable's
// reference at scope exit is safe because the block is reference-counted.
// Variables already stored as heap pointers (llType ending in "*") need no
// boxing: `&x` on a *T variable already returns the heap object pointer.

// varValuePtr returns a pointer to a variable's stored value: the stack
// alloca for normal variables, or the loaded RC heap block pointer for
// boxed variables — escaped locals (escaped=true) as well as
// capture-view bindings inside function literals (heapSlot set,
// escaped=false, borrowed=true).
fn varValuePtr(cg: *CodeGen, sv: ScopeVar) -> string {
    // heapSlot marks boxed storage — set for escaped variables and for
    // closure-capture view bindings inside function literals (which are
    // borrowed views of the captured box, so escaped stays false and the
    // scope-exit release does not drop the capture's reference).
    if str.Len(sv.heapSlot) > 0 {
        ptrType := str.Concat(sv.llType, "*")
        return emitLoad(cg, ptrType, ptrType, sv.heapSlot)
    }
    return sv.alloca
}

// getOrCreateBoxDtor emits (once per type) a destructor that releases the
// heap-allocated contents of a boxed variable when its RC block is freed,
// and returns the destructor's name. Pointer-typed boxes release their
// payload pointer; struct-by-value boxes release each heap field.
// Returns "" for value types that own no heap contents.
fn getOrCreateBoxDtor(cg: *CodeGen, llType: string) -> string {
    if isHeapLLType(llType) {
        // The box stores a heap pointer (e.g. a captured *T local):
        // release the payload when the box is freed.
        typeTag := sanitizeLLTypeName(llType)
        dtorName := str.Concat("__box_dtor_", typeTag)
        cached := cg.arrayDtors[dtorName]
        if str.Len(cached) > 0 {
            return cached
        }
        cg.arrayDtors[dtorName] = dtorName
        b := &cg.arrayDtorFns
        str.Write(b, str.Concat(str.Concat("define void @", dtorName), "(i8* %raw) {\n"))
        str.Write(b, "entry:\n")
        str.Write(b, str.Concat(str.Concat("  %bp = bitcast i8* %raw to ", llType), "*\n"))
        str.Write(b, str.Concat(str.Concat(str.Concat("  %v = load ", llType), str.Concat(", ", llType)), "* %bp\n"))
        str.Write(b, str.Concat(str.Concat("  %v8 = bitcast ", llType), " %v to i8*\n"))
        str.Write(b, "  call void @Skink_rc_release(i8* %v8)\n")
        str.Write(b, "  ret void\n}\n\n")
        return dtorName
    }
    if !str.StartsWith(llType, "%struct.") || str.EndsWith(llType, "*") {
        return ""
    }
    if !needsArrayDtor(cg, llType) {
        return ""
    }
    typeTag := sanitizeLLTypeName(llType)
    dtorName := str.Concat("__box_dtor_", typeTag)
    cached := cg.arrayDtors[dtorName]
    if str.Len(cached) > 0 {
        return cached
    }
    cg.arrayDtors[dtorName] = dtorName
    b := &cg.arrayDtorFns
    str.Write(b, str.Concat(str.Concat("define void @", dtorName), "(i8* %raw) {\n"))
    str.Write(b, "entry:\n")
    structName := str.Substr(llType, str.Len("%struct."), str.Len(llType) - str.Len("%struct."))
    layout := cg.structLayouts[structName]
    hasLayout := str.Len(layout.llType) > 0
    if hasLayout && structHasDtorTrampoline(cg, layout) {
        // Struct has a destructor trampoline (Drop and/or field release).
        llStructName := str.Substr(layout.llType, str.Len("%struct."), str.Len(layout.llType) - str.Len("%struct."))
        str.Write(b, str.Concat(str.Concat("  call void @", llStructName), "__dtor(i8* %raw)\n"))
    } else {
        // Release each heap-allocated field of the boxed struct.
        str.Write(b, str.Concat(str.Concat("  %bp = bitcast i8* %raw to ", llType), "*\n"))
        emitArrayDtorStructFields(b, cg, llType, "%bp", "bx")
    }
    str.Write(b, "  ret void\n")
    str.Write(b, "}\n\n")
    return dtorName
}

// promoteEscapedVar boxes a variable whose address is taken: copies its
// (already initialized) value into an RC-managed heap block and records
// the slot holding the block pointer. Called from declareVar after the
// variable's initial value has been stored into sv.alloca. The dead stack
// copy is zeroed so nothing that later walks the alloca double-releases
// fields that now belong solely to the heap block.
fn promoteEscapedVar(cg: *CodeGen, name: string, sv: ScopeVar) {
    if !cg.escapedVars[name] && !cg.capturedVars[name] {
        return
    }
    // Pointer-typed variables already refer to heap storage; `&x` on them
    // returns the object pointer (see emitAddressOf), so no boxing needed.
    // A captured pointer variable must still be boxed — the closure env
    // stores the box so writes inside the literal propagate by reference.
    if str.EndsWith(sv.llType, "*") && !cg.capturedVars[name] {
        return
    }
    boxVarAtScope(cg, cg.scopeDepth, name, sv)
}

// boxVarAtScope moves a variable's (already initialized) value into an
// RC-managed heap block and records the slot holding the block pointer,
// writing the updated binding back to scopeIdx where it was found.
// Shared by &x escape promotion (declare-time) and closure capture
// promotion (literal-creation time, possibly in an outer scope).
fn boxVarAtScope(cg: *CodeGen, scopeIdx: int, name: string, sv: ScopeVar) {
    ptrType := str.Concat(sv.llType, "*")
    size := elemSizeLiteral(cg, sv.llType)
    dtor := getOrCreateBoxDtor(cg, sv.llType)
    raw := nextReg(cg)
    if str.Len(dtor) > 0 {
        emitfmt(cg, "  %s = call i8* @Skink_rc_alloc_typed(i64 %s, i8* bitcast (void (i8*)* @%s to i8*))\n",
            []string{raw, strconv.Itoa(size), dtor})
    } else {
        emitfmt(cg, "  %s = call i8* @Skink_rc_alloc(i64 %s)\n",
            []string{raw, strconv.Itoa(size)})
    }
    heapPtr := nextReg(cg)
    emitfmt(cg, "  %s = bitcast i8* %s to %s\n", []string{heapPtr, raw, ptrType})
    v := emitLoad(cg, sv.llType, sv.llType, sv.alloca)
    emitStore(cg, sv.llType, v, sv.llType, heapPtr)
    zeroVal := zeroValueForLLType(sv.llType)
    if str.Len(zeroVal) > 0 {
        emitStore(cg, sv.llType, zeroVal, sv.llType, sv.alloca)
    }
    heapSlot := emitAlloca(cg, ptrType)
    emitStore(cg, ptrType, heapPtr, ptrType, heapSlot)
    sv.heapSlot = heapSlot
    sv.escaped = true
    // Re-register so future lookups see the escaped binding.
    scopeVSet(&cg.scopeVars[scopeIdx], name, sv)
}

// promoteForCapture boxes (or reuses the box of) a local so a function
// literal can hold a stable reference. Unlike promoteEscapedVar it also
// boxes pointer-typed variables — the box stores the pointer value so
// writes inside the literal propagate to the enclosing variable — and
// it writes back to the scope where the variable actually lives.
// Returns the (possibly updated) binding.
fn promoteForCapture(cg: *CodeGen, name: string) -> (ScopeVar, bool) {
    i := cg.scopeDepth
    for i >= 0 {
        v := scopeVGet(&cg.scopeVars[i], name)
        if str.Len(v.llType) > 0 {
            if str.Len(v.heapSlot) == 0 {
                boxVarAtScope(cg, i, name, v)
                v = scopeVGet(&cg.scopeVars[i], name)
            }
            return v, true
        }
        i = i - 1
    }
    return ScopeVar{}, false
}

// === Closure capture collection ===

// CaptureScan accumulates identifier names occurring in a function
// literal body — candidates for capture from enclosing scopes. Deduped
// via the seen map; names keeps a deterministic order for the env block
// layout (packing and unpacking must agree).
struct CaptureScan {
    seen:  map[string]bool  // the seen
    names: []string  // the names
}

// add records a name once, preserving first-use order.
fn captureScanAdd(s: *CaptureScan, name: string) {
    if str.Len(name) == 0 || str.Equal(name, "_") || s.seen[name] {
        return
    }
    s.seen[name] = true
    s.names = append(s.names, name)
}

// collectLitCaptureNames returns the names a function literal must
// capture: identifiers in its body (including nested literals, which
// resolve captures through this literal's scope) that bind to variables
// in the enclosing scopes at the point the literal is evaluated. Names
// resolving to nothing here (globals, functions, consts) are excluded;
// names declared inside the literal are captured needlessly at worst —
// the literal's own declarations re-register the name and shadow the
// capture view.
fn collectLitCaptureNames(cg: *CodeGen, e: ast.Expr) -> []string {
    scan := CaptureScan{}
    scan.seen = make(map[string]bool)
    captureScanStmts(&scan, e.fnLitBody)
    // Literal parameters shadow same-named enclosing variables: the scan
    // collects every ident in the body, so a param name would land in the
    // capture set and the env view would overwrite the param binding in
    // scope 0 (comp_error.md #40). Nested literals that reference a param
    // name still capture it through this literal's own scope.
    paramNames := make(map[string]bool)
    for pi := 0; pi < len(e.fnLitParams); pi = pi + 1 {
        paramNames[e.fnLitParams[pi].name] = true
    }
    out := []string{}
    i := 0
    for i < len(scan.names) {
        if paramNames[scan.names[i]] {
            i = i + 1
            continue
        }
        _, ok := lookupVar(cg, scan.names[i])
        if ok {
            out = append(out, scan.names[i])
        }
        i = i + 1
    }
    return out
}

// collectStmts walks a statement list collecting identifier names.
fn captureScanStmts(s: *CaptureScan, stmts: []ast.Stmt) {
    i := 0
    for i < len(stmts) {
        captureScanStmt(s, stmts[i])
        i = i + 1
    }
}

// collectStmt walks one statement's expression fields collecting names.
fn captureScanStmt(s: *CaptureScan, st: ast.Stmt) {
    captureScanExprs(s, st.varValue)
    captureScanExprs(s, st.assignTarget)
    captureScanExprs(s, st.assignValue)
    captureScanExprs(s, st.tupleTargets)
    captureScanExprs(s, st.returnValues)
    captureScanExprs(s, st.cond)
    captureScanStmts(s, st.ifInit)
    captureScanStmts(s, st.thenBody)
    captureScanStmts(s, st.elseBody)
    captureScanStmts(s, st.forInit)
    captureScanStmts(s, st.forPost)
    captureScanExprs(s, st.forIterExpr)
    captureScanExprs(s, st.matchSubject)
    i := 0
    for i < len(st.matchArms) {
        captureScanExprs(s, st.matchArms[i].guard)
        captureScanStmts(s, st.matchArms[i].body)
        i = i + 1
    }
    captureScanStmts(s, st.deferStmt)
    captureScanExprs(s, st.expr)
    captureScanExprs(s, st.spawnCall)
    i = 0
    for i < len(st.selectCases) {
        captureScanExprs(s, st.selectCases[i].cond)
        captureScanStmts(s, st.selectCases[i].body)
        i = i + 1
    }
}

// collectExprs walks an expression list collecting identifier names.
fn captureScanExprs(s: *CaptureScan, es: []ast.Expr) {
    i := 0
    for i < len(es) {
        captureScanExpr(s, es[i])
        i = i + 1
    }
}

// collectExpr walks one expression, recording identifier occurrences and
// recursing into every child expression. Nested function literals are
// descended into — their captures resolve through this literal's scope.
fn captureScanExpr(s: *CaptureScan, e: ast.Expr) {
    if e.kind == ast.EX_IDENT {
        captureScanAdd(s, e.ident)
        return
    }
    if e.kind == ast.EX_FN_LIT {
        captureScanStmts(s, e.fnLitBody)
        return
    }
    captureScanExprs(s, e.prefixRight)
    captureScanExprs(s, e.infixLeft)
    captureScanExprs(s, e.infixRight)
    captureScanExprs(s, e.callFunc)
    captureScanExprs(s, e.callArgs)
    captureScanExprs(s, e.indexTarget)
    captureScanExprs(s, e.indexExpr)
    captureScanExprs(s, e.fieldTarget)
    captureScanExprs(s, e.arrayElems)
    captureScanExprs(s, e.mapKeys)
    captureScanExprs(s, e.mapVals)
    captureScanExprs(s, e.setElems)
    i := 0
    for i < len(e.structLitFields) {
        captureScanExprs(s, e.structLitFields[i].value)
        i = i + 1
    }
    captureScanExprs(s, e.inner)
    captureScanExprs(s, e.sliceTarget)
    captureScanExprs(s, e.sliceLow)
    captureScanExprs(s, e.sliceHigh)
    captureScanExprs(s, e.ifCond)
    captureScanExprs(s, e.ifThen)
    captureScanExprs(s, e.ifElse)
    captureScanExprs(s, e.matchExprSubject)
    i = 0
    for i < len(e.matchExprArms) {
        captureScanExprs(s, e.matchExprArms[i].guard)
        captureScanStmts(s, e.matchExprArms[i].body)
        i = i + 1
    }
    captureScanExprs(s, e.makeSize)
    captureScanExprs(s, e.rangeLow)
    captureScanExprs(s, e.rangeHigh)
    captureScanExprs(s, e.spreadExpr)
    captureScanExprs(s, e.postfixTarget)
    captureScanExprs(s, e.awaitExpr)
    captureScanExprs(s, e.tupleElems)
    i = 0
    for i < len(e.interpParts) {
        captureScanExprs(s, e.interpParts[i].expr)
        i = i + 1
    }
}

// collectEscapedVars scans a function body for `&` address-of expressions
// and returns the set of root variable names whose address may escape the
// frame. Nested function literals are skipped — they emit as separate
// functions and run their own escape scan when emitted.
// EscapeScan holds the results of the escape pre-scan: `escaped` lists
// variables whose address is taken via `&`, `captured` lists names that
// occur inside any function-literal body and may therefore be captured
// by a closure (comp_error.md #39).
struct EscapeScan {
    escaped:  map[string]bool  // the escaped
    captured: map[string]bool  // the captured
}

fn collectEscapedVars(stmts: []ast.Stmt) -> EscapeScan {
    out := EscapeScan{}
    out.escaped = make(map[string]bool)
    out.captured = make(map[string]bool)
    collectEscapedStmts(stmts, &out)
    return out
}

// collectEscapedStmts walks a statement list collecting escapee names.
fn collectEscapedStmts(stmts: []ast.Stmt, out: *EscapeScan) {
    i := 0
    for i < len(stmts) {
        collectEscapedStmt(stmts[i], out)
        i = i + 1
    }
}

// collectEscapedStmt walks one statement's expression and sub-statement
// fields collecting escapee names.
fn collectEscapedStmt(s: ast.Stmt, out: *EscapeScan) {
    collectEscapedExprs(s.varValue, out)
    collectEscapedExprs(s.assignTarget, out)
    collectEscapedExprs(s.assignValue, out)
    collectEscapedExprs(s.tupleTargets, out)
    collectEscapedExprs(s.returnValues, out)
    collectEscapedExprs(s.cond, out)
    collectEscapedStmts(s.ifInit, out)
    collectEscapedStmts(s.thenBody, out)
    collectEscapedStmts(s.elseBody, out)
    collectEscapedStmts(s.forInit, out)
    collectEscapedStmts(s.forPost, out)
    collectEscapedExprs(s.forIterExpr, out)
    collectEscapedExprs(s.matchSubject, out)
    i := 0
    for i < len(s.matchArms) {
        collectEscapedExprs(s.matchArms[i].guard, out)
        collectEscapedStmts(s.matchArms[i].body, out)
        i = i + 1
    }
    collectEscapedStmts(s.deferStmt, out)
    collectEscapedExprs(s.expr, out)
    collectEscapedExprs(s.spawnCall, out)
    i = 0
    for i < len(s.selectCases) {
        collectEscapedExprs(s.selectCases[i].cond, out)
        collectEscapedStmts(s.selectCases[i].body, out)
        i = i + 1
    }
}

// collectEscapedExprs walks an expression list collecting escapee names.
fn collectEscapedExprs(es: []ast.Expr, out: *EscapeScan) {
    i := 0
    for i < len(es) {
        collectEscapedExpr(es[i], out)
        i = i + 1
    }
}

// collectEscapedExpr walks one expression, recording the root variable of
// every `&lvalue` address-of and recursing into all child expressions.
fn collectEscapedExpr(e: ast.Expr, out: *EscapeScan) {
    if e.kind == ast.EX_PREFIX && str.Equal(e.prefixOp, "&") && len(e.prefixRight) > 0 {
        collectEscapeTarget(e.prefixRight[0], out)
    }
    // Function literals become separate functions; their locals escape
    // within their own frame and are scanned when the literal is emitted.
    // Every identifier inside the literal body is a capture candidate —
    // an enclosing variable by that name must be boxed at declaration
    // time so the box exists before any enclosing loop re-executes the
    // literal's evaluation site (comp_error.md #39). The scan is
    // name-based and over-approximates (literal params and lit-local
    // names land here too); boxing an uncaptured variable only costs an
    // extra RC block.
    if e.kind == ast.EX_FN_LIT {
        scan := CaptureScan{}
        scan.seen = make(map[string]bool)
        captureScanStmts(&scan, e.fnLitBody)
        for ci := 0; ci < len(scan.names); ci = ci + 1 {
            out.captured[scan.names[ci]] = true
        }
        return
    }
    collectEscapedExprs(e.prefixRight, out)
    collectEscapedExprs(e.infixLeft, out)
    collectEscapedExprs(e.infixRight, out)
    collectEscapedExprs(e.callFunc, out)
    collectEscapedExprs(e.callArgs, out)
    collectEscapedExprs(e.indexTarget, out)
    collectEscapedExprs(e.indexExpr, out)
    collectEscapedExprs(e.fieldTarget, out)
    collectEscapedExprs(e.arrayElems, out)
    collectEscapedExprs(e.mapKeys, out)
    collectEscapedExprs(e.mapVals, out)
    collectEscapedExprs(e.setElems, out)
    i := 0
    for i < len(e.structLitFields) {
        collectEscapedExprs(e.structLitFields[i].value, out)
        i = i + 1
    }
    collectEscapedExprs(e.inner, out)
    collectEscapedExprs(e.sliceTarget, out)
    collectEscapedExprs(e.sliceLow, out)
    collectEscapedExprs(e.sliceHigh, out)
    collectEscapedExprs(e.ifCond, out)
    collectEscapedExprs(e.ifThen, out)
    collectEscapedExprs(e.ifElse, out)
    collectEscapedExprs(e.matchExprSubject, out)
    i = 0
    for i < len(e.matchExprArms) {
        collectEscapedExprs(e.matchExprArms[i].guard, out)
        collectEscapedStmts(e.matchExprArms[i].body, out)
        i = i + 1
    }
    collectEscapedExprs(e.makeSize, out)
    collectEscapedExprs(e.rangeLow, out)
    collectEscapedExprs(e.rangeHigh, out)
    collectEscapedExprs(e.spreadExpr, out)
    collectEscapedExprs(e.postfixTarget, out)
    collectEscapedExprs(e.awaitExpr, out)
    collectEscapedExprs(e.tupleElems, out)
    i = 0
    for i < len(e.interpParts) {
        collectEscapedExprs(e.interpParts[i].expr, out)
        i = i + 1
    }
}

// collectEscapeTarget records the root variable of an lvalue that follows
// `&`: `&x`, `&x.f`, `&x.f[i]` all escape the variable x. Non-identifier
// roots (parenthesized subexpressions, `*p` dereferences) need no boxing.
fn collectEscapeTarget(e: ast.Expr, out: *EscapeScan) {
    if e.kind == ast.EX_IDENT {
        out.escaped[e.ident] = true
        return
    }
    if e.kind == ast.EX_FIELD && len(e.fieldTarget) > 0 {
        collectEscapeTarget(e.fieldTarget[0], out)
        return
    }
    if e.kind == ast.EX_INDEX && len(e.indexTarget) > 0 {
        collectEscapeTarget(e.indexTarget[0], out)
        return
    }
    if e.kind == ast.EX_PAREN && len(e.inner) > 0 {
        collectEscapeTarget(e.inner[0], out)
        return
    }
}

// exprProducesOwned reports whether evaluating e produces a fresh owned
// reference (refcount +1 that the caller must eventually release). This is
// true for constructor expressions, all function calls (callees retain
// heap return values before returning), string interpolation, slices,
// await/async results, channel receives, and if/match expressions whose
// result type is heap-managed (their arms retain into the result alloca).
// isOwnedExternResult reports whether an extern function returns a
// freshly allocated, registry-tracked block that the caller owns. All
// other externs return borrowed pointers (C library data), untracked
// pointers (plain malloc), or aliases of their arguments (memcpy,
// strcpy, memset return dest) and must not be released as temporaries.
fn isOwnedExternResult(name: string) -> bool {
    return str.Equal(name, "Skink_mem_alloc") ||
        str.Equal(name, "Skink_mem_calloc") ||
        str.Equal(name, "Skink_mem_realloc") ||
        str.Equal(name, "Skink_raw_alloc") ||
        str.Equal(name, "Skink_raw_calloc") ||
        str.Equal(name, "Skink_rc_alloc") ||
        str.Equal(name, "Skink_rc_alloc_typed")
}

fn exprProducesOwned(cg: *CodeGen, e: ast.Expr) -> bool {
    if isConstructorExpr(cg, e) {
        return true
    }
    if e.kind == ast.EX_CALL {
        // Type casts (int(x), string(x), ...) are not owning calls — a
        // cast may return its operand unchanged, which would make the
        // temporary release an un-owned reference.
        if len(e.callFunc) > 0 && e.callFunc[0].kind == ast.EX_IDENT {
            n := e.callFunc[0].ident
            if str.Equal(n, "int") || str.Equal(n, "uint") ||
               str.Equal(n, "int8") || str.Equal(n, "uint8") ||
               str.Equal(n, "int16") || str.Equal(n, "uint16") ||
               str.Equal(n, "int32") || str.Equal(n, "uint32") ||
               str.Equal(n, "int64") || str.Equal(n, "uint64") ||
               str.Equal(n, "float") || str.Equal(n, "bool") ||
               str.Equal(n, "string") {
                return false
            }
        }
        // Extern (C ABI) functions do not follow Skink ownership rules:
        // most return borrowed or aliased pointers (e.g. memcpy returns
        // its dest argument), so treating the result as owned would
        // release memory the callee never gave us. Only the runtime
        // allocators, which return freshly tracked blocks, are owned.
        calleeName := ""
        if len(e.callFunc) > 0 {
            if e.callFunc[0].kind == ast.EX_IDENT {
                calleeName = resolveDirectFnName(cg, e.callFunc[0].ident)
            } else if e.callFunc[0].kind == ast.EX_FIELD {
                rn, _ := resolveMethodCallFnName(cg, e.callFunc[0])
                calleeName = rn
            }
        }
        if str.Len(calleeName) > 0 && mapStringBoolHasKeyCG(cg.externFns, calleeName) {
            return isOwnedExternResult(calleeName)
        }
        return true
    }
    if e.kind == ast.EX_INTERP || e.kind == ast.EX_SLICE ||
       e.kind == ast.EX_AWAIT || e.kind == ast.EX_ASYNC ||
       e.kind == ast.EX_ERROR_PROP {
        return true
    }
    if e.kind == ast.EX_PREFIX && str.Equal(e.prefixOp, "<-") {
        // Channel receive: the sender retains the value before it is
        // boxed, so the received value is owned by the receiver.
        return true
    }
    if e.kind == ast.EX_IF_EXPR || e.kind == ast.EX_MATCH_EXPR {
        rt := exprLLType(cg, e)
        if isHeapLLType(rt) ||
           (isCompositeType(rt) && !str.EndsWith(rt, "*")) {
            return true
        }
        return false
    }
    if e.kind == ast.EX_PAREN && len(e.inner) > 0 {
        return exprProducesOwned(cg, e.inner[0])
    }
    if e.kind == ast.EX_SPREAD && len(e.spreadExpr) > 0 {
        return exprProducesOwned(cg, e.spreadExpr[0])
    }
    if e.kind == ast.EX_NONNULL && len(e.postfixTarget) > 0 {
        return exprProducesOwned(cg, e.postfixTarget[0])
    }
    return false
}

// recordTemp registers an owned expression result as an anonymous
// scope-tracked temporary. The value is stored into a fresh alloca so that
// scope-exit release is a load+release: the alloca is zero-initialized in
// the entry block, making the release a safe no-op on control-flow paths
// where the temporary was never produced (panic unwind, deferred blocks
// emitted on sibling return paths, etc.).
fn recordTemp(cg: *CodeGen, reg: string, llType: string) {
    if !cg.fnBodyActive {
        return
    }
    if cg.scopeDepth <= 0 || cg.scopeDepth >= len(cg.scopeVars) {
        return
    }
    if str.Len(reg) == 0 || str.Equal(reg, "0") || str.Equal(reg, "null") {
        return
    }
    isComposite := isCompositeType(llType) && !str.EndsWith(llType, "*")
    if !isHeapLLType(llType) && !isComposite {
        return
    }
    alloca := emitAlloca(cg, llType)
    emitStore(cg, llType, reg, llType, alloca)
    sv := ScopeVar{}
    sv.alloca = alloca
    sv.llType = llType
    sv.synType = checker.unknownType()
    cg.tempCounter = cg.tempCounter + 1
    name := str.Concat("$tmp", strconv.Itoa(cg.tempCounter))
    scopeVSet(&cg.scopeVars[cg.scopeDepth], name, sv)
}

// === Memory Management (ARC) ===

// isHeapLLType reports whether an LLVM type is a reference-counted pointer.
fn isHeapLLType(llType: string) -> bool {
    // Template fat-pointer boxes ({data, methodFns...}*) are RC-managed
    // since comp_error.md #95 — coerceToTemplate heap-allocates them so
    // they can escape their creation frame. Only the pointer type is
    // heap; the bare %template.X value type falls through below.
    if str.StartsWith(llType, "%template.") && !str.EndsWith(llType, "*") {
        return false
    }
    // Function pointer types (e.g. "void (i8*, i32)*") are code addresses,
    // not heap-allocated objects — they must not be retained/released.
    if str.EndsWith(llType, ")*") {
        return false
    }
    if str.Equal(llType, "i8*") {
        return true
    }
    if str.EndsWith(llType, "*") {
        return true
    }
    return false
}

// isCompositeType reports whether an LLVM type is a by-value composite type.
fn isCompositeType(llType: string) -> bool {
    if str.StartsWith(llType, "%struct.") {
        return true
    }
    if str.StartsWith(llType, "%map_") {
        return true
    }
    if str.StartsWith(llType, "%set.") {
        return true
    }
    return false
}

// needsArrayDtor returns true if a slice with the given element LLVM type
// holds values that must be released when the slice's backing array is freed.
// structLLKey converts an LLVM composite type name into the key used by
// cg.structLayouts: "%struct.snn_Neuron" -> "snn_Neuron". Non-struct
// composites (maps, sets) strip only the leading "%".
fn structLLKey(elemLLType: string) -> string {
    if str.StartsWith(elemLLType, "%struct.") {
        return str.Substr(elemLLType, str.Len("%struct."), str.Len(elemLLType) - str.Len("%struct."))
    }
    if str.StartsWith(elemLLType, "%") {
        return str.Substr(elemLLType, str.Len("%"), str.Len(elemLLType) - str.Len("%"))
    }
    return elemLLType
}

// needsArrayDtor reports whether a slice backing array of the given element
// type needs a per-element destructor: pointer elements always do, and
// struct-by-value elements do when any field is RC-managed (recursively).
fn needsArrayDtor(cg: *CodeGen, elemLLType: string) -> bool {
    if isHeapLLType(elemLLType) {
        return true
    }
    // Struct-by-value elements: only need a dtor if the struct has heap fields
    if isCompositeType(elemLLType) && !str.EndsWith(elemLLType, "*") {
        // structLayouts is keyed by sanitized name (e.g. "snn_Neuron"), so
        // strip the full "%struct." prefix — stripping only "%" yields
        // "struct.snn_Neuron", which never matches (comp_error.md #99).
        structName := structLLKey(elemLLType)
        layout := cg.structLayouts[structName]
        hasLayout := str.Len(layout.llType) > 0
        if !hasLayout {
            return false
        }
        j := 0
        for j < len(layout.fieldTypes) {
            ft := layout.fieldTypes[j]
            if isHeapLLType(ft) {
                return true
            }
            if isCompositeType(ft) && !str.EndsWith(ft, "*") {
                if needsArrayDtor(cg, ft) {
                    return true
                }
            }
            j = j + 1
        }
    }
    return false
}

// getOrCreateArrayDtor generates (once per element type) a per-element
// destructor function for slices of that element type and returns its name.
// The destructor walks the backing array and releases each element.
fn getOrCreateArrayDtor(cg: *CodeGen, elemLLType: string) -> string {
    if !needsArrayDtor(cg, elemLLType) {
        return ""
    }
    // Cache by element type
    cached := cg.arrayDtors[elemLLType]
    if str.Len(cached) > 0 {
        return cached
    }
    // Use a unique suffix derived from the element type to avoid collisions
    // across modules; sanitize the type into a safe identifier component.
    typeTag := sanitizeLLTypeName(elemLLType)
    dtorName := str.Concat("__array_dtor_", typeTag)
    cg.arrayDtors[elemLLType] = dtorName

    // Emit the destructor into the separate arrayDtorFns buffer so it
    // becomes a top-level function definition, not inline in the current
    // function body.
    b := &cg.arrayDtorFns
    str.Write(b, str.Concat(str.Concat("define void @", dtorName), "(i8* %arr) {\n"))
    str.Write(b, "entry:\n")

    // Read the element scan count at payload - 8 (the RC header's size
    // slot). Slice allocations store their element count there for len();
    // map/set backing arrays store their slot capacity in the same slot
    // (emitMapArrayAlloc/emitSetLiteral). Slots the scan should skip are
    // always null — blocks are memset-zeroed at allocation and delete()
    // nulls released slots — so scanning exactly `count` slots is correct
    // under both conventions. This previously read offset -16, which is
    // the RC magic field: its value (0xDEADBEEFCAFEBABE) is negative as
    // i64, so `count` came out negative, the loop never ran, and every
    // array destructor silently released nothing (comp_error.md #99).
    str.Write(b, "  %cnt_ptr = getelementptr inbounds i8, i8* %arr, i64 -8\n")
    str.Write(b, "  %cnt_ptr.t = bitcast i8* %cnt_ptr to i64*\n")
    str.Write(b, "  %count = load i64, i64* %cnt_ptr.t\n")
    // Cast payload to element pointer
    elemPtrType := str.Concat(elemLLType, "*")
    str.Write(b, str.Concat(str.Concat("  %arr.t = bitcast i8* %arr to ", elemPtrType), "\n"))
    // Loop: for i in 0..count, release element at arr.t[i]
    str.Write(b, "  %i = alloca i64\n")
    str.Write(b, "  store i64 0, i64* %i\n")
    str.Write(b, "  br label %loop.cond\n")
    str.Write(b, "loop.cond:\n")
    str.Write(b, "  %ci = load i64, i64* %i\n")
    str.Write(b, "  %cmp = icmp slt i64 %ci, %count\n")
    str.Write(b, "  br i1 %cmp, label %loop.body, label %loop.end\n")
    str.Write(b, "loop.body:\n")
    // Get element address
    str.Write(b, str.Concat(str.Concat(str.Concat(str.Concat(
        "  %ep = getelementptr ", elemLLType), ", "), elemPtrType), " %arr.t, i64 %ci\n"))
    // Release the element based on its type
    if isHeapLLType(elemLLType) {
        // Pointer element: load and release
        str.Write(b, str.Concat(str.Concat(str.Concat(
            "  %ev = load ", elemLLType), ", "), str.Concat(elemLLType, "* %ep\n")))
        str.Write(b, str.Concat(str.Concat(
            "  %ev.r = bitcast ", elemLLType), " %ev to i8*\n"))
        str.Write(b, "  call void @Skink_rc_release(i8* %ev.r)\n")
    } else if isCompositeType(elemLLType) && !str.EndsWith(elemLLType, "*") {
        // Struct-by-value element: call the struct's dtor trampoline if it has one
        structName := structLLKey(elemLLType)
        layout := cg.structLayouts[structName]
        hasLayout := str.Len(layout.llType) > 0
        if hasLayout && structHasDtorTrampoline(cg, layout) {
            llStructName := str.Substr(layout.llType, str.Len("%struct."), str.Len(layout.llType) - str.Len("%struct."))
            str.Write(b, str.Concat(str.Concat(
                "  %ep.r = bitcast ", elemLLType), "* %ep to i8*\n"))
            str.Write(b, str.Concat(str.Concat(
                "  call void @", llStructName), "__dtor(i8* %ep.r)\n"))
        } else if hasLayout {
            // No dtor fn but has heap fields: generate inline release code
            emitArrayDtorStructFields(b, cg, elemLLType, "%ep", "e")
        }
    }
    str.Write(b, "  %ni = add i64 %ci, 1\n")
    str.Write(b, "  store i64 %ni, i64* %i\n")
    str.Write(b, "  br label %loop.cond\n")
    str.Write(b, "loop.end:\n")
    str.Write(b, "  ret void\n")
    str.Write(b, "}\n\n")
    return dtorName
}

// elemSizeLiteral returns the element size as a compile-time integer.
fn elemSizeLiteral(cg: *CodeGen, elemLLType: string) -> int {
    if str.Equal(elemLLType, "i1") || str.Equal(elemLLType, "i8") {
        return 1
    }
    if str.Equal(elemLLType, "i16") {
        return 2
    }
    if str.Equal(elemLLType, "i32") {
        return 4
    }
    if str.Equal(elemLLType, "i64") || str.Equal(elemLLType, "double") {
        return 8
    }
    if str.Equal(elemLLType, "i8*") {
        return 8
    }
    if str.EndsWith(elemLLType, "*") {
        return 8
    }
    // Struct or composite type: use the layout size. The prefix to strip
    // is "%struct.", "%map_", or "%set." — stripping only "%" left the
    // "struct." component in the key and the layout lookup always missed,
    // silently returning 8 bytes for every struct (which under-allocated
    // escape-box blocks and overflowed them on the copy store).
    structName := ""
    if str.StartsWith(elemLLType, "%struct.") {
        structName = str.Substr(elemLLType, str.Len("%struct."), str.Len(elemLLType) - str.Len("%struct."))
    } else if str.StartsWith(elemLLType, "%map_") || str.StartsWith(elemLLType, "%set.") {
        structName = str.Substr(elemLLType, str.Len("%"), str.Len(elemLLType) - str.Len("%"))
    } else if str.StartsWith(elemLLType, "%") {
        structName = str.Substr(elemLLType, str.Len("%"), str.Len(elemLLType) - str.Len("%"))
    }
    if str.Len(structName) > 0 {
        layout := cg.structLayouts[structName]
        hasLayout := str.Len(layout.llType) > 0
        if hasLayout {
            return layout.size
        }
    }
    return 8
}

// emitArrayDtorStructFields emits inline release code for heap fields of a
// struct-by-value array element, writing directly to the builder buffer.
// The prefix is used to generate unique SSA register names across nesting.
fn emitArrayDtorStructFields(b: *str.Builder, cg: *CodeGen, structLLType: string, basePtr: string, prefix: string) {
    structName := str.Substr(structLLType, str.Len("%struct."), str.Len(structLLType) - str.Len("%struct."))
    layout := cg.structLayouts[structName]
    hasLayout := str.Len(layout.llType) > 0
    if !hasLayout {
        return
    }
    structPtrType := str.Concat(structLLType, "*")
    j := 0
    for j < len(layout.fields) {
        fieldType := layout.fieldTypes[j]
        regBase := str.Concat(str.Concat(prefix, "_f"), strconv.Itoa(j))
        if isHeapLLType(fieldType) {
            // Load field and release
            str.Write(b, str.Concat("  %", str.Concat(regBase, ".ptr = getelementptr ")))
            str.Write(b, structLLType)
            str.Write(b, ", ")
            str.Write(b, structPtrType)
            str.Write(b, " ")
            str.Write(b, basePtr)
            str.Write(b, ", i32 0, i32 ")
            str.Write(b, strconv.Itoa(j))
            str.Write(b, "\n")
            str.Write(b, str.Concat("  %", str.Concat(regBase, ".val = load ")))
            str.Write(b, fieldType)
            str.Write(b, ", ")
            str.Write(b, fieldType)
            str.Write(b, "* %")
            str.Write(b, regBase)
            str.Write(b, ".ptr\n")
            str.Write(b, str.Concat("  %", str.Concat(regBase, ".raw = bitcast ")))
            str.Write(b, fieldType)
            str.Write(b, " %")
            str.Write(b, regBase)
            str.Write(b, ".val to i8*\n")
            str.Write(b, str.Concat("  call void @Skink_rc_release(i8* %", str.Concat(regBase, ".raw)\n")))
        } else if str.StartsWith(fieldType, "%struct.") && !str.EndsWith(fieldType, "*") {
            // Recursively release nested struct fields
            str.Write(b, str.Concat("  %", str.Concat(regBase, ".ptr = getelementptr ")))
            str.Write(b, structLLType)
            str.Write(b, ", ")
            str.Write(b, structPtrType)
            str.Write(b, " ")
            str.Write(b, basePtr)
            str.Write(b, ", i32 0, i32 ")
            str.Write(b, strconv.Itoa(j))
            str.Write(b, "\n")
            emitArrayDtorStructFields(b, cg, fieldType, str.Concat(str.Concat("%", regBase), ".ptr"), regBase)
        }
        j = j + 1
    }
}

// isConstructorExpr reports whether an expression produces a fresh heap
// allocation that already owns a refcount of 1.  Variables and assignments
// must not retain these values, and returns must not retain them on the way
// out of a function, because doing so would leave a leaked reference that
// nothing can ever release.
fn isConstructorExpr(cg: *CodeGen, e: ast.Expr) -> bool {
    if e.kind == ast.EX_ARRAY_LIT || e.kind == ast.EX_MAP_LIT ||
       e.kind == ast.EX_SET_LIT || e.kind == ast.EX_MAKE ||
       e.kind == ast.EX_STRUCT_LIT {
        return true
    }
    if e.kind == ast.EX_INFIX && len(e.infixLeft) > 0 && len(e.infixRight) > 0 {
        if str.Equal(e.infixOp, "+") {
            if str.Equal(exprLLType(cg, e.infixLeft[0]), "i8*") &&
               str.Equal(exprLLType(cg, e.infixRight[0]), "i8*") {
                return true
            }
        }
    }
    if e.kind == ast.EX_CALL && len(e.callFunc) > 0 {
        cf := e.callFunc[0]
        if cf.kind == ast.EX_IDENT {
            name := cf.ident
            if str.Equal(name, "append") {
                return true
            }
            if isHeapLLType(exprCallLLType(cg, e)) {
                if str.StartsWith(name, "str.") || str.StartsWith(name, "buf.") ||
                   str.StartsWith(name, "strconv.") {
                    return true
                }
                if str.Equal(name, "Skink_mem_alloc") ||
                   str.Equal(name, "Skink_mem_calloc") ||
                   str.Equal(name, "Skink_mem_realloc") {
                    return true
                }
                if str.Equal(name, "libc.malloc") ||
                   str.Equal(name, "libc.calloc") ||
                   str.Equal(name, "libc.realloc") {
                    return true
                }
            }
        } else if cf.kind == ast.EX_FIELD && len(cf.fieldTarget) > 0 {
            fnName := ""
            if cf.fieldTarget[0].kind == ast.EX_IDENT {
                fnName = str.Concat(cf.fieldTarget[0].ident, str.Concat(".", cf.fieldName))
            }
            if isHeapLLType(exprCallLLType(cg, e)) {
                if str.StartsWith(fnName, "str.") || str.StartsWith(fnName, "buf.") ||
                   str.StartsWith(fnName, "strconv.") {
                    return true
                }
            }
        }
    }
    return false
}

// emitRetain emits a Skink_rc_retain call for a heap value and returns the
// (still valid) register. Non-i8* heap types are bitcast for the call.
fn emitRetain(cg: *CodeGen, reg: string, llType: string) -> string {
    if !isHeapLLType(llType) {
        return reg
    }
    // Retaining a null pointer is a no-op in the runtime; skip the call
    // entirely to avoid emitting invalid "i8* 0" LLVM IR.
    if str.Equal(reg, "0") || str.Equal(reg, "null") {
        return reg
    }
    src := reg
    if !str.Equal(llType, "i8*") {
        src = nextReg(cg)
        emitfmt(cg, "  %s = bitcast %s %s to i8*\n", []string{src, llType, reg})
    }
    emitfmt(cg, "  call i8* @Skink_rc_retain(i8* %s)\n", []string{src})
    return reg
}

// emitRetainStructHeapFields retains all heap-allocated fields of a struct
// value, including nested struct-by-value fields. This is needed before
// deallocations to prevent use-after-free when local variables stored in
// struct fields are released.
fn emitRetainStructHeapFields(cg: *CodeGen, valReg: string, structLLType: string) -> string {
    if !str.StartsWith(structLLType, "%struct.") && !str.StartsWith(structLLType, "%map_") && !str.StartsWith(structLLType, "%set.") {
        return valReg
    }
    if str.EndsWith(structLLType, "*") {
        return valReg
    }
    // Get the struct name (strip %struct. prefix or %map_/%set. prefix)
    structName := ""
    if str.StartsWith(structLLType, "%struct.") {
        structName = str.Substr(structLLType, str.Len("%struct."), str.Len(structLLType) - str.Len("%struct."))
    } else if str.StartsWith(structLLType, "%map_") || str.StartsWith(structLLType, "%set.") {
        structName = str.Substr(structLLType, str.Len("%"), str.Len(structLLType) - str.Len("%"))
    }
    layout := cg.structLayouts[structName]
    hasLayout := str.Len(layout.llType) > 0
    if !hasLayout {
        return valReg
    }
    // Store struct in temp alloca, retain each heap field, then reload
    tmpAlloca := emitAlloca(cg, structLLType)
    emitStore(cg, structLLType, valReg, structLLType, tmpAlloca)
    structPtrType := str.Concat(structLLType, "*")
    i := 0
    for i < len(layout.fields) {
        fieldType := layout.fieldTypes[i]
        if isHeapLLType(fieldType) {
            indices := []string{}
            indices = append(indices, "i32 0")
            indices = append(indices, str.Concat("i32 ", strconv.Itoa(i)))
            fieldPtr := emitGEP(cg, structLLType, structPtrType, tmpAlloca, indices)
            fieldVal := emitLoad(cg, fieldType, fieldType, fieldPtr)
            retained := emitRetain(cg, fieldVal, fieldType)
            emitStore(cg, fieldType, retained, fieldType, fieldPtr)
        } else if str.StartsWith(fieldType, "%struct.") && !str.EndsWith(fieldType, "*") {
            // Recursively retain heap fields of nested struct-by-value fields
            indices := []string{}
            indices = append(indices, "i32 0")
            indices = append(indices, str.Concat("i32 ", strconv.Itoa(i)))
            fieldPtr := emitGEP(cg, structLLType, structPtrType, tmpAlloca, indices)
            fieldVal := emitLoad(cg, fieldType, fieldType, fieldPtr)
            retained := emitRetainStructHeapFields(cg, fieldVal, fieldType)
            emitStore(cg, fieldType, retained, fieldType, fieldPtr)
        }
        i = i + 1
    }
    reloaded := emitLoad(cg, structLLType, structLLType, tmpAlloca)
    return reloaded
}

// emitRelease emits a Skink_rc_release call for a heap value.
// Non-i8* heap types are bitcast for the call.
fn emitRelease(cg: *CodeGen, reg: string, llType: string) {
    if !isHeapLLType(llType) {
        return
    }
    // Releasing a null pointer is a no-op in the runtime; skip the call
    // entirely to avoid emitting invalid "i8* 0" LLVM IR.
    if str.Equal(reg, "0") || str.Equal(reg, "null") {
        return
    }
    src := reg
    if !str.Equal(llType, "i8*") {
        src = nextReg(cg)
        emitfmt(cg, "  %s = bitcast %s %s to i8*\n", []string{src, llType, reg})
    }
    emitfmt(cg, "  call void @Skink_rc_release(i8* %s)\n", []string{src})
}

// emitDeallocationsForScope emits release calls for all live variables in a scope.
fn emitDeallocationsForScope(cg: *CodeGen, scopeIdx: int) {
    if scopeIdx < 0 || scopeIdx >= len(cg.scopeVars) {
        return
    }
    scope := &cg.scopeVars[scopeIdx]
    i := 0
    for i < len(scope.names) {
        name := scope.names[i]
        v := scopeVGet(scope, name)
        if v.escaped {
            // Boxed variable: release the variable's reference on the RC
            // heap block (whose destructor frees any heap fields). Other
            // `&x` holders keep the block alive via their own references.
            ptrType := str.Concat(v.llType, "*")
            boxPtr := emitLoad(cg, ptrType, ptrType, v.heapSlot)
            emitRelease(cg, boxPtr, ptrType)
            i = i + 1
            continue
        }
        if v.borrowed {
            i = i + 1
            continue
        }
        if isHeapLLType(v.llType) {
            // Release heap-allocated pointer variables (strings, slices, maps).
            loaded := emitLoad(cg, v.llType, v.llType, v.alloca)
            emitRelease(cg, loaded, v.llType)
        } else if isCompositeType(v.llType) && !str.EndsWith(v.llType, "*") {
            // Struct-by-value variables: release heap-allocated fields
            // (strings, slices, pointers) directly. Stack structs don't
            // go through the RC system, so their fields must be released
            // manually when the variable goes out of scope.
            emitReleaseStructHeapFields(cg, v.alloca, v.llType)
        }
        i = i + 1
    }
}

// emitReleaseStructHeapFields releases all heap-allocated fields of a
// struct-by-value variable stored at the given alloca address.
fn emitReleaseStructHeapFields(cg: *CodeGen, allocaReg: string, structLLType: string) {
    if str.Equal(allocaReg, "") || str.Equal(allocaReg, "0") {
        return
    }
    if !str.StartsWith(structLLType, "%struct.") && !str.StartsWith(structLLType, "%map_") && !str.StartsWith(structLLType, "%set.") {
        return
    }
    if str.EndsWith(structLLType, "*") {
        return
    }
    // Get the struct name (strip %struct. prefix or %map_/%set. prefix)
    structName := ""
    if str.StartsWith(structLLType, "%struct.") {
        structName = str.Substr(structLLType, str.Len("%struct."), str.Len(structLLType) - str.Len("%struct."))
    } else if str.StartsWith(structLLType, "%map_") {
        structName = str.Substr(structLLType, str.Len("%"), str.Len(structLLType) - str.Len("%"))
    } else if str.StartsWith(structLLType, "%set.") {
        structName = str.Substr(structLLType, str.Len("%"), str.Len(structLLType) - str.Len("%"))
    }
    layout := cg.structLayouts[structName]
    hasLayout := str.Len(layout.llType) > 0
    if !hasLayout {
        return
    }
    structPtrType := str.Concat(structLLType, "*")
    j := 0
    for j < len(layout.fields) {
        fieldType := layout.fieldTypes[j]
        if isHeapLLType(fieldType) {
            indices := []string{}
            indices = append(indices, "i32 0")
            indices = append(indices, str.Concat("i32 ", strconv.Itoa(j)))
            fieldPtr := emitGEP(cg, structLLType, structPtrType, allocaReg, indices)
            fieldVal := emitLoad(cg, fieldType, fieldType, fieldPtr)
            emitRelease(cg, fieldVal, fieldType)
        } else if str.StartsWith(fieldType, "%struct.") && !str.EndsWith(fieldType, "*") {
            // Nested struct-by-value field: prefer the field's own dtor
            // trampoline when one exists — it runs the user's Drop method
            // (needed for structs holding non-RC resources like sync
            // primitives) AND releases the nested heap fields. Only fall
            // back to a manual recursive heap-field release for structs
            // without a trampoline.
            indices := []string{}
            indices = append(indices, "i32 0")
            indices = append(indices, str.Concat("i32 ", strconv.Itoa(j)))
            fieldPtr := emitGEP(cg, structLLType, structPtrType, allocaReg, indices)
            nestedName := structLLKey(fieldType)
            nestedLayout := cg.structLayouts[nestedName]
            nestedHasLayout := str.Len(nestedLayout.llType) > 0
            if nestedHasLayout && structHasDtorTrampoline(cg, nestedLayout) {
                nestedDtorName := str.Concat(str.Substr(nestedLayout.llType, str.Len("%struct."), str.Len(nestedLayout.llType) - str.Len("%struct.")), "__dtor")
                fieldRaw := nextReg(cg)
                emitfmt(cg, "  %s = bitcast %s %s to i8*\n", []string{fieldRaw, str.Concat(fieldType, "*"), fieldPtr})
                emitln(cg, str.Concat(str.Concat(str.Concat("  call void @", nestedDtorName), str.Concat("(i8* ", fieldRaw)), ")\n"))
            } else {
                emitReleaseStructHeapFields(cg, fieldPtr, fieldType)
            }
        }
        j = j + 1
    }
}

// emitAllDeallocations emits release calls for all live variables across scopes.
fn emitAllDeallocations(cg: *CodeGen) {
    // Release all scopes EXCEPT scope 0 (function parameters).
    // Parameters are borrowed — the caller owns them. Only locally-declared
    // variables that are not borrowed are released.
    i := cg.scopeDepth
    for i > 0 {
        emitDeallocationsForScope(cg, i)
        i = i - 1
    }
}

// === LLVM Type Mapping ===

// llvmType converts a checker.TType to its LLVM IR type string.
// paramLLType converts a parameter LLVM type to the ABI convention:
// composite by-value types are passed as pointers to avoid excessive
// stack usage in recursive functions.
fn paramLLType(llType: string) -> string {
    if isCompositeType(llType) && !str.EndsWith(llType, "*") {
        return str.Concat(llType, "*")
    }
    return llType
}

// llvmType converts a checker type to its LLVM IR type string.
fn llvmType(cg: *CodeGen, t: checker.TType) -> string {
    if t.kind == 0 {
        return "void"
    }
    if t.kind == checker.TK_BUILTIN { return builtinLLType(t.name) }
    if t.kind == checker.TK_POINTER { return str.Concat(llvmType(cg, checker.typeOptT(t.elem)), "*") }
    if t.kind == checker.TK_ARRAY { return str.Concat(llvmType(cg, checker.typeOptT(t.elem)), "*") }
    if t.kind == checker.TK_SET { return setLLType(cg, llvmType(cg, checker.typeOptT(t.elem))) }
    if t.kind == checker.TK_MAP { return mapLLType(cg, llvmType(cg, checker.typeOptT(t.keyType)), llvmType(cg, checker.typeOptT(t.elem))) }
    if t.kind == checker.TK_CHAN { return "i8*" }
    if t.kind == checker.TK_TENSOR { return "i8*" }
    if t.kind == checker.TK_NAMED {
        // future<T> handles are opaque i8* pointers produced by async.
        if str.Equal(t.name, "future") { return "i8*" }
        // Resolve type aliases (e.g. type Handler = fn(...) -> TK_FUNCTION)
        // before falling back to opaque struct naming. Without this, function
        // type aliases would be emitted as %struct.<name> which is invalid.
        resolved := resolveAliasCG(cg, t)
        if resolved.kind != checker.TK_NAMED {
            return llvmType(cg, resolved)
        }
        return namedLLType(cg, t.name)
    }
    if t.kind == checker.TK_TEMPLATE { return templateLLTypePtr(t.name) }
    // Function values are uniform i8* closure handles: a pointer to a
    // block whose first field is the code pointer. Capturing literals
    // store captured-variable boxes in the remaining fields; the handle
    // itself is passed to the callee as a hidden env argument.
    if t.kind == checker.TK_FUNCTION { return "i8*" }
    if t.kind == checker.TK_TUPLE { return tupleLLType(cg, t) }
    if t.kind == checker.TK_NIL { return "i8*" }
    if t.kind == checker.TK_ANY { return "i8*" }
    if t.kind == checker.TK_UNKNOWN { return "i8*" }
    if t.kind == checker.TK_ERROR { return "%struct.errors_Error" }
    if t.kind == checker.TK_TAGGED_UNION { return str.Concat("%", sanitizeName(t.name)) }
    return "i8*"
}

// builtinLLType returns the LLVM type string for a builtin type name.
fn builtinLLType(name: string) -> string {
    if str.Equal(name, "int") { return "i32" }
    if str.Equal(name, "int32") { return "i32" }
    if str.Equal(name, "uint") { return "i32" }
    if str.Equal(name, "uint32") { return "i32" }
    if str.Equal(name, "int8") { return "i8" }
    if str.Equal(name, "uint8") { return "i8" }
    if str.Equal(name, "byte") { return "i8" }
    if str.Equal(name, "int16") { return "i16" }
    if str.Equal(name, "uint16") { return "i16" }
    if str.Equal(name, "int64") { return "i64" }
    if str.Equal(name, "uint64") { return "i64" }
    if str.Equal(name, "float") { return "double" }
    if str.Equal(name, "bool") { return "i1" }
    if str.Equal(name, "string") { return "i8*" }
    if str.Equal(name, "bytes") { return "i8*" }
    if str.Equal(name, "void") { return "void" }
    return "i8*"
}

// setLLType returns the LLVM pointer type for a set of the given element type,
// ensuring the %set.<elem> struct type declaration is emitted in the module
// header (comp_error.md #138).
fn setLLType(cg: *CodeGen, elemLL: string) -> string {
    if str.Len(elemLL) == 0 || str.Equal(elemLL, "void") {
        elemLL = "i8*"
    }
    name := setTypeName(elemLL)
    emitSetTypeDecl(cg, name, elemLL)
    return str.Concat("%", str.Concat(name, "*"))
}

// setTypeName returns the LLVM struct name for a set of the given element type.
fn setTypeName(elemLL: string) -> string {
    sanitized := sanitizeLLTypeName(elemLL)
    return str.Concat("set.", sanitized)
}

// emitSetTypeDecl emits the LLVM type declaration for a set struct.
// A set is represented as { elem*, i32 } (data pointer + count).
fn emitSetTypeDecl(cg: *CodeGen, name: string, elemLL: string) {
    has := mapStringBoolHasKeyCG(cg.setTypes, name)
    if has {
        return
    }
    cg.setTypes[name] = true
    parts := []string{}
    parts = append(parts, "%")
    parts = append(parts, name)
    parts = append(parts, " = type { ")
    parts = append(parts, elemLL)
    parts = append(parts, "*, i32 }\n")
    emitHeader(cg, concatMany(parts))
}

// mapLLType returns the LLVM pointer type for a map with the given key/value
// types, ensuring the %map_<key>__<val> struct type declaration is emitted in
// the module header (comp_error.md #138).
fn mapLLType(cg: *CodeGen, keyLL: string, valLL: string) -> string {
    if str.Len(keyLL) == 0 || str.Equal(keyLL, "void") {
        keyLL = "i8*"
    }
    if str.Len(valLL) == 0 || str.Equal(valLL, "void") {
        valLL = "i8*"
    }
    name := mapTypeName(keyLL, valLL)
    emitMapTypeDecl(cg, name, keyLL, valLL)
    return str.Concat("%", str.Concat(name, "*"))
}

// namedLLType resolves a named type to its LLVM type string.
fn namedLLType(cg: *CodeGen, name: string) -> string {
    // Check if it's a tagged union
    hasTU := mapStringDeclHasKeyTU(cg.taggedUnions, name)
    if hasTU {
        return str.Concat("%", sanitizeName(name))
    }
    // Check if it's a known struct
    layout := cg.structLayouts[name]
    hasLayout := str.Len(layout.llType) > 0
    if hasLayout {
        return layout.llType
    }
    // If unqualified, try qualifying with current module
    if !str.Contains(name, ".") && str.Len(cg.currentModule) > 0 {
        qualified := str.Concat(cg.currentModule, str.Concat(".", name))
        qlayout := cg.structLayouts[qualified]
        qhasLayout := str.Len(qlayout.llType) > 0
        if qhasLayout {
            return qlayout.llType
        }
    }
    // If qualified, also try the short (unqualified) name for imported types
    if str.Contains(name, ".") {
        dot := str.LastIndexOf(name, ".")
        if dot >= 0 {
            short := str.Substr(name, dot + 1, str.Len(name) - dot - 1)
            slayout := cg.structLayouts[short]
            shasLayout := str.Len(slayout.llType) > 0
            if shasLayout {
                return slayout.llType
            }
            // Also try the sanitized short name
            sanitizedShort := sanitizeName(short)
            sanlayout := cg.structLayouts[sanitizedShort]
            sanhasLayout := str.Len(sanlayout.llType) > 0
            if sanhasLayout {
                return sanlayout.llType
            }
        }
    }
    // Template types → fat pointer struct (data + method function pointers)
    hasTmpl := checker.hasTemplate(cg.checker, name)
    if hasTmpl {
        return templateLLTypePtr(name)
    }
    // Module-qualified types: replace dots with underscores
    if str.Contains(name, ".") {
        return str.Concat("%struct.", sanitizeName(name))
    }
    // Generic type parameters (unqualified, not a known struct/tagged-union)
    // are erased to opaque pointers. This matches the Go compiler's behavior
    // after monomorphization replaces T with concrete types; when emitting
    // a library module standalone, generic functions remain with T as i8*.
    return "i8*"
}

// === Tagged union helpers ===

// tuLLName returns the LLVM struct type name for a tagged union.
fn tuLLName(name: string) -> string {
    return str.Concat("%", sanitizeName(name))
}

// mapStringDeclHasKeyTU2 reports whether m contains key (tagged-union
// variant map — same shape as mapStringDeclHasKeyTU but for tuVariantDecl).
fn mapStringDeclHasKeyTU2(m: map[string]ast.Decl, key: string) -> bool {
    v := m[key]
    return str.Len(v.enumName) > 0
}

// tuVariantIndex returns the index of variant `vname` in decl d, or -1.
fn tuVariantIndex(d: ast.Decl, vname: string) -> int {
    i := 0
    for i < len(d.enumVariants) {
        if str.Equal(d.enumVariants[i].name, vname) {
            return i
        }
        i = i + 1
    }
    return -1
}

// tuPayloadLLType builds the payload struct type "{ double, double }"
// for variant vidx of decl d, or "" when the variant has no payloads.
fn tuPayloadLLType(cg: *CodeGen, d: ast.Decl, vidx: int) -> string {
    v := d.enumVariants[vidx]
    if len(v.payloads) == 0 {
        return ""
    }
    parts := []string{}
    j := 0
    for j < len(v.payloads) {
        pt := checker.astTypeToType(cg.checker, v.payloads[j])
        parts = append(parts, llvmType(cg, pt))
        j = j + 1
    }
    return str.Concat("{ ", str.Concat(str.Join(parts, ", "), " }"))
}

// tuPayloadBytes returns the payload-area byte size N for a tagged union
// decl: the maximum over variants of their packed payload struct size,
// with a floor of 8 so tag-only unions still allocate a payload slot.
fn tuPayloadBytes(cg: *CodeGen, d: ast.Decl) -> int {
    maxBytes := 8
    j := 0
    for j < len(d.enumVariants) {
        v := d.enumVariants[j]
        if len(v.payloads) == 0 {
            j = j + 1
            continue
        }
        size := 0
        align := 8
        k := 0
        for k < len(v.payloads) {
            pt := checker.astTypeToType(cg.checker, v.payloads[k])
            es, ea := typeSizeAndAlign(cg, pt)
            size = alignUp(size, ea)
            size = size + es
            if ea > align {
                align = ea
            }
            k = k + 1
        }
        size = alignUp(size, align)
        if size > maxBytes {
            maxBytes = size
        }
        j = j + 1
    }
    return maxBytes
}

// emitTUTypeDecl emits `%Name = type { i32, [N x i8] }` for a tagged union.
fn emitTUTypeDecl(cg: *CodeGen, d: ast.Decl) {
    n := tuPayloadBytes(cg, d)
    emitHeader(cg, str.Concat(tuLLName(d.enumName), str.Concat(" = type { i32, [", str.Concat(strconv.Itoa(n), " x i8] }\n"))))
}

// lookupTUForLL resolves an LLVM type name like "%Shape" or "%foo_Shape"
// back to the tagged-union decl, if any.
fn lookupTUForLL(cg: *CodeGen, llType: string) -> (ast.Decl, bool) {
    if !str.StartsWith(llType, "%") {
        return ast.Decl{}, false
    }
    name := str.Substr(llType, 1, str.Len(llType) - 1)
    d := cg.taggedUnions[name]
    if mapStringDeclHasKeyTU(cg.taggedUnions, name) {
        return d, true
    }
    // Try unsanitizing dots: "foo_Shape" -> "foo.Shape"
    dotIdx := str.IndexOf(name, "_")
    for dotIdx >= 0 {
        candidate := str.Concat(str.Substr(name, 0, dotIdx), str.Concat(".", str.Substr(name, dotIdx + 1, str.Len(name) - dotIdx - 1)))
        if mapStringDeclHasKeyTU(cg.taggedUnions, candidate) {
            return cg.taggedUnions[candidate], true
        }
        nextIdx := str.IndexOf(str.Substr(name, dotIdx + 1, str.Len(name) - dotIdx - 1), "_")
        if nextIdx < 0 {
            break
        }
        dotIdx = dotIdx + 1 + nextIdx
    }
    return ast.Decl{}, false
}

// emitTUCtor emits a tagged-union constructor call: Variant(payloads...).
fn emitTUCtor(cg: *CodeGen, fnName: string, args: []ast.Expr) -> string {
    d := cg.tuVariantDecl[fnName]
    vidx := cg.tuVariantIdx[fnName]
    tuLL := tuLLName(d.enumName)
    n := tuPayloadBytes(cg, d)
    tmp := emitAlloca(cg, tuLL)
    tagPtr := nextReg(cg)
    emitfmt(cg, "  %s = getelementptr inbounds %s, %s* %s, i32 0, i32 0\n", []string{tagPtr, tuLL, tuLL, tmp})
    emitStore(cg, "i32", strconv.Itoa(vidx), "i32", tagPtr)
    payArrLL := str.Concat("[", str.Concat(strconv.Itoa(n), " x i8]"))
    payPtr := nextReg(cg)
    emitfmt(cg, "  %s = getelementptr inbounds %s, %s* %s, i32 0, i32 1\n", []string{payPtr, tuLL, tuLL, tmp})
    emitfmt(cg, "  store %s zeroinitializer, %s* %s\n", []string{payArrLL, payArrLL, payPtr})
    v := d.enumVariants[vidx]
    if len(v.payloads) > 0 {
        payStruct := tuPayloadLLType(cg, d, vidx)
        payTyped := nextReg(cg)
        emitfmt(cg, "  %s = bitcast %s* %s to %s*\n", []string{payTyped, payArrLL, payPtr, payStruct})
        j := 0
        for j < len(v.payloads) && j < len(args) {
            argReg := emitExpression(cg, args[j])
            pt := checker.astTypeToType(cg.checker, v.payloads[j])
            argLL := llvmType(cg, pt)
            argReg = coerceExprToParamType(cg, argReg, exprLLType(cg, args[j]), argLL, args[j])
            if isHeapLLType(argLL) {
                argReg = emitRetain(cg, argReg, argLL)
            }
            fptr := nextReg(cg)
            emitfmt(cg, "  %s = getelementptr inbounds %s, %s* %s, i32 0, i32 %s\n", []string{fptr, payStruct, payStruct, payTyped, strconv.Itoa(j)})
            emitStore(cg, argLL, argReg, argLL, fptr)
            j = j + 1
        }
    }
    res := emitLoad(cg, tuLL, tuLL, tmp)
    return res
}

// emitTUBareVariant emits a payload-less variant used as a value
// (e.g. `s := None` for a tagged union).
fn emitTUBareVariant(cg: *CodeGen, name: string) -> string {
    d := cg.tuVariantDecl[name]
    vidx := cg.tuVariantIdx[name]
    n := tuPayloadBytes(cg, d)
    tuLL := tuLLName(d.enumName)
    tmp := emitAlloca(cg, tuLL)
    tagPtr := nextReg(cg)
    emitfmt(cg, "  %s = getelementptr inbounds %s, %s* %s, i32 0, i32 0\n", []string{tagPtr, tuLL, tuLL, tmp})
    emitStore(cg, "i32", strconv.Itoa(vidx), "i32", tagPtr)
    payArrLL := str.Concat("[", str.Concat(strconv.Itoa(n), " x i8]"))
    payPtr := nextReg(cg)
    emitfmt(cg, "  %s = getelementptr inbounds %s, %s* %s, i32 0, i32 1\n", []string{payPtr, tuLL, tuLL, tmp})
    emitfmt(cg, "  store %s zeroinitializer, %s* %s\n", []string{payArrLL, payArrLL, payPtr})
    loaded := nextReg(cg)
    emitfmt(cg, "  %s = load %s, %s* %s\n", []string{loaded, tuLL, tuLL, tmp})
    return loaded
}

// templateLLTypePtr returns the LLVM pointer type for a template fat pointer.
// Template-typed values are represented as { i8* data, i8* fn1, i8* fn2, ... }*.
fn templateLLTypePtr(templateName: string) -> string {
    return str.Concat("%template.", str.Concat(sanitizeName(templateName), "*"))
}

// templateLLTypeStruct returns the LLVM struct type (without trailing *) for a template.
fn templateLLTypeStruct(templateName: string) -> string {
    return str.Concat("%template.", sanitizeName(templateName))
}

// findTemplateByLLType finds the template name from an LLVM type like "%template.reader_Reader*".
fn findTemplateByLLType(cg: *CodeGen, llType: string) -> (string, bool) {
    prefix := "%template."
    if !str.StartsWith(llType, prefix) {
        return "", false
    }
    rest := str.Substr(llType, str.Len(prefix), str.Len(llType) - str.Len(prefix))
    if str.EndsWith(rest, "*") {
        rest = str.Substr(rest, 0, str.Len(rest) - 1)
    }
    names := checker.templateNames(cg.checker)
    i := 0
    for i < len(names) {
        if str.Equal(sanitizeName(names[i]), rest) {
            return names[i], true
        }
        i = i + 1
    }
    return "", false
}

// findConcreteMethodFnName finds the qualified function name for a method on a concrete type.
// structLLName is the sanitized struct name from the LLVM type (e.g. "buf_Buffer").
fn findConcreteMethodFnName(cg: *CodeGen, structLLName: string, methodName: string) -> string {
    // Try sanitized form (e.g. "buf_Buffer.Read")
    c1 := str.Concat(structLLName, str.Concat(".", methodName))
    if mapStringStringSliceHasKeyCG(cg.fnRetTypes, c1) {
        return c1
    }
    // Try with dots instead of underscores (e.g. "buf.Buffer.Read")
    dotName := str.Replace(structLLName, "_", ".")
    c2 := str.Concat(dotName, str.Concat(".", methodName))
    if mapStringStringSliceHasKeyCG(cg.fnRetTypes, c2) {
        return c2
    }
    // Try short name (without module prefix)
    dotIdx := str.IndexOf(structLLName, "_")
    if dotIdx > 0 {
        shortName := str.Substr(structLLName, dotIdx + 1, str.Len(structLLName) - dotIdx - 1)
        c3 := str.Concat(shortName, str.Concat(".", methodName))
        if mapStringStringSliceHasKeyCG(cg.fnRetTypes, c3) {
            return c3
        }
    }
    // Fallback: module or type names containing underscores make the
    // sanitized form ambiguous (e.g. "template_escape_test_Alpha" could
    // come from "template_escape_test.Alpha" or "template.escape_test.Alpha").
    // Scan for a function whose receiver portion re-sanitizes to the
    // struct LLVM name — the only unambiguous mapping.
    wantSuffix := str.Concat(".", methodName)
    for k in cg.fnRetTypes {
        if str.EndsWith(k, wantSuffix) {
            recvPart := str.Substr(k, 0, str.Len(k) - str.Len(wantSuffix))
            if str.Equal(sanitizeName(recvPart), structLLName) {
                return k
            }
            // UFCS free function `mod.Write(self: *T, ...)` where the
            // module name itself contains underscores: sanitizeName(mod)
            // is a prefix of the struct's sanitized LLVM name
            // ("writer_template_0001" vs "writer_template_0001_StringBuilder").
            // The first parameter must actually take this struct type —
            // otherwise a shorter module prefix could shadow the real
            // receiver module.
            if str.StartsWith(structLLName, str.Concat(sanitizeName(recvPart), "_")) {
                ps := cg.fnParamTypes[k]
                if len(ps) > 0 {
                    p0 := ps[0]
                    for str.EndsWith(p0, "*") {
                        p0 = str.Substr(p0, 0, str.Len(p0) - 1)
                    }
                    if str.Equal(p0, str.Concat("%struct.", structLLName)) {
                        return k
                    }
                }
            }
        }
    }
    return ""
}

// coerceToTemplate creates a fat pointer from a concrete value for a template parameter.
fn coerceToTemplate(cg: *CodeGen, argReg: string, argType: string, paramType: string) -> string {
    tmplName, ok := findTemplateByLLType(cg, paramType)
    if !ok {
        return argReg
    }
    tmpl := checker.getTemplate(cg.checker, tmplName)
    // Extract concrete struct name from argType (e.g. "%struct.buf_Buffer*" -> "buf_Buffer")
    // Strip all trailing * to handle double-pointer cases (e.g. "%struct.foo_Bar**"
    // when the struct is heap-allocated and passed by address-of).
    structLLName := ""
    if str.StartsWith(argType, "%struct.") {
        structLLName = str.Substr(argType, str.Len("%struct."), str.Len(argType) - str.Len("%struct."))
        for str.EndsWith(structLLName, "*") {
            structLLName = str.Substr(structLLName, 0, str.Len(structLLName) - 1)
        }
    }
    // Allocate the template struct on the heap with a destructor that
    // releases the boxed data pointer — the fat pointer may outlive this
    // frame (stored in a slice, field, or returned), so a stack alloca
    // would dangle (comp_error.md #95).
    structType := templateLLTypeStruct(tmplName)
    boxSize := strconv.Itoa((1 + len(tmpl.templateMethods)) * 8)
    rawBox := nextReg(cg)
    emitfmt(cg, "  %s = call i8* @Skink_rc_alloc_typed(i64 %s, i8* bitcast (void (i8*)* @Skink_template_box_dtor to i8*))\n",
        []string{rawBox, boxSize})
    alloc := nextReg(cg)
    emitfmt(cg, "  %s = bitcast i8* %s to %s*\n", []string{alloc, rawBox, structType})
    // Store data pointer (bitcast argReg to i8*) at field 0 — retain it
    // first so the box owns a reference independent of the caller's temp.
    dataGEP := nextReg(cg)
    emitfmt(cg, "  %s = getelementptr inbounds %s, %s* %s, i32 0, i32 0\n",
        []string{dataGEP, structType, structType, alloc})
    dataCast := nextReg(cg)
    emitfmt(cg, "  %s = bitcast %s %s to i8*\n", []string{dataCast, argType, argReg})
    if isHeapLLType(argType) {
        dataCast = emitRetain(cg, dataCast, "i8*")
    }
    emitfmt(cg, "  store i8* %s, i8** %s\n", []string{dataCast, dataGEP})
    // Store each method function pointer
    i := 0
    for i < len(tmpl.templateMethods) {
        methodName := tmpl.templateMethods[i].fnName
        concreteFnName := ""
        if str.Len(structLLName) > 0 {
            concreteFnName = findConcreteMethodFnName(cg, structLLName, methodName)
        }
        if str.Len(concreteFnName) > 0 {
            fnGEP := nextReg(cg)
            emitfmt(cg, "  %s = getelementptr inbounds %s, %s* %s, i32 0, i32 %s\n",
                []string{fnGEP, structType, structType, alloc, strconv.Itoa(i + 1)})
            fnCast := nextReg(cg)
            emitfmt(cg, "  %s = bitcast void ()* @%s to i8*\n", []string{fnCast, concreteFnName})
            emitfmt(cg, "  store i8* %s, i8** %s\n", []string{fnCast, fnGEP})
        }
        i = i + 1
    }
    return alloc
}

// llTypeToSkinkName converts an LLVM type string to the corresponding
// Skink type name for reflect metadata.
fn llTypeToSkinkName(llType: string) -> string {
    if str.Equal(llType, "i1") { return "bool" }
    if str.Equal(llType, "i8") { return "int8" }
    if str.Equal(llType, "i16") { return "int16" }
    if str.Equal(llType, "i32") { return "int" }
    if str.Equal(llType, "i64") { return "int64" }
    if str.Equal(llType, "double") { return "float" }
    if str.Equal(llType, "i8*") { return "string" }
    if str.Equal(llType, "i1*") { return "*bool" }
    if str.Equal(llType, "i16*") { return "*int16" }
    if str.Equal(llType, "i32*") { return "*int" }
    if str.Equal(llType, "i64*") { return "*int64" }
    if str.Equal(llType, "double*") { return "*float" }
    if str.Equal(llType, "i8**") { return "*string" }
    // Struct types: strip the %struct. prefix and convert trailing *
    // indirections into leading * prefixes so *T ("*Inner") is distinct
    // from inline T ("Inner") in reflect.Field.type_name (comp_error.md #135).
    if str.StartsWith(llType, "%struct.") {
        name := str.Substr(llType, str.Len("%struct."), str.Len(llType) - str.Len("%struct."))
        stars := ""
        for str.EndsWith(name, "*") {
            stars = str.Concat(stars, "*")
            name = str.Substr(name, 0, str.Len(name) - 1)
        }
        return str.Concat(stars, name)
    }
    return llType
}

// skinkTypeName formats a semantic checker type into the Skink type name
// reported by reflect.Field.type_name, preserving the distinction between
// slices ([]T) and pointers (*T) that both lower to elemLL* in LLVM IR
// (comp_error.md #137).
fn skinkTypeName(cg: *CodeGen, ft: checker.TType, fLL: string) -> string {
    resolved := resolveAliasCG(cg, ft)
    if resolved.kind != ft.kind {
        ft = resolved
    }
    if ft.kind == checker.TK_ARRAY {
        elemT := checker.typeOptT(ft.elem)
        elemLL := llvmType(cg, elemT)
        return str.Concat("[]", skinkTypeName(cg, elemT, elemLL))
    }
    if ft.kind == checker.TK_POINTER {
        elemT := checker.typeOptT(ft.elem)
        elemLL := llvmType(cg, elemT)
        return str.Concat("*", skinkTypeName(cg, elemT, elemLL))
    }
    if ft.kind == checker.TK_MAP {
        keyT := checker.typeOptT(ft.keyType)
        valT := checker.typeOptT(ft.elem)
        return str.Concat("map[", str.Concat(skinkTypeName(cg, keyT, llvmType(cg, keyT)), str.Concat("]", skinkTypeName(cg, valT, llvmType(cg, valT)))))
    }
    if ft.kind == checker.TK_SET {
        elemT := checker.typeOptT(ft.elem)
        return str.Concat("set<", str.Concat(skinkTypeName(cg, elemT, llvmType(cg, elemT)), ">"))
    }
    return llTypeToSkinkName(fLL)
}

// emitReflectTypeOf generates inline type info for reflect.TypeOf<T>(arg).
// It creates a reflect.Type struct with the correct name, size, and fields
// based on the generic type argument T.
fn emitReflectTypeOf(cg: *CodeGen, e: ast.Expr) -> string {
    if len(e.genericArgs) == 0 {
        return "0"
    }
    typeArg := e.genericArgs[0]
    typeName := typeArg.name

    // Determine size
    sizeVal := 8
    if str.Equal(typeName, "int") || str.Equal(typeName, "uint") || str.Equal(typeName, "int32") || str.Equal(typeName, "uint32") {
        sizeVal = 4
    } else if str.Equal(typeName, "int8") || str.Equal(typeName, "uint8") || str.Equal(typeName, "bool") {
        sizeVal = 1
    } else if str.Equal(typeName, "int16") || str.Equal(typeName, "uint16") {
        sizeVal = 2
    } else if str.Equal(typeName, "int64") || str.Equal(typeName, "uint64") {
        sizeVal = 8
    } else if str.Equal(typeName, "float") || str.Equal(typeName, "double") {
        sizeVal = 8
    } else if str.Equal(typeName, "string") {
        sizeVal = 8
    } else {
        // Struct type: look up layout
        layout := cg.structLayouts[typeName]
        hasLayout := mapStringStructLayoutHasKeyCG(cg.structLayouts, typeName)
        if hasLayout {
            sizeVal = layout.size
        }
        if !hasLayout && str.Len(cg.currentModule) > 0 {
            qn := str.Concat(cg.currentModule, str.Concat(".", typeName))
            qlayout := cg.structLayouts[qn]
            hasQLayout := mapStringStructLayoutHasKeyCG(cg.structLayouts, qn)
            if hasQLayout {
                layout = qlayout
                hasLayout = true
                sizeVal = layout.size
            }
        }
    }

    // Allocate a reflect.Type struct on the stack
    typeAlloca := nextReg(cg)
    emitln(cg, concatMany([]string{"  ", typeAlloca, " = alloca %struct.reflect_Type"}))

    // Set name field (i8*)
    nameStr := emitStringLiteral(cg, typeName)
    nameGEP := nextReg(cg)
    emitln(cg, concatMany([]string{"  ", nameGEP, " = getelementptr inbounds %struct.reflect_Type, %struct.reflect_Type* ", typeAlloca, ", i32 0, i32 0"}))
    nameRetained := nextReg(cg)
    emitfmt(cg, "  %s = call i8* @Skink_rc_retain(i8* %s)\n", []string{nameRetained, nameStr})
    emitfmt(cg, "  store i8* %s, i8** %s\n", []string{nameRetained, nameGEP})

    // Set size field (i32)
    sizeGEP := nextReg(cg)
    emitln(cg, concatMany([]string{"  ", sizeGEP, " = getelementptr inbounds %struct.reflect_Type, %struct.reflect_Type* ", typeAlloca, ", i32 0, i32 1"}))
    emitfmt(cg, "  store i32 %s, i32* %s\n", []string{strconv.Itoa(sizeVal), sizeGEP})

    // Build fields array if it's a struct
    layout := cg.structLayouts[typeName]
    hasLayout := mapStringStructLayoutHasKeyCG(cg.structLayouts, typeName)
    if !hasLayout && str.Len(cg.currentModule) > 0 {
        qn := str.Concat(cg.currentModule, str.Concat(".", typeName))
        qlayout := cg.structLayouts[qn]
        hasQLayout := mapStringStructLayoutHasKeyCG(cg.structLayouts, qn)
        if hasQLayout {
            layout = qlayout
            hasLayout = true
        }
    }

    numFields := 0
    if hasLayout {
        numFields = len(layout.fields)
    }

    // Set numFields field (i32)
    nfGEP := nextReg(cg)
    emitln(cg, concatMany([]string{"  ", nfGEP, " = getelementptr inbounds %struct.reflect_Type, %struct.reflect_Type* ", typeAlloca, ", i32 0, i32 2"}))
    emitfmt(cg, "  store i32 %s, i32* %s\n", []string{strconv.Itoa(numFields), nfGEP})

    // Build fields array
    if numFields > 0 {
        fieldSize := 32
        fieldsArrReg := nextReg(cg)
        emitfmt(cg, "  %s = call i8* @Skink_rc_alloc(i64 %s)\n", []string{fieldsArrReg, strconv.Itoa(fieldSize * numFields)})
        fieldsTypedReg := nextReg(cg)
        emitln(cg, concatMany([]string{"  ", fieldsTypedReg, " = bitcast i8* ", fieldsArrReg, " to %struct.reflect_Field*"}))

        fi := 0
        for fi < numFields {
            fieldName := layout.fields[fi]
            fieldType := llTypeToSkinkName(layout.fieldTypes[fi])
            if fi < len(layout.fieldSkinkTypes) && str.Len(layout.fieldSkinkTypes[fi]) > 0 {
                fieldType = layout.fieldSkinkTypes[fi]
            }
            fieldOffset := layout.offsets[fi]
            fiStr := strconv.Itoa(fi)

            // Set field name
            fNameStr := emitStringLiteral(cg, fieldName)
            fNameGEP := nextReg(cg)
            emitln(cg, concatMany([]string{"  ", fNameGEP, " = getelementptr inbounds %struct.reflect_Field, %struct.reflect_Field* ", fieldsTypedReg, ", i32 ", fiStr, ", i32 0"}))
            fNameRetained := nextReg(cg)
            emitfmt(cg, "  %s = call i8* @Skink_rc_retain(i8* %s)\n", []string{fNameRetained, fNameStr})
            emitfmt(cg, "  store i8* %s, i8** %s\n", []string{fNameRetained, fNameGEP})

            // Set field type_name
            fTypeStr := emitStringLiteral(cg, fieldType)
            fTypeGEP := nextReg(cg)
            emitln(cg, concatMany([]string{"  ", fTypeGEP, " = getelementptr inbounds %struct.reflect_Field, %struct.reflect_Field* ", fieldsTypedReg, ", i32 ", fiStr, ", i32 1"}))
            fTypeRetained := nextReg(cg)
            emitfmt(cg, "  %s = call i8* @Skink_rc_retain(i8* %s)\n", []string{fTypeRetained, fTypeStr})
            emitfmt(cg, "  store i8* %s, i8** %s\n", []string{fTypeRetained, fTypeGEP})

            // Set field offset
            fOffGEP := nextReg(cg)
            emitln(cg, concatMany([]string{"  ", fOffGEP, " = getelementptr inbounds %struct.reflect_Field, %struct.reflect_Field* ", fieldsTypedReg, ", i32 ", fiStr, ", i32 2"}))
            emitfmt(cg, "  store i32 %s, i32* %s\n", []string{strconv.Itoa(fieldOffset), fOffGEP})

            // Set field tag (the joined [attr] annotation text, "" when
            // the field is untagged)
            fieldTag := ""
            if fi < len(layout.fieldTags) {
                fieldTag = layout.fieldTags[fi]
            }
            fTagStr := emitStringLiteral(cg, fieldTag)
            fTagGEP := nextReg(cg)
            emitln(cg, concatMany([]string{"  ", fTagGEP, " = getelementptr inbounds %struct.reflect_Field, %struct.reflect_Field* ", fieldsTypedReg, ", i32 ", fiStr, ", i32 3"}))
            fTagRetained := nextReg(cg)
            emitfmt(cg, "  %s = call i8* @Skink_rc_retain(i8* %s)\n", []string{fTagRetained, fTagStr})
            emitfmt(cg, "  store i8* %s, i8** %s\n", []string{fTagRetained, fTagGEP})

            fi = fi + 1
        }

        // Set fields pointer in Type struct
        fpGEP := nextReg(cg)
        emitln(cg, concatMany([]string{"  ", fpGEP, " = getelementptr inbounds %struct.reflect_Type, %struct.reflect_Type* ", typeAlloca, ", i32 0, i32 3"}))
        fpRetained := nextReg(cg)
        emitfmt(cg, "  %s = call i8* @Skink_rc_retain(i8* %s)\n", []string{fpRetained, fieldsArrReg})
        emitln(cg, concatMany([]string{"  store %struct.reflect_Field* ", fieldsTypedReg, ", %struct.reflect_Field** ", fpGEP}))
    } else {
        // Set fields pointer to null
        fpGEP := nextReg(cg)
        emitln(cg, concatMany([]string{"  ", fpGEP, " = getelementptr inbounds %struct.reflect_Type, %struct.reflect_Type* ", typeAlloca, ", i32 0, i32 3"}))
        emitln(cg, concatMany([]string{"  store %struct.reflect_Field* null, %struct.reflect_Field** ", fpGEP}))
    }

    // Load the Type struct value and return it
    resultReg := nextReg(cg)
    emitln(cg, concatMany([]string{"  ", resultReg, " = load %struct.reflect_Type, %struct.reflect_Type* ", typeAlloca}))
    return resultReg
}

// emitRegisterRuleCall handles registerRule calls on rulesets by generating
// wrapper functions for the dynamic rule source's triggered/Action/start/stop
// methods, then calling registerRule with the source pointer + wrappers.
fn emitRegisterRuleCall(cg: *CodeGen, e: ast.Expr, rulesetName: string) -> string {
    // Emit the source argument
    srcArg := e.callArgs[0]
    srcReg := emitExpression(cg, srcArg)
    srcLLType := exprLLType(cg, srcArg)

    // Determine the struct type from the source pointer
    // srcLLType may be a double pointer (e.g. **SensorSource) due to
    // address-of semantics; strip all indirection to find the base struct.
    structLLType := srcLLType
    for str.EndsWith(structLLType, "*") {
        structLLType = str.Substr(structLLType, 0, str.Len(structLLType) - 1)
    }
    // structLLType is now the base struct type (e.g. %struct.rules_test_SensorSource)
    // The actual pointer type is structLLType + "*"

    // Generate unique wrapper function names
    wrapperId := strconv.Itoa(cg.labelCounter)
    cg.labelCounter = cg.labelCounter + 1
    evalFnName := str.Concat(str.Concat("@__ruleset_eval_wrapper_", wrapperId), "")
    startFnName := str.Concat(str.Concat("@__ruleset_start_wrapper_", wrapperId), "")
    stopFnName := str.Concat(str.Concat("@__ruleset_stop_wrapper_", wrapperId), "")

    // Determine method function names
    // The struct name from LLVM type: rules_test_SensorSource
    structName := ""
    if str.StartsWith(structLLType, "%struct.") {
        structName = str.Substr(structLLType, str.Len("%struct."), str.Len(structLLType) - str.Len("%struct."))
    }

    // Find the triggered, Action, start, stop methods
    // Try qualified names: module.Struct.method and module.method
    triggeredFnName := ""
    actionFnName := ""
    startFnName2 := ""
    stopFnName2 := ""

    // Replace last underscore with dot for module-qualified name
    dottedName := structName
    lastUS := str.LastIndexOf(structName, "_")
    if lastUS > 0 {
        dottedName = str.Concat(str.Substr(structName, 0, lastUS), str.Concat(".", str.Substr(structName, lastUS + 1, str.Len(structName) - lastUS - 1)))
    }

    // Try dottedName.triggered, dottedName.Action, etc.
    candidates := []string{dottedName, structName}
    ci := 0
    for ci < len(candidates) {
        cn := candidates[ci]
        if str.Len(triggeredFnName) == 0 {
            qn := str.Concat(cn, str.Concat(".", "triggered"))
            if mapStringStringSliceHasKeyCG(cg.fnRetTypes, qn) {
                triggeredFnName = qn
            }
        }
        if str.Len(actionFnName) == 0 {
            qn := str.Concat(cn, str.Concat(".", "Action"))
            if mapStringStringSliceHasKeyCG(cg.fnRetTypes, qn) {
                actionFnName = qn
            }
        }
        if str.Len(startFnName2) == 0 {
            qn := str.Concat(cn, str.Concat(".", "start"))
            if mapStringStringSliceHasKeyCG(cg.fnRetTypes, qn) {
                startFnName2 = qn
            }
        }
        if str.Len(stopFnName2) == 0 {
            qn := str.Concat(cn, str.Concat(".", "stop"))
            if mapStringStringSliceHasKeyCG(cg.fnRetTypes, qn) {
                stopFnName2 = qn
            }
        }
        ci = ci + 1
    }

    // Emit eval wrapper: calls triggered(), if true calls Action()
    // Build as string for header emission
    var evalBody string
    evalBody = concatMany([]string{"define void ", evalFnName, "(i8* %self) {\nentry:\n"})
    if str.Len(triggeredFnName) > 0 && str.Len(actionFnName) > 0 {
        wCastReg := nextReg(cg)
        evalBody = str.Concat(evalBody, concatMany([]string{"  ", wCastReg, " = bitcast i8* %self to ", structLLType, "*\n"}))
        wTrigReg := nextReg(cg)
        trigRet := "i1"
        if mapStringStringSliceHasKeyCG(cg.fnRetTypes, triggeredFnName) && len(cg.fnRetTypes[triggeredFnName]) > 0 {
            trigRet = cg.fnRetTypes[triggeredFnName][0]
        }
        evalBody = str.Concat(evalBody, concatMany([]string{"  ", wTrigReg, " = call ", trigRet, " @", triggeredFnName, "(", structLLType, "* ", wCastReg, ")\n"}))
        wCmpReg := wTrigReg
        if !str.Equal(trigRet, "i1") {
            wCmpReg = nextReg(cg)
            evalBody = str.Concat(evalBody, concatMany([]string{"  ", wCmpReg, " = icmp ne ", trigRet, " ", wTrigReg, ", 0\n"}))
        }
        wTrueLbl := nextLabel(cg)
        wEndLbl := nextLabel(cg)
        evalBody = str.Concat(evalBody, concatMany([]string{"  br i1 ", wCmpReg, ", label %", wTrueLbl, ", label %", wEndLbl, "\n"}))
        evalBody = str.Concat(evalBody, concatMany([]string{wTrueLbl, ":\n"}))
        evalBody = str.Concat(evalBody, concatMany([]string{"  call void @", actionFnName, "(", structLLType, "* ", wCastReg, ")\n"}))
        evalBody = str.Concat(evalBody, concatMany([]string{"  br label %", wEndLbl, "\n"}))
        evalBody = str.Concat(evalBody, concatMany([]string{wEndLbl, ":\n"}))
    }
    evalBody = str.Concat(evalBody, "  ret void\n}\n\n")
    emitHeader(cg, evalBody)

    // Emit start wrapper
    var startBody string
    startBody = concatMany([]string{"define void ", startFnName, "(i8* %self) {\nentry:\n"})
    if str.Len(startFnName2) > 0 {
        sCastReg := nextReg(cg)
        startBody = str.Concat(startBody, concatMany([]string{"  ", sCastReg, " = bitcast i8* %self to ", structLLType, "*\n"}))
        startBody = str.Concat(startBody, concatMany([]string{"  call void @", startFnName2, "(", structLLType, "* ", sCastReg, ")\n"}))
    }
    startBody = str.Concat(startBody, "  ret void\n}\n\n")
    emitHeader(cg, startBody)

    // Emit stop wrapper
    var stopBody string
    stopBody = concatMany([]string{"define void ", stopFnName, "(i8* %self) {\nentry:\n"})
    if str.Len(stopFnName2) > 0 {
        stCastReg := nextReg(cg)
        stopBody = str.Concat(stopBody, concatMany([]string{"  ", stCastReg, " = bitcast i8* %self to ", structLLType, "*\n"}))
        stopBody = str.Concat(stopBody, concatMany([]string{"  call void @", stopFnName2, "(", structLLType, "* ", stCastReg, ")\n"}))
    }
    stopBody = str.Concat(stopBody, "  ret void\n}\n\n")
    emitHeader(cg, stopBody)

    // Call registerRule(source, eval, start, stop)
    regQn := str.Concat(rulesetName, str.Concat(".", "registerRule"))
    // Cast source pointer to i8*
    // The actual value type is structLLType* (single pointer), not srcLLType
    actualPtrType := str.Concat(structLLType, "*")
    srcI8Reg := srcReg
    if !str.Equal(actualPtrType, "i8*") {
        srcI8Reg = nextReg(cg)
        emitfmt(cg, "  %s = bitcast %s %s to i8*\n", []string{srcI8Reg, actualPtrType, srcReg})
    }
    evalPtr := str.Concat("void(i8*)* bitcast (void(i8*)* ", str.Concat(evalFnName, " to void(i8*)*)"))
    startPtr := str.Concat("void(i8*)* bitcast (void(i8*)* ", str.Concat(startFnName, " to void(i8*)*)"))
    stopPtr := str.Concat("void(i8*)* bitcast (void(i8*)* ", str.Concat(stopFnName, " to void(i8*)*)"))
    emitfmt(cg, "  call void @%s(i8* %s, %s, %s, %s)\n",
        []string{regQn, srcI8Reg, evalPtr, startPtr, stopPtr})
    return ""
}

// emitTemplateMethodCall emits a call to a template interface method via
// the fat pointer's function pointer field.
fn emitTemplateMethodCall(cg: *CodeGen, e: ast.Expr, methodName: string, receiverExpr: ast.Expr, receiverLLType: string) -> string {
    tmplName, ok := findTemplateByLLType(cg, receiverLLType)
    if !ok {
        return "0"
    }
    tmpl := checker.getTemplate(cg.checker, tmplName)
    // Find method index
    methodIdx := -1
    i := 0
    for i < len(tmpl.templateMethods) {
        if str.Equal(tmpl.templateMethods[i].fnName, methodName) {
            methodIdx = i
            break
        }
        i = i + 1
    }
    if methodIdx < 0 {
        return "0"
    }
    m := tmpl.templateMethods[methodIdx]
    // Get return type
    retType := "void"
    if len(m.fnRetTypes) > 0 {
        t := checker.astTypeToType(cg.checker, m.fnRetTypes[0])
        retType = llvmType(cg, t)
    }
    // Emit receiver (the fat pointer)
    fatPtrReg := emitExpression(cg, receiverExpr)
    structType := templateLLTypeStruct(tmplName)
    // Load data pointer (field 0)
    dataGEP := nextReg(cg)
    emitfmt(cg, "  %s = getelementptr inbounds %s, %s %s, i32 0, i32 0\n",
        []string{dataGEP, structType, receiverLLType, fatPtrReg})
    dataReg := nextReg(cg)
    emitfmt(cg, "  %s = load i8*, i8** %s\n", []string{dataReg, dataGEP})
    // Load function pointer (field methodIdx + 1)
    fnGEP := nextReg(cg)
    emitfmt(cg, "  %s = getelementptr inbounds %s, %s %s, i32 0, i32 %s\n",
        []string{fnGEP, structType, receiverLLType, fatPtrReg, strconv.Itoa(methodIdx + 1)})
    fnReg := nextReg(cg)
    emitfmt(cg, "  %s = load i8*, i8** %s\n", []string{fnReg, fnGEP})
    // Build args: data pointer is first arg, then call args
    args := []string{}
    args = append(args, str.Concat("i8* ", dataReg))
    i = 0
    for i < len(e.callArgs) {
        argReg := emitExpression(cg, e.callArgs[i])
        argType := exprLLType(cg, e.callArgs[i])
        // Coerce to method's parameter type (offset by 1 for self)
        if i + 1 < len(m.fnParams) {
            if len(m.fnParams[i + 1].typ) > 0 {
                t := checker.astTypeToType(cg.checker, m.fnParams[i + 1].typ[0])
                expected := llvmType(cg, t)
                argReg = coerceExprToParamType(cg, argReg, argType, expected, e.callArgs[i])
                argType = expected
            }
        }
        args = append(args, str.Concat(argType, str.Concat(" ", argReg)))
        i = i + 1
    }
    return emitIndirectCall(cg, retType, "i8*", fnReg, args)
}

// emitTemplateTypes emits LLVM type definitions for all templates.
fn emitTemplateTypes(cg: *CodeGen) {
    names := checker.templateNames(cg.checker)
    emitted := make(map[string]bool)
    i := 0
    for i < len(names) {
        if !emitted[names[i]] {
            emitted[names[i]] = true
            tmpl := checker.getTemplate(cg.checker, names[i])
            structType := templateLLTypeStruct(names[i])
            // Build struct body: { i8* data, i8* fn1, i8* fn2, ... }
            fields := []string{}
            fields = append(fields, "i8*")
            j := 0
            for j < len(tmpl.templateMethods) {
                fields = append(fields, "i8*")
                j = j + 1
            }
            emitHeader(cg, str.Concat(structType, str.Concat(" = type { ", str.Concat(str.Join(fields, ", "), " }\n"))))
        }
        i = i + 1
    }
}

// funcLLType returns the LLVM function pointer type for a checker function type.
fn funcLLType(cg: *CodeGen, t: checker.TType) -> string {
    paramParts := []string{}
    i := 0
    for i < len(t.params) {
        pt := llvmType(cg, t.params[i])
        if isCompositeType(pt) && !str.EndsWith(pt, "*") {
            pt = str.Concat(pt, "*")
        }
        paramParts = append(paramParts, pt)
        i = i + 1
    }
    retType := "void"
    if len(t.retTypes) > 0 {
        retType = llvmType(cg, t.retTypes[0])
    }
    if str.Equal(retType, "") {
        retType = "void"
    }
    return str.Concat(retType, str.Concat(" (", str.Concat(str.Join(paramParts, ", "), ")*")))
}

// tupleLLType returns the LLVM struct type for a checker tuple type.
fn tupleLLType(cg: *CodeGen, t: checker.TType) -> string {
    parts := []string{}
    i := 0
    for i < len(t.tupleTypes) {
        parts = append(parts, llvmType(cg, t.tupleTypes[i]))
        i = i + 1
    }
    return str.Concat("{ ", str.Concat(str.Join(parts, ", "), " }"))
}

// mapTypeName generates a sanitized map type name from key/value LLVM types.
pub fn mapTypeName(keyLL: string, valLL: string) -> string {
    k := sanitizeLLTypeName(keyLL)
    v := sanitizeLLTypeName(valLL)
    return str.Concat(str.Concat("map_", k), str.Concat("__", v))
}

// parseMapTypeLL extracts key and value LLVM type names from a map type string like "%map_i8Ptr__i32*".
fn parseMapTypeLL(llType: string) -> (string, string, bool) {
    if !str.StartsWith(llType, "%map_") || !str.EndsWith(llType, "*") {
        return "", "", false
    }
    inner := str.Substr(llType, str.Len("%map_"), str.Len(llType) - str.Len("%map_") - str.Len("*"))
    sepIdx := str.IndexOf(inner, "__")
    if sepIdx < 0 {
        return "", "", false
    }
    keyPart := str.Substr(inner, 0, sepIdx)
    valPart := str.Substr(inner, sepIdx + 2, str.Len(inner) - sepIdx - 2)
    keyLL := desanitizeLLTypeName(keyPart)
    valLL := desanitizeLLTypeName(valPart)
    return keyLL, valLL, true
}

// desanitizeLLTypeName reverses the sanitizeLLTypeName encoding.
fn desanitizeLLTypeName(s: string) -> string {
    isStructType := str.StartsWith(s, "struct_") || str.StartsWith(s, "set_")
    if isStructType {
        if str.EndsWith(s, "Ptr") {
            s = str.Concat(str.Substr(s, 0, str.Len(s) - 3), "*")
        }
    } else {
        s = str.Replace(s, "Ptr", "*")
    }
    if str.StartsWith(s, "struct_") {
        s = str.Concat("%struct.", str.Substr(s, str.Len("struct_"), str.Len(s) - str.Len("struct_")))
    } else if str.StartsWith(s, "set_") {
        s = str.Concat("%set.", str.Substr(s, str.Len("set_"), str.Len(s) - str.Len("set_")))
    } else if str.StartsWith(s, "map_") {
        s = str.Concat("%", s)
    }
    return s
}

// emitMapTypeDecl emits the LLVM type declaration for a map struct.
// Map struct layout (hash-based open addressing with linear probing):
//   { keys*, vals*, occupied*, capacity, count }
// Field indices: 0=keys, 1=vals, 2=occupied flags (i8*), 3=capacity, 4=count
fn emitMapTypeDecl(cg: *CodeGen, name: string, keyLL: string, valLL: string) {
    has := mapStringBoolHasKeyCG(cg.mapTypes, name)
    if has {
        return
    }
    cg.mapTypes[name] = true
    b := str.NewBuilder(64)
    str.Write(&b, "%")
    str.Write(&b, name)
    str.Write(&b, " = type { ")
    str.Write(&b, keyLL)
    str.Write(&b, "*, ")
    str.Write(&b, valLL)
    str.Write(&b, "*, i8*, i32, i32 }\n")
    emitHeader(cg, str.String(b))
    str.Free(&b)
}

// emitMapArrayAlloc allocates a map key or value backing array using
// Skink_rc_alloc_typed with an array destructor when the element type
// holds heap-reachable values. This ensures retained keys/values are
// properly released when the array is freed during map reallocation.
fn emitMapArrayAlloc(cg: *CodeGen, elemLL: string, nBytes64: string) -> string {
    dtorName := getOrCreateArrayDtor(cg, elemLL)
    rawReg := nextReg(cg)
    if str.Len(dtorName) > 0 {
        dtorPtr := str.Concat("i8* bitcast (void (i8*)* @", str.Concat(dtorName, " to i8*)"))
        emitfmt(cg, "  %s = call i8* @Skink_rc_alloc_typed(i64 %s, %s)\n", []string{rawReg, nBytes64, dtorPtr})
    } else {
        emitfmt(cg, "  %s = call i8* @Skink_rc_alloc(i64 %s)\n", []string{rawReg, nBytes64})
    }
    // Store the slot capacity at payload - 8 as the array's element count.
    // Map backing arrays are not slices and never get a length write, so
    // without this the slot held the raw byte size, which both the element
    // destructor and emitSliceCopyArr (map copy) would misread as an element
    // count — memcpy'ing byteSize*elemSize bytes out of a byteSize buffer.
    // This must be unconditional: non-dtor element types (ints, floats)
    // take the plain Skink_rc_alloc branch above but are still copied.
    capCount := nextReg(cg)
    emitfmt(cg, "  %s = udiv i64 %s, %s\n", []string{capCount, nBytes64, strconv.Itoa(elemSizeLiteral(cg, elemLL))})
    cntPtr := nextReg(cg)
    emitfmt(cg, "  %s = getelementptr inbounds i8, i8* %s, i64 -8\n", []string{cntPtr, rawReg})
    cntTyped := nextReg(cg)
    emitfmt(cg, "  %s = bitcast i8* %s to i64*\n", []string{cntTyped, cntPtr})
    emitfmt(cg, "  store i64 %s, i64* %s\n", []string{capCount, cntTyped})
    return rawReg
}

// emitMapLiteral emits a map literal as an RC-managed struct.
// Uses hash-based open addressing: capacity = n*2 for 50% load factor.
// Each key is placed at (hash % capacity) with linear probing.
fn emitMapLiteral(cg: *CodeGen, e: ast.Expr) -> string {
    if len(e.mapKeys) == 0 {
        return "null"
    }
    keyLL := exprLLType(cg, e.mapKeys[0])
    valLL := exprLLType(cg, e.mapVals[0])
    mtName := mapTypeName(keyLL, valLL)
    emitMapTypeDecl(cg, mtName, keyLL, valLL)
    mapStructType := str.Concat("%", mtName)

    n := len(e.mapKeys)
    // Capacity = n*2 for 50% load factor (good probe performance).
    cap := n * 2
    if cap < 8 {
        cap = 8
    }
    keyElemSize := emitElemSize(cg, keyLL)
    valElemSize := emitElemSize(cg, valLL)

    keysBytes := nextReg(cg)
    emitfmt(cg, "  %s = mul i32 %s, %s\n", []string{keysBytes, strconv.Itoa(cap), keyElemSize})
    keysBytes64 := nextReg(cg)
    emitfmt(cg, "  %s = zext i32 %s to i64\n", []string{keysBytes64, keysBytes})
    keysRaw := emitMapArrayAlloc(cg, keyLL, keysBytes64)
    keysTyped := nextReg(cg)
    emitfmt(cg, "  %s = bitcast i8* %s to %s*\n", []string{keysTyped, keysRaw, keyLL})

    valsBytes := nextReg(cg)
    emitfmt(cg, "  %s = mul i32 %s, %s\n", []string{valsBytes, strconv.Itoa(cap), valElemSize})
    valsBytes64 := nextReg(cg)
    emitfmt(cg, "  %s = zext i32 %s to i64\n", []string{valsBytes64, valsBytes})
    valsRaw := emitMapArrayAlloc(cg, valLL, valsBytes64)
    valsTyped := nextReg(cg)
    emitfmt(cg, "  %s = bitcast i8* %s to %s*\n", []string{valsTyped, valsRaw, valLL})

    // Allocate occupied flags array (1 byte per slot), zeroed.
    occBytes64 := nextReg(cg)
    emitfmt(cg, "  %s = zext i32 %s to i64\n", []string{occBytes64, strconv.Itoa(cap)})
    occRaw := nextReg(cg)
    emitfmt(cg, "  %s = call i8* @Skink_rc_alloc(i64 %s)\n", []string{occRaw, occBytes64})
    occTyped := nextReg(cg)
    emitfmt(cg, "  %s = bitcast i8* %s to i8*\n", []string{occTyped, occRaw})
    // Zero the occupied array using memset.
    emitfmt(cg, "  call void @llvm.memset.p0i8.i64(i8* %s, i8 0, i64 %s, i1 false)\n", []string{occTyped, occBytes64})

    // Insert each key-value pair using hash-based probing.
    i := 0
    for i < n {
        keyReg := emitExpression(cg, e.mapKeys[i])
        valReg := emitExpression(cg, e.mapVals[i])

        // Retain RC-managed keys and values so the map owns them.
        if isHeapLLType(keyLL) {
            keyReg = emitRetain(cg, keyReg, keyLL)
        }
        if isHeapLLType(valLL) {
            valReg = emitRetain(cg, valReg, valLL)
        }

        // Compute hash and find slot via linear probing.
        hashReg := nextReg(cg)
        if str.Equal(keyLL, "i8*") {
            emitfmt(cg, "  %s = call i32 @Skink_str_hash(i8* %s)\n", []string{hashReg, keyReg})
        } else {
            // For integer keys, use the value itself as the hash.
            hashReg = keyReg
        }
        idxReg := nextReg(cg)
        emitfmt(cg, "  %s = srem i32 %s, %s\n", []string{idxReg, hashReg, strconv.Itoa(cap)})
        negCheck := nextReg(cg)
        emitfmt(cg, "  %s = icmp slt i32 %s, 0\n", []string{negCheck, idxReg})
        negIdx := nextReg(cg)
        emitfmt(cg, "  %s = sub i32 0, %s\n", []string{negIdx, idxReg})
        startIdx := nextReg(cg)
        emitfmt(cg, "  %s = select i1 %s, i32 %s, i32 %s\n", []string{startIdx, negCheck, negIdx, idxReg})

        // Probe loop: find an empty slot.
        probeAlloca := nextReg(cg)
        emitfmt(cg, "  %s = alloca i32\n", []string{probeAlloca})
        emitfmt(cg, "  store i32 %s, i32* %s\n", []string{startIdx, probeAlloca})
        probeCond := nextLabel(cg)
        probeBody := nextLabel(cg)
        probeStore := nextLabel(cg)
        emitBranch(cg, probeCond)
        emitln(cg, str.Concat(probeCond, ":\n"))
        probeVal := nextReg(cg)
        emitfmt(cg, "  %s = load i32, i32* %s\n", []string{probeVal, probeAlloca})
        occGep := nextReg(cg)
        emitfmt(cg, "  %s = getelementptr inbounds i8, i8* %s, i32 %s\n", []string{occGep, occTyped, probeVal})
        occVal := nextReg(cg)
        emitfmt(cg, "  %s = load i8, i8* %s\n", []string{occVal, occGep})
        occBool := nextReg(cg)
        emitfmt(cg, "  %s = icmp eq i8 %s, 0\n", []string{occBool, occVal})
        emitCondBranch(cg, occBool, probeStore, probeBody)
        emitln(cg, str.Concat(probeBody, ":\n"))
        nextProbe := nextReg(cg)
        emitfmt(cg, "  %s = add i32 %s, 1\n", []string{nextProbe, probeVal})
        wrapProbe := nextReg(cg)
        emitfmt(cg, "  %s = srem i32 %s, %s\n", []string{wrapProbe, nextProbe, strconv.Itoa(cap)})
        emitfmt(cg, "  store i32 %s, i32* %s\n", []string{wrapProbe, probeAlloca})
        emitBranch(cg, probeCond)
        emitln(cg, str.Concat(probeStore, ":\n"))
        storeIdx := nextReg(cg)
        emitfmt(cg, "  %s = load i32, i32* %s\n", []string{storeIdx, probeAlloca})

        // Store key.
        keyGep := nextReg(cg)
        emitfmt(cg, "  %s = getelementptr inbounds %s, %s* %s, i32 %s\n", []string{keyGep, keyLL, keyLL, keysTyped, storeIdx})
        emitStore(cg, keyLL, keyReg, keyLL, keyGep)
        // Store value.
        valGep := nextReg(cg)
        emitfmt(cg, "  %s = getelementptr inbounds %s, %s* %s, i32 %s\n", []string{valGep, valLL, valLL, valsTyped, storeIdx})
        emitStore(cg, valLL, valReg, valLL, valGep)
        // Mark occupied.
        occGep2 := nextReg(cg)
        emitfmt(cg, "  %s = getelementptr inbounds i8, i8* %s, i32 %s\n", []string{occGep2, occTyped, storeIdx})
        emitfmt(cg, "  store i8 1, i8* %s\n", []string{occGep2})

        i = i + 1
    }

    structSizePtr := nextReg(cg)
    emitfmt(cg, "  %s = getelementptr %s, %s* null, i32 1\n", []string{structSizePtr, mapStructType, mapStructType})
    structSize := nextReg(cg)
    emitfmt(cg, "  %s = ptrtoint %s* %s to i64\n", []string{structSize, mapStructType, structSizePtr})
    mapRaw := nextReg(cg)
    emitfmt(cg, "  %s = call i8* @Skink_rc_alloc(i64 %s)\n", []string{mapRaw, structSize})
    mapPtr := nextReg(cg)
    emitfmt(cg, "  %s = bitcast i8* %s to %s*\n", []string{mapPtr, mapRaw, mapStructType})

    // Store keys (field 0).
    keysField := nextReg(cg)
    emitfmt(cg, "  %s = getelementptr inbounds %s, %s* %s, i32 0, i32 0\n", []string{keysField, mapStructType, mapStructType, mapPtr})
    emitfmt(cg, "  store %s* %s, %s** %s\n", []string{keyLL, keysTyped, keyLL, keysField})
    // Store vals (field 1).
    valsField := nextReg(cg)
    emitfmt(cg, "  %s = getelementptr inbounds %s, %s* %s, i32 0, i32 1\n", []string{valsField, mapStructType, mapStructType, mapPtr})
    emitfmt(cg, "  store %s* %s, %s** %s\n", []string{valLL, valsTyped, valLL, valsField})
    // Store occupied (field 2).
    occField := nextReg(cg)
    emitfmt(cg, "  %s = getelementptr inbounds %s, %s* %s, i32 0, i32 2\n", []string{occField, mapStructType, mapStructType, mapPtr})
    emitfmt(cg, "  store i8* %s, i8** %s\n", []string{occTyped, occField})
    // Store capacity (field 3).
    capField := nextReg(cg)
    emitfmt(cg, "  %s = getelementptr inbounds %s, %s* %s, i32 0, i32 3\n", []string{capField, mapStructType, mapStructType, mapPtr})
    emitfmt(cg, "  store i32 %s, i32* %s\n", []string{strconv.Itoa(cap), capField})
    // Store count (field 4).
    lenField := nextReg(cg)
    emitfmt(cg, "  %s = getelementptr inbounds %s, %s* %s, i32 0, i32 4\n", []string{lenField, mapStructType, mapStructType, mapPtr})
    emitfmt(cg, "  store i32 %s, i32* %s\n", []string{strconv.Itoa(n), lenField})

    return mapPtr
}

// emitSetLiteral emits a set literal as an RC-managed struct.
// Sets use the same struct layout as maps but with only a data pointer
// and count: { elem*, i32 }. Duplicate elements are filtered out at
// emission time via a linear scan over the already-added elements.
fn emitSetLiteral(cg: *CodeGen, e: ast.Expr) -> string {
    if len(e.setElems) == 0 {
        return "null"
    }
    elemLL := exprLLType(cg, e.setElems[0])
    setName := setTypeName(elemLL)
    emitSetTypeDecl(cg, setName, elemLL)
    setStructType := str.Concat("%", setName)

    n := len(e.setElems)
    elemSize := emitElemSize(cg, elemLL)

    // Allocate backing array with capacity = n (worst case: all unique).
    bytesReg := nextReg(cg)
    emitfmt(cg, "  %s = mul i32 %s, %s\n", []string{bytesReg, strconv.Itoa(n), elemSize})
    bytes64 := nextReg(cg)
    emitfmt(cg, "  %s = zext i32 %s to i64\n", []string{bytes64, bytesReg})
    arrDtorName := getOrCreateArrayDtor(cg, elemLL)
    rawReg := nextReg(cg)
    if str.Len(arrDtorName) > 0 {
        arrDtorPtr := str.Concat("i8* bitcast (void (i8*)* @", str.Concat(arrDtorName, " to i8*)"))
        emitfmt(cg, "  %s = call i8* @Skink_rc_alloc_typed(i64 %s, %s)\n", []string{rawReg, bytes64, arrDtorPtr})
    } else {
        emitfmt(cg, "  %s = call i8* @Skink_rc_alloc(i64 %s)\n", []string{rawReg, bytes64})
    }
    // Store the element capacity at payload - 8 as the array's element
    // count (same convention as map backing arrays — see emitMapArrayAlloc).
    // Unconditional: emitSliceCopyArr reads this slot for every copy, and
    // without it a non-dtor element type leaves the raw byte size there.
    capPtr := nextReg(cg)
    emitfmt(cg, "  %s = getelementptr inbounds i8, i8* %s, i64 -8\n", []string{capPtr, rawReg})
    capTyped := nextReg(cg)
    emitfmt(cg, "  %s = bitcast i8* %s to i64*\n", []string{capTyped, capPtr})
    emitfmt(cg, "  store i64 %s, i64* %s\n", []string{strconv.Itoa(n), capTyped})
    dataTyped := nextReg(cg)
    emitfmt(cg, "  %s = bitcast i8* %s to %s*\n", []string{dataTyped, rawReg, elemLL})

    // Allocate an i32 counter for the number of unique elements added.
    countAlloca := nextReg(cg)
    emitfmt(cg, "  %s = alloca i32\n", []string{countAlloca})
    emitfmt(cg, "  store i32 0, i32* %s\n", []string{countAlloca})

    // Process each element, skipping duplicates.
    i := 0
    for i < n {
        elemReg := emitExpression(cg, e.setElems[i])
        if isHeapLLType(elemLL) {
            elemReg = emitRetain(cg, elemReg, elemLL)
        }

        // Load current count.
        countReg := nextReg(cg)
        emitfmt(cg, "  %s = load i32, i32* %s\n", []string{countReg, countAlloca})

        // Linear scan: check if elemReg already exists in dataTyped[0..count).
        jAlloca := nextReg(cg)
        emitfmt(cg, "  %s = alloca i32\n", []string{jAlloca})
        emitfmt(cg, "  store i32 0, i32* %s\n", []string{jAlloca})
        foundAlloca := nextReg(cg)
        emitfmt(cg, "  %s = alloca i1\n", []string{foundAlloca})
        emitfmt(cg, "  store i1 false, i1* %s\n", []string{foundAlloca})

        loopLabel := nextLabel(cg)
        checkLabel := nextLabel(cg)
        endLabel := nextLabel(cg)
        emitLabel(cg, loopLabel)
        jReg := nextReg(cg)
        emitfmt(cg, "  %s = load i32, i32* %s\n", []string{jReg, jAlloca})
        cmpJ := nextReg(cg)
        emitfmt(cg, "  %s = icmp slt i32 %s, %s\n", []string{cmpJ, jReg, countReg})
        emitCondBranch(cg, cmpJ, checkLabel, endLabel)

        emitLabel(cg, checkLabel)
        // Load existing element at index jReg.
        existingGep := nextReg(cg)
        emitfmt(cg, "  %s = getelementptr inbounds %s, %s* %s, i32 %s\n", []string{existingGep, elemLL, elemLL, dataTyped, jReg})
        existingReg := nextReg(cg)
        emitfmt(cg, "  %s = load %s, %s* %s\n", []string{existingReg, elemLL, elemLL, existingGep})
        // Compare.
        isDup := emitSetElemCompare(cg, elemReg, existingReg, elemLL)
        foundReg := nextReg(cg)
        emitfmt(cg, "  %s = load i1, i1* %s\n", []string{foundReg, foundAlloca})
        // OR the new duplicate finding with the existing found state.
        // This prevents resetting foundAlloca to false when a non-duplicate
        // is checked after a duplicate was already found.
        newFound := nextReg(cg)
        emitfmt(cg, "  %s = or i1 %s, %s\n", []string{newFound, foundReg, isDup})
        emitfmt(cg, "  store i1 %s, i1* %s\n", []string{newFound, foundAlloca})
        // Increment j.
        jNext := nextReg(cg)
        emitfmt(cg, "  %s = add i32 %s, 1\n", []string{jNext, jReg})
        emitfmt(cg, "  store i32 %s, i32* %s\n", []string{jNext, jAlloca})
        emitBranch(cg, loopLabel)

        emitLabel(cg, endLabel)
        // If found, skip storing this element (and release the retained copy).
        foundFinal := nextReg(cg)
        emitfmt(cg, "  %s = load i1, i1* %s\n", []string{foundFinal, foundAlloca})
        notFound := nextReg(cg)
        emitfmt(cg, "  %s = xor i1 %s, true\n", []string{notFound, foundFinal})
        storeLabel := nextLabel(cg)
        skipLabel := nextLabel(cg)
        afterLabel := nextLabel(cg)
        emitCondBranch(cg, notFound, storeLabel, skipLabel)

        emitLabel(cg, storeLabel)
        // Store elemReg at index countReg.
        storeGep := nextReg(cg)
        emitfmt(cg, "  %s = getelementptr inbounds %s, %s* %s, i32 %s\n", []string{storeGep, elemLL, elemLL, dataTyped, countReg})
        emitStore(cg, elemLL, elemReg, elemLL, storeGep)
        // Increment count.
        countNext := nextReg(cg)
        emitfmt(cg, "  %s = add i32 %s, 1\n", []string{countNext, countReg})
        emitfmt(cg, "  store i32 %s, i32* %s\n", []string{countNext, countAlloca})
        emitBranch(cg, afterLabel)

        emitLabel(cg, skipLabel)
        // Release the retained duplicate.
        if isHeapLLType(elemLL) {
            emitRelease(cg, elemReg, elemLL)
        }
        emitBranch(cg, afterLabel)

        emitLabel(cg, afterLabel)
        i = i + 1
    }

    // Allocate the set struct.
    structSizePtr := nextReg(cg)
    emitfmt(cg, "  %s = getelementptr %s, %s* null, i32 1\n", []string{structSizePtr, setStructType, setStructType})
    structSize := nextReg(cg)
    emitfmt(cg, "  %s = ptrtoint %s* %s to i64\n", []string{structSize, setStructType, structSizePtr})
    setRaw := nextReg(cg)
    emitfmt(cg, "  %s = call i8* @Skink_rc_alloc(i64 %s)\n", []string{setRaw, structSize})
    setPtr := nextReg(cg)
    emitfmt(cg, "  %s = bitcast i8* %s to %s*\n", []string{setPtr, setRaw, setStructType})

    // Store data pointer (field 0).
    dataField := nextReg(cg)
    emitfmt(cg, "  %s = getelementptr inbounds %s, %s* %s, i32 0, i32 0\n", []string{dataField, setStructType, setStructType, setPtr})
    emitfmt(cg, "  store %s* %s, %s** %s\n", []string{elemLL, dataTyped, elemLL, dataField})

    // Store count (field 1).
    finalCount := nextReg(cg)
    emitfmt(cg, "  %s = load i32, i32* %s\n", []string{finalCount, countAlloca})
    countField := nextReg(cg)
    emitfmt(cg, "  %s = getelementptr inbounds %s, %s* %s, i32 0, i32 1\n", []string{countField, setStructType, setStructType, setPtr})
    emitfmt(cg, "  store i32 %s, i32* %s\n", []string{finalCount, countField})

    return setPtr
}

// emitSetElemCompare compares two set elements of the given LLVM type
// and returns an i1 register that is true when they are equal.
fn emitSetElemCompare(cg: *CodeGen, a: string, b: string, elemLL: string) -> string {
    if str.Equal(elemLL, "i8*") {
        cmp := nextReg(cg)
        emitfmt(cg, "  %s = call i32 @strcmp(i8* %s, i8* %s)\n", []string{cmp, a, b})
        r := nextReg(cg)
        emitfmt(cg, "  %s = icmp eq i32 %s, 0\n", []string{r, cmp})
        return r
    }
    r := nextReg(cg)
    emitfmt(cg, "  %s = icmp eq %s %s, %s\n", []string{r, elemLL, a, b})
    return r
}

// emitSetInOp emits code for the `x in setVal` membership test.
// It does a linear scan through the set's data array comparing each
// element to x, returning an i1 result.
fn emitSetInOp(cg: *CodeGen, e: ast.Expr) -> string {
    leftReg := emitExpression(cg, e.infixLeft[0])
    setReg := emitExpression(cg, e.infixRight[0])
    setLLType := exprLLType(cg, e.infixRight[0])
    elemLL := exprLLType(cg, e.infixLeft[0])

    // Load set count (field 1).
    setType := str.Substr(setLLType, 0, str.Len(setLLType) - 1)
    countField := nextReg(cg)
    emitfmt(cg, "  %s = getelementptr inbounds %s, %s %s, i32 0, i32 1\n", []string{countField, setType, setLLType, setReg})
    countReg := nextReg(cg)
    emitfmt(cg, "  %s = load i32, i32* %s\n", []string{countReg, countField})

    // Load data pointer (field 0).
    dataField := nextReg(cg)
    emitfmt(cg, "  %s = getelementptr inbounds %s, %s %s, i32 0, i32 0\n", []string{dataField, setType, setLLType, setReg})
    dataReg := nextReg(cg)
    emitfmt(cg, "  %s = load %s*, %s** %s\n", []string{dataReg, elemLL, elemLL, dataField})

    // Result alloca (i1), initially false.
    resultAlloca := nextReg(cg)
    emitfmt(cg, "  %s = alloca i1\n", []string{resultAlloca})
    emitfmt(cg, "  store i1 false, i1* %s\n", []string{resultAlloca})

    // Loop index alloca.
    iAlloca := nextReg(cg)
    emitfmt(cg, "  %s = alloca i32\n", []string{iAlloca})
    emitfmt(cg, "  store i32 0, i32* %s\n", []string{iAlloca})

    loopLabel := nextLabel(cg)
    checkLabel := nextLabel(cg)
    endLabel := nextLabel(cg)
    emitBranch(cg, loopLabel)

    emitLabel(cg, loopLabel)
    iReg := nextReg(cg)
    emitfmt(cg, "  %s = load i32, i32* %s\n", []string{iReg, iAlloca})
    cmpI := nextReg(cg)
    emitfmt(cg, "  %s = icmp slt i32 %s, %s\n", []string{cmpI, iReg, countReg})
    emitCondBranch(cg, cmpI, checkLabel, endLabel)

    emitLabel(cg, checkLabel)
    elemGep := nextReg(cg)
    emitfmt(cg, "  %s = getelementptr inbounds %s, %s* %s, i32 %s\n", []string{elemGep, elemLL, elemLL, dataReg, iReg})
    elemReg := nextReg(cg)
    emitfmt(cg, "  %s = load %s, %s* %s\n", []string{elemReg, elemLL, elemLL, elemGep})
    isMatch := emitSetElemCompare(cg, leftReg, elemReg, elemLL)
    // If match, set result to true.
    emitfmt(cg, "  store i1 %s, i1* %s\n", []string{isMatch, resultAlloca})
    // If match, break out of loop.
    foundLabel := nextLabel(cg)
    contLabel := nextLabel(cg)
    emitCondBranch(cg, isMatch, foundLabel, contLabel)

    emitLabel(cg, foundLabel)
    emitBranch(cg, endLabel)

    emitLabel(cg, contLabel)
    iNext := nextReg(cg)
    emitfmt(cg, "  %s = add i32 %s, 1\n", []string{iNext, iReg})
    emitfmt(cg, "  store i32 %s, i32* %s\n", []string{iNext, iAlloca})
    emitBranch(cg, loopLabel)

    emitLabel(cg, endLabel)
    resultReg := nextReg(cg)
    emitfmt(cg, "  %s = load i1, i1* %s\n", []string{resultReg, resultAlloca})
    return resultReg
}

// emitMapIndex emits a hash-based lookup through a map.
// Uses open addressing with linear probing: computes hash(key) % capacity,
// then probes until finding the key or an empty slot.
fn emitMapIndex(cg: *CodeGen, mapReg: string, keyReg: string, keyLL: string, valLL: string) -> string {
    mtName := mapTypeName(keyLL, valLL)
    emitMapTypeDecl(cg, mtName, keyLL, valLL)
    mapType := str.Concat("%", mtName)
    resultAlloca := nextReg(cg)
    emitfmt(cg, "  %s = alloca %s\n", []string{resultAlloca, valLL})
    if str.Equal(valLL, "i8*") {
        emptyStr := emitStringLiteral(cg, "")
        emitfmt(cg, "  store i8* %s, i8** %s\n", []string{emptyStr, resultAlloca})
    } else if str.EndsWith(valLL, "*") {
        emitfmt(cg, "  store %s null, %s* %s\n", []string{valLL, valLL, resultAlloca})
    } else if str.StartsWith(valLL, "%struct.") || str.StartsWith(valLL, "%map_") || str.StartsWith(valLL, "%set.") || str.StartsWith(valLL, "{") {
        emitfmt(cg, "  store %s zeroinitializer, %s* %s\n", []string{valLL, valLL, resultAlloca})
    } else {
        zv := zeroValueForLLType(valLL)
        emitfmt(cg, "  store %s %s, %s* %s\n", []string{valLL, zv, valLL, resultAlloca})
    }

    // Reads on a nil map return the zero value instead of crashing on
    // the field loads — Go semantics; writes panic instead
    // (comp_error.md #80).
    isNilMap := nextReg(cg)
    emitfmt(cg, "  %s = icmp eq %s* %s, null\n", []string{isNilMap, mapType, mapReg})
    nilDoneL := nextLabel(cg)
    goBodyL := nextLabel(cg)
    emitCondBranch(cg, isNilMap, nilDoneL, goBodyL)
    emitLabel(cg, goBodyL)

    // Load keys (field 0), vals (field 1), occupied (field 2), capacity (field 3).
    keysField := nextReg(cg)
    emitfmt(cg, "  %s = getelementptr inbounds %s, %s* %s, i32 0, i32 0\n", []string{keysField, mapType, mapType, mapReg})
    keysPtr := nextReg(cg)
    emitfmt(cg, "  %s = load %s*, %s** %s\n", []string{keysPtr, keyLL, keyLL, keysField})

    valsField := nextReg(cg)
    emitfmt(cg, "  %s = getelementptr inbounds %s, %s* %s, i32 0, i32 1\n", []string{valsField, mapType, mapType, mapReg})
    valsPtr := nextReg(cg)
    emitfmt(cg, "  %s = load %s*, %s** %s\n", []string{valsPtr, valLL, valLL, valsField})

    occField := nextReg(cg)
    emitfmt(cg, "  %s = getelementptr inbounds %s, %s* %s, i32 0, i32 2\n", []string{occField, mapType, mapType, mapReg})
    occPtr := nextReg(cg)
    emitfmt(cg, "  %s = load i8*, i8** %s\n", []string{occPtr, occField})

    capField := nextReg(cg)
    emitfmt(cg, "  %s = getelementptr inbounds %s, %s* %s, i32 0, i32 3\n", []string{capField, mapType, mapType, mapReg})
    capReg := nextReg(cg)
    emitfmt(cg, "  %s = load i32, i32* %s\n", []string{capReg, capField})

    // If capacity is 0 (empty map), skip search and return default value.
    endLabel := nextLabel(cg)
    capZeroCheck := nextReg(cg)
    emitfmt(cg, "  %s = icmp eq i32 %s, 0\n", []string{capZeroCheck, capReg})
    searchLabel := nextLabel(cg)
    emitCondBranch(cg, capZeroCheck, endLabel, searchLabel)

    emitln(cg, str.Concat(searchLabel, ":\n"))
    // Compute hash and starting index.
    hashReg := nextReg(cg)
    if str.Equal(keyLL, "i8*") {
        emitfmt(cg, "  %s = call i32 @Skink_str_hash(i8* %s)\n", []string{hashReg, keyReg})
    } else {
        hashReg = keyReg
    }
    idxReg := nextReg(cg)
    emitfmt(cg, "  %s = srem i32 %s, %s\n", []string{idxReg, hashReg, capReg})
    negCheck := nextReg(cg)
    emitfmt(cg, "  %s = icmp slt i32 %s, 0\n", []string{negCheck, idxReg})
    negIdx := nextReg(cg)
    emitfmt(cg, "  %s = sub i32 0, %s\n", []string{negIdx, idxReg})
    startIdx := nextReg(cg)
    emitfmt(cg, "  %s = select i1 %s, i32 %s, i32 %s\n", []string{startIdx, negCheck, negIdx, idxReg})

    // Probe loop.
    idxAlloca := nextReg(cg)
    emitfmt(cg, "  %s = alloca i32\n", []string{idxAlloca})
    emitfmt(cg, "  store i32 %s, i32* %s\n", []string{startIdx, idxAlloca})

    condLabel := nextLabel(cg)
    bodyLabel := nextLabel(cg)
    foundLabel := nextLabel(cg)
    probeLabel := nextLabel(cg)
    emitBranch(cg, condLabel)

    emitln(cg, str.Concat(condLabel, ":\n"))
    iVal := nextReg(cg)
    emitfmt(cg, "  %s = load i32, i32* %s\n", []string{iVal, idxAlloca})
    occGep := nextReg(cg)
    emitfmt(cg, "  %s = getelementptr inbounds i8, i8* %s, i32 %s\n", []string{occGep, occPtr, iVal})
    occVal := nextReg(cg)
    emitfmt(cg, "  %s = load i8, i8* %s\n", []string{occVal, occGep})
    occBool := nextReg(cg)
    emitfmt(cg, "  %s = icmp eq i8 %s, 0\n", []string{occBool, occVal})
    emitCondBranch(cg, occBool, endLabel, bodyLabel)

    emitln(cg, str.Concat(bodyLabel, ":\n"))
    keyGep := nextReg(cg)
    emitfmt(cg, "  %s = getelementptr inbounds %s, %s* %s, i32 %s\n", []string{keyGep, keyLL, keyLL, keysPtr, iVal})
    curKey := nextReg(cg)
    emitfmt(cg, "  %s = load %s, %s* %s\n", []string{curKey, keyLL, keyLL, keyGep})

    var matchReg: string
    if str.Equal(keyLL, "i8*") {
        cmp := nextReg(cg)
        emitfmt(cg, "  %s = call i32 @strcmp(i8* %s, i8* %s)\n", []string{cmp, curKey, keyReg})
        matchReg = nextReg(cg)
        emitfmt(cg, "  %s = icmp eq i32 %s, 0\n", []string{matchReg, cmp})
    } else {
        matchReg = nextReg(cg)
        emitfmt(cg, "  %s = icmp eq %s %s, %s\n", []string{matchReg, keyLL, curKey, keyReg})
    }
    emitCondBranch(cg, matchReg, foundLabel, probeLabel)

    emitln(cg, str.Concat(foundLabel, ":\n"))
    valGep := nextReg(cg)
    emitfmt(cg, "  %s = getelementptr inbounds %s, %s* %s, i32 %s\n", []string{valGep, valLL, valLL, valsPtr, iVal})
    valReg := nextReg(cg)
    emitfmt(cg, "  %s = load %s, %s* %s\n", []string{valReg, valLL, valLL, valGep})
    emitfmt(cg, "  store %s %s, %s* %s\n", []string{valLL, valReg, valLL, resultAlloca})
    emitBranch(cg, endLabel)

    emitln(cg, str.Concat(probeLabel, ":\n"))
    nextI := nextReg(cg)
    emitfmt(cg, "  %s = add i32 %s, 1\n", []string{nextI, iVal})
    wrapI := nextReg(cg)
    emitfmt(cg, "  %s = srem i32 %s, %s\n", []string{wrapI, nextI, capReg})
    emitfmt(cg, "  store i32 %s, i32* %s\n", []string{wrapI, idxAlloca})
    emitBranch(cg, condLabel)

    // The probe block is already terminated by the branch above, so
    // emitLabel only writes the label; the nil path then falls into
    // endLabel's result load.
    emitLabel(cg, nilDoneL)
    emitBranch(cg, endLabel)
    cg.terminated = false
    emitln(cg, str.Concat(endLabel, ":\n"))
    result := nextReg(cg)
    emitfmt(cg, "  %s = load %s, %s* %s\n", []string{result, valLL, valLL, resultAlloca})
    return result
}

// emitMapIndexOk handles map[key] access with comma-ok: returns (value, found).
// Uses hash-based lookup with linear probing.
fn emitMapIndexOk(cg: *CodeGen, mapReg: string, keyReg: string, keyLL: string, valLL: string) -> (string, string) {
    mtName := mapTypeName(keyLL, valLL)
    emitMapTypeDecl(cg, mtName, keyLL, valLL)
    mapType := str.Concat("%", mtName)
    resultAlloca := nextReg(cg)
    emitfmt(cg, "  %s = alloca %s\n", []string{resultAlloca, valLL})
    if str.Equal(valLL, "i8*") {
        emptyStr := emitStringLiteral(cg, "")
        emitfmt(cg, "  store i8* %s, i8** %s\n", []string{emptyStr, resultAlloca})
    } else if str.EndsWith(valLL, "*") {
        emitfmt(cg, "  store %s null, %s* %s\n", []string{valLL, valLL, resultAlloca})
    } else if str.StartsWith(valLL, "%struct.") || str.StartsWith(valLL, "%map_") || str.StartsWith(valLL, "%set.") || str.StartsWith(valLL, "{") {
        emitfmt(cg, "  store %s zeroinitializer, %s* %s\n", []string{valLL, valLL, resultAlloca})
    } else {
        zv := zeroValueForLLType(valLL)
        emitfmt(cg, "  store %s %s, %s* %s\n", []string{valLL, zv, valLL, resultAlloca})
    }

    // ok alloca (i1)
    okAlloca := nextReg(cg)
    emitfmt(cg, "  %s = alloca i1\n", []string{okAlloca})
    emitfmt(cg, "  store i1 0, i1* %s\n", []string{okAlloca})

    // Nil map: return (zero, false) instead of dereferencing a null
    // struct — Go semantics (comp_error.md #80).
    isNilMap := nextReg(cg)
    emitfmt(cg, "  %s = icmp eq %s* %s, null\n", []string{isNilMap, mapType, mapReg})
    nilDoneL := nextLabel(cg)
    goBodyL := nextLabel(cg)
    emitCondBranch(cg, isNilMap, nilDoneL, goBodyL)
    emitLabel(cg, goBodyL)

    // Load keys (field 0), vals (field 1), occupied (field 2), capacity (field 3).
    keysField := nextReg(cg)
    emitfmt(cg, "  %s = getelementptr inbounds %s, %s* %s, i32 0, i32 0\n", []string{keysField, mapType, mapType, mapReg})
    keysPtr := nextReg(cg)
    emitfmt(cg, "  %s = load %s*, %s** %s\n", []string{keysPtr, keyLL, keyLL, keysField})

    valsField := nextReg(cg)
    emitfmt(cg, "  %s = getelementptr inbounds %s, %s* %s, i32 0, i32 1\n", []string{valsField, mapType, mapType, mapReg})
    valsPtr := nextReg(cg)
    emitfmt(cg, "  %s = load %s*, %s** %s\n", []string{valsPtr, valLL, valLL, valsField})

    occField := nextReg(cg)
    emitfmt(cg, "  %s = getelementptr inbounds %s, %s* %s, i32 0, i32 2\n", []string{occField, mapType, mapType, mapReg})
    occPtr := nextReg(cg)
    emitfmt(cg, "  %s = load i8*, i8** %s\n", []string{occPtr, occField})

    capField := nextReg(cg)
    emitfmt(cg, "  %s = getelementptr inbounds %s, %s* %s, i32 0, i32 3\n", []string{capField, mapType, mapType, mapReg})
    capReg := nextReg(cg)
    emitfmt(cg, "  %s = load i32, i32* %s\n", []string{capReg, capField})

    // If capacity is 0 (empty map), skip search and return default value + false.
    endLabel := nextLabel(cg)
    capZeroCheck := nextReg(cg)
    emitfmt(cg, "  %s = icmp eq i32 %s, 0\n", []string{capZeroCheck, capReg})
    searchLabel := nextLabel(cg)
    emitCondBranch(cg, capZeroCheck, endLabel, searchLabel)

    emitln(cg, str.Concat(searchLabel, ":\n"))
    // Compute hash and starting index.
    hashReg := nextReg(cg)
    if str.Equal(keyLL, "i8*") {
        emitfmt(cg, "  %s = call i32 @Skink_str_hash(i8* %s)\n", []string{hashReg, keyReg})
    } else {
        hashReg = keyReg
    }
    idxReg := nextReg(cg)
    emitfmt(cg, "  %s = srem i32 %s, %s\n", []string{idxReg, hashReg, capReg})
    negCheck := nextReg(cg)
    emitfmt(cg, "  %s = icmp slt i32 %s, 0\n", []string{negCheck, idxReg})
    negIdx := nextReg(cg)
    emitfmt(cg, "  %s = sub i32 0, %s\n", []string{negIdx, idxReg})
    startIdx := nextReg(cg)
    emitfmt(cg, "  %s = select i1 %s, i32 %s, i32 %s\n", []string{startIdx, negCheck, negIdx, idxReg})

    // Probe loop.
    idxAlloca := nextReg(cg)
    emitfmt(cg, "  %s = alloca i32\n", []string{idxAlloca})
    emitfmt(cg, "  store i32 %s, i32* %s\n", []string{startIdx, idxAlloca})

    condLabel := nextLabel(cg)
    bodyLabel := nextLabel(cg)
    foundLabel := nextLabel(cg)
    probeLabel := nextLabel(cg)
    emitBranch(cg, condLabel)

    emitln(cg, str.Concat(condLabel, ":\n"))
    iVal := nextReg(cg)
    emitfmt(cg, "  %s = load i32, i32* %s\n", []string{iVal, idxAlloca})
    occGep := nextReg(cg)
    emitfmt(cg, "  %s = getelementptr inbounds i8, i8* %s, i32 %s\n", []string{occGep, occPtr, iVal})
    occVal := nextReg(cg)
    emitfmt(cg, "  %s = load i8, i8* %s\n", []string{occVal, occGep})
    occBool := nextReg(cg)
    emitfmt(cg, "  %s = icmp eq i8 %s, 0\n", []string{occBool, occVal})
    emitCondBranch(cg, occBool, endLabel, bodyLabel)

    emitln(cg, str.Concat(bodyLabel, ":\n"))
    keyGep := nextReg(cg)
    emitfmt(cg, "  %s = getelementptr inbounds %s, %s* %s, i32 %s\n", []string{keyGep, keyLL, keyLL, keysPtr, iVal})
    curKey := nextReg(cg)
    emitfmt(cg, "  %s = load %s, %s* %s\n", []string{curKey, keyLL, keyLL, keyGep})

    var matchReg: string
    if str.Equal(keyLL, "i8*") {
        cmp := nextReg(cg)
        emitfmt(cg, "  %s = call i32 @strcmp(i8* %s, i8* %s)\n", []string{cmp, curKey, keyReg})
        matchReg = nextReg(cg)
        emitfmt(cg, "  %s = icmp eq i32 %s, 0\n", []string{matchReg, cmp})
    } else {
        matchReg = nextReg(cg)
        emitfmt(cg, "  %s = icmp eq %s %s, %s\n", []string{matchReg, keyLL, curKey, keyReg})
    }
    emitCondBranch(cg, matchReg, foundLabel, probeLabel)

    emitln(cg, str.Concat(foundLabel, ":\n"))
    valGep := nextReg(cg)
    emitfmt(cg, "  %s = getelementptr inbounds %s, %s* %s, i32 %s\n", []string{valGep, valLL, valLL, valsPtr, iVal})
    valReg := nextReg(cg)
    emitfmt(cg, "  %s = load %s, %s* %s\n", []string{valReg, valLL, valLL, valGep})
    emitfmt(cg, "  store %s %s, %s* %s\n", []string{valLL, valReg, valLL, resultAlloca})
    emitfmt(cg, "  store i1 1, i1* %s\n", []string{okAlloca})
    emitBranch(cg, endLabel)

    emitln(cg, str.Concat(probeLabel, ":\n"))
    nextI := nextReg(cg)
    emitfmt(cg, "  %s = add i32 %s, 1\n", []string{nextI, iVal})
    wrapI := nextReg(cg)
    emitfmt(cg, "  %s = srem i32 %s, %s\n", []string{wrapI, nextI, capReg})
    emitfmt(cg, "  store i32 %s, i32* %s\n", []string{wrapI, idxAlloca})
    emitBranch(cg, condLabel)

    emitLabel(cg, nilDoneL)
    emitBranch(cg, endLabel)
    cg.terminated = false
    emitln(cg, str.Concat(endLabel, ":\n"))
    result := nextReg(cg)
    emitfmt(cg, "  %s = load %s, %s* %s\n", []string{result, valLL, valLL, resultAlloca})
    okResult := nextReg(cg)
    emitfmt(cg, "  %s = load i1, i1* %s\n", []string{okResult, okAlloca})
    return result, okResult
}

// emitMapIndexAssignment handles map[key] = value with hash-based search, update, and insert.
// If the key exists, updates the value. If not, inserts a new entry, resizing (rehashing)
// when the load factor exceeds 75%.
fn emitMapIndexAssignment(cg: *CodeGen, mapReg: string, keyReg: string, keyLL: string, valLL: string, value: ast.Expr, op: string) {
    mtName := mapTypeName(keyLL, valLL)
    emitMapTypeDecl(cg, mtName, keyLL, valLL)
    mapType := str.Concat("%", mtName)

    // Writing to a nil map dereferences a null struct pointer — panic
    // instead, matching Go (comp_error.md #80). Reads stay nil-safe.
    isNilMap := nextReg(cg)
    emitfmt(cg, "  %s = icmp eq %s* %s, null\n", []string{isNilMap, mapType, mapReg})
    nilMapL := nextLabel(cg)
    okMapL := nextLabel(cg)
    emitCondBranch(cg, isNilMap, nilMapL, okMapL)
    emitLabel(cg, nilMapL)
    nilMapMsg := emitStringLiteral(cg, "assignment to entry in nil map")
    emitfmt(cg, "  call void @Skink_panic(i8* %s)\n", []string{nilMapMsg})
    emitln(cg, "  unreachable")
    emitLabel(cg, okMapL)

    // Load keys (field 0), vals (field 1), occupied (field 2), capacity (field 3), count (field 4).
    keysField := nextReg(cg)
    emitfmt(cg, "  %s = getelementptr inbounds %s, %s* %s, i32 0, i32 0\n", []string{keysField, mapType, mapType, mapReg})
    keysPtr := nextReg(cg)
    emitfmt(cg, "  %s = load %s*, %s** %s\n", []string{keysPtr, keyLL, keyLL, keysField})

    valsField := nextReg(cg)
    emitfmt(cg, "  %s = getelementptr inbounds %s, %s* %s, i32 0, i32 1\n", []string{valsField, mapType, mapType, mapReg})
    valsPtr := nextReg(cg)
    emitfmt(cg, "  %s = load %s*, %s** %s\n", []string{valsPtr, valLL, valLL, valsField})

    occField := nextReg(cg)
    emitfmt(cg, "  %s = getelementptr inbounds %s, %s* %s, i32 0, i32 2\n", []string{occField, mapType, mapType, mapReg})
    occPtr := nextReg(cg)
    emitfmt(cg, "  %s = load i8*, i8** %s\n", []string{occPtr, occField})

    capField := nextReg(cg)
    emitfmt(cg, "  %s = getelementptr inbounds %s, %s* %s, i32 0, i32 3\n", []string{capField, mapType, mapType, mapReg})
    capReg := nextReg(cg)
    emitfmt(cg, "  %s = load i32, i32* %s\n", []string{capReg, capField})

    countField := nextReg(cg)
    emitfmt(cg, "  %s = getelementptr inbounds %s, %s* %s, i32 0, i32 4\n", []string{countField, mapType, mapType, mapReg})
    countReg := nextReg(cg)
    emitfmt(cg, "  %s = load i32, i32* %s\n", []string{countReg, countField})

    valReg := emitExpression(cg, value)
    valType := exprLLType(cg, value)
    if str.Equal(valType, "i1") && !str.Equal(valLL, "i1") {
        zextReg := nextReg(cg)
        emitfmt(cg, "  %s = zext i1 %s to i32\n", []string{zextReg, valReg})
        valReg = zextReg
        valType = "i32"
    }
    if str.Equal(valType, "i32") && str.Equal(valLL, "i8") {
        truncReg := nextReg(cg)
        emitfmt(cg, "  %s = trunc i32 %s to i8\n", []string{truncReg, valReg})
        valReg = truncReg
        valType = "i8"
    }
    if str.EndsWith(valType, "*") && str.Equal(valType, str.Concat(valLL, "*")) &&
        (str.StartsWith(valLL, "%struct.") || str.StartsWith(valLL, "%map_") || str.StartsWith(valLL, "%set.")) {
        loadReg := nextReg(cg)
        emitfmt(cg, "  %s = load %s, %s* %s\n", []string{loadReg, valLL, valType, valReg})
        valReg = loadReg
        valType = valLL
    }
    // General integer width coercion (e.g. an i32 `-9` literal stored
    // into a map[string]int16 value slot).
    if str.StartsWith(valType, "i") && str.StartsWith(valLL, "i") &&
        !str.EndsWith(valType, "*") && !str.Equal(valType, valLL) {
        valReg = coerceExprToParamType(cg, valReg, valType, valLL, value)
        valType = valLL
    }
    needCompound := !str.Equal(op, "=")

    // Allocate found flag and index before the capacity check (needed by both paths).
    foundFlag := nextReg(cg)
    emitfmt(cg, "  %s = alloca i1\n", []string{foundFlag})
    emitfmt(cg, "  store i1 0, i1* %s\n", []string{foundFlag})
    foundIdx := nextReg(cg)
    emitfmt(cg, "  %s = alloca i32\n", []string{foundIdx})
    emitfmt(cg, "  store i32 0, i32* %s\n", []string{foundIdx})

    // Compute hash (always needed for both search and insert paths).
    hashReg := nextReg(cg)
    if str.Equal(keyLL, "i8*") {
        emitfmt(cg, "  %s = call i32 @Skink_str_hash(i8* %s)\n", []string{hashReg, keyReg})
    } else {
        hashReg = keyReg
    }

    // Compute startIdx safely: if capacity == 0, use 0 to avoid division by zero.
    // (The no-resize insert path uses startIdx; when capacity == 0, resize always
    // happens, so the 0 default is never actually used for insertion.)
    capZeroCheck := nextReg(cg)
    emitfmt(cg, "  %s = icmp eq i32 %s, 0\n", []string{capZeroCheck, capReg})
    safeCap := nextReg(cg)
    emitfmt(cg, "  %s = select i1 %s, i32 1, i32 %s\n", []string{safeCap, capZeroCheck, capReg})
    idxReg := nextReg(cg)
    emitfmt(cg, "  %s = srem i32 %s, %s\n", []string{idxReg, hashReg, safeCap})
    negCheck := nextReg(cg)
    emitfmt(cg, "  %s = icmp slt i32 %s, 0\n", []string{negCheck, idxReg})
    negIdx := nextReg(cg)
    emitfmt(cg, "  %s = sub i32 0, %s\n", []string{negIdx, idxReg})
    startIdx := nextReg(cg)
    emitfmt(cg, "  %s = select i1 %s, i32 %s, i32 %s\n", []string{startIdx, negCheck, negIdx, idxReg})

    // If capacity is 0 (empty map from make()), skip search and go directly to insert.
    searchEndLabel := nextLabel(cg)
    skipSearchLabel := nextLabel(cg)
    emitCondBranch(cg, capZeroCheck, searchEndLabel, skipSearchLabel)

    emitln(cg, str.Concat(skipSearchLabel, ":\n"))

    // Probe loop: search for the key or an empty slot.
    idxAlloca := nextReg(cg)
    emitfmt(cg, "  %s = alloca i32\n", []string{idxAlloca})
    emitfmt(cg, "  store i32 %s, i32* %s\n", []string{startIdx, idxAlloca})

    condLabel := nextLabel(cg)
    bodyLabel := nextLabel(cg)
    foundLabel := nextLabel(cg)
    probeLabel := nextLabel(cg)
    emitBranch(cg, condLabel)

    emitln(cg, str.Concat(condLabel, ":\n"))
    iVal := nextReg(cg)
    emitfmt(cg, "  %s = load i32, i32* %s\n", []string{iVal, idxAlloca})
    occGep := nextReg(cg)
    emitfmt(cg, "  %s = getelementptr inbounds i8, i8* %s, i32 %s\n", []string{occGep, occPtr, iVal})
    occVal := nextReg(cg)
    emitfmt(cg, "  %s = load i8, i8* %s\n", []string{occVal, occGep})
    occBool := nextReg(cg)
    emitfmt(cg, "  %s = icmp eq i8 %s, 0\n", []string{occBool, occVal})
    emitCondBranch(cg, occBool, searchEndLabel, bodyLabel)

    emitln(cg, str.Concat(bodyLabel, ":\n"))
    keyGep := nextReg(cg)
    emitfmt(cg, "  %s = getelementptr inbounds %s, %s* %s, i32 %s\n", []string{keyGep, keyLL, keyLL, keysPtr, iVal})
    curKey := nextReg(cg)
    emitfmt(cg, "  %s = load %s, %s* %s\n", []string{curKey, keyLL, keyLL, keyGep})

    var matchReg: string
    if str.Equal(keyLL, "i8*") {
        cmp := nextReg(cg)
        emitfmt(cg, "  %s = call i32 @strcmp(i8* %s, i8* %s)\n", []string{cmp, curKey, keyReg})
        matchReg = nextReg(cg)
        emitfmt(cg, "  %s = icmp eq i32 %s, 0\n", []string{matchReg, cmp})
    } else {
        matchReg = nextReg(cg)
        emitfmt(cg, "  %s = icmp eq %s %s, %s\n", []string{matchReg, keyLL, curKey, keyReg})
    }
    emitCondBranch(cg, matchReg, foundLabel, probeLabel)

    emitln(cg, str.Concat(foundLabel, ":\n"))
    emitfmt(cg, "  store i1 1, i1* %s\n", []string{foundFlag})
    emitfmt(cg, "  store i32 %s, i32* %s\n", []string{iVal, foundIdx})
    emitBranch(cg, searchEndLabel)

    emitln(cg, str.Concat(probeLabel, ":\n"))
    nextI := nextReg(cg)
    emitfmt(cg, "  %s = add i32 %s, 1\n", []string{nextI, iVal})
    wrapI := nextReg(cg)
    emitfmt(cg, "  %s = srem i32 %s, %s\n", []string{wrapI, nextI, capReg})
    emitfmt(cg, "  store i32 %s, i32* %s\n", []string{wrapI, idxAlloca})
    emitBranch(cg, condLabel)

    cg.terminated = false
    emitln(cg, str.Concat(searchEndLabel, ":\n"))
    wasFound := nextReg(cg)
    emitfmt(cg, "  %s = load i1, i1* %s\n", []string{wasFound, foundFlag})
    updateLabel := nextLabel(cg)
    insertLabel := nextLabel(cg)
    endLabel := nextLabel(cg)
    emitCondBranch(cg, wasFound, updateLabel, insertLabel)

    // Update: key found, store new value at the found index.
    emitln(cg, str.Concat(updateLabel, ":\n"))
    idxReg2 := nextReg(cg)
    emitfmt(cg, "  %s = load i32, i32* %s\n", []string{idxReg2, foundIdx})
    valGep := nextReg(cg)
    emitfmt(cg, "  %s = getelementptr inbounds %s, %s* %s, i32 %s\n", []string{valGep, valLL, valLL, valsPtr, idxReg2})
    if needCompound {
        oldVal := nextReg(cg)
        emitfmt(cg, "  %s = load %s, %s* %s\n", []string{oldVal, valLL, valLL, valGep})
        valReg = computeCompoundOp(cg, oldVal, valReg, op, valLL, false)
    }
    // The map owns a reference: retain the new value before releasing the
    // previous one — they may alias (m[k] = m[k]).
    if isHeapLLType(valLL) {
        valCast := nextReg(cg)
        emitfmt(cg, "  %s = bitcast %s %s to i8*\n", []string{valCast, valLL, valReg})
        emitfmt(cg, "  call i8* @Skink_rc_retain(i8* %s)\n", []string{valCast})
        oldStored := nextReg(cg)
        emitfmt(cg, "  %s = load %s, %s* %s\n", []string{oldStored, valLL, valLL, valGep})
        emitRelease(cg, oldStored, valLL)
    }
    // Struct-by-value: the map copy must own references to the
    // struct's heap fields; retain the new value's fields before
    // releasing the old value's (they may share them). Use a block-local
    // register — the retain emits instructions valid only in this block.
    updValReg := valReg
    if isCompositeType(valLL) && !str.EndsWith(valLL, "*") {
        updValReg = emitRetainStructHeapFields(cg, valReg, valLL)
        oldStored := nextReg(cg)
        emitfmt(cg, "  %s = load %s, %s* %s\n", []string{oldStored, valLL, valLL, valGep})
        oldAlloca := emitAlloca(cg, valLL)
        emitStore(cg, valLL, oldStored, valLL, oldAlloca)
        emitReleaseStructHeapFields(cg, oldAlloca, valLL)
    }
    emitfmt(cg, "  store %s %s, %s* %s\n", []string{valLL, updValReg, valLL, valGep})
    emitBranch(cg, endLabel)

    // Insert: key not found. Check if resize is needed (load factor > 75%).
    emitln(cg, str.Concat(insertLabel, ":\n"))
    // newCount = count + 1
    newCount := nextReg(cg)
    emitfmt(cg, "  %s = add i32 %s, 1\n", []string{newCount, countReg})
    // threshold = capacity * 3 / 4
    threshold := nextReg(cg)
    emitfmt(cg, "  %s = mul i32 %s, 3\n", []string{threshold, capReg})
    thresholdDiv := nextReg(cg)
    emitfmt(cg, "  %s = sdiv i32 %s, 4\n", []string{thresholdDiv, threshold})
    needResizeReg := nextReg(cg)
    emitfmt(cg, "  %s = icmp sgt i32 %s, %s\n", []string{needResizeReg, newCount, thresholdDiv})

    resizeLabel := nextLabel(cg)
    noResizeLabel := nextLabel(cg)
    emitCondBranch(cg, needResizeReg, resizeLabel, noResizeLabel)

    // Resize path: allocate new arrays with 2x capacity, rehash all entries, then insert.
    emitln(cg, str.Concat(resizeLabel, ":\n"))
    doubleCap := nextReg(cg)
    emitfmt(cg, "  %s = mul i32 %s, 2\n", []string{doubleCap, capReg})
    capZero := nextReg(cg)
    emitfmt(cg, "  %s = icmp eq i32 %s, 0\n", []string{capZero, doubleCap})
    newCap := nextReg(cg)
    // If capacity was 0, use initial capacity of 8 instead of 0*2=0.
    emitfmt(cg, "  %s = select i1 %s, i32 8, i32 %s\n", []string{newCap, capZero, doubleCap})

    keyElemSize := emitElemSize(cg, keyLL)
    valElemSize := emitElemSize(cg, valLL)

    newKeysBytes := nextReg(cg)
    emitfmt(cg, "  %s = mul i32 %s, %s\n", []string{newKeysBytes, newCap, keyElemSize})
    newKeysBytes64 := nextReg(cg)
    emitfmt(cg, "  %s = zext i32 %s to i64\n", []string{newKeysBytes64, newKeysBytes})
    newKeysRaw := emitMapArrayAlloc(cg, keyLL, newKeysBytes64)
    newKeysPtr := nextReg(cg)
    emitfmt(cg, "  %s = bitcast i8* %s to %s*\n", []string{newKeysPtr, newKeysRaw, keyLL})

    newValsBytes := nextReg(cg)
    emitfmt(cg, "  %s = mul i32 %s, %s\n", []string{newValsBytes, newCap, valElemSize})
    newValsBytes64 := nextReg(cg)
    emitfmt(cg, "  %s = zext i32 %s to i64\n", []string{newValsBytes64, newValsBytes})
    newValsRaw := emitMapArrayAlloc(cg, valLL, newValsBytes64)
    newValsPtr := nextReg(cg)
    emitfmt(cg, "  %s = bitcast i8* %s to %s*\n", []string{newValsPtr, newValsRaw, valLL})

    // Allocate new occupied array, zeroed.
    newOccBytes64 := nextReg(cg)
    emitfmt(cg, "  %s = zext i32 %s to i64\n", []string{newOccBytes64, newCap})
    newOccRaw := nextReg(cg)
    emitfmt(cg, "  %s = call i8* @Skink_rc_alloc(i64 %s)\n", []string{newOccRaw, newOccBytes64})
    newOccPtr := nextReg(cg)
    emitfmt(cg, "  %s = bitcast i8* %s to i8*\n", []string{newOccPtr, newOccRaw})
    emitfmt(cg, "  call void @llvm.memset.p0i8.i64(i8* %s, i8 0, i64 %s, i1 false)\n", []string{newOccPtr, newOccBytes64})

    // Rehash: iterate over old occupied slots and re-insert into new arrays.
    rehashI := nextReg(cg)
    emitfmt(cg, "  %s = alloca i32\n", []string{rehashI})
    emitfmt(cg, "  store i32 0, i32* %s\n", []string{rehashI})
    rehashCond := nextLabel(cg)
    rehashBody := nextLabel(cg)
    rehashSkip := nextLabel(cg)
    rehashProbe := nextLabel(cg)
    rehashEnd := nextLabel(cg)
    emitBranch(cg, rehashCond)

    emitln(cg, str.Concat(rehashCond, ":\n"))
    riVal := nextReg(cg)
    emitfmt(cg, "  %s = load i32, i32* %s\n", []string{riVal, rehashI})
    riCond := nextReg(cg)
    emitfmt(cg, "  %s = icmp slt i32 %s, %s\n", []string{riCond, riVal, capReg})
    emitCondBranch(cg, riCond, rehashBody, rehashEnd)

    emitln(cg, str.Concat(rehashBody, ":\n"))
    oldOccGep := nextReg(cg)
    emitfmt(cg, "  %s = getelementptr inbounds i8, i8* %s, i32 %s\n", []string{oldOccGep, occPtr, riVal})
    oldOccVal := nextReg(cg)
    emitfmt(cg, "  %s = load i8, i8* %s\n", []string{oldOccVal, oldOccGep})
    oldOccBool := nextReg(cg)
    emitfmt(cg, "  %s = icmp eq i8 %s, 0\n", []string{oldOccBool, oldOccVal})
    emitCondBranch(cg, oldOccBool, rehashSkip, rehashProbe)

    emitln(cg, str.Concat(rehashProbe, ":\n"))
    // Load old key and value.
    oldKeyGep := nextReg(cg)
    emitfmt(cg, "  %s = getelementptr inbounds %s, %s* %s, i32 %s\n", []string{oldKeyGep, keyLL, keyLL, keysPtr, riVal})
    oldKeyVal := nextReg(cg)
    emitfmt(cg, "  %s = load %s, %s* %s\n", []string{oldKeyVal, keyLL, keyLL, oldKeyGep})
    oldValGep := nextReg(cg)
    emitfmt(cg, "  %s = getelementptr inbounds %s, %s* %s, i32 %s\n", []string{oldValGep, valLL, valLL, valsPtr, riVal})
    oldValVal := nextReg(cg)
    emitfmt(cg, "  %s = load %s, %s* %s\n", []string{oldValVal, valLL, valLL, oldValGep})
    // Compute new hash index.
    rehashHash := nextReg(cg)
    if str.Equal(keyLL, "i8*") {
        emitfmt(cg, "  %s = call i32 @Skink_str_hash(i8* %s)\n", []string{rehashHash, oldKeyVal})
    } else {
        rehashHash = oldKeyVal
    }
    rehashIdx := nextReg(cg)
    emitfmt(cg, "  %s = srem i32 %s, %s\n", []string{rehashIdx, rehashHash, newCap})
    rehashNeg := nextReg(cg)
    emitfmt(cg, "  %s = icmp slt i32 %s, 0\n", []string{rehashNeg, rehashIdx})
    rehashNegIdx := nextReg(cg)
    emitfmt(cg, "  %s = sub i32 0, %s\n", []string{rehashNegIdx, rehashIdx})
    rehashStart := nextReg(cg)
    emitfmt(cg, "  %s = select i1 %s, i32 %s, i32 %s\n", []string{rehashStart, rehashNeg, rehashNegIdx, rehashIdx})
    // Probe for empty slot in new arrays.
    rehashProbeAlloca := nextReg(cg)
    emitfmt(cg, "  %s = alloca i32\n", []string{rehashProbeAlloca})
    emitfmt(cg, "  store i32 %s, i32* %s\n", []string{rehashStart, rehashProbeAlloca})
    rehashPCond := nextLabel(cg)
    rehashPBody := nextLabel(cg)
    rehashPStore := nextLabel(cg)
    emitBranch(cg, rehashPCond)

    emitln(cg, str.Concat(rehashPCond, ":\n"))
    rpVal := nextReg(cg)
    emitfmt(cg, "  %s = load i32, i32* %s\n", []string{rpVal, rehashProbeAlloca})
    newOccGep := nextReg(cg)
    emitfmt(cg, "  %s = getelementptr inbounds i8, i8* %s, i32 %s\n", []string{newOccGep, newOccPtr, rpVal})
    newOccVal := nextReg(cg)
    emitfmt(cg, "  %s = load i8, i8* %s\n", []string{newOccVal, newOccGep})
    newOccBool := nextReg(cg)
    emitfmt(cg, "  %s = icmp eq i8 %s, 0\n", []string{newOccBool, newOccVal})
    emitCondBranch(cg, newOccBool, rehashPStore, rehashPBody)

    emitln(cg, str.Concat(rehashPBody, ":\n"))
    rpNext := nextReg(cg)
    emitfmt(cg, "  %s = add i32 %s, 1\n", []string{rpNext, rpVal})
    rpWrap := nextReg(cg)
    emitfmt(cg, "  %s = srem i32 %s, %s\n", []string{rpWrap, rpNext, newCap})
    emitfmt(cg, "  store i32 %s, i32* %s\n", []string{rpWrap, rehashProbeAlloca})
    emitBranch(cg, rehashPCond)

    emitln(cg, str.Concat(rehashPStore, ":\n"))
    rpStoreVal := nextReg(cg)
    emitfmt(cg, "  %s = load i32, i32* %s\n", []string{rpStoreVal, rehashProbeAlloca})
    nkGep := nextReg(cg)
    emitfmt(cg, "  %s = getelementptr inbounds %s, %s* %s, i32 %s\n", []string{nkGep, keyLL, keyLL, newKeysPtr, rpStoreVal})
    // The new arrays must own a reference to each moved element: retain
    // here so the old arrays' destructor release (below) balances out.
    if isHeapLLType(keyLL) {
        rkCast := nextReg(cg)
        emitfmt(cg, "  %s = bitcast %s %s to i8*\n", []string{rkCast, keyLL, oldKeyVal})
        emitfmt(cg, "  call i8* @Skink_rc_retain(i8* %s)\n", []string{rkCast})
    }
    if isCompositeType(keyLL) && !str.EndsWith(keyLL, "*") {
        oldKeyVal = emitRetainStructHeapFields(cg, oldKeyVal, keyLL)
    }
    emitStore(cg, keyLL, oldKeyVal, keyLL, nkGep)
    nvGep := nextReg(cg)
    emitfmt(cg, "  %s = getelementptr inbounds %s, %s* %s, i32 %s\n", []string{nvGep, valLL, valLL, newValsPtr, rpStoreVal})
    if isHeapLLType(valLL) {
        rvCast := nextReg(cg)
        emitfmt(cg, "  %s = bitcast %s %s to i8*\n", []string{rvCast, valLL, oldValVal})
        emitfmt(cg, "  call i8* @Skink_rc_retain(i8* %s)\n", []string{rvCast})
    }
    if isCompositeType(valLL) && !str.EndsWith(valLL, "*") {
        oldValVal = emitRetainStructHeapFields(cg, oldValVal, valLL)
    }
    emitStore(cg, valLL, oldValVal, valLL, nvGep)
    noGep := nextReg(cg)
    emitfmt(cg, "  %s = getelementptr inbounds i8, i8* %s, i32 %s\n", []string{noGep, newOccPtr, rpStoreVal})
    emitfmt(cg, "  store i8 1, i8* %s\n", []string{noGep})
    emitBranch(cg, rehashSkip)

    emitln(cg, str.Concat(rehashSkip, ":\n"))
    riNext := nextReg(cg)
    emitfmt(cg, "  %s = add i32 %s, 1\n", []string{riNext, riVal})
    emitfmt(cg, "  store i32 %s, i32* %s\n", []string{riNext, rehashI})
    emitBranch(cg, rehashCond)

    emitln(cg, str.Concat(rehashEnd, ":\n"))
    // Now insert the new key into the new (resized) arrays.
    insHash := nextReg(cg)
    if str.Equal(keyLL, "i8*") {
        emitfmt(cg, "  %s = call i32 @Skink_str_hash(i8* %s)\n", []string{insHash, keyReg})
    } else {
        insHash = keyReg
    }
    insIdx := nextReg(cg)
    emitfmt(cg, "  %s = srem i32 %s, %s\n", []string{insIdx, insHash, newCap})
    insNeg := nextReg(cg)
    emitfmt(cg, "  %s = icmp slt i32 %s, 0\n", []string{insNeg, insIdx})
    insNegIdx := nextReg(cg)
    emitfmt(cg, "  %s = sub i32 0, %s\n", []string{insNegIdx, insIdx})
    insStart := nextReg(cg)
    emitfmt(cg, "  %s = select i1 %s, i32 %s, i32 %s\n", []string{insStart, insNeg, insNegIdx, insIdx})
    insProbeAlloca := nextReg(cg)
    emitfmt(cg, "  %s = alloca i32\n", []string{insProbeAlloca})
    emitfmt(cg, "  store i32 %s, i32* %s\n", []string{insStart, insProbeAlloca})
    insPCond := nextLabel(cg)
    insPBody := nextLabel(cg)
    insPStore := nextLabel(cg)
    emitBranch(cg, insPCond)

    emitln(cg, str.Concat(insPCond, ":\n"))
    ipVal := nextReg(cg)
    emitfmt(cg, "  %s = load i32, i32* %s\n", []string{ipVal, insProbeAlloca})
    insOccGep := nextReg(cg)
    emitfmt(cg, "  %s = getelementptr inbounds i8, i8* %s, i32 %s\n", []string{insOccGep, newOccPtr, ipVal})
    insOccVal := nextReg(cg)
    emitfmt(cg, "  %s = load i8, i8* %s\n", []string{insOccVal, insOccGep})
    insOccBool := nextReg(cg)
    emitfmt(cg, "  %s = icmp eq i8 %s, 0\n", []string{insOccBool, insOccVal})
    emitCondBranch(cg, insOccBool, insPStore, insPBody)

    emitln(cg, str.Concat(insPBody, ":\n"))
    ipNext := nextReg(cg)
    emitfmt(cg, "  %s = add i32 %s, 1\n", []string{ipNext, ipVal})
    ipWrap := nextReg(cg)
    emitfmt(cg, "  %s = srem i32 %s, %s\n", []string{ipWrap, ipNext, newCap})
    emitfmt(cg, "  store i32 %s, i32* %s\n", []string{ipWrap, insProbeAlloca})
    emitBranch(cg, insPCond)

    emitln(cg, str.Concat(insPStore, ":\n"))
    ipStoreVal := nextReg(cg)
    emitfmt(cg, "  %s = load i32, i32* %s\n", []string{ipStoreVal, insProbeAlloca})
    insKeyGep := nextReg(cg)
    emitfmt(cg, "  %s = getelementptr inbounds %s, %s* %s, i32 %s\n", []string{insKeyGep, keyLL, keyLL, newKeysPtr, ipStoreVal})
    // Retain RC-managed keys. Block-local registers: these retains emit
    // instructions valid only in this block, so they must not overwrite
    // the shared keyReg/valReg used by sibling blocks.
    insKeyReg := keyReg
    if isHeapLLType(keyLL) {
        keyCast := nextReg(cg)
        emitfmt(cg, "  %s = bitcast %s %s to i8*\n", []string{keyCast, keyLL, keyReg})
        emitfmt(cg, "  call i8* @Skink_rc_retain(i8* %s)\n", []string{keyCast})
    }
    if isCompositeType(keyLL) && !str.EndsWith(keyLL, "*") {
        insKeyReg = emitRetainStructHeapFields(cg, keyReg, keyLL)
    }
    emitStore(cg, keyLL, insKeyReg, keyLL, insKeyGep)
    insValGep := nextReg(cg)
    emitfmt(cg, "  %s = getelementptr inbounds %s, %s* %s, i32 %s\n", []string{insValGep, valLL, valLL, newValsPtr, ipStoreVal})
    // Retain RC-managed values.
    insValReg := valReg
    if isHeapLLType(valLL) {
        valCast := nextReg(cg)
        emitfmt(cg, "  %s = bitcast %s %s to i8*\n", []string{valCast, valLL, valReg})
        emitfmt(cg, "  call i8* @Skink_rc_retain(i8* %s)\n", []string{valCast})
    }
    if isCompositeType(valLL) && !str.EndsWith(valLL, "*") {
        insValReg = emitRetainStructHeapFields(cg, valReg, valLL)
    }
    emitStore(cg, valLL, insValReg, valLL, insValGep)
    insOccGep2 := nextReg(cg)
    emitfmt(cg, "  %s = getelementptr inbounds i8, i8* %s, i32 %s\n", []string{insOccGep2, newOccPtr, ipStoreVal})
    emitfmt(cg, "  store i8 1, i8* %s\n", []string{insOccGep2})

    // Update map struct fields with new arrays and capacity.
    newKeysField := nextReg(cg)
    emitfmt(cg, "  %s = getelementptr inbounds %s, %s* %s, i32 0, i32 0\n", []string{newKeysField, mapType, mapType, mapReg})
    emitfmt(cg, "  store %s* %s, %s** %s\n", []string{keyLL, newKeysPtr, keyLL, newKeysField})
    newValsField := nextReg(cg)
    emitfmt(cg, "  %s = getelementptr inbounds %s, %s* %s, i32 0, i32 1\n", []string{newValsField, mapType, mapType, mapReg})
    emitfmt(cg, "  store %s* %s, %s** %s\n", []string{valLL, newValsPtr, valLL, newValsField})
    newOccField := nextReg(cg)
    emitfmt(cg, "  %s = getelementptr inbounds %s, %s* %s, i32 0, i32 2\n", []string{newOccField, mapType, mapType, mapReg})
    emitfmt(cg, "  store i8* %s, i8** %s\n", []string{newOccPtr, newOccField})
    newCapField := nextReg(cg)
    emitfmt(cg, "  %s = getelementptr inbounds %s, %s* %s, i32 0, i32 3\n", []string{newCapField, mapType, mapType, mapReg})
    emitfmt(cg, "  store i32 %s, i32* %s\n", []string{newCap, newCapField})
    newCountField := nextReg(cg)
    emitfmt(cg, "  %s = getelementptr inbounds %s, %s* %s, i32 0, i32 4\n", []string{newCountField, mapType, mapType, mapReg})
    emitfmt(cg, "  store i32 %s, i32* %s\n", []string{newCount, newCountField})

    // Release old arrays.
    oldKeysRaw := nextReg(cg)
    emitfmt(cg, "  %s = bitcast %s* %s to i8*\n", []string{oldKeysRaw, keyLL, keysPtr})
    emitfmt(cg, "  call void @Skink_rc_release(i8* %s)\n", []string{oldKeysRaw})
    oldValsRaw := nextReg(cg)
    emitfmt(cg, "  %s = bitcast %s* %s to i8*\n", []string{oldValsRaw, valLL, valsPtr})
    emitfmt(cg, "  call void @Skink_rc_release(i8* %s)\n", []string{oldValsRaw})
    oldOccRaw := nextReg(cg)
    emitfmt(cg, "  %s = bitcast i8* %s to i8*\n", []string{oldOccRaw, occPtr})
    emitfmt(cg, "  call void @Skink_rc_release(i8* %s)\n", []string{oldOccRaw})
    emitBranch(cg, endLabel)

    // No-resize path: insert into existing arrays.
    emitln(cg, str.Concat(noResizeLabel, ":\n"))
    // Find empty slot starting from startIdx.
    noResizeProbeAlloca := nextReg(cg)
    emitfmt(cg, "  %s = alloca i32\n", []string{noResizeProbeAlloca})
    emitfmt(cg, "  store i32 %s, i32* %s\n", []string{startIdx, noResizeProbeAlloca})
    nrCond := nextLabel(cg)
    nrBody := nextLabel(cg)
    nrStore := nextLabel(cg)
    emitBranch(cg, nrCond)

    emitln(cg, str.Concat(nrCond, ":\n"))
    nrVal := nextReg(cg)
    emitfmt(cg, "  %s = load i32, i32* %s\n", []string{nrVal, noResizeProbeAlloca})
    nrOccGep := nextReg(cg)
    emitfmt(cg, "  %s = getelementptr inbounds i8, i8* %s, i32 %s\n", []string{nrOccGep, occPtr, nrVal})
    nrOccVal := nextReg(cg)
    emitfmt(cg, "  %s = load i8, i8* %s\n", []string{nrOccVal, nrOccGep})
    nrOccBool := nextReg(cg)
    emitfmt(cg, "  %s = icmp eq i8 %s, 0\n", []string{nrOccBool, nrOccVal})
    emitCondBranch(cg, nrOccBool, nrStore, nrBody)

    emitln(cg, str.Concat(nrBody, ":\n"))
    nrNext := nextReg(cg)
    emitfmt(cg, "  %s = add i32 %s, 1\n", []string{nrNext, nrVal})
    nrWrap := nextReg(cg)
    emitfmt(cg, "  %s = srem i32 %s, %s\n", []string{nrWrap, nrNext, capReg})
    emitfmt(cg, "  store i32 %s, i32* %s\n", []string{nrWrap, noResizeProbeAlloca})
    emitBranch(cg, nrCond)

    emitln(cg, str.Concat(nrStore, ":\n"))
    nrStoreVal := nextReg(cg)
    emitfmt(cg, "  %s = load i32, i32* %s\n", []string{nrStoreVal, noResizeProbeAlloca})
    nrKeyGep := nextReg(cg)
    emitfmt(cg, "  %s = getelementptr inbounds %s, %s* %s, i32 %s\n", []string{nrKeyGep, keyLL, keyLL, keysPtr, nrStoreVal})
    // Retain RC-managed keys. Block-local registers: these retains emit
    // instructions valid only in this block, so they must not overwrite
    // the shared keyReg/valReg used by sibling blocks.
    nrKeyReg := keyReg
    if isHeapLLType(keyLL) {
        nrKeyCast := nextReg(cg)
        emitfmt(cg, "  %s = bitcast %s %s to i8*\n", []string{nrKeyCast, keyLL, keyReg})
        emitfmt(cg, "  call i8* @Skink_rc_retain(i8* %s)\n", []string{nrKeyCast})
    }
    if isCompositeType(keyLL) && !str.EndsWith(keyLL, "*") {
        nrKeyReg = emitRetainStructHeapFields(cg, keyReg, keyLL)
    }
    emitStore(cg, keyLL, nrKeyReg, keyLL, nrKeyGep)
    nrValGep := nextReg(cg)
    emitfmt(cg, "  %s = getelementptr inbounds %s, %s* %s, i32 %s\n", []string{nrValGep, valLL, valLL, valsPtr, nrStoreVal})
    // Retain RC-managed values.
    nrValReg := valReg
    if isHeapLLType(valLL) {
        nrValCast := nextReg(cg)
        emitfmt(cg, "  %s = bitcast %s %s to i8*\n", []string{nrValCast, valLL, valReg})
        emitfmt(cg, "  call i8* @Skink_rc_retain(i8* %s)\n", []string{nrValCast})
    }
    if isCompositeType(valLL) && !str.EndsWith(valLL, "*") {
        nrValReg = emitRetainStructHeapFields(cg, valReg, valLL)
    }
    emitStore(cg, valLL, nrValReg, valLL, nrValGep)
    nrOccGep2 := nextReg(cg)
    emitfmt(cg, "  %s = getelementptr inbounds i8, i8* %s, i32 %s\n", []string{nrOccGep2, occPtr, nrStoreVal})
    emitfmt(cg, "  store i8 1, i8* %s\n", []string{nrOccGep2})
    // Increment count.
    nrCountField := nextReg(cg)
    emitfmt(cg, "  %s = getelementptr inbounds %s, %s* %s, i32 0, i32 4\n", []string{nrCountField, mapType, mapType, mapReg})
    emitfmt(cg, "  store i32 %s, i32* %s\n", []string{newCount, nrCountField})
    emitBranch(cg, endLabel)

    cg.terminated = false
    emitln(cg, str.Concat(endLabel, ":\n"))
}

// computeCompoundOp handles +=, -=, *=, /= operators.
fn computeCompoundOp(cg: *CodeGen, oldVal: string, valReg: string, op: string, llType: string, isUnsigned: bool) -> string {
    baseOp := str.Substr(op, 0, str.Len(op) - 1)
    if str.Equal(baseOp, "+") {
        if str.Equal(llType, "double") {
            return emitBinaryOp(cg, "fadd", llType, oldVal, valReg)
        }
        return emitBinaryOp(cg, "add", llType, oldVal, valReg)
    }
    if str.Equal(baseOp, "-") {
        if str.Equal(llType, "double") {
            return emitBinaryOp(cg, "fsub", llType, oldVal, valReg)
        }
        return emitBinaryOp(cg, "sub", llType, oldVal, valReg)
    }
    if str.Equal(baseOp, "*") {
        if str.Equal(llType, "double") {
            return emitBinaryOp(cg, "fmul", llType, oldVal, valReg)
        }
        return emitBinaryOp(cg, "mul", llType, oldVal, valReg)
    }
    if str.Equal(baseOp, "/") {
        if str.Equal(llType, "double") {
            return emitBinaryOp(cg, "fdiv", llType, oldVal, valReg)
        }
        if isUnsigned {
            return emitBinaryOp(cg, "udiv", llType, oldVal, valReg)
        }
        return emitBinaryOp(cg, "sdiv", llType, oldVal, valReg)
    }
    if str.Equal(baseOp, "%") {
        if isUnsigned {
            return emitBinaryOp(cg, "urem", llType, oldVal, valReg)
        }
        return emitBinaryOp(cg, "srem", llType, oldVal, valReg)
    }
    if str.Equal(baseOp, "&") {
        return emitBinaryOp(cg, "and", llType, oldVal, valReg)
    }
    if str.Equal(baseOp, "|") {
        return emitBinaryOp(cg, "or", llType, oldVal, valReg)
    }
    if str.Equal(baseOp, "^") {
        return emitBinaryOp(cg, "xor", llType, oldVal, valReg)
    }
    if str.Equal(baseOp, "<<") {
        return emitBinaryOp(cg, "shl", llType, oldVal, valReg)
    }
    if str.Equal(baseOp, ">>") {
        if isUnsigned {
            return emitBinaryOp(cg, "lshr", llType, oldVal, valReg)
        }
        return emitBinaryOp(cg, "ashr", llType, oldVal, valReg)
    }
    return valReg
}

// sanitizeLLTypeName converts an LLVM type string to a safe identifier component.
fn sanitizeLLTypeName(llType: string) -> string {
    s := llType
    s = str.Replace(s, "%", "")
    s = str.Replace(s, "*", "Ptr")
    s = str.Replace(s, ".", "_")
    s = str.Replace(s, " ", "")
    s = str.Replace(s, "{", "")
    s = str.Replace(s, "}", "")
    s = str.Replace(s, ",", "_")
    return s
}

// unsanitizeLLTypeName reverses sanitizeLLTypeName for common LLVM types.
// It handles the most common cases: i32, i64, i8*, double, i1, and struct/map types.
fn unsanitizeLLTypeName(s: string) -> string {
    // Handle common primitive types that don't need unsanitization.
    if str.Equal(s, "i32") || str.Equal(s, "i64") || str.Equal(s, "i16") ||
       str.Equal(s, "i8") || str.Equal(s, "double") || str.Equal(s, "i1") ||
       str.Equal(s, "float") {
        return s
    }
    // Handle struct/set types before the generic "Ptr" check:
    // "struct_foo" -> "%struct.foo", "struct_fooPtr" -> "%struct.foo*",
    // "set_i32" -> "%set.i32". Checking these prefixes first matters —
    // "struct_fooPtr" also ends with "Ptr".
    if str.StartsWith(s, "struct_") || str.StartsWith(s, "set_") {
        base := s
        suffix := ""
        if str.EndsWith(s, "Ptr") {
            base = str.Substr(s, 0, str.Len(s) - 3)
            suffix = "*"
        }
        if str.StartsWith(base, "struct_") {
            return str.Concat("%struct.", str.Concat(str.Substr(base, str.Len("struct_"), str.Len(base) - str.Len("struct_")), suffix))
        }
        return str.Concat("%set.", str.Concat(str.Substr(base, str.Len("set_"), str.Len(base) - str.Len("set_")), suffix))
    }
    // Handle map types
    if str.StartsWith(s, "map_") {
        return str.Concat("%", s)
    }
    // Handle pointer types: "i8Ptr" -> "i8*", "i32Ptr" -> "i32*", etc.
    if str.EndsWith(s, "Ptr") {
        base := str.Substr(s, 0, str.Len(s) - 3)
        return str.Concat(base, "*")
    }
    // Fallback: return as-is.
    return s
}

// sanitizeName converts a Skink name (possibly with dots) to an LLVM-safe identifier.
fn sanitizeName(name: string) -> string {
    return str.Replace(name, ".", "_")
}

// === Zero Values ===

// zeroValueForLLType returns the LLVM zero/neutral value for a type.
fn zeroValueForLLType(llType: string) -> string {
    if str.Equal(llType, "double") {
        return "0.0"
    }
    if str.Equal(llType, "float") {
        return "0.0"
    }
    if str.Equal(llType, "i1") {
        return "false"
    }
    if str.Equal(llType, "void") {
        return ""
    }
    if str.StartsWith(llType, "[") {
        return "zeroinitializer"
    }
    if str.EndsWith(llType, "*") {
        return "null"
    }
    if str.StartsWith(llType, "%struct.") || str.StartsWith(llType, "%map_") || str.StartsWith(llType, "%set.") {
        return "zeroinitializer"
    }
    if str.StartsWith(llType, "{") {
        return "zeroinitializer"
    }
    if str.StartsWith(llType, "%") && !str.EndsWith(llType, "*") {
        return "zeroinitializer"
    }
    if str.Equal(llType, "%struct.errors_Error") {
        return "zeroinitializer"
    }
    return "0"
}

// defaultValue returns the LLVM zero value for a checker type.
fn defaultValue(cg: *CodeGen, t: checker.TType) -> string {
    ll := llvmType(cg, t)
    return zeroValueForLLType(ll)
}

// === Map Key Existence Helpers ===
// (Skink doesn't support comma-ok map access)

// mapStringDeclHasKeyTU reports whether a Decl map contains the key.
fn mapStringDeclHasKeyTU(m: map[string]ast.Decl, key: string) -> bool {
    v := m[key]
    return str.Len(v.structName) > 0 || str.Len(v.fnName) > 0 || str.Len(v.enumName) > 0 || str.Len(v.templateName) > 0
}

// mapStringStructLayoutHasKey reports whether a StructLayout map contains the key.
fn mapStringStructLayoutHasKey(m: map[string]StructLayout, key: string) -> bool {
    v := m[key]
    return str.Len(v.llType) > 0
}

// mapStringScopeVarHasKey reports whether a ScopeVar map contains the key.
fn mapStringScopeVarHasKey(m: map[string]ScopeVar, key: string) -> bool {
    v := m[key]
    return str.Len(v.llType) > 0
}

// mapStringStringSliceHasKeyCG reports whether a string-slice map contains the key.
fn mapStringStringSliceHasKeyCG(m: map[string][]string, key: string) -> bool {
    v := m[key]
    return len(v) > 0
}

// resolveDirectFnName resolves a function name to its fully qualified name.
fn resolveDirectFnName(cg: *CodeGen, name: string) -> string {
    // Prefer the current module's own qualified declaration: private
    // functions of the module being emitted must shadow unqualified
    // (main-module or foreign) functions of the same name, otherwise a
    // user function like `report` would hijack calls to `checker.report`.
    if str.Len(cg.currentModule) > 0 && str.IndexOf(name, ".") < 0 {
        qualified := str.Concat(cg.currentModule, str.Concat(".", name))
        if mapStringStringSliceHasKeyCG(cg.fnRetTypes, qualified) {
            return qualified
        }
    }
    if mapStringStringSliceHasKeyCG(cg.fnRetTypes, name) {
        return name
    }
    // Search imported modules for the function (e.g. Errorf -> testing.Errorf)
    if str.Len(cg.currentModule) > 0 {
        imps := checker.importsFor(cg.checker, cg.currentModule)
        j := 0
        for j < len(imps) {
            alias := imps[j]
            resolvedModule := resolveImportAliasCG(cg, alias)
            qualified := str.Concat(resolvedModule, str.Concat(".", name))
            if mapStringStringSliceHasKeyCG(cg.fnRetTypes, qualified) {
                return qualified
            }
            // Also try with the alias itself
            aliasQualified := str.Concat(alias, str.Concat(".", name))
            if mapStringStringSliceHasKeyCG(cg.fnRetTypes, aliasQualified) {
                return aliasQualified
            }
            j = j + 1
        }
    }
    return name
}

// setModuleContextFromName sets the emitter and checker module context
// from a resolver-qualified top-level name ("mod.name" -> "mod"), so
// unqualified identifiers inside module-level var initializers resolve
// the same way they did during checking. Unqualified names belong to
// the main module.
fn setModuleContextFromName(cg: *CodeGen, name: string) {
    dotIdx := str.LastIndexOf(name, ".")
    if dotIdx > 0 {
        cg.currentModule = str.Substr(name, 0, dotIdx)
    } else {
        cg.currentModule = "main"
    }
    cg.checker.currentModule = cg.currentModule
}

// emitConstExpr emits a const's stored initializer under the module that
// owns it, so unqualified identifiers inside the initializer (same-module
// consts, private fns, struct types) resolve the same way they did during
// checking — regardless of which module referenced the const. key is the
// resolver-qualified name under which the const was found.
fn emitConstExpr(cg: *CodeGen, key: string) -> string {
    savedCgMod := cg.currentModule
    savedCheckerMod := cg.checker.currentModule
    savedFile := cg.currentFilePath
    setModuleContextFromName(cg, key)
    if str.Len(cg.constFiles[key]) > 0 {
        cg.currentFilePath = cg.constFiles[key]
    }
    reg := emitExpression(cg, cg.consts[key])
    cg.currentFilePath = savedFile
    cg.currentModule = savedCgMod
    cg.checker.currentModule = savedCheckerMod
    return reg
}

// constExprLLType is the exprLLType analogue of emitConstExpr.
fn constExprLLType(cg: *CodeGen, key: string) -> string {
    savedCgMod := cg.currentModule
    savedCheckerMod := cg.checker.currentModule
    savedFile := cg.currentFilePath
    setModuleContextFromName(cg, key)
    if str.Len(cg.constFiles[key]) > 0 {
        cg.currentFilePath = cg.constFiles[key]
    }
    t := exprLLType(cg, cg.consts[key])
    cg.currentFilePath = savedFile
    cg.currentModule = savedCgMod
    cg.checker.currentModule = savedCheckerMod
    return t
}

// mapStringBoolHasKeyCG reports whether a bool map contains the key.
fn mapStringBoolHasKeyCG(m: map[string]bool, key: string) -> bool {
    v := m[key]
    return v
}

// mapStringStringHasKeyCG reports whether a string map contains the key.
fn mapStringStringHasKeyCG(m: map[string]string, key: string) -> bool {
    v := m[key]
    return str.Len(v) > 0
}

// mapStringTTypeHasKeyCG reports whether a TType map contains the key.
fn mapStringTTypeHasKeyCG(m: map[string]checker.TType, key: string) -> bool {
    v := m[key]
    return v.kind != 0
}

// mapStringExprHasKey reports whether an Expr map contains the key.
fn mapStringExprHasKey(m: map[string]ast.Expr, key: string) -> bool {
    v := m[key]
    return v.kind != 0
}

// mapStringArrayMetaHasKey reports whether an ArrayMeta map contains the key.
fn mapStringArrayMetaHasKey(m: map[string]ArrayMeta, key: string) -> bool {
    v := m[key]
    return str.Len(v.elemType) > 0
}

// mapStringStructLayoutHasKeyCG reports whether a StructLayout map contains the key.
fn mapStringStructLayoutHasKeyCG(m: map[string]StructLayout, key: string) -> bool {
    v := m[key]
    return str.Len(v.llType) > 0
}

// === Struct Layout Computation ===

// alignUp rounds an offset up to the nearest multiple of alignment.
fn alignUp(offset: int, alignment: int) -> int {
    if alignment == 0 {
        return offset
    }
    return ((offset + alignment - 1) / alignment) * alignment
}

// typeSizeAndAlign computes the byte size and alignment for a checker type.
fn typeSizeAndAlign(cg: *CodeGen, t: checker.TType) -> (int, int) {
    if t.kind == checker.TK_BUILTIN {
        return builtinSizeAndAlign(t.name)
    }
    if t.kind == checker.TK_POINTER || t.kind == checker.TK_ARRAY || t.kind == checker.TK_SET || t.kind == checker.TK_CHAN || t.kind == checker.TK_TENSOR {
        return 8, 8
    }
    if t.kind == checker.TK_MAP {
        return 8, 8
    }
    if t.kind == checker.TK_FUNCTION {
        return 8, 8
    }
    if t.kind == checker.TK_NIL || t.kind == checker.TK_ANY || t.kind == checker.TK_UNKNOWN {
        return 8, 8
    }
    if t.kind == checker.TK_ERROR {
        return 16, 8
    }
    if t.kind == checker.TK_NAMED {
        // Check tagged union
        hasTU := mapStringDeclHasKeyTU(cg.taggedUnions, t.name)
        if hasTU {
            return 8, 8
        }
        // Check struct layout
        layout := cg.structLayouts[t.name]
        hasLayout := str.Len(layout.llType) > 0
        if hasLayout {
            return layout.size, layout.alignment
        }
        // Module-qualified types
        return 8, 8
    }
    if t.kind == checker.TK_TAGGED_UNION {
        return 8, 8
    }
    if t.kind == checker.TK_TUPLE {
        size := 0
        align := 1
        i := 0
        for i < len(t.tupleTypes) {
            es, ea := typeSizeAndAlign(cg, t.tupleTypes[i])
            size = alignUp(size, ea)
            size = size + es
            if ea > align {
                align = ea
            }
            i = i + 1
        }
        size = alignUp(size, align)
        return size, align
    }
    return 8, 8
}

// builtinSizeAndAlign returns the byte size and alignment for a builtin type.
fn builtinSizeAndAlign(name: string) -> (int, int) {
    if str.Equal(name, "int") || str.Equal(name, "int32") || str.Equal(name, "uint") || str.Equal(name, "uint32") {
        return 4, 4
    }
    if str.Equal(name, "int8") || str.Equal(name, "uint8") || str.Equal(name, "byte") {
        return 1, 1
    }
    if str.Equal(name, "int16") || str.Equal(name, "uint16") {
        return 2, 2
    }
    if str.Equal(name, "int64") || str.Equal(name, "uint64") {
        return 8, 8
    }
    if str.Equal(name, "float") {
        return 8, 8
    }
    if str.Equal(name, "bool") {
        return 1, 1
    }
    if str.Equal(name, "string") || str.Equal(name, "bytes") {
        return 8, 8
    }
    if str.Equal(name, "void") {
        return 0, 1
    }
    return 8, 8
}

// computeStructLayout computes field offsets, types, and size for a struct.
fn computeStructLayout(cg: *CodeGen, name: string, d: ast.Decl) -> StructLayout {
    layout := StructLayout{}
    layout.llType = str.Concat("%struct.", sanitizeName(name))
    layout.fields = []string{}
    layout.fieldTypes = []string{}
    layout.fieldSkinkTypes = []string{}
    layout.fieldTags = []string{}
    layout.isUnsigned = []bool{}
    layout.offsets = []int{}

    offset := 0
    maxAlign := 1

    i := 0
    for i < len(d.structFields) {
        field := d.structFields[i]
        ft := checker.unknownType()
        fLL := "i32"
        fSkinkType := ""
        if len(field.typ) > 0 {
            // Set the checker's currentModule to the struct's module so
            // that unqualified type names in field declarations resolve
            // correctly (e.g., "Type" in struct "ast.Type" → "ast.Type").
            savedModule := cg.checker.currentModule
            savedCgModule := cg.currentModule
            markBorrowed(cg, "savedModule")
            markBorrowed(cg, "savedCgModule")
            dotIdx := str.IndexOf(name, ".")
            if dotIdx > 0 {
                cg.checker.currentModule = str.Substr(name, 0, dotIdx)
                cg.currentModule = str.Substr(name, 0, dotIdx)
            }
            ft = checker.astTypeToType(cg.checker, field.typ[0])
            fLL = llvmType(cg, ft)
            fSkinkType = skinkTypeName(cg, ft, fLL)
            cg.checker.currentModule = savedModule
            cg.currentModule = savedCgModule
        } else {
            fLL = llvmType(cg, ft)
            fSkinkType = skinkTypeName(cg, ft, fLL)
        }
        fSize, fAlign := typeSizeAndAlign(cg, ft)

        offset = alignUp(offset, fAlign)
        layout.fields = append(layout.fields, field.name)
        layout.fieldTypes = append(layout.fieldTypes, fLL)
        layout.fieldSkinkTypes = append(layout.fieldSkinkTypes, fSkinkType)
        layout.fieldTags = append(layout.fieldTags, str.Join(field.tags, " "))
        layout.isUnsigned = append(layout.isUnsigned, false)
        layout.offsets = append(layout.offsets, offset)
        offset = offset + fSize
        if fAlign > maxAlign {
            maxAlign = fAlign
        }
        i = i + 1
    }

    layout.size = alignUp(offset, maxAlign)
    layout.alignment = maxAlign

    dtorFn := ""
    j := 0
    for j < len(d.structMethods) {
        m := d.structMethods[j]
        if str.Equal(m.fnName, "Drop") {
            dtorFn = str.Concat(name, str.Concat(".", m.fnName))
            break
        }
        // Note: Free and Close are NOT used as automatic destructors.
        // They are explicit cleanup methods called by the user. Using them
        // as automatic dtors causes use-after-free when structs are returned
        // by value, because the dtor runs on the temporary and frees resources
        // that are still referenced by the returned copy.
        j = j + 1
    }
    layout.dtorFn = dtorFn

    return layout
}

// llTypeSizeBits returns the size in bits of an LLVM IR type string.
// Used for DWARF debug member metadata (size is in bits).
fn llTypeSizeBits(llType: string) -> int {
    if str.Equal(llType, "i1") { return 1 }
    if str.Equal(llType, "i8") { return 8 }
    if str.Equal(llType, "i16") { return 16 }
    if str.Equal(llType, "i32") { return 32 }
    if str.Equal(llType, "i64") { return 64 }
    if str.Equal(llType, "double") { return 64 }
    if str.Equal(llType, "float") { return 32 }
    // Pointers, structs, and opaque types default to 64 bits (pointer-sized)
    if str.EndsWith(llType, "*") { return 64 }
    return 64
}

// === Element Size Emission ===

// emitElemSize emits code to compute the byte size of an LLVM element type.
fn emitElemSize(cg: *CodeGen, elemType: string) -> string {
    if str.Equal(elemType, "i1") || str.Equal(elemType, "i8") {
        return "1"
    }
    if str.Equal(elemType, "i16") {
        return "2"
    }
    if str.Equal(elemType, "i32") {
        return "4"
    }
    if str.Equal(elemType, "i64") || str.Equal(elemType, "double") {
        return "8"
    }
    if str.Equal(elemType, "i8*") {
        return "8"
    }
    if str.StartsWith(elemType, "%struct.") || str.StartsWith(elemType, "%") {
        // Use getelementptr to compute size at runtime
        sizePtr := nextReg(cg)
        emitfmt(cg, "  %s = getelementptr %s, %s* null, i32 1\n", []string{sizePtr, elemType, elemType})
        r := nextReg(cg)
        emitfmt(cg, "  %s = ptrtoint %s* %s to i32\n", []string{r, elemType, sizePtr})
        return r
    }
    return "8"
}

// === String Literal Emission ===

// escapeLLVMString escapes special characters in a string for LLVM IR.
fn escapeLLVMString(s: string) -> string {
    // For now, just handle basic escape sequences
    // Full escaping would handle all C escape sequences
    result := s
    result = str.Replace(result, "\\", "\\\\")
    result = str.Replace(result, "\n", "\\0A")
    result = str.Replace(result, "\t", "\\09")
    result = str.Replace(result, "\r", "\\0D")
    result = str.Replace(result, "\"", "\\22")
    return result
}

// emitStringLiteral emits a string literal as a global and returns its pointer.
fn emitStringLiteral(cg: *CodeGen, value: string) -> string {
    // Each literal site gets its own global storage (no interning):
    // Skink allows byte stores into strings (s[0] = 72), so literals
    // must be writable and must not be shared — mutating "hello" at
    // one site must not corrupt a "hello" used elsewhere.
    globalName := nextStrGlobal(cg)
    escaped := escapeLLVMString(value)
    length := str.Len(value) + 1  // +1 for null terminator
    parts := []string{}
    parts = append(parts, globalName)
    parts = append(parts, " = private global [")
    parts = append(parts, strconv.Itoa(length))
    parts = append(parts, " x i8] c\"")
    parts = append(parts, escaped)
    parts = append(parts, "\\00\"\n")
    emitStringGlobal(cg, concatMany(parts))
    r := nextReg(cg)
    emitfmt(cg, "  %s = getelementptr inbounds [%s x i8], [%s x i8]* %s, i64 0, i64 0\n", []string{r, strconv.Itoa(length), strconv.Itoa(length), globalName})
    return r
}

// === Resolve Import Alias ===

// resolveImportAliasCG resolves an import alias to its real module name.
fn resolveImportAliasCG(cg: *CodeGen, name: string) -> string {
    real := cg.importAliases[name]
    ok := mapStringStringHasKeyCG(cg.importAliases, name)
    if ok {
        return real
    }
    return name
}

// === Type Alias Resolution ===

// resolveAliasCG resolves a type alias to its underlying checker type.
fn resolveAliasCG(cg: *CodeGen, t: checker.TType) -> checker.TType {
    if t.kind != checker.TK_NAMED {
        return t
    }
    // Check if this is a known alias
    underlying := cg.aliases[t.name]
    ok := mapStringTTypeHasKeyCG(cg.aliases, t.name)
    if ok {
        return resolveAliasCG(cg, underlying)
    }
    // Also check checker's aliases
    return checker.resolveAlias(cg.checker, t)
}

// === Expression Emission ===

// concatMany concatenates a slice of strings into one.
fn concatMany(parts: []string) -> string {
    result := ""
    i := 0
    for i < len(parts) {
        result = str.Concat(result, parts[i])
        i = i + 1
    }
    return result
}

// emitfmt formats a template string with %s placeholders and emits it.
// Optimization: uses str.Builder to avoid per-character allocations.
// The previous implementation created a []string of single-character
// substrings then concatenated them with str.Concat, causing ~48 allocations
// per call. The Builder approach writes directly to a growable buffer.
fn emitfmt(cg: *CodeGen, tmpl: string, args: []string) {
    b := str.NewBuilder(str.Len(tmpl) + 32)
    argIdx := 0
    i := 0
    n := str.Len(tmpl)
    for i < n {
        if i + 1 < n {
            // Check for %s placeholder by comparing bytes directly
            // (avoids allocating a 2-char substring).
            if int(tmpl[i]) == 37 && int(tmpl[i + 1]) == 115 {
                if argIdx < len(args) {
                    str.Write(&b, args[argIdx])
                    argIdx = argIdx + 1
                }
                i = i + 2
                continue
            }
        }
        str.WriteByte(&b, int(tmpl[i]))
        i = i + 1
    }
    emitln(cg, str.String(b))
    str.Free(&b)
}

// fmtStr is like emitfmt but returns the formatted string instead of emitting.
// Optimization: uses str.Builder to avoid per-character allocations.
fn fmtStr(tmpl: string, args: []string) -> string {
    b := str.NewBuilder(str.Len(tmpl) + 32)
    argIdx := 0
    i := 0
    n := str.Len(tmpl)
    for i < n {
        if i + 1 < n {
            if int(tmpl[i]) == 37 && int(tmpl[i + 1]) == 115 {
                if argIdx < len(args) {
                    str.Write(&b, args[argIdx])
                    argIdx = argIdx + 1
                }
                i = i + 2
                continue
            }
        }
        str.WriteByte(&b, int(tmpl[i]))
        i = i + 1
    }
    result := str.String(b)
    str.Free(&b)
    return result
}

// emitGEP emits a getelementptr instruction and returns the result register.
fn emitGEP(cg: *CodeGen, baseType: string, ptrType: string, ptrReg: string, indices: []string) -> string {
    r := nextReg(cg)
    // Ensure ptrType has * suffix for valid LLVM syntax
    actualPtrType := ptrType
    if !str.EndsWith(ptrType, "*") {
        actualPtrType = str.Concat(ptrType, "*")
    }
    // Ensure each index has an i32 type prefix
    typedIndices := []string{}
    i := 0
    for i < len(indices) {
        idx := indices[i]
        if str.StartsWith(idx, "i32 ") || str.StartsWith(idx, "i64 ") {
            typedIndices = append(typedIndices, idx)
        } else {
            typedIndices = append(typedIndices, str.Concat("i32 ", idx))
        }
        i = i + 1
    }
    idxStr := str.Join(typedIndices, ", ")
    parts := []string{}
    parts = append(parts, "  ")
    parts = append(parts, r)
    parts = append(parts, " = getelementptr inbounds ")
    parts = append(parts, baseType)
    parts = append(parts, ", ")
    parts = append(parts, actualPtrType)
    parts = append(parts, " ")
    parts = append(parts, ptrReg)
    parts = append(parts, ", ")
    parts = append(parts, idxStr)
    emitln(cg, concatMany(parts))
    return r
}

// emitLoad emits a load instruction and returns the result register.
fn emitLoad(cg: *CodeGen, llType: string, ptrType: string, ptrReg: string) -> string {
    r := nextReg(cg)
    parts := []string{}
    parts = append(parts, "  ")
    parts = append(parts, r)
    parts = append(parts, " = load ")
    parts = append(parts, llType)
    parts = append(parts, ", ")
    parts = append(parts, ptrType)
    parts = append(parts, "* ")
    parts = append(parts, ptrReg)
    emitln(cg, concatMany(parts))
    return r
}

// emitStore emits a store instruction.
fn emitStore(cg: *CodeGen, llType: string, valReg: string, ptrType: string, ptrReg: string) {
    // Convert a bare "0" literal to the correct zero value for the type,
    // so that pointer types emit "null" instead of the invalid "i8* 0".
    effVal := valReg
    if str.Equal(valReg, "0") {
        zv := zeroValueForLLType(llType)
        if !str.Equal(zv, "") {
            effVal = zv
        }
    }
    parts := []string{}
    parts = append(parts, "  store ")
    parts = append(parts, llType)
    parts = append(parts, " ")
    parts = append(parts, effVal)
    parts = append(parts, ", ")
    parts = append(parts, ptrType)
    parts = append(parts, "* ")
    parts = append(parts, ptrReg)
    emitln(cg, concatMany(parts))
}

// emitAlloca emits an alloca instruction and returns the result register.
fn emitAlloca(cg: *CodeGen, llType: string) -> string {
    r := nextReg(cg)
    parts := []string{}
    parts = append(parts, "  ")
    parts = append(parts, r)
    parts = append(parts, " = alloca ")
    parts = append(parts, llType)
    line := concatMany(parts)
    // Write to alloca buffer instead of inline, so all allocas end up
    // in the entry block and dominate all their uses.
    cg.allocaBuffer.Write(line)
    cg.allocaBuffer.WriteByte(10)
    // Zero-initialize the alloca immediately in the entry block.
    // This prevents use-of-uninitialized-memory bugs when a variable
    // is declared inside a conditional block (e.g. a for-loop body that
    // never executes) but its scope-exit release code runs
    // unconditionally after the block's end label.  Without this,
    // Skink_rc_release would be called on garbage stack bytes, causing
    // heap corruption and segfaults.
    zeroVal := zeroValueForLLType(llType)
    if !str.Equal(zeroVal, "") {
        zparts := []string{}
        zparts = append(zparts, "  store ")
        zparts = append(zparts, llType)
        zparts = append(zparts, " ")
        zparts = append(zparts, zeroVal)
        zparts = append(zparts, ", ")
        zparts = append(zparts, llType)
        zparts = append(zparts, "* ")
        zparts = append(zparts, r)
        zline := concatMany(zparts)
        cg.allocaBuffer.Write(zline)
        cg.allocaBuffer.WriteByte(10)
    }
    return r
}

// emitSExtI32ToI64 sign-extends an i32 value to i64.
fn emitSExtI32ToI64(cg: *CodeGen, val: string) -> string {
    r := nextReg(cg)
    emitfmt(cg, "  %s = sext i32 %s to i64\n", []string{r, val})
    return r
}

// emitBinaryOp emits a binary operation and returns the result register.
// emitDivZeroGuard emits a zero-divisor check before sdiv/udiv/srem/urem:
// a bare LLVM div by zero is a hardware trap (SIGFPE) that kills the
// process, so the guard routes to Skink_panic making the error
// recoverable via recover() (comp_error.md #74).
fn emitDivZeroGuard(cg: *CodeGen, llType: string, right: string) {
    cmp := nextReg(cg)
    emitfmt(cg, "  %s = icmp eq %s %s, 0\n", []string{cmp, llType, right})
    panicL := nextLabel(cg)
    okL := nextLabel(cg)
    emitCondBranch(cg, cmp, panicL, okL)
    emitLabel(cg, panicL)
    msg := emitStringLiteral(cg, "integer divide by zero")
    emitfmt(cg, "  call void @Skink_panic(i8* %s)\n", []string{msg})
    emitln(cg, "  unreachable")
    emitLabel(cg, okL)
}

// emitGuardedShift emits a shift with a range-checked count: LLVM
// considers a shift by >= the bit width poison (UB), so the count is
// checked first. A negative count panics (Go semantics); a count >= the
// operand width yields 0 via select (comp_error.md #75). The negative
// check uses a signed compare, which also treats an unsigned count >=
// 2^(w-1) as negative — stricter than Go (which would yield 0) but
// safer than silently shifting.
fn emitGuardedShift(cg: *CodeGen, op: string, llType: string, left: string, right: string) -> string {
    width := "32"
    if str.Equal(llType, "i8") {
        width = "8"
    } else if str.Equal(llType, "i16") {
        width = "16"
    } else if str.Equal(llType, "i64") {
        width = "64"
    }
    negCmp := nextReg(cg)
    emitfmt(cg, "  %s = icmp slt %s %s, 0\n", []string{negCmp, llType, right})
    negL := nextLabel(cg)
    posL := nextLabel(cg)
    emitCondBranch(cg, negCmp, negL, posL)
    emitLabel(cg, negL)
    negMsg := emitStringLiteral(cg, "negative shift amount")
    emitfmt(cg, "  call void @Skink_panic(i8* %s)\n", []string{negMsg})
    emitln(cg, "  unreachable")
    emitLabel(cg, posL)
    bigCmp := nextReg(cg)
    emitfmt(cg, "  %s = icmp uge %s %s, %s\n", []string{bigCmp, llType, right, width})
    // Clamp the count so the shift itself is never poison, then select
    // the result: 0 when the count was oversized, else the real shift.
    safeCnt := nextReg(cg)
    parts := []string{}
    parts = append(parts, "  ")
    parts = append(parts, safeCnt)
    parts = append(parts, " = select i1 ")
    parts = append(parts, bigCmp)
    parts = append(parts, ", ")
    parts = append(parts, llType)
    parts = append(parts, " 0, ")
    parts = append(parts, llType)
    parts = append(parts, " ")
    parts = append(parts, right)
    emitln(cg, concatMany(parts))
    shifted := nextReg(cg)
    parts2 := []string{}
    parts2 = append(parts2, "  ")
    parts2 = append(parts2, shifted)
    parts2 = append(parts2, " = ")
    parts2 = append(parts2, op)
    parts2 = append(parts2, " ")
    parts2 = append(parts2, llType)
    parts2 = append(parts2, " ")
    parts2 = append(parts2, left)
    parts2 = append(parts2, ", ")
    parts2 = append(parts2, safeCnt)
    emitln(cg, concatMany(parts2))
    res := nextReg(cg)
    emitfmt(cg, "  %s = select i1 %s, %s 0, %s %s\n", []string{res, bigCmp, llType, llType, shifted})
    return res
}

fn emitBinaryOp(cg: *CodeGen, op: string, llType: string, left: string, right: string) -> string {
    isDiv := str.Equal(op, "sdiv") || str.Equal(op, "udiv") || str.Equal(op, "srem") || str.Equal(op, "urem")
    if isDiv && !str.Equal(llType, "double") && !str.Equal(llType, "float") {
        emitDivZeroGuard(cg, llType, right)
    }
    if str.Equal(op, "shl") || str.Equal(op, "lshr") || str.Equal(op, "ashr") {
        return emitGuardedShift(cg, op, llType, left, right)
    }
    r := nextReg(cg)
    parts := []string{}
    parts = append(parts, "  ")
    parts = append(parts, r)
    parts = append(parts, " = ")
    parts = append(parts, op)
    parts = append(parts, " ")
    parts = append(parts, llType)
    parts = append(parts, " ")
    parts = append(parts, left)
    parts = append(parts, ", ")
    parts = append(parts, right)
    emitln(cg, concatMany(parts))
    return r
}

// emitShortCircuitAnd emits LLVM IR for `left && right` with short-circuit
// evaluation: if `left` is false, `right` is not evaluated and the result is
// false. This prevents null dereferences in expressions like
// `len(arr) > 0 && arr[0].kind == X`.
//
// A rightEnd label is used after evaluating the right operand so that nested
// short-circuit expressions (which create their own blocks) have a correct
// predecessor in the phi node.
fn emitShortCircuitAnd(cg: *CodeGen, e: ast.Expr) -> string {
    left := emitExpression(cg, e.infixLeft[0])
    evalRightLabel := nextLabel(cg)
    shortFalseLabel := nextLabel(cg)
    rightEndLabel := nextLabel(cg)
    mergeLabel := nextLabel(cg)
    emitCondBranch(cg, left, evalRightLabel, shortFalseLabel)
    emitLabel(cg, evalRightLabel)
    right := emitExpression(cg, e.infixRight[0])
    emitBranch(cg, rightEndLabel)
    emitLabel(cg, rightEndLabel)
    emitBranch(cg, mergeLabel)
    emitLabel(cg, shortFalseLabel)
    emitBranch(cg, mergeLabel)
    emitLabel(cg, mergeLabel)
    resultReg := nextReg(cg)
    parts := []string{}
    parts = append(parts, "  ")
    parts = append(parts, resultReg)
    parts = append(parts, " = phi i1 [false, %")
    parts = append(parts, shortFalseLabel)
    parts = append(parts, "], [")
    parts = append(parts, right)
    parts = append(parts, ", %")
    parts = append(parts, rightEndLabel)
    parts = append(parts, "]")
    emitln(cg, concatMany(parts))
    return resultReg
}

// emitShortCircuitOr emits LLVM IR for `left || right` with short-circuit
// evaluation: if `left` is true, `right` is not evaluated and the result is
// true.
//
// A rightEnd label is used after evaluating the right operand so that nested
// short-circuit expressions (which create their own blocks) have a correct
// predecessor in the phi node.
fn emitShortCircuitOr(cg: *CodeGen, e: ast.Expr) -> string {
    left := emitExpression(cg, e.infixLeft[0])
    shortTrueLabel := nextLabel(cg)
    evalRightLabel := nextLabel(cg)
    rightEndLabel := nextLabel(cg)
    mergeLabel := nextLabel(cg)
    emitCondBranch(cg, left, shortTrueLabel, evalRightLabel)
    emitLabel(cg, shortTrueLabel)
    emitBranch(cg, mergeLabel)
    emitLabel(cg, evalRightLabel)
    right := emitExpression(cg, e.infixRight[0])
    emitBranch(cg, rightEndLabel)
    emitLabel(cg, rightEndLabel)
    emitBranch(cg, mergeLabel)
    emitLabel(cg, mergeLabel)
    resultReg := nextReg(cg)
    parts := []string{}
    parts = append(parts, "  ")
    parts = append(parts, resultReg)
    parts = append(parts, " = phi i1 [true, %")
    parts = append(parts, shortTrueLabel)
    parts = append(parts, "], [")
    parts = append(parts, right)
    parts = append(parts, ", %")
    parts = append(parts, rightEndLabel)
    parts = append(parts, "]")
    emitln(cg, concatMany(parts))
    return resultReg
}

// coerceArgToParamType adjusts an argument register to match a function's
// declared parameter type. Handles: template fat-pointer coercion
// (concrete struct → template interface), struct pointer → by-value load
// (e.g. indexing a slice of structs passed to a by-value param),
// pointer ↔ integer conversions, integer → float (sitofp), and integer
// width narrowing/widening. Integer widening uses sext unconditionally —
// callers that have the source expression should prefer
// coerceExprToParamType, which zero-extends unsigned operand types.
fn coerceArgToParamType(cg: *CodeGen, argReg: string, argType: string, paramType: string) -> string {
    // Template coercion: concrete struct pointer → template fat pointer
    if str.StartsWith(paramType, "%template.") && str.StartsWith(argType, "%struct.") {
        return coerceToTemplate(cg, argReg, argType, paramType)
    }
    // Passing an existing template fat pointer to a template parameter — no coercion needed
    if str.StartsWith(paramType, "%template.") && str.StartsWith(argType, "%template.") {
        return argReg
    }
    // nil (i8*) → template fat pointer (null)
    if str.StartsWith(paramType, "%template.") && str.Equal(argType, "i8*") {
        return argReg
    }
    // Generic type erasure: integer/bool → i8* via inttoptr.
    // This allows passing concrete values to functions with generic type
    // params that are erased to i8* in the LLVM IR.
    if str.Equal(paramType, "i8*") && !str.Equal(argType, "i8*") && !str.EndsWith(argType, "*") {
        if str.StartsWith(argType, "i") {
            reg := nextReg(cg)
            emitfmt(cg, "  %s = inttoptr %s %s to i8*\n", []string{reg, argType, argReg})
            return reg
        }
    }
    // Bitcast any pointer type (including function pointers) to i8*.
    // This allows passing struct pointers and function pointers to extern
    // functions that accept void* (e.g. threading helpers).
    if str.Equal(paramType, "i8*") && str.EndsWith(argType, "*") && !str.Equal(argType, "i8*") {
        reg := nextReg(cg)
        emitfmt(cg, "  %s = bitcast %s %s to i8*\n", []string{reg, argType, argReg})
        return reg
    }
    // Reverse of generic erasure: values read back out of a generic
    // container (HashMap, Stack, ...) are i8* but the checker knows the
    // concrete element type. Convert back with ptrtoint.
    if (str.Equal(paramType, "i32") || str.Equal(paramType, "i64")) && str.EndsWith(argType, "*") {
        reg := nextReg(cg)
        emitfmt(cg, "  %s = ptrtoint %s %s to %s\n", []string{reg, argType, argReg, paramType})
        return reg
    }
    if str.StartsWith(paramType, "%struct.") && !str.EndsWith(paramType, "*") &&
        str.Equal(argType, str.Concat(paramType, "*")) {
        return emitLoad(cg, paramType, paramType, argReg)
    }
    // Reverse case: a pointer is expected (e.g. an array element slot that
    // stores struct pointers) but we have the struct by value — spill it
    // to a fresh stack slot and hand out the pointer.
    if str.EndsWith(paramType, "*") &&
        str.Equal(str.Substr(paramType, 0, str.Len(paramType) - 1), argType) {
        tmp := emitAlloca(cg, argType)
        emitStore(cg, argType, argReg, argType, tmp)
        return tmp
    }
    // Integer narrowing/widening: truncate or extend integer types to match.
    // e.g. i32 → i8 (trunc), i8 → i32 (sext for signed, zext for unsigned)
    if str.StartsWith(argType, "i") && str.StartsWith(paramType, "i") &&
        !str.Equal(argType, paramType) &&
        !str.EndsWith(argType, "*") && !str.EndsWith(paramType, "*") {
        argBits := parseIntBits(argType)
        paramBits := parseIntBits(paramType)
        if argBits > 0 && paramBits > 0 && argBits != paramBits {
            if argBits > paramBits {
                // Narrowing: truncate
                reg := nextReg(cg)
                emitfmt(cg, "  %s = trunc %s %s to %s\n", []string{reg, argType, argReg, paramType})
                return reg
            }
            // Widening: sign-extend (Skink ints are signed)
            reg := nextReg(cg)
            emitfmt(cg, "  %s = sext %s %s to %s\n", []string{reg, argType, argReg, paramType})
            return reg
        }
    }
    // Integer → float coercion (e.g. math.Sqrt(16) passes an i32).
    if str.Equal(paramType, "double") && str.StartsWith(argType, "i") && !str.EndsWith(argType, "*") {
        reg := nextReg(cg)
        emitfmt(cg, "  %s = sitofp %s %s to double\n", []string{reg, argType, argReg})
        return reg
    }
    return argReg
}

// coerceExprToParamType is coerceArgToParamType with the source
// expression available, so integer widening picks zext for unsigned
// operand types (uint8/16/32/64, byte, bool) instead of sext. LLVM
// integer types carry no signedness, so this consults the checker's
// recorded type for the expression.
fn coerceExprToParamType(cg: *CodeGen, argReg: string, argType: string, paramType: string, e: ast.Expr) -> string {
    // nil for a by-value struct type (e.g. error) means the zero value —
    // the pointer form would otherwise emit `load %struct.X* null`.
    if e.kind == ast.EX_NIL && str.StartsWith(paramType, "%struct.") && !str.EndsWith(paramType, "*") {
        tmp := emitAlloca(cg, paramType)
        emitfmt(cg, "  store %s zeroinitializer, %s* %s\n", []string{paramType, paramType, tmp})
        return emitLoad(cg, paramType, paramType, tmp)
    }
    if str.StartsWith(argType, "i") && str.StartsWith(paramType, "i") &&
        !str.Equal(argType, paramType) &&
        !str.EndsWith(argType, "*") && !str.EndsWith(paramType, "*") {
        argBits := parseIntBits(argType)
        paramBits := parseIntBits(paramType)
        if argBits > 0 && paramBits > 0 && argBits != paramBits {
            if argBits > paramBits {
                reg := nextReg(cg)
                emitfmt(cg, "  %s = trunc %s %s to %s\n", []string{reg, argType, argReg, paramType})
                return reg
            }
            reg := nextReg(cg)
            if argBits == 1 || exprIsUnsignedInt(cg, e) {
                emitfmt(cg, "  %s = zext %s %s to %s\n", []string{reg, argType, argReg, paramType})
            } else {
                emitfmt(cg, "  %s = sext %s %s to %s\n", []string{reg, argType, argReg, paramType})
            }
            return reg
        }
    }
    return coerceArgToParamType(cg, argReg, argType, paramType)
}

// parseIntBits extracts the bit width from an LLVM integer type like "i8" → 8.
fn parseIntBits(llType: string) -> int {
    if !str.StartsWith(llType, "i") {
        return 0
    }
    rest := str.Substr(llType, 1, str.Len(llType) - 1)
    if str.Len(rest) == 0 {
        return 0
    }
    // Ensure all remaining chars are digits
    i := 0
    for i < str.Len(rest) {
        c := rest[i]
        if c < 48 || c > 57 {
            return 0
        }
        i = i + 1
    }
    n, ok := strconv.ParseInt(rest)
    if !ok {
        return 0
    }
    return n
}

// aggregateRetType builds the LLVM struct type for a multi-return function
// from a list of individual return types, e.g. ["i32","i32"] => "{ i32, i32 }".
fn aggregateRetType(retTypes: []string) -> string {
    parts := []string{}
    i := 0
    for i < len(retTypes) {
        parts = append(parts, retTypes[i])
        i = i + 1
    }
    return str.Concat(str.Concat("{ ", str.Join(parts, ", ")), " }")
}

// emitCall emits a function call instruction and returns the result register.
fn emitCall(cg: *CodeGen, retType: string, fnName: string, args: []string) -> string {
    r := ""
    if !str.Equal(retType, "void") {
        r = nextReg(cg)
    }
    parts := []string{}
    parts = append(parts, "  ")
    if !str.Equal(retType, "void") {
        parts = append(parts, r)
        parts = append(parts, " = ")
    }
    parts = append(parts, "call ")
    parts = append(parts, retType)
    parts = append(parts, " @")
    parts = append(parts, fnName)
    parts = append(parts, "(")
    parts = append(parts, str.Join(args, ", "))
    parts = append(parts, ")")
    emitln(cg, concatMany(parts))
    return r
}

// emitIndirectCall emits a call through a function pointer register.
// With LLVM opaque pointers, the syntax is: call <retType> %<reg>(args)
fn emitIndirectCall(cg: *CodeGen, retType: string, fnPtrLLType: string, fnPtrReg: string, args: []string) -> string {
    r := ""
    if !str.Equal(retType, "void") {
        r = nextReg(cg)
    }
    parts := []string{}
    parts = append(parts, "  ")
    if !str.Equal(retType, "void") {
        parts = append(parts, r)
        parts = append(parts, " = ")
    }
    parts = append(parts, "call ")
    parts = append(parts, retType)
    parts = append(parts, " ")
    parts = append(parts, fnPtrReg)
    parts = append(parts, "(")
    parts = append(parts, str.Join(args, ", "))
    parts = append(parts, ")")
    emitln(cg, concatMany(parts))
    return r
}

// === Closures ===
//
// Function-typed values (fn types, type aliases of them, function
// literals) are uniform i8* closure handles: a pointer to a block whose
// first field is the code pointer. Capturing literals store the box
// pointers of captured variables in the remaining block fields (see
// emitFnLit). The calling convention always passes the handle itself as
// a hidden first argument — for non-capturing code it is simply unused.
//
// A non-capturing literal or a named function used as a value shares a
// module-level constant block { i8* code } (emitClosureValue), so taking
// a function value costs no allocation. A capturing literal allocates an
// RC block { i8* code, i8* cap1, ... } — the handle participates in the
// normal retain/release machinery because i8* is heap-typed.

// closureCodePtrType returns the LLVM signature string of the code
// pointer stored in a closure block: "<ret> (i8*, <paramLLTypes...>)".
fn closureCodeSig(retType: string, paramLLTypes: []string) -> string {
    parts := []string{}
    parts = append(parts, retType)
    parts = append(parts, " (i8*")
    i := 0
    for i < len(paramLLTypes) {
        parts = append(parts, ", ")
        parts = append(parts, paramLLTypes[i])
        i = i + 1
    }
    parts = append(parts, ")")
    return concatMany(parts)
}

// emitClosureCall calls a function value through its closure handle.
// Loads the code pointer from block field 0, bitcasts it to the
// expected signature, and invokes it with the handle as the hidden env
// argument followed by the (already coerced) argument list.
fn emitClosureCall(cg: *CodeGen, retType: string, paramLLTypes: []string, handleReg: string, args: []string) -> string {
    bp := nextReg(cg)
    emitfmt(cg, "  %s = bitcast i8* %s to i8**\n", []string{bp, handleReg})
    codeReg := nextReg(cg)
    emitfmt(cg, "  %s = load i8*, i8** %s\n", []string{codeReg, bp})
    sig := str.Concat(closureCodeSig(retType, paramLLTypes), "*")
    fnReg := nextReg(cg)
    emitfmt(cg, "  %s = bitcast i8* %s to %s\n", []string{fnReg, codeReg, sig})
    callArgs := []string{}
    callArgs = append(callArgs, str.Concat("i8* ", handleReg))
    i := 0
    for i < len(args) {
        callArgs = append(callArgs, args[i])
        i = i + 1
    }
    return emitIndirectCall(cg, retType, sig, fnReg, callArgs)
}

// closureCallParams extracts the caller-visible parameter LLVM types and
// the return LLVM type from a checker function type, applying the same
// by-pointer convention for composite by-value params as funcLLType.
fn closureCallTypes(cg: *CodeGen, ft: checker.TType) -> (string, []string) {
    retType := "void"
    if len(ft.retTypes) > 1 {
        var rets []string
        i := 0
        for i < len(ft.retTypes) {
            rets = append(rets, llvmType(cg, ft.retTypes[i]))
            i = i + 1
        }
        retType = aggregateRetType(rets)
    } else if len(ft.retTypes) == 1 {
        retType = llvmType(cg, ft.retTypes[0])
    }
    params := []string{}
    i := 0
    for i < len(ft.params) {
        params = append(params, paramLLType(llvmType(cg, ft.params[i])))
        i = i + 1
    }
    return retType, params
}

// emitClosureValue materializes an i8* closure handle for a named
// function. Emits (once per function) a thunk with the closure calling
// convention — hidden i8* env first argument, then the real params —
// that forwards to the function, plus a private constant block holding
// the thunk's bitcast code pointer. For functions whose signature is
// unknown (builtins), falls back to a plain bitcast of the symbol.
fn emitClosureValue(cg: *CodeGen, fnName: string) -> string {
    hasFn := mapStringStringSliceHasKeyCG(cg.fnRetTypes, fnName)
    if !hasFn {
        // Unknown signature (builtin or extern): the symbol alone cannot
        // be thunked. A null handle keeps the IR well formed; calling it
        // traps rather than silently calling with a shifted env arg.
        return "null"
    }
    globalName := str.Concat("__clos_h_", fnName)
    thunkName := str.Concat("__clos_t_", fnName)
    if !cg.closureThunks[fnName] {
        cg.closureThunks[fnName] = true
        paramLL := cg.fnParamTypes[fnName]
        rets := cg.fnRetTypes[fnName]
        retType := "void"
        if len(rets) > 1 {
            retType = aggregateRetType(rets)
        } else if len(rets) == 1 {
            retType = rets[0]
        }
        // Thunk: define <ret> @__clos_t_<name>(i8* %env, <params>) that
        // tail-forwards to @<name>. The env argument is unused.
        b := &cg.anonFns
        str.Write(b, "define ")
        str.Write(b, retType)
        str.Write(b, " @")
        str.Write(b, thunkName)
        str.Write(b, "(i8* %env")
        i := 0
        for i < len(paramLL) {
            str.Write(b, ", ")
            str.Write(b, paramLL[i])
            str.Write(b, " %a")
            str.Write(b, strconv.Itoa(i))
            i = i + 1
        }
        str.Write(b, ") {\nentry:\n")
        var callArgs []string
        i = 0
        for i < len(paramLL) {
            callArgs = append(callArgs, str.Concat(paramLL[i], str.Concat(" %a", strconv.Itoa(i))))
            i = i + 1
        }
        if str.Equal(retType, "void") {
            str.Write(b, "  call void @")
            str.Write(b, fnName)
            str.Write(b, "(")
            str.Write(b, str.Join(callArgs, ", "))
            str.Write(b, ")\n  ret void\n")
        } else {
            str.Write(b, "  %r = call ")
            str.Write(b, retType)
            str.Write(b, " @")
            str.Write(b, fnName)
            str.Write(b, "(")
            str.Write(b, str.Join(callArgs, ", "))
            str.Write(b, ")\n  ret ")
            str.Write(b, retType)
            str.Write(b, " %r\n")
        }
        str.Write(b, "}\n\n")
        // Constant handle block { i8* code }.
        emitHeader(cg, str.Concat(str.Concat("@", globalName),
            str.Concat(" = private constant { i8* } { i8* bitcast (",
                str.Concat(closureCodeSig(retType, paramLL),
                    str.Concat("* @", str.Concat(thunkName, " to i8*) }\n"))))))
    }
    r := nextReg(cg)
    emitfmt(cg, "  %s = bitcast { i8* }* @%s to i8*\n", []string{r, globalName})
    return r
}

// emitBranch emits a branch instruction.
fn emitBranch(cg: *CodeGen, label: string) {
    emitln(cg, str.Concat(str.Concat("  br label %", label), ""))
    cg.terminated = true
}

// emitCondBranch emits a conditional branch instruction.
fn emitCondBranch(cg: *CodeGen, cond: string, trueLabel: string, falseLabel: string) {
    parts := []string{}
    parts = append(parts, "  br i1 ")
    parts = append(parts, cond)
    parts = append(parts, ", label %")
    parts = append(parts, trueLabel)
    parts = append(parts, ", label %")
    parts = append(parts, falseLabel)
    emitln(cg, concatMany(parts))
    cg.terminated = true
}

// emitLabel emits a basic block label. If the current block has not been
// terminated (no br/ret/etc. emitted yet), a fallthrough branch into the
// new label is emitted first, since LLVM IR does not allow implicit
// fallthrough between basic blocks.
fn emitLabel(cg: *CodeGen, label: string) {
    clearDbgLocation(cg)
    if !cg.terminated {
        emitBranch(cg, label)
    }
    emitln(cg, str.Concat(str.Concat(label, ":"), ""))
    cg.terminated = false
}

// emitRet emits a return instruction.
fn emitRet(cg: *CodeGen, llType: string, val: string) {
    // Pop the panic handler before running deferred statements so a
    // panic raised inside a defer on the normal-return path propagates
    // to the NEXT enclosing handler rather than re-entering ours.
    if cg.needPanicLanding {
        emitln(cg, "  call void @Skink_panic_pop_handler()")
    }
    // Drain the runtime defer stack before returning (Go-like defer
    // semantics): registrations accumulate per executed defer — loops
    // included — and unwind LIFO on every return path.
    emitDeferDrain(cg)
    // Release owned parameters (scope 0) after deferred statements, which
    // may still reference them. Guarded by fnBodyActive so code emitted
    // outside a function body (ruleset eval functions) never touches a
    // stale scope stack.
    if cg.fnBodyActive {
        emitDeallocationsForScope(cg, 0)
    }
    if str.Equal(llType, "void") {
        emitln(cg, "  ret void")
        cg.terminated = true
        return
    }
    parts := []string{}
    parts = append(parts, "  ret ")
    parts = append(parts, llType)
    parts = append(parts, " ")
    parts = append(parts, val)
    emitln(cg, concatMany(parts))
    cg.terminated = true
}

// emitExpression recursively evaluates a Skink expression and returns the
// LLVM SSA virtual register (or inline constant) that holds its value.
// If the expression produces an owned (refcount +1) heap/composite value,
// the result is registered as a scope temporary so it is released when
// the enclosing scope exits.
fn emitExpression(cg: *CodeGen, e: ast.Expr) -> string {
    reg := emitExpressionRaw(cg, e)
    if cg.terminated {
        return reg
    }
    // Passthrough kinds defer to the inner expression, which already
    // recorded its own temporary — don't record the same value twice.
    if e.kind == ast.EX_PAREN || e.kind == ast.EX_SPREAD ||
       e.kind == ast.EX_NONNULL {
        return reg
    }
    if exprProducesOwned(cg, e) {
        recordTemp(cg, reg, exprLLType(cg, e))
    }
    return reg
}

// emitExpressionRaw performs the actual expression dispatch. Callers should
// normally use emitExpression, which additionally tracks owned temporaries.
fn emitExpressionRaw(cg: *CodeGen, e: ast.Expr) -> string {
    if e.kind == ast.EX_INT { return strconv.Itoa(e.intVal) }
    if e.kind == ast.EX_FLOAT {
        // Parser stores the literal text in strVal (floatVal is never set).
        // Normalize for LLVM: strip '_' separators and ensure a '.'
        // appears before any exponent (LLVM requires a decimal point).
        return floatLitLLVM(e.strVal)
    }
    if e.kind == ast.EX_BOOL { return emitBoolLit(e.boolVal) }
    if e.kind == ast.EX_NIL { return "null" }
    if e.kind == ast.EX_STRING { return emitStringLiteral(cg, e.strVal) }
    if e.kind == ast.EX_IDENT { return emitIdent(cg, e) }
    if e.kind == ast.EX_PREFIX { return emitPrefixExpr(cg, e) }
    if e.kind == ast.EX_INFIX { return emitInfixExpr(cg, e) }
    if e.kind == ast.EX_CALL { return emitCallExpr(cg, e) }
    if e.kind == ast.EX_INDEX { return emitIndexExpr(cg, e) }
    if e.kind == ast.EX_FIELD { return emitFieldAccessExpr(cg, e) }
    if e.kind == ast.EX_ARRAY_LIT { return emitArrayLiteral(cg, e) }
    if e.kind == ast.EX_STRUCT_LIT { return emitStructInitExpr(cg, e) }
    if e.kind == ast.EX_PAREN { return emitExpression(cg, e.inner[0]) }
    if e.kind == ast.EX_SLICE { return emitSliceExpr(cg, e) }
    if e.kind == ast.EX_MAKE { return emitMakeExpr(cg, e) }
    if e.kind == ast.EX_FROM_END { return emitFromEndExpr(cg, e) }
    if e.kind == ast.EX_SPREAD { return emitExpression(cg, e.spreadExpr[0]) }
    if e.kind == ast.EX_ERROR_PROP { return emitErrorProp(cg, e) }
    if e.kind == ast.EX_NONNULL { return emitExpression(cg, e.postfixTarget[0]) }
    if e.kind == ast.EX_IF_EXPR { return emitIfExpr(cg, e) }
    if e.kind == ast.EX_MAP_LIT { return emitMapLiteral(cg, e) }
    if e.kind == ast.EX_SET_LIT { return emitSetLiteral(cg, e) }
    if e.kind == ast.EX_SIZEOF { return emitSizeofExpr(cg, e) }
    if e.kind == ast.EX_ALIGNOF { return emitAlignofExpr(cg, e) }
    if e.kind == ast.EX_RANGE { return emitRangeExpr(cg, e) }
    if e.kind == ast.EX_MATCH_EXPR { return emitMatchExpr(cg, e) }
    if e.kind == ast.EX_INTERP { return emitInterpExpr(cg, e) }
    if e.kind == ast.EX_FN_LIT { return emitFnLit(cg, e) }
    if e.kind == ast.EX_ASYNC { return emitAsyncExpr(cg, e) }
    if e.kind == ast.EX_AWAIT { return emitAwaitExpr(cg, e) }
    return "0"
}

// floatLitLLVM normalizes a float literal for LLVM IR: strips '_'
// separators and inserts a decimal point before an exponent marker
// (LLVM requires one: "1e5" is invalid, "1.0e5" is fine).
fn floatLitLLVM(s: string) -> string {
    out := ""
    hasDot := false
    hasExp := false
    i := 0
    for i < str.Len(s) {
        c := s[i]
        if c == 95 { // '_'
            i = i + 1
            continue
        }
        if c == 46 { // '.'
            hasDot = true
        }
        if c == 101 || c == 69 { // 'e'/'E'
            hasExp = true
        }
        out = str.Concat(out, str.Substr(s, i, 1))
        i = i + 1
    }
    if !hasDot {
        if hasExp {
            epos := str.IndexOf(out, "e")
            if epos < 0 {
                epos = str.IndexOf(out, "E")
            }
            out = str.Concat(str.Substr(out, 0, epos), str.Concat(".0", str.Substr(out, epos, str.Len(out) - epos)))
        } else {
            out = str.Concat(out, ".0")
        }
    }
    return out
}

// emitBoolLit returns the LLVM literal for a boolean value.
fn emitBoolLit(b: bool) -> string {
    if b {
        return "1"
    }
    return "0"
}

// emitIdent handles identifier expressions.
fn emitIdent(cg: *CodeGen, e: ast.Expr) -> string {
    name := e.ident
    // Check if it's a const
    val := cg.consts[name]
    if val.kind != 0 {
        return emitConstExpr(cg, name)
    }
    if str.Len(cg.currentModule) > 0 {
        qualified := str.Concat(cg.currentModule, str.Concat(".", name))
        qval := cg.consts[qualified]
        if qval.kind != 0 {
            return emitConstExpr(cg, qualified)
        }
    }
    // Look up local variable
    sv, ok := lookupVar(cg, name)
    if ok {
        reg := emitLoad(cg, sv.llType, sv.llType, varValuePtr(cg, sv))
        return reg
    }
    // Bare tagged-union variant used as a value (e.g. `s := None`)
    if mapStringDeclHasKeyTU2(cg.tuVariantDecl, name) {
        d2 := cg.tuVariantDecl[name]
        vidx2 := cg.tuVariantIdx[name]
        if len(d2.enumVariants[vidx2].payloads) == 0 {
            return emitTUBareVariant(cg, name)
        }
    }
    // Check if it's a function — materialize a closure handle (i8*).
    hasFn := mapStringStringSliceHasKeyCG(cg.fnRetTypes, name)
    if hasFn {
        return emitClosureValue(cg, name)
    }
    // Try module-qualified function name
    if str.Len(cg.currentModule) > 0 {
        qualifiedFn := str.Concat(str.Concat(cg.currentModule, "."), name)
        hasQFn := mapStringStringSliceHasKeyCG(cg.fnRetTypes, qualifiedFn)
        if hasQFn {
            return emitClosureValue(cg, qualifiedFn)
        }
    }
    // Check if it's a global variable
    gvt := cg.globalVarTypes[name]
    hasGvt := mapStringStringHasKeyCG(cg.globalVarTypes, name)
    if hasGvt {
        globalPtr := str.Concat("@", name)
        reg := emitLoad(cg, gvt, gvt, globalPtr)
        return reg
    }
    // Try module-qualified global variable name
    if str.Len(cg.currentModule) > 0 {
        qualifiedName := str.Concat(str.Concat(cg.currentModule, "."), name)
        qGvt := cg.globalVarTypes[qualifiedName]
        hasQGvt := mapStringStringHasKeyCG(cg.globalVarTypes, qualifiedName)
        if hasQGvt {
            globalPtr := str.Concat("@", qualifiedName)
            reg := emitLoad(cg, qGvt, qGvt, globalPtr)
            return reg
        }
    }
    // Default
    return str.Concat("@", name)
}

// emitAddressOf computes the address of an lvalue expression (used for the
// `&expr` operator) without loading its value, so mutations through the
// resulting pointer are visible to the original storage location.
fn emitAddressOf(cg: *CodeGen, e: ast.Expr) -> string {
    if e.kind == ast.EX_IDENT {
        sv, ok := lookupVar(cg, e.ident)
        if ok {
            // Mark variable as borrowed so it won't be released at scope exit
            markBorrowed(cg, e.ident)
            if sv.escaped || str.Len(sv.heapSlot) > 0 {
                // &ptr on a boxed struct-pointer variable still returns the
                // object pointer — the value stored inside the box — not the
                // address of the box itself, matching the unboxed path below
                // (comp_error.md #39 regression: `spawn worker(&wg)` passed
                // the box as *WaitGroup once captured pointer vars boxed at
                // declaration). Non-struct pointer types keep true
                // address-of semantics: the box pointer is their **T.
                if str.StartsWith(sv.llType, "%struct.") && str.EndsWith(sv.llType, "*") {
                    boxPtr := varValuePtr(cg, sv)
                    return emitLoad(cg, sv.llType, sv.llType, boxPtr)
                }
                // Boxed variable: the RC heap block pointer is its stable
                // address and remains valid after this frame returns.
                return varValuePtr(cg, sv)
            }
            // Struct-by-value variables are stored as heap pointers in allocas.
            // &var should return the heap pointer (loaded from alloca), not
            // the alloca address itself.
            if str.StartsWith(sv.llType, "%struct.") && str.EndsWith(sv.llType, "*") {
                return emitLoad(cg, sv.llType, sv.llType, sv.alloca)
            }
            return sv.alloca
        }
        hasGvt := mapStringStringHasKeyCG(cg.globalVarTypes, e.ident)
        if hasGvt {
            return str.Concat("@", e.ident)
        }
        // Globals are stored under the module-qualified name in non-main
        // modules (comp_error.md #87).
        if str.Len(cg.currentModule) > 0 {
            qn := str.Concat(str.Concat(cg.currentModule, "."), e.ident)
            if mapStringStringHasKeyCG(cg.globalVarTypes, qn) {
                return str.Concat("@", qn)
            }
        }
    }
    if e.kind == ast.EX_INDEX {
        arrExpr := e.indexTarget[0]
        arrReg := emitExpression(cg, arrExpr)
        leftType := exprLLType(cg, arrExpr)
        idxReg := emitExpression(cg, e.indexExpr[0])
        emitIndexBoundsCheck(cg, arrExpr, arrReg, leftType, idxReg, e.indexExpr[0])
        idxReg = emitIndexAsI32(cg, idxReg, e.indexExpr[0])
        elemType := exprLLType(cg, e)
        if str.Equal(leftType, "i8*") && exprIsByteSlice(cg, arrExpr) {
            elemType = "i8"
        }
        elemPtrType := str.Concat(elemType, "*")
        actualBase := arrReg
        if exprIsSlice(cg, arrExpr) || (str.Equal(leftType, "i8*") && exprIsByteSlice(cg, arrExpr)) {
            dataPtr := emitSliceData(cg, arrReg, leftType)
            actualBase = emitFromI8Ptr(cg, dataPtr, elemPtrType)
        }
        indices := []string{}
        indices = append(indices, idxReg)
        return emitGEP(cg, elemType, elemPtrType, actualBase, indices)
    }
    if e.kind == ast.EX_FIELD {
        receiverExpr := e.fieldTarget[0]
        fieldName := e.fieldName
        leftType := exprLLType(cg, receiverExpr)
        if str.StartsWith(leftType, "%struct.") {
            structName := str.Substr(leftType, str.Len("%struct."), str.Len(leftType) - str.Len("%struct."))
            if str.Contains(structName, "*") {
                structName = str.Substr(structName, 0, str.IndexOf(structName, "*"))
            }
            layout := cg.structLayouts[structName]
            hasLayout := str.Len(layout.llType) > 0
            if hasLayout {
                fieldIdx := -1
                i := 0
                for i < len(layout.fields) {
                    if str.Equal(layout.fields[i], fieldName) {
                        fieldIdx = i
                        break
                    }
                    i = i + 1
                }
                if fieldIdx >= 0 {
                    var receiverPtr string
                    if str.EndsWith(leftType, "*") {
                        // Pointer-typed receiver (e.g. cg.checker *Checker):
                        // the loaded pointer IS the struct base. Taking
                        // emitAddressOf would yield &ptr — a **T — and the
                        // GEP below would index through the pointer slot
                        // instead of the pointee (comp_error.md #32).
                        receiverPtr = emitExpression(cg, receiverExpr)
                    } else {
                        // Value receiver: prefer its own address (not a
                        // loaded copy) so field mutations propagate.
                        receiverPtr = emitAddressOf(cg, receiverExpr)
                    }
                    structPtrType := str.Concat(layout.llType, "*")
                    indices := []string{}
                    indices = append(indices, "i32 0")
                    indices = append(indices, str.Concat("i32 ", strconv.Itoa(fieldIdx)))
                    return emitGEP(cg, layout.llType, structPtrType, receiverPtr, indices)
                }
            }
        }
    }
    // Fallback: for expressions that already produce a pointer (e.g.
    // struct literals, which are heap-allocated), the emitted value IS
    // the address — return it directly, matching the Go reference
    // compiler's "the emitted value is already an address" rule.
    // For non-pointer value types, spill to a fresh alloca so the caller
    // gets a valid address (mutations won't propagate, but this avoids
    // crashing on unsupported lvalue forms).
    valReg := emitExpression(cg, e)
    valType := exprLLType(cg, e)
    if str.EndsWith(valType, "*") {
        return valReg
    }
    tmp := emitAlloca(cg, valType)
    emitStore(cg, valType, valReg, valType, tmp)
    return tmp
}

// emitPrefixExpr handles unary prefix expressions.
fn emitPrefixExpr(cg: *CodeGen, e: ast.Expr) -> string {
    op := e.prefixOp
    if str.Equal(op, "<-") {
        return emitChanRecv(cg, e)
    }
    if str.Equal(op, "&") {
        // Address-of: compute the lvalue's address directly, without
        // going through the normal (loading) expression emitter.
        return emitAddressOf(cg, e.prefixRight[0])
    }
    operand := emitExpression(cg, e.prefixRight[0])
    resultType := exprLLType(cg, e)
    if str.Equal(op, "-") {
        if str.Equal(resultType, "double") {
            r := nextReg(cg)
            parts := []string{}
            parts = append(parts, "  ")
            parts = append(parts, r)
            parts = append(parts, " = fneg double ")
            parts = append(parts, operand)
            emitln(cg, concatMany(parts))
            return r
        }
        // Use the operand's actual integer type (i32 or i64) for negation.
        operandType := exprLLType(cg, e.prefixRight[0])
        // Also check resultType and direct variable lookup as fallbacks,
        // since exprLLType may not always resolve the correct type for
        // identifiers in certain scope contexts.
        if str.Equal(resultType, "i64") {
            return emitBinaryOp(cg, "sub", "i64", "0", operand)
        }
        if e.prefixRight[0].kind == ast.EX_IDENT {
            sv, ok := lookupVar(cg, e.prefixRight[0].ident)
            if ok && str.Equal(sv.llType, "i64") {
                return emitBinaryOp(cg, "sub", "i64", "0", operand)
            }
        }
        if str.Equal(operandType, "i64") {
            return emitBinaryOp(cg, "sub", "i64", "0", operand)
        }
        // Narrow ints (i8/i16): negate at the operand's own width —
        // `sub i32 0, %i16reg` would be invalid IR.
        if str.StartsWith(operandType, "i") && !str.EndsWith(operandType, "*") &&
            !str.Equal(operandType, "i1") && !str.Equal(operandType, "i32") {
            return emitBinaryOp(cg, "sub", operandType, "0", operand)
        }
        return emitBinaryOp(cg, "sub", "i32", "0", operand)
    }
    if str.Equal(op, "!") {
        return emitBinaryOp(cg, "xor", "i1", operand, "1")
    }
    if str.Equal(op, "~") {
        operandType := exprLLType(cg, e.prefixRight[0])
        if str.StartsWith(operandType, "i") && !str.EndsWith(operandType, "*") &&
            !str.Equal(operandType, "i1") && !str.Equal(operandType, "i32") {
            return emitBinaryOp(cg, "xor", operandType, operand, "-1")
        }
        return emitBinaryOp(cg, "xor", "i32", operand, "-1")
    }
    if str.Equal(op, "*") {
        // Dereference: load from pointer
        elemType := resultType
        return emitLoad(cg, elemType, elemType, operand)
    }
    return operand
}

// emitChanSendBox evaluates a channel-send value expression, coerces it to
// the channel's declared element type, retains it for the channel buffer,
// and stores it in a fresh stack slot. Returns the slot pointer bitcast to
// i8* for Skink_chan_send. The slot type must be the channel element type —
// not the expression type — because the runtime copies elem_size bytes from
// it: sending a heap-allocated struct pointer (%struct.T*) through chan<T>
// must dereference to a full %struct.T, otherwise the copy reads past the
// pointer-sized slot and delivers a corrupted struct.
fn emitChanSendBox(cg: *CodeGen, chExpr: ast.Expr, valExpr: ast.Expr) -> string {
    valReg := emitExpression(cg, valExpr)
    valLLType := exprLLType(cg, valExpr)
    elemLLType := chanElemLLTypeOpt(cg, chExpr)
    if str.Len(elemLLType) > 0 {
        if !str.Equal(elemLLType, valLLType) {
            valReg = coerceExprToParamType(cg, valReg, valLLType, elemLLType, valExpr)
        }
        valLLType = elemLLType
    }
    if str.Equal(valLLType, "") {
        valLLType = "i32"
    }
    // The channel takes ownership of a reference: retain heap values so
    // the value stays alive inside the channel buffer even after the
    // sender's own reference (or expression temporary) is released.
    if isHeapLLType(valLLType) {
        valReg = emitRetain(cg, valReg, valLLType)
    } else if isCompositeType(valLLType) && !str.EndsWith(valLLType, "*") {
        valReg = emitRetainStructHeapFields(cg, valReg, valLLType)
    }
    slotReg := emitAlloca(cg, valLLType)
    emitStore(cg, valLLType, valReg, valLLType, slotReg)
    slotI8 := nextReg(cg)
    emitfmt(cg, "  %s = bitcast %s* %s to i8*\n", []string{slotI8, valLLType, slotReg})
    return slotI8
}

// emitChanSend handles channel send: ch <- val.
fn emitChanSend(cg: *CodeGen, e: ast.Expr) -> string {
    chReg := emitExpression(cg, e.infixLeft[0])
    slotI8 := emitChanSendBox(cg, e.infixLeft[0], e.infixRight[0])
    emitfmt(cg, "  call void @Skink_chan_send(i8* %s, i8* %s)\n", []string{chReg, slotI8})
    return "0"
}

// emitChanRecv handles channel receive: <-ch.
// A closed channel returns NULL from Skink_chan_recv — produce the
// element type's zero value rather than dereferencing null.
fn emitChanRecv(cg: *CodeGen, e: ast.Expr) -> string {
    chReg := emitExpression(cg, e.prefixRight[0])
    resultLLType := chanRecvElemLLType(cg, e)
    if str.Equal(resultLLType, "") {
        resultLLType = "i32"
    }
    dataPtr := nextReg(cg)
    emitfmt(cg, "  %s = call i8* @Skink_chan_recv(i8* %s)\n", []string{dataPtr, chReg})
    // Zero slot for the closed-channel case.
    zeroSlot := emitAlloca(cg, resultLLType)
    emitStore(cg, resultLLType, "zeroinitializer", resultLLType, zeroSlot)
    // Select between the zero slot and the received data before loading.
    isNull := nextReg(cg)
    emitfmt(cg, "  %s = icmp eq i8* %s, null\n", []string{isNull, dataPtr})
    typedPtr := nextReg(cg)
    emitfmt(cg, "  %s = bitcast i8* %s to %s*\n", []string{typedPtr, dataPtr, resultLLType})
    srcPtr := nextReg(cg)
    emitfmt(cg, "  %s = select i1 %s, %s* %s, %s* %s\n", []string{srcPtr, isNull, resultLLType, zeroSlot, resultLLType, typedPtr})
    valReg := emitLoad(cg, resultLLType, resultLLType, srcPtr)
    emitfmt(cg, "  call void @Skink_free(i8* %s)\n", []string{dataPtr})
    return valReg
}

// exprIsChan reports whether an expression's static type is a channel.
fn exprIsChan(cg: *CodeGen, e: ast.Expr) -> bool {
    // Prefer the checker's recorded type for this exact expression — it
    // resolves receivers like `h.ch`/`self.ch` where emitter-side scope
    // lookups below can't see the local/field types.
    rt := checker.exprTypeLookup(cg.checker, cg.currentFilePath, e.line, e.col)
    if rt.kind == checker.TK_NAMED {
        rt = resolveAliasCG(cg, rt)
    }
    if rt.kind == checker.TK_CHAN {
        return true
    }
    if e.kind == ast.EX_IDENT {
        sv, ok := lookupVar(cg, e.ident)
        if ok {
            t := sv.synType
            if t.kind == checker.TK_NAMED {
                t = resolveAliasCG(cg, t)
            }
            return t.kind == checker.TK_CHAN
        }
        return false
    }
    if e.kind == ast.EX_FIELD {
        fieldType := checker.resolveFieldType(cg.checker, e)
        return fieldType.kind == checker.TK_CHAN
    }
    return false
}

// chanElemLLTypeOpt looks up the LLVM type of a channel's element,
// returning "" when the channel type cannot be resolved.
fn chanElemLLTypeOpt(cg: *CodeGen, chExpr: ast.Expr) -> string {
    // Preferred source: the checker's recorded type for this exact
    // expression. Handles receivers like self.out and inferred locals
    // (oc := h.out) whose synType isn't tracked in the emitter's scope —
    // resolveFieldType below can't see `self`/locals at emit time.
    rt := checker.exprTypeLookup(cg.checker, cg.currentFilePath, chExpr.line, chExpr.col)
    if rt.kind == checker.TK_NAMED {
        rt = resolveAliasCG(cg, rt)
    }
    if rt.kind == checker.TK_CHAN && len(rt.elem) > 0 {
        elemT := typeOptT(rt.elem)
        return llvmType(cg, elemT)
    }
    // For identifier expressions, look up the variable's synType
    if chExpr.kind == ast.EX_IDENT {
        sv, ok := lookupVar(cg, chExpr.ident)
        if ok {
            t := sv.synType
            if t.kind == checker.TK_NAMED {
                t = resolveAliasCG(cg, t)
            }
            if t.kind == checker.TK_CHAN && len(t.elem) > 0 {
                elemT := typeOptT(t.elem)
                return llvmType(cg, elemT)
            }
        }
    }
    // For field access expressions (e.g. t.C), look up the struct's
    // field type via the checker to find the channel element type.
    if chExpr.kind == ast.EX_FIELD {
        fieldType := checker.resolveFieldType(cg.checker, chExpr)
        if fieldType.kind == checker.TK_NAMED {
            fieldType = resolveAliasCG(cg, fieldType)
        }
        if fieldType.kind == checker.TK_CHAN && len(fieldType.elem) > 0 {
            elemT := typeOptT(fieldType.elem)
            return llvmType(cg, elemT)
        }
    }
    return ""
}

// chanElemLLType looks up the LLVM type of a channel's element.
fn chanElemLLType(cg: *CodeGen, chExpr: ast.Expr) -> string {
    ll := chanElemLLTypeOpt(cg, chExpr)
    if str.Equal(ll, "") {
        return "i32"
    }
    return ll
}

// chanRecvElemLLType looks up the LLVM type of a channel receive expression's
// result. It prefers the checker's file-aware exprTypes record (the recv
// expr's own type IS the element type), then the line:col-keyed
// chanElemTypes map, then falls back to chanElemLLType on the channel
// expression.
fn chanRecvElemLLType(cg: *CodeGen, recvExpr: ast.Expr) -> string {
    // Preferred source: the checker's recorded type for the recv
    // expression itself — it IS the element type, and the key is
    // file-aware (chanElemTypes below keys on line:col only).
    rt := checker.exprTypeLookup(cg.checker, cg.currentFilePath, recvExpr.line, recvExpr.col)
    if rt.kind == checker.TK_NAMED {
        rt = resolveAliasCG(cg, rt)
    }
    if rt.kind != 0 && rt.kind != checker.TK_UNKNOWN {
        ll := llvmType(cg, rt)
        if str.Len(ll) > 0 && !str.Equal(ll, "void") {
            return ll
        }
    }
    t := checker.chanElemTypeLookup(cg.checker, recvExpr.line, recvExpr.col)
    if t.kind != 0 {
        ll := llvmType(cg, t)
        if str.Len(ll) > 0 && !str.Equal(ll, "void") {
            return ll
        }
    }
    return chanElemLLType(cg, recvExpr.prefixRight[0])
}

// builtinTypeLL converts a builtin type name string to its LLVM type.
fn builtinTypeLL(name: string) -> string {
    if str.Equal(name, "int") || str.Equal(name, "int32") || str.Equal(name, "uint32") {
        return "i32"
    }
    if str.Equal(name, "int64") || str.Equal(name, "uint64") {
        return "i64"
    }
    if str.Equal(name, "int8") || str.Equal(name, "uint8") {
        return "i8"
    }
    if str.Equal(name, "int16") || str.Equal(name, "uint16") {
        return "i16"
    }
    if str.Equal(name, "bool") {
        return "i1"
    }
    if str.Equal(name, "float") || str.Equal(name, "double") {
        return "double"
    }
    if str.Equal(name, "string") {
        return "i8*"
    }
    // Default: treat as pointer (i8*) for named/complex types
    return "i8*"
}

// isIntegerLiteralExpr returns true if the expression is an integer literal.
fn isIntegerLiteralExpr(e: ast.Expr) -> bool {
    return e.kind == ast.EX_INT
}

// coerceIntLiteralToPtr converts an integer literal value to i8* via inttoptr.
fn coerceIntLiteralToPtr(cg: *CodeGen, val: string, e: ast.Expr) -> string {
    // Integer literals are emitted as i32; coerce to i64 first (sign-extend
    // to preserve negative values), then to i8*
    i64Reg := nextReg(cg)
    emitfmt(cg, "  %s = sext i32 %s to i64\n", []string{i64Reg, val})
    ptrReg := nextReg(cg)
    emitfmt(cg, "  %s = inttoptr i64 %s to i8*\n", []string{ptrReg, i64Reg})
    return ptrReg
}

// emitErrorProp handles the ? error propagation operator. It evaluates the
// target expression (which produces an aggregate { T, error }), extracts the
// first value (T), and checks the error. If the error is non-nil, it propagates
// the error to the caller. For now, we just extract the first value.
fn emitErrorProp(cg: *CodeGen, e: ast.Expr) -> string {
    aggReg := emitExpression(cg, e.postfixTarget[0])
    aggType := exprLLType(cg, e.postfixTarget[0])
    // If the target is a call to a multi-return function, use the function's
    // return types to determine the aggregate type.
    calleeRetTypes := []string{}
    if e.postfixTarget[0].kind == ast.EX_CALL {
        callFn := e.postfixTarget[0].callFunc[0]
        callFnName := ""
        if callFn.kind == ast.EX_IDENT {
            callFnName = resolveDirectFnName(cg, callFn.ident)
        } else if callFn.kind == ast.EX_FIELD {
            dummy := false
            callFnName, dummy = resolveMethodCallFnName(cg, callFn)
        }
        hasFn := mapStringStringSliceHasKeyCG(cg.fnRetTypes, callFnName)
        if hasFn && len(cg.fnRetTypes[callFnName]) > 1 {
            aggType = aggregateRetType(cg.fnRetTypes[callFnName])
            calleeRetTypes = cg.fnRetTypes[callFnName]
        }
    }
    // Only handle aggregate returns (multi-value with error as last)
    if !str.StartsWith(aggType, "{ ") {
        return aggReg
    }
    if len(calleeRetTypes) == 0 {
        // Fallback: extract first value (old behavior)
        reg := nextReg(cg)
        emitfmt(cg, "  %s = extractvalue %s %s, 0\n", []string{reg, aggType, aggReg})
        return reg
    }
    // Extract the error (last value from the aggregate)
    errIdx := len(calleeRetTypes) - 1
    errType := calleeRetTypes[errIdx]
    errReg := nextReg(cg)
    emitfmt(cg, "  %s = extractvalue %s %s, %s\n", []string{errReg, aggType, aggReg, strconv.Itoa(errIdx)})

    // Check if the error is non-nil. For errors.Error (a struct with a
    // message: string field), "nil" means the message is empty (i8* null).
    // The struct is %struct.errors_Error = { i8* }. Check field 0 against null.
    errIsNilReg := nextReg(cg)
    if str.Equal(errType, "%struct.errors_Error") {
        // Extract the message field (index 0) from the error struct
        msgReg := nextReg(cg)
        emitfmt(cg, "  %s = extractvalue %s %s, 0\n", []string{msgReg, errType, errReg})
        emitfmt(cg, "  %s = icmp eq i8* %s, null\n", []string{errIsNilReg, msgReg})
    } else {
        // For pointer-typed errors, compare against null directly
        if str.EndsWith(errType, "*") {
            emitfmt(cg, "  %s = icmp eq %s %s, null\n", []string{errIsNilReg, errType, errReg})
        } else {
            // Unknown error type — assume no error
            emitfmt(cg, "  %s = add i1 0, 1\n", []string{errIsNilReg})
        }
    }

    // If error is nil, continue to extract the value. If non-nil, propagate.
    okLabel := nextLabel(cg)
    propLabel := nextLabel(cg)
    emitCondBranch(cg, errIsNilReg, okLabel, propLabel)

    // Error propagation path: store the aggregate into fnReturnAlloca and
    // branch to the function's return label.
    emitLabel(cg, propLabel)
    if str.Len(cg.fnReturnLabel) > 0 && str.Len(cg.fnReturnAlloca) > 0 {
        // The enclosing function's return shape may differ from the
        // callee's aggregate (e.g. fn returns (Config, error) but the call
        // produced (string, error)). Build the function's own return
        // aggregate: zero values for non-error slots, the real error last.
        fnAgg := aggregateRetType(cg.currentFnRetTypes)
        retAgg := "undef"
        ri := 0
        for ri < len(cg.currentFnRetTypes) {
            if ri == errIdx && str.Equal(cg.currentFnRetTypes[ri], errType) {
                insReg := nextReg(cg)
                emitfmt(cg, "  %s = insertvalue %s %s, %s %s, %s\n", []string{insReg, fnAgg, retAgg, errType, errReg, strconv.Itoa(ri)})
                retAgg = insReg
            } else {
                insReg := nextReg(cg)
                zt := cg.currentFnRetTypes[ri]
                zv := zeroValueForLLType(zt)
                emitfmt(cg, "  %s = insertvalue %s %s, %s %s, %s\n", []string{insReg, fnAgg, retAgg, zt, zv, strconv.Itoa(ri)})
                retAgg = insReg
            }
            ri = ri + 1
        }
        emitfmt(cg, "  store %s %s, %s* %s\n", []string{fnAgg, retAgg, fnAgg, cg.fnReturnAlloca})
        emitBranch(cg, cg.fnReturnLabel)
        cg.terminated = false
    } else {
        // Functions returning a bare error (e.g. `-> errors.Error`) don't
        // get a return label. Propagate just the error value, not the
        // whole source aggregate.
        emitAllDeallocations(cg)
        if len(cg.currentFnRetTypes) == 1 && str.Equal(cg.currentFnRetTypes[0], errType) {
            emitfmt(cg, "  ret %s %s\n", []string{errType, errReg})
        } else {
            emitfmt(cg, "  ret %s %s\n", []string{aggType, aggReg})
        }
        cg.terminated = true
    }

    // Success path: extract the non-error value(s)
    emitLabel(cg, okLabel)
    if len(calleeRetTypes) == 2 {
        // Single non-error value
        reg := nextReg(cg)
        emitfmt(cg, "  %s = extractvalue %s %s, 0\n", []string{reg, aggType, aggReg})
        return reg
    }
    // Multiple non-error values: build a tuple aggregate
    // For now, extract the first value (common case)
    reg := nextReg(cg)
    emitfmt(cg, "  %s = extractvalue %s %s, 0\n", []string{reg, aggType, aggReg})
    return reg
}

// emitPowerOp implements the ** operator. For floating-point operands it
// uses llvm.pow.f64. For integer operands it emits a simple multiplication
// loop. The exponent is assumed to be a non-negative integer for the
// integer case.
fn emitPowerOp(cg: *CodeGen, left: string, right: string, operandType: string) -> string {
    // Floating-point power: use llvm.pow.f64
    if str.Equal(operandType, "double") {
        result := nextReg(cg)
        emitfmt(cg, "  %s = call double @llvm.pow.f64(double %s, double %s)\n", []string{result, left, right})
        return result
    }
    // Integer power: emit a loop that multiplies left by itself right times.
    // result = 1; while (exp > 0) { if (exp & 1) result *= base; base *= base; exp >>= 1; }
    resultAlloca := nextReg(cg)
    emitfmt(cg, "  %s = alloca %s\n", []string{resultAlloca, operandType})
    emitfmt(cg, "  store %s 1, %s* %s\n", []string{operandType, operandType, resultAlloca})

    baseAlloca := nextReg(cg)
    emitfmt(cg, "  %s = alloca %s\n", []string{baseAlloca, operandType})
    emitfmt(cg, "  store %s %s, %s* %s\n", []string{operandType, left, operandType, baseAlloca})

    expAlloca := nextReg(cg)
    emitfmt(cg, "  %s = alloca %s\n", []string{expAlloca, operandType})
    emitfmt(cg, "  store %s %s, %s* %s\n", []string{operandType, right, operandType, expAlloca})

    condLabel := nextLabel(cg)
    bodyLabel := nextLabel(cg)
    endLabel := nextLabel(cg)

    emitBranch(cg, condLabel)
    emitln(cg, str.Concat(condLabel, ":\n"))
    expVal := nextReg(cg)
    emitfmt(cg, "  %s = load %s, %s* %s\n", []string{expVal, operandType, operandType, expAlloca})
    cond := nextReg(cg)
    emitfmt(cg, "  %s = icmp sgt %s %s, 0\n", []string{cond, operandType, expVal})
    emitCondBranch(cg, cond, bodyLabel, endLabel)

    emitln(cg, str.Concat(bodyLabel, ":\n"))
    // if (exp & 1) result *= base
    oneBit := nextReg(cg)
    emitfmt(cg, "  %s = and %s %s, 1\n", []string{oneBit, operandType, expVal})
    doMul := nextReg(cg)
    emitfmt(cg, "  %s = icmp ne %s %s, 0\n", []string{doMul, operandType, oneBit})
    mulLabel := nextLabel(cg)
    skipMulLabel := nextLabel(cg)
    emitCondBranch(cg, doMul, mulLabel, skipMulLabel)

    emitln(cg, str.Concat(mulLabel, ":\n"))
    curResult := nextReg(cg)
    emitfmt(cg, "  %s = load %s, %s* %s\n", []string{curResult, operandType, operandType, resultAlloca})
    curBase := nextReg(cg)
    emitfmt(cg, "  %s = load %s, %s* %s\n", []string{curBase, operandType, operandType, baseAlloca})
    newResult := nextReg(cg)
    emitfmt(cg, "  %s = mul %s %s, %s\n", []string{newResult, operandType, curResult, curBase})
    emitfmt(cg, "  store %s %s, %s* %s\n", []string{operandType, newResult, operandType, resultAlloca})
    emitBranch(cg, skipMulLabel)

    emitln(cg, str.Concat(skipMulLabel, ":\n"))
    // base *= base
    curBase2 := nextReg(cg)
    emitfmt(cg, "  %s = load %s, %s* %s\n", []string{curBase2, operandType, operandType, baseAlloca})
    newBase := nextReg(cg)
    emitfmt(cg, "  %s = mul %s %s, %s\n", []string{newBase, operandType, curBase2, curBase2})
    emitfmt(cg, "  store %s %s, %s* %s\n", []string{operandType, newBase, operandType, baseAlloca})
    // exp >>= 1
    newExp := nextReg(cg)
    emitfmt(cg, "  %s = ashr %s %s, 1\n", []string{newExp, operandType, expVal})
    emitfmt(cg, "  store %s %s, %s* %s\n", []string{operandType, newExp, operandType, expAlloca})
    emitBranch(cg, condLabel)

    cg.terminated = false
    emitln(cg, str.Concat(endLabel, ":\n"))
    finalResult := nextReg(cg)
    emitfmt(cg, "  %s = load %s, %s* %s\n", []string{finalResult, operandType, operandType, resultAlloca})
    return finalResult
}

// emitInfixExpr handles binary infix expressions.
fn emitInfixExpr(cg: *CodeGen, e: ast.Expr) -> string {
    op := e.infixOp

    // Short-circuit logical operators: && and || must not evaluate their
    // right operand if the left operand determines the result.  Without
    // this, expressions like `len(arr) > 0 && arr[0].kind == X` would
    // access arr[0] even when arr is empty, causing null dereferences.
    if str.Equal(op, "&&") {
        return emitShortCircuitAnd(cg, e)
    }
    if str.Equal(op, "||") {
        return emitShortCircuitOr(cg, e)
    }

    // Channel send: ch <- val
    if str.Equal(op, "<-") {
        return emitChanSend(cg, e)
    }

    // Set membership: x in set{...}
    if str.Equal(op, "in") {
        return emitSetInOp(cg, e)
    }

    // Error vs nil comparison: struct types with a `message` field
    // (e.g. errors.Error) can't be compared directly to null. Instead,
    // compare the message field (i8*) to null — an empty message means
    // "no error" (nil).
    if str.Equal(op, "==") || str.Equal(op, "!=") {
        leftIsNil := e.infixLeft[0].kind == ast.EX_NIL
        rightIsNil := e.infixRight[0].kind == ast.EX_NIL
        if leftIsNil || rightIsNil {
            var errExpr ast.Expr
            if leftIsNil {
                errExpr = e.infixRight[0]
            } else {
                errExpr = e.infixLeft[0]
            }
            errLLType := exprLLType(cg, errExpr)
            // Check if this is a struct type with a "message" field
            if str.StartsWith(errLLType, "%struct.") && !str.EndsWith(errLLType, "*") {
                structName := str.Substr(errLLType, str.Len("%struct."), str.Len(errLLType) - str.Len("%struct."))
                layout := cg.structLayouts[structName]
                hasLayout := str.Len(layout.llType) > 0
                msgFieldIdx := -1
                if hasLayout {
                    for fi := 0; fi < len(layout.fields); fi = fi + 1 {
                        if str.Equal(layout.fields[fi], "message") {
                            msgFieldIdx = fi
                            break
                        }
                    }
                }
                if msgFieldIdx >= 0 {
                    errReg := emitExpression(cg, errExpr)
                    // errReg is a struct value; spill to alloca to get a pointer
                    errAlloca := emitAlloca(cg, errLLType)
                    emitStore(cg, errLLType, errReg, errLLType, errAlloca)
                    // GEP the message field from the struct
                    msgPtr := nextReg(cg)
                    emitfmt(cg, "  %s = getelementptr inbounds %s, %s* %s, i32 0, i32 %s\n", []string{msgPtr, errLLType, errLLType, errAlloca, strconv.Itoa(msgFieldIdx)})
                    msgVal := nextReg(cg)
                    emitfmt(cg, "  %s = load i8*, i8** %s\n", []string{msgVal, msgPtr})
                    // err == nil means message is empty (first byte is 0)
                    // or message pointer is null. The byte load must not
                    // deref null — select a static zero byte instead.
                    nullReg := nextReg(cg)
                    emitfmt(cg, "  %s = icmp eq i8* %s, null\n", []string{nullReg, msgVal})
                    zeroByteAlloca := emitAlloca(cg, "i8")
                    emitfmt(cg, "  store i8 0, i8* %s\n", []string{zeroByteAlloca})
                    safePtr := nextReg(cg)
                    emitfmt(cg, "  %s = select i1 %s, i8* %s, i8* %s\n", []string{safePtr, nullReg, zeroByteAlloca, msgVal})
                    firstByte := nextReg(cg)
                    emitfmt(cg, "  %s = load i8, i8* %s\n", []string{firstByte, safePtr})
                    emptyReg := nextReg(cg)
                    emitfmt(cg, "  %s = icmp eq i8 %s, 0\n", []string{emptyReg, firstByte})
                    isEmpty := nextReg(cg)
                    emitfmt(cg, "  %s = or i1 %s, %s\n", []string{isEmpty, nullReg, emptyReg})
                    if str.Equal(op, "==") {
                        return isEmpty
                    }
                    r := nextReg(cg)
                    emitfmt(cg, "  %s = xor i1 %s, true\n", []string{r, isEmpty})
                    return r
                }
            }
        }
    }

    left := emitExpression(cg, e.infixLeft[0])
    right := emitExpression(cg, e.infixRight[0])
    resultType := exprLLType(cg, e)

    // Operand type drives arithmetic/comparison opcode selection. For
    // comparison operators the result type is i1 (boolean), so we must
    // inspect the operand type rather than the result type to decide
    // whether to use integer (icmp) or floating-point (fcmp) ops.
    operandType := exprLLType(cg, e.infixLeft[0])
    if str.Equal(operandType, "") {
        operandType = "i32"
    }

    // String concatenation (i8* + i8* => i8*)
    if str.Equal(op, "+") && str.Equal(resultType, "i8*") {
        return emitStringConcat(cg, left, right)
    }

    // Power operator: ** — right-associative exponentiation
    if str.Equal(op, "**") {
        return emitPowerOp(cg, left, right, operandType)
    }

    // Float arithmetic and comparisons. Treat the expression as double if
    // either operand is double; coerce the other (integer) operand to double.
    leftType := exprLLType(cg, e.infixLeft[0])
    rightType := exprLLType(cg, e.infixRight[0])
    if str.Equal(operandType, "double") || str.Equal(leftType, "double") || str.Equal(rightType, "double") {
        if !str.Equal(leftType, "double") && !str.Equal(leftType, "float") {
            left = emitCastToDouble(cg, left, leftType)
        }
        if !str.Equal(rightType, "double") && !str.Equal(rightType, "float") {
            right = emitCastToDouble(cg, right, rightType)
        }
        if str.Equal(op, "+") {
            return emitBinaryOp(cg, "fadd", "double", left, right)
        }
        if str.Equal(op, "-") {
            return emitBinaryOp(cg, "fsub", "double", left, right)
        }
        if str.Equal(op, "*") {
            return emitBinaryOp(cg, "fmul", "double", left, right)
        }
        if str.Equal(op, "/") {
            return emitBinaryOp(cg, "fdiv", "double", left, right)
        }
        if str.Equal(op, "%") {
            return emitBinaryOp(cg, "frem", "double", left, right)
        }
        if str.Equal(op, "==") {
            return emitBinaryOp(cg, "fcmp oeq", "double", left, right)
        }
        if str.Equal(op, "!=") {
            // une (unordered-or-not-equal): NaN != NaN must be true per
            // IEEE 754 — "one" requires ordered operands and wrongly
            // returns false for NaN (comp_error.md #85).
            return emitBinaryOp(cg, "fcmp une", "double", left, right)
        }
        if str.Equal(op, "<") {
            return emitBinaryOp(cg, "fcmp olt", "double", left, right)
        }
        if str.Equal(op, ">") {
            return emitBinaryOp(cg, "fcmp ogt", "double", left, right)
        }
        if str.Equal(op, "<=") {
            return emitBinaryOp(cg, "fcmp ole", "double", left, right)
        }
        if str.Equal(op, ">=") {
            return emitBinaryOp(cg, "fcmp oge", "double", left, right)
        }
    }

    // String comparison: use strcmp for == and != on i8* operands
    // Null-safe: treat NULL as empty string to avoid strcmp crashes
    // BUT: if the other operand is an integer literal (from generic type
    // erasure where int→i8* via inttoptr), use pointer comparison instead.
    if str.Equal(operandType, "i8*") && !isIntegerLiteralExpr(e.infixRight[0]) && !isIntegerLiteralExpr(e.infixLeft[0]) {
        if str.Equal(op, "==") {
            leftNull := nextReg(cg)
            emitfmt(cg, "  %s = icmp eq i8* %s, null\n", []string{leftNull, left})
            leftSafe := nextReg(cg)
            emptyL := emitStringLiteral(cg, "")
            emitfmt(cg, "  %s = select i1 %s, i8* %s, i8* %s\n", []string{leftSafe, leftNull, emptyL, left})
            rightNull := nextReg(cg)
            emitfmt(cg, "  %s = icmp eq i8* %s, null\n", []string{rightNull, right})
            rightSafe := nextReg(cg)
            emptyR := emitStringLiteral(cg, "")
            emitfmt(cg, "  %s = select i1 %s, i8* %s, i8* %s\n", []string{rightSafe, rightNull, emptyR, right})
            cmpReg := nextReg(cg)
            emitfmt(cg, "  %s = call i32 @strcmp(i8* %s, i8* %s)\n", []string{cmpReg, leftSafe, rightSafe})
            r := nextReg(cg)
            emitfmt(cg, "  %s = icmp eq i32 %s, 0\n", []string{r, cmpReg})
            return r
        }
        if str.Equal(op, "!=") {
            leftNull := nextReg(cg)
            emitfmt(cg, "  %s = icmp eq i8* %s, null\n", []string{leftNull, left})
            leftSafe := nextReg(cg)
            emptyL := emitStringLiteral(cg, "")
            emitfmt(cg, "  %s = select i1 %s, i8* %s, i8* %s\n", []string{leftSafe, leftNull, emptyL, left})
            rightNull := nextReg(cg)
            emitfmt(cg, "  %s = icmp eq i8* %s, null\n", []string{rightNull, right})
            rightSafe := nextReg(cg)
            emptyR := emitStringLiteral(cg, "")
            emitfmt(cg, "  %s = select i1 %s, i8* %s, i8* %s\n", []string{rightSafe, rightNull, emptyR, right})
            cmpReg := nextReg(cg)
            emitfmt(cg, "  %s = call i32 @strcmp(i8* %s, i8* %s)\n", []string{cmpReg, leftSafe, rightSafe})
            r := nextReg(cg)
            emitfmt(cg, "  %s = icmp ne i32 %s, 0\n", []string{r, cmpReg})
            return r
        }
        // Relational string comparison via strcmp sign.
        isRel := str.Equal(op, "<") || str.Equal(op, ">") || str.Equal(op, "<=") || str.Equal(op, ">=")
        if isRel {
            leftNull := nextReg(cg)
            emitfmt(cg, "  %s = icmp eq i8* %s, null\n", []string{leftNull, left})
            leftSafe := nextReg(cg)
            emptyL := emitStringLiteral(cg, "")
            emitfmt(cg, "  %s = select i1 %s, i8* %s, i8* %s\n", []string{leftSafe, leftNull, emptyL, left})
            rightNull := nextReg(cg)
            emitfmt(cg, "  %s = icmp eq i8* %s, null\n", []string{rightNull, right})
            rightSafe := nextReg(cg)
            emptyR := emitStringLiteral(cg, "")
            emitfmt(cg, "  %s = select i1 %s, i8* %s, i8* %s\n", []string{rightSafe, rightNull, emptyR, right})
            cmpReg := nextReg(cg)
            emitfmt(cg, "  %s = call i32 @strcmp(i8* %s, i8* %s)\n", []string{cmpReg, leftSafe, rightSafe})
            r := nextReg(cg)
            icmpOp := "slt"
            if str.Equal(op, ">") { icmpOp = "sgt" }
            if str.Equal(op, "<=") { icmpOp = "sle" }
            if str.Equal(op, ">=") { icmpOp = "sge" }
            emitfmt(cg, "  %s = icmp %s i32 %s, 0\n", []string{r, icmpOp, cmpReg})
            return r
        }
    }

    integerType := operandType

    // Integer promotion: if the result type is i64, operate at i64.
    if str.Equal(resultType, "i64") {
        integerType = "i64"
    }

    // Unify integer operand widths: literals and unary exprs emit i32,
    // but narrow operands are i8/i16 (e.g. `i16var == -5` or
    // `i16var + 1`), and mixed widths widen to the operation type
    // (subsumes the old i32→i64 promotion for i64 results).
    if str.StartsWith(integerType, "i") && !str.EndsWith(integerType, "*") {
        leftLL := exprLLType(cg, e.infixLeft[0])
        if str.Equal(leftLL, "") {
            leftLL = "i32"
        }
        if str.StartsWith(leftLL, "i") && !str.EndsWith(leftLL, "*") && !str.Equal(leftLL, integerType) {
            left = coerceExprToParamType(cg, left, leftLL, integerType, e.infixLeft[0])
        }
        rightLL := exprLLType(cg, e.infixRight[0])
        if str.Equal(rightLL, "") {
            rightLL = "i32"
        }
        if str.StartsWith(rightLL, "i") && !str.EndsWith(rightLL, "*") && !str.Equal(rightLL, integerType) {
            right = coerceExprToParamType(cg, right, rightLL, integerType, e.infixRight[0])
        }
    }

    // Generic type erasure: if operandType is i8* but one side is an
    // integer literal (erased from a generic type param), use pointer
    // comparison (icmp eq/ne on i8*) instead of integer ops.
    if str.Equal(integerType, "i8*") && (isIntegerLiteralExpr(e.infixLeft[0]) || isIntegerLiteralExpr(e.infixRight[0])) {
        // Coerce integer literal operands to i8* via inttoptr
        leftCoerced := left
        if isIntegerLiteralExpr(e.infixLeft[0]) {
            leftCoerced = coerceIntLiteralToPtr(cg, left, e.infixLeft[0])
        }
        rightCoerced := right
        if isIntegerLiteralExpr(e.infixRight[0]) {
            rightCoerced = coerceIntLiteralToPtr(cg, right, e.infixRight[0])
        }
        if str.Equal(op, "==") {
            return emitBinaryOp(cg, "icmp eq", "i8*", leftCoerced, rightCoerced)
        }
        if str.Equal(op, "!=") {
            return emitBinaryOp(cg, "icmp ne", "i8*", leftCoerced, rightCoerced)
        }
    }

    // Signedness for integer division/remainder, relational compares,
    // and right shift: LLVM int types carry no sign, so consult the
    // checker's recorded operand types — unsigned if EITHER operand is
    // unsigned (C-style usual arithmetic conversions).
    unsignedOps := exprIsUnsignedInt(cg, e.infixLeft[0]) || exprIsUnsignedInt(cg, e.infixRight[0])

    // Integer arithmetic
    if str.Equal(op, "+") {
        return emitBinaryOp(cg, "add", integerType, left, right)
    }
    if str.Equal(op, "-") {
        return emitBinaryOp(cg, "sub", integerType, left, right)
    }
    if str.Equal(op, "*") {
        return emitBinaryOp(cg, "mul", integerType, left, right)
    }
    if str.Equal(op, "/") {
        if unsignedOps {
            return emitBinaryOp(cg, "udiv", integerType, left, right)
        }
        return emitBinaryOp(cg, "sdiv", integerType, left, right)
    }
    if str.Equal(op, "%") {
        if unsignedOps {
            return emitBinaryOp(cg, "urem", integerType, left, right)
        }
        return emitBinaryOp(cg, "srem", integerType, left, right)
    }

    // Integer comparison
    if str.Equal(op, "==") {
        return emitBinaryOp(cg, "icmp eq", integerType, left, right)
    }
    if str.Equal(op, "!=") {
        return emitBinaryOp(cg, "icmp ne", integerType, left, right)
    }
    if str.Equal(op, "<") {
        if unsignedOps {
            return emitBinaryOp(cg, "icmp ult", integerType, left, right)
        }
        return emitBinaryOp(cg, "icmp slt", integerType, left, right)
    }
    if str.Equal(op, ">") {
        if unsignedOps {
            return emitBinaryOp(cg, "icmp ugt", integerType, left, right)
        }
        return emitBinaryOp(cg, "icmp sgt", integerType, left, right)
    }
    if str.Equal(op, "<=") {
        if unsignedOps {
            return emitBinaryOp(cg, "icmp ule", integerType, left, right)
        }
        return emitBinaryOp(cg, "icmp sle", integerType, left, right)
    }
    if str.Equal(op, ">=") {
        if unsignedOps {
            return emitBinaryOp(cg, "icmp uge", integerType, left, right)
        }
        return emitBinaryOp(cg, "icmp sge", integerType, left, right)
    }

    // Bitwise
    if str.Equal(op, "&") {
        return emitBinaryOp(cg, "and", integerType, left, right)
    }
    if str.Equal(op, "|") {
        return emitBinaryOp(cg, "or", integerType, left, right)
    }
    if str.Equal(op, "^") {
        return emitBinaryOp(cg, "xor", integerType, left, right)
    }
    if str.Equal(op, "<<") {
        return emitBinaryOp(cg, "shl", integerType, left, right)
    }
    if str.Equal(op, ">>") {
        // Unsigned values need a logical shift (zero-fill); signed values
        // need an arithmetic shift to preserve the sign bit.
        if unsignedOps {
            return emitBinaryOp(cg, "lshr", integerType, left, right)
        }
        return emitBinaryOp(cg, "ashr", integerType, left, right)
    }

    return "0"
}

// emitStringConcat emits string concatenation using strlen, malloc, strcpy, strcat.
fn emitStringConcat(cg: *CodeGen, left: string, right: string) -> string {
    // Null-safe strlen: treat NULL as empty string
    leftNull := nextReg(cg)
    emitfmt(cg, "  %s = icmp eq i8* %s, null\n", []string{leftNull, left})
    leftSafe := nextReg(cg)
    emptyL := emitStringLiteral(cg, "")
    emitfmt(cg, "  %s = select i1 %s, i8* %s, i8* %s\n", []string{leftSafe, leftNull, emptyL, left})

    rightNull := nextReg(cg)
    emitfmt(cg, "  %s = icmp eq i8* %s, null\n", []string{rightNull, right})
    rightSafe := nextReg(cg)
    emptyR := emitStringLiteral(cg, "")
    emitfmt(cg, "  %s = select i1 %s, i8* %s, i8* %s\n", []string{rightSafe, rightNull, emptyR, right})

    // len1 = strlen(left)
    len1 := nextReg(cg)
    parts := []string{}
    parts = append(parts, "  ")
    parts = append(parts, len1)
    parts = append(parts, " = call i64 @strlen(i8* ")
    parts = append(parts, leftSafe)
    parts = append(parts, ")")
    emitln(cg, concatMany(parts))

    // len2 = strlen(right)
    len2 := nextReg(cg)
    parts2 := []string{}
    parts2 = append(parts2, "  ")
    parts2 = append(parts2, len2)
    parts2 = append(parts2, " = call i64 @strlen(i8* ")
    parts2 = append(parts2, rightSafe)
    parts2 = append(parts2, ")")
    emitln(cg, concatMany(parts2))

    // totalLen = len1 + len2 + 1
    totalLen := nextReg(cg)
    parts3 := []string{}
    parts3 = append(parts3, "  ")
    parts3 = append(parts3, totalLen)
    parts3 = append(parts3, " = add i64 ")
    parts3 = append(parts3, len1)
    parts3 = append(parts3, ", ")
    parts3 = append(parts3, len2)
    emitln(cg, concatMany(parts3))

    totalLen1 := nextReg(cg)
    parts4 := []string{}
    parts4 = append(parts4, "  ")
    parts4 = append(parts4, totalLen1)
    parts4 = append(parts4, " = add i64 ")
    parts4 = append(parts4, totalLen)
    parts4 = append(parts4, ", 1")
    emitln(cg, concatMany(parts4))

    // buf = Skink_rc_alloc(totalLen1) so the result is refcounted
    buf := nextReg(cg)
    parts5 := []string{}
    parts5 = append(parts5, "  ")
    parts5 = append(parts5, buf)
    parts5 = append(parts5, " = call i8* @Skink_rc_alloc(i64 ")
    parts5 = append(parts5, totalLen1)
    parts5 = append(parts5, ")")
    emitln(cg, concatMany(parts5))

    // strcpy(buf, left)
    parts6 := []string{}
    parts6 = append(parts6, "  call i8* @strcpy(i8* ")
    parts6 = append(parts6, buf)
    parts6 = append(parts6, ", i8* ")
    parts6 = append(parts6, leftSafe)
    parts6 = append(parts6, ")")
    emitln(cg, concatMany(parts6))

    // strcat(buf, right)
    parts7 := []string{}
    parts7 = append(parts7, "  call i8* @strcat(i8* ")
    parts7 = append(parts7, buf)
    parts7 = append(parts7, ", i8* ")
    parts7 = append(parts7, rightSafe)
    parts7 = append(parts7, ")")
    emitln(cg, concatMany(parts7))

    return buf
}

// emitInterpExpr emits code for an interpolated string expression (EX_INTERP).
// It converts each part to a string and concatenates them pairwise.
fn emitInterpExpr(cg: *CodeGen, e: ast.Expr) -> string {
    parts := e.interpParts
    n := len(parts)
    if n == 0 {
        return emitStringLiteral(cg, "")
    }
    // Convert first part to string
    result := emitInterpPart(cg, e, 0)
    // Concatenate remaining parts
    i := 1
    for i < n {
        next := emitInterpPart(cg, e, i)
        result = emitStringConcat(cg, result, next)
        i = i + 1
    }
    return result
}

// emitInterpPart converts a single interpolation part to a string (i8*).
// Part exprs carry fragment-relative positions, so their checker-recorded
// type is looked up under the parent string's position + "#index" (the
// same key checkInterpExpr records with).
fn emitInterpPart(cg: *CodeGen, e: ast.Expr, idx: int) -> string {
    part := e.interpParts[idx]
    if !part.isExpr {
        return emitStringLiteral(cg, part.strVal)
    }
    t := checker.exprTypeLookupAt(cg.checker, cg.currentFilePath, e.line, e.col, idx)
    return emitExprAsStringT(cg, part.expr[0], t)
}

// typeIsUnsignedInt reports whether a checker type is an unsigned
// integer (uint8/16/32/64, uint, byte).
fn typeIsUnsignedInt(t: checker.TType) -> bool {
    if t.kind == checker.TK_BUILTIN || t.kind == checker.TK_NAMED {
        return str.StartsWith(t.name, "uint") || str.Equal(t.name, "byte")
    }
    return false
}

// exprIsUnsignedInt reports whether the expression's checker-recorded
// type is an unsigned integer.
fn exprIsUnsignedInt(cg: *CodeGen, e: ast.Expr) -> bool {
    return typeIsUnsignedInt(checker.exprTypeLookup(cg.checker, cg.currentFilePath, e.line, e.col))
}

// exprSkinkType returns the checker-recorded semantic type for an expression.
// Used when the LLVM type alone is ambiguous (e.g., i8* is shared by strings
// and byte slices).
fn exprSkinkType(cg: *CodeGen, e: ast.Expr) -> checker.TType {
    // Sub-expressions inside string interpolations are parsed from fragment
    // text with line=1, which collides across interpolations in the same
    // file. Local variable bindings in cg carry their exact semantic type
    // in sv.synType, so consult the scope table first for identifiers.
    if e.kind == ast.EX_IDENT {
        sv, ok := lookupVar(cg, e.ident)
        if ok && sv.synType.kind != 0 && sv.synType.kind != checker.TK_UNKNOWN {
            return sv.synType
        }
    }
    if e.line <= 0 {
        return checker.TType{}
    }
    return checker.exprTypeLookup(cg.checker, cg.currentFilePath, e.line, e.col)
}

// typeIsString reports whether a checker type is the builtin string type.
fn typeIsString(t: checker.TType) -> bool {
    return t.kind == checker.TK_BUILTIN && str.Equal(t.name, "string")
}

// typeIsByteSlice reports whether a checker type is a byte slice ([]uint8 or
// []int8). These share the LLVM type i8* with strings, so they must be treated
// as slices (length at offset -8) rather than null-terminated strings.
fn typeIsByteSlice(t: checker.TType) -> bool {
    if t.kind != checker.TK_ARRAY || len(t.elem) == 0 {
        return false
    }
    elem := t.elem[0]
    return elem.kind == checker.TK_BUILTIN &&
        (str.Equal(elem.name, "uint8") || str.Equal(elem.name, "int8"))
}

// exprIsString reports whether the expression's semantic type is string.
fn exprIsString(cg: *CodeGen, e: ast.Expr) -> bool {
    return typeIsString(exprSkinkType(cg, e))
}

// exprIsByteSlice reports whether the expression's semantic type is []uint8
// or []int8.
fn exprIsByteSlice(cg: *CodeGen, e: ast.Expr) -> bool {
    return typeIsByteSlice(exprSkinkType(cg, e))
}

// exprIsSlice reports whether the expression's value is a slice — under the
// fat-slice ABI the register then holds a slice header, and element access
// must unwrap h->data. Raw *T pointers and strings return false.
fn exprIsSlice(cg: *CodeGen, e: ast.Expr) -> bool {
    tt := exprSkinkType(cg, e)
    if tt.kind == checker.TK_NAMED {
        tt = resolveAliasCG(cg, tt)
    }
    return tt.kind == checker.TK_ARRAY
}

// extendNarrowInt widens an i8/i16 register to i32 with the correct
// extension for the value's signedness.
fn extendNarrowInt(cg: *CodeGen, val: string, llType: string, unsigned: bool) -> string {
    r := nextReg(cg)
    if unsigned {
        emitfmt(cg, "  %s = zext %s %s to i32\n", []string{r, llType, val})
    } else {
        emitfmt(cg, "  %s = sext %s %s to i32\n", []string{r, llType, val})
    }
    return r
}

// emitExprAsStringT converts an expression to a string (i8*), using the
// supplied checker type to pick signed vs unsigned extension for narrow
// integers.
fn emitExprAsStringT(cg: *CodeGen, e: ast.Expr, t: checker.TType) -> string {
    val := emitExpression(cg, e)
    llType := exprLLType(cg, e)
    // Narrow ints must be extended and stringified — passing the raw
    // i8/i16 register onward treats it as an i8* and crashes codegen.
    if str.Equal(llType, "i8") || str.Equal(llType, "i16") {
        return emitIntToString(cg, extendNarrowInt(cg, val, llType, typeIsUnsignedInt(t)))
    }
    // Byte slices share the i8* LLVM type with strings. Without the checker
    // type check, emitValAsString returns the raw pointer and the caller
    // strlen()s a non-NUL-terminated buffer — a heap over-read caught by
    // ASAN (comp_error.md #103).
    if str.Equal(llType, "i8*") && typeIsByteSlice(t) {
        return emitArrayToString(cg, val, "i8*", "i8")
    }
    return emitValAsString(cg, val, llType)
}

// emitExprAsString converts an expression to a string (i8*) based on its type.
fn emitExprAsString(cg: *CodeGen, e: ast.Expr) -> string {
    t := checker.exprTypeLookup(cg.checker, cg.currentFilePath, e.line, e.col)
    return emitExprAsStringT(cg, e, t)
}

// emitValAsString converts a value register to a string (i8*) based on its LLVM type.
fn emitValAsString(cg: *CodeGen, val: string, llType: string) -> string {
    if str.Equal(llType, "i8*") {
        return val
    }
    if str.Equal(llType, "i32") {
        return emitIntToString(cg, val)
    }
    if str.Equal(llType, "i8") || str.Equal(llType, "i16") {
        // No expression context here — Skink ints default to signed.
        return emitIntToString(cg, extendNarrowInt(cg, val, llType, false))
    }
    if str.Equal(llType, "i64") {
        return emitInt64ToString(cg, val)
    }
    if str.Equal(llType, "double") {
        return emitFloatToString(cg, val)
    }
    if str.Equal(llType, "i1") {
        trueStr := emitStringLiteral(cg, "true")
        falseStr := emitStringLiteral(cg, "false")
        r := nextReg(cg)
        emitfmt(cg, "  %s = select i1 %s, i8* %s, i8* %s\n", []string{r, val, trueStr, falseStr})
        return r
    }
    if str.EndsWith(llType, "*") {
        elemType := str.Substr(llType, 0, str.Len(llType) - 1)
        return emitArrayToString(cg, val, llType, elemType)
    }
    return val
}

// emitIntToString converts an i32 value to a string using snprintf with "%d".
fn emitIntToString(cg: *CodeGen, val: string) -> string {
    bufReg := emitAlloca(cg, "[32 x i8]")
    ptrReg := nextReg(cg)
    emitfmt(cg, "  %s = getelementptr inbounds [32 x i8], [32 x i8]* %s, i64 0, i64 0\n", []string{ptrReg, bufReg})
    fmtReg := emitStringLiteral(cg, "%d")
    retReg := nextReg(cg)
    emitfmt(cg, "  %s = call i32 (i8*, i64, i8*, ...) @snprintf(i8* %s, i64 32, i8* %s, i32 %s)\n", []string{retReg, ptrReg, fmtReg, val})
    return ptrReg
}

// emitInt64ToString converts an i64 value to a string using snprintf with "%ld".
fn emitInt64ToString(cg: *CodeGen, val: string) -> string {
    bufReg := emitAlloca(cg, "[32 x i8]")
    ptrReg := nextReg(cg)
    emitfmt(cg, "  %s = getelementptr inbounds [32 x i8], [32 x i8]* %s, i64 0, i64 0\n", []string{ptrReg, bufReg})
    fmtReg := emitStringLiteral(cg, "%ld")
    retReg := nextReg(cg)
    emitfmt(cg, "  %s = call i32 (i8*, i64, i8*, ...) @snprintf(i8* %s, i64 32, i8* %s, i64 %s)\n", []string{retReg, ptrReg, fmtReg, val})
    return ptrReg
}

// emitFloatToString converts a double value to a string using snprintf with "%g".
fn emitFloatToString(cg: *CodeGen, val: string) -> string {
    bufReg := emitAlloca(cg, "[64 x i8]")
    ptrReg := nextReg(cg)
    emitfmt(cg, "  %s = getelementptr inbounds [64 x i8], [64 x i8]* %s, i64 0, i64 0\n", []string{ptrReg, bufReg})
    fmtReg := emitStringLiteral(cg, "%g")
    retReg := nextReg(cg)
    emitfmt(cg, "  %s = call i32 (i8*, i64, i8*, ...) @snprintf(i8* %s, i64 64, i8* %s, double %s)\n", []string{retReg, ptrReg, fmtReg, val})
    return ptrReg
}

// emitArrayToString converts an array/slice value to a string like "[1, 2, 3]".
// It iterates over elements, converts each to a string, and joins with ", ".
fn emitArrayToString(cg: *CodeGen, arrVal: string, arrType: string, elemType: string) -> string {
    // Get raw header pointer for null check and length access ([]byte is
    // already i8* — emitI8Ptr elides the invalid same-type bitcast).
    rawPtr := emitI8Ptr(cg, arrVal, arrType)

    // Initialize result with "["
    openBracket := emitStringLiteral(cg, "[")
    resultAlloca := emitAlloca(cg, "i8*")
    emitStore(cg, "i8*", openBracket, "i8*", resultAlloca)

    // Allocate loop counter
    iAlloca := emitAlloca(cg, "i32")
    emitStore(cg, "i32", "0", "i32", iAlloca)

    // Check if array is null
    isNull := nextReg(cg)
    emitfmt(cg, "  %s = icmp eq i8* %s, null\n", []string{isNull, rawPtr})

    nullLabel := nextLabel(cg)
    lenLabel := nextLabel(cg)
    endLabel := nextLabel(cg)
    emitCondBranch(cg, isNull, nullLabel, lenLabel)

    // Null: skip to end (result is "[]")
    emitLabel(cg, nullLabel)
    emitBranch(cg, endLabel)

    // Element count via the runtime — reads the slice header's len.
    emitLabel(cg, lenLabel)
    lenReg := nextReg(cg)
    emitfmt(cg, "  %s = call i64 @Skink_slice_len(i8* %s)\n", []string{lenReg, rawPtr})
    arrData := nextReg(cg)
    emitfmt(cg, "  %s = call i8* @Skink_slice_data(i8* %s)\n", []string{arrData, rawPtr})
    arrDataTyped := emitFromI8Ptr(cg, arrData, str.Concat(elemType, "*"))

    // Check if empty
    isEmpty := nextReg(cg)
    emitfmt(cg, "  %s = icmp eq i64 %s, 0\n", []string{isEmpty, lenReg})
    condLabel := nextLabel(cg)
    emitCondBranch(cg, isEmpty, endLabel, condLabel)

    // Loop condition: i < len
    emitLabel(cg, condLabel)
    iVal := emitLoad(cg, "i32", "i32", iAlloca)
    i64Val := nextReg(cg)
    emitfmt(cg, "  %s = sext i32 %s to i64\n", []string{i64Val, iVal})
    loopCond := nextReg(cg)
    emitfmt(cg, "  %s = icmp slt i64 %s, %s\n", []string{loopCond, i64Val, lenReg})
    bodyLabel := nextLabel(cg)
    emitCondBranch(cg, loopCond, bodyLabel, endLabel)

    // Loop body
    emitLabel(cg, bodyLabel)

    // If not first element, append ", "
    isFirst := nextReg(cg)
    emitfmt(cg, "  %s = icmp eq i32 %s, 0\n", []string{isFirst, iVal})
    sepLabel := nextLabel(cg)
    loadElemLabel := nextLabel(cg)
    emitCondBranch(cg, isFirst, loadElemLabel, sepLabel)

    // Append separator ", "
    emitLabel(cg, sepLabel)
    sepStr := emitStringLiteral(cg, ", ")
    curResult1 := emitLoad(cg, "i8*", "i8*", resultAlloca)
    resultWithSep := emitStringConcat(cg, curResult1, sepStr)
    emitStore(cg, "i8*", resultWithSep, "i8*", resultAlloca)
    emitBranch(cg, loadElemLabel)

    // Load element and convert to string. Under the fat-slice ABI arrVal is
    // a slice header — unwrap its data pointer in lenLabel above.
    emitLabel(cg, loadElemLabel)
    indices := []string{}
    indices = append(indices, iVal)
    elemPtr := emitGEP(cg, elemType, str.Concat(elemType, "*"), arrDataTyped, indices)
    elemVal := emitLoad(cg, elemType, elemType, elemPtr)
    elemStr := emitValAsString(cg, elemVal, elemType)

    // Append element string to result
    curResult2 := emitLoad(cg, "i8*", "i8*", resultAlloca)
    resultNew := emitStringConcat(cg, curResult2, elemStr)
    emitStore(cg, "i8*", resultNew, "i8*", resultAlloca)

    // Increment index and loop back
    iNext := nextReg(cg)
    emitfmt(cg, "  %s = add i32 %s, 1\n", []string{iNext, iVal})
    emitStore(cg, "i32", iNext, "i32", iAlloca)
    emitBranch(cg, condLabel)

    // End: append "]" to result
    emitLabel(cg, endLabel)
    finalResult := emitLoad(cg, "i8*", "i8*", resultAlloca)
    closeBracket := emitStringLiteral(cg, "]")
    return emitStringConcat(cg, finalResult, closeBracket)
}

// emitCallExpr handles function calls.
fn emitCallExpr(cg: *CodeGen, e: ast.Expr) -> string {
    fnExpr := e.callFunc[0]

    // Handle direct function name calls
    if fnExpr.kind == ast.EX_IDENT {
        fnName := resolveDirectFnName(cg, fnExpr.ident)

        // Check for builtins
        if str.Equal(fnName, "len") {
            return emitLenCall(cg, e)
        }
        if str.Equal(fnName, "println") || str.Equal(fnName, "print") {
            return emitPrintCall(cg, e, str.Equal(fnName, "println"))
        }
        if str.Equal(fnName, "append") {
            return emitAppendCall(cg, e)
        }
        if str.Equal(fnName, "copy") {
            return emitCopyCall(cg, e)
        }
        if str.Equal(fnName, "delete") {
            return emitDeleteCall(cg, e)
        }
        if str.Equal(fnName, "panic") {
            return emitPanicCall(cg, e)
        }
        if str.Equal(fnName, "assert") && len(e.callArgs) > 0 {
            condReg := emitExpression(cg, e.callArgs[0])
            failLabel := nextLabel(cg)
            okLabel := nextLabel(cg)
            cmpReg := nextReg(cg)
            emitfmt(cg, "  %s = icmp eq i1 %s, 0\n", []string{cmpReg, condReg})
            emitCondBranch(cg, cmpReg, failLabel, okLabel)
            emitLabel(cg, failLabel)
            assertMsg := emitStringLiteral(cg, "assertion failed")
            emitfmt(cg, "  call void @Skink_panic(i8* %s)\n", []string{assertMsg})
            emitLabel(cg, okLabel)
            return ""
        }
        if str.Equal(fnName, "recover") {
            r := nextReg(cg)
            emitfmt(cg, "  %s = call i8* @Skink_panic_recover()\n", []string{r})
            return r
        }
        // Tagged-union constructor: Variant(payloads...)
        if mapStringDeclHasKeyTU2(cg.tuVariantDecl, fnName) {
            d2 := cg.tuVariantDecl[fnName]
            vidx2 := cg.tuVariantIdx[fnName]
            if len(d2.enumVariants[vidx2].payloads) > 0 {
                return emitTUCtor(cg, fnName, e.callArgs)
            }
        }
        if str.Equal(fnName, "close") && len(e.callArgs) > 0 {
            chReg := emitExpression(cg, e.callArgs[0])
            // Channels are opaque i8* handles
            chReg = coerceExprToParamType(cg, chReg, exprLLType(cg, e.callArgs[0]), "i8*", e.callArgs[0])
            emitfmt(cg, "  call void @Skink_chan_close(i8* %s)\n", []string{chReg})
            return ""
        }

        // Type casts
        if str.Equal(fnName, "int") || str.Equal(fnName, "uint") || str.Equal(fnName, "int32") || str.Equal(fnName, "uint32") {
            return emitCast(cg, e.callArgs[0], "i32")
        }
        if str.Equal(fnName, "int8") || str.Equal(fnName, "uint8") {
            return emitCast(cg, e.callArgs[0], "i8")
        }
        if str.Equal(fnName, "int16") || str.Equal(fnName, "uint16") {
            return emitCast(cg, e.callArgs[0], "i16")
        }
        if str.Equal(fnName, "int64") || str.Equal(fnName, "uint64") {
            return emitCast(cg, e.callArgs[0], "i64")
        }
        if str.Equal(fnName, "float") {
            return emitCast(cg, e.callArgs[0], "double")
        }
        if str.Equal(fnName, "bool") {
            return emitCast(cg, e.callArgs[0], "i1")
        }
        if str.Equal(fnName, "string") {
            return emitCastToString(cg, e.callArgs[0])
        }

        // Math builtins: sin, cos, tan, sqrt (1 arg -> double)
        if (str.Equal(fnName, "sin") || str.Equal(fnName, "cos") || str.Equal(fnName, "tan") || str.Equal(fnName, "sqrt")) && len(e.callArgs) == 1 {
            valReg := emitExpression(cg, e.callArgs[0])
            valReg = coerceExprToParamType(cg, valReg, exprLLType(cg, e.callArgs[0]), "double", e.callArgs[0])
            reg := nextReg(cg)
            emitfmt(cg, "  %s = call double @%s(double %s)\n", []string{reg, fnName, valReg})
            return reg
        }
        // Math builtin: pow (2 args -> double)
        if str.Equal(fnName, "pow") && len(e.callArgs) == 2 {
            xReg := emitExpression(cg, e.callArgs[0])
            yReg := emitExpression(cg, e.callArgs[1])
            xReg = coerceExprToParamType(cg, xReg, exprLLType(cg, e.callArgs[0]), "double", e.callArgs[0])
            yReg = coerceExprToParamType(cg, yReg, exprLLType(cg, e.callArgs[1]), "double", e.callArgs[1])
            reg := nextReg(cg)
            emitfmt(cg, "  %s = call double @pow(double %s, double %s)\n", []string{reg, xReg, yReg})
            return reg
        }
        // Math builtins: dot(a, b) and norm(v) on []float slices.
        // Slice length lives in the RC header at payload-8 (element count).
        if str.Equal(fnName, "dot") && len(e.callArgs) == 2 {
            aReg := emitExpression(cg, e.callArgs[0])
            bReg := emitExpression(cg, e.callArgs[1])
            aCast := nextReg(cg)
            emitfmt(cg, "  %s = bitcast %s %s to i8*\n", []string{aCast, exprLLType(cg, e.callArgs[0]), aReg})
            bCast := nextReg(cg)
            emitfmt(cg, "  %s = bitcast %s %s to i8*\n", []string{bCast, exprLLType(cg, e.callArgs[1]), bReg})
            reg := nextReg(cg)
            emitfmt(cg, "  %s = call double @Skink_vec_dot(i8* %s, i8* %s)\n", []string{reg, aCast, bCast})
            return reg
        }
        if str.Equal(fnName, "norm") && len(e.callArgs) == 1 {
            vReg := emitExpression(cg, e.callArgs[0])
            vCast := nextReg(cg)
            emitfmt(cg, "  %s = bitcast %s %s to i8*\n", []string{vCast, exprLLType(cg, e.callArgs[0]), vReg})
            reg := nextReg(cg)
            emitfmt(cg, "  %s = call double @Skink_vec_norm(i8* %s)\n", []string{reg, vCast})
            return reg
        }

        // A local variable holding a function value shadows any function
        // of the same name — check scopeVars before resolving @<name>.
        sv, isVar := lookupVar(cg, fnExpr.ident)
        if isVar {
            ft := sv.synType
            if ft.kind == 0 || ft.kind == checker.TK_UNKNOWN {
                ft = exprSkinkType(cg, fnExpr)
            }
            if ft.kind == checker.TK_NAMED {
                ft = resolveAliasCG(cg, ft)
            }
            if ft.kind == checker.TK_FUNCTION {
                retType, cparams := closureCallTypes(cg, ft)
                args := []string{}
                i := 0
                for i < len(e.callArgs) {
                    argReg := emitExpression(cg, e.callArgs[i])
                    argType := exprLLType(cg, e.callArgs[i])
                    if i < len(cparams) {
                        expected := cparams[i]
                        argReg = coerceExprToParamType(cg, argReg, argType, expected, e.callArgs[i])
                        argType = expected
                    }
                    args = append(args, str.Concat(argType, str.Concat(" ", argReg)))
                    i = i + 1
                }
                handleReg := emitLoad(cg, "i8*", "i8*", varValuePtr(cg, sv))
                return emitClosureCall(cg, retType, cparams, handleReg, args)
            }
        }

        // Regular function call
        hasFn := mapStringStringSliceHasKeyCG(cg.fnRetTypes, fnName)

        if !hasFn {
            // A module-level variable holding a function value is not in
            // scopeVars — check the global table for a closure handle.
            hasGvt := mapStringStringHasKeyCG(cg.globalVarTypes, fnExpr.ident)
            if hasGvt {
                ft := exprSkinkType(cg, fnExpr)
                if ft.kind == checker.TK_NAMED {
                    ft = resolveAliasCG(cg, ft)
                }
                if ft.kind == checker.TK_FUNCTION {
                    retType, cparams := closureCallTypes(cg, ft)
                    gvt := cg.globalVarTypes[fnExpr.ident]
                    handleReg := emitLoad(cg, gvt, gvt, str.Concat("@", fnExpr.ident))
                    args := []string{}
                    i := 0
                    for i < len(e.callArgs) {
                        argReg := emitExpression(cg, e.callArgs[i])
                        argType := exprLLType(cg, e.callArgs[i])
                        if i < len(cparams) {
                            expected := cparams[i]
                            argReg = coerceExprToParamType(cg, argReg, argType, expected, e.callArgs[i])
                            argType = expected
                        }
                        args = append(args, str.Concat(argType, str.Concat(" ", argReg)))
                        i = i + 1
                    }
                    return emitClosureCall(cg, retType, cparams, handleReg, args)
                }
            }
        }

        retType := "void"
        if hasFn && len(cg.fnRetTypes[fnName]) > 0 {
            if len(cg.fnRetTypes[fnName]) > 1 {
                retType = aggregateRetType(cg.fnRetTypes[fnName])
            } else {
                retType = cg.fnRetTypes[fnName][0]
            }
        }

        // Emit arguments
        args := []string{}
        i := 0
        for i < len(e.callArgs) {
            // If the argument is a variable whose storage the callee can
            // write through (composite-by-value ABI pointers and explicit
            // multi-level pointers), mark it borrowed so it won't be
            // released at scope exit. That is only true when the variable
            // itself is a by-value composite (%struct.X, %map_*, %set.*):
            // the ABI passes &var, so callee field writes mutate the
            // caller's variable directly. Pointer-typed vars (*T, i8**,
            // map/set handles — all ending in "*") pass their value by
            // copy: the callee borrows the pointee, the caller still owns
            // the variable, and suppressing its scope release leaks it
            // (comp_error.md #100).
            hasParams := mapStringStringSliceHasKeyCG(cg.fnParamTypes, fnName)
            if hasParams && i < len(cg.fnParamTypes[fnName]) {
                expected := cg.fnParamTypes[fnName][i]
                if str.EndsWith(expected, "*") && !str.Equal(expected, "i8*") &&
                   e.callArgs[i].kind == ast.EX_IDENT {
                    argSV, argOK := lookupVar(cg, e.callArgs[i].ident)
                    if argOK && !str.EndsWith(argSV.llType, "*") {
                        markBorrowed(cg, e.callArgs[i].ident)
                    }
                }
            }
            argReg := emitExpression(cg, e.callArgs[i])
            // Determine arg type from the expression's inferred type
            argType := exprLLType(cg, e.callArgs[i])
            // Fall back to function's declared param type
            if hasParams && i < len(cg.fnParamTypes[fnName]) {
                expected := cg.fnParamTypes[fnName][i]
                argReg = coerceExprToParamType(cg, argReg, argType, expected, e.callArgs[i])
                argType = expected
            }
            args = append(args, str.Concat(argType, str.Concat(" ", argReg)))
            i = i + 1
        }

        // Generic calls erase params/results to i8*; convert the raw
        // result back to the checker's substituted concrete type.
        return coerceGenericCallResult(cg, e, emitCall(cg, retType, fnName, args), retType)
    }

    // Method calls (field access)
    if fnExpr.kind == ast.EX_FIELD {
        // Special handling for reflect.TypeOf<T>(arg): generate type info inline
        if str.Equal(fnExpr.fieldName, "TypeOf") && len(e.genericArgs) > 0 {
            recvName := ""
            if fnExpr.fieldTarget[0].kind == ast.EX_IDENT {
                recvName = fnExpr.fieldTarget[0].ident
            }
            if str.Equal(recvName, "reflect") {
                return emitReflectTypeOf(cg, e)
            }
        }
        return emitMethodCall(cg, e)
    }

    // Indirect call through a function value expression (e.g. tests[i](),
    // or an immediately-invoked literal `defer fn(){...}()`). Function
    // values are i8* closure handles; the callee type comes from the
    // checker's recorded expression type.
    ft := exprSkinkType(cg, fnExpr)
    if (ft.kind == 0 || ft.kind == checker.TK_UNKNOWN) && fnExpr.kind == ast.EX_FN_LIT {
        // Literals are not always recorded in the expression-type table;
        // build the function type from the literal's own signature.
        var litParams []checker.TType
        for li := 0; li < len(fnExpr.fnLitParams); li = li + 1 {
            var litPt checker.TType
            litPt = checker.unknownType()
            if len(fnExpr.fnLitParams[li].typ) > 0 {
                litPt = checker.astTypeToType(cg.checker, fnExpr.fnLitParams[li].typ[0])
            }
            litParams = append(litParams, litPt)
        }
        var litRets []checker.TType
        for li := 0; li < len(fnExpr.fnLitRetTypes); li = li + 1 {
            litRets = append(litRets, checker.astTypeToType(cg.checker, fnExpr.fnLitRetTypes[li]))
        }
        if len(litRets) == 0 {
            litRets = append(litRets, checker.builtinType("void"))
        }
        ft = checker.functionType(litParams, litRets)
    }
    if ft.kind == checker.TK_NAMED {
        ft = resolveAliasCG(cg, ft)
    }
    if ft.kind == checker.TK_FUNCTION {
        retType, cparams := closureCallTypes(cg, ft)
        handleReg := emitExpression(cg, fnExpr)
        args := []string{}
        i := 0
        for i < len(e.callArgs) {
            argReg := emitExpression(cg, e.callArgs[i])
            argType := exprLLType(cg, e.callArgs[i])
            if i < len(cparams) {
                expected := cparams[i]
                argReg = coerceExprToParamType(cg, argReg, argType, expected, e.callArgs[i])
                argType = expected
            }
            args = append(args, str.Concat(argType, str.Concat(" ", argReg)))
            i = i + 1
        }
        return emitClosureCall(cg, retType, cparams, handleReg, args)
    }

    return "0"
}

// parseFnPtrRetType extracts the return type from an LLVM function pointer
// type string like "void ()*" -> "void" or "i32 (i32, i8*)*" -> "i32".
// Also handles nested function pointer return types like
// "void (...)* (void (...)*)*" -> "void (...)*".
fn parseFnPtrRetType(fnPtrLL: string) -> string {
    // Strip the trailing pointer indicator "*".
    inner := fnPtrLL
    if str.EndsWith(inner, "*") {
        inner = str.Substr(inner, 0, str.Len(inner) - 1)
    }
    // Find the last ")" which closes the parameter list.
    lastClose := str.LastIndexOf(inner, ")")
    if lastClose < 0 {
        return "void"
    }
    // Scan backwards to find the matching "(".
    depth := 0
    i := lastClose
    for i >= 0 {
        ch := inner[i]
        if ch == 41 { // ')'
            depth = depth + 1
        } else if ch == 40 { // '('
            depth = depth - 1
            if depth == 0 {
                // Everything before this "(" is the return type.
                // Skip the space before "(".
                retEnd := i
                if retEnd > 0 && inner[retEnd - 1] == 32 { // space
                    retEnd = retEnd - 1
                }
                return str.Substr(inner, 0, retEnd)
            }
        }
        i = i - 1
    }
    // Fallback: find the first " (" which separates the return type from params
    parenIdx := str.IndexOf(fnPtrLL, " (")
    if parenIdx < 0 {
        return "void"
    }
    return str.Substr(fnPtrLL, 0, parenIdx)
}

// parseFnPtrParamTypes extracts the parameter types from an LLVM function
// pointer type string like "i32 (i32, i8*)*" -> ["i32", "i8*"].
// Also handles nested function pointer return types.
fn parseFnPtrParamTypes(fnPtrLL: string) -> []string {
    result := []string{}
    // Use parseFnPtrRetType to find the return type, then skip past it
    // to find the parameter list opening paren.
    retType := parseFnPtrRetType(fnPtrLL)
    retEnd := str.Len(retType)
    // Skip the space after the return type
    if retEnd < str.Len(fnPtrLL) && fnPtrLL[retEnd] == 32 {
        retEnd = retEnd + 1
    }
    // Now fnPtrLL[retEnd] should be '('
    if retEnd >= str.Len(fnPtrLL) || fnPtrLL[retEnd] != 40 {
        return result
    }
    openParen := retEnd
    closeParen := str.LastIndexOf(fnPtrLL, ")")
    if closeParen < 0 || closeParen <= openParen {
        return result
    }
    // Extract the content between parentheses
    inner := str.Substr(fnPtrLL, openParen + 1, closeParen - openParen - 1)
    inner = str.Trim(inner)
    if str.Len(inner) == 0 {
        return result
    }
    // Split by ", " but respect parenthesis depth (don't split inside
    // nested function pointer types like "void (i32, i8*)*").
    parts := []string{}
    depth := 0
    start := 0
    i := 0
    for i < str.Len(inner) {
        ch := inner[i]
        if ch == 40 { // '('
            depth = depth + 1
        } else if ch == 41 { // ')'
            depth = depth - 1
        } else if ch == 44 && depth == 0 { // ',' at depth 0
            // Check if followed by space
            seg := str.Trim(str.Substr(inner, start, i - start))
            if str.Len(seg) > 0 {
                parts = append(parts, seg)
            }
            start = i + 1
            if start < str.Len(inner) && inner[start] == 32 {
                start = start + 1
            }
        }
        i = i + 1
    }
    // Add the last segment
    seg := str.Trim(str.Substr(inner, start, str.Len(inner) - start))
    if str.Len(seg) > 0 {
        parts = append(parts, seg)
    }
    i = 0
    for i < len(parts) {
        t := str.Trim(parts[i])
        if str.Len(t) > 0 {
            result = append(result, t)
        }
        i = i + 1
    }
    return result
}

// emitCast emits an LLVM conversion instruction for a type cast.
// emitCastToDouble converts an integer LLVM register to double
fn emitCastToDouble(cg: *CodeGen, reg: string, srcType: string) -> string {
    if str.Equal(srcType, "double") || str.Equal(srcType, "float") {
        return reg
    }
    result := nextReg(cg)
    if str.Equal(srcType, "i1") {
        emitfmt(cg, "  %s = uitofp i1 %s to double\n", []string{result, reg})
    } else if str.Equal(srcType, "i8") {
        emitfmt(cg, "  %s = sitofp i8 %s to double\n", []string{result, reg})
    } else if str.Equal(srcType, "i16") {
        emitfmt(cg, "  %s = sitofp i16 %s to double\n", []string{result, reg})
    } else if str.Equal(srcType, "i32") {
        emitfmt(cg, "  %s = sitofp i32 %s to double\n", []string{result, reg})
    } else if str.Equal(srcType, "i64") {
        emitfmt(cg, "  %s = sitofp i64 %s to double\n", []string{result, reg})
    } else {
        // Default: assume i32
        emitfmt(cg, "  %s = sitofp i32 %s to double\n", []string{result, reg})
    }
    return result
}

// intLitToI64String converts a raw integer literal token to the decimal
// string LLVM IR requires. Decimal literals pass through, but 0x/0b/0o
// prefixed literals are re-emitted in decimal — LLVM IR treats a leading
// `0x` as a hexadecimal *floating-point* constant, so `0x0f` in an `and`
// is rejected by Clang (comp_error.md #44). '_' digit separators are also
// stripped since LLVM does not accept them either.
fn intLitToI64String(s: string) -> string {
    n := str.Len(s)
    i := 0
    neg := false
    if n > 0 && s[0] == 45 { // '-'
        neg = true
        i = 1
    }
    if i + 2 <= n && s[i] == 48 { // '0'
        p := s[i + 1]
        base := int64(0)
        if p == 120 || p == 88 { base = int64(16) } // x/X
        if p == 98 || p == 66 { base = int64(2) }   // b/B
        if p == 111 || p == 79 { base = int64(8) }  // o/O
        if base != int64(0) {
            v := int64(0)
            i = i + 2
            for i < n {
                c := s[i]
                if c != 95 { // '_'
                    d := int64(0)
                    if c >= 48 && c <= 57 {
                        d = int64(c - 48)
                    } else if c >= 97 && c <= 102 {
                        d = int64(c - 87)
                    } else if c >= 65 && c <= 70 {
                        d = int64(c - 55)
                    }
                    v = v * base + d
                }
                i = i + 1
            }
            if neg {
                v = -v
            }
            return strconv.Itoa64(v)
        }
    }
    if str.Contains(s, "_") {
        return str.Replace(s, "_", "")
    }
    return s
}

// emitCast emits a type cast expression, converting to the target LLVM type.
fn emitCast(cg: *CodeGen, expr: ast.Expr, targetType: string) -> string {
    // For integer literals being cast to i64, emit the literal directly to
    // avoid overflow when the value exceeds i32 range — but normalize the
    // raw text to decimal first (#44).
    if expr.kind == ast.EX_INT && str.Equal(targetType, "i64") && str.Len(expr.strVal) > 0 {
        return intLitToI64String(expr.strVal)
    }
    // Unary minus over an int literal parses as PrefixExpr(-, IntLit), so
    // it never reaches the raw-strVal path above — int64(-N) for N > i32
    // range emitted the truncated i32 magnitude negated (#121). Fold the
    // sign into the raw literal instead: intLitToI64String already handles
    // a leading '-', including over 0x/0b/0o and '_' digit separators.
    if expr.kind == ast.EX_PREFIX && str.Equal(targetType, "i64") && len(expr.prefixRight) > 0 {
        inner := expr.prefixRight[0]
        if inner.kind == ast.EX_INT && str.Len(inner.strVal) > 0 && str.Equal(expr.prefixOp, "-") {
            return intLitToI64String(str.Concat("-", inner.strVal))
        }
    }
    operand := emitExpression(cg, expr)
    srcType := exprLLType(cg, expr)
    reg := nextReg(cg)

    if str.Equal(srcType, targetType) {
        return operand
    }
    if str.Equal(srcType, "i1") && str.Equal(targetType, "double") {
        emitfmt(cg, "  %s = uitofp i1 %s to double\n", []string{reg, operand})
        return reg
    }
    if str.Equal(srcType, "double") && str.Equal(targetType, "i1") {
        // une so NaN is truthy (NaN != 0.0 is true — comp_error.md #85).
        emitfmt(cg, "  %s = fcmp une double %s, 0.0\n", []string{reg, operand})
        return reg
    }
    if str.StartsWith(srcType, "i") && str.Equal(targetType, "double") {
        emitfmt(cg, "  %s = sitofp %s %s to double\n", []string{reg, srcType, operand})
        return reg
    }
    if str.Equal(srcType, "double") && str.StartsWith(targetType, "i") {
        emitfmt(cg, "  %s = fptosi double %s to %s\n", []string{reg, operand, targetType})
        return reg
    }
    if str.Equal(srcType, "i1") && str.Equal(targetType, "i32") {
        emitfmt(cg, "  %s = zext i1 %s to i32\n", []string{reg, operand})
        return reg
    }
    if str.Equal(srcType, "i32") && str.Equal(targetType, "i1") {
        emitfmt(cg, "  %s = icmp ne i32 %s, 0\n", []string{reg, operand})
        return reg
    }
    if str.EndsWith(srcType, "*") && str.EndsWith(targetType, "*") {
        emitfmt(cg, "  %s = bitcast %s %s to %s\n", []string{reg, srcType, operand, targetType})
        return reg
    }
    if str.EndsWith(srcType, "*") && (str.Equal(targetType, "i32") || str.Equal(targetType, "i64")) {
        emitfmt(cg, "  %s = ptrtoint %s %s to %s\n", []string{reg, srcType, operand, targetType})
        return reg
    }
    if (str.Equal(srcType, "i32") || str.Equal(srcType, "i64")) && str.EndsWith(targetType, "*") {
        emitfmt(cg, "  %s = inttoptr %s %s to %s\n", []string{reg, srcType, operand, targetType})
        return reg
    }
    if str.StartsWith(srcType, "i") && str.StartsWith(targetType, "i") {
        srcBits := str.Substr(srcType, 1, str.Len(srcType) - 1)
        targetBits := str.Substr(targetType, 1, str.Len(targetType) - 1)
        if str.Equal(srcBits, targetBits) {
            return operand
        }
        sb, _ := strconv.ParseInt(srcBits)
        tb, _ := strconv.ParseInt(targetBits)
        if sb > tb {
            emitfmt(cg, "  %s = trunc %s %s to %s\n", []string{reg, srcType, operand, targetType})
        } else {
            // Widen with zext for unsigned/bool sources, sext for signed —
            // int(uint8(250)) must yield 250, not -6.
            if str.Equal(srcType, "i1") || exprIsUnsignedInt(cg, expr) {
                emitfmt(cg, "  %s = zext %s %s to %s\n", []string{reg, srcType, operand, targetType})
            } else {
                emitfmt(cg, "  %s = sext %s %s to %s\n", []string{reg, srcType, operand, targetType})
            }
        }
        return reg
    }
    // Unsupported cast pair: report a compile error instead of
    // returning the operand with a mismatched type (which produces
    // invalid LLVM IR downstream).
    errorf(cg, str.Concat(str.Concat("cannot cast ", srcType), str.Concat(" to ", targetType)))
    return operand
}

// emitCastToString converts an int or float to a string.
fn emitCastToString(cg: *CodeGen, expr: ast.Expr) -> string {
    srcType := exprLLType(cg, expr)
    operand := emitExpression(cg, expr)
    // Narrow ints must be widened to i32 before stringification — the
    // i32 case below handles the conversion, and leaving an i8/i16
    // register here would fall through and be treated as an i8*.
    if str.Equal(srcType, "i8") || str.Equal(srcType, "i16") {
        operand = extendNarrowInt(cg, operand, srcType, exprIsUnsignedInt(cg, expr))
        srcType = "i32"
    }
    if str.Equal(srcType, "i32") {
        fmtReg := emitStringLiteral(cg, "%d")
        bufReg := nextReg(cg)
        emitfmt(cg, "  %s = alloca [32 x i8]\n", []string{bufReg})
        ptrReg := nextReg(cg)
        emitfmt(cg, "  %s = getelementptr inbounds [32 x i8], [32 x i8]* %s, i64 0, i64 0\n", []string{ptrReg, bufReg})
        retReg := nextReg(cg)
        emitfmt(cg, "  %s = call i32 (i8*, ...) @sprintf(i8* %s, i8* %s, i32 %s)\n", []string{retReg, ptrReg, fmtReg, operand})
        return ptrReg
    }
    if str.Equal(srcType, "double") {
        fmtReg := emitStringLiteral(cg, "%f")
        bufReg := nextReg(cg)
        emitfmt(cg, "  %s = alloca [32 x i8]\n", []string{bufReg})
        ptrReg := nextReg(cg)
        emitfmt(cg, "  %s = getelementptr inbounds [32 x i8], [32 x i8]* %s, i64 0, i64 0\n", []string{ptrReg, bufReg})
        retReg := nextReg(cg)
        emitfmt(cg, "  %s = call i32 (i8*, ...) @sprintf(i8* %s, i8* %s, double %s)\n", []string{retReg, ptrReg, fmtReg, operand})
        return ptrReg
    }
    if str.Equal(srcType, "i32") || str.Equal(srcType, "i64") {
        ptrReg := nextReg(cg)
        emitfmt(cg, "  %s = inttoptr %s %s to i8*\n", []string{ptrReg, srcType, operand})
        return ptrReg
    }
    if str.Equal(srcType, "i8*") {
        // A byte slice operand is a slice header under the fat-slice ABI —
        // string(b) must materialize h->data into a NUL-terminated copy.
        if exprIsByteSlice(cg, expr) {
            convReg := nextReg(cg)
            emitfmt(cg, "  %s = call i8* @Skink_str_from_slice(i8* %s)\n", []string{convReg, operand})
            return convReg
        }
        return operand
    }
    return operand
}

// emitIfExpr emits an if expression that returns a value.
fn emitIfExpr(cg: *CodeGen, e: ast.Expr) -> string {
    resultType := exprLLType(cg, e)
    if str.Equal(resultType, "") {
        resultType = "i32"
    }
    resultAlloca := emitAlloca(cg, resultType)

    condVal := emitExpression(cg, e.ifCond[0])
    thenLabel := nextLabel(cg)
    elseLabel := nextLabel(cg)
    mergeLabel := nextLabel(cg)

    emitCondBranch(cg, condVal, thenLabel, elseLabel)

    emitLabel(cg, thenLabel)
    cg.terminated = false
    pushScope(cg)
    thenVal := emitExpression(cg, e.ifThen[0])
    // The result alloca must own a reference that survives the arm
    // scope's cleanup (which releases any temporaries produced by the
    // arm expression).
    thenType := exprLLType(cg, e.ifThen[0])
    if isHeapLLType(thenType) {
        thenVal = emitRetain(cg, thenVal, thenType)
    } else if isCompositeType(thenType) && !str.EndsWith(thenType, "*") {
        thenVal = emitRetainStructHeapFields(cg, thenVal, thenType)
    }
    emitStore(cg, resultType, thenVal, resultType, resultAlloca)
    popScope(cg)
    emitBranch(cg, mergeLabel)

    emitLabel(cg, elseLabel)
    cg.terminated = false
    pushScope(cg)
    if len(e.ifElse) > 0 {
        elseVal := emitExpression(cg, e.ifElse[0])
        elseType := exprLLType(cg, e.ifElse[0])
        if isHeapLLType(elseType) {
            elseVal = emitRetain(cg, elseVal, elseType)
        } else if isCompositeType(elseType) && !str.EndsWith(elseType, "*") {
            elseVal = emitRetainStructHeapFields(cg, elseVal, elseType)
        }
        emitStore(cg, resultType, elseVal, resultType, resultAlloca)
    } else {
        emitStore(cg, resultType, zeroValueForLLType(resultType), resultType, resultAlloca)
    }
    popScope(cg)
    emitBranch(cg, mergeLabel)

    emitLabel(cg, mergeLabel)
    resultReg := nextReg(cg)
    emitfmt(cg, "  %s = load %s, %s* %s\n", []string{resultReg, resultType, resultType, resultAlloca})
    return resultReg
}

// matchExprResultLLType infers the LLVM result type of a match expression
// from the first arm's body (mirrors matchArmLLType in the Go compiler).
// Tagged unions / variant patterns with payload bindings are not yet
// supported by the self-hosted emitter (not needed by the current
// bootstrap corpus), so only the plain literal/ident pattern case is
// handled here.
fn matchExprResultLLType(cg: *CodeGen, e: ast.Expr) -> string {
    // Prefer the checker's recorded result type — arm bodies may
    // reference pattern-bound variables that aren't in scope here.
    key := str.Concat(strconv.Itoa(e.line), str.Concat(":", strconv.Itoa(e.col)))
    // NOTE: access via a local — the bootstrap compiler mis-emits the
    // receiver address for `cg.checker.matchResultTypes` (pointer field
    // treated as inline struct; comp_error.md #32). Going through an
    // ident takes the correct load path.
    ch := cg.checker
    rt := ch.matchResultTypes.Get(key)
    if ch.matchResultTypes.Has(key) && rt.kind != checker.TK_UNKNOWN {
        return llvmType(cg, rt)
    }
    if len(e.matchExprArms) == 0 {
        return "i32"
    }
    arm := e.matchExprArms[0]
    if len(arm.body) == 0 {
        return "i32"
    }
    last := arm.body[len(arm.body) - 1]
    if last.kind == ast.ST_EXPR && len(last.expr) > 0 {
        return exprLLType(cg, last.expr[0])
    }
    return "i32"
}

// emitPatternValue emits the value of a simple (non-variant) match pattern,
// for comparison against the match subject.
fn emitPatternValue(cg: *CodeGen, pat: ast.Pattern) -> string {
    if pat.kind == ast.PK_INT {
        return strconv.Itoa(pat.intVal)
    }
    if pat.kind == ast.PK_STRING {
        return emitStringLiteral(cg, pat.strVal)
    }
    if pat.kind == ast.PK_BOOL {
        if pat.boolVal {
            return "1"
        }
        return "0"
    }
    if pat.kind == ast.PK_NIL {
        return "null"
    }
    if pat.kind == ast.PK_IDENT {
        identExpr := ast.Expr{kind: ast.EX_IDENT, ident: pat.identName}
        return emitExpression(cg, identExpr)
    }
    return "0"
}

// emitMatchArmBody emits a match arm's body, storing the value of the final
// expression statement (if any) into resultAlloca, mirroring
// emitIfBranchBlock in the Go compiler.
fn emitMatchArmBody(cg: *CodeGen, body: []ast.Stmt, resultAlloca: string, resultType: string) {
    if len(body) == 0 {
        return
    }
    i := 0
    for i < len(body) - 1 {
        if cg.terminated {
            return
        }
        emitStatement(cg, body[i])
        i = i + 1
    }
    if cg.terminated {
        return
    }
    last := body[len(body) - 1]
    if last.kind == ast.ST_EXPR && len(last.expr) > 0 && !str.Equal(resultType, "void") {
        valReg := emitExpression(cg, last.expr[0])
        valType := exprLLType(cg, last.expr[0])
        if str.Equal(resultType, "i32") && str.Equal(valType, "i1") {
            zext := nextReg(cg)
            emitfmt(cg, "  %s = zext i1 %s to i32\n", []string{zext, valReg})
            valReg = zext
        }
        // The result alloca must own a reference that survives arm-scope
        // cleanup of temporaries produced by the arm expression.
        if isHeapLLType(valType) {
            valReg = emitRetain(cg, valReg, valType)
        } else if isCompositeType(valType) && !str.EndsWith(valType, "*") {
            valReg = emitRetainStructHeapFields(cg, valReg, valType)
        }
        emitStore(cg, resultType, valReg, resultType, resultAlloca)
        return
    }
    // Trailing `if cond { expr } else { expr }` used in value position:
    // each branch's final expression stores into the result alloca.
    if last.kind == ast.ST_IF && !str.Equal(resultType, "void") {
        emitIfValueStmt(cg, last, resultAlloca, resultType)
        return
    }
    emitStatement(cg, last)
}

// emitIfValueStmt emits an if/else statement in value position: the last
// statement of each branch is an expression whose value is stored into
// resultAlloca. Used for match-arm bodies like:
//   if sq > 0.0 { sqrt(sq) } else { 0.0 }
fn emitIfValueStmt(cg: *CodeGen, stmt: ast.Stmt, resultAlloca: string, resultType: string) {
    pushScope(cg)
    if len(stmt.ifInit) > 0 {
        emitStatement(cg, stmt.ifInit[0])
    }
    condReg := emitExpression(cg, stmt.cond[0])
    trueLabel := nextLabel(cg)
    falseLabel := nextLabel(cg)
    endLabel := nextLabel(cg)
    hasElse := len(stmt.elseBody) > 0
    if !hasElse {
        emitCondBranch(cg, condReg, trueLabel, endLabel)
    } else {
        emitCondBranch(cg, condReg, trueLabel, falseLabel)
    }
    emitLabel(cg, trueLabel)
    emitBlockLastExprStore(cg, stmt.thenBody, resultAlloca, resultType)
    if !cg.terminated {
        emitBranch(cg, endLabel)
    }
    if hasElse {
        emitLabel(cg, falseLabel)
        emitBlockLastExprStore(cg, stmt.elseBody, resultAlloca, resultType)
        if !cg.terminated {
            emitBranch(cg, endLabel)
        }
    }
    emitLabel(cg, endLabel)
    popScope(cg)
}

// emitBlockLastExprStore emits a block whose last statement is an
// expression; its value is stored into resultAlloca.
fn emitBlockLastExprStore(cg: *CodeGen, body: []ast.Stmt, resultAlloca: string, resultType: string) {
    pushScope(cg)
    i := 0
    for i < len(body) - 1 {
        if cg.terminated {
            popScope(cg)
            return
        }
        emitStatement(cg, body[i])
        i = i + 1
    }
    if !cg.terminated && len(body) > 0 {
        last := body[len(body) - 1]
        if last.kind == ast.ST_EXPR && len(last.expr) > 0 {
            valReg := emitExpression(cg, last.expr[0])
            valType := exprLLType(cg, last.expr[0])
            if str.Equal(resultType, "i32") && str.Equal(valType, "i1") {
                zext := nextReg(cg)
                emitfmt(cg, "  %s = zext i1 %s to i32\n", []string{zext, valReg})
                valReg = zext
            }
            // The result alloca must own a reference that survives the
            // block scope's cleanup of expression temporaries.
            if isHeapLLType(valType) {
                valReg = emitRetain(cg, valReg, valType)
            } else if isCompositeType(valType) && !str.EndsWith(valType, "*") {
                valReg = emitRetainStructHeapFields(cg, valReg, valType)
            }
            emitStore(cg, resultType, valReg, resultType, resultAlloca)
        } else {
            emitStatement(cg, last)
        }
    }
    popScope(cg)
}

// bindVariantPayloads loads a matched variant's payload fields from the
// subject alloca and declares each binding name as a local variable.
fn bindVariantPayloads(cg: *CodeGen, d: ast.Decl, vidx: int, subjAlloca: string, tuLL: string, bindings: []string) {
    v := d.enumVariants[vidx]
    if len(v.payloads) == 0 {
        return
    }
    n := tuPayloadBytes(cg, d)
    payArrLL := str.Concat("[", str.Concat(strconv.Itoa(n), " x i8]"))
    payPtr := nextReg(cg)
    emitfmt(cg, "  %s = getelementptr inbounds %s, %s* %s, i32 0, i32 1\n", []string{payPtr, tuLL, tuLL, subjAlloca})
    payStruct := tuPayloadLLType(cg, d, vidx)
    payTyped := nextReg(cg)
    emitfmt(cg, "  %s = bitcast %s* %s to %s*\n", []string{payTyped, payArrLL, payPtr, payStruct})
    j := 0
    for j < len(bindings) && j < len(v.payloads) {
        if !str.Equal(bindings[j], "_") {
            pt := checker.astTypeToType(cg.checker, v.payloads[j])
            fLL := llvmType(cg, pt)
            fptr := nextReg(cg)
            emitfmt(cg, "  %s = getelementptr inbounds %s, %s* %s, i32 0, i32 %s\n", []string{fptr, payStruct, payStruct, payTyped, strconv.Itoa(j)})
            val := emitLoad(cg, fLL, fLL, fptr)
            if isHeapLLType(fLL) {
                val = emitRetain(cg, val, fLL)
            }
            bAlloca := emitAlloca(cg, fLL)
            emitStore(cg, fLL, val, fLL, bAlloca)
            declareVar(cg, bindings[j], bAlloca, fLL, pt)
        }
        j = j + 1
    }
}

// emitMatchExpr lowers a match expression to a chain of conditional
// branches. Supports simple patterns (literals, identifiers/constants),
// range patterns, tagged-union variant patterns with payload bindings,
// and wildcard/last-arm fallback.
fn emitMatchExpr(cg: *CodeGen, e: ast.Expr) -> string {
    resultType := matchExprResultLLType(cg, e)
    if str.Len(resultType) == 0 {
        resultType = "i32"
    }
    isVoid := str.Equal(resultType, "void")
    resultAlloca := ""
    if !isVoid {
        resultAlloca = emitAlloca(cg, resultType)
    }

    subjectReg := emitExpression(cg, e.matchExprSubject[0])
    subjectType := exprLLType(cg, e.matchExprSubject[0])

    // Tagged-union subject: stash the value in an alloca so variant arms
    // can GEP into the payload area to bind their fields.
    subjTUDecl := ast.Decl{}
    subjIsTU := false
    subjAlloca := ""
    if str.StartsWith(subjectType, "%") && !str.EndsWith(subjectType, "*") && !str.StartsWith(subjectType, "%struct.") && !str.StartsWith(subjectType, "%map_") && !str.StartsWith(subjectType, "%set.") {
        td, hasTU := lookupTUForLL(cg, subjectType)
        if hasTU {
            subjIsTU = true
            subjTUDecl = td
            subjAlloca = emitAlloca(cg, subjectType)
            emitStore(cg, subjectType, subjectReg, subjectType, subjAlloca)
        }
    }

    endLabel := nextLabel(cg)

    n := len(e.matchExprArms)
    i := 0
    for i < n {
        arm := e.matchExprArms[i]
        isLast := i == n - 1
        if isLast || arm.isWildcard {
            pushScope(cg)
            // A last arm may still carry a variant pattern with bindings
            // (the checker verified coverage); bind its payloads before
            // emitting the body.
            if !arm.isWildcard && arm.pattern.kind == ast.PK_VARIANT && subjIsTU {
                vidx := tuVariantIndex(subjTUDecl, arm.pattern.variantName)
                if vidx >= 0 {
                    bindVariantPayloads(cg, subjTUDecl, vidx, subjAlloca, subjectType, arm.pattern.bindings)
                }
            }
            emitMatchArmBody(cg, arm.body, resultAlloca, resultType)
            popScope(cg)
            if !cg.terminated {
                emitBranch(cg, endLabel)
            }
            i = n
        } else if arm.pattern.kind == ast.PK_RANGE {
            // Range pattern: low..high matches when low <= subject <= high.
            // Emit two comparisons and AND them. Use the subject's actual
            // integer type (i32 or i64) for the comparisons.
            lowLit := strconv.Itoa(arm.pattern.rangeLow)
            highLit := strconv.Itoa(arm.pattern.rangeHigh)
            cmpType := subjectType
            if !str.Equal(cmpType, "i64") {
                cmpType = "i32"
            }
            geReg := nextReg(cg)
            emitfmt(cg, "  %s = icmp sge %s %s, %s\n", []string{geReg, cmpType, subjectReg, lowLit})
            leReg := nextReg(cg)
            emitfmt(cg, "  %s = icmp sle %s %s, %s\n", []string{leReg, cmpType, subjectReg, highLit})
            cmpReg := nextReg(cg)
            emitfmt(cg, "  %s = and i1 %s, %s\n", []string{cmpReg, geReg, leReg})
            condReg := cmpReg
            if len(arm.guard) > 0 {
                guardReg := emitExpression(cg, arm.guard[0])
                combined := nextReg(cg)
                emitfmt(cg, "  %s = and i1 %s, %s\n", []string{combined, condReg, guardReg})
                condReg = combined
            }
            bodyLabel := nextLabel(cg)
            nextArmLabel := nextLabel(cg)
            emitCondBranch(cg, condReg, bodyLabel, nextArmLabel)

            emitLabel(cg, bodyLabel)
            pushScope(cg)
            emitMatchArmBody(cg, arm.body, resultAlloca, resultType)
            popScope(cg)
            if !cg.terminated {
                emitBranch(cg, endLabel)
            }

            emitLabel(cg, nextArmLabel)
            i = i + 1
        } else if subjIsTU && arm.pattern.kind == ast.PK_VARIANT {
            // Variant pattern with bindings: Circle(r), Rectangle(w, h)
            vidx := tuVariantIndex(subjTUDecl, arm.pattern.variantName)
            if vidx < 0 {
                errorf(cg, str.Concat("unknown variant ", arm.pattern.variantName))
                i = i + 1
                continue
            }
            tagReg := nextReg(cg)
            emitfmt(cg, "  %s = extractvalue %s %s, 0\n", []string{tagReg, subjectType, subjectReg})
            cmpReg := nextReg(cg)
            emitfmt(cg, "  %s = icmp eq i32 %s, %s\n", []string{cmpReg, tagReg, strconv.Itoa(vidx)})
            condReg := cmpReg
            if len(arm.guard) > 0 {
                guardReg := emitExpression(cg, arm.guard[0])
                combined := nextReg(cg)
                emitfmt(cg, "  %s = and i1 %s, %s\n", []string{combined, condReg, guardReg})
                condReg = combined
            }
            bodyLabel := nextLabel(cg)
            nextArmLabel := nextLabel(cg)
            emitCondBranch(cg, condReg, bodyLabel, nextArmLabel)

            emitLabel(cg, bodyLabel)
            pushScope(cg)
            bindVariantPayloads(cg, subjTUDecl, vidx, subjAlloca, subjectType, arm.pattern.bindings)
            emitMatchArmBody(cg, arm.body, resultAlloca, resultType)
            popScope(cg)
            if !cg.terminated {
                emitBranch(cg, endLabel)
            }
            emitLabel(cg, nextArmLabel)
            i = i + 1
        } else if subjIsTU && arm.pattern.kind == ast.PK_IDENT && mapStringDeclHasKeyTU2(cg.tuVariantDecl, arm.pattern.identName) {
            // Bare variant pattern: None, Empty, etc. — tag compare only.
            vidx := tuVariantIndex(subjTUDecl, arm.pattern.identName)
            tagReg := nextReg(cg)
            emitfmt(cg, "  %s = extractvalue %s %s, 0\n", []string{tagReg, subjectType, subjectReg})
            cmpReg := nextReg(cg)
            emitfmt(cg, "  %s = icmp eq i32 %s, %s\n", []string{cmpReg, tagReg, strconv.Itoa(vidx)})
            condReg := cmpReg
            if len(arm.guard) > 0 {
                guardReg := emitExpression(cg, arm.guard[0])
                combined := nextReg(cg)
                emitfmt(cg, "  %s = and i1 %s, %s\n", []string{combined, condReg, guardReg})
                condReg = combined
            }
            bodyLabel := nextLabel(cg)
            nextArmLabel := nextLabel(cg)
            emitCondBranch(cg, condReg, bodyLabel, nextArmLabel)

            emitLabel(cg, bodyLabel)
            pushScope(cg)
            emitMatchArmBody(cg, arm.body, resultAlloca, resultType)
            popScope(cg)
            if !cg.terminated {
                emitBranch(cg, endLabel)
            }
            emitLabel(cg, nextArmLabel)
            i = i + 1
        } else {
            patternReg := emitPatternValue(cg, arm.pattern)
            cmpReg := nextReg(cg)
            if str.Equal(subjectType, "i8*") {
                strcmpReg := nextReg(cg)
                emitfmt(cg, "  %s = call i32 @strcmp(i8* %s, i8* %s)\n", []string{strcmpReg, subjectReg, patternReg})
                emitfmt(cg, "  %s = icmp eq i32 %s, 0\n", []string{cmpReg, strcmpReg})
            } else if str.Equal(subjectType, "i1") {
                emitfmt(cg, "  %s = icmp eq i1 %s, %s\n", []string{cmpReg, subjectReg, patternReg})
            } else if str.Equal(subjectType, "i64") {
                emitfmt(cg, "  %s = icmp eq i64 %s, %s\n", []string{cmpReg, subjectReg, patternReg})
            } else {
                emitfmt(cg, "  %s = icmp eq i32 %s, %s\n", []string{cmpReg, subjectReg, patternReg})
            }
            condReg := cmpReg
            if len(arm.guard) > 0 {
                guardReg := emitExpression(cg, arm.guard[0])
                combined := nextReg(cg)
                emitfmt(cg, "  %s = and i1 %s, %s\n", []string{combined, condReg, guardReg})
                condReg = combined
            }
            bodyLabel := nextLabel(cg)
            nextArmLabel := nextLabel(cg)
            emitCondBranch(cg, condReg, bodyLabel, nextArmLabel)

            emitLabel(cg, bodyLabel)
            pushScope(cg)
            emitMatchArmBody(cg, arm.body, resultAlloca, resultType)
            popScope(cg)
            if !cg.terminated {
                emitBranch(cg, endLabel)
            }

            emitLabel(cg, nextArmLabel)
            i = i + 1
        }
    }

    emitLabel(cg, endLabel)
    if isVoid {
        return ""
    }
    resultReg := nextReg(cg)
    emitfmt(cg, "  %s = load %s, %s* %s\n", []string{resultReg, resultType, resultType, resultAlloca})
    return resultReg
}

// emitFnLit emits a function literal and returns its closure handle (i8*).
// The literal is lifted to a module-scope function `__skink_fnlit_N` with
// signature `retType(i8* %env, params...)`. Locals referenced from
// enclosing scopes are collected by collectCaptures, boxed via
// boxVarAtScope (so reads and writes alias the enclosing variable —
// capture is by reference), and their box pointers are packed into an RC
// block after the code pointer: `{ i8* code, i8* cap0, ... }`. The lifted
// function unpacks env[i+1] into borrowed heapSlot bindings in its
// prologue. Non-capturing literals use a constant `{ i8* code }` global
// handle instead. This supports the common `defer fn(){...}()` pattern
// and full closure semantics (comp_error.md #20).
fn emitFnLit(cg: *CodeGen, e: ast.Expr) -> string {
    cg.fnLitCounter = cg.fnLitCounter + 1
    fnName := str.Concat("__skink_fnlit_", strconv.Itoa(cg.fnLitCounter))

    // Determine return type
    retType := "void"
    if len(e.fnLitRetTypes) > 0 {
        t := checker.astTypeToType(cg.checker, e.fnLitRetTypes[0])
        retType = llvmType(cg, t)
    }

    // Build parameter list
    paramStrs := []string{}
    paramLLTypes := []string{}
    i := 0
    for i < len(e.fnLitParams) {
        paramType := "i32"
        if len(e.fnLitParams[i].typ) > 0 {
            t := checker.astTypeToType(cg.checker, e.fnLitParams[i].typ[0])
            paramType = llvmType(cg, t)
        }
        sigType := paramLLType(paramType)
        paramStrs = append(paramStrs, str.Concat(sigType, str.Concat(" %arg", strconv.Itoa(i))))
        paramLLTypes = append(paramLLTypes, sigType)
        i = i + 1
    }

    // === Capture packing (still in the enclosing function's stream) ===
    // Identify enclosing locals the literal references and box them so
    // the literal holds a stable, shared view. The env block layout is
    // { i8* code, i8* cap1, ..., i8* capN }.
    capNames := collectLitCaptureNames(cg, e)
    capLLTypes := []string{}
    capSynTypes := []checker.TType{}
    capBoxRegs := []string{}
    capKeptNames := []string{}
    i = 0
    for i < len(capNames) {
        csv, ok := promoteForCapture(cg, capNames[i])
        if !ok {
            continue
        }
        capKeptNames = append(capKeptNames, capNames[i])
        capLLTypes = append(capLLTypes, csv.llType)
        capSynTypes = append(capSynTypes, csv.synType)
        boxReg := varValuePtr(cg, csv)
        boxI8 := nextReg(cg)
        emitfmt(cg, "  %s = bitcast %s* %s to i8*\n", []string{boxI8, csv.llType, boxReg})
        // The env block holds its own reference on each captured box.
        emitRetain(cg, boxI8, "i8*")
        capBoxRegs = append(capBoxRegs, boxI8)
        i = i + 1
    }
    capNames = capKeptNames

    envTypeName := str.Concat("%__clos_", fnName)
    codeSig := closureCodeSig(retType, paramLLTypes)
    var handleReg string
    if len(capBoxRegs) > 0 {
        // Env block type + destructor (releases each captured box).
        fields := []string{}
        fields = append(fields, "i8*")
        i = 0
        for i < len(capBoxRegs) {
            fields = append(fields, "i8*")
            i = i + 1
        }
        emitHeader(cg, str.Concat(envTypeName,
            str.Concat(" = type { ", str.Concat(str.Join(fields, ", "), " }\n"))))
        dtorName := str.Concat("__clos_dtor_", fnName)
        b := &cg.arrayDtorFns
        str.Write(b, str.Concat(str.Concat("define void @", dtorName), "(i8* %raw) {\nentry:\n"))
        str.Write(b, str.Concat(str.Concat("  %bp = bitcast i8* %raw to ", envTypeName), "*\n"))
        i = 0
        for i < len(capBoxRegs) {
            str.Write(b, str.Concat(str.Concat("  %f", strconv.Itoa(i)),
                str.Concat(str.Concat(" = getelementptr ", envTypeName),
                    str.Concat(str.Concat(", ", str.Concat(envTypeName, "* %bp, i32 0, i32 ")), str.Concat(strconv.Itoa(i+1), "\n")))))
            str.Write(b, str.Concat(str.Concat("  %v", strconv.Itoa(i)),
                str.Concat(" = load i8*, i8** %f", str.Concat(strconv.Itoa(i), "\n"))))
            str.Write(b, str.Concat(str.Concat("  call void @Skink_rc_release(i8* %v", strconv.Itoa(i)), ")\n"))
            i = i + 1
        }
        str.Write(b, "  ret void\n}\n\n")
        // Allocate and fill the env block; the handle is the block.
        raw := nextReg(cg)
        emitfmt(cg, "  %s = call i8* @Skink_rc_alloc_typed(i64 %s, i8* bitcast (void (i8*)* @%s to i8*))\n",
            []string{raw, strconv.Itoa(8 * (1 + len(capBoxRegs))), dtorName})
        bp := nextReg(cg)
        emitfmt(cg, "  %s = bitcast i8* %s to %s\n", []string{bp, raw, str.Concat(envTypeName, "*")})
        cp := nextReg(cg)
        emitfmt(cg, "  %s = getelementptr %s, %s %s, i32 0, i32 0\n",
            []string{cp, envTypeName, str.Concat(envTypeName, "*"), bp})
        emitfmt(cg, "  store i8* bitcast (%s* @%s to i8*), i8** %s\n", []string{codeSig, fnName, cp})
        i = 0
        for i < len(capBoxRegs) {
            fp := nextReg(cg)
            emitfmt(cg, "  %s = getelementptr %s, %s %s, i32 0, i32 %s\n",
                []string{fp, envTypeName, str.Concat(envTypeName, "*"), bp, strconv.Itoa(i+1)})
            emitfmt(cg, "  store i8* %s, i8** %s\n", []string{capBoxRegs[i], fp})
            i = i + 1
        }
        handleReg = raw
    } else {
        // No captures: a module-level constant { i8* code } handle.
        globalName := str.Concat("__clos_h_", fnName)
        emitHeader(cg, str.Concat(str.Concat("@", globalName),
            str.Concat(" = private constant { i8* } { i8* bitcast (",
                str.Concat(codeSig, str.Concat("* @", str.Concat(fnName, " to i8*) }\n"))))))
        handleReg = nextReg(cg)
        emitfmt(cg, "  %s = bitcast { i8* }* @%s to i8*\n", []string{handleReg, globalName})
    }

    // Save CodeGen state (mirrors emitFnDecl)
    savedRetTypes := cg.currentFnRetTypes
    savedRetNames := cg.currentFnRetNames
    savedRegCounter := cg.regCounter
    savedLabelCounter := cg.labelCounter
    savedDeferred := cg.deferred
    savedHasDefer := cg.hasDefer
    savedNeedPanicLanding := cg.needPanicLanding
    savedCurrentModule := cg.currentModule
    savedAllocaBuffer := cg.allocaBuffer
    savedLoopLabelDepth := cg.loopLabelDepth
    savedCurrentFnName := cg.currentFnName
    savedCheckerMod := cg.checker.currentModule
    savedFnReturnLabel := cg.fnReturnLabel
    savedFnReturnAlloca := cg.fnReturnAlloca
    savedScopeVars := cg.scopeVars
    savedScopeDepth := cg.scopeDepth
    savedFnBodyActive := cg.fnBodyActive
    savedEscapedVars := cg.escapedVars
    savedCapturedVars := cg.capturedVars
    savedDeferQueueAlloca := cg.deferQueueAlloca

    cg.currentFnName = fnName
    // Keep cg.currentModule — calls inside the literal (e.g. recSave(...))
    // must still resolve module-qualified names like mymod.recSave.
    cg.regCounter = 0
    cg.labelCounter = 0
    cg.deferred = []ast.Stmt{}
    cg.hasDefer = false
    cg.deferQueueAlloca = ""
    cg.needPanicLanding = stmtsContainDefer(e.fnLitBody)
    cg.loopLabelDepth = 0
    cg.allocaBuffer = str.NewBuilder(256)
    cg.currentFnRetTypes = []string{}
    cg.currentFnRetNames = []string{}
    if !str.Equal(retType, "void") {
        cg.currentFnRetTypes = append(cg.currentFnRetTypes, retType)
    }
    // The literal is a separate function — it needs its own scope stack so
    // that return-path deallocations (emitAllDeallocations) don't emit
    // releases for the ENCLOSING function's allocas inside this body.
    cg.scopeVars = []ScopeV{}
    cg.scopeVars = append(cg.scopeVars, scopeVMake())
    cg.scopeDepth = 0
    // The literal body tracks expression temporaries and owns its
    // parameter copies, same as a regular function body.
    cg.fnBodyActive = true
    // The literal's own `&x` escapes get boxed within this frame, and its
    // nested literals' captures box its locals.
    litEscapeScan := collectEscapedVars(e.fnLitBody)
    cg.escapedVars = litEscapeScan.escaped
    cg.capturedVars = litEscapeScan.captured

    // Emit function header to the real output, then switch cg.out to a
    // body buffer so allocas collected in allocaBuffer can be emitted at
    // the entry block (mirrors emitFnDecl).
    savedOut := cg.out
    cg.out = str.NewBuilder(4096)

    // Allocate parameters into local slots — scope 0 holds the callee's
    // owned copies (mirrors emitFnDecl): the entry store retains, and the
    // scope-0 release emitted after deferred statements on every return
    // path balances it, so reassigning a parameter releases the
    // callee-owned value rather than the caller's borrowed argument.
    i = 0
    for i < len(e.fnLitParams) {
        paramType := "i32"
        paramSyn := checker.unknownType()
        if len(e.fnLitParams[i].typ) > 0 {
            paramSyn = checker.astTypeToType(cg.checker, e.fnLitParams[i].typ[0])
            paramType = llvmType(cg, paramSyn)
        }
        sigType := paramLLType(paramType)
        argName := str.Concat("%arg", strconv.Itoa(i))
        if isCompositeType(paramType) && !str.EndsWith(paramType, "*") {
            // Composite by-value params arrive as pointers; store an
            // owned copy of the struct in the local alloca.
            alloca := emitAlloca(cg, paramType)
            copyReg := nextReg(cg)
            emitfmt(cg, "  %s = load %s, %s* %s\n", []string{copyReg, paramType, sigType, argName})
            copyReg = emitRetainStructHeapFields(cg, copyReg, paramType)
            emitStore(cg, paramType, copyReg, paramType, alloca)
            declareVar(cg, e.fnLitParams[i].name, alloca, paramType, paramSyn)
        } else {
            alloca := emitAlloca(cg, sigType)
            if isHeapLLType(sigType) {
                emitRetain(cg, argName, sigType)
            }
            emitfmt(cg, "  store %s %s, %s* %s\n", []string{sigType, argName, sigType, alloca})
            declareVar(cg, e.fnLitParams[i].name, alloca, sigType, paramSyn)
        }
        i = i + 1
    }

    // Unpack captured variables: env field i+1 holds the i8* box pointer
    // for capNames[i]. Each capture is registered as a borrowed boxed
    // view (heapSlot set, escaped false) — reads and writes go through
    // the shared box, and the literal releases nothing at scope exit
    // (the env block's destructor owns the reference).
    if len(capNames) > 0 {
        envPtrType := str.Concat(envTypeName, "*")
        ep := nextReg(cg)
        emitfmt(cg, "  %s = bitcast i8* %s to %s\n", []string{ep, "%env", envPtrType})
        i = 0
        for i < len(capNames) {
            fp := nextReg(cg)
            emitfmt(cg, "  %s = getelementptr %s, %s %s, i32 0, i32 %s\n",
                []string{fp, envTypeName, envPtrType, ep, strconv.Itoa(i+1)})
            vp := nextReg(cg)
            emitfmt(cg, "  %s = load i8*, i8** %s\n", []string{vp, fp})
            capPtrType := str.Concat(capLLTypes[i], "*")
            tp := nextReg(cg)
            emitfmt(cg, "  %s = bitcast i8* %s to %s\n", []string{tp, vp, capPtrType})
            slot := emitAlloca(cg, capPtrType)
            emitStore(cg, capPtrType, tp, capPtrType, slot)
            csv := ScopeVar{}
            csv.llType = capLLTypes[i]
            csv.synType = capSynTypes[i]
            csv.heapSlot = slot
            csv.borrowed = true
            scopeVSet(&cg.scopeVars[0], capNames[i], csv)
            i = i + 1
        }
    }
    pushScope(cg)

    // Emit body — install a panic handler if the literal contains defer.
    // The defer stack head is initialized first: a setjmp re-entry must
    // not reset it and lose pending registrations.
    if cg.needPanicLanding {
        emitDeferQueueInit(cg)
        emitPanicPrologue(cg)
    }
    emitBlockStmtRaw(cg, e.fnLitBody)

    // Fall-through epilogue: deferred statements and scope deallocations
    // belong to the implicit-return path only. When the body already
    // terminated with `return`, emitRet emitted them per-path; emitting
    // again here would leave dead instructions after a terminator,
    // which LLVM rejects (comp_error.md — fn-lit dead dealloc).
    if !cg.terminated {
        // Pop the panic handler before running deferred statements
        // (same ordering as emitRet).
        if cg.needPanicLanding {
            emitln(cg, "  call void @Skink_panic_pop_handler()")
        }

        // Emit deferred statements (if any)
        emitDeferDrain(cg)

        // Scope deallocations must precede the terminating ret —
        // emitting them after a terminator leaves dead instructions.
        popScope(cg)
        // Release owned parameters (scope 0); deferred statements ran.
        emitDeallocationsForScope(cg, 0)

        if str.Equal(retType, "void") {
            emitln(cg, "  ret void")
        } else {
            // Return zero for the type
            zeroVal := "0"
            if str.Equal(retType, "double") {
                zeroVal = "0.0"
            } else if str.Equal(retType, "i1") {
                zeroVal = "0"
            } else if str.Equal(retType, "i8*") {
                zeroVal = "null"
            }
            emitfmt(cg, "  ret %s %s\n", []string{retType, zeroVal})
        }
    } else {
        // Balance the scope stack even when the body self-terminated.
        popScope(cg)
    }

    // Panic landing pad for the literal.
    if cg.needPanicLanding {
        emitPanicEpilogue(cg, retType)
    }
    cg.terminated = false

    bodyText := str.BuilderValue(cg.out)
    bodyLen := str.LenBuilder(cg.out)
    cg.out = savedOut

    // Function literals are top-level definitions — they must go to the
    // anonFns buffer, not inline in the enclosing function body (LLVM does
    // not allow nested function definitions).
    emitAnonFn(cg, "define ")
    emitAnonFn(cg, retType)
    emitAnonFn(cg, " @")
    emitAnonFn(cg, fnName)
    emitAnonFn(cg, "(i8* %env")
    i = 0
    for i < len(paramStrs) {
        emitAnonFn(cg, ", ")
        emitAnonFn(cg, paramStrs[i])
        i = i + 1
    }
    emitAnonFn(cg, ") {\n")

    allocaText := str.BuilderValue(cg.allocaBuffer)
    if str.LenBuilder(cg.allocaBuffer) > 0 {
        cg.anonFns.Write(allocaText)
        cg.anonFns.WriteByte(10)
    }
    if bodyLen > 0 {
        cg.anonFns.Write(bodyText)
        cg.anonFns.WriteByte(10)
    }
    emitAnonFn(cg, "}\n")

    // Restore CodeGen state
    cg.currentFnRetTypes = savedRetTypes
    cg.currentFnRetNames = savedRetNames
    cg.regCounter = savedRegCounter
    cg.labelCounter = savedLabelCounter
    cg.deferred = savedDeferred
    cg.hasDefer = savedHasDefer
    cg.needPanicLanding = savedNeedPanicLanding
    cg.currentModule = savedCurrentModule
    cg.allocaBuffer = savedAllocaBuffer
    cg.loopLabelDepth = savedLoopLabelDepth
    cg.currentFnName = savedCurrentFnName
    cg.checker.currentModule = savedCheckerMod
    cg.fnReturnLabel = savedFnReturnLabel
    cg.fnReturnAlloca = savedFnReturnAlloca
    cg.scopeVars = savedScopeVars
    cg.scopeDepth = savedScopeDepth
    cg.fnBodyActive = savedFnBodyActive
    cg.escapedVars = savedEscapedVars
    cg.capturedVars = savedCapturedVars
    cg.deferQueueAlloca = savedDeferQueueAlloca

    // The handle was materialized in the enclosing body before the state
    // switch — an RC env block for capturing literals, a constant global
    // handle for non-capturing ones.
    return handleReg
}

// emitLenCall handles len() builtin.
fn emitLenCall(cg: *CodeGen, e: ast.Expr) -> string {
    argExpr := e.callArgs[0]
    arg := emitExpression(cg, argExpr)
    argType := exprLLType(cg, argExpr)

    // Channel: number of buffered elements via the runtime.
    if exprIsChan(cg, argExpr) {
        r := nextReg(cg)
        emitfmt(cg, "  %s = call i32 @Skink_chan_len(i8* %s)\n", []string{r, arg})
        return r
    }

    // String, map, set, and array handling lives in emitLenCallRaw.
    return emitLenCallRaw(cg, arg, argType, argExpr)
}

// emitSliceCopyArr copies a non-null backing array (given as an i8* element
// pointer) and returns the new payload pointer as i8*. The element LLVM type
// determines the array destructor and whether copied elements must be
// retained, and srcLen64 supplies the element count — callers pass
// Skink_slice_len(h) for slice headers or Skink_arr_count(a) for raw map/set
// backing arrays. This is the fast path: a single bulk memcpy plus an
// optional retain loop for reference-counted element types.
fn emitSliceCopyArr(cg: *CodeGen, srcRaw: string, elemLL: string, srcLen64: string) -> string {

    // Allocation size = srcLen * sizeof(elem)
    elemSizeReg := emitElemSize(cg, elemLL)
    elemSizeI64 := nextReg(cg)
    emitfmt(cg, "  %s = zext i32 %s to i64\n", []string{elemSizeI64, elemSizeReg})
    nBytes := nextReg(cg)
    emitfmt(cg, "  %s = mul i64 %s, %s\n", []string{nBytes, srcLen64, elemSizeI64})

    // Allocate a new backing array with the same element destructor.
    arrDtorName := getOrCreateArrayDtor(cg, elemLL)
    newArr := nextReg(cg)
    if str.Len(arrDtorName) > 0 {
        arrDtorPtr := str.Concat("i8* bitcast (void (i8*)* @", str.Concat(arrDtorName, " to i8*)"))
        emitfmt(cg, "  %s = call i8* @Skink_rc_alloc_typed(i64 %s, %s)\n", []string{newArr, nBytes, arrDtorPtr})
    } else {
        emitfmt(cg, "  %s = call i8* @Skink_rc_alloc(i64 %s)\n", []string{newArr, nBytes})
    }

    // Store the length at offset -8 of the new array.
    newLenPtr := nextReg(cg)
    emitfmt(cg, "  %s = getelementptr inbounds i8, i8* %s, i64 -8\n", []string{newLenPtr, newArr})
    newTypedLenPtr := nextReg(cg)
    emitfmt(cg, "  %s = bitcast i8* %s to i64*\n", []string{newTypedLenPtr, newLenPtr})
    emitfmt(cg, "  store i64 %s, i64* %s\n", []string{srcLen64, newTypedLenPtr})

    // Bulk-copy the element bytes.
    emitfmt(cg, "  call void @llvm.memcpy.p0i8.p0i8.i64(i8* %s, i8* %s, i64 %s, i1 false)\n", []string{newArr, srcRaw, nBytes})

    // If the element type is heap-reachable, retain each copied element so the
    // new slice owns its own references (the source's destructor releases its
    // copies when the source is freed).
    if needsArrayDtor(cg, elemLL) {
        newArrTyped := nextReg(cg)
        emitfmt(cg, "  %s = bitcast i8* %s to %s*\n", []string{newArrTyped, newArr, elemLL})
        retainIdxAlloca := nextReg(cg)
        emitfmt(cg, "  %s = alloca i64\n", []string{retainIdxAlloca})
        emitfmt(cg, "  store i64 0, i64* %s\n", []string{retainIdxAlloca})
        retCondLabel := nextLabel(cg)
        retBodyLabel := nextLabel(cg)
        retEndLabel := nextLabel(cg)
        emitBranch(cg, retCondLabel)
        emitLabel(cg, retCondLabel)
        retIdx := nextReg(cg)
        emitfmt(cg, "  %s = load i64, i64* %s\n", []string{retIdx, retainIdxAlloca})
        retCmp := nextReg(cg)
        emitfmt(cg, "  %s = icmp slt i64 %s, %s\n", []string{retCmp, retIdx, srcLen64})
        emitCondBranch(cg, retCmp, retBodyLabel, retEndLabel)
        emitLabel(cg, retBodyLabel)
        retElemAddr := nextReg(cg)
        emitfmt(cg, "  %s = getelementptr %s, %s* %s, i64 %s\n", []string{retElemAddr, elemLL, elemLL, newArrTyped, retIdx})
        if isHeapLLType(elemLL) {
            retElemVal := nextReg(cg)
            emitfmt(cg, "  %s = load %s, %s* %s\n", []string{retElemVal, elemLL, elemLL, retElemAddr})
            retElemRaw := nextReg(cg)
            emitfmt(cg, "  %s = bitcast %s %s to i8*\n", []string{retElemRaw, elemLL, retElemVal})
            emitfmt(cg, "  call void @Skink_rc_retain(i8* %s)\n", []string{retElemRaw})
        } else if isCompositeType(elemLL) && !str.EndsWith(elemLL, "*") {
            retElemVal := nextReg(cg)
            emitfmt(cg, "  %s = load %s, %s* %s\n", []string{retElemVal, elemLL, elemLL, retElemAddr})
            retained := emitRetainStructHeapFields(cg, retElemVal, elemLL)
            emitStore(cg, elemLL, retained, elemLL, retElemAddr)
        }
        retNextIdx := nextReg(cg)
        emitfmt(cg, "  %s = add i64 %s, 1\n", []string{retNextIdx, retIdx})
        emitfmt(cg, "  store i64 %s, i64* %s\n", []string{retNextIdx, retainIdxAlloca})
        emitBranch(cg, retCondLabel)
        emitLabel(cg, retEndLabel)
    }

    return newArr
}

// emitSliceCopyNullable copies a raw backing array that may be null — used
// for map/set internal arrays, whose element count sits at payload-8
// (read via Skink_arr_count). Slice values go through emitSliceCopyValue
// instead: their count lives in the header. srcArr has LLVM type elemLL*.
// Returns the new payload pointer as i8* (null if the source was null).
fn emitSliceCopyNullable(cg: *CodeGen, srcArr: string, elemLL: string) -> string {
    // Use an alloca for the result so we don't have to track the exact
    // predecessor basic block (emitSliceCopyArr may create internal blocks
    // for the retain loop).
    resultAlloca := nextReg(cg)
    emitfmt(cg, "  %s = alloca i8*\n", []string{resultAlloca})
    srcRaw := emitI8Ptr(cg, srcArr, str.Concat(elemLL, "*"))
    isNull := nextReg(cg)
    emitfmt(cg, "  %s = icmp eq i8* %s, null\n", []string{isNull, srcRaw})
    nullLabel := nextLabel(cg)
    copyLabel := nextLabel(cg)
    mergeLabel := nextLabel(cg)
    emitCondBranch(cg, isNull, nullLabel, copyLabel)
    emitLabel(cg, nullLabel)
    emitfmt(cg, "  store i8* null, i8** %s\n", []string{resultAlloca})
    emitBranch(cg, mergeLabel)
    emitLabel(cg, copyLabel)
    srcCnt := nextReg(cg)
    emitfmt(cg, "  %s = call i64 @Skink_arr_count(i8* %s)\n", []string{srcCnt, srcRaw})
    newArrI8 := emitSliceCopyArr(cg, srcRaw, elemLL, srcCnt)
    emitfmt(cg, "  store i8* %s, i8** %s\n", []string{newArrI8, resultAlloca})
    emitBranch(cg, mergeLabel)
    emitLabel(cg, mergeLabel)
    resultReg := nextReg(cg)
    emitfmt(cg, "  %s = load i8*, i8** %s\n", []string{resultReg, resultAlloca})
    return resultReg
}

// emitI8Ptr coerces a register of any pointer LL type to i8*, eliding the
// bitcast when the source is already i8* (LLVM rejects same-type bitcasts —
// this matters for []byte slices, whose header is itself i8*).
fn emitI8Ptr(cg: *CodeGen, reg: string, llType: string) -> string {
    if str.Equal(llType, "i8*") {
        return reg
    }
    r := nextReg(cg)
    emitfmt(cg, "  %s = bitcast %s %s to i8*\n", []string{r, llType, reg})
    return r
}

// emitFromI8Ptr bitcasts an i8* register to an arbitrary target type,
// eliding the bitcast when the target is already i8* (invalid in LLVM).
fn emitFromI8Ptr(cg: *CodeGen, reg: string, targetLL: string) -> string {
    if str.Equal(targetLL, "i8*") {
        return reg
    }
    r := nextReg(cg)
    emitfmt(cg, "  %s = bitcast i8* %s to %s\n", []string{r, reg, targetLL})
    return r
}

// emitSliceData unwraps a slice header to its element base pointer (i8*).
// Nil-safe: Skink_slice_data returns null for a nil slice value.
fn emitSliceData(cg: *CodeGen, sliceReg: string, sliceLL: string) -> string {
    raw := sliceReg
    if !str.Equal(sliceLL, "i8*") {
        raw = nextReg(cg)
        emitfmt(cg, "  %s = bitcast %s %s to i8*\n", []string{raw, sliceLL, sliceReg})
    }
    res := nextReg(cg)
    emitfmt(cg, "  %s = call i8* @Skink_slice_data(i8* %s)\n", []string{res, raw})
    return res
}

// emitSliceLenReg unwraps a slice header's element length (i64). Nil-safe.
fn emitSliceLenReg(cg: *CodeGen, sliceReg: string, sliceLL: string) -> string {
    raw := sliceReg
    if !str.Equal(sliceLL, "i8*") {
        raw = nextReg(cg)
        emitfmt(cg, "  %s = bitcast %s %s to i8*\n", []string{raw, sliceLL, sliceReg})
    }
    res := nextReg(cg)
    emitfmt(cg, "  %s = call i64 @Skink_slice_len(i8* %s)\n", []string{res, raw})
    return res
}

// emitSliceCopyValue deep-copies a slice VALUE — under the fat-slice ABI
// srcVal is a slice header, so the element base and count come from the
// header and the result is re-wrapped in a fresh header. Nil propagates.
// Returns a register of LLVM type srcType (the slice's elemLL* fiction).
fn emitSliceCopyValue(cg: *CodeGen, srcVal: string, srcType: string, elemLL: string) -> string {
    rawHdr := srcVal
    if !str.Equal(srcType, "i8*") {
        rawHdr = nextReg(cg)
        emitfmt(cg, "  %s = bitcast %s %s to i8*\n", []string{rawHdr, srcType, srcVal})
    }
    srcData := nextReg(cg)
    emitfmt(cg, "  %s = call i8* @Skink_slice_data(i8* %s)\n", []string{srcData, rawHdr})
    srcLen := nextReg(cg)
    emitfmt(cg, "  %s = call i64 @Skink_slice_len(i8* %s)\n", []string{srcLen, rawHdr})
    resultAlloca := nextReg(cg)
    emitfmt(cg, "  %s = alloca i8*\n", []string{resultAlloca})
    isNull := nextReg(cg)
    emitfmt(cg, "  %s = icmp eq i8* %s, null\n", []string{isNull, srcData})
    nullLabel := nextLabel(cg)
    copyLabel := nextLabel(cg)
    mergeLabel := nextLabel(cg)
    emitCondBranch(cg, isNull, nullLabel, copyLabel)
    emitLabel(cg, nullLabel)
    emitfmt(cg, "  store i8* null, i8** %s\n", []string{resultAlloca})
    emitBranch(cg, mergeLabel)
    emitLabel(cg, copyLabel)
    newData := emitSliceCopyArr(cg, srcData, elemLL, srcLen)
    newHdr := nextReg(cg)
    emitfmt(cg, "  %s = call i8* @Skink_slice_hdr(i8* %s, i64 %s, i64 %s, i8* %s)\n",
        []string{newHdr, newData, srcLen, srcLen, newData})
    emitfmt(cg, "  store i8* %s, i8** %s\n", []string{newHdr, resultAlloca})
    emitBranch(cg, mergeLabel)
    emitLabel(cg, mergeLabel)
    resI8 := nextReg(cg)
    emitfmt(cg, "  %s = load i8*, i8** %s\n", []string{resI8, resultAlloca})
    if str.Equal(srcType, "i8*") {
        return resI8
    }
    res := nextReg(cg)
    emitfmt(cg, "  %s = bitcast i8* %s to %s\n", []string{res, resI8, srcType})
    return res
}

// emitPinMapField loads a map backing-array field and pins it against a
// concurrent resize by retaining it and verifying the field still holds the
// same pointer.  Returns the field's typed pointer (elemLL*), retained on
// success — or null.  The caller must release it via emitReleasePinned once
// finished reading the array.
fn emitPinMapField(cg: *CodeGen, mapType: string, srcType: string, src: string, fieldIdx: string, elemLL: string) -> string {
    resultAlloca := nextReg(cg)
    emitfmt(cg, "  %s = alloca %s*\n", []string{resultAlloca, elemLL})
    retryLabel := nextLabel(cg)
    mismLabel := nextLabel(cg)
    doneLabel := nextLabel(cg)
    emitLabel(cg, retryLabel)
    fld := nextReg(cg)
    emitfmt(cg, "  %s = getelementptr inbounds %s, %s %s, i32 0, i32 %s\n", []string{fld, mapType, srcType, src, fieldIdx})
    p1 := nextReg(cg)
    emitfmt(cg, "  %s = load %s, %s* %s\n", []string{p1, str.Concat(elemLL, "*"), str.Concat(elemLL, "*"), fld})
    p1raw := nextReg(cg)
    emitfmt(cg, "  %s = bitcast %s* %s to i8*\n", []string{p1raw, elemLL, p1})
    emitfmt(cg, "  call i8* @Skink_rc_retain(i8* %s)\n", []string{p1raw})
    p2 := nextReg(cg)
    emitfmt(cg, "  %s = load %s, %s* %s\n", []string{p2, str.Concat(elemLL, "*"), str.Concat(elemLL, "*"), fld})
    same := nextReg(cg)
    emitfmt(cg, "  %s = icmp eq %s* %s, %s\n", []string{same, elemLL, p1, p2})
    emitCondBranch(cg, same, doneLabel, mismLabel)
    emitLabel(cg, mismLabel)
    // Generation changed under us: release the stale pin (harmless if the
    // retain found the pointer dead) and retry with the current field.
    emitfmt(cg, "  call void @Skink_rc_release(i8* %s)\n", []string{p1raw})
    emitBranch(cg, retryLabel)
    emitLabel(cg, doneLabel)
    emitfmt(cg, "  store %s* %s, %s** %s\n", []string{elemLL, p1, elemLL, resultAlloca})
    resultReg := nextReg(cg)
    emitfmt(cg, "  %s = load %s*, %s** %s\n", []string{resultReg, elemLL, elemLL, resultAlloca})
    return resultReg
}

// emitReleasePinned releases a pointer returned by emitPinMapField.
fn emitReleasePinned(cg: *CodeGen, ptr: string, elemLL: string) {
    rawReg := nextReg(cg)
    emitfmt(cg, "  %s = bitcast %s* %s to i8*\n", []string{rawReg, elemLL, ptr})
    emitfmt(cg, "  call void @Skink_rc_release(i8* %s)\n", []string{rawReg})
}

// emitMapCopy duplicates a map struct: it allocates a new map, deep-copies the
// key, value, and occupied backing arrays (memcpy + retain), and copies capacity/count.
fn emitMapCopy(cg: *CodeGen, src: string, srcType: string) -> string {
    mapType := str.Substr(srcType, 0, str.Len(srcType) - 1)
    keyLL, valLL, _ := parseMapTypeLL(srcType)
    mtName := mapTypeName(keyLL, valLL)
    emitMapTypeDecl(cg, mtName, keyLL, valLL)

    // Use an alloca for the result so we don't have to track the exact
    // predecessor basic block (the inner array copies create their own).
    resultAlloca := nextReg(cg)
    emitfmt(cg, "  %s = alloca %s\n", []string{resultAlloca, srcType})

    // Handle a null source map by returning null.
    isNull := nextReg(cg)
    emitfmt(cg, "  %s = icmp eq %s %s, null\n", []string{isNull, srcType, src})
    nullLabel := nextLabel(cg)
    copyLabel := nextLabel(cg)
    mergeLabel := nextLabel(cg)
    emitCondBranch(cg, isNull, nullLabel, copyLabel)
    emitLabel(cg, nullLabel)
    emitfmt(cg, "  store %s null, %s* %s\n", []string{srcType, srcType, resultAlloca})
    emitBranch(cg, mergeLabel)

    emitLabel(cg, copyLabel)
    // Pin the source backing arrays before copying.  A concurrent map write
    // can resize (replacing + releasing these arrays) while we hold them, so
    // each field is retained and re-verified in a retry loop: if the field
    // changed under us, the just-retained pointer may belong to a retired
    // generation — release it (a no-op if it was never registered) and retry.
    // rc_retain's registry lookup rejects dead pointers without dereferencing
    // them, and the retire quarantine keeps recently-freed chunks mapped, so
    // the retain cannot touch unmapped memory.
    srcKeys := emitPinMapField(cg, mapType, srcType, src, "0", keyLL)
    srcVals := emitPinMapField(cg, mapType, srcType, src, "1", valLL)
    srcOcc := emitPinMapField(cg, mapType, srcType, src, "2", "i8")

    // Load source capacity (field 3).
    srcCapField := nextReg(cg)
    emitfmt(cg, "  %s = getelementptr inbounds %s, %s %s, i32 0, i32 3\n", []string{srcCapField, mapType, srcType, src})
    srcCap := nextReg(cg)
    emitfmt(cg, "  %s = load i32, i32* %s\n", []string{srcCap, srcCapField})

    // Load source count (field 4).
    srcCountField := nextReg(cg)
    emitfmt(cg, "  %s = getelementptr inbounds %s, %s %s, i32 0, i32 4\n", []string{srcCountField, mapType, srcType, src})
    srcCount := nextReg(cg)
    emitfmt(cg, "  %s = load i32, i32* %s\n", []string{srcCount, srcCountField})

    // Allocate a new map struct.
    sizeReg := nextReg(cg)
    emitfmt(cg, "  %s = getelementptr %s, %s* null, i32 1\n", []string{sizeReg, mapType, mapType})
    sizeReg2 := nextReg(cg)
    emitfmt(cg, "  %s = ptrtoint %s* %s to i64\n", []string{sizeReg2, mapType, sizeReg})
    rawReg := nextReg(cg)
    emitfmt(cg, "  %s = call i8* @Skink_rc_alloc(i64 %s)\n", []string{rawReg, sizeReg2})
    newMap := nextReg(cg)
    emitfmt(cg, "  %s = bitcast i8* %s to %s*\n", []string{newMap, rawReg, mapType})

    // Deep-copy the key and value backing arrays (handles null internally).
    // Each pinned source pointer is released right after its copy completes.
    newKeysI8 := emitSliceCopyNullable(cg, srcKeys, keyLL)
    emitReleasePinned(cg, srcKeys, keyLL)
    newValsI8 := emitSliceCopyNullable(cg, srcVals, valLL)
    emitReleasePinned(cg, srcVals, valLL)

    // Copy the occupied array (plain i8* buffer, capacity bytes).
    newOccI8 := emitSliceCopyNullable(cg, srcOcc, "i8")
    emitReleasePinned(cg, srcOcc, "i8")

    // Store the new keys array (field 0).
    newKeysTyped := nextReg(cg)
    emitfmt(cg, "  %s = bitcast i8* %s to %s*\n", []string{newKeysTyped, newKeysI8, keyLL})
    nkf := nextReg(cg)
    emitfmt(cg, "  %s = getelementptr inbounds %s, %s* %s, i32 0, i32 0\n", []string{nkf, mapType, mapType, newMap})
    emitfmt(cg, "  store %s* %s, %s** %s\n", []string{keyLL, newKeysTyped, keyLL, nkf})

    // Store the new values array (field 1).
    newValsTyped := nextReg(cg)
    emitfmt(cg, "  %s = bitcast i8* %s to %s*\n", []string{newValsTyped, newValsI8, valLL})
    nvf := nextReg(cg)
    emitfmt(cg, "  %s = getelementptr inbounds %s, %s* %s, i32 0, i32 1\n", []string{nvf, mapType, mapType, newMap})
    emitfmt(cg, "  store %s* %s, %s** %s\n", []string{valLL, newValsTyped, valLL, nvf})

    // Store the new occupied array (field 2).
    nof := nextReg(cg)
    emitfmt(cg, "  %s = getelementptr inbounds %s, %s* %s, i32 0, i32 2\n", []string{nof, mapType, mapType, newMap})
    emitfmt(cg, "  store i8* %s, i8** %s\n", []string{newOccI8, nof})

    // Store capacity (field 3).
    ncf := nextReg(cg)
    emitfmt(cg, "  %s = getelementptr inbounds %s, %s* %s, i32 0, i32 3\n", []string{ncf, mapType, mapType, newMap})
    emitfmt(cg, "  store i32 %s, i32* %s\n", []string{srcCap, ncf})

    // Store count (field 4).
    nlf := nextReg(cg)
    emitfmt(cg, "  %s = getelementptr inbounds %s, %s* %s, i32 0, i32 4\n", []string{nlf, mapType, mapType, newMap})
    emitfmt(cg, "  store i32 %s, i32* %s\n", []string{srcCount, nlf})

    emitfmt(cg, "  store %s %s, %s* %s\n", []string{srcType, newMap, srcType, resultAlloca})
    emitBranch(cg, mergeLabel)
    emitLabel(cg, mergeLabel)
    resultReg := nextReg(cg)
    emitfmt(cg, "  %s = load %s, %s* %s\n", []string{resultReg, srcType, srcType, resultAlloca})
    return resultReg
}

// emitCopyCall handles the copy() builtin, producing a like-for-like deep copy
// of a slice or map. Slices use a fast bulk memcpy of the backing array (plus
// an element retain loop for reference-counted element types); maps deep-copy
// both the key and value backing arrays and the length field.
fn emitCopyCall(cg: *CodeGen, e: ast.Expr) -> string {
    argExpr := e.callArgs[0]
    src := emitExpression(cg, argExpr)
    srcType := exprLLType(cg, argExpr)

    // Map copy.
    _, _, isMap := parseMapTypeLL(srcType)
    if isMap && !str.EndsWith(srcType, "**") {
        return emitMapCopy(cg, src, srcType)
    }

    // Slice copy. The element type is the source type without its trailing *.
    elemLL := srcType
    if str.EndsWith(srcType, "*") {
        elemLL = str.Substr(srcType, 0, str.Len(srcType) - 1)
    }

    return emitSliceCopyValue(cg, src, srcType, elemLL)
}

// emitDeleteCall implements delete(map, key) for removing a key from a map.
// Map struct: field 0 = keys array, field 1 = values array, field 2 = length.
// We scan the keys array for a match, and if found, shift the remaining
// elements down and decrement the length.
fn emitDeleteCall(cg: *CodeGen, e: ast.Expr) -> string {
    if len(e.callArgs) == 1 {
        // delete(x): release a heap-allocated value and null the variable
        // so a later scope-exit release is a no-op.
        arg := e.callArgs[0]
        llT := exprLLType(cg, arg)
        if arg.kind == ast.EX_IDENT {
            sv, ok := lookupVar(cg, arg.ident)
            if ok {
                if sv.escaped || str.Len(sv.heapSlot) > 0 {
                    // Boxed variable: release the contents held by the
                    // heap block and zero it so the block destructor
                    // becomes a no-op when the block is finally freed.
                    bp := varValuePtr(cg, sv)
                    if isCompositeType(sv.llType) {
                        emitReleaseStructHeapFields(cg, bp, sv.llType)
                    }
                    zv := zeroValueForLLType(sv.llType)
                    if str.Len(zv) > 0 {
                        emitStore(cg, sv.llType, zv, sv.llType, bp)
                    }
                    return ""
                }
                if isHeapLLType(sv.llType) {
                    loaded := emitLoad(cg, sv.llType, sv.llType, sv.alloca)
                    emitRelease(cg, loaded, sv.llType)
                    emitStore(cg, sv.llType, "null", sv.llType, sv.alloca)
                } else if isCompositeType(sv.llType) && !str.EndsWith(sv.llType, "*") {
                    emitReleaseStructHeapFields(cg, sv.alloca, sv.llType)
                }
                return ""
            }
        }
        reg := emitExpression(cg, arg)
        emitRelease(cg, reg, llT)
        return ""
    }
    if len(e.callArgs) < 2 {
        return ""
    }
    mapExpr := e.callArgs[0]
    keyExpr := e.callArgs[1]
    mapReg := emitExpression(cg, mapExpr)
    mapLLType := exprLLType(cg, mapExpr)
    keyReg := emitExpression(cg, keyExpr)
    keyLL := exprLLType(cg, keyExpr)

    // Only handle actual maps (not slices of maps).
    parsedKey, parsedVal, isMap := parseMapTypeLL(mapLLType)
    if !isMap || str.EndsWith(mapLLType, "**") {
        return ""
    }
    emitMapTypeDecl(cg, mapTypeName(parsedKey, parsedVal), parsedKey, parsedVal)
    if !str.Equal(keyLL, parsedKey) {
        // Key type mismatch; skip.
        return ""
    }

    mapStructType := str.Substr(mapLLType, 0, str.Len(mapLLType) - 1)

    // delete on a nil map is a no-op (Go semantics). GEP through a zeroed
    // stand-in map header so no field load ever dereferences null.
    zeroMap := emitAlloca(cg, mapStructType)
    isNullMap := nextReg(cg)
    emitfmt(cg, "  %s = icmp eq %s %s, null\n", []string{isNullMap, mapLLType, mapReg})
    safeMap := nextReg(cg)
    emitfmt(cg, "  %s = select i1 %s, %s %s, %s %s\n", []string{safeMap, isNullMap, mapLLType, zeroMap, mapLLType, mapReg})

    // Load keys (field 0), vals (field 1), occupied (field 2), capacity (field 3), count (field 4).
    keysField := nextReg(cg)
    emitfmt(cg, "  %s = getelementptr inbounds %s, %s %s, i32 0, i32 0\n", []string{keysField, mapStructType, mapLLType, safeMap})
    keysPtr := nextReg(cg)
    emitfmt(cg, "  %s = load %s*, %s** %s\n", []string{keysPtr, keyLL, keyLL, keysField})

    valsField := nextReg(cg)
    emitfmt(cg, "  %s = getelementptr inbounds %s, %s %s, i32 0, i32 1\n", []string{valsField, mapStructType, mapLLType, safeMap})
    // The value type comes from parseMapTypeLL — desanitizeLLTypeName
    // handles multi-level pointers (e.g. "i8PtrPtr" -> "i8**"), unlike
    // unsanitizeLLTypeName which strips only one Ptr suffix.
    valLL := parsedVal
    valsPtr := nextReg(cg)
    emitfmt(cg, "  %s = load %s*, %s** %s\n", []string{valsPtr, valLL, valLL, valsField})

    occField := nextReg(cg)
    emitfmt(cg, "  %s = getelementptr inbounds %s, %s %s, i32 0, i32 2\n", []string{occField, mapStructType, mapLLType, safeMap})
    occPtr := nextReg(cg)
    emitfmt(cg, "  %s = load i8*, i8** %s\n", []string{occPtr, occField})

    capField := nextReg(cg)
    emitfmt(cg, "  %s = getelementptr inbounds %s, %s %s, i32 0, i32 3\n", []string{capField, mapStructType, mapLLType, safeMap})
    capReg := nextReg(cg)
    emitfmt(cg, "  %s = load i32, i32* %s\n", []string{capReg, capField})

    countField := nextReg(cg)
    emitfmt(cg, "  %s = getelementptr inbounds %s, %s %s, i32 0, i32 4\n", []string{countField, mapStructType, mapLLType, safeMap})
    countReg := nextReg(cg)
    emitfmt(cg, "  %s = load i32, i32* %s\n", []string{countReg, countField})

    // Allocate found flag and index before the capacity check (needed by both paths).
    foundAlloca := emitAlloca(cg, "i1")
    emitStore(cg, "i1", "0", "i1", foundAlloca)
    idxAlloca := emitAlloca(cg, "i32")
    emitStore(cg, "i32", "0", "i32", idxAlloca)

    // Compute hash (always needed for search path).
    hashReg := nextReg(cg)
    if str.Equal(keyLL, "i8*") {
        emitfmt(cg, "  %s = call i32 @Skink_str_hash(i8* %s)\n", []string{hashReg, keyReg})
    } else {
        hashReg = keyReg
    }

    // Compute startIdx safely: if capacity == 0, use 0 to avoid division by zero.
    capZeroCheck := nextReg(cg)
    emitfmt(cg, "  %s = icmp eq i32 %s, 0\n", []string{capZeroCheck, capReg})
    safeCap := nextReg(cg)
    emitfmt(cg, "  %s = select i1 %s, i32 1, i32 %s\n", []string{safeCap, capZeroCheck, capReg})
    idxReg := nextReg(cg)
    emitfmt(cg, "  %s = srem i32 %s, %s\n", []string{idxReg, hashReg, safeCap})
    negCheck := nextReg(cg)
    emitfmt(cg, "  %s = icmp slt i32 %s, 0\n", []string{negCheck, idxReg})
    negIdx := nextReg(cg)
    emitfmt(cg, "  %s = sub i32 0, %s\n", []string{negIdx, idxReg})
    startIdx := nextReg(cg)
    emitfmt(cg, "  %s = select i1 %s, i32 %s, i32 %s\n", []string{startIdx, negCheck, negIdx, idxReg})

    // If capacity is 0 (empty map), nothing to delete — skip to end.
    endLabel := nextLabel(cg)
    delSearchLabel := nextLabel(cg)
    emitCondBranch(cg, capZeroCheck, endLabel, delSearchLabel)

    emitln(cg, str.Concat(delSearchLabel, ":\n"))
    emitStore(cg, "i32", startIdx, "i32", idxAlloca)

    condLabel := nextLabel(cg)
    bodyLabel := nextLabel(cg)
    foundLabel := nextLabel(cg)
    probeLabel := nextLabel(cg)
    notFoundLabel := nextLabel(cg)
    emitBranch(cg, condLabel)

    emitLabel(cg, condLabel)
    iVal := emitLoad(cg, "i32", "i32", idxAlloca)
    occGep := nextReg(cg)
    emitfmt(cg, "  %s = getelementptr inbounds i8, i8* %s, i32 %s\n", []string{occGep, occPtr, iVal})
    occVal := nextReg(cg)
    emitfmt(cg, "  %s = load i8, i8* %s\n", []string{occVal, occGep})
    occBool := nextReg(cg)
    emitfmt(cg, "  %s = icmp eq i8 %s, 0\n", []string{occBool, occVal})
    emitCondBranch(cg, occBool, notFoundLabel, bodyLabel)

    emitLabel(cg, bodyLabel)
    keyGep := nextReg(cg)
    emitfmt(cg, "  %s = getelementptr inbounds %s, %s* %s, i32 %s\n", []string{keyGep, keyLL, keyLL, keysPtr, iVal})
    keyVal := nextReg(cg)
    emitfmt(cg, "  %s = load %s, %s* %s\n", []string{keyVal, keyLL, keyLL, keyGep})
    isMatch := nextReg(cg)
    if str.Equal(keyLL, "i8*") {
        cmpResult := nextReg(cg)
        emitfmt(cg, "  %s = call i32 @strcmp(i8* %s, i8* %s)\n", []string{cmpResult, keyVal, keyReg})
        emitfmt(cg, "  %s = icmp eq i32 %s, 0\n", []string{isMatch, cmpResult})
    } else {
        emitfmt(cg, "  %s = icmp eq %s %s, %s\n", []string{isMatch, keyLL, keyVal, keyReg})
    }
    emitCondBranch(cg, isMatch, foundLabel, probeLabel)

    emitLabel(cg, foundLabel)
    emitStore(cg, "i1", "1", "i1", foundAlloca)
    emitBranch(cg, endLabel)

    emitLabel(cg, probeLabel)
    nextI := emitBinaryOp(cg, "add", "i32", iVal, "1")
    wrapI := nextReg(cg)
    emitfmt(cg, "  %s = srem i32 %s, %s\n", []string{wrapI, nextI, capReg})
    emitStore(cg, "i32", wrapI, "i32", idxAlloca)
    emitBranch(cg, condLabel)

    emitLabel(cg, notFoundLabel)
    emitBranch(cg, endLabel)

    emitLabel(cg, endLabel)
    wasFound := emitLoad(cg, "i1", "i1", foundAlloca)
    doDeleteLabel := nextLabel(cg)
    skipDeleteLabel := nextLabel(cg)
    emitCondBranch(cg, wasFound, doDeleteLabel, skipDeleteLabel)

    // Do delete: mark slot as unoccupied, release key/value, decrement count,
    // then rehash all entries to maintain probe chain correctness.
    emitLabel(cg, doDeleteLabel)
    delIdx := emitLoad(cg, "i32", "i32", idxAlloca)
    // Release the key and value at the deleted slot.
    delKeyGep := nextReg(cg)
    emitfmt(cg, "  %s = getelementptr inbounds %s, %s* %s, i32 %s\n", []string{delKeyGep, keyLL, keyLL, keysPtr, delIdx})
    delKeyVal := nextReg(cg)
    emitfmt(cg, "  %s = load %s, %s* %s\n", []string{delKeyVal, keyLL, keyLL, delKeyGep})
    if isHeapLLType(keyLL) {
        delKeyCast := nextReg(cg)
        emitfmt(cg, "  %s = bitcast %s %s to i8*\n", []string{delKeyCast, keyLL, delKeyVal})
        emitfmt(cg, "  call void @Skink_rc_release(i8* %s)\n", []string{delKeyCast})
        // Null the released slot: the array destructor scans all capacity
        // slots when the old arrays are freed below, and a stale pointer
        // here would be released a second time.
        emitfmt(cg, "  store %s null, %s* %s\n", []string{keyLL, keyLL, delKeyGep})
    }
    delValGep := nextReg(cg)
    emitfmt(cg, "  %s = getelementptr inbounds %s, %s* %s, i32 %s\n", []string{delValGep, valLL, valLL, valsPtr, delIdx})
    delValVal := nextReg(cg)
    emitfmt(cg, "  %s = load %s, %s* %s\n", []string{delValVal, valLL, valLL, delValGep})
    if isHeapLLType(valLL) {
        delValCast := nextReg(cg)
        emitfmt(cg, "  %s = bitcast %s %s to i8*\n", []string{delValCast, valLL, delValVal})
        emitfmt(cg, "  call void @Skink_rc_release(i8* %s)\n", []string{delValCast})
        emitfmt(cg, "  store %s null, %s* %s\n", []string{valLL, valLL, delValGep})
    }
    // Mark slot as unoccupied.
    delOccGep := nextReg(cg)
    emitfmt(cg, "  %s = getelementptr inbounds i8, i8* %s, i32 %s\n", []string{delOccGep, occPtr, delIdx})
    emitfmt(cg, "  store i8 0, i8* %s\n", []string{delOccGep})
    // Decrement count.
    newCount := emitBinaryOp(cg, "sub", "i32", countReg, "1")
    emitfmt(cg, "  store i32 %s, i32* %s\n", []string{newCount, countField})

    // Rehash: allocate new arrays, iterate over old occupied slots, re-insert.
    keyElemSize := emitElemSize(cg, keyLL)
    valElemSize := emitElemSize(cg, valLL)
    newKeysBytes := nextReg(cg)
    emitfmt(cg, "  %s = mul i32 %s, %s\n", []string{newKeysBytes, capReg, keyElemSize})
    newKeysBytes64 := nextReg(cg)
    emitfmt(cg, "  %s = zext i32 %s to i64\n", []string{newKeysBytes64, newKeysBytes})
    newKeysRaw := emitMapArrayAlloc(cg, keyLL, newKeysBytes64)
    newKeysPtr := nextReg(cg)
    emitfmt(cg, "  %s = bitcast i8* %s to %s*\n", []string{newKeysPtr, newKeysRaw, keyLL})
    newValsBytes := nextReg(cg)
    emitfmt(cg, "  %s = mul i32 %s, %s\n", []string{newValsBytes, capReg, valElemSize})
    newValsBytes64 := nextReg(cg)
    emitfmt(cg, "  %s = zext i32 %s to i64\n", []string{newValsBytes64, newValsBytes})
    newValsRaw := emitMapArrayAlloc(cg, valLL, newValsBytes64)
    newValsPtr := nextReg(cg)
    emitfmt(cg, "  %s = bitcast i8* %s to %s*\n", []string{newValsPtr, newValsRaw, valLL})
    newOccBytes64 := nextReg(cg)
    emitfmt(cg, "  %s = zext i32 %s to i64\n", []string{newOccBytes64, capReg})
    newOccRaw := nextReg(cg)
    emitfmt(cg, "  %s = call i8* @Skink_rc_alloc(i64 %s)\n", []string{newOccRaw, newOccBytes64})
    newOccPtr := nextReg(cg)
    emitfmt(cg, "  %s = bitcast i8* %s to i8*\n", []string{newOccPtr, newOccRaw})
    emitfmt(cg, "  call void @llvm.memset.p0i8.i64(i8* %s, i8 0, i64 %s, i1 false)\n", []string{newOccPtr, newOccBytes64})

    // Iterate over old occupied slots and re-insert into new arrays.
    rehashI := emitAlloca(cg, "i32")
    emitStore(cg, "i32", "0", "i32", rehashI)
    rehashCond := nextLabel(cg)
    rehashBody := nextLabel(cg)
    rehashSkip := nextLabel(cg)
    rehashProbe := nextLabel(cg)
    rehashEnd := nextLabel(cg)
    emitBranch(cg, rehashCond)

    emitLabel(cg, rehashCond)
    riVal := emitLoad(cg, "i32", "i32", rehashI)
    riCond := nextReg(cg)
    emitfmt(cg, "  %s = icmp slt i32 %s, %s\n", []string{riCond, riVal, capReg})
    emitCondBranch(cg, riCond, rehashBody, rehashEnd)

    emitLabel(cg, rehashBody)
    oldOccGep := nextReg(cg)
    emitfmt(cg, "  %s = getelementptr inbounds i8, i8* %s, i32 %s\n", []string{oldOccGep, occPtr, riVal})
    oldOccVal := nextReg(cg)
    emitfmt(cg, "  %s = load i8, i8* %s\n", []string{oldOccVal, oldOccGep})
    oldOccBool := nextReg(cg)
    emitfmt(cg, "  %s = icmp eq i8 %s, 0\n", []string{oldOccBool, oldOccVal})
    emitCondBranch(cg, oldOccBool, rehashSkip, rehashProbe)

    emitLabel(cg, rehashProbe)
    oldKeyGep := nextReg(cg)
    emitfmt(cg, "  %s = getelementptr inbounds %s, %s* %s, i32 %s\n", []string{oldKeyGep, keyLL, keyLL, keysPtr, riVal})
    oldKeyVal := nextReg(cg)
    emitfmt(cg, "  %s = load %s, %s* %s\n", []string{oldKeyVal, keyLL, keyLL, oldKeyGep})
    oldValGep := nextReg(cg)
    emitfmt(cg, "  %s = getelementptr inbounds %s, %s* %s, i32 %s\n", []string{oldValGep, valLL, valLL, valsPtr, riVal})
    oldValVal := nextReg(cg)
    emitfmt(cg, "  %s = load %s, %s* %s\n", []string{oldValVal, valLL, valLL, oldValGep})
    rehashHash := nextReg(cg)
    if str.Equal(keyLL, "i8*") {
        emitfmt(cg, "  %s = call i32 @Skink_str_hash(i8* %s)\n", []string{rehashHash, oldKeyVal})
    } else {
        rehashHash = oldKeyVal
    }
    rehashIdx := nextReg(cg)
    emitfmt(cg, "  %s = srem i32 %s, %s\n", []string{rehashIdx, rehashHash, capReg})
    rehashNeg := nextReg(cg)
    emitfmt(cg, "  %s = icmp slt i32 %s, 0\n", []string{rehashNeg, rehashIdx})
    rehashNegIdx := nextReg(cg)
    emitfmt(cg, "  %s = sub i32 0, %s\n", []string{rehashNegIdx, rehashIdx})
    rehashStart := nextReg(cg)
    emitfmt(cg, "  %s = select i1 %s, i32 %s, i32 %s\n", []string{rehashStart, rehashNeg, rehashNegIdx, rehashIdx})
    rehashProbeAlloca := emitAlloca(cg, "i32")
    emitStore(cg, "i32", rehashStart, "i32", rehashProbeAlloca)
    rehashPCond := nextLabel(cg)
    rehashPBody := nextLabel(cg)
    rehashPStore := nextLabel(cg)
    emitBranch(cg, rehashPCond)

    emitLabel(cg, rehashPCond)
    rpVal := emitLoad(cg, "i32", "i32", rehashProbeAlloca)
    newOccGep := nextReg(cg)
    emitfmt(cg, "  %s = getelementptr inbounds i8, i8* %s, i32 %s\n", []string{newOccGep, newOccPtr, rpVal})
    newOccVal := nextReg(cg)
    emitfmt(cg, "  %s = load i8, i8* %s\n", []string{newOccVal, newOccGep})
    newOccBool := nextReg(cg)
    emitfmt(cg, "  %s = icmp eq i8 %s, 0\n", []string{newOccBool, newOccVal})
    emitCondBranch(cg, newOccBool, rehashPStore, rehashPBody)

    emitLabel(cg, rehashPBody)
    rpNext := emitBinaryOp(cg, "add", "i32", rpVal, "1")
    rpWrap := nextReg(cg)
    emitfmt(cg, "  %s = srem i32 %s, %s\n", []string{rpWrap, rpNext, capReg})
    emitStore(cg, "i32", rpWrap, "i32", rehashProbeAlloca)
    emitBranch(cg, rehashPCond)

    emitLabel(cg, rehashPStore)
    rpStoreVal := emitLoad(cg, "i32", "i32", rehashProbeAlloca)
    nkGep := nextReg(cg)
    emitfmt(cg, "  %s = getelementptr inbounds %s, %s* %s, i32 %s\n", []string{nkGep, keyLL, keyLL, newKeysPtr, rpStoreVal})
    // The new arrays must own a reference to each moved element: retain
    // here so the old arrays' destructor release (below) balances out.
    if isHeapLLType(keyLL) {
        oldKeyVal = emitRetain(cg, oldKeyVal, keyLL)
    }
    if isCompositeType(keyLL) && !str.EndsWith(keyLL, "*") {
        oldKeyVal = emitRetainStructHeapFields(cg, oldKeyVal, keyLL)
    }
    emitStore(cg, keyLL, oldKeyVal, keyLL, nkGep)
    nvGep := nextReg(cg)
    emitfmt(cg, "  %s = getelementptr inbounds %s, %s* %s, i32 %s\n", []string{nvGep, valLL, valLL, newValsPtr, rpStoreVal})
    if isHeapLLType(valLL) {
        oldValVal = emitRetain(cg, oldValVal, valLL)
    }
    if isCompositeType(valLL) && !str.EndsWith(valLL, "*") {
        oldValVal = emitRetainStructHeapFields(cg, oldValVal, valLL)
    }
    emitStore(cg, valLL, oldValVal, valLL, nvGep)
    noGep := nextReg(cg)
    emitfmt(cg, "  %s = getelementptr inbounds i8, i8* %s, i32 %s\n", []string{noGep, newOccPtr, rpStoreVal})
    emitfmt(cg, "  store i8 1, i8* %s\n", []string{noGep})
    emitBranch(cg, rehashSkip)

    emitLabel(cg, rehashSkip)
    riNext := emitBinaryOp(cg, "add", "i32", riVal, "1")
    emitStore(cg, "i32", riNext, "i32", rehashI)
    emitBranch(cg, rehashCond)

    emitLabel(cg, rehashEnd)
    // Update map struct fields with new arrays.
    newKeysField := nextReg(cg)
    emitfmt(cg, "  %s = getelementptr inbounds %s, %s %s, i32 0, i32 0\n", []string{newKeysField, mapStructType, mapLLType, safeMap})
    emitfmt(cg, "  store %s* %s, %s** %s\n", []string{keyLL, newKeysPtr, keyLL, newKeysField})
    newValsField := nextReg(cg)
    emitfmt(cg, "  %s = getelementptr inbounds %s, %s %s, i32 0, i32 1\n", []string{newValsField, mapStructType, mapLLType, safeMap})
    emitfmt(cg, "  store %s* %s, %s** %s\n", []string{valLL, newValsPtr, valLL, newValsField})
    newOccField := nextReg(cg)
    emitfmt(cg, "  %s = getelementptr inbounds %s, %s %s, i32 0, i32 2\n", []string{newOccField, mapStructType, mapLLType, safeMap})
    emitfmt(cg, "  store i8* %s, i8** %s\n", []string{newOccPtr, newOccField})
    // Release old arrays.
    oldKeysRaw := nextReg(cg)
    emitfmt(cg, "  %s = bitcast %s* %s to i8*\n", []string{oldKeysRaw, keyLL, keysPtr})
    emitfmt(cg, "  call void @Skink_rc_release(i8* %s)\n", []string{oldKeysRaw})
    oldValsRaw := nextReg(cg)
    emitfmt(cg, "  %s = bitcast %s* %s to i8*\n", []string{oldValsRaw, valLL, valsPtr})
    emitfmt(cg, "  call void @Skink_rc_release(i8* %s)\n", []string{oldValsRaw})
    oldOccRaw := nextReg(cg)
    emitfmt(cg, "  %s = bitcast i8* %s to i8*\n", []string{oldOccRaw, occPtr})
    emitfmt(cg, "  call void @Skink_rc_release(i8* %s)\n", []string{oldOccRaw})
    emitLabel(cg, skipDeleteLabel)
    return ""
}

// emitPrintCall handles print/println builtins.
fn emitPrintCall(cg: *CodeGen, e: ast.Expr, newline: bool) -> string {
    if len(e.callArgs) == 0 {
        if newline {
            // Print just a newline
            fmtReg := emitStringLiteral(cg, "\n")
            parts := []string{}
            parts = append(parts, "  call i32 (i8*, ...) @printf(i8* ")
            parts = append(parts, fmtReg)
            parts = append(parts, ")")
            emitln(cg, concatMany(parts))
        }
        return ""
    }
    // print/println are declared variadic — every argument gets its own
    // printf call in order. Previously only callArgs[0] was emitted, so
    // print(id, ": ", text) silently dropped everything after the first
    // argument (comp_error.md #124).
    argIdx := 0
    for argIdx < len(e.callArgs) {
        arg := emitExpression(cg, e.callArgs[argIdx])
        argType := exprLLType(cg, e.callArgs[argIdx])

        // Narrow ints: printf varargs read a full i32, so extend explicitly —
        // otherwise the register's upper bits leak through and narrow signed
        // ints render as unsigned (int16(-5) prints 65531).
        if str.Equal(argType, "i8") || str.Equal(argType, "i16") {
            arg = extendNarrowInt(cg, arg, argType, exprIsUnsignedInt(cg, e.callArgs[argIdx]))
            argType = "i32"
        }

        // For bool and array/slice types, convert to string first so they
        // print as "true"/"false" and "[1, 2, 3]" respectively.
        if str.Equal(argType, "i1") {
            arg = emitValAsString(cg, arg, argType)
            argType = "i8*"
        } else if str.EndsWith(argType, "*") && !str.Equal(argType, "i8*") {
            arg = emitValAsString(cg, arg, argType)
            argType = "i8*"
        }

        // Choose format specifier based on argument type
        fmtStr := "%s"
        if str.Equal(argType, "i32") || str.Equal(argType, "i8") || str.Equal(argType, "i16") {
            fmtStr = "%d"
        } else if str.Equal(argType, "i64") {
            fmtStr = "%ld"
        } else if str.Equal(argType, "double") {
            fmtStr = "%f"
        }
        if newline && argIdx == len(e.callArgs) - 1 {
            fmtStr = str.Concat(fmtStr, "\n")
        }
        fmtReg := emitStringLiteral(cg, fmtStr)
        parts := []string{}
        parts = append(parts, "  call i32 (i8*, ...) @printf(i8* ")
        parts = append(parts, fmtReg)
        parts = append(parts, ", ")
        parts = append(parts, argType)
        parts = append(parts, " ")
        parts = append(parts, arg)
        parts = append(parts, ")")
        emitln(cg, concatMany(parts))
        argIdx = argIdx + 1
    }
    return ""
}

// emitAppendCall handles append() builtin.
fn emitAppendCall(cg: *CodeGen, e: ast.Expr) -> string {
    // Consume the self-assign flag before evaluating any sub-expression so a
    // nested append (e.g. x = append(append(x, a), b)) cannot claim it: the
    // inner append's result is an owned temp whose backing store must not be
    // grown out from under it without the ownership compensation done below.
    growVar := cg.appendSelfVar
    cg.appendSelfVar = ""

    arrExpr := e.callArgs[0]
    valExpr := e.callArgs[1]

    // Handle spread append: append(slice, anotherSlice...)
    if valExpr.kind == ast.EX_SPREAD {
        return emitSpreadAppend(cg, e, growVar)
    }

    // mayGrow is only true for the self-assign idiom `x = append(x, ...)`:
    // the first argument must be the very variable being assigned, which is
    // the only proof that its backing array reference is dead. Any other
    // source — a different variable, a field, a non-append call result —
    // must keep its array intact, so those take the copy path even at
    // refcount 1.
    mayGrow := false
    if str.Len(growVar) > 0 && str.Equal(lValueKey(arrExpr), growVar) {
        mayGrow = true
    }

    oldArr := emitExpression(cg, arrExpr)
    arrType := exprLLType(cg, arrExpr)

    var reg string
    // Variadic append: append(s, a, b, ...) appends each extra argument
    // in turn, threading the result array register through. Intermediate
    // results are owned temps visible to no one else, so they may always
    // take the in-place grow path.
    if len(e.callArgs) > 2 {
        reg = emitAppendValues(cg, oldArr, arrType, e.callArgs[1], mayGrow)
        i := 2
        for i < len(e.callArgs) {
            reg = emitAppendValues(cg, reg, arrType, e.callArgs[i], true)
            i = i + 1
        }
    } else {
        reg = emitAppendValues(cg, oldArr, arrType, valExpr, mayGrow)
    }

    // When the grow path took the array's reference over in place, the result
    // is bitwise the same pointer the variable held. The caller's
    // release-of-old-value plus the statement temp release expect the result
    // to carry its own reference, so retain once when the pointers alias.
    // When the block moved or a fresh copy was made, no compensation is
    // needed (the old pointer is either gone from the RC table or a still-
    // owned distinct block).
    if mayGrow {
        emitRetainIfAliased(cg, reg, arrType, oldArr, arrType)
    }
    return reg
}

// lValueKey returns a stable textual key for simple l-value expressions —
// an identifier or a field path rooted at an identifier ("x", "t.vals",
// "a.b.c"). Returns "" for anything else (indexing, dereference, calls),
// which callers treat as "not a matchable l-value".
fn lValueKey(e: ast.Expr) -> string {
    if e.kind == ast.EX_IDENT {
        return e.ident
    }
    if e.kind == ast.EX_FIELD && len(e.fieldTarget) > 0 {
        base := lValueKey(e.fieldTarget[0])
        if str.Len(base) > 0 {
            return str.Concat(base, str.Concat(".", e.fieldName))
        }
    }
    return ""
}

// emitRetainIfAliased emits a runtime pointer comparison between newReg and
// oldReg, retaining newReg only when they are the same block. Used to
// compensate the extra release an aliasing self-assignment performs.
fn emitRetainIfAliased(cg: *CodeGen, newReg: string, newType: string, oldReg: string, oldType: string) {
    newRaw := newReg
    if !str.Equal(newType, "i8*") {
        newRaw = nextReg(cg)
        emitfmt(cg, "  %s = bitcast %s %s to i8*\n", []string{newRaw, newType, newReg})
    }
    oldRaw := oldReg
    if !str.Equal(oldType, "i8*") {
        oldRaw = nextReg(cg)
        emitfmt(cg, "  %s = bitcast %s %s to i8*\n", []string{oldRaw, oldType, oldReg})
    }
    sameReg := nextReg(cg)
    emitfmt(cg, "  %s = icmp eq i8* %s, %s\n", []string{sameReg, newRaw, oldRaw})
    sameLabel := nextLabel(cg)
    contLabel := nextLabel(cg)
    emitCondBranch(cg, sameReg, sameLabel, contLabel)
    emitLabel(cg, sameLabel)
    emitfmt(cg, "  call i8* @Skink_rc_retain(i8* %s)\n", []string{newRaw})
    emitBranch(cg, contLabel)
    emitLabel(cg, contLabel)
}

// emitAppendValues emits one element append onto an array register.
// oldArr is the array pointer (arrType), valExpr the element to append.
// mayGrow permits the in-place geometric growth path; when false the append
// always copies into a fresh backing array so the source stays untouched.
fn emitAppendValues(cg: *CodeGen, oldArr: string, arrType: string, valExpr: ast.Expr, mayGrow: bool) -> string {
    // Derive the slice element type from the array pointer type. Using the
    // array's element type (rather than the value's type) fixes append on
    // []uint8/[]int8: an integer literal value has LLVM type i32, but the slice
    // stores i8 elements. It also makes appending a typed value to a slice of a
    // different (but assignable) width reliable.
    elemType := arrType
    if str.EndsWith(elemType, "**") {
        // Slice of pointers/slices: keep one trailing * (e.g. i8** -> i8*).
        elemType = str.Substr(elemType, 0, str.Len(elemType) - 1)
    } else if str.EndsWith(elemType, "*") {
        elemType = str.Substr(elemType, 0, str.Len(elemType) - 1)
    }

    valReg := emitExpression(cg, valExpr)
    valType := exprLLType(cg, valExpr)

    // Struct-by-value: when appending a struct literal (which returns a
    // pointer) to a slice of inline structs, load the struct value from
    // the pointer and retain its heap fields.
    if str.StartsWith(valType, "%struct.") && str.EndsWith(valType, "*") &&
        !str.EndsWith(str.Substr(valType, 0, str.Len(valType) - 1), "*") {
        // valType is a pointer to a struct (e.g., from struct literal)
        structValType := str.Substr(valType, 0, str.Len(valType) - 1)
        // Check if the array stores inline structs (arrType matches structValType*)
        if str.Equal(arrType, str.Concat(structValType, "*")) {
            loaded := emitLoad(cg, structValType, structValType, valReg)
            valReg = emitRetainStructHeapFields(cg, loaded, structValType)
            valType = structValType
        }
    } else if str.StartsWith(valType, "%struct.") && !str.EndsWith(valType, "*") {
        valReg = emitRetainStructHeapFields(cg, valReg, valType)
    }

    // Coerce the appended value to the slice's element type and use that
    // for all sizing/storing decisions going forward.
    valReg = coerceExprToParamType(cg, valReg, valType, elemType, valExpr)
    valType = elemType

    // Retain plain pointer values (strings, slices) so that the new
    // array owns a reference.  Without this, when the original owner
    // releases the value, the array holds a dangling pointer, causing
    // a use-after-free.  Slice blocks are allocated with Skink_rc_alloc
    // (NULL destructor), so the retained pointers are not released when
    // the containing slice is freed — this is a deliberate leak, which
    // is far safer than the crash it prevents.
    if isHeapLLType(valType) {
        valReg = emitRetain(cg, valReg, valType)
    }

    return emitAppendCore(cg, oldArr, arrType, valType, valReg, mayGrow)
}

// emitAppendCore appends one already-coerced, already-retained element
// register to a slice value. Under the fat-slice ABI the result is always
// a (possibly new) slice header of type arrType.
fn emitAppendCore(cg: *CodeGen, oldArr: string, arrType: string, valType: string, valReg: string, mayGrow: bool) -> string {
    elemSizeI32 := emitElemSize(cg, valType)
    elemSizeI64 := nextReg(cg)
    emitfmt(cg, "  %s = zext i32 %s to i64\n", []string{elemSizeI64, elemSizeI32})

    // Determine the array element destructor so that retained elements are
    // released when the slice's backing array is freed.
    arrDtorName := getOrCreateArrayDtor(cg, valType)
    arrDtorPtr := "null"
    if str.Len(arrDtorName) > 0 {
        arrDtorPtr = str.Concat("i8* bitcast (void (i8*)* @", str.Concat(arrDtorName, " to i8*)"))
    }

    // Fat-slice ABI: the slice register is a header. Read its fields, then
    // take one of three paths — spare capacity (write the shared backing and
    // mint a longer header), unique in-place grow (mutate the header after
    // Skink_slice_ensure reallocs the backing), or copy.
    oldHdrRaw := emitI8Ptr(cg, oldArr, arrType)
    isNull := nextReg(cg)
    emitfmt(cg, "  %s = icmp eq i8* %s, null\n", []string{isNull, oldHdrRaw})

    nullLabel := nextLabel(cg)
    notNullLabel := nextLabel(cg)
    capLabel := nextLabel(cg)
    growGateLabel := nextLabel(cg)
    tryEnsureLabel := nextLabel(cg)
    doGrowLabel := nextLabel(cg)
    growDoneLabel := nextLabel(cg)
    copyLabel := nextLabel(cg)
    mergeLabel := nextLabel(cg)
    emitCondBranch(cg, isNull, nullLabel, notNullLabel)

    // NULL header: fresh 1-element backing wrapped in a header.
    emitLabel(cg, nullLabel)
    rawNull := nextReg(cg)
    if str.Len(arrDtorName) > 0 {
        emitfmt(cg, "  %s = call i8* @Skink_rc_alloc_typed(i64 %s, %s)\n", []string{rawNull, elemSizeI64, arrDtorPtr})
    } else {
        emitfmt(cg, "  %s = call i8* @Skink_rc_alloc(i64 %s)\n", []string{rawNull, elemSizeI64})
    }
    lenPtrNull := nextReg(cg)
    emitfmt(cg, "  %s = getelementptr inbounds i8, i8* %s, i64 -8\n", []string{lenPtrNull, rawNull})
    typedLenPtrNull := nextReg(cg)
    emitfmt(cg, "  %s = bitcast i8* %s to i64*\n", []string{typedLenPtrNull, lenPtrNull})
    emitfmt(cg, "  store i64 1, i64* %s\n", []string{typedLenPtrNull})
    typedElemStartNull := emitFromI8Ptr(cg, rawNull, str.Concat(valType, "*"))
    emitStore(cg, valType, valReg, valType, typedElemStartNull)
    nullHdr := nextReg(cg)
    emitfmt(cg, "  %s = call i8* @Skink_slice_hdr(i8* %s, i64 1, i64 1, i8* %s)\n", []string{nullHdr, rawNull, rawNull})
    emitBranch(cg, mergeLabel)

    // NOT NULL: unwrap the header fields.
    emitLabel(cg, notNullLabel)
    oldLenReg := nextReg(cg)
    emitfmt(cg, "  %s = call i64 @Skink_slice_len(i8* %s)\n", []string{oldLenReg, oldHdrRaw})
    oldCapReg := nextReg(cg)
    emitfmt(cg, "  %s = call i64 @Skink_slice_cap(i8* %s)\n", []string{oldCapReg, oldHdrRaw})
    oldDataReg := nextReg(cg)
    emitfmt(cg, "  %s = call i8* @Skink_slice_data(i8* %s)\n", []string{oldDataReg, oldHdrRaw})
    oldBaseReg := nextReg(cg)
    emitfmt(cg, "  %s = call i8* @Skink_slice_base(i8* %s)\n", []string{oldBaseReg, oldHdrRaw})
    newLenReg := nextReg(cg)
    emitfmt(cg, "  %s = add i64 %s, 1\n", []string{newLenReg, oldLenReg})
    bytesNeeded := nextReg(cg)
    emitfmt(cg, "  %s = mul i64 %s, %s\n", []string{bytesNeeded, newLenReg, elemSizeI64})
    emitBranch(cg, growGateLabel)

    // In-place append (either into existing spare capacity or by growing via
    // Skink_slice_ensure) is safe only when mayGrow is true, the slice is a
    // full-backing owner (cap >= 0; subslice views carry cap == -1), and BOTH
    // the header and its backing allocation have refcount == 1.
    emitLabel(cg, growGateLabel)
    if mayGrow {
        hdrRc := nextReg(cg)
        emitfmt(cg, "  %s = call i64 @Skink_rc_count(i8* %s)\n", []string{hdrRc, oldHdrRaw})
        hdrUnique := nextReg(cg)
        emitfmt(cg, "  %s = icmp eq i64 %s, 1\n", []string{hdrUnique, hdrRc})
        notView := nextReg(cg)
        emitfmt(cg, "  %s = icmp sge i64 %s, 0\n", []string{notView, oldCapReg})
        baseNonNull := nextReg(cg)
        emitfmt(cg, "  %s = icmp ne i8* %s, null\n", []string{baseNonNull, oldBaseReg})
        gate1 := nextReg(cg)
        emitfmt(cg, "  %s = and i1 %s, %s\n", []string{gate1, hdrUnique, notView})
        gateOk := nextReg(cg)
        emitfmt(cg, "  %s = and i1 %s, %s\n", []string{gateOk, gate1, baseNonNull})
        emitCondBranch(cg, gateOk, tryEnsureLabel, copyLabel)

        emitLabel(cg, tryEnsureLabel)
        baseRc := nextReg(cg)
        emitfmt(cg, "  %s = call i64 @Skink_rc_count(i8* %s)\n", []string{baseRc, oldBaseReg})
        baseUnique := nextReg(cg)
        emitfmt(cg, "  %s = icmp eq i64 %s, 1\n", []string{baseUnique, baseRc})
        fitsCap := nextReg(cg)
        emitfmt(cg, "  %s = icmp sle i64 %s, %s\n", []string{fitsCap, newLenReg, oldCapReg})
        canInPlaceCap := nextReg(cg)
        emitfmt(cg, "  %s = and i1 %s, %s\n", []string{canInPlaceCap, baseUnique, fitsCap})
        checkGrowLabel := nextLabel(cg)
        emitCondBranch(cg, canInPlaceCap, capLabel, checkGrowLabel)

        // Uniquely-owned spare capacity: store the element at data[oldLen] and
        // bump both the backing element-count slot and header len in place.
        emitLabel(cg, capLabel)
        capDataT := emitFromI8Ptr(cg, oldDataReg, str.Concat(valType, "*"))
        capEnd := nextReg(cg)
        emitfmt(cg, "  %s = getelementptr %s, %s* %s, i64 %s\n", []string{capEnd, valType, valType, capDataT, oldLenReg})
        emitStore(cg, valType, valReg, valType, capEnd)
        capCntPtr := nextReg(cg)
        emitfmt(cg, "  %s = getelementptr inbounds i8, i8* %s, i64 -8\n", []string{capCntPtr, oldBaseReg})
        capCntTyped := nextReg(cg)
        emitfmt(cg, "  %s = bitcast i8* %s to i64*\n", []string{capCntTyped, capCntPtr})
        emitfmt(cg, "  store i64 %s, i64* %s\n", []string{newLenReg, capCntTyped})
        capHp := nextReg(cg)
        emitfmt(cg, "  %s = bitcast i8* %s to %hdr.slice*\n", []string{capHp, oldHdrRaw})
        capFldLen := nextReg(cg)
        emitfmt(cg, "  %s = getelementptr %hdr.slice, %hdr.slice* %s, i32 0, i32 1\n", []string{capFldLen, capHp})
        emitfmt(cg, "  store i64 %s, i64* %s\n", []string{newLenReg, capFldLen})
        emitBranch(cg, mergeLabel)

        emitLabel(cg, checkGrowLabel)
        emitCondBranch(cg, baseUnique, doGrowLabel, copyLabel)

        emitLabel(cg, doGrowLabel)
        grownRaw := nextReg(cg)
        emitfmt(cg, "  %s = call i8* @Skink_slice_ensure(i8* %s, i64 %s)\n", []string{grownRaw, oldBaseReg, bytesNeeded})
        ensureOk := nextReg(cg)
        emitfmt(cg, "  %s = icmp ne i8* %s, null\n", []string{ensureOk, grownRaw})
        emitCondBranch(cg, ensureOk, growDoneLabel, copyLabel)

        // Update the solely-owned header in place — base and data move to the
        // grown block and cap reflects the new capacity.
        emitLabel(cg, growDoneLabel)
        hp := nextReg(cg)
        emitfmt(cg, "  %s = bitcast i8* %s to %hdr.slice*\n", []string{hp, oldHdrRaw})
        capBytesReg := nextReg(cg)
        emitfmt(cg, "  %s = call i64 @Skink_rc_capacity(i8* %s)\n", []string{capBytesReg, grownRaw})
        capElems := nextReg(cg)
        emitfmt(cg, "  %s = udiv i64 %s, %s\n", []string{capElems, capBytesReg, elemSizeI64})
        fldData := nextReg(cg)
        emitfmt(cg, "  %s = getelementptr %hdr.slice, %hdr.slice* %s, i32 0, i32 0\n", []string{fldData, hp})
        emitfmt(cg, "  store i8* %s, i8** %s\n", []string{grownRaw, fldData})
        fldLen := nextReg(cg)
        emitfmt(cg, "  %s = getelementptr %hdr.slice, %hdr.slice* %s, i32 0, i32 1\n", []string{fldLen, hp})
        emitfmt(cg, "  store i64 %s, i64* %s\n", []string{newLenReg, fldLen})
        fldCap := nextReg(cg)
        emitfmt(cg, "  %s = getelementptr %hdr.slice, %hdr.slice* %s, i32 0, i32 2\n", []string{fldCap, hp})
        emitfmt(cg, "  store i64 %s, i64* %s\n", []string{capElems, fldCap})
        fldBase := nextReg(cg)
        emitfmt(cg, "  %s = getelementptr %hdr.slice, %hdr.slice* %s, i32 0, i32 3\n", []string{fldBase, hp})
        emitfmt(cg, "  store i8* %s, i8** %s\n", []string{grownRaw, fldBase})
        // Backing element count for Skink_array_dtor_sized = live element count.
        cntPtr := nextReg(cg)
        emitfmt(cg, "  %s = getelementptr inbounds i8, i8* %s, i64 -8\n", []string{cntPtr, grownRaw})
        cntTyped := nextReg(cg)
        emitfmt(cg, "  %s = bitcast i8* %s to i64*\n", []string{cntTyped, cntPtr})
        emitfmt(cg, "  store i64 %s, i64* %s\n", []string{newLenReg, cntTyped})
        gDataT := emitFromI8Ptr(cg, grownRaw, str.Concat(valType, "*"))
        gEnd := nextReg(cg)
        emitfmt(cg, "  %s = getelementptr %s, %s* %s, i64 %s\n", []string{gEnd, valType, valType, gDataT, oldLenReg})
        emitStore(cg, valType, valReg, valType, gEnd)
        emitBranch(cg, mergeLabel)
    } else {
        emitBranch(cg, copyLabel)
    }

    // Shared or foreign backing: copy into a fresh block sized for newLen.
    emitLabel(cg, copyLabel)
    rawNew := nextReg(cg)
    if str.Len(arrDtorName) > 0 {
        emitfmt(cg, "  %s = call i8* @Skink_rc_alloc_typed(i64 %s, %s)\n", []string{rawNew, bytesNeeded, arrDtorPtr})
    } else {
        emitfmt(cg, "  %s = call i8* @Skink_rc_alloc(i64 %s)\n", []string{rawNew, bytesNeeded})
    }
    lenPtrNew := nextReg(cg)
    emitfmt(cg, "  %s = getelementptr inbounds i8, i8* %s, i64 -8\n", []string{lenPtrNew, rawNew})
    typedLenPtrNew := nextReg(cg)
    emitfmt(cg, "  %s = bitcast i8* %s to i64*\n", []string{typedLenPtrNew, lenPtrNew})
    emitfmt(cg, "  store i64 %s, i64* %s\n", []string{newLenReg, typedLenPtrNew})
    typedElemStartNew := emitFromI8Ptr(cg, rawNew, str.Concat(valType, "*"))
    oldDataT := emitFromI8Ptr(cg, oldDataReg, str.Concat(valType, "*"))

    // Copy old elements, retaining heap-reachable ones so the new array
    // owns its own references.
    copyIdxAlloca := emitAlloca(cg, "i64")
    emitfmt(cg, "  store i64 0, i64* %s\n", []string{copyIdxAlloca})
    loopCondLabel := nextLabel(cg)
    loopBodyLabel := nextLabel(cg)
    loopEndLabel := nextLabel(cg)
    emitBranch(cg, loopCondLabel)

    emitLabel(cg, loopCondLabel)
    currIdx := nextReg(cg)
    emitfmt(cg, "  %s = load i64, i64* %s\n", []string{currIdx, copyIdxAlloca})
    comp := nextReg(cg)
    emitfmt(cg, "  %s = icmp slt i64 %s, %s\n", []string{comp, currIdx, oldLenReg})
    emitCondBranch(cg, comp, loopBodyLabel, loopEndLabel)

    emitLabel(cg, loopBodyLabel)
    srcGep := nextReg(cg)
    emitfmt(cg, "  %s = getelementptr %s, %s* %s, i64 %s\n", []string{srcGep, valType, valType, oldDataT, currIdx})
    srcVal := nextReg(cg)
    emitfmt(cg, "  %s = load %s, %s* %s\n", []string{srcVal, valType, valType, srcGep})
    if isHeapLLType(valType) {
        srcVal = emitRetain(cg, srcVal, valType)
    } else if isCompositeType(valType) && !str.EndsWith(valType, "*") {
        srcVal = emitRetainStructHeapFields(cg, srcVal, valType)
    }
    dstGep := nextReg(cg)
    emitfmt(cg, "  %s = getelementptr %s, %s* %s, i64 %s\n", []string{dstGep, valType, valType, typedElemStartNew, currIdx})
    emitStore(cg, valType, srcVal, valType, dstGep)
    nextIdx := nextReg(cg)
    emitfmt(cg, "  %s = add i64 %s, 1\n", []string{nextIdx, currIdx})
    emitfmt(cg, "  store i64 %s, i64* %s\n", []string{nextIdx, copyIdxAlloca})
    emitBranch(cg, loopCondLabel)

    emitLabel(cg, loopEndLabel)
    endGep := nextReg(cg)
    emitfmt(cg, "  %s = getelementptr %s, %s* %s, i64 %s\n", []string{endGep, valType, valType, typedElemStartNew, oldLenReg})
    emitStore(cg, valType, valReg, valType, endGep)
    copyHdr := nextReg(cg)
    emitfmt(cg, "  %s = call i8* @Skink_slice_hdr(i8* %s, i64 %s, i64 %s, i8* %s)\n",
        []string{copyHdr, rawNew, newLenReg, newLenReg, rawNew})
    emitBranch(cg, mergeLabel)

    emitLabel(cg, mergeLabel)
    resHdr := nextReg(cg)
    if mayGrow {
        emitfmt(cg, "  %s = phi i8* [%s, %s], [%s, %s], [%s, %s], [%s, %s]\n",
            []string{resHdr, nullHdr, str.Concat("%", nullLabel), oldHdrRaw, str.Concat("%", capLabel),
                     oldHdrRaw, str.Concat("%", growDoneLabel), copyHdr, str.Concat("%", loopEndLabel)})
    } else {
        emitfmt(cg, "  %s = phi i8* [%s, %s], [%s, %s]\n",
            []string{resHdr, nullHdr, str.Concat("%", nullLabel),
                     copyHdr, str.Concat("%", loopEndLabel)})
    }
    return emitFromI8Ptr(cg, resHdr, arrType)
}

// emitSpreadAppend handles append(slice, anotherSlice...) by iterating
// over the source slice and appending each element to the destination.
// growVar is the self-assign variable name consumed by emitAppendCall (or
// "" — see CodeGen.appendSelfVar): in-place growth is only allowed when the
// destination is that exact variable and the source is not the same slice.
fn emitSpreadAppend(cg: *CodeGen, e: ast.Expr, growVar: string) -> string {
    arrExpr := e.callArgs[0]
    spreadExpr := e.callArgs[1].spreadExpr[0]

    // In-place growth is only safe for `d = append(d, src...)`: the
    // destination's backing reference is dead, and the source must not be
    // the same slice (s = append(s, s...) would read elements from an array
    // being grown beneath it).
    mayGrow := false
    if str.Len(growVar) > 0 && str.Equal(lValueKey(arrExpr), growVar) &&
        !str.Equal(lValueKey(spreadExpr), growVar) {
        mayGrow = true
    }

    // Get the destination slice.
    dstArr := emitExpression(cg, arrExpr)

    // Get the source slice.
    srcArr := emitExpression(cg, spreadExpr)
    srcType := exprLLType(cg, spreadExpr)

    // Element type (strip * from pointer type).
    elemType := srcType
    if str.EndsWith(elemType, "*") {
        elemType = str.Substr(elemType, 0, str.Len(elemType) - 1)
    }

    // Get source length. Byte slices share i8* with strings; strings use
    // strlen, slices use Skink_slice_len — nil-safe and view-aware (a
    // view's length is not stored at payload-8).
    srcLen := nextReg(cg)
    if str.Equal(srcType, "i8*") && !exprIsByteSlice(cg, spreadExpr) {
        emitfmt(cg, "  %s = call i64 @strlen(i8* %s)\n", []string{srcLen, srcArr})
    } else {
        castReg := emitI8Ptr(cg, srcArr, srcType)
        emitfmt(cg, "  %s = call i64 @Skink_slice_len(i8* %s)\n", []string{srcLen, castReg})
    }

    // Loop: for i = 0; i < srcLen; i++ { dstArr = append(dstArr, srcArr[i]) }
    // When !mayGrow, detach dstArr into a fresh private header once before the
    // loop so every iteration can grow in place without mutating the caller's
    // source slice or leaking intermediate headers.
    startDst := dstArr
    if !mayGrow {
        startDst = emitSliceCopyValue(cg, dstArr, srcType, elemType)
    }
    iAlloca := emitAlloca(cg, "i32")
    emitStore(cg, "i32", "0", "i32", iAlloca)
    dstAlloca := emitAlloca(cg, srcType)
    emitStore(cg, srcType, startDst, srcType, dstAlloca)
    // A slice source is a slice header under the fat-slice ABI: unwrap
    // its element base pointer once here; the loop GEPs against it. A
    // string source stays a raw i8*.
    srcData := srcArr
    if !str.Equal(srcType, "i8*") || exprIsByteSlice(cg, spreadExpr) {
        srcRaw := emitSliceData(cg, srcArr, srcType)
        srcData = emitFromI8Ptr(cg, srcRaw, str.Concat(elemType, "*"))
    }

    condLabel := nextLabel(cg)
    bodyLabel := nextLabel(cg)
    endLabel := nextLabel(cg)

    emitBranch(cg, condLabel)
    emitLabel(cg, condLabel)
    iVal := emitLoad(cg, "i32", "i32", iAlloca)
    i64Val := nextReg(cg)
    emitfmt(cg, "  %s = sext i32 %s to i64\n", []string{i64Val, iVal})
    condReg := nextReg(cg)
    emitfmt(cg, "  %s = icmp slt i64 %s, %s\n", []string{condReg, i64Val, srcLen})
    emitCondBranch(cg, condReg, bodyLabel, endLabel)

    emitLabel(cg, bodyLabel)
    // Load element from source.
    indices := []string{}
    indices = append(indices, iVal)
    elemPtr := emitGEP(cg, elemType, str.Concat(elemType, "*"), srcData, indices)
    elemVal := emitLoad(cg, elemType, elemType, elemPtr)

    // Retain heap elements.
    if isHeapLLType(elemType) {
        elemVal = emitRetain(cg, elemVal, elemType)
    }

    // Append through the shared append core (header-aware).
    curDst := emitLoad(cg, srcType, srcType, dstAlloca)
    newDst := emitAppendCore(cg, curDst, srcType, elemType, elemVal, true)
    emitStore(cg, srcType, newDst, srcType, dstAlloca)

    // i = i + 1
    nextI := emitBinaryOp(cg, "add", "i32", iVal, "1")
    emitStore(cg, "i32", nextI, "i32", iAlloca)
    emitBranch(cg, condLabel)

    emitLabel(cg, endLabel)
    result := emitLoad(cg, srcType, srcType, dstAlloca)
    // If the destination was grown in place, result aliases the array the
    // source variable held — retain it so the caller's release-of-old plus
    // temp release don't free the live block (see emitRetainIfAliased).
    if mayGrow {
        dstType := exprLLType(cg, arrExpr)
        emitRetainIfAliased(cg, result, srcType, dstArr, dstType)
    }
    return result
}

// emitPanicCall handles panic() builtin.
fn emitPanicCall(cg: *CodeGen, e: ast.Expr) -> string {
    if len(e.callArgs) > 0 {
        msg := emitExpression(cg, e.callArgs[0])
        parts := []string{}
        parts = append(parts, "  call void @Skink_panic(i8* ")
        parts = append(parts, msg)
        parts = append(parts, ")")
        emitln(cg, concatMany(parts))
    }
    return ""
}

// emitMethodCall handles method calls (obj.method()).
// In Skink, methods are functions with a self parameter, so
// obj.method(a, b) becomes method(obj, a, b).
// resolveMethodCallFnName determines the LLVM function symbol name for a
// method-call-syntax expression (obj.method(args)), plus whether it was
// resolved as a module-qualified call with no implicit receiver argument
// (isModuleCall). Shared between emitMethodCall (codegen) and
// exprCallLLType (type inference) so both stay in sync.
fn resolveMethodCallFnName(cg: *CodeGen, fnExpr: ast.Expr) -> (string, bool) {
    methodName := fnExpr.fieldName
    receiverExpr := fnExpr.fieldTarget[0]

    // Determine the function name to call
    fnName := methodName
    isModuleCall := false
    // Try qualified name based on receiver type
    receiverType := exprLLType(cg, receiverExpr)
    if str.StartsWith(receiverType, "%struct.") {
        structName := str.Substr(receiverType, str.Len("%struct."), str.Len(receiverType) - str.Len("%struct."))
        if str.Contains(structName, "*") {
            structName = str.Substr(structName, 0, str.IndexOf(structName, "*"))
        }
        // Try StructName.method (struct name as sanitized in LLVM type names,
        // i.e. dots replaced with underscores to match cg.fnRetTypes keys
        // that use the same sanitization for struct-qualified method names).
        found := false
        candidates := []string{}
        candidates = append(candidates, str.Concat(structName, str.Concat(".", methodName)))
        // Also try with '.' in place of the LAST '_' in case the struct name is
        // module-qualified with dots (e.g. "rules_test.SensorSource") rather than
        // the underscore-sanitized LLVM form (e.g. "rules_test_SensorSource").
        // We only replace the last underscore to avoid corrupting module names
        // that contain underscores (e.g. "rules_test").
        lastUnderscore := str.LastIndexOf(structName, "_")
        if lastUnderscore > 0 {
            dottedName := str.Concat(str.Substr(structName, 0, lastUnderscore), str.Concat(".", str.Substr(structName, lastUnderscore + 1, str.Len(structName) - lastUnderscore - 1)))
            candidates = append(candidates, str.Concat(dottedName, str.Concat(".", methodName)))
        }
        // UFCS: try module.methodName where module is extracted from the
        // struct name (e.g. str_Builder -> str.Write). This handles
        // module-level functions that take a struct pointer as first param.
        underscoreIdx := str.IndexOf(structName, "_")
        if underscoreIdx > 0 {
            moduleName := str.Substr(structName, 0, underscoreIdx)
            candidates = append(candidates, str.Concat(moduleName, str.Concat(".", methodName)))
        }
        i := 0
        for i < len(candidates) && !found {
            hasQualified := mapStringStringSliceHasKeyCG(cg.fnRetTypes, candidates[i])
            if hasQualified {
                fnName = candidates[i]
                found = true
            }
            i = i + 1
        }
        if !found {
            // Module names containing underscores defeat the
            // first-underscore split above (e.g. "writer_template_0001_Write"
            // backing `writer_template_0001_StringBuilder`). Scan
            // registered functions for a `mod.method` key whose sanitized
            // module name prefixes the struct's LLVM name.
            wantSuffix := str.Concat(".", methodName)
            for k in cg.fnRetTypes {
                if str.EndsWith(k, wantSuffix) {
                    recvPart := str.Substr(k, 0, str.Len(k) - str.Len(wantSuffix))
                    if str.StartsWith(structName, str.Concat(sanitizeName(recvPart), "_")) {
                        // First param must take this struct type so a
                        // shorter module prefix can't shadow the real one.
                        ps := cg.fnParamTypes[k]
                        if len(ps) > 0 {
                            p0 := ps[0]
                            for str.EndsWith(p0, "*") {
                                p0 = str.Substr(p0, 0, str.Len(p0) - 1)
                            }
                            if str.Equal(p0, str.Concat("%struct.", structName)) {
                                fnName = k
                                found = true
                            }
                        }
                    }
                }
            }
        }
        // Plain module-level function taking `self` as first parameter
        // (UFCS-style call), registered under its module-qualified name.
        if !found && str.Len(cg.currentModule) > 0 {
            moduleQualified := str.Concat(cg.currentModule, str.Concat(".", methodName))
            if mapStringStringSliceHasKeyCG(cg.fnRetTypes, moduleQualified) {
                fnName = moduleQualified
                found = true
            }
        }
    }
    // Try module-qualified name
    if receiverExpr.kind == ast.EX_IDENT {
        receiverName := receiverExpr.ident
        _, isLocal := lookupVar(cg, receiverName)
        isGlobal := mapStringStringHasKeyCG(cg.globalVarTypes, receiverName)
        if !isLocal && !isGlobal {
            // Resolve import alias (e.g. "tsr" -> "tensor")
            resolvedModule := resolveImportAliasCG(cg, receiverName)
            qualifiedName := str.Concat(resolvedModule, str.Concat(".", methodName))
            hasQualified := mapStringStringSliceHasKeyCG(cg.fnRetTypes, qualifiedName)
            if hasQualified {
                fnName = qualifiedName
                isModuleCall = true
            } else {
                // Also try with the original alias name
                aliasQualified := str.Concat(receiverName, str.Concat(".", methodName))
                hasAliasQualified := mapStringStringSliceHasKeyCG(cg.fnRetTypes, aliasQualified)
                if hasAliasQualified {
                    fnName = aliasQualified
                    isModuleCall = true
                } else {
                    // C externs from std/libc are registered without a module
                    // prefix, while source calls use the libc.name form.
                    hasExtern := mapStringStringSliceHasKeyCG(cg.fnRetTypes, methodName)
                    if hasExtern {
                        fnName = methodName
                        isModuleCall = true
                    }
                }
            }
        }
    }
    return fnName, isModuleCall
}

// lookupTemplateMethodRetType searches all registered templates for a method
// with the given name and returns its LLVM return type, or "" if not found.
fn lookupTemplateMethodRetType(cg: *CodeGen, methodName: string) -> string {
    // Iterate through templates via the checker's template map.
    // Since Skink doesn't support map iteration, we use the checker's
    // templateNames list if available, or try common module-qualified names.
    names := checker.templateNames(cg.checker)
    i := 0
    for i < len(names) {
        tmpl := checker.getTemplate(cg.checker, names[i])
        j := 0
        for j < len(tmpl.templateMethods) {
            if str.Equal(tmpl.templateMethods[j].fnName, methodName) {
                m := tmpl.templateMethods[j]
                if len(m.fnRetTypes) > 0 {
                    t := checker.astTypeToType(cg.checker, m.fnRetTypes[0])
                    return llvmType(cg, t)
                }
                return "void"
            }
            j = j + 1
        }
        i = i + 1
    }
    return ""
}

// emitMethodCall emits a method call expression (obj.method(args)).
fn emitMethodCall(cg: *CodeGen, e: ast.Expr) -> string {
    fnExpr := e.callFunc[0]
    receiverExpr := fnExpr.fieldTarget[0]
    methodName := fnExpr.fieldName

    // Template dispatch: if receiver is a template fat pointer, emit indirect call
    tmplRecvLLType := exprLLType(cg, receiverExpr)
    if str.StartsWith(tmplRecvLLType, "%template.") {
        return emitTemplateMethodCall(cg, e, methodName, receiverExpr, tmplRecvLLType)
    }

    // Special handling for registerRule on rulesets: generate wrapper functions
    // for the dynamic rule source's triggered/Action/start/stop methods.
    if str.Equal(methodName, "registerRule") && len(e.callArgs) > 0 {
        // Check if the receiver is a ruleset
        recvName := ""
        if receiverExpr.kind == ast.EX_IDENT {
            recvName = receiverExpr.ident
        }
        isRuleset := false
        if str.Len(recvName) > 0 {
            // Check both short and qualified names
            _, isLocal := lookupVar(cg, recvName)
            isGlobal := mapStringStringHasKeyCG(cg.globalVarTypes, recvName)
            if !isLocal && !isGlobal {
                // It's a module/type name — check if it's a ruleset
                // by looking up the registerRule function
                regQn := str.Concat(recvName, str.Concat(".", "registerRule"))
                hasReg := mapStringStringSliceHasKeyCG(cg.fnRetTypes, regQn)
                if hasReg {
                    isRuleset = true
                }
            }
        }
        if isRuleset {
            return emitRegisterRuleCall(cg, e, recvName)
        }
    }

    fnName, isModuleCall := resolveMethodCallFnName(cg, fnExpr)

    // Get return type
    hasFn := mapStringStringSliceHasKeyCG(cg.fnRetTypes, fnName)
    retType := "void"
    if hasFn && len(cg.fnRetTypes[fnName]) > 0 {
        if len(cg.fnRetTypes[fnName]) > 1 {
            retType = aggregateRetType(cg.fnRetTypes[fnName])
        } else {
            retType = cg.fnRetTypes[fnName][0]
        }
    }

    // If the method is not a known function, it may be a template method.
    // Look up the return type from the template declaration and register it.
    if !hasFn {
        tmplRetType := lookupTemplateMethodRetType(cg, fnName)
        if str.Len(tmplRetType) > 0 {
            retType = tmplRetType
            // Register so future lookups find it
            cg.fnRetTypes[fnName] = []string{}
            cg.fnRetTypes[fnName] = append(cg.fnRetTypes[fnName], retType)
            // Emit a declare so the IR verifies (the concrete implementation
            // will be provided when the template is monomorphized or when
            // a concrete type implements the method).
            emitHeader(cg, str.Concat(str.Concat(str.Concat("declare ", retType), str.Concat(" @", fnName)), "(...)\n"))
            hasFn = true
        }
    }

    if isModuleCall {
        args := []string{}
        i := 0
        for i < len(e.callArgs) {
            argReg := emitExpression(cg, e.callArgs[i])
            argType := exprLLType(cg, e.callArgs[i])
            hasParams := mapStringStringSliceHasKeyCG(cg.fnParamTypes, fnName)
            if hasParams && i < len(cg.fnParamTypes[fnName]) {
                expected := cg.fnParamTypes[fnName][i]
                argReg = coerceExprToParamType(cg, argReg, argType, expected, e.callArgs[i])
                argType = expected
            }
            args = append(args, str.Concat(argType, str.Concat(" ", argReg)))
            i = i + 1
        }
        // Generic module-qualified calls erase to i8* — convert back to
        // the checker's substituted concrete type.
        return coerceGenericCallResult(cg, e, emitCall(cg, retType, fnName, args), retType)
    }

    // Not a method and not a module function: the field may hold a
    // function value (closure). Call it through its i8* handle. The
    // checker's fn-field path records the field access's semantic type
    // so exprSkinkType finds it here.
    if !hasFn {
        ft := exprSkinkType(cg, fnExpr)
        if ft.kind == checker.TK_NAMED {
            ft = resolveAliasCG(cg, ft)
        }
        if ft.kind == checker.TK_FUNCTION {
            retType, cparams := closureCallTypes(cg, ft)
            handleReg := emitExpression(cg, fnExpr)
            args := []string{}
            i := 0
            for i < len(e.callArgs) {
                argReg := emitExpression(cg, e.callArgs[i])
                argType := exprLLType(cg, e.callArgs[i])
                if i < len(cparams) {
                    expected := cparams[i]
                    argReg = coerceExprToParamType(cg, argReg, argType, expected, e.callArgs[i])
                    argType = expected
                }
                args = append(args, str.Concat(argType, str.Concat(" ", argReg)))
                i = i + 1
            }
            return emitClosureCall(cg, retType, cparams, handleReg, args)
        }
    }

    // Emit receiver as first argument
    receiverReg, receiverLLType := emitMethodReceiver(cg, receiverExpr, fnName)
    args := []string{}
    args = append(args, str.Concat(receiverLLType, str.Concat(" ", receiverReg)))

    // Emit remaining arguments
    i := 0
    for i < len(e.callArgs) {
        argReg := emitExpression(cg, e.callArgs[i])
        argType := exprLLType(cg, e.callArgs[i])
        // Fall back to declared param type (offset by 1 for receiver)
        hasParams := mapStringStringSliceHasKeyCG(cg.fnParamTypes, fnName)
        if hasParams && i + 1 < len(cg.fnParamTypes[fnName]) {
            expected := cg.fnParamTypes[fnName][i + 1]
            argReg = coerceExprToParamType(cg, argReg, argType, expected, e.callArgs[i])
            argType = expected
        }
        args = append(args, str.Concat(argType, str.Concat(" ", argReg)))
        i = i + 1
    }

    return coerceGenericCallResult(cg, e, emitCall(cg, retType, fnName, args), retType)
}

// emitMethodReceiver emits the receiver value for a method call, coercing
// it to the callee's declared self-parameter convention (pointer vs value).
// Returns the receiver register and its LLVM type. Shared between
// emitMethodCall and emitSpawnStmt so spawned method calls pass the
// receiver the same way synchronous calls do.
fn emitMethodReceiver(cg: *CodeGen, receiverExpr: ast.Expr, fnName: string) -> (string, string) {
    hasParams := mapStringStringSliceHasKeyCG(cg.fnParamTypes, fnName)
    needsPointerReceiver := false
    if hasParams && len(cg.fnParamTypes[fnName]) > 0 {
        expectedType := cg.fnParamTypes[fnName][0]
        if str.EndsWith(expectedType, "*") {
            recvLLT := exprLLType(cg, receiverExpr)
            if !str.EndsWith(recvLLT, "*") {
                needsPointerReceiver = true
            }
        }
    }

    var receiverReg string
    var receiverLLType string
    if needsPointerReceiver && receiverExpr.kind == ast.EX_IDENT {
        // For local variables, pass the address of the variable directly
        // so mutations persist (Go-like auto-addressing).
        sv, ok := lookupVar(cg, receiverExpr.ident)
        if ok {
            // Struct-by-value variables are stored as heap pointers in allocas.
            // &var should return the heap pointer, not the alloca address.
            if sv.escaped || str.Len(sv.heapSlot) > 0 {
                // Boxed local: the heap block pointer is the receiver.
                receiverReg = varValuePtr(cg, sv)
                receiverLLType = str.Concat(sv.llType, "*")
            } else if str.StartsWith(sv.llType, "%struct.") && str.EndsWith(sv.llType, "*") {
                receiverReg = emitLoad(cg, sv.llType, sv.llType, sv.alloca)
                receiverLLType = sv.llType
            } else {
                receiverReg = sv.alloca
                receiverLLType = str.Concat(sv.llType, "*")
            }
        } else {
            // lookupVar only covers locals — a module-level var is still
            // an lvalue: globals live at @name / @module.name, so pass
            // that address and self-mutations persist. Without this,
            // `g.Add(1)` on a package-level WaitGroup silently mutates a
            // stack copy (comp_error.md #87).
            gname := ""
            if mapStringStringHasKeyCG(cg.globalVarTypes, receiverExpr.ident) {
                gname = receiverExpr.ident
            } else if str.Len(cg.currentModule) > 0 {
                qn := str.Concat(str.Concat(cg.currentModule, "."), receiverExpr.ident)
                if mapStringStringHasKeyCG(cg.globalVarTypes, qn) {
                    gname = qn
                }
            }
            if str.Len(gname) > 0 {
                receiverReg = str.Concat("@", gname)
                receiverLLType = str.Concat(exprLLType(cg, receiverExpr), "*")
            } else {
                // Fall back to expression + temp copy
                receiverReg = emitExpression(cg, receiverExpr)
                receiverLLType = exprLLType(cg, receiverExpr)
                tmpAlloca := emitAlloca(cg, receiverLLType)
                emitStore(cg, receiverLLType, receiverReg, receiverLLType, tmpAlloca)
                receiverReg = tmpAlloca
                receiverLLType = str.Concat(receiverLLType, "*")
            }
        }
    } else if needsPointerReceiver && receiverExpr.kind == ast.EX_FIELD {
        // For struct fields (e.g., cg.moduleHeader.Write(s)), get the
        // address of the field directly so mutations persist.
        receiverReg = emitAddressOf(cg, receiverExpr)
        receiverLLType = str.Concat(exprLLType(cg, receiverExpr), "*")
    } else if needsPointerReceiver {
        // Non-identifier receiver: create temp copy and pass pointer
        receiverReg = emitExpression(cg, receiverExpr)
        receiverLLType = exprLLType(cg, receiverExpr)
        tmpAlloca := emitAlloca(cg, receiverLLType)
        emitStore(cg, receiverLLType, receiverReg, receiverLLType, tmpAlloca)
        receiverReg = tmpAlloca
        receiverLLType = str.Concat(receiverLLType, "*")
    } else {
        receiverReg = emitExpression(cg, receiverExpr)
        receiverLLType = exprLLType(cg, receiverExpr)
        // If method expects a pointer but receiver is a struct value,
        // allocate a temporary copy and pass the pointer
        if hasParams && len(cg.fnParamTypes[fnName]) > 0 {
            expectedType := cg.fnParamTypes[fnName][0]
            if str.EndsWith(expectedType, "*") && !str.EndsWith(receiverLLType, "*") {
                tmpAlloca := emitAlloca(cg, receiverLLType)
                emitStore(cg, receiverLLType, receiverReg, receiverLLType, tmpAlloca)
                receiverReg = tmpAlloca
                receiverLLType = expectedType
            }
        }
    }
    return receiverReg, receiverLLType
}

// emitIndexExpr handles array/map indexing.
// emitFromEndExpr handles arr[^i] from-end indexing.
// It computes len(arr) - i and then does a normal index.
fn emitFromEndExpr(cg: *CodeGen, e: ast.Expr) -> string {
    target := emitExpression(cg, e.indexTarget[0])
    leftType := exprLLType(cg, e.indexTarget[0])

    // Compute len(arr)
    lenReg := emitLenCallRaw(cg, target, leftType, e.indexTarget[0])

    // Compute len(arr) - index
    idxExpr := emitExpression(cg, e.indexExpr[0])
    realIdx := nextReg(cg)
    emitfmt(cg, "  %s = sub i32 %s, %s\n", []string{realIdx, lenReg, idxExpr})

    // String and byte-slice indexing
    if str.Equal(leftType, "i8*") {
        base := target
        if exprIsByteSlice(cg, e.indexTarget[0]) {
            base = emitSliceData(cg, target, leftType)
        }
        gep := nextReg(cg)
        emitfmt(cg, "  %s = getelementptr inbounds i8, i8* %s, i32 %s\n", []string{gep, base, realIdx})
        reg := nextReg(cg)
        emitfmt(cg, "  %s = load i8, i8* %s\n", []string{reg, gep})
        zext := nextReg(cg)
        emitfmt(cg, "  %s = zext i8 %s to i32\n", []string{zext, reg})
        return zext
    }

    // Array/slice indexing — unwrap h->data for slice headers.
    elemType := exprLLType(cg, e)
    actualBase := target
    elemPtrType := str.Concat(elemType, "*")
    if exprIsSlice(cg, e.indexTarget[0]) {
        dataPtr := emitSliceData(cg, target, leftType)
        actualBase = emitFromI8Ptr(cg, dataPtr, elemPtrType)
    } else if !str.Equal(leftType, elemPtrType) {
        castReg := nextReg(cg)
        emitfmt(cg, "  %s = bitcast %s %s to %s*\n", []string{castReg, leftType, target, elemType})
        actualBase = castReg
    }
    indices := []string{}
    indices = append(indices, realIdx)
    elemPtr := emitGEP(cg, elemType, elemPtrType, actualBase, indices)
    return emitLoad(cg, elemType, elemType, elemPtr)
}

// emitLenCallRaw computes len() for a given target register and type,
// without going through the EX_CALL dispatch. Used by emitFromEndExpr.
// The source expression is supplied so i8* values can be disambiguated:
// strings use strlen, while []uint8/[]int8 slices read length from offset -8.
fn emitLenCallRaw(cg: *CodeGen, target: string, leftType: string, expr: ast.Expr) -> string {
    // String (null-safe). Byte slices ([]uint8/[]int8) share the i8* LLVM type
    // and must fall through to the array path below.
    if str.Equal(leftType, "i8*") && !exprIsByteSlice(cg, expr) {
        nullCheck := nextReg(cg)
        emitfmt(cg, "  %s = icmp eq i8* %s, null\n", []string{nullCheck, target})
        safePtr := nextReg(cg)
        emptyStr := emitStringLiteral(cg, "")
        emitfmt(cg, "  %s = select i1 %s, i8* %s, i8* %s\n", []string{safePtr, nullCheck, emptyStr, target})
        r := nextReg(cg)
        emitfmt(cg, "  %s = call i64 @strlen(i8* %s)\n", []string{r, safePtr})
        r2 := nextReg(cg)
        emitfmt(cg, "  %s = trunc i64 %s to i32\n", []string{r2, r})
        return r2
    }
    // Map
    lenKeyLL, lenValLL, isMap := parseMapTypeLL(leftType)
    if isMap && !str.EndsWith(leftType, "**") {
        emitMapTypeDecl(cg, mapTypeName(lenKeyLL, lenValLL), lenKeyLL, lenValLL)
        mapType := str.Substr(leftType, 0, str.Len(leftType) - 1)
        // A nil map has length 0 (Go semantics). GEP through a zeroed
        // stand-in map header so the count load never dereferences null.
        zeroMap := emitAlloca(cg, mapType)
        isNullMap := nextReg(cg)
        emitfmt(cg, "  %s = icmp eq %s %s, null\n", []string{isNullMap, leftType, target})
        safeMap := nextReg(cg)
        emitfmt(cg, "  %s = select i1 %s, %s %s, %s %s\n", []string{safeMap, isNullMap, leftType, zeroMap, leftType, target})
        lenField := nextReg(cg)
        emitfmt(cg, "  %s = getelementptr inbounds %s, %s %s, i32 0, i32 4\n", []string{lenField, mapType, leftType, safeMap})
        lenReg := nextReg(cg)
        emitfmt(cg, "  %s = load i32, i32* %s\n", []string{lenReg, lenField})
        return lenReg
    }
    // Set
    if str.StartsWith(leftType, "%set.") && str.EndsWith(leftType, "*") && !str.EndsWith(leftType, "**") {
        setType := str.Substr(leftType, 0, str.Len(leftType) - 1)
        zeroSet := emitAlloca(cg, setType)
        isNullSet := nextReg(cg)
        emitfmt(cg, "  %s = icmp eq %s %s, null\n", []string{isNullSet, leftType, target})
        safeSet := nextReg(cg)
        emitfmt(cg, "  %s = select i1 %s, %s %s, %s %s\n", []string{safeSet, isNullSet, leftType, zeroSet, leftType, target})
        lenField := nextReg(cg)
        emitfmt(cg, "  %s = getelementptr inbounds %s, %s %s, i32 0, i32 1\n", []string{lenField, setType, leftType, safeSet})
        lenReg := nextReg(cg)
        emitfmt(cg, "  %s = load i32, i32* %s\n", []string{lenReg, lenField})
        return lenReg
    }
    // Array: element count via the runtime — Skink_slice_len handles nil
    // (0) and slice views, whose length is not stored at payload-8.
    rawPtr := emitI8Ptr(cg, target, leftType)
    lenReg64 := nextReg(cg)
    emitfmt(cg, "  %s = call i64 @Skink_slice_len(i8* %s)\n", []string{lenReg64, rawPtr})
    truncReg := nextReg(cg)
    emitfmt(cg, "  %s = trunc i64 %s to i32\n", []string{truncReg, lenReg64})
    return truncReg
}

// emitIndexAsI32 coerces an index register to i32 for GEP/bounds-check
// use: i64 indices truncate, narrow i8/i16 indices zext (an out-of-range
// or negative value then trips the bounds check). Index registers are
// otherwise passed through unchanged.
fn emitIndexAsI32(cg: *CodeGen, idxReg: string, idxExpr: ast.Expr) -> string {
    idxLL := exprLLType(cg, idxExpr)
    if str.Equal(idxLL, "i64") {
        r := nextReg(cg)
        emitfmt(cg, "  %s = trunc i64 %s to i32\n", []string{r, idxReg})
        return r
    }
    if str.Len(idxLL) > 0 && !str.Equal(idxLL, "i32") &&
       (str.Equal(idxLL, "i8") || str.Equal(idxLL, "i16")) {
        r := nextReg(cg)
        emitfmt(cg, "  %s = zext %s %s to i32\n", []string{r, idxLL, idxReg})
        return r
    }
    return idxReg
}

// emitIndexBoundsCheck emits Skink_bounds_check(i, i+1, len) before an
// element index `a[i]` — unchecked indexing is silent UB
// (comp_error.md #78). Only slice-typed targets are checked: the checker's
// recorded type must be TK_ARRAY (or, lacking a record, an i8* target
// that exprIsByteSlice recognises as a byte slice). Raw *T pointer
// indexing stays unchecked — pointers have no length header. Plain
// strings are also unchecked: they are NUL-terminated with no header,
// and a strlen per index would make per-char loops quadratic.
fn emitIndexBoundsCheck(cg: *CodeGen, targetExpr: ast.Expr, target: string, leftType: string, idxReg: string, idxExpr: ast.Expr) {
    isSlice := false
    tt := checker.exprTypeLookup(cg.checker, cg.currentFilePath, targetExpr.line, targetExpr.col)
    if tt.kind == checker.TK_NAMED {
        tt = resolveAliasCG(cg, tt)
    }
    if tt.kind == checker.TK_ARRAY {
        isSlice = true
    } else if tt.kind == 0 && str.Equal(leftType, "i8*") && exprIsByteSlice(cg, targetExpr) {
        isSlice = true
    }
    if !isSlice {
        return
    }
    // Slice element count via Skink_slice_len: nil-safe (0, so any index
    // trips the bounds panic — comp_error.md #69) and view-aware, since a
    // view's length is not stored at payload-8.
    rawPtr := emitI8Ptr(cg, target, leftType)
    lenReg := nextReg(cg)
    emitfmt(cg, "  %s = call i64 @Skink_slice_len(i8* %s)\n", []string{lenReg, rawPtr})
    // Skink_bounds_check takes i32 params; coerce the index and length.
    lo := emitIndexAsI32(cg, idxReg, idxExpr)
    hi := nextReg(cg)
    emitfmt(cg, "  %s = add i32 %s, 1\n", []string{hi, lo})
    len32 := nextReg(cg)
    emitfmt(cg, "  %s = trunc i64 %s to i32\n", []string{len32, lenReg})
    emitfmt(cg, "  call void @Skink_bounds_check(i32 %s, i32 %s, i32 %s)\n", []string{lo, hi, len32})
}

// emitIndexExpr emits an index access expression (arr[i], m[key], s[i]).
fn emitIndexExpr(cg: *CodeGen, e: ast.Expr) -> string {
    target := emitExpression(cg, e.indexTarget[0])
    leftType := exprLLType(cg, e.indexTarget[0])
    
    // Check if this is a map index access
    // A slice of maps has type %map_...** (double pointer) — indexing into
    // it is array indexing, not map indexing.
    keyLL, valLL, isMap := parseMapTypeLL(leftType)
    if isMap && !str.EndsWith(leftType, "**") {
        idx := emitExpression(cg, e.indexExpr[0])
        return emitMapIndex(cg, target, idx, keyLL, valLL)
    }
    
    // String and byte-slice indexing. Strings are raw i8*; byte slices
    // share the i8* LLVM type but are slice headers under the fat-slice
    // ABI — unwrap the element base pointer before the GEP.
    if str.Equal(leftType, "i8*") {
        idx := emitExpression(cg, e.indexExpr[0])
        emitIndexBoundsCheck(cg, e.indexTarget[0], target, leftType, idx, e.indexExpr[0])
        idx = emitIndexAsI32(cg, idx, e.indexExpr[0])
        base := target
        if exprIsByteSlice(cg, e.indexTarget[0]) {
            base = emitSliceData(cg, target, leftType)
        }
        gep := nextReg(cg)
        emitfmt(cg, "  %s = getelementptr inbounds i8, i8* %s, i32 %s\n", []string{gep, base, idx})
        reg := nextReg(cg)
        emitfmt(cg, "  %s = load i8, i8* %s\n", []string{reg, gep})
        zext := nextReg(cg)
        emitfmt(cg, "  %s = zext i8 %s to i32\n", []string{zext, reg})
        return zext
    }

    idx := emitExpression(cg, e.indexExpr[0])
    emitIndexBoundsCheck(cg, e.indexTarget[0], target, leftType, idx, e.indexExpr[0])
    idx = emitIndexAsI32(cg, idx, e.indexExpr[0])
    elemType := exprLLType(cg, e)

    // Slice values are headers — the element base lives at h->data.
    // Raw *T pointers index their pointee directly.
    actualBase := target
    elemPtrType := str.Concat(elemType, "*")
    if exprIsSlice(cg, e.indexTarget[0]) {
        dataPtr := emitSliceData(cg, target, leftType)
        actualBase = emitFromI8Ptr(cg, dataPtr, elemPtrType)
    } else if !str.Equal(leftType, elemPtrType) {
        castReg := nextReg(cg)
        emitfmt(cg, "  %s = bitcast %s %s to %s*\n", []string{castReg, leftType, target, elemType})
        actualBase = castReg
    }

    indices := []string{}
    indices = append(indices, idx)
    elemPtr := emitGEP(cg, elemType, elemPtrType, actualBase, indices)
    return emitLoad(cg, elemType, elemType, elemPtr)
}

// emitFieldAccessExpr handles struct field access.
fn emitFieldAccessExpr(cg: *CodeGen, e: ast.Expr) -> string {
    target := emitExpression(cg, e.fieldTarget[0])
    fieldName := e.fieldName

    // Get the struct type of the receiver
    leftType := exprLLType(cg, e.fieldTarget[0])

    // Module-qualified constant or variable access
    if e.fieldTarget[0].kind == ast.EX_IDENT {
        receiverName := e.fieldTarget[0].ident
        // Check if receiver is a module name (not a local variable)
        _, isLocal := lookupVar(cg, receiverName)
        isGlobal := mapStringStringHasKeyCG(cg.globalVarTypes, receiverName)
        if !isLocal && !isGlobal {
            // This is a module-qualified access: module.field
            qualifiedName := str.Concat(receiverName, str.Concat(".", fieldName))
            // Check global var
            gvt := cg.globalVarTypes[qualifiedName]
            hasGvt := mapStringStringHasKeyCG(cg.globalVarTypes, qualifiedName)
            if hasGvt {
                globalPtr := str.Concat("@", qualifiedName)
                return emitLoad(cg, gvt, gvt, globalPtr)
            }
            // Check const
            val := cg.consts[qualifiedName]
            if val.kind != 0 {
                return emitConstExpr(cg, qualifiedName)
            }
            // Check unqualified const
            val2 := cg.consts[fieldName]
            if val2.kind != 0 {
                return emitConstExpr(cg, fieldName)
            }
            // Check function reference (module.function)
            hasFn := mapStringStringSliceHasKeyCG(cg.fnRetTypes, qualifiedName)
            if hasFn {
                return emitClosureValue(cg, qualifiedName)
            }
            hasFn2 := mapStringStringSliceHasKeyCG(cg.fnRetTypes, fieldName)
            if hasFn2 {
                return emitClosureValue(cg, fieldName)
            }
        }
    }

    // Struct field access
    if str.StartsWith(leftType, "%struct.") {
        structName := str.Substr(leftType, str.Len("%struct."), str.Len(leftType) - str.Len("%struct."))
        if str.Contains(structName, "*") {
            structName = str.Substr(structName, 0, str.IndexOf(structName, "*"))
        }
        layout := cg.structLayouts[structName]
        hasLayout := str.Len(layout.llType) > 0
        if hasLayout {
            fieldIdx := -1
            i := 0
            for i < len(layout.fields) {
                if str.Equal(layout.fields[i], fieldName) {
                    fieldIdx = i
                    break
                }
                i = i + 1
            }
            if fieldIdx >= 0 {
                fieldType := layout.fieldTypes[fieldIdx]
                structPtrType := str.Concat(layout.llType, "*")
                basePtr := target
                if !str.EndsWith(leftType, "*") {
                    valueAlloca := emitAlloca(cg, leftType)
                    emitStore(cg, leftType, target, leftType, valueAlloca)
                    basePtr = valueAlloca
                }
                indices := []string{}
                indices = append(indices, "i32 0")
                indices = append(indices, str.Concat("i32 ", strconv.Itoa(fieldIdx)))
                fieldPtr := emitGEP(cg, layout.llType, structPtrType, basePtr, indices)
                return emitLoad(cg, fieldType, fieldType, fieldPtr)
            }
        }
    }

    // Template method/field access: e.g. tr.r.Read where r is a template
    // fat pointer. Methods are stored as function pointers (i8*) in the
    // template struct at index methodIdx + 1.
    if str.StartsWith(leftType, "%template.") {
        tmplName, ok := findTemplateByLLType(cg, leftType)
        if ok {
            tmpl := checker.getTemplate(cg.checker, tmplName)
            methodIdx := -1
            mi := 0
            for mi < len(tmpl.templateMethods) {
                if str.Equal(tmpl.templateMethods[mi].fnName, fieldName) {
                    methodIdx = mi
                    break
                }
                mi = mi + 1
            }
            if methodIdx >= 0 {
                structType := templateLLTypeStruct(tmplName)
                // Null check: if the fat pointer is null, return null
                nullCmp := nextReg(cg)
                emitfmt(cg, "  %s = icmp eq %s %s, null\n", []string{nullCmp, leftType, target})
                nullLbl := nextLabel(cg)
                nonNullLbl := nextLabel(cg)
                endLbl := nextLabel(cg)
                emitCondBranch(cg, nullCmp, nullLbl, nonNullLbl)
                emitLabel(cg, nullLbl)
                emitBranch(cg, endLbl)
                emitLabel(cg, nonNullLbl)
                fnGEP := nextReg(cg)
                emitfmt(cg, "  %s = getelementptr inbounds %s, %s %s, i32 0, i32 %s\n",
                    []string{fnGEP, structType, leftType, target, strconv.Itoa(methodIdx + 1)})
                fnReg := nextReg(cg)
                emitfmt(cg, "  %s = load i8*, i8** %s\n", []string{fnReg, fnGEP})
                emitBranch(cg, endLbl)
                emitLabel(cg, endLbl)
                resultReg := nextReg(cg)
                emitln(cg, concatMany([]string{"  ", resultReg, " = phi i8* [ null, %", nullLbl, " ], [ ", fnReg, ", %", nonNullLbl, " ]"}))
                return resultReg
            }
        }
    }

    // Fallback: return target
    return target
}

// emitArrayLiteral handles array literals.
fn emitArrayLiteral(cg: *CodeGen, e: ast.Expr) -> string {
    n := len(e.arrayElems)
    // Prefer the declared element type ([]T{...}) over first-element
    // inference — []uint8{1,2,3} must emit i8 elements, not i32
    // (comp_error.md #26). Untyped literals fall back to inference.
    elemType := "i32"
    if len(e.arrayType) > 0 {
        t := checker.astTypeToType(cg.checker, e.arrayType[0])
        elemType = llvmType(cg, t)
    } else if n > 0 {
        elemType = exprLLType(cg, e.arrayElems[0])
    }
    // Compute the allocation size: n * sizeof(elemType).
    // The slice length is stored at payload - 8 (the RC header's size
    // field), not in the payload itself.
    elemSizeReg := emitElemSize(cg, elemType)
    elemSizeI64 := nextReg(cg)
    emitfmt(cg, "  %s = zext i32 %s to i64\n", []string{elemSizeI64, elemSizeReg})
    nBytes := nextReg(cg)
    emitfmt(cg, "  %s = mul i64 %s, %s\n", []string{nBytes, strconv.Itoa(n), elemSizeI64})
    // Use typed allocation with array destructor if the element type
    // holds heap-reachable values.
    arrDtorName := getOrCreateArrayDtor(cg, elemType)
    allocReg := nextReg(cg)
    if str.Len(arrDtorName) > 0 {
        arrDtorPtr := str.Concat("i8* bitcast (void (i8*)* @", str.Concat(arrDtorName, " to i8*)"))
        emitfmt(cg, "  %s = call i8* @Skink_rc_alloc_typed(i64 %s, %s)\n", []string{allocReg, nBytes, arrDtorPtr})
    } else {
        emitfmt(cg, "  %s = call i8* @Skink_rc_alloc(i64 %s)\n", []string{allocReg, nBytes})
    }

    // Store the slice length at payload - 8 (RC header size field)
    lenPtr := nextReg(cg)
    emitfmt(cg, "  %s = getelementptr inbounds i8, i8* %s, i64 -8\n", []string{lenPtr, allocReg})
    typedLenPtr := nextReg(cg)
    emitfmt(cg, "  %s = bitcast i8* %s to i64*\n", []string{typedLenPtr, lenPtr})
    emitfmt(cg, "  store i64 %s, i64* %s\n", []string{strconv.Itoa(n), typedLenPtr})

    arrReg := nextReg(cg)
    parts2 := []string{}
    parts2 = append(parts2, "  ")
    parts2 = append(parts2, arrReg)
    parts2 = append(parts2, " = bitcast i8* ")
    parts2 = append(parts2, allocReg)
    parts2 = append(parts2, " to ")
    parts2 = append(parts2, elemType)
    parts2 = append(parts2, "*")
    emitln(cg, concatMany(parts2))

    // Store elements
    i := 0
    for i < n {
        elemReg := emitExpression(cg, e.arrayElems[i])
        elemValType := exprLLType(cg, e.arrayElems[i])
        elemReg = coerceExprToParamType(cg, elemReg, elemValType, elemType, e.arrayElems[i])
        // Retain heap elements so the array owns a reference. The array's
        // destructor will release each element when the array is freed.
        if isHeapLLType(elemType) {
            elemReg = emitRetain(cg, elemReg, elemType)
        } else if str.StartsWith(elemType, "%struct.") && !str.EndsWith(elemType, "*") {
            elemReg = emitRetainStructHeapFields(cg, elemReg, elemType)
        }
        indices := []string{}
        indices = append(indices, strconv.Itoa(i))
        elemPtr := emitGEP(cg, elemType, str.Concat(elemType, "*"), arrReg, indices)
        emitStore(cg, elemType, elemReg, elemType, elemPtr)
        i = i + 1
    }
    // Wrap the backing array in a slice header: {data, len, cap, base}
    // where data == base (a full slice owns its storage from index 0).
    hdrReg := nextReg(cg)
    nStr := strconv.Itoa(n)
    emitfmt(cg, "  %s = call i8* @Skink_slice_hdr(i8* %s, i64 %s, i64 %s, i8* %s)\n",
        []string{hdrReg, allocReg, nStr, nStr, allocReg})
    return emitFromI8Ptr(cg, hdrReg, str.Concat(elemType, "*"))
}

// emitStructInitExpr handles struct literal expressions.
fn emitStructInitExpr(cg: *CodeGen, e: ast.Expr) -> string {
    structName := e.structLitName
    // Qualify struct name with current module if unqualified
    // (handles cases where multiple modules define structs with the same name)
    if !str.Contains(structName, ".") && str.Len(cg.currentModule) > 0 {
        qualified := str.Concat(cg.currentModule, str.Concat(".", structName))
        qualifiedLayout := cg.structLayouts[qualified]
        if str.Len(qualifiedLayout.llType) > 0 {
            structName = qualified
        }
    }
    layout := cg.structLayouts[structName]
    hasLayout := str.Len(layout.llType) > 0
    if !hasLayout {
        return "null"
    }
    // Allocate struct on heap. Whenever a destructor trampoline exists —
    // a user Drop or RC-managed fields to release — the block must be a
    // typed allocation so rc_release invokes it (comp_error.md #99).
    allocReg := nextReg(cg)
    if structHasDtorTrampoline(cg, layout) {
        // Use the layout's llType to derive the correct trampoline name,
        // since structName may be a short name while the trampoline is
        // defined with the fully qualified name.
        llStructName := str.Substr(layout.llType, str.Len("%struct."), str.Len(layout.llType) - str.Len("%struct."))
        trampolineName := str.Concat(llStructName, "__dtor")
        dtorPtr := str.Concat("i8* bitcast (void (i8*)* @", str.Concat(trampolineName, " to i8*)"))
        emitfmt(cg, "  %s = call i8* @Skink_rc_alloc_typed(i64 %s, %s)\n", []string{allocReg, strconv.Itoa(layout.size), dtorPtr})
    } else {
        parts := []string{}
        parts = append(parts, "  ")
        parts = append(parts, allocReg)
        parts = append(parts, " = call i8* @Skink_rc_alloc(i64 ")
        parts = append(parts, strconv.Itoa(layout.size))
        parts = append(parts, ")")
        emitln(cg, concatMany(parts))
    }

    // Cast to struct pointer
    structPtrType := str.Concat(layout.llType, "*")
    structPtr := nextReg(cg)
    parts2 := []string{}
    parts2 = append(parts2, "  ")
    parts2 = append(parts2, structPtr)
    parts2 = append(parts2, " = bitcast i8* ")
    parts2 = append(parts2, allocReg)
    parts2 = append(parts2, " to ")
    parts2 = append(parts2, structPtrType)
    emitln(cg, concatMany(parts2))

    // Track which fields are explicitly set
    setFields := make([]bool, len(layout.fields))

    // Store each field
    i := 0
    for i < len(e.structLitFields) {
        field := e.structLitFields[i]
        fieldIdx := -1
        j := 0
        for j < len(layout.fields) {
            if str.Equal(layout.fields[j], field.name) {
                fieldIdx = j
                break
            }
            j = j + 1
        }
        if fieldIdx >= 0 && len(field.value) > 0 {
            setFields[fieldIdx] = true
            valReg := emitExpression(cg, field.value[0])
            fieldType := layout.fieldTypes[fieldIdx]
            // Coerce the value to the field's type: template fat
            // pointers, struct pointer → by-value load, integer width
            // narrowing/widening (e.g. a `-5` unary expr emits i32 into
            // an i16 field), int → float, pointer → i8*.
            valLL := exprLLType(cg, field.value[0])
            valReg = coerceExprToParamType(cg, valReg, valLL, fieldType, field.value[0])
            // Retain heap values when storing into struct fields
            // to prevent use-after-free when the source is deallocated
            if isHeapLLType(fieldType) {
                valReg = emitRetain(cg, valReg, fieldType)
            } else if str.StartsWith(fieldType, "%struct.") && !str.EndsWith(fieldType, "*") {
                valReg = emitRetainStructHeapFields(cg, valReg, fieldType)
            }
            indices := []string{}
            indices = append(indices, "i32 0")
            indices = append(indices, str.Concat("i32 ", strconv.Itoa(fieldIdx)))
            fieldPtr := emitGEP(cg, layout.llType, structPtrType, structPtr, indices)
            emitStore(cg, fieldType, valReg, fieldType, fieldPtr)
        }
        i = i + 1
    }
    // Initialize unset string fields to empty string (NULL causes strcmp crashes)
    k := 0
    for k < len(layout.fields) {
        if !setFields[k] && str.Equal(layout.fieldTypes[k], "i8*") {
            emptyStr := emitStringLiteral(cg, "")
            indices2 := []string{}
            indices2 = append(indices2, "i32 0")
            indices2 = append(indices2, str.Concat("i32 ", strconv.Itoa(k)))
            fieldPtr2 := emitGEP(cg, layout.llType, structPtrType, structPtr, indices2)
            emitfmt(cg, "  store i8* %s, i8** %s\n", []string{emptyStr, fieldPtr2})
        }
        k = k + 1
    }
    // Return the struct pointer (structs are heap-allocated in skink-pure)
    return structPtr
}

// releaseStructLiteralBlock emits release code for a heap-allocated struct block.
fn releaseStructLiteralBlock(cg: *CodeGen, ptr: string, structLLType: string) {
    if str.Equal(ptr, "") || str.Equal(ptr, "0") {
        return
    }
    cast := nextReg(cg)
    parts := []string{}
    parts = append(parts, "  ")
    parts = append(parts, cast)
    parts = append(parts, " = bitcast ")
    parts = append(parts, structLLType)
    parts = append(parts, " ")
    parts = append(parts, ptr)
    parts = append(parts, " to i8*")
    emitln(cg, concatMany(parts))
    parts2 := []string{}
    parts2 = append(parts2, "  call void @Skink_rc_release(i8* ")
    parts2 = append(parts2, cast)
    parts2 = append(parts2, ")")
    emitln(cg, concatMany(parts2))
}

// emitSliceExpr handles slice expressions (arr[low:high], arr[:high], arr[low:]).
// Strings always produce a fresh NUL-terminated copy. Array slices are
// three-way: low > 0 produces an RC-registered interior-pointer view that
// shares the backing array; s[0:len] is an identity alias (retained);
// s[0:k] with k < len copies — see the comment in the array path below.
fn emitSliceExpr(cg: *CodeGen, e: ast.Expr) -> string {
    target := emitExpression(cg, e.sliceTarget[0])
    targetType := exprLLType(cg, e.sliceTarget[0])

    // String slicing: return a new string that is a substring.
    // Byte slices ([]uint8/[]int8) share the i8* LLVM type and must use the
    // array-slice path (length at offset -8).
    if str.Equal(targetType, "i8*") && !exprIsByteSlice(cg, e.sliceTarget[0]) {
        // Compute the source length
        srcLen := nextReg(cg)
        emitfmt(cg, "  %s = call i64 @strlen(i8* %s)\n", []string{srcLen, target})
        srcLen32 := nextReg(cg)
        emitfmt(cg, "  %s = trunc i64 %s to i32\n", []string{srcLen32, srcLen})

        // Determine low (default 0)
        lowVal := "0"
        if len(e.sliceLow) > 0 {
            lowVal = emitExpression(cg, e.sliceLow[0])
        }

        // Determine high (default = strlen)
        highVal := srcLen32
        if len(e.sliceHigh) > 0 {
            highVal = emitExpression(cg, e.sliceHigh[0])
        }

        // Bounds check: panic on lo < 0, hi < lo, or hi > len.
        emitfmt(cg, "  call void @Skink_bounds_check(i32 %s, i32 %s, i32 %s)\n", []string{lowVal, highVal, srcLen32})

        // Compute slice length = high - low
        sliceLen := nextReg(cg)
        emitfmt(cg, "  %s = sub i32 %s, %s\n", []string{sliceLen, highVal, lowVal})

        // Allocate sliceLen + 1 bytes (null-terminated)
        allocSize := nextReg(cg)
        emitfmt(cg, "  %s = add i32 %s, 1\n", []string{allocSize, sliceLen})
        allocSize64 := nextReg(cg)
        emitfmt(cg, "  %s = zext i32 %s to i64\n", []string{allocSize64, allocSize})
        newBuf := nextReg(cg)
        emitfmt(cg, "  %s = call i8* @Skink_rc_alloc(i64 %s)\n", []string{newBuf, allocSize64})

        // Compute source offset: target + low
        srcOffset := nextReg(cg)
        emitfmt(cg, "  %s = getelementptr inbounds i8, i8* %s, i32 %s\n", []string{srcOffset, target, lowVal})

        // memcpy newBuf <- srcOffset, sliceLen bytes
        // Use a simple loop or just call memcpy
        bytesToCopy64 := nextReg(cg)
        emitfmt(cg, "  %s = zext i32 %s to i64\n", []string{bytesToCopy64, sliceLen})
        // Declare memcpy if not already declared
        emitfmt(cg, "  call void @llvm.memcpy.p0i8.p0i8.i64(i8* %s, i8* %s, i64 %s, i1 false)\n", []string{newBuf, srcOffset, bytesToCopy64})

        // Null-terminate
        nullPtr := nextReg(cg)
        emitfmt(cg, "  %s = getelementptr inbounds i8, i8* %s, i32 %s\n", []string{nullPtr, newBuf, sliceLen})
        emitfmt(cg, "  store i8 0, i8* %s\n", []string{nullPtr})

        return newBuf
    }

    // Array slicing. Under the fat-slice ABI (comp_error.md #114) every
    // s[a:b] produces a new slice header sharing the source's backing
    // store — including strict prefixes s[0:k], which the old thin-pointer
    // representation had to copy because a view at offset 0 could not
    // carry its own length. Skink_slice_sub is nil-safe: a nil source
    // yields a nil view.
    elemType := targetType
    if str.EndsWith(targetType, "*") {
        elemType = str.Substr(targetType, 0, str.Len(targetType) - 1)
    }

    rawPtr := emitI8Ptr(cg, target, targetType)
    srcLen64 := nextReg(cg)
    emitfmt(cg, "  %s = call i64 @Skink_slice_len(i8* %s)\n", []string{srcLen64, rawPtr})
    srcLen32 := nextReg(cg)
    emitfmt(cg, "  %s = trunc i64 %s to i32\n", []string{srcLen32, srcLen64})

    // Determine low (default 0). Slice bounds coerce like indices — an
    // int64 bound must truncate to i32 for the bounds check and offset math.
    lowVal := "0"
    if len(e.sliceLow) > 0 {
        lowVal = emitIndexAsI32(cg, emitExpression(cg, e.sliceLow[0]), e.sliceLow[0])
    }

    // Determine high (default = srcLen)
    highVal := srcLen32
    if len(e.sliceHigh) > 0 {
        highVal = emitIndexAsI32(cg, emitExpression(cg, e.sliceHigh[0]), e.sliceHigh[0])
    }

    // Bounds check: panic on lo < 0, hi < lo, or hi > len.
    emitfmt(cg, "  call void @Skink_bounds_check(i32 %s, i32 %s, i32 %s)\n", []string{lowVal, highVal, srcLen32})

    // Compute slice length = high - low
    sliceLen := nextReg(cg)
    emitfmt(cg, "  %s = sub i32 %s, %s\n", []string{sliceLen, highVal, lowVal})
    sliceLen64 := nextReg(cg)
    emitfmt(cg, "  %s = zext i32 %s to i64\n", []string{sliceLen64, sliceLen})

    // View capacity = source capacity - low (the writable tail from data).
    srcCap64 := nextReg(cg)
    emitfmt(cg, "  %s = call i64 @Skink_slice_cap(i8* %s)\n", []string{srcCap64, rawPtr})
    lowVal64 := nextReg(cg)
    emitfmt(cg, "  %s = sext i32 %s to i64\n", []string{lowVal64, lowVal})
    viewCap64 := nextReg(cg)
    emitfmt(cg, "  %s = sub i64 %s, %s\n", []string{viewCap64, srcCap64, lowVal64})

    // Byte offset of the view's first element = low * sizeof(elem).
    elemSizeReg := emitElemSize(cg, elemType)
    elemSizeI64 := nextReg(cg)
    emitfmt(cg, "  %s = zext i32 %s to i64\n", []string{elemSizeI64, elemSizeReg})
    offBytes := nextReg(cg)
    emitfmt(cg, "  %s = mul i64 %s, %s\n", []string{offBytes, lowVal64, elemSizeI64})

    newHdr := nextReg(cg)
    emitfmt(cg, "  %s = call i8* @Skink_slice_sub(i8* %s, i64 %s, i64 %s, i64 %s)\n",
            []string{newHdr, rawPtr, offBytes, sliceLen64, viewCap64})
    return emitFromI8Ptr(cg, newHdr, targetType)
}

// emitMakeExpr handles make() expressions.
fn emitMakeExpr(cg: *CodeGen, e: ast.Expr) -> string {
    if len(e.makeType) == 0 {
        return "null"
    }
    t := checker.astTypeToType(cg.checker, e.makeType[0])
    lt := llvmType(cg, t)
    
    // make(chan<T>, [cap]) - allocate channel
    if t.kind == checker.TK_CHAN || t.kind == 6 ||
       (len(e.makeType) > 0 && (e.makeType[0].kind == ast.TY_CHAN || e.makeType[0].kind == 205 || str.Equal(e.makeType[0].name, "chan") || str.StartsWith(e.makeType[0].name, "chan<"))) {
        capReg := "0"
        if len(e.makeSize) > 0 {
            capReg = emitExpression(cg, e.makeSize[0])
        }
        elemSize := 1
        if len(e.makeType[0].elem) > 0 {
            elemT := checker.astTypeToType(cg.checker, e.makeType[0].elem[0])
            s, _ := typeSizeAndAlign(cg, elemT)
            if s > 0 {
                elemSize = s
            }
        }
        chReg := nextReg(cg)
        emitfmt(cg, "  %s = call i8* @Skink_chan_make(i32 %s, i32 %s)\n", []string{chReg, strconv.Itoa(elemSize), capReg})
        return chReg
    }

    // make(map[K]V) - heap-allocate empty map struct
    // The LLVM type for a map is %map_...* (single pointer). A slice of maps
    // would be %map_...** (double pointer), so we check that the type doesn't
    // end with ** to distinguish.
    if str.StartsWith(lt, "%map_") && str.EndsWith(lt, "*") && !str.EndsWith(lt, "**") {
        mapType := str.Substr(lt, 0, str.Len(lt) - 1)
        keyLL, valLL, _ := parseMapTypeLL(lt)
        emitMapTypeDecl(cg, mapTypeName(keyLL, valLL), keyLL, valLL)

        sizeReg := nextReg(cg)
        emitfmt(cg, "  %s = getelementptr %s, %s* null, i32 1\n", []string{sizeReg, mapType, mapType})
        sizeReg2 := nextReg(cg)
        emitfmt(cg, "  %s = ptrtoint %s* %s to i64\n", []string{sizeReg2, mapType, sizeReg})
        rawReg := nextReg(cg)
        emitfmt(cg, "  %s = call i8* @Skink_rc_alloc(i64 %s)\n", []string{rawReg, sizeReg2})
        mapReg := nextReg(cg)
        emitfmt(cg, "  %s = bitcast i8* %s to %s*\n", []string{mapReg, rawReg, mapType})

        // Initialize empty map: keys=null, vals=null, occupied=null, capacity=0, count=0.
        kf := nextReg(cg)
        emitfmt(cg, "  %s = getelementptr inbounds %s, %s* %s, i32 0, i32 0\n", []string{kf, mapType, mapType, mapReg})
        emitfmt(cg, "  store %s* null, %s** %s\n", []string{keyLL, keyLL, kf})

        vf := nextReg(cg)
        emitfmt(cg, "  %s = getelementptr inbounds %s, %s* %s, i32 0, i32 1\n", []string{vf, mapType, mapType, mapReg})
        emitfmt(cg, "  store %s* null, %s** %s\n", []string{valLL, valLL, vf})

        of := nextReg(cg)
        emitfmt(cg, "  %s = getelementptr inbounds %s, %s* %s, i32 0, i32 2\n", []string{of, mapType, mapType, mapReg})
        emitfmt(cg, "  store i8* null, i8** %s\n", []string{of})

        cf := nextReg(cg)
        emitfmt(cg, "  %s = getelementptr inbounds %s, %s* %s, i32 0, i32 3\n", []string{cf, mapType, mapType, mapReg})
        emitfmt(cg, "  store i32 0, i32* %s\n", []string{cf})

        lf := nextReg(cg)
        emitfmt(cg, "  %s = getelementptr inbounds %s, %s* %s, i32 0, i32 4\n", []string{lf, mapType, mapType, mapReg})
        emitfmt(cg, "  store i32 0, i32* %s\n", []string{lf})
        return mapReg
    }

    // make([]T, n) - allocate backing array
    if str.EndsWith(lt, "*") {
        elemLL := str.Substr(lt, 0, str.Len(lt) - 1)
        nReg := "0"
        if len(e.makeSize) > 0 {
            nReg = emitExpression(cg, e.makeSize[0])
        }
        elemSize := emitElemSize(cg, elemLL)
        bytesReg := nextReg(cg)
        emitfmt(cg, "  %s = mul i32 %s, %s\n", []string{bytesReg, nReg, elemSize})
        bytes64 := nextReg(cg)
        emitfmt(cg, "  %s = zext i32 %s to i64\n", []string{bytes64, bytesReg})
        // Use typed allocation with array destructor if the element type
        // holds heap-reachable values.
        arrDtorName := getOrCreateArrayDtor(cg, elemLL)
        rawReg := nextReg(cg)
        if str.Len(arrDtorName) > 0 {
            arrDtorPtr := str.Concat("i8* bitcast (void (i8*)* @", str.Concat(arrDtorName, " to i8*)"))
            emitfmt(cg, "  %s = call i8* @Skink_rc_alloc_typed(i64 %s, %s)\n", []string{rawReg, bytes64, arrDtorPtr})
        } else {
            emitfmt(cg, "  %s = call i8* @Skink_rc_alloc(i64 %s)\n", []string{rawReg, bytes64})
        }

        // Store the backing capacity at payload - 8 (the array destructor
        // scans that many slots; unwritten slots are zeroed and release to
        // no-ops).
        nReg64 := nextReg(cg)
        emitfmt(cg, "  %s = zext i32 %s to i64\n", []string{nReg64, nReg})
        lenPtr := nextReg(cg)
        emitfmt(cg, "  %s = getelementptr inbounds i8, i8* %s, i64 -8\n", []string{lenPtr, rawReg})
        typedLenPtr := nextReg(cg)
        emitfmt(cg, "  %s = bitcast i8* %s to i64*\n", []string{typedLenPtr, lenPtr})
        emitfmt(cg, "  store i64 %s, i64* %s\n", []string{nReg64, typedLenPtr})

        // Wrap the backing array in a slice header {data, len, cap, base}.
        hdrReg := nextReg(cg)
        emitfmt(cg, "  %s = call i8* @Skink_slice_hdr(i8* %s, i64 %s, i64 %s, i8* %s)\n",
            []string{hdrReg, rawReg, nReg64, nReg64, rawReg})
        return emitFromI8Ptr(cg, hdrReg, str.Concat(elemLL, "*"))
    }
    
    return "null"
}

// emitSizeofExpr handles sizeof() expressions.
fn emitSizeofExpr(cg: *CodeGen, e: ast.Expr) -> string {
    if len(e.sizeofType) > 0 {
        t := checker.astTypeToType(cg.checker, e.sizeofType[0])
        size, _ := typeSizeAndAlign(cg, t)
        return strconv.Itoa(size)
    }
    return "0"
}

// emitAlignofExpr handles alignof() expressions.
fn emitAlignofExpr(cg: *CodeGen, e: ast.Expr) -> string {
    if len(e.sizeofType) > 0 {
        t := checker.astTypeToType(cg.checker, e.sizeofType[0])
        _, align := typeSizeAndAlign(cg, t)
        return strconv.Itoa(align)
    }
    return "1"
}

// emitRangeExpr handles range expressions (low..high).
fn emitRangeExpr(cg: *CodeGen, e: ast.Expr) -> string {
    // For now, return 0
    return "0"
}

// === Statement Emission ===

// emitStatement dispatches statement emission based on statement kind.
fn emitStatement(cg: *CodeGen, stmt: ast.Stmt) {
    cg.currentStmtLine = stmt.line
    cg.currentStmtCol = stmt.col
    if cg.dbgEnabled {
        emitDbgLocation(cg, stmt.line, stmt.col)
    }
    if stmt.kind == ast.ST_VAR {
        emitVarStmt(cg, stmt)
        return
    }
    if stmt.kind == ast.ST_ASSIGN {
        emitAssignStmt(cg, stmt)
        return
    }
    if stmt.kind == ast.ST_TUPLEASSIGN {
        emitTupleAssignStmt(cg, stmt)
        return
    }
    if stmt.kind == ast.ST_RETURN {
        emitReturnStmt(cg, stmt)
        return
    }
    if stmt.kind == ast.ST_BREAK {
        emitBreakStmt(cg)
        return
    }
    if stmt.kind == ast.ST_CONTINUE {
        emitContinueStmt(cg)
        return
    }
    if stmt.kind == ast.ST_EXPR {
        emitExprStmt(cg, stmt)
        return
    }
    if stmt.kind == ast.ST_IF {
        emitIfStmt(cg, stmt)
        return
    }
    if stmt.kind == ast.ST_WHILE {
        emitWhileStmt(cg, stmt)
        return
    }
    if stmt.kind == ast.ST_UNTIL {
        emitUntilStmt(cg, stmt)
        return
    }
    if stmt.kind == ast.ST_FOR {
        emitForStmt(cg, stmt)
        return
    }
    if stmt.kind == ast.ST_BLOCK {
        emitBlockStmt(cg, stmt)
        return
    }
    if stmt.kind == ast.ST_DEFER {
        emitDeferStmt(cg, stmt)
        return
    }
    if stmt.kind == ast.ST_SWITCH {
        emitSwitchStmt(cg, stmt)
        return
    }
    if stmt.kind == ast.ST_SELECT {
        emitSelectStmt(cg, stmt)
        return
    }
    if stmt.kind == ast.ST_MATCH {
        emitMatchStmt(cg, stmt)
        return
    }
    if stmt.kind == ast.ST_SPAWN {
        emitSpawnStmt(cg, stmt)
        return
    }
    emitExprStmt(cg, stmt)
}

// emitMatchStmt handles bare match statements (used as control flow, not
// as an expression). Reuses emitMatchExpr by wrapping the statement's
// subject/arms in a synthetic match expression and discarding the result.
fn emitMatchStmt(cg: *CodeGen, stmt: ast.Stmt) {
    e := ast.Expr{kind: ast.EX_MATCH_EXPR}
    e.matchExprSubject = stmt.matchSubject
    e.matchExprArms = stmt.matchArms
    emitMatchExpr(cg, e)
}

// emitSpawnStmt handles: spawn funcCall(args...)
// It generates a thunk function that unpacks a struct of arguments and calls
// the spawned function, then calls Skink_spawn to run it in a detached thread.
fn emitSpawnStmt(cg: *CodeGen, stmt: ast.Stmt) {
    if len(stmt.spawnCall) == 0 {
        return
    }
    callExpr := stmt.spawnCall[0]
    if callExpr.kind != ast.EX_CALL {
        emitExpression(cg, callExpr)
        return
    }
    fnExpr := callExpr.callFunc[0]
    fnName := ""
    hasReceiver := false
    var receiverExpr ast.Expr
    if fnExpr.kind == ast.EX_IDENT {
        fnName = resolveDirectFnName(cg, fnExpr.ident)
    } else if fnExpr.kind == ast.EX_FIELD && len(fnExpr.fieldTarget) > 0 {
        // Method call (obj.method(args)): resolve like emitMethodCall.
        // A non-module call passes the receiver as implicit argument 0.
        recvExpr := fnExpr.fieldTarget[0]
        if str.StartsWith(exprLLType(cg, recvExpr), "%template.") {
            // Template fat pointers dispatch indirectly and cannot be
            // called through a static thunk — keep the synchronous
            // fallback for this edge case.
            emitExpression(cg, callExpr)
            return
        }
        resolved, isModuleCall := resolveMethodCallFnName(cg, fnExpr)
        fnName = resolved
        if !isModuleCall {
            hasReceiver = true
            receiverExpr = recvExpr
        }
    } else {
        emitExpression(cg, callExpr)
        return
    }
    // Function values (closure variables, fn-typed fields) cannot be
    // spawned through a static thunk — fall back to a synchronous call.
    if str.Len(fnName) == 0 || !mapStringStringSliceHasKeyCG(cg.fnRetTypes, fnName) {
        emitExpression(cg, callExpr)
        return
    }
    // Resolve the callee's real signature so the thunk calls it with the
    // correct return type (non-void results are discarded) and parameter
    // types (arguments are coerced before being packed).
    hasFnSig := mapStringStringSliceHasKeyCG(cg.fnRetTypes, fnName)
    retLL := "void"
    if hasFnSig && len(cg.fnRetTypes[fnName]) > 0 {
        if len(cg.fnRetTypes[fnName]) > 1 {
            retLL = aggregateRetType(cg.fnRetTypes[fnName])
        } else {
            retLL = cg.fnRetTypes[fnName][0]
        }
    }
    hasParams := mapStringStringSliceHasKeyCG(cg.fnParamTypes, fnName)

    // Build the packed argument list: for method calls the receiver is
    // implicit argument 0, followed by the call's explicit arguments.
    // argTypes is the LLVM type stored in the pack; callTypes is the type
    // passed to the callee; passByRef marks args where the thunk passes
    // the pack field's address instead of a loaded value.
    argTypes := []string{}
    callTypes := []string{}
    passByRef := []bool{}
    argRegs := []string{}
    paramOffset := 0
    if hasReceiver {
        receiverReg, receiverLLType := emitMethodReceiver(cg, receiverExpr, fnName)
        packType := receiverLLType
        callType := receiverLLType
        byRef := false
        if receiverExpr.kind == ast.EX_IDENT {
            sv, ok := lookupVar(cg, receiverExpr.ident)
            if ok && str.Equal(receiverReg, sv.alloca) && isCompositeType(sv.llType) && !str.EndsWith(sv.llType, "*") {
                // The receiver is the address of a stack alloca holding a
                // by-value struct — it would dangle once this frame
                // returns. Pack the struct value instead and have the
                // thunk pass the pack field's address to the callee.
                receiverReg = emitLoad(cg, sv.llType, sv.llType, sv.alloca)
                receiverReg = emitRetainStructHeapFields(cg, receiverReg, sv.llType)
                packType = sv.llType
                callType = str.Concat(sv.llType, "*")
                byRef = true
            }
        }
        if !byRef && isHeapLLType(receiverLLType) {
            receiverReg = emitRetain(cg, receiverReg, receiverLLType)
        }
        argTypes = append(argTypes, packType)
        callTypes = append(callTypes, callType)
        passByRef = append(passByRef, byRef)
        argRegs = append(argRegs, receiverReg)
        paramOffset = 1
    }
    for i := 0; i < len(callExpr.callArgs); i = i + 1 {
        argReg := emitExpression(cg, callExpr.callArgs[i])
        argLL := exprLLType(cg, callExpr.callArgs[i])
        if str.Equal(argLL, "") {
            argLL = "i32"
        }
        // Coerce to the declared parameter type when known.
        if hasParams && i + paramOffset < len(cg.fnParamTypes[fnName]) {
            argLL = cg.fnParamTypes[fnName][i + paramOffset]
            argReg = coerceExprToParamType(cg, argReg, exprLLType(cg, callExpr.callArgs[i]), argLL, callExpr.callArgs[i])
        }
        // Retain reference-counted arguments so the parent cannot free
        // them while the spawned thread is still running.
        if isHeapLLType(argLL) {
            argReg = emitRetain(cg, argReg, argLL)
        }
        argTypes = append(argTypes, argLL)
        callTypes = append(callTypes, argLL)
        passByRef = append(passByRef, false)
        argRegs = append(argRegs, argReg)
    }
    nArgs := len(argTypes)

    // No-argument spawn: thunk takes i8* but ignores it
    if nArgs == 0 {
        thunkName := str.Concat("Skink_spawn_thunk_", strconv.Itoa(cg.spawnThunkCounter))
        cg.spawnThunkCounter = cg.spawnThunkCounter + 1
        parts := []string{}
        parts = append(parts, "define i8* @")
        parts = append(parts, thunkName)
        parts = append(parts, "(i8* %arg) {\n")
        parts = append(parts, "  call ")
        parts = append(parts, retLL)
        parts = append(parts, " @")
        parts = append(parts, fnName)
        parts = append(parts, "()\n")
        parts = append(parts, "  ret i8* null\n}\n\n")
        emitSpawnThunk(cg, concatMany(parts))
        emitfmt(cg, "  call void @Skink_spawn(i8* bitcast (i8* (i8*)* @%s to i8*), i8* null, i8* null)\n", []string{thunkName})
        return
    }

    // Build struct type string: { i32, i8*, ... }
    structBody := "{ "
    for i := 0; i < nArgs; i = i + 1 {
        if i > 0 {
            structBody = str.Concat(structBody, ", ")
        }
        structBody = str.Concat(structBody, argTypes[i])
    }
    structBody = str.Concat(structBody, " }")
    structLLName := str.Concat(str.Concat("%Skink_spawn_args_", strconv.Itoa(cg.spawnThunkCounter)), "_t")

    // Emit struct type declaration
    declParts := []string{}
    declParts = append(declParts, structLLName)
    declParts = append(declParts, " = type ")
    declParts = append(declParts, structBody)
    declParts = append(declParts, "\n")
    emitHeader(cg, concatMany(declParts))

    thunkName := str.Concat("Skink_spawn_thunk_", strconv.Itoa(cg.spawnThunkCounter))
    cg.spawnThunkCounter = cg.spawnThunkCounter + 1

    // Generate thunk function
    thunkParts := []string{}
    thunkParts = append(thunkParts, "define i8* @")
    thunkParts = append(thunkParts, thunkName)
    thunkParts = append(thunkParts, "(i8* %arg) {\n")
    thunkParts = append(thunkParts, "  %args = bitcast i8* %arg to ")
    thunkParts = append(thunkParts, structLLName)
    thunkParts = append(thunkParts, "*\n")
    // Extract each field
    for i := 0; i < nArgs; i = i + 1 {
        fieldReg := str.Concat("%a", strconv.Itoa(i))
        emitIdx := strconv.Itoa(i)
        gepParts := []string{}
        gepParts = append(gepParts, "  ")
        gepParts = append(gepParts, fieldReg)
        gepParts = append(gepParts, " = getelementptr inbounds ")
        gepParts = append(gepParts, structLLName)
        gepParts = append(gepParts, ", ")
        gepParts = append(gepParts, structLLName)
        gepParts = append(gepParts, "* %args, i32 0, i32 ")
        gepParts = append(gepParts, emitIdx)
        gepParts = append(gepParts, "\n")
        thunkParts = append(thunkParts, concatMany(gepParts))
        if !passByRef[i] {
            loadReg := str.Concat("%v", strconv.Itoa(i))
            loadParts := []string{}
            loadParts = append(loadParts, "  ")
            loadParts = append(loadParts, loadReg)
            loadParts = append(loadParts, " = load ")
            loadParts = append(loadParts, argTypes[i])
            loadParts = append(loadParts, ", ")
            loadParts = append(loadParts, argTypes[i])
            loadParts = append(loadParts, "* ")
            loadParts = append(loadParts, fieldReg)
            loadParts = append(loadParts, "\n")
            thunkParts = append(thunkParts, concatMany(loadParts))
        }
    }
    // Build call instruction — use the callee's real return type; a
    // non-void result is simply discarded.
    callHead := []string{}
    callHead = append(callHead, "  call ")
    callHead = append(callHead, retLL)
    callHead = append(callHead, " @")
    callHead = append(callHead, fnName)
    callHead = append(callHead, "(")
    callParts := concatMany(callHead)
    for i := 0; i < nArgs; i = i + 1 {
        if i > 0 {
            callParts = str.Concat(callParts, ", ")
        }
        // passByRef args hand the callee the pack field's address
        // (e.g. a by-value struct receiver packed into the arg struct).
        argRegName := str.Concat("%v", strconv.Itoa(i))
        if passByRef[i] {
            argRegName = str.Concat("%a", strconv.Itoa(i))
        }
        callParts = str.Concat(callParts, str.Concat(callTypes[i], str.Concat(" ", argRegName)))
    }
    callParts = str.Concat(callParts, ")\n")
    thunkParts = append(thunkParts, callParts)
    // Release the per-argument references that emitSpawnStmt retained
    // into the pack — the callee treats parameters as borrowed (params
    // are never released inside the callee), so the thunk owns them.
    // passByRef struct receivers still leak their retained fields
    // (pre-existing; their release needs a field walk we can't emit
    // into the thunk text stream cheaply).
    for i := 0; i < nArgs; i = i + 1 {
        if !passByRef[i] && isHeapLLType(argTypes[i]) {
            vname := "%v" + strconv.Itoa(i)
            if str.Equal(argTypes[i], "i8*") {
                thunkParts = append(thunkParts, "  call void @Skink_rc_release(i8* " + vname + ")\n")
            } else {
                rname := "%rc" + strconv.Itoa(i)
                thunkParts = append(thunkParts, "  " + rname + " = bitcast " + argTypes[i] + " " + vname + " to i8*\n")
                thunkParts = append(thunkParts, "  call void @Skink_rc_release(i8* " + rname + ")\n")
            }
        }
    }
    // Release the argument pack now that the call has consumed it
    // (it was allocated with Skink_rc_alloc).
    thunkParts = append(thunkParts, "  call void @Skink_rc_release(i8* %arg)\n")
    thunkParts = append(thunkParts, "  ret i8* null\n}\n\n")
    emitSpawnThunk(cg, concatMany(thunkParts))

    // Pack arguments into a heap-allocated struct
    sizeGep := nextReg(cg)
    emitfmt(cg, "  %s = getelementptr %s, %s* null, i32 1\n", []string{sizeGep, structLLName, structLLName})
    sizeReg := nextReg(cg)
    emitfmt(cg, "  %s = ptrtoint %s* %s to i64\n", []string{sizeReg, structLLName, sizeGep})
    rawReg := nextReg(cg)
    emitfmt(cg, "  %s = call i8* @Skink_rc_alloc(i64 %s)\n", []string{rawReg, sizeReg})
    packedReg := nextReg(cg)
    emitfmt(cg, "  %s = bitcast i8* %s to %s*\n", []string{packedReg, rawReg, structLLName})
    // Store each argument
    for i := 0; i < nArgs; i = i + 1 {
        fieldPtr := nextReg(cg)
        emitfmt(cg, "  %s = getelementptr inbounds %s, %s* %s, i32 0, i32 %s\n", []string{fieldPtr, structLLName, structLLName, packedReg, strconv.Itoa(i)})
        emitStore(cg, argTypes[i], argRegs[i], argTypes[i], fieldPtr)
    }
    // Call Skink_spawn
    packedI8 := nextReg(cg)
    emitfmt(cg, "  %s = bitcast %s* %s to i8*\n", []string{packedI8, structLLName, packedReg})
    emitfmt(cg, "  call void @Skink_spawn(i8* bitcast (i8* (i8*)* @%s to i8*), i8* %s, i8* null)\n", []string{thunkName, packedI8})
}

// asyncThunkTail returns the thunk epilogue for an async call: the call
// result %r (of type retLL) is boxed into an Skink_rc_alloc'd heap slot and
// returned as i8*. Void calls simply return null. Closes the thunk body.
fn asyncThunkTail(retLL: string) -> string {
    if str.Equal(retLL, "void") {
        return "  ret i8* null\n}\n\n"
    }
    p := []string{}
    p = append(p, "  %asz = getelementptr ")
    p = append(p, retLL)
    p = append(p, ", ")
    p = append(p, retLL)
    p = append(p, "* null, i32 1\n")
    p = append(p, "  %aszi = ptrtoint ")
    p = append(p, retLL)
    p = append(p, "* %asz to i64\n")
    p = append(p, "  %abox = call i8* @Skink_rc_alloc(i64 %aszi)\n")
    p = append(p, "  %abc = bitcast i8* %abox to ")
    p = append(p, retLL)
    p = append(p, "*\n")
    p = append(p, "  store ")
    p = append(p, retLL)
    p = append(p, " %r, ")
    p = append(p, retLL)
    p = append(p, "* %abc\n")
    p = append(p, "  ret i8* %abox\n}\n\n")
    return concatMany(p)
}

// emitAsyncExpr handles `async f(args...)`. It creates a future, spawns f
// on a detached thread via a generated thunk that boxes the call result,
// and returns the i8* future handle. await unboxes the result.
fn emitAsyncExpr(cg: *CodeGen, e: ast.Expr) -> string {
    if len(e.inner) == 0 || e.inner[0].kind != ast.EX_CALL {
        errorf(cg, "async requires a function call — e.g. async f(x)")
        return "null"
    }
    callExpr := e.inner[0]
    if len(callExpr.callFunc) == 0 || callExpr.callFunc[0].kind != ast.EX_IDENT {
        errorf(cg, "async requires a named function call — e.g. async f(x)")
        return "null"
    }
    fnName := resolveDirectFnName(cg, callExpr.callFunc[0].ident)
    if !mapStringStringSliceHasKeyCG(cg.fnRetTypes, fnName) {
        errorf(cg, str.Concat("async: unknown function ", fnName))
        return "null"
    }
    if len(cg.fnRetTypes[fnName]) > 1 {
        errorf(cg, "async calls must return a single value — return a struct or map for multiple results")
        return "null"
    }
    retLL := "void"
    if len(cg.fnRetTypes[fnName]) == 1 {
        retLL = cg.fnRetTypes[fnName][0]
    }
    hasParams := mapStringStringSliceHasKeyCG(cg.fnParamTypes, fnName)
    nArgs := len(callExpr.callArgs)

    // Create the future that await will block on.
    futReg := nextReg(cg)
    emitfmt(cg, "  %s = call i8* @Skink_future_make()\n", []string{futReg})

    thunkName := str.Concat("Skink_async_thunk_", strconv.Itoa(cg.spawnThunkCounter))
    cg.spawnThunkCounter = cg.spawnThunkCounter + 1

    // No-argument async call
    if nArgs == 0 {
        parts := []string{}
        parts = append(parts, "define i8* @")
        parts = append(parts, thunkName)
        parts = append(parts, "(i8* %arg) {\n")
        if str.Equal(retLL, "void") {
            parts = append(parts, "  call void @")
            parts = append(parts, fnName)
            parts = append(parts, "()\n")
        } else {
            parts = append(parts, "  %r = call ")
            parts = append(parts, retLL)
            parts = append(parts, " @")
            parts = append(parts, fnName)
            parts = append(parts, "()\n")
        }
        parts = append(parts, asyncThunkTail(retLL))
        emitSpawnThunk(cg, concatMany(parts))
        emitfmt(cg, "  call void @Skink_spawn(i8* bitcast (i8* (i8*)* @%s to i8*), i8* null, i8* %s)\n", []string{thunkName, futReg})
        return futReg
    }

    // Multi-argument async call: pack args into a heap struct (same scheme
    // as spawn) so the detached thunk can unpack them.
    argTypes := []string{}
    argRegs := []string{}
    for i := 0; i < nArgs; i = i + 1 {
        argReg := emitExpression(cg, callExpr.callArgs[i])
        argLL := exprLLType(cg, callExpr.callArgs[i])
        if str.Equal(argLL, "") {
            argLL = "i32"
        }
        // Coerce to the declared parameter type when known.
        if hasParams && i < len(cg.fnParamTypes[fnName]) {
            argLL = cg.fnParamTypes[fnName][i]
            argReg = coerceExprToParamType(cg, argReg, exprLLType(cg, callExpr.callArgs[i]), argLL, callExpr.callArgs[i])
        }
        // Retain reference-counted arguments so the parent cannot free
        // them while the spawned thread is still running.
        if isHeapLLType(argLL) {
            argReg = emitRetain(cg, argReg, argLL)
        }
        argTypes = append(argTypes, argLL)
        argRegs = append(argRegs, argReg)
    }

    structBody := "{ "
    for i := 0; i < nArgs; i = i + 1 {
        if i > 0 {
            structBody = str.Concat(structBody, ", ")
        }
        structBody = str.Concat(structBody, argTypes[i])
    }
    structBody = str.Concat(structBody, " }")
    structLLName := str.Concat(str.Concat("%Skink_async_args_", strconv.Itoa(cg.spawnThunkCounter)), "_t")
    emitHeader(cg, str.Concat(str.Concat(structLLName, " = type "), str.Concat(structBody, "\n")))

    // Thunk: unpack args, call fn, release the pack, box the result.
    thunkParts := []string{}
    thunkParts = append(thunkParts, "define i8* @")
    thunkParts = append(thunkParts, thunkName)
    thunkParts = append(thunkParts, "(i8* %arg) {\n")
    thunkParts = append(thunkParts, "  %args = bitcast i8* %arg to ")
    thunkParts = append(thunkParts, structLLName)
    thunkParts = append(thunkParts, "*\n")
    for i := 0; i < nArgs; i = i + 1 {
        gep := []string{}
        gep = append(gep, "  %a")
        gep = append(gep, strconv.Itoa(i))
        gep = append(gep, " = getelementptr inbounds ")
        gep = append(gep, structLLName)
        gep = append(gep, ", ")
        gep = append(gep, structLLName)
        gep = append(gep, "* %args, i32 0, i32 ")
        gep = append(gep, strconv.Itoa(i))
        gep = append(gep, "\n")
        thunkParts = append(thunkParts, concatMany(gep))
        ld := []string{}
        ld = append(ld, "  %v")
        ld = append(ld, strconv.Itoa(i))
        ld = append(ld, " = load ")
        ld = append(ld, argTypes[i])
        ld = append(ld, ", ")
        ld = append(ld, argTypes[i])
        ld = append(ld, "* %a")
        ld = append(ld, strconv.Itoa(i))
        ld = append(ld, "\n")
        thunkParts = append(thunkParts, concatMany(ld))
    }
    callHead := []string{}
    if !str.Equal(retLL, "void") {
        callHead = append(callHead, "  %r = call ")
    } else {
        callHead = append(callHead, "  call ")
    }
    callHead = append(callHead, retLL)
    callHead = append(callHead, " @")
    callHead = append(callHead, fnName)
    callHead = append(callHead, "(")
    callParts := concatMany(callHead)
    for i := 0; i < nArgs; i = i + 1 {
        if i > 0 {
            callParts = str.Concat(callParts, ", ")
        }
        callParts = str.Concat(callParts, str.Concat(argTypes[i], str.Concat(" %v", strconv.Itoa(i))))
    }
    callParts = str.Concat(callParts, ")\n")
    thunkParts = append(thunkParts, callParts)
    // Release the argument pack now that the call has consumed it.
    thunkParts = append(thunkParts, "  call void @Skink_rc_release(i8* %arg)\n")
    thunkParts = append(thunkParts, asyncThunkTail(retLL))
    emitSpawnThunk(cg, concatMany(thunkParts))

    // Pack arguments into a heap-allocated struct
    sizeGep := nextReg(cg)
    emitfmt(cg, "  %s = getelementptr %s, %s* null, i32 1\n", []string{sizeGep, structLLName, structLLName})
    sizeReg := nextReg(cg)
    emitfmt(cg, "  %s = ptrtoint %s* %s to i64\n", []string{sizeReg, structLLName, sizeGep})
    rawReg := nextReg(cg)
    emitfmt(cg, "  %s = call i8* @Skink_rc_alloc(i64 %s)\n", []string{rawReg, sizeReg})
    packedReg := nextReg(cg)
    emitfmt(cg, "  %s = bitcast i8* %s to %s*\n", []string{packedReg, rawReg, structLLName})
    for i := 0; i < nArgs; i = i + 1 {
        fieldPtr := nextReg(cg)
        emitfmt(cg, "  %s = getelementptr inbounds %s, %s* %s, i32 0, i32 %s\n", []string{fieldPtr, structLLName, structLLName, packedReg, strconv.Itoa(i)})
        emitStore(cg, argTypes[i], argRegs[i], argTypes[i], fieldPtr)
    }
    packedI8 := nextReg(cg)
    emitfmt(cg, "  %s = bitcast %s* %s to i8*\n", []string{packedI8, structLLName, packedReg})
    emitfmt(cg, "  call void @Skink_spawn(i8* bitcast (i8* (i8*)* @%s to i8*), i8* %s, i8* %s)\n", []string{thunkName, packedI8, futReg})
    return futReg
}

// emitAwaitExpr handles `await p`: blocks on the future via
// Skink_future_get, then unboxes the result using the element type of the
// awaited future.
fn emitAwaitExpr(cg: *CodeGen, e: ast.Expr) -> string {
    if len(e.awaitExpr) == 0 {
        return "null"
    }
    futReg := emitExpression(cg, e.awaitExpr[0])
    valReg := nextReg(cg)
    emitfmt(cg, "  %s = call i8* @Skink_future_get(i8* %s)\n", []string{valReg, futReg})
    // Derive the future's element type from the inner expression's
    // semantic type. This avoids a lookup in the checker's awaitElemTypes
    // map, whose string keys are transient and can become unstable.
    llT := ""
    futT := exprSkinkType(cg, e.awaitExpr[0])
    if futT.kind == checker.TK_NAMED && str.Equal(futT.name, "future") && len(futT.elem) > 0 {
        elemT := checker.typeOptT(futT.elem)
        llT = llvmType(cg, elemT)
    }
    if str.Equal(llT, "") || str.Equal(llT, "void") {
        return valReg
    }
    boxCast := nextReg(cg)
    emitfmt(cg, "  %s = bitcast i8* %s to %s*\n", []string{boxCast, valReg, llT})
    res := nextReg(cg)
    emitfmt(cg, "  %s = load %s, %s* %s\n", []string{res, llT, llT, boxCast})
    // The box is single-use: free it now that the value is loaded out.
    emitfmt(cg, "  call void @Skink_rc_release(i8* %s)\n", []string{valReg})
    return res
}

// emitVarStmt handles variable declarations.
fn emitVarStmt(cg: *CodeGen, stmt: ast.Stmt) {
    // Channel receive comma-ok: v, ok := <-ch
    if len(stmt.varNames) == 2 && len(stmt.varValue) > 0 {
        ve := stmt.varValue[0]
        if ve.kind == ast.EX_PREFIX && str.Equal(ve.prefixOp, "<-") {
            // Emit channel receive.
            chReg := emitExpression(cg, ve.prefixRight[0])
            resultLLType := chanRecvElemLLType(cg, ve)
            if str.Equal(resultLLType, "") {
                resultLLType = "i32"
            }
            dataPtr := nextReg(cg)
            emitfmt(cg, "  %s = call i8* @Skink_chan_recv(i8* %s)\n", []string{dataPtr, chReg})
            // ok = (dataPtr != null)
            okReg := nextReg(cg)
            emitfmt(cg, "  %s = icmp ne i8* %s, null\n", []string{okReg, dataPtr})
            // Value: if dataPtr is null (closed channel), use a zero
            // value; otherwise load from dataPtr. Load through a select
            // so we never dereference null.
            zeroSlot := emitAlloca(cg, resultLLType)
            emitStore(cg, resultLLType, "zeroinitializer", resultLLType, zeroSlot)
            isNull := nextReg(cg)
            emitfmt(cg, "  %s = icmp eq i8* %s, null\n", []string{isNull, dataPtr})
            typedPtr := nextReg(cg)
            emitfmt(cg, "  %s = bitcast i8* %s to %s*\n", []string{typedPtr, dataPtr, resultLLType})
            srcPtr := nextReg(cg)
            emitfmt(cg, "  %s = select i1 %s, %s* %s, %s* %s\n", []string{srcPtr, isNull, resultLLType, zeroSlot, resultLLType, typedPtr})
            valReg := emitLoad(cg, resultLLType, resultLLType, srcPtr)
            emitfmt(cg, "  call void @Skink_free(i8* %s)\n", []string{dataPtr})
            // Declare variables.
            valAlloca := emitAlloca(cg, resultLLType)
            emitStore(cg, resultLLType, valReg, resultLLType, valAlloca)
            declareVar(cg, stmt.varNames[0], valAlloca, resultLLType, checker.unknownType())
            okAlloca := emitAlloca(cg, "i1")
            emitStore(cg, "i1", okReg, "i1", okAlloca)
            declareVar(cg, stmt.varNames[1], okAlloca, "i1", checker.unknownType())
            return
        }
        // Map comma-ok: v, ok := m[key]
        if ve.kind == ast.EX_INDEX {
            mapType := exprLLType(cg, ve.indexTarget[0])
            keyLL, valLL, isMap := parseMapTypeLL(mapType)
            if isMap && !str.EndsWith(mapType, "**") {
                mapReg := emitExpression(cg, ve.indexTarget[0])
                keyReg := emitExpression(cg, ve.indexExpr[0])
                // Emit map index with ok flag.
                valReg, okReg := emitMapIndexOk(cg, mapReg, keyReg, keyLL, valLL)
                // The map owns its values — the variable needs its own ref.
                if isHeapLLType(valLL) {
                    valReg = emitRetain(cg, valReg, valLL)
                } else if isCompositeType(valLL) && !str.EndsWith(valLL, "*") {
                    valReg = emitRetainStructHeapFields(cg, valReg, valLL)
                }
                valAlloca := emitAlloca(cg, valLL)
                emitStore(cg, valLL, valReg, valLL, valAlloca)
                declareVar(cg, stmt.varNames[0], valAlloca, valLL, checker.unknownType())
                okAlloca := emitAlloca(cg, "i1")
                emitStore(cg, "i1", okReg, "i1", okAlloca)
                declareVar(cg, stmt.varNames[1], okAlloca, "i1", checker.unknownType())
                return
            }
        }
    }
    // Multi-variable declaration: a, b := foo()
    if len(stmt.varNames) > 1 && len(stmt.varValue) > 0 {
        // Multi-expression form: a, b := 10, 20 — emit each expression
        // independently rather than extracting from a tuple.
        if len(stmt.varValue) == len(stmt.varNames) && len(stmt.varValue) > 1 {
            i := 0
            for i < len(stmt.varNames) {
                vr := emitExpression(cg, stmt.varValue[i])
                vt := exprLLType(cg, stmt.varValue[i])
                // Each variable takes its own reference; owned
                // temporaries are balanced by their scope-exit release.
                if isHeapLLType(vt) {
                    vr = emitRetain(cg, vr, vt)
                } else if isCompositeType(vt) && !str.EndsWith(vt, "*") {
                    vr = emitRetainStructHeapFields(cg, vr, vt)
                }
                ptrReg := emitAlloca(cg, vt)
                emitStore(cg, vt, vr, vt, ptrReg)
                declareVar(cg, stmt.varNames[i], ptrReg, vt, checker.unknownType())
                i = i + 1
            }
            return
        }
        aggReg := emitExpression(cg, stmt.varValue[0])
        // Determine the return types of the call
        callFnName := ""
        hasFn := false
        if stmt.varValue[0].kind == ast.EX_CALL {
            callFn := stmt.varValue[0].callFunc[0]
            if callFn.kind == ast.EX_IDENT {
                callFnName = resolveDirectFnName(cg, callFn.ident)
            } else if callFn.kind == ast.EX_FIELD {
                dummy := false
                callFnName, dummy = resolveMethodCallFnName(cg, callFn)
            }
            hasFn = mapStringStringSliceHasKeyCG(cg.fnRetTypes, callFnName)
        }
        aggType := exprLLType(cg, stmt.varValue[0])
        if hasFn && len(cg.fnRetTypes[callFnName]) > 1 {
            aggType = aggregateRetType(cg.fnRetTypes[callFnName])
        }
        i := 0
        for i < len(stmt.varNames) {
            elemType := "i32"
            if hasFn && i < len(cg.fnRetTypes[callFnName]) {
                elemType = cg.fnRetTypes[callFnName][i]
            }
            ptrReg := emitAlloca(cg, elemType)
            reg := nextReg(cg)
            emitln(cg, str.Concat(str.Concat(str.Concat(str.Concat(str.Concat(str.Concat("  ", reg), " = extractvalue "), aggType), " "), aggReg), str.Concat(", ", strconv.Itoa(i))))
            // Elements extracted from an owned aggregate (e.g. a call
            // result) already carry a +1 reference — extracting transfers
            // ownership, so don't retain. Elements from a borrowed
            // aggregate must be retained.
            if !exprProducesOwned(cg, stmt.varValue[0]) {
                if isHeapLLType(elemType) {
                    reg = emitRetain(cg, reg, elemType)
                } else if isCompositeType(elemType) && !str.EndsWith(elemType, "*") {
                    reg = emitRetainStructHeapFields(cg, reg, elemType)
                }
            }
            emitStore(cg, elemType, reg, elemType, ptrReg)
            declareVar(cg, stmt.varNames[i], ptrReg, elemType, checker.unknownType())
            i = i + 1
        }
        return
    }
    name := stmt.varName
    llType := "i32"
    synT := checker.unknownType()
    if len(stmt.varType) > 0 {
        t := checker.astTypeToType(cg.checker, stmt.varType[0])
        llType = llvmType(cg, t)
        synT = t
    } else if len(stmt.varValue) > 0 {
        // Infer type from the value expression
        llType = exprLLType(cg, stmt.varValue[0])
        // For make(chan T, ...) expressions, also capture the checker type
        // so that channel receive (<-ch) can determine the element type.
        if stmt.varValue[0].kind == ast.EX_MAKE && len(stmt.varValue[0].makeType) > 0 {
            synT = checker.astTypeToType(cg.checker, stmt.varValue[0].makeType[0])
        }
        // For `x := fn(...) {...}`, record the function type so later calls
        // through the variable are emitted as indirect calls.
        if stmt.varValue[0].kind == ast.EX_FN_LIT {
            lit := stmt.varValue[0]
            var litParams []checker.TType
            for li := 0; li < len(lit.fnLitParams); li = li + 1 {
                var litPt checker.TType
                litPt = checker.unknownType()
                if len(lit.fnLitParams[li].typ) > 0 {
                    litPt = checker.astTypeToType(cg.checker, lit.fnLitParams[li].typ[0])
                }
                litParams = append(litParams, litPt)
            }
            var litRets []checker.TType
            for li := 0; li < len(lit.fnLitRetTypes); li = li + 1 {
                litRets = append(litRets, checker.astTypeToType(cg.checker, lit.fnLitRetTypes[li]))
            }
            if len(litRets) == 0 {
                litRets = append(litRets, checker.builtinType("void"))
            }
            synT = checker.functionType(litParams, litRets)
        }
        // For other := inits (e.g. `h := static.FileServer(dir)` where the
        // callee returns a fn-typed alias), recover the checker's recorded
        // type so that calls through the variable emit indirect calls.
        if synT.kind == 0 || synT.kind == checker.TK_UNKNOWN {
            rt := checker.exprTypeLookup(cg.checker, cg.currentFilePath, stmt.varValue[0].line, stmt.varValue[0].col)
            if rt.kind != 0 && rt.kind != checker.TK_UNKNOWN {
                synT = rt
            }
        }
    }
    allocaReg := emitAlloca(cg, llType)
    if len(stmt.varValue) > 0 {
        valReg := emitExpression(cg, stmt.varValue[0])
        // Coerce the initializer to the declared type: integer width
        // narrowing/widening (e.g. `var a int16 = -5` where the unary
        // expr emits i32), struct pointer → by-value load, int → float.
        valReg = coerceExprToParamType(cg, valReg, exprLLType(cg, stmt.varValue[0]), llType, stmt.varValue[0])
        // Retain heap values when storing into local variables: the
        // variable takes its own reference. Owned temporaries (call
        // results, constructors) are also scope-tracked and released at
        // scope exit, so retaining here keeps the refcount balanced —
        // the variable holds +1 and the temporary's +1 is released.
        if isHeapLLType(llType) {
            valReg = emitRetain(cg, valReg, llType)
        } else if str.StartsWith(llType, "%struct.") && !str.EndsWith(llType, "*") {
            valReg = emitRetainStructHeapFields(cg, valReg, llType)
        }
        emitStore(cg, llType, valReg, llType, allocaReg)
    } else {
        // Zero-initialize
        zeroVal := zeroValueForLLType(llType)
        if !str.Equal(zeroVal, "") {
            emitStore(cg, llType, zeroVal, llType, allocaReg)
        }
    }
    declareVar(cg, name, allocaReg, llType, synT)
}

// emitAssignStmt handles assignment statements.
fn emitAssignStmt(cg: *CodeGen, stmt: ast.Stmt) {
    target := stmt.assignTarget[0]
    // Unwrap parenthesized targets — `(*p) = v` / `(x) = v` parse the
    // target as EX_PAREN wrapping the real lvalue (comp_error.md #38).
    for target.kind == ast.EX_PAREN && len(target.inner) > 0 {
        target = target.inner[0]
    }
    if len(stmt.assignValue) == 0 {
        return
    }
    // `_ = expr` discards the value — evaluate for side effects only.
    if target.kind == ast.EX_IDENT && str.Equal(target.ident, "_") {
        emitExpression(cg, stmt.assignValue[0])
        return
    }

    // Map assignment needs the raw expression, so handle it before emitting valReg
    if target.kind == ast.EX_INDEX {
        arrExpr := target.indexTarget[0]
        leftType := exprLLType(cg, arrExpr)
        _, _, isMap := parseMapTypeLL(leftType)
        if isMap && !str.EndsWith(leftType, "**") {
            arrReg := emitExpression(cg, arrExpr)
            keyReg := emitExpression(cg, target.indexExpr[0])
            keyLL, valLL, _ := parseMapTypeLL(leftType)
            emitMapIndexAssignment(cg, arrReg, keyReg, keyLL, valLL, stmt.assignValue[0], stmt.assignOp)
            return
        }
    }

    // Detect the `x = append(x, ...)` self-assignment idiom (also field
    // targets like `t.vals = append(t.vals, v)`): only then is the
    // appended-from slice's backing-array reference provably dead (the
    // assign releases it below), which is what makes geometric in-place
    // growth safe. emitAppendCall consumes and clears the flag.
    if str.Equal(stmt.assignOp, "=") && stmt.assignValue[0].kind == ast.EX_CALL {
        callExpr := stmt.assignValue[0]
        if len(callExpr.callFunc) > 0 && callExpr.callFunc[0].kind == ast.EX_IDENT &&
            str.Equal(resolveDirectFnName(cg, callExpr.callFunc[0].ident), "append") &&
            len(callExpr.callArgs) > 0 {
            targetKey := lValueKey(target)
            if str.Len(targetKey) > 0 && str.Equal(lValueKey(callExpr.callArgs[0]), targetKey) {
                cg.appendSelfVar = targetKey
            }
        }
    }
    valReg := emitExpression(cg, stmt.assignValue[0])
    cg.appendSelfVar = ""
    valType := exprLLType(cg, stmt.assignValue[0])

    // Simple variable assignment: x = val  (or compound: x += val)
    if target.kind == ast.EX_IDENT {
        sv, ok := lookupVar(cg, target.ident)
        if ok {
            // Compound assignment: x += val  →  x = x + val
            if !str.Equal(stmt.assignOp, "=") {
                oldVal := emitLoad(cg, sv.llType, sv.llType, varValuePtr(cg, sv))
                coercedReg := coerceExprToParamType(cg, valReg, valType, sv.llType, stmt.assignValue[0])
                resultReg := computeCompoundOp(cg, oldVal, coercedReg, stmt.assignOp, sv.llType, false)
                emitStore(cg, sv.llType, resultReg, sv.llType, varValuePtr(cg, sv))
                return
            }
            coercedReg := coerceExprToParamType(cg, valReg, valType, sv.llType, stmt.assignValue[0])
            // ARC: retain new heap value BEFORE releasing the old one —
            // the new value may alias the old (x = x, x = f(x)), so
            // releasing first could free it before the retain.
            if isHeapLLType(sv.llType) {
                coercedReg = emitRetain(cg, coercedReg, sv.llType)
                oldReg := emitLoad(cg, sv.llType, sv.llType, varValuePtr(cg, sv))
                emitRelease(cg, oldReg, sv.llType)
            } else if str.StartsWith(sv.llType, "%struct.") && !str.EndsWith(sv.llType, "*") {
                coercedReg = emitRetainStructHeapFields(cg, coercedReg, sv.llType)
                emitReleaseStructHeapFields(cg, varValuePtr(cg, sv), sv.llType)
            }
            emitStore(cg, sv.llType, coercedReg, sv.llType, varValuePtr(cg, sv))
            return
        }
        // Check global variable (unqualified name)
        gvt := cg.globalVarTypes[target.ident]
        hasGvt := mapStringStringHasKeyCG(cg.globalVarTypes, target.ident)
        if !hasGvt && str.Len(cg.currentModule) > 0 {
            qualifiedName := str.Concat(str.Concat(cg.currentModule, "."), target.ident)
            gvt = cg.globalVarTypes[qualifiedName]
            hasGvt = mapStringStringHasKeyCG(cg.globalVarTypes, qualifiedName)
            if hasGvt {
                target.ident = qualifiedName
            }
        }
        if hasGvt {
            globalPtr := str.Concat("@", target.ident)
            if !str.Equal(stmt.assignOp, "=") {
                oldVal := emitLoad(cg, gvt, gvt, globalPtr)
                coercedReg := coerceExprToParamType(cg, valReg, valType, gvt, stmt.assignValue[0])
                resultReg := computeCompoundOp(cg, oldVal, coercedReg, stmt.assignOp, gvt, false)
                emitStore(cg, gvt, resultReg, gvt, globalPtr)
            } else {
                coercedReg := coerceExprToParamType(cg, valReg, valType, gvt, stmt.assignValue[0])
                // The global owns a reference: retain the new value before
                // releasing the old one (they may alias).
                if isHeapLLType(gvt) {
                    coercedReg = emitRetain(cg, coercedReg, gvt)
                    oldReg := emitLoad(cg, gvt, gvt, globalPtr)
                    emitRelease(cg, oldReg, gvt)
                } else if isCompositeType(gvt) && !str.EndsWith(gvt, "*") {
                    coercedReg = emitRetainStructHeapFields(cg, coercedReg, gvt)
                    emitReleaseStructHeapFields(cg, globalPtr, gvt)
                }
                emitStore(cg, gvt, coercedReg, gvt, globalPtr)
            }
        }
        return
    }

    // Field assignment: obj.field = val  (or compound: obj.field += val)
    if target.kind == ast.EX_FIELD {
        emitFieldAssignment(cg, target, valReg, valType, stmt.assignOp, stmt.assignValue[0])
        return
    }

    // Index assignment: arr[i] = val  (or compound: arr[i] += val)
    if target.kind == ast.EX_INDEX {
        emitIndexAssignment(cg, target, valReg, valType, stmt.assignOp, stmt.assignValue[0])
        return
    }

    // Dereference assignment: *p = val  (or compound: *p += val). The
    // pointer expression evaluates to the target address; elemType is the
    // pointee type. Without this branch the RHS was evaluated for side
    // effects only and the store silently vanished.
    if target.kind == ast.EX_PREFIX && str.Equal(target.prefixOp, "*") && len(target.prefixRight) > 0 {
        ptrExpr := target.prefixRight[0]
        ptrReg := emitExpression(cg, ptrExpr)
        elemType := exprLLType(cg, target)
        if !str.Equal(stmt.assignOp, "=") {
            oldVal := emitLoad(cg, elemType, elemType, ptrReg)
            coercedReg := coerceExprToParamType(cg, valReg, valType, elemType, stmt.assignValue[0])
            resultReg := computeCompoundOp(cg, oldVal, coercedReg, stmt.assignOp, elemType, false)
            emitStore(cg, elemType, resultReg, elemType, ptrReg)
            return
        }
        coercedReg := coerceExprToParamType(cg, valReg, valType, elemType, stmt.assignValue[0])
        // ARC: the pointee location owns its value — retain the new
        // reference before releasing the old (they may alias).
        if isHeapLLType(elemType) {
            coercedReg = emitRetain(cg, coercedReg, elemType)
            oldReg := emitLoad(cg, elemType, elemType, ptrReg)
            emitRelease(cg, oldReg, elemType)
        } else if str.StartsWith(elemType, "%struct.") && !str.EndsWith(elemType, "*") {
            coercedReg = emitRetainStructHeapFields(cg, coercedReg, elemType)
            emitReleaseStructHeapFields(cg, ptrReg, elemType)
        }
        emitStore(cg, elemType, coercedReg, elemType, ptrReg)
        return
    }
}

// emitTupleAssignStmt handles multi-value assignments: a, b = foo()
fn emitTupleAssignStmt(cg: *CodeGen, stmt: ast.Stmt) {
    if len(stmt.tupleTargets) == 0 || len(stmt.assignValue) == 0 {
        return
    }
    // Per-target form: a, b = x, y — evaluate each RHS then store into the
    // matching target. Evaluate all RHS first so `a, b = b, a` swaps work.
    if len(stmt.assignValue) == len(stmt.tupleTargets) && len(stmt.assignValue) > 1 {
        var regs []string
        var types []string
        j := 0
        for j < len(stmt.assignValue) {
            r := emitExpression(cg, stmt.assignValue[j])
            regs = append(regs, r)
            types = append(types, exprLLType(cg, stmt.assignValue[j]))
            j = j + 1
        }
        j = 0
        for j < len(stmt.tupleTargets) {
            target := stmt.tupleTargets[j]
            if target.kind == ast.EX_IDENT {
                sv, ok := lookupVar(cg, target.ident)
                if ok {
                    et := types[j]
                    reg := regs[j]
                    if isHeapLLType(et) {
                        oldReg := emitLoad(cg, et, et, varValuePtr(cg, sv))
                        emitRelease(cg, oldReg, et)
                        reg = emitRetain(cg, reg, et)
                    }
                    emitStore(cg, et, reg, et, varValuePtr(cg, sv))
                }
            }
            j = j + 1
        }
        return
    }
    aggReg := emitExpression(cg, stmt.assignValue[0])
    callFnName := ""
    hasFn := false
    if stmt.assignValue[0].kind == ast.EX_CALL {
        callFn := stmt.assignValue[0].callFunc[0]
        if callFn.kind == ast.EX_IDENT {
            callFnName = resolveDirectFnName(cg, callFn.ident)
        } else if callFn.kind == ast.EX_FIELD {
            dummy := false
            callFnName, dummy = resolveMethodCallFnName(cg, callFn)
        }
        hasFn = mapStringStringSliceHasKeyCG(cg.fnRetTypes, callFnName)
    }
    aggType := exprLLType(cg, stmt.assignValue[0])
    if hasFn && len(cg.fnRetTypes[callFnName]) > 1 {
        aggType = aggregateRetType(cg.fnRetTypes[callFnName])
    }
    i := 0
    for i < len(stmt.tupleTargets) {
        elemType := "i32"
        if hasFn && i < len(cg.fnRetTypes[callFnName]) {
            elemType = cg.fnRetTypes[callFnName][i]
        }
        reg := nextReg(cg)
        emitln(cg, str.Concat(str.Concat(str.Concat(str.Concat(str.Concat(str.Concat("  ", reg), " = extractvalue "), aggType), " "), aggReg), str.Concat(", ", strconv.Itoa(i))))
        target := stmt.tupleTargets[i]
        if target.kind == ast.EX_IDENT {
            sv, ok := lookupVar(cg, target.ident)
            if ok {
                // ARC: release old value, retain new heap value. Elements
                // extracted from an owned aggregate already carry +1.
                if isHeapLLType(elemType) {
                    oldReg := emitLoad(cg, elemType, elemType, varValuePtr(cg, sv))
                    emitRelease(cg, oldReg, elemType)
                    if !exprProducesOwned(cg, stmt.assignValue[0]) {
                        reg = emitRetain(cg, reg, elemType)
                    }
                } else if str.StartsWith(elemType, "%struct.") && !str.EndsWith(elemType, "*") {
                    emitReleaseStructHeapFields(cg, varValuePtr(cg, sv), elemType)
                    if !exprProducesOwned(cg, stmt.assignValue[0]) {
                        reg = emitRetainStructHeapFields(cg, reg, elemType)
                    }
                }
                emitStore(cg, elemType, reg, elemType, varValuePtr(cg, sv))
            }
        }
        i = i + 1
    }
}

// emitFieldAssignment handles obj.field = val assignments.
// `value` is the assigned value expression (already emitted into
// valReg/valType), used for signedness-aware integer width coercion.
fn emitFieldAssignment(cg: *CodeGen, target: ast.Expr, valReg: string, valType: string, op: string, value: ast.Expr) {
    receiverExpr := target.fieldTarget[0]
    fieldName := target.fieldName
    leftType := exprLLType(cg, receiverExpr)
    // If the receiver is a struct held by value (not already a pointer),
    // we need its address (not the loaded value) to mutate it in place.
    var receiverReg string
    if str.StartsWith(leftType, "%struct.") && !str.EndsWith(leftType, "*") {
        receiverReg = emitAddressOf(cg, receiverExpr)
    } else {
        receiverReg = emitExpression(cg, receiverExpr)
    }

    if str.StartsWith(leftType, "%struct.") {
        structName := str.Substr(leftType, str.Len("%struct."), str.Len(leftType) - str.Len("%struct."))
        if str.Contains(structName, "*") {
            structName = str.Substr(structName, 0, str.IndexOf(structName, "*"))
        }
        layout := cg.structLayouts[structName]
        hasLayout := str.Len(layout.llType) > 0
        if hasLayout {
            fieldIdx := -1
            i := 0
            for i < len(layout.fields) {
                if str.Equal(layout.fields[i], fieldName) {
                    fieldIdx = i
                    break
                }
                i = i + 1
            }
            if fieldIdx >= 0 {
                fieldType := layout.fieldTypes[fieldIdx]
                structPtrType := str.Concat(layout.llType, "*")
                indices := []string{}
                indices = append(indices, "i32 0")
                indices = append(indices, str.Concat("i32 ", strconv.Itoa(fieldIdx)))
                fieldPtr := emitGEP(cg, layout.llType, structPtrType, receiverReg, indices)
                // Compound assignment: obj.field += val → obj.field = obj.field + val
                if !str.Equal(op, "=") {
                    oldVal := emitLoad(cg, fieldType, fieldType, fieldPtr)
                    coercedReg := coerceExprToParamType(cg, valReg, valType, fieldType, value)
                    resultReg := computeCompoundOp(cg, oldVal, coercedReg, op, fieldType, false)
                    emitStore(cg, fieldType, resultReg, fieldType, fieldPtr)
                    return
                }
                coercedReg := coerceExprToParamType(cg, valReg, valType, fieldType, value)
                // ARC: retain the new value before releasing the old —
                // they may alias (obj.field = obj.field).
                if isHeapLLType(fieldType) {
                    coercedReg = emitRetain(cg, coercedReg, fieldType)
                    oldFieldVal := emitLoad(cg, fieldType, fieldType, fieldPtr)
                    emitRelease(cg, oldFieldVal, fieldType)
                } else if str.StartsWith(fieldType, "%struct.") && !str.EndsWith(fieldType, "*") {
                    coercedReg = emitRetainStructHeapFields(cg, coercedReg, fieldType)
                    emitReleaseStructHeapFields(cg, fieldPtr, fieldType)
                }
                emitStore(cg, fieldType, coercedReg, fieldType, fieldPtr)
            }
        }
    }
}

// emitIndexAssignment handles arr[i] = val assignments.
// `value` is the assigned value expression (already emitted into
// valReg/valType), used for signedness-aware integer width coercion.
fn emitIndexAssignment(cg: *CodeGen, target: ast.Expr, valReg: string, valType: string, op: string, value: ast.Expr) {
    arrExpr := target.indexTarget[0]
    idxExpr := target.indexExpr[0]
    arrReg := emitExpression(cg, arrExpr)
    leftType := exprLLType(cg, arrExpr)

    idxReg := emitExpression(cg, idxExpr)
    elemType := exprLLType(cg, target)

    // String byte assignment: string is i8*, element is i8 (not i32).
    // exprIndexLLType returns i32 for reads (zero-extended byte), but
    // for writes we must store a single byte. Byte slices share the i8*
    // LLVM type but are slice headers — unwrap the data pointer first.
    if str.Equal(leftType, "i8*") {
        emitIndexBoundsCheck(cg, arrExpr, arrReg, leftType, idxReg, idxExpr)
        idxReg = emitIndexAsI32(cg, idxReg, idxExpr)
        base := arrReg
        if exprIsByteSlice(cg, arrExpr) {
            base = emitSliceData(cg, arrReg, leftType)
        }
        // Truncate value to i8 (skip if already i8)
        truncReg := valReg
        if !str.Equal(valType, "i8") {
            truncReg = nextReg(cg)
            emitfmt(cg, "  %s = trunc %s %s to i8\n", []string{truncReg, valType, valReg})
        }
        // GEP as i8* (1 byte per element)
        indices := []string{}
        indices = append(indices, idxReg)
        elemPtr := emitGEP(cg, "i8", "i8", base, indices)
        if !str.Equal(op, "=") {
            oldVal := emitLoad(cg, "i8", "i8", elemPtr)
            extOld := nextReg(cg)
            emitfmt(cg, "  %s = zext i8 %s to i32\n", []string{extOld, oldVal})
            extVal := nextReg(cg)
            emitfmt(cg, "  %s = zext i8 %s to i32\n", []string{extVal, truncReg})
            resultReg := computeCompoundOp(cg, extOld, extVal, op, "i32", false)
            truncResult := nextReg(cg)
            emitfmt(cg, "  %s = trunc i32 %s to i8\n", []string{truncResult, resultReg})
            emitStore(cg, "i8", truncResult, "i8", elemPtr)
        } else {
            emitStore(cg, "i8", truncReg, "i8", elemPtr)
        }
        return
    }

    emitIndexBoundsCheck(cg, arrExpr, arrReg, leftType, idxReg, idxExpr)
    idxReg = emitIndexAsI32(cg, idxReg, idxExpr)
    // Slice values are headers — the element base lives at h->data.
    actualBase := arrReg
    elemPtrType := str.Concat(elemType, "*")
    if exprIsSlice(cg, arrExpr) {
        dataPtr := emitSliceData(cg, arrReg, leftType)
        actualBase = emitFromI8Ptr(cg, dataPtr, elemPtrType)
    } else if !str.Equal(leftType, elemPtrType) {
        castReg := nextReg(cg)
        emitfmt(cg, "  %s = bitcast %s %s to %s*\n", []string{castReg, leftType, arrReg, elemType})
        actualBase = castReg
    }

    indices := []string{}
    indices = append(indices, idxReg)
    elemPtr := emitGEP(cg, elemType, elemPtrType, actualBase, indices)
    // Compound assignment: arr[i] += val → arr[i] = arr[i] + val
    if !str.Equal(op, "=") {
        oldVal := emitLoad(cg, elemType, elemType, elemPtr)
        coercedReg := coerceExprToParamType(cg, valReg, valType, elemType, value)
        resultReg := computeCompoundOp(cg, oldVal, coercedReg, op, elemType, false)
        emitStore(cg, elemType, resultReg, elemType, elemPtr)
        return
    }
    coercedReg := coerceExprToParamType(cg, valReg, valType, elemType, value)
    if isHeapLLType(elemType) {
        // Retain before release: arr[i] = arr[i] may alias.
        coercedReg = emitRetain(cg, coercedReg, elemType)
        oldVal := emitLoad(cg, elemType, elemType, elemPtr)
        emitRelease(cg, oldVal, elemType)
    } else if str.StartsWith(elemType, "%struct.") && !str.EndsWith(elemType, "*") {
        coercedReg = emitRetainStructHeapFields(cg, coercedReg, elemType)
        emitReleaseStructHeapFields(cg, elemPtr, elemType)
    }
    emitStore(cg, elemType, coercedReg, elemType, elemPtr)
}

// emitReturnStmt handles return statements.
fn emitReturnStmt(cg: *CodeGen, stmt: ast.Stmt) {
    if len(stmt.returnValues) == 0 {
        // Check for named returns: if the function has named return variables,
        // return their values.
        if len(cg.currentFnRetNames) > 0 && len(cg.currentFnRetTypes) > 0 {
            if len(cg.currentFnRetTypes) == 1 {
                sv, ok := lookupVar(cg, cg.currentFnRetNames[0])
                if ok {
                    val := emitLoad(cg, sv.llType, sv.llType, varValuePtr(cg, sv))
                    emitAllDeallocations(cg)
                    emitRet(cg, sv.llType, val)
                    return
                }
            } else {
                // Multi-return: build aggregate from named return variables.
                aggType := aggregateRetType(cg.currentFnRetTypes)
                newAgg := "undef"
                i := 0
                for i < len(cg.currentFnRetTypes) {
                    elemType := cg.currentFnRetTypes[i]
                    sv, ok := lookupVar(cg, cg.currentFnRetNames[i])
                    if ok {
                        val := emitLoad(cg, elemType, elemType, varValuePtr(cg, sv))
                        insReg := nextReg(cg)
                        emitfmt(cg, "  %s = insertvalue %s %s, %s %s, %s\n", []string{insReg, aggType, newAgg, elemType, val, strconv.Itoa(i)})
                        newAgg = insReg
                    }
                    i = i + 1
                }
                emitAllDeallocations(cg)
                emitRet(cg, aggType, newAgg)
                return
            }
        }
        emitRet(cg, "void", "")
        return
    }
    // Multi-value return with single expression that's already an aggregate
    // (e.g., return foo() where foo() returns (int, int))
    if len(cg.currentFnRetTypes) > 1 && len(stmt.returnValues) == 1 {
        valReg := emitExpression(cg, stmt.returnValues[0])
        valType := exprLLType(cg, stmt.returnValues[0])
        aggType := aggregateRetType(cg.currentFnRetTypes)
        // If the expression already produces the aggregate type, return directly
        if str.Equal(valType, aggType) {
            emitAllDeallocations(cg)
            emitRet(cg, aggType, valReg)
            return
        }
        // Otherwise, try to extract values from the aggregate
        if str.StartsWith(valType, "{ ") && str.EndsWith(valType, " }") {
            i := 0
            newAgg := "undef"
            for i < len(cg.currentFnRetTypes) {
                elemType := cg.currentFnRetTypes[i]
                extReg := nextReg(cg)
                emitln(cg, str.Concat(str.Concat(str.Concat(str.Concat(str.Concat(str.Concat("  ", extReg), " = extractvalue "), valType), " "), valReg), str.Concat(", ", strconv.Itoa(i))))
                // Elements of an owned aggregate carry +1 already;
                // borrowed aggregate elements need a retain.
                if isHeapLLType(elemType) && !exprProducesOwned(cg, stmt.returnValues[0]) {
                    extReg = emitRetain(cg, extReg, elemType)
                }
                insReg := nextReg(cg)
                parts := []string{}
                parts = append(parts, "  ")
                parts = append(parts, insReg)
                parts = append(parts, " = insertvalue ")
                parts = append(parts, aggType)
                parts = append(parts, " ")
                parts = append(parts, newAgg)
                parts = append(parts, ", ")
                parts = append(parts, elemType)
                parts = append(parts, " ")
                parts = append(parts, extReg)
                parts = append(parts, ", ")
                parts = append(parts, strconv.Itoa(i))
                emitln(cg, concatMany(parts))
                newAgg = insReg
                i = i + 1
            }
            emitAllDeallocations(cg)
            emitRet(cg, aggType, newAgg)
            return
        }
        // Fall through to other handlers below
    }
    // Multi-value return with multiple expressions: build aggregate with insertvalue
    if len(cg.currentFnRetTypes) > 1 && len(stmt.returnValues) >= len(cg.currentFnRetTypes) {
        aggType := aggregateRetType(cg.currentFnRetTypes)
        aggReg := "undef"
        i := 0
        for i < len(cg.currentFnRetTypes) {
            valReg := emitExpression(cg, stmt.returnValues[i])
            elemType := cg.currentFnRetTypes[i]
            valType := exprLLType(cg, stmt.returnValues[i])
            // Handle struct-by-value: if return type is a struct but we have a pointer, load it
            // (nil expressions are excluded — they materialize a zero
            // struct in coerceExprToParamType instead).
            if str.StartsWith(elemType, "%struct.") && !str.EndsWith(elemType, "*") &&
                str.EndsWith(valType, "*") &&
                stmt.returnValues[i].kind != ast.EX_NIL {
                loaded := emitLoad(cg, elemType, elemType, valReg)
                loaded = emitRetainStructHeapFields(cg, loaded, elemType)
                emitRelease(cg, valReg, valType)
                valReg = loaded
                valType = elemType
            }
            // Coerce to the declared element type (e.g. i32 → i16).
            valReg = coerceExprToParamType(cg, valReg, valType, elemType, stmt.returnValues[i])
            // Retain heap return values so the caller receives +1; owned
            // temporaries are scope-tracked and released by
            // emitAllDeallocations below, keeping the count balanced.
            if isHeapLLType(elemType) {
                valReg = emitRetain(cg, valReg, elemType)
            }
            // Retain heap-allocated fields of struct-by-value returns.
            if str.StartsWith(elemType, "%struct.") && !str.EndsWith(elemType, "*") {
                valReg = emitRetainStructHeapFields(cg, valReg, elemType)
            }
            newAgg := nextReg(cg)
            parts := []string{}
            parts = append(parts, "  ")
            parts = append(parts, newAgg)
            parts = append(parts, " = insertvalue ")
            parts = append(parts, aggType)
            parts = append(parts, " ")
            parts = append(parts, aggReg)
            parts = append(parts, ", ")
            parts = append(parts, elemType)
            parts = append(parts, " ")
            parts = append(parts, valReg)
            parts = append(parts, ", ")
            parts = append(parts, strconv.Itoa(i))
            emitln(cg, concatMany(parts))
            aggReg = newAgg
            i = i + 1
        }
        emitAllDeallocations(cg)
        emitRet(cg, aggType, aggReg)
        return
    }
    // Special case: if returning &localVar directly, heap-allocate a copy
    // to avoid returning a dangling stack pointer.  Without this, the
    // returned pointer would reference a stack alloca that becomes invalid
    // as soon as the function returns, causing use-after-free in the caller.
    // This mirrors the Go reference compiler's emitReturnStmt special case.
    if len(stmt.returnValues) == 1 && len(cg.currentFnRetTypes) > 0 {
        rv := stmt.returnValues[0]
        if rv.kind == ast.EX_PREFIX && str.Equal(rv.prefixOp, "&") &&
            len(rv.prefixRight) > 0 && rv.prefixRight[0].kind == ast.EX_IDENT {
            innerIdent := rv.prefixRight[0].ident
            sv, found := lookupVar(cg, innerIdent)
            if found && str.StartsWith(sv.llType, "%struct.") && !str.EndsWith(sv.llType, "*") {
                // Mark the variable as borrowed so it isn't released at
                // scope exit (we're copying its value to the heap, but the
                // original alloca's heap fields are now owned by the copy).
                markBorrowed(cg, innerIdent)
                // Look up the struct layout for the size
                structName := str.Substr(sv.llType, str.Len("%struct."),
                    str.Len(sv.llType) - str.Len("%struct."))
                layout := cg.structLayouts[structName]
                hasLayout := str.Len(layout.llType) > 0
                if hasLayout && layout.size > 0 {
                    // Heap-allocate a copy of the local struct
                    rawReg := nextReg(cg)
                    emitfmt(cg, "  %s = call i8* @Skink_rc_alloc(i64 %s)\n",
                        []string{rawReg, strconv.Itoa(layout.size)})
                    heapPtr := nextReg(cg)
                    structPtrType := str.Concat(sv.llType, "*")
                    emitfmt(cg, "  %s = bitcast i8* %s to %s\n",
                        []string{heapPtr, rawReg, structPtrType})
                    // Load the struct value from its storage slot
                    valReg := emitLoad(cg, sv.llType, sv.llType, varValuePtr(cg, sv))
                    // Store it into the heap allocation
                    emitStore(cg, sv.llType, valReg, sv.llType, heapPtr)
                    // The heap pointer is the return value; the fresh
                    // allocation already owns +1 — no extra retain.
                    retVal := heapPtr
                    retType := cg.currentFnRetTypes[0]
                    emitAllDeallocations(cg)
                    emitRet(cg, retType, retVal)
                    return
                }
            }
        }
    }
    if len(cg.currentFnRetTypes) > 0 && len(stmt.returnValues) > 0 {
        valReg := emitExpression(cg, stmt.returnValues[0])
        retType := cg.currentFnRetTypes[0]
        valType := exprLLType(cg, stmt.returnValues[0])
        if str.StartsWith(retType, "%struct.") && !str.EndsWith(retType, "*") &&
            str.EndsWith(valType, "*") &&
            stmt.returnValues[0].kind != ast.EX_NIL {
            loaded := emitLoad(cg, retType, retType, valReg)
            loaded = emitRetainStructHeapFields(cg, loaded, retType)
            emitRelease(cg, valReg, valType)
            valReg = loaded
            valType = retType
        }
        // Coerce the value to the declared return type — e.g. a unary
        // `-7` emits i32 but an `int16` return needs i16.
        valReg = coerceExprToParamType(cg, valReg, valType, retType, stmt.returnValues[0])
        // Retain heap return values so the caller receives +1. Owned
        // temporaries are scope-tracked, so emitAllDeallocations below
        // releases the temporary's own reference and the retain keeps the
        // returned reference alive.
        if isHeapLLType(retType) {
            valReg = emitRetain(cg, valReg, retType)
        }
        // Retain heap-allocated fields of struct-by-value returns
        // to prevent use-after-free when local variables are deallocated.
        if str.StartsWith(retType, "%struct.") && !str.EndsWith(retType, "*") {
            valReg = emitRetainStructHeapFields(cg, valReg, retType)
        }
        emitAllDeallocations(cg)
        emitRet(cg, retType, valReg)
        return
    }
    // Void function with return expression (e.g., `return match ...`):
    // evaluate for side effects, then return void
    if len(cg.currentFnRetTypes) == 0 {
        if len(stmt.returnValues) > 0 {
            // Evaluate the expression for side effects
            dummy := emitExpression(cg, stmt.returnValues[0])
            if str.Len(dummy) < 0 {
                emitln(cg, "; unreachable")
            }
        }
        emitAllDeallocations(cg)
        emitRet(cg, "void", "")
        return
    }
    // Default: return 0
    emitAllDeallocations(cg)
    emitRet(cg, "i32", "0")
}

// stmtsContainDefer reports whether a statement list (or any nested
// block inside it) contains a defer statement.
fn stmtsContainDefer(stmts: []ast.Stmt) -> bool {
    i := 0
    for i < len(stmts) {
        s := stmts[i]
        if s.kind == ast.ST_DEFER {
            return true
        }
        if stmtsContainDefer(s.thenBody) {
            return true
        }
        if stmtsContainDefer(s.elseBody) {
            return true
        }
        if stmtsContainDefer(s.ifInit) {
            return true
        }
        if stmtsContainDefer(s.forInit) {
            return true
        }
        for j := 0; j < len(s.selectCases); j = j + 1 {
            if stmtsContainDefer(s.selectCases[j].body) {
                return true
            }
        }
        for j := 0; j < len(s.matchArms); j = j + 1 {
            if stmtsContainDefer(s.matchArms[j].body) {
                return true
            }
        }
        i = i + 1
    }
    return false
}

// emitPanicPrologue emits the setjmp-based panic handler installation for
// functions that contain defer statements. Layout:
//   %jb = alloca [264 x i8]
//   %r  = call i32 @setjmp(%jb)     ; 0 = normal entry, !0 = caught panic
//   br %caught -> panic_landing : normal_entry
//   normal_entry:
//   call Skink_panic_push_handler(%jb)
//   <body>
//   panic_landing:  (emitted by emitPanicEpilogue after the body)
fn emitPanicPrologue(cg: *CodeGen) {
    cg.needPanicLanding = true
    cg.panicLandingLabel = nextLabel(cg)
    cg.normalEntryLabel = nextLabel(cg)
    jbAlloca := emitAlloca(cg, "[264 x i8]")
    jbPtr := nextReg(cg)
    emitfmt(cg, "  %s = getelementptr inbounds [264 x i8], [264 x i8]* %s, i64 0, i64 0\n", []string{jbPtr, jbAlloca})
    sjReg := nextReg(cg)
    emitfmt(cg, "  %s = call i32 @setjmp(i8* %s)\n", []string{sjReg, jbPtr})
    caughtReg := nextReg(cg)
    emitfmt(cg, "  %s = icmp ne i32 %s, 0\n", []string{caughtReg, sjReg})
    emitCondBranch(cg, caughtReg, cg.panicLandingLabel, cg.normalEntryLabel)
    emitLabel(cg, cg.normalEntryLabel)
    emitfmt(cg, "  call i32 @Skink_panic_push_handler(i8* %s)\n", []string{jbPtr})
}

// emitPanicEpilogue emits the panic landing pad: drain the defer stack,
// then re-raise if the panic was not consumed by recover().
fn emitPanicEpilogue(cg: *CodeGen, retType: string) {
    emitLabel(cg, cg.panicLandingLabel)
    cg.terminated = false
    emitDeferDrain(cg)
    pendReg := nextReg(cg)
    emitfmt(cg, "  %s = call i32 @Skink_panic_pending()\n", []string{pendReg})
    isPend := nextReg(cg)
    emitfmt(cg, "  %s = icmp ne i32 %s, 0\n", []string{isPend, pendReg})
    reraiseLabel := nextLabel(cg)
    resumeLabel := nextLabel(cg)
    emitCondBranch(cg, isPend, reraiseLabel, resumeLabel)

    emitLabel(cg, reraiseLabel)
    emitln(cg, "  call void @Skink_panic_reraise()")
    emitln(cg, "  unreachable")

    emitLabel(cg, resumeLabel)
    emitAllDeallocations(cg)
    // Release owned parameters (scope 0); deferred statements already ran.
    if cg.fnBodyActive {
        emitDeallocationsForScope(cg, 0)
    }
    if str.Equal(retType, "void") {
        emitln(cg, "  ret void")
    } else {
        emitfmt(cg, "  ret %s %s\n", []string{retType, zeroValueForLLType(retType)})
    }
}

// emitBreakStmt handles break statements.
fn emitBreakStmt(cg: *CodeGen) {
    ll, ok := currentLoopLabel(cg)
    if ok && str.Len(ll.endLabel) > 0 {
        // Release locals/temps in scopes that the branch bypasses —
        // popScope for those scopes is emitted on the fall-through path,
        // which a break never reaches.
        i := cg.scopeDepth
        for i > ll.scopeDepth {
            emitDeallocationsForScope(cg, i)
            i = i - 1
        }
        emitBranch(cg, ll.endLabel)
        return
    }
    errorf(cg, "break outside of loop or switch")
}

// emitContinueStmt handles continue statements.
fn emitContinueStmt(cg: *CodeGen) {
    ll, ok := currentLoopLabel(cg)
    if ok && str.Len(ll.continueLabel) > 0 {
        i := cg.scopeDepth
        for i > ll.continueDepth {
            emitDeallocationsForScope(cg, i)
            i = i - 1
        }
        emitBranch(cg, ll.continueLabel)
        return
    }
    errorf(cg, "continue outside of loop")
}

// emitSwitchCaseCmp emits a type-aware comparison between the switch
// subject and a case value, returning an i1 register.
fn emitSwitchCaseCmp(cg: *CodeGen, subjReg: string, subjType: string, caseExpr: ast.Expr) -> string {
    caseValReg := emitExpression(cg, caseExpr)
    caseType := exprLLType(cg, caseExpr)
    if !str.Equal(caseType, subjType) {
        caseValReg = coerceExprToParamType(cg, caseValReg, caseType, subjType, caseExpr)
    }

    // String subject: null-safe strcmp
    if str.Equal(subjType, "i8*") {
        subjNull := nextReg(cg)
        emitfmt(cg, "  %s = icmp eq i8* %s, null\n", []string{subjNull, subjReg})
        subjSafe := nextReg(cg)
        emptyL := emitStringLiteral(cg, "")
        emitfmt(cg, "  %s = select i1 %s, i8* %s, i8* %s\n", []string{subjSafe, subjNull, emptyL, subjReg})
        caseNull := nextReg(cg)
        emitfmt(cg, "  %s = icmp eq i8* %s, null\n", []string{caseNull, caseValReg})
        caseSafe := nextReg(cg)
        emptyR := emitStringLiteral(cg, "")
        emitfmt(cg, "  %s = select i1 %s, i8* %s, i8* %s\n", []string{caseSafe, caseNull, emptyR, caseValReg})
        cmpResult := nextReg(cg)
        emitfmt(cg, "  %s = call i32 @strcmp(i8* %s, i8* %s)\n", []string{cmpResult, subjSafe, caseSafe})
        cmpReg := nextReg(cg)
        emitfmt(cg, "  %s = icmp eq i32 %s, 0\n", []string{cmpReg, cmpResult})
        return cmpReg
    }

    // Float subject: fcmp
    if str.Equal(subjType, "double") {
        cmpReg := nextReg(cg)
        emitfmt(cg, "  %s = fcmp oeq double %s, %s\n", []string{cmpReg, subjReg, caseValReg})
        return cmpReg
    }

    // Value struct/map/set subjects cannot be compared with icmp.
    if str.StartsWith(subjType, "%") && !str.EndsWith(subjType, "*") {
        errorf(cg, str.Concat("switch on composite value type ", str.Concat(subjType, " is not supported")))
        cmpReg := nextReg(cg)
        emitfmt(cg, "  %s = icmp eq i32 0, 0\n", []string{cmpReg})
        return cmpReg
    }

    // Integers, bools, and pointers: icmp eq
    cmpReg := nextReg(cg)
    parts := []string{}
    parts = append(parts, "  ")
    parts = append(parts, cmpReg)
    parts = append(parts, " = icmp eq ")
    parts = append(parts, subjType)
    parts = append(parts, " ")
    parts = append(parts, subjReg)
    parts = append(parts, ", ")
    parts = append(parts, caseValReg)
    emitln(cg, concatMany(parts))
    return cmpReg
}

// emitSwitchStmt handles switch statements.
// In skink-pure, switch has no subject; each case has a boolean condition.
fn emitSwitchStmt(cg: *CodeGen, stmt: ast.Stmt) {
    endLabel := nextLabel(cg)
    // A switch is not a loop: `break` exits the switch, but `continue`
    // belongs to the enclosing loop. Inherit its continue label.
    enclosingContinue := ""
    prevLL, hasPrev := currentLoopLabel(cg)
    if hasPrev {
        enclosingContinue = prevLL.continueLabel
    }
    pushLoopLabel(cg, enclosingContinue, endLabel)
    if hasPrev {
        // `continue` inside a switch targets the enclosing loop — release
        // down to that loop's scope depth, not the switch's.
        cg.loopLabels[cg.loopLabelDepth - 1].continueDepth = prevLL.continueDepth
    }

    // Emit the switch subject expression once and store it
    var subjReg string
    var subjType string
    if len(stmt.cond) > 0 {
        subjReg = emitExpression(cg, stmt.cond[0])
        subjType = exprLLType(cg, stmt.cond[0])
    }

    i := 0
    for i < len(stmt.selectCases) {
        c := stmt.selectCases[i]
        if c.isDefault {
            i = i + 1
            continue
        }
        bodyLabel := nextLabel(cg)
        nextLabel_ := nextLabel(cg)
        // Subjectless switch: the case expression is the boolean itself.
        var cmpReg string
        if len(stmt.cond) == 0 {
            cmpReg = emitExpression(cg, c.cond[0])
        } else {
            // Compare subject to case value (type-aware: string→strcmp,
            // float→fcmp, int/pointer→icmp).
            cmpReg = emitSwitchCaseCmp(cg, subjReg, subjType, c.cond[0])
        }
        emitCondBranch(cg, cmpReg, bodyLabel, nextLabel_)

        emitLabel(cg, bodyLabel)
        cg.terminated = false
        pushScope(cg)
        j := 0
        for j < len(c.body) {
            if cg.terminated {
                break
            }
            emitStatement(cg, c.body[j])
            j = j + 1
        }
        popScope(cg)
        if !cg.terminated {
            emitBranch(cg, endLabel)
        }

        emitLabel(cg, nextLabel_)
        cg.terminated = false
        i = i + 1
    }

    // Default case
    i = 0
    for i < len(stmt.selectCases) {
        c := stmt.selectCases[i]
        if c.isDefault {
            pushScope(cg)
            j := 0
            for j < len(c.body) {
                if cg.terminated {
                    break
                }
                emitStatement(cg, c.body[j])
                j = j + 1
            }
            popScope(cg)
            if !cg.terminated {
                emitBranch(cg, endLabel)
            }
            break
        }
        i = i + 1
    }

    emitLabel(cg, endLabel)
    cg.terminated = false
    popLoopLabel(cg)
}

// emitSelectStmt handles select statements for channel operations.
// It collects all non-default cases (send and receive), builds arrays
// of channels, send-flags, and value pointers, then calls Skink_chan_select
// to determine which case is ready. The returned index dispatches to the
// corresponding case body. If no case is ready and a default exists, the
// default body is executed.
fn emitSelectStmt(cg: *CodeGen, stmt: ast.Stmt) {
    endLabel := nextLabel(cg)
    // Like switch: `break` exits the select, `continue` targets the
    // enclosing loop.
    enclosingContinue := ""
    prevLL, hasPrev := currentLoopLabel(cg)
    if hasPrev {
        enclosingContinue = prevLL.continueLabel
    }
    pushLoopLabel(cg, enclosingContinue, endLabel)
    if hasPrev {
        cg.loopLabels[cg.loopLabelDepth - 1].continueDepth = prevLL.continueDepth
    }

    // Count non-default cases
    n := 0
    for i := 0; i < len(stmt.selectCases); i = i + 1 {
        if stmt.selectCases[i].isDefault == false {
            n = n + 1
        }
    }

    // If there are no cases at all, just emit the default (if any)
    if n == 0 {
        for i := 0; i < len(stmt.selectCases); i = i + 1 {
            if stmt.selectCases[i].isDefault {
                pushScope(cg)
                for j := 0; j < len(stmt.selectCases[i].body); j = j + 1 {
                    if cg.terminated { break }
                    emitStatement(cg, stmt.selectCases[i].body[j])
                }
                popScope(cg)
                break
            }
        }
        emitLabel(cg, endLabel)
        cg.terminated = false
        popLoopLabel(cg)
        return
    }

    // Allocate arrays for Skink_chan_select:
    //   chs[n x i8*]     — channel pointers
    //   is_send[n x i32] — 1 for send, 0 for receive
    //   vals[n x i8*]    — value pointers (for send) or null (for receive)
    //   out_val: i8*     — output pointer for received data
    chsArrType := str.Concat("[", str.Concat(strconv.Itoa(n), " x i8*]"))
    isSendArrType := str.Concat("[", str.Concat(strconv.Itoa(n), " x i32]"))
    valsArrType := str.Concat("[", str.Concat(strconv.Itoa(n), " x i8*]"))
    chsArr := emitAlloca(cg, chsArrType)
    isSendArr := emitAlloca(cg, isSendArrType)
    valsArr := emitAlloca(cg, valsArrType)
    outValSlot := emitAlloca(cg, "i8*")

    // Evaluate each case's channel/value expressions and store into arrays
    caseIdx := 0
    for i := 0; i < len(stmt.selectCases); i = i + 1 {
        c := stmt.selectCases[i]
        if c.isDefault {
            continue
        }
        cond := c.cond[0]
        isSend := false
        var chExpr: ast.Expr
        var valExpr: ast.Expr
        hasValExpr := false

        // Determine case type: send (infix <-) or receive (prefix <-)
        if cond.kind == ast.EX_INFIX && str.Equal(cond.infixOp, "<-") {
            // Send: ch <- val
            isSend = true
            chExpr = cond.infixLeft[0]
            valExpr = cond.infixRight[0]
            hasValExpr = true
        } else if cond.kind == ast.EX_PREFIX && str.Equal(cond.prefixOp, "<-") {
            // Receive: <-ch
            isSend = false
            chExpr = cond.prefixRight[0]
        } else {
            // Non-channel case: treat as receive with a nil channel (will never fire)
            isSend = false
            chExpr = cond
        }

        // Emit channel expression and store into chs array
        chReg := emitExpression(cg, chExpr)
        gepChs := nextReg(cg)
        emitfmt(cg, "  %s = getelementptr %s, %s* %s, i32 0, i32 %s\n",
            []string{gepChs, chsArrType, chsArrType, chsArr, strconv.Itoa(caseIdx)})
        emitStore(cg, "i8*", chReg, "i8*", gepChs)

        // Store is_send flag
        flagStr := "0"
        if isSend {
            flagStr = "1"
        }
        gepIsSend := nextReg(cg)
        emitfmt(cg, "  %s = getelementptr %s, %s* %s, i32 0, i32 %s\n",
            []string{gepIsSend, isSendArrType, isSendArrType, isSendArr, strconv.Itoa(caseIdx)})
        emitStore(cg, "i32", flagStr, "i32", gepIsSend)

        // Store value pointer (for send) or null (for receive)
        if isSend && hasValExpr {
            valI8 := emitChanSendBox(cg, chExpr, valExpr)
            gepVals := nextReg(cg)
            emitfmt(cg, "  %s = getelementptr %s, %s* %s, i32 0, i32 %s\n",
                []string{gepVals, valsArrType, valsArrType, valsArr, strconv.Itoa(caseIdx)})
            emitStore(cg, "i8*", valI8, "i8*", gepVals)
        } else {
            gepVals := nextReg(cg)
            emitfmt(cg, "  %s = getelementptr %s, %s* %s, i32 0, i32 %s\n",
                []string{gepVals, valsArrType, valsArrType, valsArr, strconv.Itoa(caseIdx)})
            emitStore(cg, "i8*", "null", "i8*", gepVals)
        }

        caseIdx = caseIdx + 1
    }

    // Determine timeout: 0 if there's a default (non-blocking), -1 if not (block forever)
    hasDefault := false
    for i := 0; i < len(stmt.selectCases); i = i + 1 {
        if stmt.selectCases[i].isDefault {
            hasDefault = true
        }
    }
    timeoutStr := "-1"
    if hasDefault {
        timeoutStr = "0"
    }

    // Bitcast arrays to pointer types for the call
    chsPtr := nextReg(cg)
    emitfmt(cg, "  %s = bitcast %s* %s to i8**\n", []string{chsPtr, chsArrType, chsArr})
    isSendPtr := nextReg(cg)
    emitfmt(cg, "  %s = bitcast %s* %s to i32*\n", []string{isSendPtr, isSendArrType, isSendArr})
    valsPtr := nextReg(cg)
    emitfmt(cg, "  %s = bitcast %s* %s to i8**\n", []string{valsPtr, valsArrType, valsArr})
    outValPtr := nextReg(cg)
    emitfmt(cg, "  %s = bitcast i8** %s to i8**\n", []string{outValPtr, outValSlot})

    // Call Skink_chan_select
    readyReg := nextReg(cg)
    emitfmt(cg, "  %s = call i32 @Skink_chan_select(i32 %s, i8** %s, i32* %s, i8** %s, i8** %s, i32 %s)\n",
        []string{readyReg, strconv.Itoa(n), chsPtr, isSendPtr, valsPtr, outValPtr, timeoutStr})

    // Generate dispatch: compare readyReg to each case index
    caseIdx = 0
    for i := 0; i < len(stmt.selectCases); i = i + 1 {
        c := stmt.selectCases[i]
        if c.isDefault {
            continue
        }

        bodyLabel := nextLabel(cg)
        nextCaseLabel := nextLabel(cg)

        // Compare ready index to this case's index
        cmpReg := nextReg(cg)
        emitfmt(cg, "  %s = icmp eq i32 %s, %s\n", []string{cmpReg, readyReg, strconv.Itoa(caseIdx)})
        emitCondBranch(cg, cmpReg, bodyLabel, nextCaseLabel)

        // Case body
        emitLabel(cg, bodyLabel)
        cg.terminated = false
        pushScope(cg)

        // For receive-binding cases (case val := <-ch:), load the received
        // value from out_val and bind it to the recvVar local variable.
        if str.Len(c.recvVar) > 0 && !str.Equal(c.recvVar, "_") {
            cond := c.cond[0]
            if cond.kind == ast.EX_PREFIX && str.Equal(cond.prefixOp, "<-") {
                // Load the received data pointer from out_val slot
                dataPtr := emitLoad(cg, "i8*", "i8*", outValSlot)
                // Determine the element type from the receive expression
                elemLLType := chanRecvElemLLType(cg, cond)
                if str.Equal(elemLLType, "") {
                    elemLLType = "i32"
                }
                // Cast to typed pointer and load the value. A closed
                // channel yields NULL — select a zero slot instead so
                // we never dereference null.
                zeroSlot := emitAlloca(cg, elemLLType)
                emitStore(cg, elemLLType, "zeroinitializer", elemLLType, zeroSlot)
                isNull := nextReg(cg)
                emitfmt(cg, "  %s = icmp eq i8* %s, null\n", []string{isNull, dataPtr})
                typedPtr := nextReg(cg)
                emitfmt(cg, "  %s = bitcast i8* %s to %s*\n", []string{typedPtr, dataPtr, elemLLType})
                srcPtr := nextReg(cg)
                emitfmt(cg, "  %s = select i1 %s, %s* %s, %s* %s\n", []string{srcPtr, isNull, elemLLType, zeroSlot, elemLLType, typedPtr})
                valReg := emitLoad(cg, elemLLType, elemLLType, srcPtr)
                // Free the received data buffer
                emitfmt(cg, "  call void @Skink_free(i8* %s)\n", []string{dataPtr})
                // Declare recvVar as a local variable and store the value
                recvAlloca := emitAlloca(cg, elemLLType)
                emitStore(cg, elemLLType, valReg, elemLLType, recvAlloca)
                declareVar(cg, c.recvVar, recvAlloca, elemLLType, checker.unknownType())
            }
        } else {
            // Unbound/discarded receive (`case <-ch:` / `case _ := <-ch:`):
            // the value was still dequeued into out_val — nobody frees the
            // box or the element's queue-owned reference, so each fire
            // leaked both (comp_error.md #99, ASAN). Load it, release the
            // element ref if heap-typed, and free the box.
            cond := c.cond[0]
            if cond.kind == ast.EX_PREFIX && str.Equal(cond.prefixOp, "<-") {
                dataPtr := emitLoad(cg, "i8*", "i8*", outValSlot)
                elemLLType := chanRecvElemLLType(cg, cond)
                if str.Equal(elemLLType, "") {
                    elemLLType = "i32"
                }
                if isHeapLLType(elemLLType) {
                    zeroSlot := emitAlloca(cg, elemLLType)
                    emitStore(cg, elemLLType, "zeroinitializer", elemLLType, zeroSlot)
                    isNull := nextReg(cg)
                    emitfmt(cg, "  %s = icmp eq i8* %s, null\n", []string{isNull, dataPtr})
                    typedPtr := nextReg(cg)
                    emitfmt(cg, "  %s = bitcast i8* %s to %s*\n", []string{typedPtr, dataPtr, elemLLType})
                    srcPtr := nextReg(cg)
                    emitfmt(cg, "  %s = select i1 %s, %s* %s, %s* %s\n", []string{srcPtr, isNull, elemLLType, zeroSlot, elemLLType, typedPtr})
                    valReg := emitLoad(cg, elemLLType, elemLLType, srcPtr)
                    emitRelease(cg, valReg, elemLLType)
                }
                emitfmt(cg, "  call void @Skink_free(i8* %s)\n", []string{dataPtr})
            }
        }

        // Emit body statements
        for j := 0; j < len(c.body); j = j + 1 {
            if cg.terminated { break }
            emitStatement(cg, c.body[j])
        }
        popScope(cg)
        if !cg.terminated {
            emitBranch(cg, endLabel)
        }

        emitLabel(cg, nextCaseLabel)
        cg.terminated = false
        caseIdx = caseIdx + 1
    }

    // Default case: executed when readyReg == -1 (no channel was ready)
    if hasDefault {
        for i := 0; i < len(stmt.selectCases); i = i + 1 {
            if stmt.selectCases[i].isDefault {
                pushScope(cg)
                for j := 0; j < len(stmt.selectCases[i].body); j = j + 1 {
                    if cg.terminated { break }
                    emitStatement(cg, stmt.selectCases[i].body[j])
                }
                popScope(cg)
                if !cg.terminated {
                    emitBranch(cg, endLabel)
                }
                break
            }
        }
    }

    emitLabel(cg, endLabel)
    cg.terminated = false
    popLoopLabel(cg)
}

// emitExprStmt handles expression statements.
fn emitExprStmt(cg: *CodeGen, stmt: ast.Stmt) {
    if len(stmt.expr) == 0 {
        return
    }
    emitExpression(cg, stmt.expr[0])
}

// emitIfStmt handles if statements.
fn emitIfStmt(cg: *CodeGen, stmt: ast.Stmt) {
    // Emit the if-init statement (if any) in a new scope.
    pushScope(cg)
    if len(stmt.ifInit) > 0 {
        emitStatement(cg, stmt.ifInit[0])
    }
    condReg := emitExpression(cg, stmt.cond[0])
    trueLabel := nextLabel(cg)
    falseLabel := nextLabel(cg)
    endLabel := nextLabel(cg)
    hasElse := len(stmt.elseBody) > 0
    if !hasElse {
        emitCondBranch(cg, condReg, trueLabel, endLabel)
    } else {
        emitCondBranch(cg, condReg, trueLabel, falseLabel)
    }
    emitLabel(cg, trueLabel)
    pushScope(cg)
    emitBlockStmtRaw(cg, stmt.thenBody)
    popScope(cg)
    if !cg.terminated {
        emitBranch(cg, endLabel)
    }
    if hasElse {
        emitLabel(cg, falseLabel)
        pushScope(cg)
        emitBlockStmtRaw(cg, stmt.elseBody)
        popScope(cg)
        if !cg.terminated {
            emitBranch(cg, endLabel)
        }
    }
    emitLabel(cg, endLabel)
    popScope(cg)
}

// emitWhileStmt handles while statements.
fn emitWhileStmt(cg: *CodeGen, stmt: ast.Stmt) {
    condLabel := nextLabel(cg)
    bodyLabel := nextLabel(cg)
    endLabel := nextLabel(cg)
    pushLoopLabel(cg, condLabel, endLabel)
    emitLabel(cg, condLabel)
    // The condition runs every iteration — give it its own scope so
    // expression temporaries are released per-iteration, not per-function.
    pushScope(cg)
    condReg := emitExpression(cg, stmt.cond[0])
    popScope(cg)
    emitCondBranch(cg, condReg, bodyLabel, endLabel)
    emitLabel(cg, bodyLabel)
    pushScope(cg)
    emitBlockStmtRaw(cg, stmt.thenBody)
    popScope(cg)
    if !cg.terminated {
        emitBranch(cg, condLabel)
    }
    emitLabel(cg, endLabel)
    popLoopLabel(cg)
}

// emitUntilStmt handles until statements (while !cond).
fn emitUntilStmt(cg: *CodeGen, stmt: ast.Stmt) {
    condLabel := nextLabel(cg)
    bodyLabel := nextLabel(cg)
    endLabel := nextLabel(cg)
    pushLoopLabel(cg, condLabel, endLabel)
    emitLabel(cg, condLabel)
    // See emitWhileStmt: per-iteration scope for condition temporaries.
    pushScope(cg)
    condReg := emitExpression(cg, stmt.cond[0])
    popScope(cg)
    // Negate condition
    notReg := emitBinaryOp(cg, "xor", "i1", condReg, "1")
    emitCondBranch(cg, notReg, bodyLabel, endLabel)
    emitLabel(cg, bodyLabel)
    pushScope(cg)
    emitBlockStmtRaw(cg, stmt.thenBody)
    popScope(cg)
    if !cg.terminated {
        emitBranch(cg, condLabel)
    }
    emitLabel(cg, endLabel)
    popLoopLabel(cg)
}

// emitForStmt handles for statements.
fn emitForStmt(cg: *CodeGen, stmt: ast.Stmt) {
    // Check if it's a for-in loop
    if len(stmt.forIterExpr) > 0 {
        emitForInStmt(cg, stmt)
        return
    }
    // C-style for loop.
    // Scope structure matches the Go reference compiler:
    //   - init variables are declared at the parent scope (released when
    //     the parent scope is popped, e.g. at function exit)
    //   - body variables get a fresh per-iteration scope (pushScope/popScope
    //     inside bodyLabel) so they are released at the end of each
    //     iteration, preventing both use-of-uninitialised-memory bugs and
    //     cross-iteration memory leaks.
    condLabel := nextLabel(cg)
    bodyLabel := nextLabel(cg)
    postLabel := nextLabel(cg)
    endLabel := nextLabel(cg)
    pushLoopLabel(cg, postLabel, endLabel)
    // Init (at parent scope — no pushScope here)
    if len(stmt.forInit) > 0 {
        emitStatement(cg, stmt.forInit[0])
    }
    emitLabel(cg, condLabel)
    if len(stmt.cond) > 0 {
        // Per-iteration scope for condition temporaries (see emitWhileStmt).
        pushScope(cg)
        condReg := emitExpression(cg, stmt.cond[0])
        popScope(cg)
        emitCondBranch(cg, condReg, bodyLabel, endLabel)
    } else {
        emitBranch(cg, bodyLabel)
    }
    emitLabel(cg, bodyLabel)
    pushScope(cg)
    emitBlockStmtRaw(cg, stmt.thenBody)
    popScope(cg)
    if !cg.terminated {
        emitBranch(cg, postLabel)
    }
    emitLabel(cg, postLabel)
    if len(stmt.forPost) > 0 {
        // Per-iteration scope for post-statement temporaries.
        pushScope(cg)
        emitStatement(cg, stmt.forPost[0])
        popScope(cg)
    }
    emitBranch(cg, condLabel)
    emitLabel(cg, endLabel)
    popLoopLabel(cg)
}

// emitForInRangeStmt handles `for i in lo..hi` — iterates i from lo
// (inclusive) to hi (exclusive) without allocating a slice.
fn emitForInRangeStmt(cg: *CodeGen, stmt: ast.Stmt, iterExpr: ast.Expr) {
    iterVar := stmt.forIterVar
    loReg := emitExpression(cg, iterExpr.rangeLow[0])
    loLL := exprLLType(cg, iterExpr.rangeLow[0])
    hiReg := emitExpression(cg, iterExpr.rangeHigh[0])
    hiLL := exprLLType(cg, iterExpr.rangeHigh[0])
    if !str.Equal(loLL, "i32") {
        loReg = coerceExprToParamType(cg, loReg, loLL, "i32", iterExpr.rangeLow[0])
    }
    if !str.Equal(hiLL, "i32") {
        hiReg = coerceExprToParamType(cg, hiReg, hiLL, "i32", iterExpr.rangeHigh[0])
    }
    // Evaluate the bound once into an alloca so `hi` is stable.
    hiAlloca := emitAlloca(cg, "i32")
    emitStore(cg, "i32", hiReg, "i32", hiAlloca)

    iAlloca := emitAlloca(cg, "i32")
    emitStore(cg, "i32", loReg, "i32", iAlloca)
    declareVar(cg, iterVar, iAlloca, "i32", checker.builtinType("int"))
    hasTwoVars := str.Len(stmt.forIterVar2) > 0
    vAlloca := ""
    if hasTwoVars {
        vAlloca = emitAlloca(cg, "i32")
        declareVar(cg, stmt.forIterVar2, vAlloca, "i32", checker.builtinType("int"))
    }

    // Iteration variables declared above may have been boxed at declare
    // time when a literal in the body captures them (comp_error.md #39):
    // every read/write of the counter and value variables must go through
    // varValuePtr so box views stay in sync.
    iSV, _ := lookupVar(cg, iterVar)
    vSV, _ := lookupVar(cg, stmt.forIterVar2)

    condLabel := nextLabel(cg)
    bodyLabel := nextLabel(cg)
    postLabel := nextLabel(cg)
    endLabel := nextLabel(cg)
    pushLoopLabel(cg, postLabel, endLabel)

    emitBranch(cg, condLabel)
    emitLabel(cg, condLabel)
    iVal := emitLoad(cg, "i32", "i32", varValuePtr(cg, iSV))
    hiVal := emitLoad(cg, "i32", "i32", hiAlloca)
    condReg := nextReg(cg)
    emitfmt(cg, "  %s = icmp slt i32 %s, %s\n", []string{condReg, iVal, hiVal})
    emitCondBranch(cg, condReg, bodyLabel, endLabel)

    emitLabel(cg, bodyLabel)
    pushScope(cg)
    if hasTwoVars {
        iCur := emitLoad(cg, "i32", "i32", varValuePtr(cg, iSV))
        emitStore(cg, "i32", iCur, "i32", varValuePtr(cg, vSV))
    }
    for j := 0; j < len(stmt.thenBody); j = j + 1 {
        if cg.terminated { break }
        emitStatement(cg, stmt.thenBody[j])
    }
    popScope(cg)
    if !cg.terminated {
        emitBranch(cg, postLabel)
    }

    emitLabel(cg, postLabel)
    iPost := emitLoad(cg, "i32", "i32", varValuePtr(cg, iSV))
    iInc := nextReg(cg)
    emitfmt(cg, "  %s = add i32 %s, 1\n", []string{iInc, iPost})
    emitStore(cg, "i32", iInc, "i32", varValuePtr(cg, iSV))
    emitBranch(cg, condLabel)

    emitLabel(cg, endLabel)
    cg.terminated = false
    popLoopLabel(cg)
}

// emitForInChanStmt emits `for v in ch`: receive elements until the
// channel is closed (Go range-over-channel semantics). Skink_chan_recv
// returns NULL on a drained closed channel, which ends the loop.
fn emitForInChanStmt(cg: *CodeGen, stmt: ast.Stmt, chReg: string) {
    iterExpr := stmt.forIterExpr[0]
    elemLL := chanElemLLType(cg, iterExpr)
    if str.Len(elemLL) == 0 || str.Equal(elemLL, "void") {
        elemLL = "i32"
    }
    vAlloca := emitAlloca(cg, elemLL)
    declareVar(cg, stmt.forIterVar, vAlloca, elemLL, checker.unknownType())
    vSV, _ := lookupVar(cg, stmt.forIterVar)

    condLabel := nextLabel(cg)
    bodyLabel := nextLabel(cg)
    endLabel := nextLabel(cg)
    // `continue` must re-attempt the receive, so its target is condLabel.
    pushLoopLabel(cg, condLabel, endLabel)

    emitBranch(cg, condLabel)
    emitLabel(cg, condLabel)
    dataPtr := nextReg(cg)
    emitfmt(cg, "  %s = call i8* @Skink_chan_recv(i8* %s)\n", []string{dataPtr, chReg})
    isNull := nextReg(cg)
    emitfmt(cg, "  %s = icmp eq i8* %s, null\n", []string{isNull, dataPtr})
    emitCondBranch(cg, isNull, endLabel, bodyLabel)

    emitLabel(cg, bodyLabel)
    typedPtr := nextReg(cg)
    emitfmt(cg, "  %s = bitcast i8* %s to %s*\n", []string{typedPtr, dataPtr, elemLL})
    val := emitLoad(cg, elemLL, elemLL, typedPtr)
    // The receive box is single-use; the value itself is independently
    // reference-counted, so freeing the box cannot invalidate it.
    emitfmt(cg, "  call void @Skink_free(i8* %s)\n", []string{dataPtr})
    emitStore(cg, elemLL, val, elemLL, varValuePtr(cg, vSV))
    pushScope(cg)
    for j := 0; j < len(stmt.thenBody); j = j + 1 {
        if cg.terminated { break }
        emitStatement(cg, stmt.thenBody[j])
    }
    popScope(cg)
    if !cg.terminated {
        emitBranch(cg, condLabel)
    }

    emitLabel(cg, endLabel)
    cg.terminated = false
    popLoopLabel(cg)
}

// emitForInStmt handles for-in loops (for x := range expr { ... }).
fn emitForInStmt(cg: *CodeGen, stmt: ast.Stmt) {
    iterVar := stmt.forIterVar
    iterExpr := stmt.forIterExpr[0]

    // Integer range iteration: for i in lo..hi
    if iterExpr.kind == ast.EX_RANGE {
        emitForInRangeStmt(cg, stmt, iterExpr)
        return
    }

    // Emit the iterable expression
    iterable := emitExpression(cg, iterExpr)
    iterType := exprLLType(cg, iterExpr)

    // Channel iteration: the checker types the loop var as the element
    // type, but without a dedicated emit path the i8* chan pointer would
    // be treated as a byte slice and iterate garbage (comp_error.md #83).
    chT := checker.exprTypeLookup(cg.checker, cg.currentFilePath, iterExpr.line, iterExpr.col)
    if chT.kind == checker.TK_NAMED {
        chT = resolveAliasCG(cg, chT)
    }
    if chT.kind == checker.TK_CHAN {
        emitForInChanStmt(cg, stmt, iterable)
        return
    }

    // Check if iterating over a map
    // A slice of maps has type %map_...** (double pointer), which is NOT
    // a map — it's an array. Skip the map check for double pointers.
    keyLL, _, isMap := parseMapTypeLL(iterType)
    if isMap && !str.EndsWith(iterType, "**") {
        emitForInMapStmt(cg, stmt, iterable, iterType, keyLL)
        return
    }

    // Check if iterating over a set
    if str.StartsWith(iterType, "%set.") && str.EndsWith(iterType, "*") && !str.EndsWith(iterType, "**") {
        // Extract element type from the set type name.
        // Set type is %set.<sanitized_elem>*; strip prefix/suffix and unsanitize.
        setStructType := str.Substr(iterType, 0, str.Len(iterType) - 1) // strip *
        setStructName := str.Substr(setStructType, 1, str.Len(setStructType) - 1) // strip %
        sanitizedElem := str.Substr(setStructName, str.Len("set."), str.Len(setStructName) - str.Len("set."))
        setElemLL := desanitizeLLTypeName(sanitizedElem)
        emitForInSetStmt(cg, stmt, iterable, iterType, setElemLL)
        return
    }

    // Get the length of the iterable
    // For arrays (T*), length is stored at offset -8 (as i64)
    // For strings (i8*), use strlen (null-safe: return 0 for NULL).
    // Byte slices ([]uint8/[]int8) share i8* and must use the array path.
    lenReg := nextReg(cg)
    if str.Equal(iterType, "i8*") && !exprIsByteSlice(cg, iterExpr) {
        nullCheck := nextReg(cg)
        emitfmt(cg, "  %s = icmp eq i8* %s, null\n", []string{nullCheck, iterable})
        safePtr := nextReg(cg)
        emptyStr := emitStringLiteral(cg, "")
        emitfmt(cg, "  %s = select i1 %s, i8* %s, i8* %s\n", []string{safePtr, nullCheck, emptyStr, iterable})
        parts := []string{}
        parts = append(parts, "  ")
        parts = append(parts, lenReg)
        parts = append(parts, " = call i64 @strlen(i8* ")
        parts = append(parts, safePtr)
        parts = append(parts, ")")
        emitln(cg, concatMany(parts))
    } else {
        // Array: element count via Skink_slice_len — nil-safe (a nil slice
        // iterates zero times, comp_error.md #69) and view-aware, since a
        // view's length is not stored at payload-8.
        castReg := emitI8Ptr(cg, iterable, iterType)
        parts2 := []string{}
        parts2 = append(parts2, "  ")
        parts2 = append(parts2, lenReg)
        parts2 = append(parts2, " = call i64 @Skink_slice_len(i8* ")
        parts2 = append(parts2, castReg)
        parts2 = append(parts2, ")")
        emitln(cg, concatMany(parts2))
    }

    // Allocate loop counter and iter variable
    iAlloca := emitAlloca(cg, "i32")
    emitStore(cg, "i32", "0", "i32", iAlloca)

    // Under the fat-slice ABI a slice iterable register is a header; unwrap
    // its element base pointer once before the loop. Strings stay raw.
    iterData := iterable
    if exprIsSlice(cg, iterExpr) || (str.Equal(iterType, "i8*") && exprIsByteSlice(cg, iterExpr)) {
        dataPtr := emitSliceData(cg, iterable, iterType)
        iterData = emitFromI8Ptr(cg, dataPtr, iterType)
    }

    elemType := exprLLType(cg, iterExpr)
    // For arrays/slices, iterType is a pointer (e.g., "i32*"); strip the * to get element type
    if str.EndsWith(elemType, "*") {
        elemType = str.Substr(elemType, 0, str.Len(elemType) - 1)
    }
    iterAlloca := emitAlloca(cg, elemType)
    declareVar(cg, iterVar, iterAlloca, elemType, checker.unknownType())

    // If two-variable for-in (for i, v in collection), also declare the index variable.
    hasTwoVars := str.Len(stmt.forIterVar2) > 0
    idxAlloca := ""
    if hasTwoVars {
        idxAlloca = emitAlloca(cg, "i32")
        declareVar(cg, stmt.forIterVar, idxAlloca, "i32", checker.unknownType())
        // Re-declare v with the element type
        declareVar(cg, stmt.forIterVar2, iterAlloca, elemType, checker.unknownType())
    }

    condLabel := nextLabel(cg)
    bodyLabel := nextLabel(cg)
    postLabel := nextLabel(cg)
    endLabel := nextLabel(cg)
    pushLoopLabel(cg, postLabel, endLabel)

    emitBranch(cg, condLabel)
    emitLabel(cg, condLabel)
    // cond: i < len
    iVal := emitLoad(cg, "i32", "i32", iAlloca)
    i64Val := nextReg(cg)
    parts4 := []string{}
    parts4 = append(parts4, "  ")
    parts4 = append(parts4, i64Val)
    parts4 = append(parts4, " = sext i32 ")
    parts4 = append(parts4, iVal)
    parts4 = append(parts4, " to i64")
    emitln(cg, concatMany(parts4))
    condReg := nextReg(cg)
    parts5 := []string{}
    parts5 = append(parts5, "  ")
    parts5 = append(parts5, condReg)
    parts5 = append(parts5, " = icmp slt i64 ")
    parts5 = append(parts5, i64Val)
    parts5 = append(parts5, ", ")
    parts5 = append(parts5, lenReg)
    emitln(cg, concatMany(parts5))
    emitCondBranch(cg, condReg, bodyLabel, endLabel)

    emitLabel(cg, bodyLabel)
    pushScope(cg)
    // Load element: iterVar = iterable[i]
    indices := []string{}
    indices = append(indices, iVal)
    elemPtr := emitGEP(cg, elemType, str.Concat(elemType, "*"), iterData, indices)
    elemVal := emitLoad(cg, elemType, elemType, elemPtr)
    // The element is borrowed from the collection; the loop variable
    // (scope-tracked) takes its own reference.
    if isHeapLLType(elemType) {
        elemVal = emitRetain(cg, elemVal, elemType)
    } else if isCompositeType(elemType) && !str.EndsWith(elemType, "*") {
        elemVal = emitRetainStructHeapFields(cg, elemVal, elemType)
    }
    // Store through varValuePtr: a captured iteration variable was boxed
    // at declare time, and literals in the body read through the box
    // (comp_error.md #39 — a direct alloca store would leave it stale).
    elemVarName := iterVar
    if hasTwoVars {
        elemVarName = stmt.forIterVar2
    }
    elemSV, _ := lookupVar(cg, elemVarName)
    emitStore(cg, elemType, elemVal, elemType, varValuePtr(cg, elemSV))
    // If two-variable for-in, store the index into the index variable.
    if hasTwoVars {
        idxSV, _ := lookupVar(cg, stmt.forIterVar)
        emitStore(cg, "i32", iVal, "i32", varValuePtr(cg, idxSV))
    }
    // Emit body
    emitBlockStmtRaw(cg, stmt.thenBody)
    popScope(cg)
    if !cg.terminated {
        emitBranch(cg, postLabel)
    }

    emitLabel(cg, postLabel)
    // i = i + 1
    iVal2 := emitLoad(cg, "i32", "i32", iAlloca)
    nextVal := emitBinaryOp(cg, "add", "i32", iVal2, "1")
    emitStore(cg, "i32", nextVal, "i32", iAlloca)
    emitBranch(cg, condLabel)

    emitLabel(cg, endLabel)
    popLoopLabel(cg)
}

// emitForInMapStmt handles for-in loops over maps.
// Uses hash-based layout: iterates 0..capacity, skipping unoccupied slots.
fn emitForInMapStmt(cg: *CodeGen, stmt: ast.Stmt, mapReg: string, mapLLType: string, keyLL: string) {
    mapStructType := str.Substr(mapLLType, 0, str.Len(mapLLType) - 1)
    _, mapValLL, _ := parseMapTypeLL(mapLLType)
    emitMapTypeDecl(cg, mapTypeName(keyLL, mapValLL), keyLL, mapValLL)

    // A nil map iterates zero times (Go semantics) — skip the loop so the
    // header loads below never dereference null.
    nilSkipLabel := nextLabel(cg)
    nonNilLabel := nextLabel(cg)
    isNullMap := nextReg(cg)
    emitfmt(cg, "  %s = icmp eq %s %s, null\n", []string{isNullMap, mapLLType, mapReg})
    emitCondBranch(cg, isNullMap, nilSkipLabel, nonNilLabel)
    emitLabel(cg, nonNilLabel)

    // Load keys array (field 0).
    keysField := nextReg(cg)
    emitfmt(cg, "  %s = getelementptr inbounds %s, %s %s, i32 0, i32 0\n", []string{keysField, mapStructType, mapLLType, mapReg})
    keysPtr := nextReg(cg)
    emitfmt(cg, "  %s = load %s*, %s** %s\n", []string{keysPtr, keyLL, keyLL, keysField})

    // Load occupied array (field 2).
    occField := nextReg(cg)
    emitfmt(cg, "  %s = getelementptr inbounds %s, %s %s, i32 0, i32 2\n", []string{occField, mapStructType, mapLLType, mapReg})
    occPtr := nextReg(cg)
    emitfmt(cg, "  %s = load i8*, i8** %s\n", []string{occPtr, occField})

    // Load capacity (field 3).
    capField := nextReg(cg)
    emitfmt(cg, "  %s = getelementptr inbounds %s, %s %s, i32 0, i32 3\n", []string{capField, mapStructType, mapLLType, mapReg})
    capReg := nextReg(cg)
    emitfmt(cg, "  %s = load i32, i32* %s\n", []string{capReg, capField})

    // Allocate index counter and loop variable
    idxAlloca := emitAlloca(cg, "i32")
    emitStore(cg, "i32", "0", "i32", idxAlloca)

    varAlloca := emitAlloca(cg, keyLL)
    declareVar(cg, stmt.forIterVar, varAlloca, keyLL, checker.unknownType())

    // If two-variable for-in (for k, v in map), also declare the value variable.
    hasTwoVars := str.Len(stmt.forIterVar2) > 0
    valAlloca := ""
    valLL := ""
    valsPtrReg := ""
    if hasTwoVars {
        // The value type comes from parseMapTypeLL — desanitizeLLTypeName
        // handles multi-level pointers (e.g. "i8PtrPtr" -> "i8**"), unlike
        // unsanitizeLLTypeName which strips only one Ptr suffix.
        valLL = mapValLL
        valAlloca = emitAlloca(cg, valLL)
        declareVar(cg, stmt.forIterVar2, valAlloca, valLL, checker.unknownType())
        // Load values array pointer (field 1).
        valsField := nextReg(cg)
        emitfmt(cg, "  %s = getelementptr inbounds %s, %s %s, i32 0, i32 1\n", []string{valsField, mapStructType, mapLLType, mapReg})
        valsPtrReg = nextReg(cg)
        emitfmt(cg, "  %s = load %s*, %s** %s\n", []string{valsPtrReg, valLL, valLL, valsField})
    }

    condLabel := nextLabel(cg)
    checkLabel := nextLabel(cg)
    bodyLabel := nextLabel(cg)
    postLabel := nextLabel(cg)
    endLabel := nextLabel(cg)
    pushLoopLabel(cg, postLabel, endLabel)

    emitBranch(cg, condLabel)

    emitLabel(cg, condLabel)
    idxLoad := emitLoad(cg, "i32", "i32", idxAlloca)
    cmpReg := nextReg(cg)
    emitfmt(cg, "  %s = icmp slt i32 %s, %s\n", []string{cmpReg, idxLoad, capReg})
    emitCondBranch(cg, cmpReg, checkLabel, endLabel)

    // Check if slot is occupied; skip if not.
    emitLabel(cg, checkLabel)
    occGep := nextReg(cg)
    emitfmt(cg, "  %s = getelementptr inbounds i8, i8* %s, i32 %s\n", []string{occGep, occPtr, idxLoad})
    occVal := nextReg(cg)
    emitfmt(cg, "  %s = load i8, i8* %s\n", []string{occVal, occGep})
    occBool := nextReg(cg)
    emitfmt(cg, "  %s = icmp eq i8 %s, 0\n", []string{occBool, occVal})
    emitCondBranch(cg, occBool, postLabel, bodyLabel)

    emitLabel(cg, bodyLabel)
    pushScope(cg)
    keyGep := nextReg(cg)
    emitfmt(cg, "  %s = getelementptr inbounds %s, %s* %s, i32 %s\n", []string{keyGep, keyLL, keyLL, keysPtr, idxLoad})
    keyVal := nextReg(cg)
    emitfmt(cg, "  %s = load %s, %s* %s\n", []string{keyVal, keyLL, keyLL, keyGep})
    // Keys/values are borrowed from the map; the loop variables take
    // their own references since they are scope-tracked and released.
    if isHeapLLType(keyLL) {
        keyVal = emitRetain(cg, keyVal, keyLL)
    } else if isCompositeType(keyLL) && !str.EndsWith(keyLL, "*") {
        keyVal = emitRetainStructHeapFields(cg, keyVal, keyLL)
    }
    // Store through varValuePtr: a captured iteration variable was boxed
    // at declare time, and literals in the body read through the box
    // (comp_error.md #39).
    keySV, _ := lookupVar(cg, stmt.forIterVar)
    emitStore(cg, keyLL, keyVal, keyLL, varValuePtr(cg, keySV))
    // If two-variable for-in, also load and store the value.
    if hasTwoVars {
        valGep := nextReg(cg)
        emitfmt(cg, "  %s = getelementptr inbounds %s, %s* %s, i32 %s\n", []string{valGep, valLL, valLL, valsPtrReg, idxLoad})
        valVal := nextReg(cg)
        emitfmt(cg, "  %s = load %s, %s* %s\n", []string{valVal, valLL, valLL, valGep})
        if isHeapLLType(valLL) {
            valVal = emitRetain(cg, valVal, valLL)
        } else if isCompositeType(valLL) && !str.EndsWith(valLL, "*") {
            valVal = emitRetainStructHeapFields(cg, valVal, valLL)
        }
        valSV, _ := lookupVar(cg, stmt.forIterVar2)
        emitStore(cg, valLL, valVal, valLL, varValuePtr(cg, valSV))
    }
    emitBlockStmtRaw(cg, stmt.thenBody)
    popScope(cg)
    if !cg.terminated {
        emitBranch(cg, postLabel)
    }

    emitLabel(cg, postLabel)
    idxLoad3 := emitLoad(cg, "i32", "i32", idxAlloca)
    nextIdx := emitBinaryOp(cg, "add", "i32", idxLoad3, "1")
    emitStore(cg, "i32", nextIdx, "i32", idxAlloca)
    emitBranch(cg, condLabel)

    emitLabel(cg, endLabel)
    popLoopLabel(cg)
    // Nil-map path lands here and falls through to the continuation.
    emitLabel(cg, nilSkipLabel)
}

// emitForInSetStmt handles for-in loops over sets.
// Sets use { elem*, i32 } layout: field 0 = data pointer, field 1 = count.
fn emitForInSetStmt(cg: *CodeGen, stmt: ast.Stmt, setReg: string, setLLType: string, elemLL: string) {
    setStructType := str.Substr(setLLType, 0, str.Len(setLLType) - 1)

    // Load data pointer (field 0).
    dataField := nextReg(cg)
    emitfmt(cg, "  %s = getelementptr inbounds %s, %s %s, i32 0, i32 0\n", []string{dataField, setStructType, setLLType, setReg})
    dataPtr := nextReg(cg)
    emitfmt(cg, "  %s = load %s*, %s** %s\n", []string{dataPtr, elemLL, elemLL, dataField})

    // Load count (field 1).
    countField := nextReg(cg)
    emitfmt(cg, "  %s = getelementptr inbounds %s, %s %s, i32 0, i32 1\n", []string{countField, setStructType, setLLType, setReg})
    countReg := nextReg(cg)
    emitfmt(cg, "  %s = load i32, i32* %s\n", []string{countReg, countField})

    // Allocate index counter and loop variable.
    idxAlloca := emitAlloca(cg, "i32")
    emitStore(cg, "i32", "0", "i32", idxAlloca)

    varAlloca := emitAlloca(cg, elemLL)
    declareVar(cg, stmt.forIterVar, varAlloca, elemLL, checker.unknownType())

    condLabel := nextLabel(cg)
    bodyLabel := nextLabel(cg)
    postLabel := nextLabel(cg)
    endLabel := nextLabel(cg)
    pushLoopLabel(cg, postLabel, endLabel)

    emitBranch(cg, condLabel)

    emitLabel(cg, condLabel)
    idxLoad := emitLoad(cg, "i32", "i32", idxAlloca)
    cmpReg := nextReg(cg)
    emitfmt(cg, "  %s = icmp slt i32 %s, %s\n", []string{cmpReg, idxLoad, countReg})
    emitCondBranch(cg, cmpReg, bodyLabel, endLabel)

    emitLabel(cg, bodyLabel)
    pushScope(cg)
    elemGep := nextReg(cg)
    emitfmt(cg, "  %s = getelementptr inbounds %s, %s* %s, i32 %s\n", []string{elemGep, elemLL, elemLL, dataPtr, idxLoad})
    elemVal := nextReg(cg)
    emitfmt(cg, "  %s = load %s, %s* %s\n", []string{elemVal, elemLL, elemLL, elemGep})
    // Elements are borrowed from the set; the loop variable takes its own.
    if isHeapLLType(elemLL) {
        elemVal = emitRetain(cg, elemVal, elemLL)
    } else if isCompositeType(elemLL) && !str.EndsWith(elemLL, "*") {
        elemVal = emitRetainStructHeapFields(cg, elemVal, elemLL)
    }
    // Store through varValuePtr: a captured iteration variable was boxed
    // at declare time (comp_error.md #39).
    setSV, _ := lookupVar(cg, stmt.forIterVar)
    emitStore(cg, elemLL, elemVal, elemLL, varValuePtr(cg, setSV))
    emitBlockStmtRaw(cg, stmt.thenBody)
    popScope(cg)
    if !cg.terminated {
        emitBranch(cg, postLabel)
    }

    emitLabel(cg, postLabel)
    idxLoad3 := emitLoad(cg, "i32", "i32", idxAlloca)
    nextIdx := emitBinaryOp(cg, "add", "i32", idxLoad3, "1")
    emitStore(cg, "i32", nextIdx, "i32", idxAlloca)
    emitBranch(cg, condLabel)

    emitLabel(cg, endLabel)
    popLoopLabel(cg)
}

// emitBlockStmt handles block statements (with scope push/pop).
fn emitBlockStmt(cg: *CodeGen, stmt: ast.Stmt) {
    pushScope(cg)
    emitBlockStmtRaw(cg, stmt.thenBody)
    popScope(cg)
}

// emitBlockStmtRaw emits a slice of statements without scope management.
fn emitBlockStmtRaw(cg: *CodeGen, stmts: []ast.Stmt) {
    i := 0
    for i < len(stmts) {
        if cg.terminated {
            break
        }
        emitStatement(cg, stmts[i])
        i = i + 1
    }
}

// emitBlockStmtWithImplicitReturn emits a block, and if the last statement
// is an expression statement and the block hasn't been terminated, treats
// the last expression as an implicit return value.
fn emitBlockStmtWithImplicitReturn(cg: *CodeGen, stmts: []ast.Stmt, retType: string) {
    if len(stmts) == 0 {
        return
    }
    // Emit all but the last statement
    i := 0
    for i < len(stmts) - 1 {
        if cg.terminated {
            break
        }
        emitStatement(cg, stmts[i])
        i = i + 1
    }
    if cg.terminated {
        return
    }
    last := stmts[len(stmts) - 1]
    // Handle match statement as implicit return (expression-bodied function)
    if last.kind == ast.ST_MATCH && !str.Equal(retType, "void") {
        // Check if the match arms have expression bodies (expression match)
        // or return statements (statement match). If any arm has a return,
        // emit as a statement and let the arms handle returns.
        hasReturnArms := false
        armIdx := 0
        for armIdx < len(last.matchArms) {
            arm := last.matchArms[armIdx]
            if len(arm.body) > 0 {
                armLast := arm.body[len(arm.body) - 1]
                if armLast.kind == ast.ST_RETURN {
                    hasReturnArms = true
                }
            }
            armIdx = armIdx + 1
        }
        if hasReturnArms {
            // Statement match: arms contain return statements, just emit as statement
            emitMatchStmt(cg, last)
        } else {
            // Expression match: wrap as expression and return result
            e := ast.Expr{kind: ast.EX_MATCH_EXPR}
            e.matchExprSubject = last.matchSubject
            e.matchExprArms = last.matchArms
            valReg := emitExpression(cg, e)
            valType := exprLLType(cg, e)
            // Handle struct-by-value: if return type is a struct but we have a pointer, load it
            if str.StartsWith(retType, "%struct.") && !str.EndsWith(retType, "*") &&
                str.EndsWith(valType, "*") {
                loaded := emitLoad(cg, retType, retType, valReg)
                emitRelease(cg, valReg, valType)
                valReg = loaded
            }
            if isHeapLLType(retType) {
                valReg = emitRetain(cg, valReg, retType)
            }
            emitAllDeallocations(cg)
            emitRet(cg, retType, valReg)
            cg.terminated = true
        }
    } else if last.kind == ast.ST_EXPR && !str.Equal(retType, "void") {
        // Implicit return: evaluate the expression and return it
        valReg := emitExpression(cg, last.expr[0])
        // Handle type conversions
        if str.Equal(retType, "i32") && str.Equal(exprLLType(cg, last.expr[0]), "i1") {
            zext := nextReg(cg)
            emitfmt(cg, "  %s = zext i1 %s to i32\n", []string{zext, valReg})
            valReg = zext
        }
        if str.Equal(retType, "i32") && str.Equal(exprLLType(cg, last.expr[0]), "double") {
            conv := nextReg(cg)
            emitfmt(cg, "  %s = fptosi double %s to i32\n", []string{conv, valReg})
            valReg = conv
        }
        // ARC: retain heap return value so the caller receives +1. Owned
        // temporaries are scope-tracked; emitAllDeallocations releases the
        // temporary's own reference and keeps the count balanced.
        if isHeapLLType(retType) {
            valReg = emitRetain(cg, valReg, retType)
        }
        emitAllDeallocations(cg)
        emitRet(cg, retType, valReg)
        cg.terminated = true
    } else {
        emitStatement(cg, last)
    }
}

// emitDeferNodeType declares the deferred-call node type once per
// module: { next node, thunk code pointer, env handle }. Nodes are
// allocated with Skink_rc_alloc and released as the defer stack drains.
fn emitDeferNodeType(cg: *CodeGen) {
    if cg.deferNodeTypeEmitted {
        return
    }
    cg.deferNodeTypeEmitted = true
    emitHeader(cg, "%__defer_node = type { i8*, i8*, i8* }\n")
}

// emitDeferQueueInit allocates and null-initializes the current
// function's defer stack head. The head lives in a heap block rather
// than an alloca: locals mutated between setjmp and longjmp are
// indeterminate (-O2 mem2reg promotes the alloca to a register, which a
// panic unwind clobbers — comp_error.md #42), while heap memory is
// untouched by the stack restore. It must run before
// emitPanicPrologue: a setjmp re-entry must not re-run the
// initialization and lose the pending registrations.
fn emitDeferQueueInit(cg: *CodeGen) {
    slot := nextReg(cg)
    emitfmt(cg, "  %s = call i8* @Skink_rc_alloc(i64 8)\n", []string{slot})
    slotPtr := nextReg(cg)
    emitfmt(cg, "  %s = bitcast i8* %s to i8**\n", []string{slotPtr, slot})
    emitStore(cg, "i8*", "null", "i8*", slotPtr)
    cg.deferQueueAlloca = slotPtr
}

// emitDeferTemp evaluates e at the defer statement and stores the result
// in a hidden local, returning an ident expression that refers to it.
// Deferred call arguments are evaluated where the defer executes — not
// where the deferred call runs — so each loop iteration captures its own
// values (comp_error.md #42). The synthesized ident inherits e's source
// position so checkers lookups (exprLLType/exprSkinkType) inside the
// deferred thunk still resolve the original expression's type.
fn emitDeferTemp(cg: *CodeGen, e: ast.Expr) -> ast.Expr {
    valReg := emitExpression(cg, e)
    ll := exprLLType(cg, e)
    synT := exprSkinkType(cg, e)
    alloca := emitAlloca(cg, ll)
    if isHeapLLType(ll) {
        valReg = emitRetain(cg, valReg, ll)
    }
    emitStore(cg, ll, valReg, ll, alloca)
    cg.deferTmpCounter = cg.deferTmpCounter + 1
    tmpName := str.Concat("__defertmp_", strconv.Itoa(cg.deferTmpCounter))
    declareVar(cg, tmpName, alloca, ll, synT)
    id := ast.newExpr(ast.EX_IDENT, e.line, e.col)
    id.ident = tmpName
    return id
}

// deferCalleeNeedsTemp reports whether a deferred call's callee must be
// evaluated at the defer point rather than inside the deferred thunk.
// Function literals bind their capture environment when evaluated — a
// literal whose env packs a block-scoped box must materialize while that
// block is still live (comp_error.md #41) — and function-typed locals
// are bound eagerly so a later reassignment does not change the
// deferred call.
fn deferCalleeNeedsTemp(cg: *CodeGen, callee: ast.Expr) -> bool {
    if callee.kind == ast.EX_FN_LIT {
        return true
    }
    if callee.kind == ast.EX_IDENT {
        _, isLocal := lookupVar(cg, callee.ident)
        return isLocal
    }
    return false
}

// emitDeferDrain emits the LIFO drain of the function's runtime defer
// stack. Every exit path runs the same drain: each head node invokes
// its thunk with the env handle, then the node and env are released.
// Static (capture-less) handles survive Skink_rc_release because they
// are not RC blocks.
fn emitDeferDrain(cg: *CodeGen) {
    if str.Len(cg.deferQueueAlloca) == 0 {
        // Fallback for frames where the defer stack was not installed.
        if cg.hasDefer {
            j := len(cg.deferred) - 1
            for j >= 0 {
                emitStatement(cg, cg.deferred[j])
                j = j - 1
            }
        }
        return
    }
    loopL := nextLabel(cg)
    bodyL := nextLabel(cg)
    doneL := nextLabel(cg)
    emitln(cg, str.Concat("  br label %", loopL))
    emitLabel(cg, loopL)
    head := nextReg(cg)
    emitfmt(cg, "  %s = load i8*, i8** %s\n", []string{head, cg.deferQueueAlloca})
    isNull := nextReg(cg)
    emitfmt(cg, "  %s = icmp eq i8* %s, null\n", []string{isNull, head})
    emitln(cg, concatMany([]string{"  br i1 ", isNull, ", label %", doneL, ", label %", bodyL}))
    emitLabel(cg, bodyL)
    node := nextReg(cg)
    emitfmt(cg, "  %s = bitcast i8* %s to %__defer_node*\n", []string{node, head})
    nextSlot := nextReg(cg)
    emitfmt(cg, "  %s = getelementptr inbounds %__defer_node, %__defer_node* %s, i32 0, i32 0\n", []string{nextSlot, node})
    nextHead := nextReg(cg)
    emitfmt(cg, "  %s = load i8*, i8** %s\n", []string{nextHead, nextSlot})
    // Pop before invoking the thunk: a deferred call may itself register
    // a defer, which must land after the remaining earlier registrations.
    emitStore(cg, "i8*", nextHead, "i8*", cg.deferQueueAlloca)
    codeSlot := nextReg(cg)
    emitfmt(cg, "  %s = getelementptr inbounds %__defer_node, %__defer_node* %s, i32 0, i32 1\n", []string{codeSlot, node})
    codeRaw := nextReg(cg)
    emitfmt(cg, "  %s = load i8*, i8** %s\n", []string{codeRaw, codeSlot})
    envSlot := nextReg(cg)
    emitfmt(cg, "  %s = getelementptr inbounds %__defer_node, %__defer_node* %s, i32 0, i32 2\n", []string{envSlot, node})
    envReg := nextReg(cg)
    emitfmt(cg, "  %s = load i8*, i8** %s\n", []string{envReg, envSlot})
    thunk := nextReg(cg)
    emitfmt(cg, "  %s = bitcast i8* %s to void (i8*)*\n", []string{thunk, codeRaw})
    emitfmt(cg, "  call void %s(i8* %s)\n", []string{thunk, envReg})
    emitfmt(cg, "  call void @Skink_rc_release(i8* %s)\n", []string{envReg})
    emitfmt(cg, "  call void @Skink_rc_release(i8* %s)\n", []string{head})
    emitln(cg, str.Concat("  br label %", loopL))
    emitLabel(cg, doneL)
    // Release the heap head slot; each exit path emits its own drain, so
    // exactly one release executes per function exit.
    slotFree := nextReg(cg)
    emitfmt(cg, "  %s = bitcast i8** %s to i8*\n", []string{slotFree, cg.deferQueueAlloca})
    emitfmt(cg, "  call void @Skink_rc_release(i8* %s)\n", []string{slotFree})
}

// emitDeferStmt compiles a defer into a runtime registration: the
// deferred call is wrapped in a zero-argument thunk literal — built now
// so its capture environment binds in the scope live at the defer
// statement — and pushed onto the function's defer stack. Arguments are
// hoisted into hidden temporaries evaluated at the defer point, so a
// defer inside a loop registers once per iteration with that
// iteration's values (comp_error.md #41/#42).
fn emitDeferStmt(cg: *CodeGen, stmt: ast.Stmt) {
    cg.hasDefer = true
    if str.Len(cg.deferQueueAlloca) == 0 {
        errorf(cg, "internal error: defer outside a defer-enabled function frame")
        return
    }
    inner := stmt.deferStmt[0]

    var thunkBody ast.Stmt
    if inner.kind == ast.ST_EXPR && len(inner.expr) > 0 && inner.expr[0].kind == ast.EX_CALL {
        call := inner.expr[0]
        argExprs := []ast.Expr{}
        ai := 0
        for ai < len(call.callArgs) {
            argExprs = append(argExprs, emitDeferTemp(cg, call.callArgs[ai]))
            ai = ai + 1
        }
        callee := call.callFunc[0]
        if deferCalleeNeedsTemp(cg, callee) {
            callee = emitDeferTemp(cg, callee)
        }
        callExpr := ast.newExpr(ast.EX_CALL, call.line, call.col)
        callExpr.callFunc = ast.singleExpr(callee)
        callExpr.callArgs = argExprs
        thunkBody = ast.newStmt(ast.ST_EXPR, stmt.line, stmt.col)
        thunkBody.expr = ast.singleExpr(callExpr)
    } else {
        thunkBody = inner
    }
    lit := ast.newExpr(ast.EX_FN_LIT, stmt.line, stmt.col)
    lit.fnLitBody = []ast.Stmt{thunkBody}
    handleReg := emitFnLit(cg, lit)

    // Push {next, code, env} onto the defer stack; the env slot keeps the
    // handle alive until the drain releases it.
    emitDeferNodeType(cg)
    rawNode := nextReg(cg)
    emitfmt(cg, "  %s = call i8* @Skink_rc_alloc(i64 24)\n", []string{rawNode})
    nodeReg := nextReg(cg)
    emitfmt(cg, "  %s = bitcast i8* %s to %__defer_node*\n", []string{nodeReg, rawNode})
    handlePtr := nextReg(cg)
    emitfmt(cg, "  %s = bitcast i8* %s to i8**\n", []string{handlePtr, handleReg})
    codeReg := nextReg(cg)
    emitfmt(cg, "  %s = load i8*, i8** %s\n", []string{codeReg, handlePtr})
    nextSlot := nextReg(cg)
    emitfmt(cg, "  %s = getelementptr inbounds %__defer_node, %__defer_node* %s, i32 0, i32 0\n", []string{nextSlot, nodeReg})
    oldHead := nextReg(cg)
    emitfmt(cg, "  %s = load i8*, i8** %s\n", []string{oldHead, cg.deferQueueAlloca})
    emitStore(cg, "i8*", oldHead, "i8*", nextSlot)
    codeSlot := nextReg(cg)
    emitfmt(cg, "  %s = getelementptr inbounds %__defer_node, %__defer_node* %s, i32 0, i32 1\n", []string{codeSlot, nodeReg})
    emitStore(cg, "i8*", codeReg, "i8*", codeSlot)
    envSlot := nextReg(cg)
    emitfmt(cg, "  %s = getelementptr inbounds %__defer_node, %__defer_node* %s, i32 0, i32 2\n", []string{envSlot, nodeReg})
    emitStore(cg, "i8*", handleReg, "i8*", envSlot)
    emitStore(cg, "i8*", rawNode, "i8*", cg.deferQueueAlloca)
}

// === Declaration Emission ===

// emitFnDecl handles function declarations.
fn emitFnDecl(cg: *CodeGen, d: ast.Decl) {
    fnName := d.fnName
    // Rename main to _skink_main so we can emit a C entry point wrapper —
    // but only for the real entry point in module main. A `fn main` in a
    // library module is an ordinary function (e.g. foo.main); renaming it
    // would collide with the harness main when `skink -t` imports a module
    // that still contains its own main (comp_error.md #116).
    mainShort := fnName
    mainDot := str.LastIndexOf(fnName, ".")
    if mainDot >= 0 {
        mainShort = str.Substr(fnName, mainDot + 1, str.Len(fnName) - mainDot - 1)
    }
    if str.Len(mainShort) == 4 && mainShort[0] == 109 && mainShort[1] == 97 && mainShort[2] == 105 && mainShort[3] == 110 {
        entryMod := d.moduleName
        if mainDot >= 0 {
            entryMod = str.Substr(fnName, 0, mainDot)
        }
        if str.Len(entryMod) == 0 || str.Equal(entryMod, "main") {
            fnName = "_skink_main"
        } else if !cg.hasModuleMainEntry && !cg.entryMainEmitted {
            // No main.main exists in this program — keep the historical
            // behaviour where a lone library `fn main` is the entry point
            // (single-file programs like the samples repo's modules).
            // Only the first such function wins; a second library main
            // stays an ordinary function.
            fnName = "_skink_main"
            cg.entryMainEmitted = true
        }
    }
    // Save state
    savedRetTypes := cg.currentFnRetTypes
    savedRetNames := cg.currentFnRetNames
    savedRegCounter := cg.regCounter
    savedLabelCounter := cg.labelCounter
    savedDeferred := cg.deferred
    savedHasDefer := cg.hasDefer
    savedNeedPanicLanding := cg.needPanicLanding
    savedCurrentModule := cg.currentModule
    savedAllocaBuffer := cg.allocaBuffer
    savedLoopLabelDepth := cg.loopLabelDepth
    savedCheckerMod := cg.checker.currentModule
    savedFnReturnLabel := cg.fnReturnLabel
    savedFnReturnAlloca := cg.fnReturnAlloca
    savedEscapedVars := cg.escapedVars
    savedCapturedVars := cg.capturedVars
    savedDeferQueueAlloca := cg.deferQueueAlloca
    cg.currentModule = ""
    // Use the original function name (d.fnName) for module detection,
    // since fnName may have been renamed (e.g. main -> _skink_main).
    moduleDot := str.IndexOf(d.fnName, ".")
    if moduleDot > 0 {
        cg.currentModule = str.Substr(d.fnName, 0, moduleDot)
    } else if str.Len(d.fnName) > 0 {
        // For unqualified functions, use the decl's own module (set by the
        // resolver); fall back to the checker's current module context.
        if str.Len(d.moduleName) > 0 {
            cg.currentModule = d.moduleName
        } else if str.Len(cg.checker.currentModule) > 0 {
            cg.currentModule = cg.checker.currentModule
        }
    }
    // Set checker module context for type resolution
    cg.checker.currentModule = cg.currentModule

    // Escape-analysis pre-scan: locals whose address is taken via `&`
    // anywhere in this body are boxed into RC heap blocks so the pointer
    // stays valid after the frame returns. The same scan collects
    // names occurring inside function-literal bodies — those must box at
    // declaration time too, so the box outlives any enclosing loop that
    // re-executes the literal's evaluation site (comp_error.md #39).
    escapeScan := collectEscapedVars(d.fnBody)
    cg.escapedVars = escapeScan.escaped
    cg.capturedVars = escapeScan.captured

    // Determine return type and individual return types for multi-return
    retType := "void"
    allRetTypes := []string{}
    if len(d.fnRetTypes) > 1 {
        // Multi-return: build aggregate struct type
        i := 0
        for i < len(d.fnRetTypes) {
            t := checker.astTypeToType(cg.checker, d.fnRetTypes[i])
            allRetTypes = append(allRetTypes, llvmType(cg, t))
            i = i + 1
        }
        retType = aggregateRetType(allRetTypes)
    } else if len(d.fnRetTypes) > 0 {
        t := checker.astTypeToType(cg.checker, d.fnRetTypes[0])
        retType = llvmType(cg, t)
        allRetTypes = append(allRetTypes, retType)
    }

    // Build parameter list
    // Composite by-value types (struct, map, set) are passed as pointers
    // (ABI convention) to avoid excessive stack usage in recursive functions.
    paramStrs := []string{}
    i := 0
    for i < len(d.fnParams) {
        paramType := "i32"
        if len(d.fnParams[i].typ) > 0 {
            t := checker.astTypeToType(cg.checker, d.fnParams[i].typ[0])
            paramType = llvmType(cg, t)
        }
        sigType := paramLLType(paramType)
        paramStrs = append(paramStrs, str.Concat(sigType, str.Concat(" %arg",
            strconv.Itoa(i))))
        i = i + 1
    }
    // Emit function header
    parts := []string{}
    parts = append(parts, "define ")
    parts = append(parts, retType)
    parts = append(parts, " @")
    parts = append(parts, fnName)
    parts = append(parts, "(")
    parts = append(parts, str.Join(paramStrs, ", "))
    parts = append(parts, ")")
    // Create DISubprogram for debug info
    if cg.dbgEnabled && str.Len(cg.currentFilePath) > 0 {
        fileId := getOrCreateDIFile(cg, cg.currentFilePath)
        cg.dbgCurrentFile = fileId
        retDbg := dbgType(cg, retType)
        paramDbgs := []string{retDbg}
        pi := 0
        for pi < len(d.fnParams) {
            paramType := "i32"
            if len(d.fnParams[pi].typ) > 0 {
                pt := checker.astTypeToType(cg.checker, d.fnParams[pi].typ[0])
                paramType = llvmType(cg, pt)
            }
            paramDbgs = append(paramDbgs, dbgType(cg, paramType))
            pi = pi + 1
        }
        typesListId := nextDbgMeta(cg)
        typesDef := str.Concat(typesListId, " = !{")
        pj := 0
        for pj < len(paramDbgs) {
            if pj > 0 {
                typesDef = str.Concat(typesDef, ", ")
            }
            typesDef = str.Concat(typesDef, paramDbgs[pj])
            pj = pj + 1
        }
        typesDef = str.Concat(typesDef, "}")
        setDbgMeta(cg, typesListId, typesDef)
        subrId := nextDbgMeta(cg)
        setDbgMeta(cg, subrId, str.Concat(str.Concat(subrId, " = !DISubroutineType(types: "), str.Concat(typesListId, ")")))
        spId := nextDbgMeta(cg)
        fnLine := cg.currentStmtLine
        if fnLine <= 0 {
            fnLine = 1
        }
        emptyNodesId := nextDbgMeta(cg)
        setDbgMeta(cg, emptyNodesId, str.Concat(emptyNodesId, " = !{}"))
        spDef := str.Concat(spId, " = distinct !DISubprogram(name: \"")
        spDef = str.Concat(spDef, fnName)
        spDef = str.Concat(spDef, "\", scope: ")
        spDef = str.Concat(spDef, fileId)
        spDef = str.Concat(spDef, ", file: ")
        spDef = str.Concat(spDef, fileId)
        spDef = str.Concat(spDef, ", line: ")
        spDef = str.Concat(spDef, strconv.Itoa(fnLine))
        spDef = str.Concat(spDef, ", type: ")
        spDef = str.Concat(spDef, subrId)
        spDef = str.Concat(spDef, ", scopeLine: ")
        spDef = str.Concat(spDef, strconv.Itoa(fnLine))
        spDef = str.Concat(spDef, ", spFlags: DISPFlagDefinition, unit: ")
        spDef = str.Concat(spDef, cg.dbgCompileUnit)
        spDef = str.Concat(spDef, ", retainedNodes: ")
        spDef = str.Concat(spDef, emptyNodesId)
        spDef = str.Concat(spDef, ")")
        setDbgMeta(cg, spId, spDef)
        cg.dbgCurrentSubprogram = spId
        parts = append(parts, str.Concat(" !dbg ", spId))
    }
    parts = append(parts, " {\n")
    parts = append(parts, "entry:")
    emitln(cg, concatMany(parts))

    cg.currentFnRetTypes = allRetTypes
    cg.currentFnRetNames = d.fnRetNames
    cg.regCounter = 0
    cg.labelCounter = 0
    cg.deferred = []ast.Stmt{}
    cg.hasDefer = false
    cg.deferQueueAlloca = ""
    cg.needPanicLanding = stmtsContainDefer(d.fnBody)
    cg.terminated = false
    cg.loopLabelDepth = 0

    // Set up error propagation support: a return label and return alloca
    // for functions that return an error as the last value.
    cg.fnReturnLabel = ""
    cg.fnReturnAlloca = ""
    needFnReturnAlloca := false
    if len(allRetTypes) > 1 {
        lastRet := allRetTypes[len(allRetTypes) - 1]
        if str.Equal(lastRet, "%struct.errors_Error") {
            cg.fnReturnLabel = str.Concat("__fn_ret_", strconv.Itoa(cg.labelCounter))
            needFnReturnAlloca = true
        }
    }

    // Reset alloca buffer for this function
    cg.allocaBuffer = str.NewBuilder(4096)

    // Now that the alloca buffer is reset, allocate the return alloca.
    if needFnReturnAlloca {
        cg.fnReturnAlloca = emitAlloca(cg, retType)
    }

    // Reset scope
    cg.scopeVars = []ScopeV{}
    cg.scopeVars = append(cg.scopeVars, scopeVMake())
    cg.scopeDepth = 0

    // Save the main output buffer and switch to a body buffer.
    // This lets us collect all allocas (parameter + body) in allocaBuffer
    // and emit them at the entry block start, dominating all uses.
    savedOut := cg.out
    cg.out = str.NewBuilder(8192)

    // Allocate parameters (allocas go into allocaBuffer)
    paramAllocaRegs := []string{}
    i = 0
    for i < len(d.fnParams) {
        param := d.fnParams[i]
        paramType := "i32"
        if len(param.typ) > 0 {
            t := checker.astTypeToType(cg.checker, param.typ[0])
            paramType = llvmType(cg, t)
        }
        // For composite by-value types, the alloca holds the struct value
        // (the parameter is a pointer to the caller's struct).
        allocaType := paramType
        allocaReg := emitAlloca(cg, allocaType)
        paramAllocaRegs = append(paramAllocaRegs, allocaReg)
        // Parameters get an owned copy: the entry store retains (below)
        // and the scope-0 release emitted on every return path (after
        // deferred statements, in emitRet) balances it. Owning the copy is
        // required so that reassigning a parameter (x = f(x)) releases the
        // callee-owned value rather than the caller's borrowed argument.
        sv := ScopeVar{}
        sv.alloca = allocaReg
        sv.llType = paramType
        if len(param.typ) > 0 {
            sv.synType = checker.astTypeToType(cg.checker, param.typ[0])
        } else {
            sv.synType = checker.unknownType()
        }
        sv.borrowed = false
        scopeVSet(&cg.scopeVars[cg.scopeDepth], param.name, sv)
        i = i + 1
    }

    // Emit parameter stores (into body buffer)
    i = 0
    for i < len(d.fnParams) {
        paramType := "i32"
        if len(d.fnParams[i].typ) > 0 {
            t := checker.astTypeToType(cg.checker, d.fnParams[i].typ[0])
            paramType = llvmType(cg, t)
        }
        argName := str.Concat("%arg", strconv.Itoa(i))
        if isCompositeType(paramType) && !str.EndsWith(paramType, "*") {
            // Composite by-value: parameter is a pointer, load the struct
            // from it and store into the local alloca. The callee owns
            // this copy: retain its heap fields.
            copyReg := nextReg(cg)
            emitln(cg, str.Concat(str.Concat(str.Concat(str.Concat(str.Concat("  ", copyReg), " = load "), paramType), ", "), str.Concat(str.Concat(str.Concat(paramType, "* "), argName), "")))
            copyReg = emitRetainStructHeapFields(cg, copyReg, paramType)
            emitStore(cg, paramType, copyReg, paramType, paramAllocaRegs[i])
        } else {
            // Owned reference: retain heap parameters on entry.
            if isHeapLLType(paramType) {
                emitRetain(cg, argName, paramType)
            }
            emitStore(cg, paramType, argName, paramType, paramAllocaRegs[i])
        }
        i = i + 1
    }

    // Box parameters whose address is taken inside the function — their
    // values must live in an RC heap block so `&param` stays valid after
    // return. Done after the entry stores so the box copies the argument.
    i = 0
    for i < len(d.fnParams) {
        if cg.escapedVars[d.fnParams[i].name] || cg.capturedVars[d.fnParams[i].name] {
            psv := scopeVGet(&cg.scopeVars[cg.scopeDepth], d.fnParams[i].name)
            promoteEscapedVar(cg, d.fnParams[i].name, psv)
        }
        i = i + 1
    }

    // Allocate named return variables (if any).
    if len(d.fnRetNames) > 0 {
        for i = 0; i < len(d.fnRetNames); i = i + 1 {
            if str.Len(d.fnRetNames[i]) > 0 && i < len(allRetTypes) {
                retLLType := allRetTypes[i]
                retAlloca := emitAlloca(cg, retLLType)
                // Initialize to zero value.
                if str.Equal(retLLType, "i8*") {
                    emptyStr := emitStringLiteral(cg, "")
                    emitStore(cg, "i8*", emptyStr, "i8*", retAlloca)
                } else if str.EndsWith(retLLType, "*") {
                    emitStore(cg, retLLType, "null", retLLType, retAlloca)
                } else if str.StartsWith(retLLType, "%struct.") || str.StartsWith(retLLType, "%map_") || str.StartsWith(retLLType, "%set.") || str.StartsWith(retLLType, "{") {
                    emitStore(cg, retLLType, "zeroinitializer", retLLType, retAlloca)
                } else {
                    emitStore(cg, retLLType, zeroValueForLLType(retLLType), retLLType, retAlloca)
                }
                sv := ScopeVar{}
                sv.alloca = retAlloca
                sv.llType = retLLType
                sv.synType = checker.unknownType()
                // Named returns transfer their value to the caller: the
                // bare-return path loads the alloca without retaining, so
                // the slot's own reference is the returned one. Mark
                // borrowed so the scope-0 release does not free it.
                sv.borrowed = true
                scopeVSet(&cg.scopeVars[cg.scopeDepth], d.fnRetNames[i], sv)
                promoteEscapedVar(cg, d.fnRetNames[i], sv)
            }
        }
    }

    // Emit #dbg_declare for parameters (debug info)
    if cg.dbgEnabled && str.Len(cg.dbgCurrentSubprogram) > 0 {
        i = 0
        for i < len(d.fnParams) {
            param := d.fnParams[i]
            paramType := "i32"
            if len(param.typ) > 0 {
                pt := checker.astTypeToType(cg.checker, param.typ[0])
                paramType = llvmType(cg, pt)
            }
            varId := nextDbgMeta(cg)
            varDef := str.Concat(varId, " = !DILocalVariable(name: \"")
            varDef = str.Concat(varDef, param.name)
            varDef = str.Concat(varDef, "\", arg: ")
            varDef = str.Concat(varDef, strconv.Itoa(i + 1))
            varDef = str.Concat(varDef, ", scope: ")
            varDef = str.Concat(varDef, cg.dbgCurrentSubprogram)
            varDef = str.Concat(varDef, ", type: ")
            varDef = str.Concat(varDef, dbgType(cg, paramType))
            varDef = str.Concat(varDef, ")")
            setDbgMeta(cg, varId, varDef)
            fnLine := cg.currentStmtLine
            if fnLine <= 0 {
                fnLine = 1
            }
            locId := nextDbgMeta(cg)
            locDef := str.Concat(str.Concat(str.Concat(str.Concat(str.Concat(
                locId, " = !DILocation(line: "), strconv.Itoa(fnLine)),
                ", column: 0, scope: "), cg.dbgCurrentSubprogram), ")")
            setDbgMeta(cg, locId, locDef)
            // Use emit+WriteByte directly to avoid emitln appending !dbg
            dbgLine := str.Concat("  #dbg_declare(ptr ", paramAllocaRegs[i])
            dbgLine = str.Concat(dbgLine, ", ")
            dbgLine = str.Concat(dbgLine, varId)
            dbgLine = str.Concat(dbgLine, ", !DIExpression(), ")
            dbgLine = str.Concat(dbgLine, locId)
            dbgLine = str.Concat(dbgLine, ")")
            cg.out.Write(dbgLine)
            cg.out.WriteByte(10)
            i = i + 1
        }
    }

    // Emit function body (into body buffer). Functions containing defer
    // get a setjmp-based panic handler installed at entry so that a panic
    // in this frame (or any callee) unwinds through our deferred calls.
    // The defer stack head is initialized first: a setjmp re-entry must
    // not reset it and lose pending registrations.
    if cg.needPanicLanding {
        emitDeferQueueInit(cg)
        emitPanicPrologue(cg)
    }
    // The body gets its own scope (depth >= 1) so that locals declared
    // directly in the function body are released on every return path —
    // scope 0 is reserved for borrowed parameters and named return slots,
    // which emitAllDeallocations deliberately skips.
    pushScope(cg)
    cg.fnBodyActive = true
    if !str.Equal(retType, "void") {
        emitBlockStmtWithImplicitReturn(cg, d.fnBody, retType)
    } else {
        emitBlockStmtRaw(cg, d.fnBody)
    }

    // Note: deferred statements are now emitted by emitRet() before each
    // return instruction. The fall-through case below handles functions
    // that don't end with an explicit return.

    // Emit default return if needed (only if the body didn't already
    // terminate with a return/break/continue instruction).
    if !cg.terminated {
        if !str.Equal(retType, "void") {
            emitAllDeallocations(cg)
            emitRet(cg, retType, zeroValueForLLType(retType))
        } else {
            emitAllDeallocations(cg)
            emitRet(cg, "void", "")
        }
    }

    // Emit the error-propagation return label if this function returns an error.
    // The `?` operator branches here with the aggregate return value stored in
    // fnReturnAlloca. This block loads the aggregate and returns it.
    if str.Len(cg.fnReturnLabel) > 0 && str.Len(cg.fnReturnAlloca) > 0 {
        cg.terminated = false
        emitLabel(cg, cg.fnReturnLabel)
        // Pop the panic handler before running deferred statements
        // (same ordering as emitRet).
        if cg.needPanicLanding {
            emitln(cg, "  call void @Skink_panic_pop_handler()")
        }
        // Drain the defer stack before the propagated return.
        emitDeferDrain(cg)
        emitAllDeallocations(cg)
        // Release owned parameters (scope 0); deferred statements already ran.
        emitDeallocationsForScope(cg, 0)
        retReg := nextReg(cg)
        emitfmt(cg, "  %s = load %s, %s* %s\n", []string{retReg, retType, retType, cg.fnReturnAlloca})
        emitfmt(cg, "  ret %s %s\n", []string{retType, retReg})
    }

    // Emit the panic landing pad after all normal return paths.
    if cg.needPanicLanding {
        emitPanicEpilogue(cg, retType)
    }

    // All exits have already emitted their scope releases; reset the
    // compile-time scope stack so code emitted outside functions
    // (global initializers, ruleset eval functions) doesn't see stale
    // scopes, and stop tracking expression temporaries.
    cg.fnBodyActive = false
    cg.scopeDepth = 0

    // Read body text from cg.out (which is the body buffer) BEFORE restoring.
    // Builder is a value struct, so cg.out may have been reallocated during
    // body emission; reading from cg.out ensures we get the current buffer.
    bodyText := str.BuilderValue(cg.out)
    bodyLen := str.LenBuilder(cg.out)

    // Restore main output
    cg.out = savedOut

    // Write alloca buffer first (entry block), then body
    allocaText := str.BuilderValue(cg.allocaBuffer)
    allocaLen := str.LenBuilder(cg.allocaBuffer)
    if allocaLen > 0 {
        cg.out.Write(allocaText)
        cg.out.WriteByte(10)
    }
    if bodyLen > 0 {
        cg.out.Write(bodyText)
        cg.out.WriteByte(10)
    }

    emitln(cg, "}")

    // Restore state
    cg.currentFnRetTypes = savedRetTypes
    cg.currentFnRetNames = savedRetNames
    cg.regCounter = savedRegCounter
    cg.labelCounter = savedLabelCounter
    cg.deferred = savedDeferred
    cg.hasDefer = savedHasDefer
    cg.needPanicLanding = savedNeedPanicLanding
    cg.currentModule = savedCurrentModule
    cg.checker.currentModule = savedCheckerMod
    cg.allocaBuffer = savedAllocaBuffer
    cg.loopLabelDepth = savedLoopLabelDepth
    cg.fnReturnLabel = savedFnReturnLabel
    cg.fnReturnAlloca = savedFnReturnAlloca
    cg.escapedVars = savedEscapedVars
    cg.capturedVars = savedCapturedVars
    cg.deferQueueAlloca = savedDeferQueueAlloca
    cg.dbgCurrentSubprogram = ""
    cg.dbgCurrentFile = ""
    cg.dbgCurrentLoc = ""
    cg.dbgDefaultLoc = ""
}

// emitStructDecl handles struct declarations (emits type definition).
fn emitStructDecl(cg: *CodeGen, d: ast.Decl) {
    name := d.structName
    layout := computeStructLayout(cg, name, d)
    cg.structLayouts[name] = layout
    // Also update short name and sanitized name entries
    idx := str.LastIndexOf(name, ".")
    if idx >= 0 {
        shortName := str.Substr(name, idx + 1, str.Len(name) - idx - 1)
        cg.structLayouts[shortName] = layout
    }
    sanitizedName := sanitizeName(name)
    cg.structLayouts[sanitizedName] = layout
    // Emit the struct type definition
    fieldTypes := []string{}
    i := 0
    for i < len(layout.fieldTypes) {
        fieldTypes = append(fieldTypes, layout.fieldTypes[i])
        i = i + 1
    }
    parts := []string{}
    parts = append(parts, layout.llType)
    parts = append(parts, " = type { ")
    parts = append(parts, str.Join(fieldTypes, ", "))
    parts = append(parts, " }")
    emitHeader(cg, concatMany(parts))
    emitHeader(cg, "\n")
}

// emitGlobalConst handles global constant declarations.
fn emitGlobalConst(cg: *CodeGen, d: ast.Decl) {
    // Store const value(s) for inlining
    if len(d.constValue) > 0 {
        cg.consts[d.constName] = d.constValue[0]
        cg.constFiles[d.constName] = cg.currentFilePath
    }
    i := 0
    for i < len(d.constBlock) {
        item := d.constBlock[i]
        if len(item.value) > 0 {
            cg.consts[item.name] = item.value[0]
            cg.constFiles[item.name] = cg.currentFilePath
        }
        i = i + 1
    }
}

// externFnName extracts the short name from a qualified extern function.
fn externFnName(name: string) -> string {
    idx := str.LastIndexOf(name, ".")
    if idx >= 0 {
        return str.Substr(name, idx + 1, str.Len(name) - idx - 1)
    }
    return name
}

// isRuntimeExtern reports whether a function is a runtime-provided extern.
fn isRuntimeExtern(name: string) -> bool {
    return name == "printf" || name == "sprintf" || name == "puts" ||
        name == "strlen" || name == "strcpy" || name == "strcat" ||
        name == "strcmp" || name == "malloc" || name == "free" ||
        name == "exit" || name == "Skink_rc_alloc" || name == "Skink_rc_alloc_typed" ||
        name == "Skink_rc_retain" || name == "Skink_rc_release" ||
        name == "Skink_panic" || name == "Skink_chan_make" || name == "Skink_chan_close" ||
        name == "Skink_chan_send" || name == "Skink_chan_recv" ||
        name == "Skink_chan_select" ||
        name == "Skink_spawn" || name == "Skink_free" ||
        name == "Skink_future_make" || name == "Skink_future_set" ||
        name == "Skink_future_get"
}

// emitExternFnDecl handles extern function declarations.
fn emitExternFnDecl(cg: *CodeGen, d: ast.Decl) {
    fnName := externFnName(d.fnName)
    // Skip runtime functions that we define ourselves in emitRuntimeMain
    if str.Equal(fnName, "_skink_runtime_get_argc") ||
       str.Equal(fnName, "_skink_runtime_get_argv") ||
       str.Equal(fnName, "_skink_runtime_set_argc") ||
       str.Equal(fnName, "_skink_runtime_set_argv") {
        return
    }
    retType := "i32"
    if len(d.fnRetTypes) > 1 {
        allRets := []string{}
        i := 0
        for i < len(d.fnRetTypes) {
            t := checker.astTypeToType(cg.checker, d.fnRetTypes[i])
            allRets = append(allRets, llvmType(cg, t))
            i = i + 1
        }
        retType = aggregateRetType(allRets)
    } else if len(d.fnRetTypes) > 0 {
        t := checker.astTypeToType(cg.checker, d.fnRetTypes[0])
        retType = llvmType(cg, t)
    }
    paramStrs := []string{}
    i := 0
    for i < len(d.fnParams) {
        paramType := "i32"
        if len(d.fnParams[i].typ) > 0 {
            t := checker.astTypeToType(cg.checker, d.fnParams[i].typ[0])
            paramType = llvmType(cg, t)
        }
        paramStrs = append(paramStrs, paramType)
        i = i + 1
    }
    if !isRuntimeExtern(fnName) {
        if !mapStringBoolHasKeyCG(cg.declaredExterns, fnName) {
            cg.declaredExterns[fnName] = true
            parts := []string{}
            parts = append(parts, "declare ")
            parts = append(parts, retType)
            parts = append(parts, " @")
            parts = append(parts, fnName)
            parts = append(parts, "(")
            parts = append(parts, str.Join(paramStrs, ", "))
            parts = append(parts, ")")
            emitHeader(cg, concatMany(parts))
            emitHeader(cg, "\n")
        }
    }
    // Register function (store individual return types for multi-return)
    cg.externFns[fnName] = true
    cg.fnRetTypes[fnName] = []string{}
    if len(d.fnRetTypes) > 1 {
        i := 0
        for i < len(d.fnRetTypes) {
            t := checker.astTypeToType(cg.checker, d.fnRetTypes[i])
            cg.fnRetTypes[fnName] = append(cg.fnRetTypes[fnName], llvmType(cg, t))
            i = i + 1
        }
    } else {
        cg.fnRetTypes[fnName] = append(cg.fnRetTypes[fnName], retType)
    }
}

// === Program Emission ===

// emitDebugMetadata emits the DICompileUnit, module flags, and all metadata
// definitions at the end of the module.
fn emitDebugMetadata(cg: *CodeGen) {
    // Collect all DIFile IDs in creation order
    // Collect all DIFile IDs in creation order
    fileIds := []string{}
    i := 0
    for i < len(cg.dbgFilePaths) {
        fid := cg.dbgFiles[cg.dbgFilePaths[i]]
        fileIds = append(fileIds, fid)
        i = i + 1
    }
    primaryFile := ""
    if len(fileIds) > 0 {
        primaryFile = fileIds[0]
    } else {
        primaryFile = nextDbgMeta(cg)
        setDbgMeta(cg, primaryFile, str.Concat(primaryFile, " = !DIFile(filename: \"skink_program\", directory: \"\")"))
    }
    // Define the DICompileUnit
    cuDef := str.Concat(str.Concat(str.Concat(
        cg.dbgCompileUnit, " = distinct !DICompileUnit(language: DW_LANG_C99, file: "),
        primaryFile), ", producer: \"skink compiler\", isOptimized: false, emissionKind: FullDebug)")
    setDbgMeta(cg, cg.dbgCompileUnit, cuDef)
    // Module flags
    // Build quote string using builder to avoid !\" sequence in source
    qb := str.NewBuilder(1)
    str.WriteByte(&qb, 34)
    q := str.String(qb)
    dbgVerId := nextDbgMeta(cg)
    dbgVerDef := str.Concat(dbgVerId, " = !{i32 2, !")
    dbgVerDef = str.Concat(dbgVerDef, q)
    dbgVerDef = str.Concat(dbgVerDef, "Debug Info Version")
    dbgVerDef = str.Concat(dbgVerDef, q)
    dbgVerDef = str.Concat(dbgVerDef, ", i32 3}")
    setDbgMeta(cg, dbgVerId, dbgVerDef)
    dwarfVerId := nextDbgMeta(cg)
    dwarfVerDef := str.Concat(dwarfVerId, " = !{i32 7, !")
    dwarfVerDef = str.Concat(dwarfVerDef, q)
    dwarfVerDef = str.Concat(dwarfVerDef, "Dwarf Version")
    dwarfVerDef = str.Concat(dwarfVerDef, q)
    dwarfVerDef = str.Concat(dwarfVerDef, ", i32 5}")
    setDbgMeta(cg, dwarfVerId, dwarfVerDef)
    identId := nextDbgMeta(cg)
    identDef := str.Concat(identId, " = !{!")
    identDef = str.Concat(identDef, q)
    identDef = str.Concat(identDef, "skink compiler")
    identDef = str.Concat(identDef, q)
    identDef = str.Concat(identDef, "}")
    setDbgMeta(cg, identId, identDef)
    // Named metadata references
    emitMetadata(cg, str.Concat("!llvm.dbg.cu = !{", str.Concat(cg.dbgCompileUnit, "}\n")))
    emitMetadata(cg, str.Concat("!llvm.module.flags = !{", str.Concat(dbgVerId, str.Concat(", ", str.Concat(dwarfVerId, "}\n")))))
    emitMetadata(cg, str.Concat("!llvm.ident = !{", str.Concat(identId, "}\n")))
    // Emit all metadata definitions
    i = 0
    for i < len(cg.dbgMetadata) {
        if str.Len(cg.dbgMetadata[i]) > 0 {
            emitMetadata(cg, cg.dbgMetadata[i])
            emitMetadata(cg, "\n")
        }
        i = i + 1
    }
}

// emitProgram emits the full LLVM IR for a program.
pub fn emitProgram(cg: *CodeGen, decls: []ast.Stmt) -> string {
    // Emit module header
    emitHeader(cg, "; ModuleID = 'skink_program'\n")
    emitHeader(cg, "source_filename = \"skink_program\"\n\n")

    // Reserve !0 for DICompileUnit (defined at end after all files are known)
    if cg.dbgEnabled {
        cg.dbgCompileUnit = nextDbgMeta(cg)
    }

    // Emit runtime declarations
    emitRuntimeDecls(cg)

    // Pre-scan: does module main declare `fn main`? If not, a lone
    // library `fn main` may still serve as the program entry point
    // (comp_error.md #116 — avoids the duplicate @_skink_main while
    // preserving standalone compilation of non-main modules).
    cg.hasModuleMainEntry = false
    cg.entryMainEmitted = false
    i := 0
    for i < len(decls) {
        d := decls[i].decl
        if d.kind == ast.ST_FN && str.Equal(d.fnName, "main.main") {
            cg.hasModuleMainEntry = true
        }
        if d.kind == ast.ST_FN && str.Equal(d.fnName, "main") && (str.Len(d.moduleName) == 0 || str.Equal(d.moduleName, "main")) {
            cg.hasModuleMainEntry = true
        }
        i = i + 1
    }

    // Pre-pass: register structs, functions, and consts
    i = 0
    for i < len(decls) {
        d := decls[i].decl
        // Register import aliases (e.g. "tsr" -> "tensor")
        if d.kind == ast.ST_IMPORT {
            if str.Len(d.importAlias) > 0 {
                realName := d.importPath
                lastSlash := str.LastIndexOf(realName, "/")
                if lastSlash >= 0 {
                    realName = str.Substr(realName, lastSlash + 1, str.Len(realName) - lastSlash - 1)
                }
                realName = str.Replace(realName, ".skink", "")
                atIdx := str.IndexOf(realName, "@")
                if atIdx >= 0 {
                    realName = str.Substr(realName, 0, atIdx)
                }
                realName = str.Replace(realName, "-", "_")
                cg.importAliases[d.importAlias] = realName
            }
        }
        if d.kind == ast.ST_EXTERN || (d.kind == ast.ST_FN && d.fnIsExtern) {
            fnName := externFnName(d.fnName)
            cg.externFns[fnName] = true
            cg.fnRetTypes[fnName] = []string{}
            if len(d.fnRetTypes) > 1 {
                j := 0
                for j < len(d.fnRetTypes) {
                    t := checker.astTypeToType(cg.checker, d.fnRetTypes[j])
                    cg.fnRetTypes[fnName] = append(cg.fnRetTypes[fnName], llvmType(cg, t))
                    j = j + 1
                }
            } else if len(d.fnRetTypes) > 0 {
                t := checker.astTypeToType(cg.checker, d.fnRetTypes[0])
                cg.fnRetTypes[fnName] = append(cg.fnRetTypes[fnName], llvmType(cg, t))
            } else {
                cg.fnRetTypes[fnName] = append(cg.fnRetTypes[fnName], "i32")
            }
            cg.fnParamTypes[fnName] = []string{}
            j := 0
            for j < len(d.fnParams) {
                if len(d.fnParams[j].typ) > 0 {
                    t := checker.astTypeToType(cg.checker, d.fnParams[j].typ[0])
                    cg.fnParamTypes[fnName] = append(cg.fnParamTypes[fnName], llvmType(cg, t))
                } else {
                    cg.fnParamTypes[fnName] = append(cg.fnParamTypes[fnName], "i32")
                }
                j = j + 1
            }
        }
        if d.kind == ast.ST_STRUCT {
            cg.structLayouts[d.structName] = computeStructLayout(cg, d.structName, d)
            cg.structDecls[d.structName] = d
            markBorrowed(cg, "d")
            idx := str.LastIndexOf(d.structName, ".")
            if idx >= 0 {
                shortName := str.Substr(d.structName, idx + 1, str.Len(d.structName) - idx - 1)
                cg.structLayouts[shortName] = cg.structLayouts[d.structName]
                cg.structDecls[shortName] = d
            }
            sanitizedName := sanitizeName(d.structName)
            cg.structLayouts[sanitizedName] = cg.structLayouts[d.structName]
            cg.structDecls[sanitizedName] = d
            // Register struct methods as StructName.methodName
            // Set checker module context for type resolution
            savedMod := cg.checker.currentModule
            markBorrowed(cg, "savedMod")
            structDotIdx := str.IndexOf(d.structName, ".")
            if structDotIdx > 0 {
                cg.checker.currentModule = str.Substr(d.structName, 0, structDotIdx)
            }
            j := 0
            for j < len(d.structMethods) {
                m := d.structMethods[j]
                qualifiedName := str.Concat(d.structName, str.Concat(".", m.fnName))
                cg.fnRetTypes[qualifiedName] = []string{}
                if len(m.fnRetTypes) > 1 {
                    k := 0
                    for k < len(m.fnRetTypes) {
                        mt := checker.astTypeToType(cg.checker, m.fnRetTypes[k])
                        cg.fnRetTypes[qualifiedName] = append(cg.fnRetTypes[qualifiedName], llvmType(cg, mt))
                        k = k + 1
                    }
                } else if len(m.fnRetTypes) > 0 {
                    mt := checker.astTypeToType(cg.checker, m.fnRetTypes[0])
                    cg.fnRetTypes[qualifiedName] = append(cg.fnRetTypes[qualifiedName], llvmType(cg, mt))
                } else {
                    cg.fnRetTypes[qualifiedName] = append(cg.fnRetTypes[qualifiedName], "void")
                }
                cg.fnParamTypes[qualifiedName] = []string{}
                k := 0
                for k < len(m.fnParams) {
                    if len(m.fnParams[k].typ) > 0 {
                        mt2 := checker.astTypeToType(cg.checker, m.fnParams[k].typ[0])
                        cg.fnParamTypes[qualifiedName] = append(cg.fnParamTypes[qualifiedName], paramLLType(llvmType(cg, mt2)))
                    } else {
                        cg.fnParamTypes[qualifiedName] = append(cg.fnParamTypes[qualifiedName], "i32")
                    }
                    k = k + 1
                }
                j = j + 1
            }
            cg.checker.currentModule = savedMod
        }
        if d.kind == ast.ST_SERVICE && str.Len(d.serviceForType) > 0 {
            // Register service implementation methods as forType.methodName
            // in fnRetTypes/fnParamTypes so call sites can resolve them.
            savedMod := cg.checker.currentModule
            markBorrowed(cg, "savedMod")
            // Use the decl's own module, not ambient context — in
            // multi-module programs (e.g. test harnesses) currentModule is
            // wrong here, leaving forType unqualified (comp_error.md #117).
            if str.Len(d.moduleName) > 0 {
                cg.checker.currentModule = d.moduleName
            }
            forType := d.serviceForType
            // Module-qualify the forType if needed (matching checker logic).
            if str.Len(cg.checker.currentModule) > 0 && !str.Equal(cg.checker.currentModule, "main") && !str.Contains(forType, ".") {
                qualified := str.Concat(str.Concat(cg.checker.currentModule, "."), forType)
                if str.Len(cg.structLayouts[qualified].llType) > 0 {
                    forType = qualified
                }
            }
            j := 0
            for j < len(d.serviceMethods) {
                m := d.serviceMethods[j]
                qualifiedName := str.Concat(forType, str.Concat(".", m.fnName))
                cg.fnRetTypes[qualifiedName] = []string{}
                if len(m.fnRetTypes) > 1 {
                    k := 0
                    for k < len(m.fnRetTypes) {
                        mt := checker.astTypeToType(cg.checker, m.fnRetTypes[k])
                        cg.fnRetTypes[qualifiedName] = append(cg.fnRetTypes[qualifiedName], llvmType(cg, mt))
                        k = k + 1
                    }
                } else if len(m.fnRetTypes) > 0 {
                    mt := checker.astTypeToType(cg.checker, m.fnRetTypes[0])
                    cg.fnRetTypes[qualifiedName] = append(cg.fnRetTypes[qualifiedName], llvmType(cg, mt))
                } else {
                    cg.fnRetTypes[qualifiedName] = append(cg.fnRetTypes[qualifiedName], "void")
                }
                cg.fnParamTypes[qualifiedName] = []string{}
                k := 0
                for k < len(m.fnParams) {
                    if len(m.fnParams[k].typ) > 0 {
                        mt2 := checker.astTypeToType(cg.checker, m.fnParams[k].typ[0])
                        cg.fnParamTypes[qualifiedName] = append(cg.fnParamTypes[qualifiedName], paramLLType(llvmType(cg, mt2)))
                    } else {
                        cg.fnParamTypes[qualifiedName] = append(cg.fnParamTypes[qualifiedName], "i32")
                    }
                    k = k + 1
                }
                j = j + 1
            }
            cg.checker.currentModule = savedMod
        }
        if d.kind == ast.ST_RULESET {
            // and registerRule as RulesetName.methodName in fnRetTypes/fnParamTypes.
            implicitMethods := []string{"start", "stop", "restart", "reset"}
            // Determine short name (without module prefix) for lookup
            shortName := d.rulesetName
            dotIdx := str.LastIndexOf(d.rulesetName, ".")
            if dotIdx >= 0 {
                shortName = str.Substr(d.rulesetName, dotIdx + 1, str.Len(d.rulesetName) - dotIdx - 1)
            }
            j := 0
            for j < len(implicitMethods) {
                qn := str.Concat(d.rulesetName, str.Concat(".", implicitMethods[j]))
                cg.fnRetTypes[qn] = []string{}
                cg.fnRetTypes[qn] = append(cg.fnRetTypes[qn], "void")
                cg.fnParamTypes[qn] = []string{}
                // Also register short name
                shortQn := str.Concat(shortName, str.Concat(".", implicitMethods[j]))
                cg.fnRetTypes[shortQn] = []string{}
                cg.fnRetTypes[shortQn] = append(cg.fnRetTypes[shortQn], "void")
                cg.fnParamTypes[shortQn] = []string{}
                j = j + 1
            }
            // registerRule takes a pointer (i8*) as parameter.
            // The emitter generates wrapper functions internally.
            regQn := str.Concat(d.rulesetName, str.Concat(".", "registerRule"))
            cg.fnRetTypes[regQn] = []string{}
            cg.fnRetTypes[regQn] = append(cg.fnRetTypes[regQn], "void")
            cg.fnParamTypes[regQn] = []string{}
            cg.fnParamTypes[regQn] = append(cg.fnParamTypes[regQn], "i8*")
            // Also register short name
            shortRegQn := str.Concat(shortName, str.Concat(".", "registerRule"))
            cg.fnRetTypes[shortRegQn] = []string{}
            cg.fnRetTypes[shortRegQn] = append(cg.fnRetTypes[shortRegQn], "void")
            cg.fnParamTypes[shortRegQn] = []string{}
            cg.fnParamTypes[shortRegQn] = append(cg.fnParamTypes[shortRegQn], "i8*")
            cg.rulesets[d.rulesetName] = true
        }
        if d.kind == ast.ST_FN {
            // Set checker module context for type resolution
            savedMod := cg.checker.currentModule
            markBorrowed(cg, "savedMod")
            fnDotIdx := str.IndexOf(d.fnName, ".")
            if fnDotIdx > 0 {
                cg.checker.currentModule = str.Substr(d.fnName, 0, fnDotIdx)
            }
            // Register function return types (support multi-return)
            cg.fnRetTypes[d.fnName] = []string{}
            if len(d.fnRetTypes) > 1 {
                j := 0
                for j < len(d.fnRetTypes) {
                    t := checker.astTypeToType(cg.checker, d.fnRetTypes[j])
                    cg.fnRetTypes[d.fnName] = append(cg.fnRetTypes[d.fnName], llvmType(cg, t))
                    j = j + 1
                }
            } else if len(d.fnRetTypes) > 0 {
                t := checker.astTypeToType(cg.checker, d.fnRetTypes[0])
                cg.fnRetTypes[d.fnName] = append(cg.fnRetTypes[d.fnName], llvmType(cg, t))
            } else {
                cg.fnRetTypes[d.fnName] = append(cg.fnRetTypes[d.fnName], "void")
            }
            // Register param types
            cg.fnParamTypes[d.fnName] = []string{}
            j := 0
            for j < len(d.fnParams) {
                if len(d.fnParams[j].typ) > 0 {
                    t := checker.astTypeToType(cg.checker, d.fnParams[j].typ[0])
                    cg.fnParamTypes[d.fnName] = append(cg.fnParamTypes[d.fnName], paramLLType(llvmType(cg, t)))
                } else {
                    cg.fnParamTypes[d.fnName] = append(cg.fnParamTypes[d.fnName], "i32")
                }
                j = j + 1
            }
            cg.checker.currentModule = savedMod
        }
        if d.kind == ast.ST_CONST {
            if len(d.constValue) > 0 {
                cg.consts[d.constName] = d.constValue[0]
                cg.constFiles[d.constName] = decls[i].filePath
            }
            j := 0
            for j < len(d.constBlock) {
                item := d.constBlock[j]
                if len(item.value) > 0 {
                    cg.consts[item.name] = item.value[0]
                    cg.constFiles[item.name] = decls[i].filePath
                }
                j = j + 1
            }
        }
        // Register simple enum variants as int constants so they get
        // inlined as i32 literals. Tagged unions (variants with payloads)
        // are handled elsewhere.
        if d.kind == ast.ST_ENUM {
            isTaggedUnion := false
            j := 0
            for j < len(d.enumVariants) {
                if len(d.enumVariants[j].payloads) > 0 {
                    isTaggedUnion = true
                    break
                }
                j = j + 1
            }
            if len(d.enumGenerics) > 0 {
                isTaggedUnion = true
            }
            if !isTaggedUnion {
                j := 0
                for j < len(d.enumVariants) {
                    vname := d.enumVariants[j].name
                    lit := ast.newExpr(ast.EX_INT, 0, 0)
                    lit.intVal = j
                    cg.consts[vname] = lit
                    j = j + 1
                }
            } else {
                // Tagged union: register the decl and every variant, and
                // emit the `{ i32 tag, [N x i8] payload }` LLVM type.
                cg.taggedUnions[d.enumName] = d
                emitTUTypeDecl(cg, d)
                j := 0
                for j < len(d.enumVariants) {
                    vname := d.enumVariants[j].name
                    cg.tuVariantDecl[vname] = d
                    cg.tuVariantIdx[vname] = j
                    j = j + 1
                }
            }
        }
        // Register global variables (ST_VARDECL stores data on Stmt, not Decl)
        if decls[i].kind == ast.ST_VARDECL {
            stmt := decls[i]
            // Set module context from the qualified var name so the
            // initializer resolves same-module symbols (e.g. private
            // consts) the way the checker did.
            savedCgMod := cg.currentModule
            savedCheckerMod := cg.checker.currentModule
            savedFile := cg.currentFilePath
            setModuleContextFromName(cg, stmt.varName)
            cg.currentFilePath = stmt.filePath
            varLLType := "i32"
            if len(stmt.varType) > 0 {
                t := checker.astTypeToType(cg.checker, stmt.varType[0])
                varLLType = llvmType(cg, t)
            } else if len(stmt.varValue) > 0 {
                vt := exprLLType(cg, stmt.varValue[0])
                if str.Len(vt) > 0 {
                    varLLType = vt
                }
            }
            cg.globalVarTypes[stmt.varName] = varLLType
            cg.currentModule = savedCgMod
            cg.checker.currentModule = savedCheckerMod
            cg.currentFilePath = savedFile
        }
        i = i + 1
    }

    // Emit template type definitions (before structs, since structs may
    // contain template-typed fields)
    emitTemplateTypes(cg)

    // Emit struct type definitions
    i = 0
    for i < len(decls) {
        d := decls[i].decl
        if d.kind == ast.ST_STRUCT {
            emitStructDecl(cg, d)
        }
        i = i + 1
    }

    // Emit all declarations
    i = 0
    for i < len(decls) {
        d := decls[i].decl
        if d.kind == ast.ST_FN && !d.fnIsExtern {
            cg.currentFilePath = decls[i].filePath
            cg.currentStmtLine = decls[i].line
            cg.currentStmtCol = decls[i].col
            emitFnDecl(cg, d)
        }
        if d.kind == ast.ST_RULESET {
            // Emit ruleset implementation using the C runtime.
            emitRulesetCode(cg, d)
        }
        if d.kind == ast.ST_STRUCT {
            // Emit each struct method with qualified name
            j := 0
            for j < len(d.structMethods) {
                m := d.structMethods[j]
                origName := m.fnName
                m.fnName = str.Concat(d.structName, str.Concat(".", m.fnName))
                cg.currentFilePath = decls[i].filePath
                cg.currentStmtLine = decls[i].line
                cg.currentStmtCol = decls[i].col
                emitFnDecl(cg, m)
                m.fnName = origName
                j = j + 1
            }
            layout := cg.structLayouts[d.structName]
            emitStructDtorTrampoline(cg, d.structName, layout)
        }
        if d.kind == ast.ST_SERVICE && str.Len(d.serviceForType) > 0 {
            // Emit service implementation methods as forType.methodName
            // functions, using the decl's own module for forType
            // qualification (comp_error.md #117).
            savedMod := cg.checker.currentModule
            markBorrowed(cg, "savedMod")
            if str.Len(d.moduleName) > 0 {
                cg.checker.currentModule = d.moduleName
            }
            forType := d.serviceForType
            if str.Len(cg.checker.currentModule) > 0 && !str.Equal(cg.checker.currentModule, "main") && !str.Contains(forType, ".") {
                qualified := str.Concat(str.Concat(cg.checker.currentModule, "."), forType)
                if str.Len(cg.structLayouts[qualified].llType) > 0 {
                    forType = qualified
                }
            }
            j := 0
            for j < len(d.serviceMethods) {
                m := d.serviceMethods[j]
                origName := m.fnName
                m.fnName = str.Concat(forType, str.Concat(".", m.fnName))
                cg.currentFilePath = decls[i].filePath
                cg.currentStmtLine = decls[i].line
                cg.currentStmtCol = decls[i].col
                emitFnDecl(cg, m)
                m.fnName = origName
                j = j + 1
            }
            cg.checker.currentModule = savedMod
        }
        if d.kind == ast.ST_CONST {
            emitGlobalConst(cg, d)
        }
        if d.kind == ast.ST_EXTERN || (d.kind == ast.ST_FN && d.fnIsExtern) {
            emitExternFnDecl(cg, d)
        }
        if decls[i].kind == ast.ST_EMBED {
            // Collect the embed spec now; the data blobs and the
            // @_skink_embed_init registration function are emitted in
            // emitRuntimeMain once every decl is collected.
            srcDir := dirNameCG(decls[i].filePath)
            spec := embedSpec{srcRoot: joinPathCG(srcDir, d.embedPath), virtRoot: cleanEmbedRoot(d.embedPath)}
            cg.embeds = append(cg.embeds, spec)
        }
        // Emit global variables (ST_VARDECL stores data on Stmt, not Decl)
        if decls[i].kind == ast.ST_VARDECL {
            stmt := decls[i]
            // Set module context from the qualified var name so the
            // initializer resolves same-module symbols (e.g. private
            // consts) the way the checker did.
            savedCgMod := cg.currentModule
            savedCheckerMod := cg.checker.currentModule
            savedFile := cg.currentFilePath
            setModuleContextFromName(cg, stmt.varName)
            cg.currentFilePath = stmt.filePath
            varLLType := cg.globalVarTypes[stmt.varName]
            hasGvt := mapStringStringHasKeyCG(cg.globalVarTypes, stmt.varName)
            if !hasGvt {
                // Determine the LLVM type from the AST type annotation or initializer
                varLLType = "i32"
                if len(stmt.varType) > 0 {
                    t := checker.astTypeToType(cg.checker, stmt.varType[0])
                    if t.kind != checker.TK_UNKNOWN {
                        varLLType = llvmType(cg, t)
                    }
                } else if len(stmt.varValue) > 0 {
                    vt := exprLLType(cg, stmt.varValue[0])
                    if str.Len(vt) > 0 {
                        varLLType = vt
                    }
                }
                cg.globalVarTypes[stmt.varName] = varLLType
            }
            // Named composite types must have their LLVM struct decl emitted
            // before the global references them (comp_error.md #113).
            if str.StartsWith(varLLType, "%map_") && str.EndsWith(varLLType, "*") && !str.EndsWith(varLLType, "**") {
                mk, mv, mok := parseMapTypeLL(varLLType)
                if mok {
                    mapName := str.Substr(varLLType, 1, str.Len(varLLType) - 2)
                    emitMapTypeDecl(cg, mapName, mk, mv)
                }
            } else if str.StartsWith(varLLType, "%set.") && str.EndsWith(varLLType, "*") && !str.EndsWith(varLLType, "**") {
                setSan := str.Substr(varLLType, str.Len("%set."), str.Len(varLLType) - str.Len("%set.") - 1)
                emitSetTypeDecl(cg, str.Concat("set.", setSan), desanitizeLLTypeName(setSan))
            }
            emitHeader(cg, str.Concat(str.Concat(str.Concat("@", stmt.varName), str.Concat(" = global ", varLLType)), str.Concat(" ", zeroValueForLLType(varLLType))))
            emitHeader(cg, "\n")
            // Collect vars with initializers for the global init function.
            // Map globals without initializers are also included so they
            // get an empty map instead of null (comp_error.md #113 —
            // assignment into a nil map panics). Null is already the
            // canonical empty set (set{} emits null), so sets stay null.
            if len(stmt.varValue) > 0 {
                cg.globalInits = append(cg.globalInits, stmt)
            } else if str.StartsWith(varLLType, "%map_") && !str.EndsWith(varLLType, "**") {
                cg.globalInits = append(cg.globalInits, stmt)
            }
            cg.currentModule = savedCgMod
            cg.checker.currentModule = savedCheckerMod
            cg.currentFilePath = savedFile
        }
        i = i + 1
    }

    // Emit runtime infrastructure (argc/argv globals, helper functions,
    // and C entry point main that calls _skink_main)
    emitRuntimeMain(cg, decls)

    // Emit debug metadata at the end of the module
    if cg.dbgEnabled {
        emitDebugMetadata(cg)
    }

    return String(cg)
}

// emitRulesetCode generates LLVM IR for a ruleset using the C runtime.
// It creates a global SkinkRuleset* variable, per-rule eval functions,
// and start/stop/reset/registerRule methods.
fn emitRulesetCode(cg: *CodeGen, d: ast.Decl) {
    rsName := d.rulesetName
    shortName := rsName
    dotIdx := str.LastIndexOf(rsName, ".")
    if dotIdx >= 0 {
        shortName = str.Substr(rsName, dotIdx + 1, str.Len(rsName) - dotIdx - 1)
    }

    // Set the current module to the ruleset's module so that expression
    // emission can resolve module-qualified global variables.
    rsModule := rsName
    if dotIdx >= 0 {
        rsModule = str.Substr(rsName, 0, dotIdx)
    }
    savedModule := cg.currentModule
    cg.currentModule = rsModule
    cg.checker.currentModule = rsModule

    // Emit extern declarations for the ruleset runtime once per program —
    // a module with multiple rulesets would otherwise emit duplicate
    // `declare` lines (invalid LLVM redefinition).
    if !mapStringBoolHasKeyCG(cg.rulesetWrappers, "__decls") {
        cg.rulesetWrappers["__decls"] = true
        emitHeader(cg, "declare i8* @Skink_ruleset_create()\n")
        emitHeader(cg, "declare void @Skink_ruleset_add_rule(i8*, i8*, void(i8*)*, void(i8*)*, void(i8*)*, i32)\n")
        emitHeader(cg, "declare void @Skink_ruleset_start(i8*)\n")
        emitHeader(cg, "declare void @Skink_ruleset_stop(i8*)\n")
        emitHeader(cg, "declare void @Skink_ruleset_reset(i8*)\n")
    }

    // Global variable to hold the SkinkRuleset* pointer
    globalVarName := str.Concat("@", str.Concat(sanitizeName(rsName), "_rs_ptr"))
    emitHeader(cg, str.Concat(globalVarName, " = global i8* null\n"))

    // Generate eval function for each rule
    ruleEvalFns := []string{}
    j := 0
    for j < len(d.rulesetRules) {
        rd := d.rulesetRules[j]
        evalFnName := str.Concat(str.Concat(str.Concat("@", sanitizeName(rsName)), "_rule_"), strconv.Itoa(j))
        ruleEvalFns = append(ruleEvalFns, evalFnName)

        // The eval function takes i8* (self, unused for static rules) and returns void.
        // It checks the condition and if true, runs the action.
        emitln(cg, str.Concat(str.Concat("define void ", evalFnName), "(i8* %self) {"))
        // Buffer the body so body-generated allocas (e.g. the append loop
        // counter) land in the entry block, dominating all uses
        // (comp_error.md #118 — previously the alloca was never emitted).
        savedOut := cg.out
        savedAllocaBuf := cg.allocaBuffer
        cg.out = str.NewBuilder(2048)
        cg.allocaBuffer = str.NewBuilder(1024)
        // Evaluate condition
        var endLabel string
        if len(rd.condition) > 0 {
            condReg := emitExpression(cg, rd.condition[0])
            condLL := exprLLType(cg, rd.condition[0])
            // Convert to i1 if needed
            if str.Equal(condLL, "i32") {
                cmpReg := nextReg(cg)
                emitfmt(cg, "  %s = icmp ne i32 %s, 0\n", []string{cmpReg, condReg})
                condReg = cmpReg
            }
            trueLabel := nextLabel(cg)
            endLabel = nextLabel(cg)
            emitCondBranch(cg, condReg, trueLabel, endLabel)
            // emitLabel (not a raw emitln) resets cg.terminated — a stuck
            // flag made emitBlockStmtRaw skip the action body and left
            // lifted action literals as empty function bodies
            // (comp_error.md #123).
            emitLabel(cg, trueLabel)
        }
        // Emit action body. `action: { ... }` parses to bare statements
        // run inline; `action: fn() { ... }` parses to an expr statement
        // holding a function literal — evaluating it only yields the
        // closure handle, so it must be invoked explicitly
        // (comp_error.md #123).
        k := 0
        for k < len(rd.ruleAction) {
            act := rd.ruleAction[k]
            if act.kind == ast.ST_EXPR && len(act.expr) > 0 && act.expr[0].kind == ast.EX_FN_LIT {
                handleReg := emitExpression(cg, act.expr[0])
                emitClosureCall(cg, "void", []string{}, handleReg, []string{})
            } else {
                emitStatement(cg, act)
            }
            k = k + 1
        }
        if len(rd.condition) > 0 {
            if !cg.terminated {
                emitBranch(cg, endLabel)
            }
            emitLabel(cg, endLabel)
        }
        emitln(cg, "  ret void")
        // Splice: entry label, then buffered allocas, then the body.
        ruleBodyText := str.BuilderValue(cg.out)
        ruleAllocaText := str.BuilderValue(cg.allocaBuffer)
        cg.out = savedOut
        cg.allocaBuffer = savedAllocaBuf
        emitln(cg, "entry:")
        if str.Len(ruleAllocaText) > 0 {
            cg.out.Write(ruleAllocaText)
            cg.out.WriteByte(10)
        }
        cg.out.Write(ruleBodyText)
        emitln(cg, "}")
        emitln(cg, "")
        j = j + 1
    }

    // Generate start() method:
    // 1. Create ruleset if not already created
    // 2. Register all static rules
    // 3. Call Skink_ruleset_start
    startQn := str.Concat(rsName, str.Concat(".", "start"))
    emitln(cg, str.Concat(str.Concat("define void @", startQn), "() {"))
    emitln(cg, "entry:")
    // Create ruleset if null
    loadReg := nextReg(cg)
    emitfmt(cg, "  %s = load i8*, i8** %s\n", []string{loadReg, globalVarName})
    nullCmp := nextReg(cg)
    emitfmt(cg, "  %s = icmp eq i8* %s, null\n", []string{nullCmp, loadReg})
    createLabel := nextLabel(cg)
    afterCreateLabel := nextLabel(cg)
    emitCondBranch(cg, nullCmp, createLabel, afterCreateLabel)
    emitln(cg, str.Concat(str.Concat(createLabel, ":"), ""))
    createdReg := nextReg(cg)
    emitfmt(cg, "  %s = call i8* @Skink_ruleset_create()\n", []string{createdReg})
    emitfmt(cg, "  store i8* %s, i8** %s\n", []string{createdReg, globalVarName})
    emitln(cg, str.Concat(str.Concat("  br label %", afterCreateLabel), ""))
    emitln(cg, str.Concat(str.Concat(afterCreateLabel, ":"), ""))
    // Load ruleset pointer
    rsReg := nextReg(cg)
    emitfmt(cg, "  %s = load i8*, i8** %s\n", []string{rsReg, globalVarName})
    // Register all static rules
    rIdx := 0
    for rIdx < len(ruleEvalFns) {
        rd := d.rulesetRules[rIdx]
        prio := rd.rulePriority
        evalFnPtr := str.Concat("void(i8*)* bitcast (void(i8*)* ", str.Concat(ruleEvalFns[rIdx], " to void(i8*)*)"))
        emitfmt(cg, "  call void @Skink_ruleset_add_rule(i8* %s, i8* null, %s, void(i8*)* null, void(i8*)* null, i32 %s)\n",
            []string{rsReg, evalFnPtr, strconv.Itoa(prio)})
        rIdx = rIdx + 1
    }
    // Call Skink_ruleset_start
    emitfmt(cg, "  call void @Skink_ruleset_start(i8* %s)\n", []string{rsReg})
    emitln(cg, "  ret void")
    emitln(cg, "}")
    emitln(cg, "")
    // Short-name alias
    startShortQn := str.Concat(shortName, str.Concat(".", "start"))
    if !str.Equal(startShortQn, startQn) {
        emitln(cg, str.Concat(str.Concat("define void @", startShortQn), "() {"))
        emitln(cg, "entry:")
        emitln(cg, str.Concat(str.Concat("  call void @", str.Concat(startQn, "()")), ""))
        emitln(cg, "  ret void")
        emitln(cg, "}")
        emitln(cg, "")
    }

    // Generate stop(), restart(), reset() methods (all no-arg, similar pattern)
    noArgMethods := []string{"stop", "restart", "reset"}
    mIdx := 0
    for mIdx < len(noArgMethods) {
        methodName := noArgMethods[mIdx]
        qn := str.Concat(rsName, str.Concat(".", methodName))
        emitln(cg, str.Concat(str.Concat("define void @", qn), "() {"))
        emitln(cg, "entry:")
        // Load ruleset pointer
        rReg := nextReg(cg)
        emitfmt(cg, "  %s = load i8*, i8** %s\n", []string{rReg, globalVarName})
        ncmp := nextReg(cg)
        emitfmt(cg, "  %s = icmp eq i8* %s, null\n", []string{ncmp, rReg})
        skipLbl := nextLabel(cg)
        endLbl := nextLabel(cg)
        emitCondBranch(cg, ncmp, skipLbl, endLbl)
        emitln(cg, str.Concat(str.Concat(skipLbl, ":"), ""))
        emitln(cg, "  ret void")
        emitln(cg, str.Concat(str.Concat(endLbl, ":"), ""))
        if str.Equal(methodName, "stop") {
            emitfmt(cg, "  call void @Skink_ruleset_stop(i8* %s)\n", []string{rReg})
        } else if str.Equal(methodName, "restart") {
            emitfmt(cg, "  call void @Skink_ruleset_stop(i8* %s)\n", []string{rReg})
            emitfmt(cg, "  call void @Skink_ruleset_start(i8* %s)\n", []string{rReg})
        } else {
            emitfmt(cg, "  call void @Skink_ruleset_reset(i8* %s)\n", []string{rReg})
        }
        emitln(cg, "  ret void")
        emitln(cg, "}")
        emitln(cg, "")
        // Short-name alias
        shortQn := str.Concat(shortName, str.Concat(".", methodName))
        if !str.Equal(shortQn, qn) {
            emitln(cg, str.Concat(str.Concat("define void @", shortQn), "() {"))
            emitln(cg, "entry:")
            emitln(cg, str.Concat(str.Concat("  call void @", str.Concat(qn, "()")), ""))
            emitln(cg, "  ret void")
            emitln(cg, "}")
            emitln(cg, "")
        }
        mIdx = mIdx + 1
    }

    // Generate registerRule method: takes source pointer + eval/start/stop fn pointers.
    // registerRule may be called before start(), so the ruleset handle is
    // created lazily here too — otherwise Skink_ruleset_add_rule(NULL, ...)
    // segfaults in pthread_mutex_lock.
    regQn := str.Concat(rsName, str.Concat(".", "registerRule"))
    emitln(cg, str.Concat(str.Concat("define void @", regQn), "(i8* %arg0, void(i8*)* %arg1, void(i8*)* %arg2, void(i8*)* %arg3) {"))
    emitln(cg, "entry:")
    rlReg := nextReg(cg)
    emitfmt(cg, "  %s = load i8*, i8** %s\n", []string{rlReg, globalVarName})
    rlNull := nextReg(cg)
    emitfmt(cg, "  %s = icmp eq i8* %s, null\n", []string{rlNull, rlReg})
    rlCreate := nextLabel(cg)
    rlAfter := nextLabel(cg)
    emitCondBranch(cg, rlNull, rlCreate, rlAfter)
    emitln(cg, str.Concat(rlCreate, ":"))
    rlMade := nextReg(cg)
    emitfmt(cg, "  %s = call i8* @Skink_ruleset_create()\n", []string{rlMade})
    emitfmt(cg, "  store i8* %s, i8** %s\n", []string{rlMade, globalVarName})
    emitln(cg, str.Concat("  br label %", rlAfter))
    emitln(cg, str.Concat(rlAfter, ":"))
    rReg2 := nextReg(cg)
    emitfmt(cg, "  %s = load i8*, i8** %s\n", []string{rReg2, globalVarName})
    emitfmt(cg, "  call void @Skink_ruleset_add_rule(i8* %s, i8* %arg0, void(i8*)* %arg1, void(i8*)* %arg2, void(i8*)* %arg3, i32 0)\n",
        []string{rReg2})
    emitln(cg, "  ret void")
    emitln(cg, "}")
    emitln(cg, "")
    // Short-name alias
    regShortQn := str.Concat(shortName, str.Concat(".", "registerRule"))
    if !str.Equal(regShortQn, regQn) {
        emitln(cg, str.Concat(str.Concat("define void @", regShortQn), "(i8* %arg0, void(i8*)* %arg1, void(i8*)* %arg2, void(i8*)* %arg3) {"))
        emitln(cg, "entry:")
        emitfmt(cg, "  call void @%s(i8* %arg0, void(i8*)* %arg1, void(i8*)* %arg2, void(i8*)* %arg3)\n", []string{regQn})
        emitln(cg, "  ret void")
        emitln(cg, "}")
        emitln(cg, "")
    }

    // Restore module context
    cg.currentModule = savedModule
    cg.checker.currentModule = savedModule
}

// structLayoutHasHeapFields reports whether a struct layout contains any
// RC-managed field, directly or inside a nested struct-by-value field.
// Cycles are impossible: a struct can only contain itself behind a pointer.
fn structLayoutHasHeapFields(cg: *CodeGen, layout: StructLayout) -> bool {
    j := 0
    for j < len(layout.fieldTypes) {
        ft := layout.fieldTypes[j]
        if isHeapLLType(ft) {
            return true
        }
        if isCompositeType(ft) && !str.EndsWith(ft, "*") {
            nested := cg.structLayouts[structLLKey(ft)]
            if str.Len(nested.llType) > 0 && structLayoutHasHeapFields(cg, nested) {
                return true
            }
        }
        j = j + 1
    }
    return false
}

// structHasDtorTrampoline reports whether an X__dtor RC destructor will be
// emitted for the struct: either a user Drop method, or RC-managed fields
// that must be released when the heap block is freed (comp_error.md #99 —
// previously only Drop types got a dtor, so every field of a plain struct
// orphaned when its pointer was released).
fn structHasDtorTrampoline(cg: *CodeGen, layout: StructLayout) -> bool {
    return str.Len(layout.dtorFn) > 0 || structLayoutHasHeapFields(cg, layout)
}

// emitStructDtorTrampoline emits an i8* destructor trampoline for a struct.
// It runs the user's Drop method (if declared) for external resources, then
// releases every RC-managed field. Drop is run first so it can observe or
// delete fields — a deleted field reads null, which release treats as a
// no-op, so no double-free can occur.
fn emitStructDtorTrampoline(cg: *CodeGen, name: string, layout: StructLayout) {
    if !structHasDtorTrampoline(cg, layout) {
        return
    }
    trampolineName := str.Concat(sanitizeName(name), "__dtor")
    structPtrType := str.Concat(layout.llType, "*")
    emitln(cg, str.Concat(str.Concat("define void @", trampolineName), "(i8* %raw) {"))
    emitln(cg, "entry:")
    emitln(cg, str.Concat(str.Concat("  %ptr = bitcast i8* %raw to ", structPtrType), ""))
    if str.Len(layout.dtorFn) > 0 {
        dtorFn := layout.dtorFn
        retType := "void"
        if mapStringStringSliceHasKeyCG(cg.fnRetTypes, layout.dtorFn) {
            rets := cg.fnRetTypes[layout.dtorFn]
            if len(rets) > 0 {
                retType = rets[0]
            }
        }
        if str.Equal(retType, "void") {
            emitln(cg, str.Concat(str.Concat(str.Concat("  call void @", dtorFn), "("), str.Concat(str.Concat(structPtrType, " %ptr"), ")")))
        } else {
            emitln(cg, str.Concat(str.Concat(str.Concat(str.Concat("  %res = call ", retType), str.Concat(" @", dtorFn)), "("), str.Concat(str.Concat(structPtrType, " %ptr"), ")")))
        }
    }
    if structLayoutHasHeapFields(cg, layout) {
        emitReleaseStructHeapFields(cg, "%ptr", layout.llType)
    }
    emitln(cg, "  ret void")
    emitln(cg, "}")
    emitln(cg, "")
}

// emitRuntimeMain emits the C entry point and runtime helpers for argc/argv.
// === Embedded filesystem support ===

// embedSpec records one `embed "dir"` declaration: the on-disk root
// (resolved against the declaring source file) and the virtual root under
// which the directory's contents become reachable through the "int:"
// filesystem.
struct embedSpec {
    srcRoot:  string
    virtRoot: string
}

// embedFile is one file captured for embedding.
struct embedFile {
    virt: string // the virtual path, e.g. "models/tag/en.bin"
    src:  string // the on-disk source path
    data: string // the raw bytes (not NUL-safe — size is authoritative)
    size: int    // the byte count
}

// dirNameCG returns the directory portion of a path ("a/b/c" -> "a/b").
fn dirNameCG(p: string) -> string {
    idx := str.LastIndexOf(p, "/")
    if idx < 0 {
        return "."
    }
    return str.Substr(p, 0, idx)
}

// joinPathCG joins two path segments with a single slash.
fn joinPathCG(a: string, b: string) -> string {
    if str.Len(a) == 0 || str.Equal(a, ".") {
        return b
    }
    if str.EndsWith(a, "/") {
        return str.Concat(a, b)
    }
    return str.Concat(a, str.Concat("/", b))
}

// cleanEmbedRoot normalizes an embed path into its virtual-root form:
// leading "./" and "/" and trailing "/" are stripped, so `embed "models"`
// and `embed "./models/"` both mount under "models".
fn cleanEmbedRoot(s: string) -> string {
    for str.StartsWith(s, "./") {
        s = str.Substr(s, 2, str.Len(s) - 2)
    }
    for str.StartsWith(s, "/") {
        s = str.Substr(s, 1, str.Len(s) - 1)
    }
    for str.EndsWith(s, "/") {
        s = str.Substr(s, 0, str.Len(s) - 1)
    }
    return s
}

// walkEmbedDir collects every regular file under srcDir, recursing into
// subdirectories. Each file's virtual path is virtPrefix + "/" + name.
// Unreadable inputs surface as codegen errors.
fn walkEmbedDir(cg: *CodeGen, srcDir: string, virtPrefix: string) -> []embedFile {
    var out []embedFile
    entries, err := fs.ReadDir(srcDir)
    if err.message != "" {
        errorf(cg, str.Concat("embed: cannot read directory ", srcDir))
        return out
    }
    i := 0
    for i < len(entries) {
        name := entries[i].Name
        srcPath := str.Concat(srcDir, str.Concat("/", name))
        virtPath := name
        if str.Len(virtPrefix) > 0 {
            virtPath = str.Concat(virtPrefix, str.Concat("/", name))
        }
        if entries[i].IsDir {
            sub := walkEmbedDir(cg, srcPath, virtPath)
            j := 0
            for j < len(sub) {
                out = append(out, sub[j])
                j = j + 1
            }
        } else {
            ef := embedFile{virt: virtPath, src: srcPath}
            size := int(fs.FileSize(srcPath))
            f, ferr := fs.Open(srcPath, "rb")
            if size < 0 || ferr.message != "" {
                errorf(cg, str.Concat("embed: cannot read file ", srcPath))
            } else {
                // Strings are writable byte buffers; fill one with fread.
                ef.data = str.Repeat(" ", size + 1)
                got := 0
                if size > 0 {
                    got = f.Read(ef.data, size)
                }
                if got < 0 {
                    got = 0
                }
                ef.size = got
                out = append(out, ef)
            }
            f.Close()
        }
        i = i + 1
    }
    return out
}

// emitEmbedTables emits one private data global per embedded file and the
// @_skink_embed_init function, which registers every file with the
// embedded-filesystem table in the runtime before main runs. Virtual paths
// are deduplicated — the first `embed` providing a path wins.
fn emitEmbedTables(cg: *CodeGen) {
    if len(cg.embeds) == 0 {
        return
    }
    var files []embedFile
    var seen []string
    i := 0
    for i < len(cg.embeds) {
        found := walkEmbedDir(cg, cg.embeds[i].srcRoot, cg.embeds[i].virtRoot)
        j := 0
        for j < len(found) {
            dup := false
            k := 0
            for k < len(seen) {
                if str.Equal(seen[k], found[j].virt) {
                    dup = true
                    break
                }
                k = k + 1
            }
            if !dup {
                seen = append(seen, found[j].virt)
                files = append(files, found[j])
            }
            j = j + 1
        }
        i = i + 1
    }

    // The init function is always emitted when an embed decl exists, even
    // when it collects no files — main calls it unconditionally.
    emitStringGlobal(cg, "declare void @Skink_embed_register(i8*, i8*, i64)\n")
    emitln(cg, "define void @_skink_embed_init() {\n")
    emitln(cg, "entry:\n")
    hexDigits := "0123456789ABCDEF"
    i = 0
    for i < len(files) {
        f := files[i]
        dataGlobal := str.Concat("@__skink_embed_data_", strconv.Itoa(i))
        dataLen := f.size + 1

        // The path name global reuses the ordinary string-literal path:
        // emitStringLiteral returns an i8* in the current function.
        nameReg := emitStringLiteral(cg, f.virt)

        // Every byte becomes a \XX hex escape so arbitrary binary content
        // survives verbatim; a trailing \00 terminates the array.
        b := str.NewBuilder(f.size * 4 + 32)
        b.Write(dataGlobal)
        b.Write(" = private constant [")
        b.Write(strconv.Itoa(dataLen))
        b.Write(" x i8] c\"")
        j := 0
        for j < f.size {
            c := f.data[j]
            b.WriteByte(92)
            b.WriteByte(hexDigits[(c >> 4) & 15])
            b.WriteByte(hexDigits[c & 15])
            j = j + 1
        }
        b.Write("\\00\"\n")
        emitStringGlobal(cg, str.BuilderValue(b))

        dataLenS := strconv.Itoa(dataLen)
        dataGEP := str.Concat("getelementptr inbounds ([", str.Concat(dataLenS, str.Concat(" x i8], [", str.Concat(dataLenS, str.Concat(" x i8]* ", str.Concat(dataGlobal, ", i64 0, i64 0)"))))))
        emitfmt(cg, "  call void @Skink_embed_register(i8* %s, i8* %s, i64 %s)\n", []string{nameReg, dataGEP, strconv.Itoa(f.size)})
        i = i + 1
    }
    emitln(cg, "  ret void\n")
    emitln(cg, "}\n")
}

// isStringSliceAstType reports whether an AST type is `[]string`, the
// only parameter type the program entry point may declare (#139).
fn isStringSliceAstType(t: ast.Type) -> bool {
    if t.kind != ast.TY_ARRAY || len(t.elem) == 0 {
        return false
    }
    e := t.elem[0]
    return e.kind == ast.TY_NAMED && str.Equal(e.name, "string")
}

fn emitRuntimeMain(cg: *CodeGen, decls: []ast.Stmt) {
    // Find the user's main function to determine return type
    mainRetType := "void"
    mainFound := false
    mainName := ""
    mainArgv := false // whether main declares a single []string argv parameter
    i := 0
    for i < len(decls) {
        d := decls[i].decl
        if d.kind == ast.ST_FN {
            // main may be qualified as "main.main" by the resolver
            shortName := d.fnName
            dot := str.LastIndexOf(d.fnName, ".")
            if dot >= 0 {
                shortName = str.Substr(d.fnName, dot + 1, str.Len(d.fnName) - dot - 1)
            }
            if str.Len(shortName) == 4 && shortName[0] == 109 && shortName[1] == 97 && shortName[2] == 105 && shortName[3] == 110 {
                mainFound = true
                mainName = d.fnName
                if len(d.fnRetTypes) > 0 {
                    t := checker.astTypeToType(cg.checker, d.fnRetTypes[0])
                    mainRetType = llvmType(cg, t)
                }
                if len(d.fnParams) == 1 && len(d.fnParams[0].typ) == 1 {
                    mainArgv = isStringSliceAstType(d.fnParams[0].typ[0])
                }
                break
            }
        }
        i = i + 1
    }
    if !mainFound {
        // Library module (no main): emit forward declarations for the runtime
        // helpers so that extern references to them verify as valid IR. When
        // this module is linked into a program that has a main, the actual
        // definitions from emitRuntimeMain (in the main module) will satisfy
        // these declarations.
        emitHeader(cg, "declare void @_skink_runtime_set_argc(i32)\n")
        emitHeader(cg, "declare void @_skink_runtime_set_argv(i8**)\n")
        emitHeader(cg, "declare i32 @_skink_runtime_get_argc()\n")
        emitHeader(cg, "declare i8** @_skink_runtime_get_argv()\n")
        if len(cg.globalInits) > 0 {
            emitHeader(cg, "declare void @_skink_global_init()\n")
        }
        return
    }

    // Emit globals
    emitHeader(cg, "@skink_argc = global i32 0\n")
    emitHeader(cg, "@skink_argv = global i8** null\n")
    emitHeader(cg, "\n")

    // Emit set/get helpers
    emitln(cg, "define void @_skink_runtime_set_argc(i32 %argc) {\n")
    emitln(cg, "entry:\n")
    emitln(cg, "  store i32 %argc, i32* @skink_argc\n")
    emitln(cg, "  ret void\n")
    emitln(cg, "}\n")

    emitln(cg, "define void @_skink_runtime_set_argv(i8** %argv) {\n")
    emitln(cg, "entry:\n")
    emitln(cg, "  store i8** %argv, i8*** @skink_argv\n")
    emitln(cg, "  ret void\n")
    emitln(cg, "}\n")

    emitln(cg, "define i32 @_skink_runtime_get_argc() {\n")
    emitln(cg, "entry:\n")
    emitln(cg, "  %r = load i32, i32* @skink_argc\n")
    emitln(cg, "  ret i32 %r\n")
    emitln(cg, "}\n")

    // Wrap argv in a slice header: the C storage is foreign (not RC-owned),
    // so the header's base is NULL and it releases nothing when freed.
    emitln(cg, "define i8** @_skink_runtime_get_argv() {\n")
    emitln(cg, "entry:\n")
    emitln(cg, "  %r = load i8**, i8*** @skink_argv\n")
    emitln(cg, "  %n = load i32, i32* @skink_argc\n")
    emitln(cg, "  %n64 = sext i32 %n to i64\n")
    emitln(cg, "  %d = bitcast i8** %r to i8*\n")
    emitln(cg, "  %h = call i8* @Skink_slice_hdr(i8* %d, i64 %n64, i64 %n64, i8* null)\n")
    emitln(cg, "  %t = bitcast i8* %h to i8**\n")
    emitln(cg, "  ret i8** %t\n")
    emitln(cg, "}\n")

    // Emit global init function (initializes module-level vars with initializers)
    if len(cg.globalInits) > 0 {
        emitln(cg, "define void @_skink_global_init() {\n")
        emitln(cg, "entry:\n")
        savedCgMod := cg.currentModule
        savedCheckerMod := cg.checker.currentModule
        savedFile := cg.currentFilePath
        i := 0
        for i < len(cg.globalInits) {
            stmt := cg.globalInits[i]
            varLLType := cg.globalVarTypes[stmt.varName]
            if len(stmt.varValue) > 0 {
                // Set module context from the qualified var name so
                // unqualified identifiers in the initializer (e.g. the
                // owning module's private consts) resolve correctly.
                setModuleContextFromName(cg, stmt.varName)
                cg.currentFilePath = stmt.filePath
                valReg := emitExpression(cg, stmt.varValue[0])
                valType := exprLLType(cg, stmt.varValue[0])
                valReg = coerceExprToParamType(cg, valReg, valType, varLLType, stmt.varValue[0])
                globalPtr := str.Concat("@", stmt.varName)
                emitStore(cg, varLLType, valReg, varLLType, globalPtr)
            } else if len(stmt.varType) > 0 && str.StartsWith(varLLType, "%map_") && !str.EndsWith(varLLType, "**") {
                // No initializer: synthesize make(map[K]V) so the global
                // starts as a usable empty map (#113).
                setModuleContextFromName(cg, stmt.varName)
                cg.currentFilePath = stmt.filePath
                me := ast.newExpr(ast.EX_MAKE, stmt.line, stmt.col)
                me.makeType = stmt.varType
                valReg := emitExpression(cg, me)
                globalPtr := str.Concat("@", stmt.varName)
                emitStore(cg, varLLType, valReg, varLLType, globalPtr)
            }
            i = i + 1
        }
        cg.currentModule = savedCgMod
        cg.checker.currentModule = savedCheckerMod
        cg.currentFilePath = savedFile
        emitln(cg, "  ret void\n")
        emitln(cg, "}\n")
    }

    // Emit embedded-data tables and their registration init. The init
    // runs before global initializers so embedded files are reachable
    // from anywhere, including module-level init code.
    emitEmbedTables(cg)

    // Emit C entry point
    emitln(cg, "define i32 @main(i32 %argc, i8** %argv) {\n")
    emitln(cg, "entry:\n")
    emitln(cg, "  call void @_skink_runtime_set_argc(i32 %argc)\n")
    emitln(cg, "  call void @_skink_runtime_set_argv(i8** %argv)\n")
    if len(cg.embeds) > 0 {
        emitln(cg, "  call void @_skink_embed_init()\n")
    }
    // Call global init function if there are any global var initializers
    if len(cg.globalInits) > 0 {
        emitln(cg, "  call void @_skink_global_init()\n")
    }
    // `fn main(args: []string)` receives the process argv as a slice,
    // identical to os.Args() (comp_error.md #139).
    mainArgStr := ""
    if mainArgv {
        emitln(cg, "  %__argv = call i8** @_skink_runtime_get_argv()\n")
        mainArgStr = "i8** %__argv"
    }
    if str.Equal(mainRetType, "void") {
        emitln(cg, str.Concat("  call void @_skink_main(", str.Concat(mainArgStr, ")\n")))
        emitln(cg, "  ret i32 0\n")
    } else if str.Equal(mainRetType, "i32") {
        emitln(cg, str.Concat("  %r = call i32 @_skink_main(", str.Concat(mainArgStr, ")\n")))
        emitln(cg, "  ret i32 %r\n")
    } else {
        emitln(cg, str.Concat("  call void @_skink_main(", str.Concat(mainArgStr, ")\n")))
        emitln(cg, "  ret i32 0\n")
    }
    emitln(cg, "}\n")
}

// emitRuntimeDecls emits declarations for runtime functions.
fn emitRuntimeDecls(cg: *CodeGen) {
    emitHeader(cg, "declare i32 @printf(i8*, ...)\n")
    emitHeader(cg, "declare i32 @sprintf(i8*, i8*, ...)\n")
    emitHeader(cg, "declare i32 @snprintf(i8*, i64, i8*, ...)\n")
    emitHeader(cg, "declare i32 @puts(i8*)\n")
    emitHeader(cg, "declare i64 @strlen(i8*)\n")
    emitHeader(cg, "declare i8* @strcpy(i8*, i8*)\n")
    emitHeader(cg, "declare i8* @strcat(i8*, i8*)\n")
    emitHeader(cg, "declare i32 @strcmp(i8*, i8*)\n")
    emitHeader(cg, "declare double @Skink_vec_dot(i8*, i8*)\n")
    emitHeader(cg, "declare double @Skink_vec_norm(i8*)\n")
    emitHeader(cg, "declare i32 @Skink_chan_len(i8*)\n")
    emitHeader(cg, "declare i8* @malloc(i64)\n")
    emitHeader(cg, "declare void @free(i8*)\n")
    emitHeader(cg, "declare void @exit(i32)\n")
    emitHeader(cg, "declare void @llvm.memcpy.p0i8.p0i8.i64(i8*, i8*, i64, i1)\n")
    emitHeader(cg, "declare void @llvm.memset.p0i8.i64(i8*, i8, i64, i1)\n")
    emitHeader(cg, "declare double @pow(double, double)\n")
    emitHeader(cg, "declare double @sin(double)\n")
    emitHeader(cg, "declare double @cos(double)\n")
    emitHeader(cg, "declare double @tan(double)\n")
    emitHeader(cg, "declare double @sqrt(double)\n")
    emitHeader(cg, "\n")
    emitHeader(cg, "declare i8* @Skink_rc_alloc(i64)\n")
    emitHeader(cg, "declare i8* @Skink_rc_alloc_typed(i64, i8*)\n")
    emitHeader(cg, "declare i8* @Skink_rc_retain(i8*)\n")
    emitHeader(cg, "declare void @Skink_rc_release(i8*)\n")
    emitHeader(cg, "declare void @Skink_rc_release_ptr(i8*)\n")
    emitHeader(cg, "declare void @Skink_template_box_dtor(i8*)\n")
    emitHeader(cg, "declare void @Skink_array_dtor_sized(i8*, i64, i8*)\n")
    emitHeader(cg, "declare i64 @Skink_rc_count(i8*)\n")
    emitHeader(cg, "declare i8* @Skink_slice_ensure(i8*, i64)\n")
    emitHeader(cg, "declare i64 @Skink_slice_len(i8*)\n")
    emitHeader(cg, "declare i64 @Skink_slice_cap(i8*)\n")
    emitHeader(cg, "declare i8* @Skink_slice_data(i8*)\n")
    emitHeader(cg, "declare i8* @Skink_slice_base(i8*)\n")
    emitHeader(cg, "declare i8* @Skink_slice_hdr(i8*, i64, i64, i8*)\n")
    emitHeader(cg, "declare i8* @Skink_slice_sub(i8*, i64, i64, i64)\n")
    emitHeader(cg, "declare i8* @Skink_str_from_slice(i8*)\n")
    emitHeader(cg, "declare i64 @Skink_arr_count(i8*)\n")
    emitHeader(cg, "declare i64 @Skink_rc_capacity(i8*)\n")
    // The slice-header struct type mirrors SkinkSliceHdr in rc_rt.c:
    // { i8* data, i64 len, i64 cap, i8* base }. Slice VALUES are headers;
    // emitted code unwraps data/cap/base only at element-access sites.
    emitHeader(cg, "%hdr.slice = type { i8*, i64, i64, i8* }\n")
    emitHeader(cg, "declare i32 @Skink_str_hash(i8*)\n")
    emitHeader(cg, "declare void @Skink_panic(i8*)\n")
    emitHeader(cg, "declare void @Skink_bounds_check(i32, i32, i32)\n")
    emitHeader(cg, "declare i32 @setjmp(i8*) returns_twice\n")
    emitHeader(cg, "declare i32 @Skink_panic_push_handler(i8*)\n")
    emitHeader(cg, "declare void @Skink_panic_pop_handler()\n")
    emitHeader(cg, "declare i32 @Skink_panic_pending()\n")
    emitHeader(cg, "declare i8* @Skink_panic_recover()\n")
    emitHeader(cg, "declare void @Skink_panic_reraise()\n")
    emitHeader(cg, "declare i8* @Skink_chan_make(i32, i32)\n")
    emitHeader(cg, "declare void @Skink_chan_close(i8*)\n")
    emitHeader(cg, "declare void @Skink_chan_send(i8*, i8*)\n")
    emitHeader(cg, "declare i8* @Skink_chan_recv(i8*)\n")
    emitHeader(cg, "declare i32 @Skink_chan_select(i32, i8**, i32*, i8**, i8**, i32)\n")
    emitHeader(cg, "declare void @Skink_spawn(i8*, i8*, i8*)\n")
    emitHeader(cg, "declare i8* @Skink_future_make()\n")
    emitHeader(cg, "declare void @Skink_future_set(i8*, i8*)\n")
    emitHeader(cg, "declare i8* @Skink_future_get(i8*)\n")
    emitHeader(cg, "declare void @Skink_free(i8*)\n")
    emitHeader(cg, "\n")

    // Mark every name we just declared so emitExternFnDecl never emits
    // a second (possibly mismatched) declare for the same symbol.
    rtNames := []string{
        "printf", "sprintf", "snprintf", "puts", "strlen", "strcpy",
        "strcat", "strcmp", "malloc", "free", "exit",
        "pow", "sin", "cos", "tan", "sqrt",
        "Skink_vec_dot", "Skink_vec_norm", "Skink_chan_len",
        "Skink_rc_alloc", "Skink_rc_alloc_typed", "Skink_rc_retain",
        "Skink_rc_release", "Skink_rc_release_ptr", "Skink_array_dtor_sized",
        "Skink_rc_count", "Skink_slice_ensure",
        "Skink_slice_len", "Skink_slice_cap", "Skink_slice_data",
        "Skink_slice_base", "Skink_slice_hdr", "Skink_slice_sub",
        "Skink_str_from_slice", "Skink_arr_count", "Skink_rc_capacity",
        "Skink_panic", "Skink_bounds_check", "setjmp",
        "Skink_panic_push_handler", "Skink_panic_pop_handler",
        "Skink_panic_pending", "Skink_panic_recover", "Skink_panic_reraise",
        "Skink_chan_make", "Skink_chan_close", "Skink_chan_send",
        "Skink_chan_recv", "Skink_chan_select", "Skink_spawn", "Skink_free",
        "Skink_future_make", "Skink_future_set", "Skink_future_get",
    }
    i := 0
    for i < len(rtNames) {
        cg.declaredExterns[rtNames[i]] = true
        i = i + 1
    }
}

// === Type Inference ===

// exprLLType infers the LLVM type of an expression without emitting code.
// This is used for type-aware code generation (e.g., choosing add vs fadd).
fn exprLLType(cg: *CodeGen, e: ast.Expr) -> string {
    if e.kind == ast.EX_INT { return "i32" }
    if e.kind == ast.EX_FLOAT { return "double" }
    if e.kind == ast.EX_BOOL { return "i1" }
    if e.kind == ast.EX_NIL { return "i8*" }
    if e.kind == ast.EX_STRING { return "i8*" }
    if e.kind == ast.EX_IDENT { return exprIdentLLType(cg, e) }
    if e.kind == ast.EX_PREFIX { return exprPrefixLLType(cg, e) }
    if e.kind == ast.EX_INFIX { return exprInfixLLType(cg, e) }
    if e.kind == ast.EX_CALL { return exprCallLLType(cg, e) }
    if e.kind == ast.EX_INDEX { return exprIndexLLType(cg, e) }
    if e.kind == ast.EX_FIELD { return exprFieldLLType(cg, e) }
    if e.kind == ast.EX_ARRAY_LIT { return exprArrayLitLLType(cg, e) }
    if e.kind == ast.EX_STRUCT_LIT { return exprStructLitLLType(cg, e) }
    if e.kind == ast.EX_PAREN { return exprLLType(cg, e.inner[0]) }
    if e.kind == ast.EX_SLICE { return exprLLType(cg, e.sliceTarget[0]) }
    if e.kind == ast.EX_MAKE { return exprMakeLLType(cg, e) }
    if e.kind == ast.EX_FROM_END { return exprIndexLLType(cg, e) }
    if e.kind == ast.EX_SPREAD { return exprSpreadLLType(cg, e) }
    if e.kind == ast.EX_ERROR_PROP {
        // ? operator extracts the first value from an aggregate { T, error }
        innerType := exprLLType(cg, e.postfixTarget[0])
        if str.StartsWith(innerType, "{ ") {
            // Extract first type from aggregate type string "{ i32, ... }"
            inner := str.Substr(innerType, 2, str.Len(innerType) - 4)
            commaIdx := str.IndexOf(inner, ",")
            if commaIdx > 0 {
                firstType := str.Trim(str.Substr(inner, 0, commaIdx))
                return firstType
            }
        }
        return innerType
    }
    if e.kind == ast.EX_NONNULL { return exprNonNullLLType(cg, e) }
    if e.kind == ast.EX_IF_EXPR {
        // The result type comes from the then-arm's value (the checker
        // guarantees both arms agree).
        if len(e.ifThen) > 0 {
            return exprLLType(cg, e.ifThen[0])
        }
        return "i32"
    }
    if e.kind == ast.EX_MAP_LIT { return "i8*" }
    if e.kind == ast.EX_SET_LIT {
        if len(e.setElems) == 0 { return "i8*" }
        elemLL := exprLLType(cg, e.setElems[0])
        return setLLType(cg, elemLL)
    }
    if e.kind == ast.EX_SIZEOF { return "i32" }
    if e.kind == ast.EX_ALIGNOF { return "i32" }
    if e.kind == ast.EX_RANGE { return "{ i32, i32 }" }
    if e.kind == ast.EX_MATCH_EXPR { return matchExprResultLLType(cg, e) }
    if e.kind == ast.EX_INTERP { return "i8*" }
    if e.kind == ast.EX_FN_LIT {
        // Function literal values are i8* closure handles.
        return "i8*"
    }
    if e.kind == ast.EX_ASYNC { return "i8*" }
    if e.kind == ast.EX_AWAIT {
        // Derive the awaited element type from the inner future expression's
        // semantic type rather than the awaitElemTypes map. This avoids map
        // lookups that can be unsafe when the key string is transient.
        futT := exprSkinkType(cg, e.awaitExpr[0])
        if futT.kind == checker.TK_NAMED && str.Equal(futT.name, "future") && len(futT.elem) > 0 {
            llT := llvmType(cg, checker.typeOptT(futT.elem))
            if str.Equal(llT, "void") { return "i8*" }
            return llT
        }
        return "i8*"
    }
    return "i32"
}

// fnPtrLLTypeFromName builds the LLVM function pointer type string for a
// known function from its stored parameter and return types.
fn fnPtrLLTypeFromName(cg: *CodeGen, name: string) -> string {
    hasParams := mapStringStringSliceHasKeyCG(cg.fnParamTypes, name)
    hasRet := mapStringStringSliceHasKeyCG(cg.fnRetTypes, name)
    paramParts := []string{}
    if hasParams {
        i := 0
        for i < len(cg.fnParamTypes[name]) {
            paramParts = append(paramParts, cg.fnParamTypes[name][i])
            i = i + 1
        }
    }
    retType := "void"
    if hasRet && len(cg.fnRetTypes[name]) > 0 {
        retType = cg.fnRetTypes[name][0]
    }
    return str.Concat(retType, str.Concat(" (", str.Concat(str.Join(paramParts, ", "), ")*")))
}

// exprIdentLLType infers the LLVM type of an identifier expression.
fn exprIdentLLType(cg: *CodeGen, e: ast.Expr) -> string {
    name := e.ident
    // Check local variable
    sv, ok := lookupVar(cg, name)
    if ok {
        return sv.llType
    }
    // Check global variable
    gvt := cg.globalVarTypes[name]
    if gvt != "" {
        return gvt
    }
    // Try module-qualified global variable name
    if str.Len(cg.currentModule) > 0 {
        qualified := str.Concat(cg.currentModule, str.Concat(".", name))
        qGvt := cg.globalVarTypes[qualified]
        hasQGvt := mapStringStringHasKeyCG(cg.globalVarTypes, qualified)
        if hasQGvt {
            return qGvt
        }
    }
    // Bare tagged-union variant used as a value (e.g. `s := None`) — its
    // type is the enclosing tagged-union struct.
    if mapStringDeclHasKeyTU2(cg.tuVariantDecl, name) {
        return tuLLName(cg.tuVariantDecl[name].enumName)
    }
    // Check function — return the function pointer type, not the return type.
    hasFn := mapStringStringSliceHasKeyCG(cg.fnRetTypes, name)
    if hasFn {
        return fnPtrLLTypeFromName(cg, name)
    }
    // Try module-qualified function name
    if str.Len(cg.currentModule) > 0 {
        qualified := str.Concat(cg.currentModule, str.Concat(".", name))
        hasQFn := mapStringStringSliceHasKeyCG(cg.fnRetTypes, qualified)
        if hasQFn {
            return fnPtrLLTypeFromName(cg, qualified)
        }
    }
    // Try resolving via imports (e.g. handleConnThread -> server.handleConnThread)
    if str.Len(cg.currentModule) > 0 {
        imps := checker.importsFor(cg.checker, cg.currentModule)
        j := 0
        for j < len(imps) {
            alias := imps[j]
            resolvedModule := resolveImportAliasCG(cg, alias)
            qualified := str.Concat(resolvedModule, str.Concat(".", name))
            hasQFn := mapStringStringSliceHasKeyCG(cg.fnRetTypes, qualified)
            if hasQFn {
                return fnPtrLLTypeFromName(cg, qualified)
            }
            j = j + 1
        }
    }
    // Check const
    val := cg.consts[name]
    if val.kind != 0 {
        return constExprLLType(cg, name)
    }
    if str.Len(cg.currentModule) > 0 {
        qualified := str.Concat(cg.currentModule, str.Concat(".", name))
        qval := cg.consts[qualified]
        if qval.kind != 0 {
            return constExprLLType(cg, qualified)
        }
    }
    return "i32"
}

// exprPrefixLLType infers the LLVM type of a prefix expression.
fn exprPrefixLLType(cg: *CodeGen, e: ast.Expr) -> string {
    op := e.prefixOp
    if str.Equal(op, "!") {
        return "i1"
    }
    if str.Equal(op, "<-") {
        return chanRecvElemLLType(cg, e)
    }
    if str.Equal(op, "&") {
        right := e.prefixRight[0]
        rt := exprLLType(cg, right)
        // Mirror emitAddressOf, which does not always produce rt + "*":
        //  - &var on a *T local loads the stored heap pointer (sv.llType
        //    already ends with "*"), so the result type is sv.llType.
        //  - index/field operands emit a real GEP to the slot (rt + "*").
        //  - other expressions that already produce a pointer (e.g.
        //    &T{...} where the literal is heap-allocated) are returned
        //    unchanged, so the result type is rt.
        if right.kind == ast.EX_IDENT {
            sv, ok := lookupVar(cg, right.ident)
            if ok {
                if str.StartsWith(sv.llType, "%struct.") && str.EndsWith(sv.llType, "*") {
                    return sv.llType
                }
                return str.Concat(sv.llType, "*")
            }
            if mapStringStringHasKeyCG(cg.globalVarTypes, right.ident) {
                return str.Concat(rt, "*")
            }
        }
        if right.kind == ast.EX_INDEX {
            return str.Concat(rt, "*")
        }
        if right.kind == ast.EX_FIELD {
            if str.StartsWith(exprLLType(cg, right.fieldTarget[0]), "%struct.") {
                return str.Concat(rt, "*")
            }
        }
        if str.EndsWith(rt, "*") {
            return rt
        }
        return str.Concat(rt, "*")
    }
    if str.Equal(op, "*") {
        rt := exprLLType(cg, e.prefixRight[0])
        if str.EndsWith(rt, "*") {
            return str.Substr(rt, 0, str.Len(rt) - 1)
        }
        return "i32"
    }
    return exprLLType(cg, e.prefixRight[0])
}

// exprInfixLLType infers the LLVM type of an infix expression.
fn exprInfixLLType(cg: *CodeGen, e: ast.Expr) -> string {
    op := e.infixOp
    // Channel send (ch <- val) produces void
    if str.Equal(op, "<-") {
        return "i32"
    }
    // Comparisons produce i1
    if str.Equal(op, "==") || str.Equal(op, "!=") || str.Equal(op, "<") ||
       str.Equal(op, ">") || str.Equal(op, "<=") || str.Equal(op, ">=") {
        return "i1"
    }
    // Logical produce i1
    if str.Equal(op, "&&") || str.Equal(op, "||") {
        return "i1"
    }
    // Set membership (in) produces i1
    if str.Equal(op, "in") {
        return "i1"
    }
    // Arithmetic: promote to double if either operand is float
    lt := exprLLType(cg, e.infixLeft[0])
    rt := exprLLType(cg, e.infixRight[0])
    if str.Equal(lt, "double") || str.Equal(rt, "double") {
        return "double"
    }
    // String concatenation: if either is i8*, result is i8*
    if str.Equal(lt, "i8*") || str.Equal(rt, "i8*") {
        if str.Equal(op, "+") {
            return "i8*"
        }
    }
    // Integer promotion: if either operand is i64, result is i64
    if str.Equal(lt, "i64") || str.Equal(rt, "i64") {
        return "i64"
    }
    return lt
}

// semanticCallLLType returns the concrete LLVM type the checker assigned
// to a call expression when it differs from the erased i8* the callee's
// signature actually emits. Generic type parameters erase to i8*, so
// `idOf(42)` emits `call i8* @idOf` while the checker sees `int` — the
// result needs converting before consumers use it. Returns "" when the
// erased type already matches or the semantic type can't be resolved to
// a concrete LLVM type (e.g. an unsubstituted generic param like T).
fn semanticCallLLType(cg: *CodeGen, e: ast.Expr, erasedLL: string) -> string {
    if !str.Equal(erasedLL, "i8*") {
        return ""
    }
    st := exprSkinkType(cg, e)
    if st.kind == 0 || st.kind == checker.TK_UNKNOWN || st.kind == checker.TK_ANY ||
        st.kind == checker.TK_NIL || st.kind == checker.TK_CHAN ||
        st.kind == checker.TK_TEMPLATE || st.kind == checker.TK_TUPLE {
        return ""
    }
    if st.kind == checker.TK_NAMED {
        // Resolve aliases; a still-generic name (T inside the generic
        // function body) has no struct layout — leave it erased.
        r := resolveAliasCG(cg, st)
        if r.kind == checker.TK_NAMED {
            layout := cg.structLayouts[r.name]
            hasLayout := str.Len(layout.llType) > 0
            if !hasLayout && str.Len(cg.currentModule) > 0 && !str.Contains(r.name, ".") {
                layout = cg.structLayouts[str.Concat(str.Concat(cg.currentModule, "."), r.name)]
                hasLayout = str.Len(layout.llType) > 0
            }
            if !hasLayout {
                return ""
            }
        }
        st = r
    }
    wantLL := llvmType(cg, st)
    if str.Len(wantLL) == 0 || str.Equal(wantLL, erasedLL) {
        return ""
    }
    return wantLL
}

// coerceGenericCallResult converts a call's raw i8* result register to the
// semantic type recorded by the checker (the reverse of the inttoptr
// argument erasure). Only handles kinds representable in an i8*: integers
// via ptrtoint and pointers via bitcast.
fn coerceGenericCallResult(cg: *CodeGen, e: ast.Expr, reg: string, emittedLL: string) -> string {
    if str.Len(reg) == 0 {
        return reg
    }
    wantLL := semanticCallLLType(cg, e, emittedLL)
    if str.Len(wantLL) == 0 {
        return reg
    }
    if str.StartsWith(wantLL, "i") && !str.EndsWith(wantLL, "*") {
        r := nextReg(cg)
        emitfmt(cg, "  %s = ptrtoint i8* %s to %s\n", []string{r, reg, wantLL})
        return r
    }
    if str.EndsWith(wantLL, "*") {
        r := nextReg(cg)
        emitfmt(cg, "  %s = bitcast i8* %s to %s\n", []string{r, reg, wantLL})
        return r
    }
    return reg
}

// exprCallLLType infers the LLVM type of a call expression.
fn exprCallLLType(cg: *CodeGen, e: ast.Expr) -> string {
    fnExpr := e.callFunc[0]
    if fnExpr.kind == ast.EX_IDENT {
        fnName := resolveDirectFnName(cg, fnExpr.ident)
        // Type casts
        if str.Equal(fnName, "int") || str.Equal(fnName, "uint") || str.Equal(fnName, "int32") || str.Equal(fnName, "uint32") {
            return "i32"
        }
        if str.Equal(fnName, "int8") || str.Equal(fnName, "uint8") {
            return "i8"
        }
        if str.Equal(fnName, "int16") || str.Equal(fnName, "uint16") {
            return "i16"
        }
        if str.Equal(fnName, "int64") || str.Equal(fnName, "uint64") {
            return "i64"
        }
        if str.Equal(fnName, "float") {
            return "double"
        }
        if str.Equal(fnName, "bool") {
            return "i1"
        }
        if str.Equal(fnName, "string") {
            return "i8*"
        }
        if str.Equal(fnName, "len") {
            return "i32"
        }
        if str.Equal(fnName, "recover") {
            return "i8*"
        }
        // Builtin math functions return doubles.
        if str.Equal(fnName, "sin") || str.Equal(fnName, "cos") || str.Equal(fnName, "tan") ||
            str.Equal(fnName, "sqrt") || str.Equal(fnName, "pow") || str.Equal(fnName, "dot") ||
            str.Equal(fnName, "norm") {
            return "double"
        }
        // append returns the same type as its first argument (the slice)
        if str.Equal(fnName, "append") {
            if len(e.callArgs) > 0 {
                return exprLLType(cg, e.callArgs[0])
            }
            return "i8*"
        }
        // copy returns the same type as its first argument (slice or map)
        if str.Equal(fnName, "copy") {
            if len(e.callArgs) > 0 {
                return exprLLType(cg, e.callArgs[0])
            }
            return "i8*"
        }
        // delete returns void
        if str.Equal(fnName, "delete") {
            return "void"
        }
        // Tagged-union constructor returns the TU value type.
        if mapStringDeclHasKeyTU2(cg.tuVariantDecl, fnName) {
            return tuLLName(cg.tuVariantDecl[fnName].enumName)
        }
        // Look up function return type
        hasFn := mapStringStringSliceHasKeyCG(cg.fnRetTypes, fnName)
        if hasFn && len(cg.fnRetTypes[fnName]) > 0 {
            if len(cg.fnRetTypes[fnName]) > 1 {
                return aggregateRetType(cg.fnRetTypes[fnName])
            }
            rt := cg.fnRetTypes[fnName][0]
            sem := semanticCallLLType(cg, e, rt)
            if str.Len(sem) > 0 {
                return sem
            }
            return rt
        }
        // Indirect call through a variable holding a function pointer —
        // use the variable's declared function type for the result.
        sv, isVar := lookupVar(cg, fnExpr.ident)
        if isVar {
            ft := sv.synType
            if ft.kind == checker.TK_NAMED {
                ft = resolveAliasCG(cg, ft)
            }
            if ft.kind == checker.TK_FUNCTION && len(ft.retTypes) > 0 {
                return llvmType(cg, ft.retTypes[0])
            }
            // Function-pointer LLVM types look like "i32 (i32, i32)*".
            if str.EndsWith(sv.llType, ")*") {
                return parseFnPtrRetType(sv.llType)
            }
        }
        return "i32"
    }
    if fnExpr.kind == ast.EX_FIELD {
        // Template method call: look up return type from template declaration
        receiverExpr := fnExpr.fieldTarget[0]
        receiverLLType := exprLLType(cg, receiverExpr)
        if str.StartsWith(receiverLLType, "%template.") {
            tmplName, ok := findTemplateByLLType(cg, receiverLLType)
            if ok {
                tmpl := checker.getTemplate(cg.checker, tmplName)
                j := 0
                for j < len(tmpl.templateMethods) {
                    if str.Equal(tmpl.templateMethods[j].fnName, fnExpr.fieldName) {
                        m := tmpl.templateMethods[j]
                        if len(m.fnRetTypes) > 0 {
                            t := checker.astTypeToType(cg.checker, m.fnRetTypes[0])
                            return llvmType(cg, t)
                        }
                        return "void"
                    }
                    j = j + 1
                }
            }
            return "i32"
        }
        // Method call: look up method return type using the same
        // resolution logic as the codegen (emitMethodCall), so type
        // inference and code emission never disagree on which function
        // a method-call-syntax expression resolves to.
        fnName, _ := resolveMethodCallFnName(cg, fnExpr)
        hasFn := mapStringStringSliceHasKeyCG(cg.fnRetTypes, fnName)
        if hasFn && len(cg.fnRetTypes[fnName]) > 0 {
            if len(cg.fnRetTypes[fnName]) > 1 {
                return aggregateRetType(cg.fnRetTypes[fnName])
            }
            rt := cg.fnRetTypes[fnName][0]
            sem := semanticCallLLType(cg, e, rt)
            if str.Len(sem) > 0 {
                return sem
            }
            return rt
        }
        // Unknown method target (e.g. a function-typed field invoked via
        // method-call syntax): use the checker's recorded type.
        st := exprSkinkType(cg, e)
        if st.kind == checker.TK_NAMED {
            st = resolveAliasCG(cg, st)
        }
        if st.kind != 0 && st.kind != checker.TK_UNKNOWN {
            return llvmType(cg, st)
        }
        return "i32"
    }
    // Calls through arbitrary callee expressions (index, deref, parenthesized
    // values) are emitted as closure calls returning i8* — but the real
    // result type comes from the checker's recorded semantic type.
    st := exprSkinkType(cg, e)
    if st.kind == checker.TK_NAMED {
        st = resolveAliasCG(cg, st)
    }
    if st.kind != 0 && st.kind != checker.TK_UNKNOWN {
        return llvmType(cg, st)
    }
    return "i32"
}

// exprIndexLLType infers the LLVM type of an index access expression.
fn exprIndexLLType(cg: *CodeGen, e: ast.Expr) -> string {
    arrType := exprLLType(cg, e.indexTarget[0])
    // Map index: return the value type
    // A slice of maps has type %map_...** (double pointer) — indexing into
    // it returns an element (map pointer), not a map value.
    _, valLL, isMap := parseMapTypeLL(arrType)
    if isMap && !str.EndsWith(arrType, "**") {
        return valLL
    }
    // String index: returns int (byte value)
    if str.Equal(arrType, "i8*") {
        return "i32"
    }
    if str.EndsWith(arrType, "*") {
        elemType := str.Substr(arrType, 0, str.Len(arrType) - 1)
        return elemType
    }
    return "i32"
}

// exprFieldLLType infers the LLVM type of a field access expression.
fn exprFieldLLType(cg: *CodeGen, e: ast.Expr) -> string {
    // Get the struct type of the receiver
    leftType := exprLLType(cg, e.fieldTarget[0])
    if str.StartsWith(leftType, "%struct.") {
        structName := str.Substr(leftType, str.Len("%struct."), str.Len(leftType) - str.Len("%struct."))
        if str.Contains(structName, "*") {
            structName = str.Substr(structName, 0, str.IndexOf(structName, "*"))
        }
        layout := cg.structLayouts[structName]
        hasLayout := str.Len(layout.llType) > 0
        if hasLayout {
            i := 0
            for i < len(layout.fields) {
                if str.Equal(layout.fields[i], e.fieldName) {
                    return layout.fieldTypes[i]
                }
                i = i + 1
            }
        }
    }
    // Template method access: e.g. tr.r.Read where r is a template fat pointer.
    // The method is stored as a function pointer (i8*) in the template struct.
    if str.StartsWith(leftType, "%template.") {
        return "i8*"
    }
    // Module-qualified constant or variable
    if e.fieldTarget[0].kind == ast.EX_IDENT {
        receiverName := e.fieldTarget[0].ident
        qualifiedName := str.Concat(receiverName, str.Concat(".", e.fieldName))
        // Check global var
        gvt := cg.globalVarTypes[qualifiedName]
        if gvt != "" {
            return gvt
        }
        // Check const
        val := cg.consts[qualifiedName]
        if val.kind != 0 {
            return constExprLLType(cg, qualifiedName)
        }
    }
    // Anything else the checker resolved — notably a module-qualified
    // function used as a value (`io.Itoa` as an argument), whose
    // function type lowers to the i8* closure handle. Falling through
    // to "i32" here made call-arg coercion emit `inttoptr i32` on the
    // already-correct i8* handle (invalid IR).
    st := exprSkinkType(cg, e)
    if st.kind == checker.TK_NAMED {
        st = resolveAliasCG(cg, st)
    }
    if st.kind != 0 && st.kind != checker.TK_UNKNOWN {
        return llvmType(cg, st)
    }
    return "i32"
}

// exprStructLitLLType infers the LLVM type of a struct literal expression.
fn exprStructLitLLType(cg: *CodeGen, e: ast.Expr) -> string {
    structName := e.structLitName
    // Qualify with current module if needed
    if !str.Contains(structName, ".") && str.Len(cg.currentModule) > 0 {
        qualified := str.Concat(cg.currentModule, str.Concat(".", structName))
        if str.Len(cg.structLayouts[qualified].llType) > 0 {
            structName = qualified
        }
    }
    layout := cg.structLayouts[structName]
    if str.Len(layout.llType) > 0 {
        return str.Concat(layout.llType, "*")
    }
    return str.Concat("%struct.", str.Concat(sanitizeName(structName), "*"))
}

// exprArrayLitLLType infers the LLVM type of an array literal expression.
fn exprArrayLitLLType(cg: *CodeGen, e: ast.Expr) -> string {
    // Declared element type wins over first-element inference so that
    // []uint8{...} reports i8* (comp_error.md #26).
    if len(e.arrayType) > 0 {
        t := checker.astTypeToType(cg.checker, e.arrayType[0])
        return str.Concat(llvmType(cg, t), "*")
    }
    if len(e.arrayElems) > 0 {
        return str.Concat(exprLLType(cg, e.arrayElems[0]), "*")
    }
    return "i32*"
}

// exprMakeLLType infers the LLVM type of a make() expression.
fn exprMakeLLType(cg: *CodeGen, e: ast.Expr) -> string {
    if len(e.makeType) > 0 {
        t := checker.astTypeToType(cg.checker, e.makeType[0])
        return llvmType(cg, t)
    }
    return "i8*"
}

// exprSpreadLLType infers the LLVM element type of a spread expression.
fn exprSpreadLLType(cg: *CodeGen, e: ast.Expr) -> string {
    operandType := exprLLType(cg, e.spreadExpr[0])
    if str.Equal(operandType, "i8*") {
        return "i32"
    }
    if str.EndsWith(operandType, "*") {
        return str.Substr(operandType, 0, str.Len(operandType) - 1)
    }
    return operandType
}

// exprNonNullLLType infers the LLVM type of a nonnull (!) postfix expression.
fn exprNonNullLLType(cg: *CodeGen, e: ast.Expr) -> string {
    innerLL := exprLLType(cg, e.postfixTarget[0])
    if str.EndsWith(innerLL, "*") {
        return str.Substr(innerLL, 0, str.Len(innerLL) - 1)
    }
    return innerLL
}

// isComparisonOp checks if an operator is a comparison operator.
fn isComparisonOp(op: string) -> bool {
    return str.Equal(op, "==") || str.Equal(op, "!=") || str.Equal(op, "<") ||
           str.Equal(op, ">") || str.Equal(op, "<=") || str.Equal(op, ">=")
}
