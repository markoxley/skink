module buf_test

import "std/buf"
import "std/str"
import "std/libc"
import "testing"

// TestNewBuffer checks that a fresh buffer starts empty.
pub fn TestNewBuffer() {
    b := buf.NewBuffer()
    if b.Len() != 0 {
        Errorf("NewBuffer len should be 0")
    }
}

// TestWriteString verifies appending a string to the buffer.
pub fn TestWriteString() {
    b := buf.NewBuffer()
    b.WriteString("hello")
    if b.Len() != 5 {
        Errorf("WriteString len failed")
    }
    s := b.String()
    if str.Equal(s, "hello") == false {
        Errorf("WriteString content failed")
    }
}

// TestWriteByte verifies appending a single byte to the buffer.
pub fn TestWriteByte() {
    b := buf.NewBuffer()
    b.WriteByte(65) // 'A'
    if b.Len() != 1 {
        Errorf("WriteByte len failed")
    }
    s := b.String()
    if str.Equal(s, "A") == false {
        Errorf("WriteByte content failed")
    }
}

// TestWriteInt verifies appending an integer's decimal representation.
pub fn TestWriteInt() {
    b := buf.NewBuffer()
    b.WriteInt(42)
    if b.Len() != 2 {
        Errorf("WriteInt len failed")
    }
    s := b.String()
    if str.Equal(s, "42") == false {
        Errorf("WriteInt content failed")
    }
}

// TestReset checks that Reset clears the buffer length.
pub fn TestReset() {
    b := buf.NewBuffer()
    b.WriteString("hello")
    b.Reset()
    if b.Len() != 0 {
        Errorf("Reset len failed")
    }
}

// TestMultipleWrites verifies that successive writes accumulate correctly.
pub fn TestMultipleWrites() {
    b := buf.NewBuffer()
    b.WriteString("hello")
    b.WriteString(" world")
    s := b.String()
    if str.Equal(s, "hello world") == false {
        Errorf("MultipleWrites content failed")
    }
}

// TestReadWrite verifies Buffer implements Reader and Writer templates.
pub fn TestReadWrite() {
    b := buf.NewBuffer()
    n := b.Write("hello", 5)
    if n != 5 {
        Errorf("Buffer.Write should return bytes written")
    }
    out := libc.malloc(10)
    r := b.Read(out, 3)
    if r != 3 {
        Errorf("Buffer.Read should return bytes read")
    }
    if b.Len() != 2 {
        Errorf("Buffer.Read should consume bytes")
    }
    b.Free()
    libc.free(out)
}

// TestReadAll verifies Buffer.Read empties the buffer.
pub fn TestReadAll() {
    b := buf.NewBuffer()
    b.WriteString("abc")
    out := libc.malloc(10)
    r := b.Read(out, 10)
    if r != 3 {
        Errorf("Buffer.Read should return available bytes")
    }
    if b.Len() != 0 {
        Errorf("Buffer should be empty after reading all")
    }
    b.Free()
    libc.free(out)
}

// --- VULN-11 security regressions ---

var btPanicMsg: string

// btSavePanic captures the panic message recovered inside btInvoke.
fn btSavePanic(s: string) { btPanicMsg = s }

// btInvoke runs f inside a recoverable frame.
fn btInvoke(f: fn()) {
    defer fn() { btSavePanic(recover()) }()
    f()
}

// btExpectPanic asserts that f panics (VULN-11 converts the old silent
// ensureCap early-return — a guaranteed heap overflow — into a panic).
fn btExpectPanic(f: fn(), what: string) {
    btPanicMsg = ""
    btInvoke(f)
    if str.Len(btPanicMsg) == 0 {
        Errorf("expected panic: " + what)
    }
}

var btBuf = buf.NewBuffer()

fn btWriteNegative() {
    btBuf.Write("abc", -1)
}

fn btWriteOverflow() {
    // len + extra overflows int32 — previously returned silently while
    // Write memcpy'd the full len into insufficient storage (VULN-11).
    // The buffer is pre-filled so len + extra crosses INT_MAX before
    // any memcpy happens; a bare huge `extra` would OOB-read instead.
    btBuf.Write("x", 2147483640)
}

// TestWriteSizeSafety guards VULN-11: negative and overflowing write
// sizes must panic rather than silently corrupt the heap.
pub fn TestWriteSizeSafety() {
    btExpectPanic(btWriteNegative, "buf.Write with negative length")
    // Seed 16 bytes so len + extra overflows int32 inside ensureCap.
    btBuf.Write("0123456789abcdef", 16)
    btExpectPanic(btWriteOverflow, "buf.Write with overflowing length")
    // Ordinary writes still work.
    b := buf.NewBuffer()
    b.Write("hello", 5)
    if b.Len() != 5 {
        Errorf("buf.Write normal case broken")
    }
}
