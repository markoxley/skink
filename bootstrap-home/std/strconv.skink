module strconv

import "std/libc"

extern fn strtod(s: string, endptr: string) -> float

// ParseInt parses a decimal integer string and returns (value, ok).
// Handles optional leading '+' or '-' and leading/trailing whitespace.
// Returns (0, false) if the string is not a valid integer.
pub fn ParseInt(s: string) -> (int, bool) {
    n := int(libc.strlen(s))
    if n == 0 {
        return 0, false
    }
    i := 0
    // Skip leading whitespace.
    for i < n {
        c := int(s[i])
        if c == 32 || c == 9 || c == 10 || c == 13 {
            i = i + 1
        } else {
            break
        }
    }
    if i >= n {
        return 0, false
    }
    negative := false
    if s[i] == 43 { // '+'
        i = i + 1
    } else if s[i] == 45 { // '-'
        negative = true
        i = i + 1
    }
    if i >= n {
        return 0, false
    }
    result := int64(0)
    for i < n {
        c := int(s[i])
        if c < 48 || c > 57 {
            // Trailing whitespace is ok, anything else is an error.
            if c == 32 || c == 9 || c == 10 || c == 13 {
                break
            }
            return 0, false
        }
        digit := int64(c - 48)
        // Check for overflow before multiplying
        maxInt := int64(2147483647)
        if result > (maxInt - digit) / 10 {
            return 0, false
        }
        result = result * 10 + digit
        i = i + 1
    }
    if negative {
        result = -result
    }
    // Check that result fits in int (allow INT_MIN = -2147483648)
    maxInt := int64(2147483647)
    minInt := -maxInt - int64(1)
    if result > maxInt || result < minInt {
        return 0, false
    }
    return int(result), true
}

// ParseInt64 parses a decimal integer string and returns (value, ok).
// Handles optional leading '+' or '-' and leading/trailing whitespace.
// Returns (0, false) if the string is not a valid int64.
pub fn ParseInt64(s: string) -> (int64, bool) {
    n := int(libc.strlen(s))
    if n == 0 {
        return int64(0), false
    }
    i := 0
    // Skip leading whitespace.
    for i < n {
        c := int(s[i])
        if c == 32 || c == 9 || c == 10 || c == 13 {
            i = i + 1
        } else {
            break
        }
    }
    if i >= n {
        return int64(0), false
    }
    negative := false
    if s[i] == 43 { // '+'
        i = i + 1
    } else if s[i] == 45 { // '-'
        negative = true
        i = i + 1
    }
    if i >= n {
        return int64(0), false
    }
    result := int64(0)
    for i < n {
        c := int(s[i])
        if c < 48 || c > 57 {
            // Trailing whitespace is ok, anything else is an error.
            if c == 32 || c == 9 || c == 10 || c == 13 {
                break
            }
            return int64(0), false
        }
        digit := int64(c - 48)
        // Check for overflow before multiplying. Compare against
        // INT64_MAX/10 using division to avoid overflowing the check.
        maxDiv10 := int64(922337203685477580)
        if result > maxDiv10 || (result == maxDiv10 && digit > int64(7)) {
            return int64(0), false
        }
        result = result * 10 + digit
        i = i + 1
    }
    if negative {
        result = -result
    }
    return result, true
}

// ParseFloat parses a decimal floating-point string and returns (value, ok).
// Validates that the string is a proper floating-point number before returning.
pub fn ParseFloat(s: string) -> (float, bool) {
    n := int(libc.strlen(s))
    if n == 0 {
        return 0.0, false
    }
    // Validate: optional sign, digits, optional '.', digits, optional exponent
    i := 0
    // Skip leading whitespace
    for i < n {
        c := int(s[i])
        if c == 32 || c == 9 || c == 10 || c == 13 {
            i = i + 1
        } else {
            break
        }
    }
    if i >= n {
        return 0.0, false
    }
    // Optional sign
    if s[i] == 43 || s[i] == 45 { // '+' or '-'
        i = i + 1
    }
    if i >= n {
        return 0.0, false
    }
    hasDigits := false
    // Integer part
    for i < n {
        c := int(s[i])
        if c >= 48 && c <= 57 {
            hasDigits = true
            i = i + 1
        } else {
            break
        }
    }
    // Fractional part
    if i < n && s[i] == 46 { // '.'
        i = i + 1
        for i < n {
            c := int(s[i])
            if c >= 48 && c <= 57 {
                hasDigits = true
                i = i + 1
            } else {
                break
            }
        }
    }
    if !hasDigits {
        return 0.0, false
    }
    // Exponent part
    if i < n && (s[i] == 101 || s[i] == 69) { // 'e' or 'E'
        i = i + 1
        if i < n && (s[i] == 43 || s[i] == 45) { // '+' or '-'
            i = i + 1
        }
        hasExpDigits := false
        for i < n {
            c := int(s[i])
            if c >= 48 && c <= 57 {
                hasExpDigits = true
                i = i + 1
            } else {
                break
            }
        }
        if !hasExpDigits {
            return 0.0, false
        }
    }
    // Allow trailing whitespace
    for i < n {
        c := int(s[i])
        if c == 32 || c == 9 || c == 10 || c == 13 {
            i = i + 1
        } else {
            return 0.0, false
        }
    }
    // Validation passed; delegate to C strtod for the actual conversion.
    return strtod(s, nil), true
}

// Itoa converts an integer to its decimal string representation.
// The caller owns the returned string.
pub fn Itoa(n: int) -> string {
    if n == 0 {
        s := libc.malloc(2)
        s[0] = 48
        s[1] = 0
        return s
    }
    negative := false
    // Use int64 for the absolute value to handle INT_MIN correctly.
    // The emitter uses sext (sign-extend) for int-to-int64 casts,
    // so negative values are preserved correctly.
    val := int64(n)
    if n < 0 {
        negative = true
        val = -val
    }
    // Count digits.
    tmp := val
    len := 0
    for tmp > 0 {
        len = len + 1
        tmp = tmp / 10
    }
    if negative {
        len = len + 1
    }
    s := libc.malloc(len + 1)
    pos := len - 1
    // Write digits from least significant to most, then reverse by position.
    for val > 0 {
        s[pos] = 48 + int(val % 10)
        val = val / 10
        pos = pos - 1
    }
    if negative {
        s[0] = 45 // '-'
    }
    s[len] = 0
    return s
}

// Itoa64 converts an int64 to its decimal string representation.
// The caller owns the returned string.
pub fn Itoa64(n: int64) -> string {
    if n == int64(0) {
        s := libc.malloc(2)
        s[0] = 48
        s[1] = 0
        return s
    }
    negative := false
    val := n
    if n < int64(0) {
        negative = true
        val = int64(0) - val
    }
    tmp := val
    len := 0
    for tmp > int64(0) {
        len = len + 1
        tmp = tmp / int64(10)
    }
    if negative {
        len = len + 1
    }
    s := libc.malloc(len + 1)
    pos := len - 1
    // Write digits from least significant to most, filling backwards.
    for val > int64(0) {
        s[pos] = 48 + int(val % int64(10))
        val = val / int64(10)
        pos = pos - 1
    }
    if negative {
        s[0] = 45 // '-'
    }
    s[len] = 0
    return s
}

// FormatFloat converts a float to its decimal string representation with
// the specified number of digits after the decimal point.
// The caller owns the returned string.
//
// precision is clamped to [0, 340]: it sizes the output buffer, so an
// unbounded value overflowed the old fixed 64-byte buffer (VULN-12).
// 340 exceeds the largest fraction a finite f64 can usefully represent
// (~325 digits). The formatting itself is delegated to snprintf via the
// runtime: the former scale-by-10^precision manual algorithm overflowed
// int64 for precision > ~18.
pub fn FormatFloat(f: float, precision: int) -> string {
    if precision < 0 {
        precision = 0
    }
    if precision > 340 {
        panic("strconv.FormatFloat: precision too large")
    }
    return Skink_format_double_prec(f, precision)
}

// Skink_format_double_prec is the runtime snprintf-probed %.*f
// formatter used by FormatFloat and fmt's formatFloatPrec.
extern fn Skink_format_double_prec(v: float, precision: int) -> string

// ParseBool parses a string as a boolean. Returns (value, ok).
// Accepts "true"/"false" (case-insensitive) and "1"/"0".
pub fn ParseBool(s: string) -> (bool, bool) {
    if strEq(s, "true") || strEq(s, "1") {
        return true, true
    }
    if strEq(s, "false") || strEq(s, "0") {
        return false, true
    }
    return false, false
}

// strEq compares two strings for equality.
fn strEq(a: string, b: string) -> bool {
    return libc.strcmp(a, b) == 0
}
