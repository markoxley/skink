module tagged_union_test

import "testing"

enum Shape {
    Circle(float)
    Rectangle(float, float)
    Triangle(float, float, float)
}

fn area(s: Shape) -> float {
    return match s {
        Circle(r) => 3.14159 * r * r
        Rectangle(w, h) => w * h
        Triangle(a, b, c) => {
            p := (a + b + c) / 2.0
            // Heron's formula via math-free approx? use real formula:
            sq := p * (p - a) * (p - b) * (p - c)
            if sq > 0.0 {
                sqrt(sq)
            } else {
                0.0
            }
        }
        _ => 0.0
    }
}

// TestCircleArea verifies tagged union Circle variant area via match.
pub fn TestCircleArea() {
    s := Circle(1.0)
    testing.AssertTrue(area(s) > 3.0 && area(s) < 3.2, "circle area ~pi")
}

// TestRectArea verifies tagged union Rectangle variant area via match.
pub fn TestRectArea() {
    s := Rectangle(3.0, 4.0)
    testing.AssertEqualFloat(12.0, area(s), "rect 3x4")
}

// TestTriangleArea verifies tagged union Triangle variant area via match.
pub fn TestTriangleArea() {
    s := Triangle(3.0, 4.0, 5.0)
    testing.AssertEqualFloat(6.0, area(s), "3-4-5 triangle area")
}
