module xml_getter_test

import "testing"
import "std/xml"

// TestGetElement verifies XML GetElement finds element by tag name.
pub fn TestGetElement() {
    doc, err := xml.Unmarshal("<root><item id=\"1\">hello</item></root>")
    testing.AssertTrue(err.message == "", "unmarshal ok")
    item := xml.GetElement(doc, "item")
    testing.AssertEqualString("item", item.Tag(), "found item tag")
    testing.AssertEqualString("hello", item.Text(), "item text")
    testing.AssertEqualString("1", item.Attr("id"), "item attr")
}

// TestGetElementMissing verifies GetElement returns empty for missing tag.
pub fn TestGetElementMissing() {
    doc, _ := xml.Unmarshal("<root></root>")
    item := xml.GetElement(doc, "nope")
    testing.AssertEqualString("", item.Tag(), "missing element -> empty tag")
}

// TestChildren verifies XML Children returns child elements.
pub fn TestChildren() {
    doc, _ := xml.Unmarshal("<root><a/><b/></root>")
    kids := doc.Children()
    testing.AssertEqualInt(2, len(kids), "two children")
}
