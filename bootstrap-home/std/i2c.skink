module i2c

import "std/errors"
import "std/libc"
import "std/strconv"

extern fn open(path: string, flags: int) -> int
extern fn read(fd: int, buf: string, count: int) -> int
extern fn write(fd: int, buf: string, count: int) -> int
extern fn ioctl(fd: int, request: int64, arg: int64) -> int
extern fn Skink_close_fd(fd: int) -> int

// Linux <linux/i2c-dev.h> slave-address selector ioctl.
pub const I2C_SLAVE = 0x0703

// Bus represents an I2C bus connection to a single slave device.
//
//   - fd:         the kernel file descriptor for /dev/i2c-N (or 1 in
//                 workstation fallback mode; 0 when closed).
//   - deviceAddr: the 7-bit slave address selected via I2C_SLAVE.
//   - hw:         true when fd is a live /dev/i2c-N descriptor.
pub struct Bus {
    fd: int  // the file descriptor
    deviceAddr: int  // the device address
    hw: bool  // whether backed by a real /dev/i2c-N descriptor

    // Write sends len bytes of data to the currently selected slave.
    pub fn Write(self: *Bus, data: string, len: int) -> int {
        if self.hw {
            return write(self.fd, data, len)
        }
        return len
    }

    // Read receives up to len bytes from the currently selected slave.
    // The returned string is heap-allocated and must be freed with libc.free.
    pub fn Read(self: *Bus, len: int) -> (string, errors.Error) {
        buf := libc.malloc(len + 1)
        if self.hw {
            n := read(self.fd, buf, len)
            if n < 0 {
                buf[0] = 0
                return buf, errors.New("i2c read failed")
            }
            buf[n] = 0
            return buf, errors.New("")
        }
        buf[len] = 0
        return buf, errors.New("")
    }

    // WriteReg writes a single byte value to an 8-bit device register.
    pub fn WriteReg(self: *Bus, reg: int, val: int) -> errors.Error {
        if self.hw {
            buf := libc.malloc(2)
            buf[0] = reg & 255
            buf[1] = val & 255
            n := write(self.fd, buf, 2)
            libc.free(buf)
            if n != 2 {
                return errors.New("i2c write register failed")
            }
        }
        return errors.New("")
    }

    // ReadReg writes the 8-bit register address and reads back one byte.
    pub fn ReadReg(self: *Bus, reg: int) -> (int, errors.Error) {
        if self.hw {
            buf := libc.malloc(2)
            buf[0] = reg & 255
            if write(self.fd, buf, 1) != 1 {
                libc.free(buf)
                return 0, errors.New("i2c register select failed")
            }
            if read(self.fd, buf, 1) != 1 {
                libc.free(buf)
                return 0, errors.New("i2c register read failed")
            }
            v := int(uint8(buf[0]))
            libc.free(buf)
            return v, errors.New("")
        }
        return 0, errors.New("")
    }

    // WriteRegister is an alias for WriteReg.
    pub fn WriteRegister(self: *Bus, reg: int, val: int) -> errors.Error {
        return self.WriteReg(reg, val)
    }

    // ReadRegister is an alias for ReadReg.
    pub fn ReadRegister(self: *Bus, reg: int) -> (int, errors.Error) {
        return self.ReadReg(reg)
    }

    // Close releases the bus file descriptor. It is idempotent.
    pub fn Close(self: *Bus) -> errors.Error {
        if self.fd != 0 {
            if self.hw {
                Skink_close_fd(self.fd)
            }
            self.fd = 0
            self.hw = false
        }
        return errors.New("")
    }

    // Address returns the 7-bit slave address this Bus was opened for.
    pub fn Address(self: Bus) -> int {
        return self.deviceAddr
    }

    // Fd returns the underlying kernel file descriptor, or 0 when closed.
    pub fn Fd(self: Bus) -> int {
        return self.fd
    }
}

// Open opens /dev/i2c-{busNumber} and selects the slave at deviceAddr via
// ioctl(I2C_SLAVE). When the device node is absent or inaccessible (e.g.
// on a workstation without I2C permissions), it falls back to an in-memory
// Bus so callers and tests can run without hardware.
pub fn Open(busNumber: int, deviceAddr: int) -> (Bus, errors.Error) {
    if busNumber < 0 || deviceAddr < 0 || deviceAddr > 0x7f {
        return Bus{fd: 0, deviceAddr: deviceAddr, hw: false}, errors.New("invalid i2c bus or address")
    }
    path := "/dev/i2c-" + strconv.Itoa(busNumber)
    fd := open(path, 2) // O_RDWR = 2
    if fd >= 0 {
        if ioctl(fd, int64(I2C_SLAVE), int64(deviceAddr)) < 0 {
            Skink_close_fd(fd)
            return Bus{fd: 0, deviceAddr: deviceAddr, hw: false}, errors.New("ioctl I2C_SLAVE failed")
        }
        return Bus{fd: fd, deviceAddr: deviceAddr, hw: true}, errors.New("")
    }
    return Bus{fd: 1, deviceAddr: deviceAddr, hw: false}, errors.New("")
}

// Standard I2C clock speeds (Hz), for documentation and future SetSpeed support.
pub const SPEED_STANDARD = 100000   // 100 kHz
pub const SPEED_FAST = 400000       // 400 kHz
pub const SPEED_FAST_PLUS = 1000000 // 1 MHz

// I2C_SMBUS ioctl sub-commands for reference (values from <linux/i2c.h>).
pub const SMBUS_READ_BYTE = 1
pub const SMBUS_READ_BYTE_DATA = 2  // the smbus read byte data
pub const SMBUS_WRITE_BYTE_DATA = 3  // the smbus write byte data
pub const SMBUS_READ_WORD_DATA = 4  // the smbus read word data
pub const SMBUS_WRITE_WORD_DATA = 5  // the smbus write word data
