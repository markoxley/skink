module json_test

import "std/json"
import "std/reflect"
import "std/strconv"
import "std/str"
import "testing"

// TestNull verifies the Null constructor.
pub fn TestNull() {
    v := json.Null()
    if json.IsNull(v) == false {
        Errorf("Null value should report IsNull true")
    }
}

// TestBool verifies boolean construction and access.
pub fn TestBool() {
    v := json.FromBool(true)
    if json.AsBool(v) != true {
        Errorf("FromBool(true) should yield true")
    }
    v2 := json.FromBool(false)
    if json.AsBool(v2) != false {
        Errorf("FromBool(false) should yield false")
    }
}

// TestNumber verifies number construction and access.
pub fn TestNumber() {
    v := json.FromNumber(42.0)
    if json.AsNumber(v) != 42.0 {
        Errorf("FromNumber should preserve the value")
    }
}

// TestString verifies string construction and access.
pub fn TestString() {
    v := json.FromString("hello")
    if str.Equal(json.AsString(v), "hello") == false {
        Errorf("FromString should preserve the string")
    }
}

// TestMarshalNull verifies null marshals to "null".
pub fn TestMarshalNull() {
    s := json.MarshalValue(json.Null())
    if str.Equal(s, "null") == false {
        Errorf("Marshal null should be null")
    }
}

// TestMarshalBool verifies boolean marshaling.
pub fn TestMarshalBool() {
    s := json.MarshalValue(json.FromBool(true))
    if str.Equal(s, "true") == false {
        Errorf("Marshal true should be true")
    }
    s2 := json.MarshalValue(json.FromBool(false))
    if str.Equal(s2, "false") == false {
        Errorf("Marshal false should be false")
    }
}

// TestMarshalString verifies string marshaling with quotes.
pub fn TestMarshalString() {
    s := json.MarshalValue(json.FromString("hi"))
    if str.Equal(s, "\"hi\"") == false {
        Errorf("Marshal string should include quotes")
    }
}

// TestUnmarshalNull verifies parsing of null.
pub fn TestUnmarshalNull() {
    v, err := json.Unmarshal("null")
    if err.message != "" {
        Errorf("Unmarshal null should not error")
    }
    if json.IsNull(v) == false {
        Errorf("Unmarshal null should produce null value")
    }
}

// TestUnmarshalBool verifies parsing of booleans.
pub fn TestUnmarshalBool() {
    v, err := json.Unmarshal("true")
    if err.message != "" {
        Errorf("Unmarshal true should not error")
    }
    if json.AsBool(v) != true {
        Errorf("Unmarshal true should yield true")
    }
    v2, err2 := json.Unmarshal("false")
    if err2.message != "" {
        Errorf("Unmarshal false should not error")
    }
    if json.AsBool(v2) != false {
        Errorf("Unmarshal false should yield false")
    }
}

// TestUnmarshalUnicodeEscape guards the \uXXXX decode regression — escape
// sequences previously consumed 'u' and emitted the hex digits as literal
// text ("\u2022" became "2022").
pub fn TestUnmarshalUnicodeEscape() {
    v, err := json.Unmarshal("\"\\u2022 \\u00e9\"")
    if err.message != "" {
        Errorf("Unmarshal \\u escape should not error")
    }
    s := json.AsString(v)
    // U+2022 = e2 80 a2, U+00E9 = c3 a9
    if str.Len(s) != 6 {
        Errorf("expected 6 bytes, got " + strconv.Itoa(str.Len(s)))
    }
    if s[0] != 226 || s[1] != 128 || s[2] != 162 {
        Errorf("expected U+2022 UTF-8 bytes")
    }
    if s[3] != 32 || s[4] != 195 || s[5] != 169 {
        Errorf("expected space + U+00E9 UTF-8 bytes")
    }

    // Surrogate pair: \uD83D\uDE00 = U+1F600 = f0 9f 98 80
    v2, _ := json.Unmarshal("\"\\uD83D\\uDE00\"")
    s2 := json.AsString(v2)
    if str.Len(s2) != 4 || s2[0] != 240 || s2[1] != 159 || s2[2] != 152 || s2[3] != 128 {
        Errorf("expected U+1F600 surrogate-pair decode")
    }

    // Lone surrogate becomes U+FFFD = ef bf bd
    v3, _ := json.Unmarshal("\"\\uD800x\"")
    s3 := json.AsString(v3)
    if str.Len(s3) != 4 || s3[0] != 239 || s3[1] != 191 || s3[2] != 189 || s3[3] != 120 {
        Errorf("expected U+FFFD + 'x' for lone surrogate")
    }
}

// TestUnmarshalNumber verifies parsing of an integer number.
pub fn TestUnmarshalNumber() {
    v, err := json.Unmarshal("123")
    if err.message != "" {
        Errorf("Unmarshal 123 should not error")
    }
    if json.AsNumber(v) != 123.0 {
        Errorf("Unmarshal 123 should yield 123")
    }
}

// TestRoundtripObject verifies marshal-then-unmarshal of a simple object.
pub fn TestRoundtripObject() {
    keys := ["name"]
    vals := [json.FromString("skink")]
    obj := json.FromObject(keys, vals)
    s := json.MarshalValue(obj)
    v2, err := json.Unmarshal(s)
    if err.message != "" {
        Errorf("Unmarshal should not error")
    }
    if json.ObjectLen(v2) != 1 {
        Errorf("Roundtrip object should preserve one key")
    }
    val := json.ObjectGet(v2, "name")
    if str.Equal(json.AsString(val), "skink") == false {
        Errorf("Roundtrip object should preserve string value")
    }
}

// --- MarshalStruct / UnmarshalInto: struct <-> JSON via [json] tags ---

// TaggedUser exercises every [json] flag: rename, ignore, omitempty.
pub struct TaggedUser {
    [json(ignore)]
    id: int64
    [json(name=full_name)]
    name: string
    age: int
    [json(omitempty)]
    nickname: string
    score: float
    active: bool
}

// BadJSON has an unmappable field type; MarshalStruct must reject it.
pub struct BadJSON {
    id: int64
    table: map[string]int
}

// TestMarshalStruct verifies object output honors renames and ignores.
pub fn TestMarshalStruct() {
    var u TaggedUser
    u.id = int64(7)
    u.name = "Ada"
    u.age = 36
    u.nickname = "ace"
    u.score = 9.5
    u.active = true
    s, err := json.MarshalStruct(reflect.TypeOf<TaggedUser>(u), int64(&u))
    if err.message != "" {
        Errorf("MarshalStruct should succeed")
    }
    if str.Contains(s, "full_name") == false {
        Errorf("[json(name=full_name)] should rename the key")
    }
    if str.Contains(s, "\"Ada\"") == false {
        Errorf("marshal should include the name value")
    }
    if str.Contains(s, "id") {
        Errorf("[json(ignore)] field should not appear")
    }
    if str.Contains(s, "nickname") == false {
        Errorf("non-empty omitempty field should appear")
    }
}

// TestMarshalStructOmitEmpty verifies zero-valued omitempty fields drop.
pub fn TestMarshalStructOmitEmpty() {
    var u TaggedUser
    u.name = "x"
    s, err := json.MarshalStruct(reflect.TypeOf<TaggedUser>(u), int64(&u))
    if err.message != "" {
        Errorf("MarshalStruct should succeed")
    }
    if str.Contains(s, "nickname") {
        Errorf("empty omitempty field should be omitted")
    }
    if str.Contains(s, "age") == false {
        Errorf("non-omitempty zero field should still appear")
    }
}

// TestMarshalStructUnsupported verifies unmappable types error out.
pub fn TestMarshalStructUnsupported() {
    var b BadJSON
    _, err := json.MarshalStruct(reflect.TypeOf<BadJSON>(b), int64(&b))
    if err.message == "" {
        Errorf("MarshalStruct should reject a map field")
    }
    if str.Contains(err.message, "table") == false {
        Errorf("error should name the offending field")
    }
}

// TestUnmarshalInto verifies object keys write into struct fields by
// (renamed) name, absent keys leave fields unchanged, unknown JSON
// keys are ignored.
pub fn TestUnmarshalInto() {
    var u TaggedUser
    u.age = 99
    err := json.UnmarshalStruct("{\"full_name\":\"Grace\",\"score\":8.25,\"unknown\":1}", reflect.TypeOf<TaggedUser>(u), int64(&u))
    if err.message != "" {
        Errorf("UnmarshalInto should succeed")
    }
    if str.Equal(u.name, "Grace") == false {
        Errorf("[json(name=full_name)] should map to the name field")
    }
    if u.score != 8.25 {
        Errorf("float field should unmarshal")
    }
    if u.age != 99 {
        Errorf("absent keys should leave fields unchanged")
    }
    if u.id != int64(0) {
        Errorf("[json(ignore)] field should not be set")
    }
}

// TestUnmarshalIntoBad verifies malformed and non-object input errors.
pub fn TestUnmarshalIntoBad() {
    var u TaggedUser
    err := json.UnmarshalStruct("not json", reflect.TypeOf<TaggedUser>(u), int64(&u))
    if err.message == "" {
        Errorf("malformed JSON should error")
    }
    err = json.UnmarshalStruct("[1,2]", reflect.TypeOf<TaggedUser>(u), int64(&u))
    if err.message == "" {
        Errorf("non-object JSON should error")
    }
}

// TestStructRoundTrip verifies marshal then unmarshal restores fields.
pub fn TestStructRoundTrip() {
    var src TaggedUser
    src.name = "Katherine"
    src.age = 41
    src.score = 7.5
    src.active = true
    src.nickname = "kat"
    s, err := json.MarshalStruct(reflect.TypeOf<TaggedUser>(src), int64(&src))
    if err.message != "" {
        Errorf("MarshalStruct should succeed")
    }
    var dst TaggedUser
    err = json.UnmarshalStruct(s, reflect.TypeOf<TaggedUser>(dst), int64(&dst))
    if err.message != "" {
        Errorf("UnmarshalInto should succeed")
    }
    if str.Equal(dst.name, "Katherine") == false || dst.age != 41 ||
        dst.score != 7.5 || dst.active == false ||
        str.Equal(dst.nickname, "kat") == false {
        Errorf("roundtrip should preserve all mapped fields")
    }
}

// TestValueKindAccessor covers the pub Kind() accessor + KIND_* consts
// added so callers can switch on a Value's tag without reaching into
// private fields (modules like skink-mongo map JSON→BSON by kind).
pub fn TestValueKindAccessor() {
    v, err := json.Unmarshal(`{"a":1,"b":"x","c":true,"d":[1],"e":{"f":null}}`)
    if err.message != "" {
        Errorf("unmarshal should succeed")
        return
    }
    AssertEqualInt(json.KIND_OBJECT, json.Kind(v), "object kind")
    AssertEqualInt(json.KIND_NUMBER, json.Kind(json.ObjectGet(v, "a")), "number kind")
    AssertEqualInt(json.KIND_STRING, json.Kind(json.ObjectGet(v, "b")), "string kind")
    AssertEqualInt(json.KIND_BOOL, json.Kind(json.ObjectGet(v, "c")), "bool kind")
    AssertEqualInt(json.KIND_ARRAY, json.Kind(json.ObjectGet(v, "d")), "array kind")
    e := json.ObjectGet(v, "e")
    f := json.ObjectGet(e, "f")
    AssertEqualInt(json.KIND_NULL, json.Kind(f), "null kind")
}

// --- Recursive struct marshal/unmarshal (nested, slices, pointers) ---
// Guards the reflect.Field.typ metadata path added so json.Marshal and
// json.UnmarshalInto recurse through struct-valued fields.

// NestedAddr is a nested-struct target for recursion tests.
pub struct NestedAddr {
    city: string
    zip: int
}

// RecursiveUser exercises nested structs, slices of scalars, slices of
// structs, pointers, narrow integers, and byte buffers in one shape.
pub struct RecursiveUser {
    name: string
    addr: NestedAddr
    scores: []int
    tags: []string
    prev: []NestedAddr
    manager: *NestedAddr
    level: int8
    code: int16
    blob: []byte
}

// TestMarshalNested guards the nested-struct recursion regression —
// json.Marshal must emit the inner object inline, not error.
pub fn TestMarshalNested() {
    var u RecursiveUser
    u.name = "Neo"
    u.addr.city = "Zion"
    u.addr.zip = 10101
    u.level = int8(3)
    u.code = int16(7)
    s, err := json.MarshalStruct(reflect.TypeOf<RecursiveUser>(u), int64(&u))
    if err.message != "" {
        Errorf("Marshal with nested struct should succeed")
        return
    }
    if str.Contains(s, "\"addr\":{\"city\":\"Zion\",\"zip\":10101}") == false {
        Errorf("nested struct should marshal as an inline object")
    }
    if str.Contains(s, "\"level\":3") == false {
        Errorf("int8 field should marshal")
    }
    if str.Contains(s, "\"code\":7") == false {
        Errorf("int16 field should marshal")
    }
    if str.Contains(s, "\"manager\":null") == false {
        Errorf("nil pointer field should marshal as null")
    }
    if str.Contains(s, "\"scores\":[]") == false {
        Errorf("empty slice should marshal as []")
    }
}

// TestMarshalSliceFields guards the slice-field regression — []int,
// []string, and []struct elements all marshal as JSON arrays.
pub fn TestMarshalSliceFields() {
    var u RecursiveUser
    u.scores = append(u.scores, 10)
    u.scores = append(u.scores, 20)
    u.tags = append(u.tags, "x")
    var a NestedAddr
    a.city = "c1"
    u.prev = append(u.prev, a)
    s, err := json.MarshalStruct(reflect.TypeOf<RecursiveUser>(u), int64(&u))
    if err.message != "" {
        Errorf("Marshal with slices should succeed")
        return
    }
    if str.Contains(s, "\"scores\":[10,20]") == false {
        Errorf("[]int should marshal as a number array")
    }
    if str.Contains(s, "\"tags\":[\"x\"]") == false {
        Errorf("[]string should marshal as a string array")
    }
    if str.Contains(s, "\"prev\":[{\"city\":\"c1\",\"zip\":0}]") == false {
        Errorf("[]struct should marshal as an object array")
    }
}

// TestUnmarshalNestedRoundTrip guards the full recursive round trip —
// nested objects, slices, pointer fields, and byte buffers must come
// back identical after Marshal + UnmarshalInto.
pub fn TestUnmarshalNestedRoundTrip() {
    var src RecursiveUser
    src.name = "Trinity"
    src.addr.city = "Metro"
    src.addr.zip = 555
    src.scores = append(src.scores, 3)
    src.scores = append(src.scores, 14)
    src.tags = append(src.tags, "ops")
    var p NestedAddr
    p.city = "HQ"
    p.zip = 9
    src.prev = append(src.prev, p)
    var m NestedAddr
    m.city = "Mgmt"
    src.manager = &m
    src.level = int8(9)
    src.code = int16(640)
    s, err := json.MarshalStruct(reflect.TypeOf<RecursiveUser>(src), int64(&src))
    if err.message != "" {
        Errorf("marshal should succeed")
        return
    }
    var dst RecursiveUser
    err = json.UnmarshalStruct(s, reflect.TypeOf<RecursiveUser>(dst), int64(&dst))
    if err.message != "" {
        Errorf("UnmarshalInto should succeed on nested input")
        return
    }
    if str.Equal(dst.addr.city, "Metro") == false || dst.addr.zip != 555 {
        Errorf("nested struct should round-trip")
    }
    if len(dst.scores) != 2 || dst.scores[1] != 14 {
        Errorf("[]int should round-trip")
    }
    if len(dst.tags) != 1 || str.Equal(dst.tags[0], "ops") == false {
        Errorf("[]string should round-trip")
    }
    if len(dst.prev) != 1 || str.Equal(dst.prev[0].city, "HQ") == false || dst.prev[0].zip != 9 {
        Errorf("[]struct should round-trip")
    }
    if dst.manager == nil || str.Equal(dst.manager.city, "Mgmt") == false {
        Errorf("pointer field should round-trip")
    }
    if dst.level != int8(9) || dst.code != int16(640) {
        Errorf("narrow int fields should round-trip")
    }
}

// TestUnmarshalNullPointer guards the explicit-null pointer regression:
// JSON null must nil out a previously-set pointer field.
pub fn TestUnmarshalNullPointer() {
    var u RecursiveUser
    var m NestedAddr
    u.manager = &m
    err := json.UnmarshalStruct("{\"manager\":null}", reflect.TypeOf<RecursiveUser>(u), int64(&u))
    if err.message != "" {
        Errorf("unmarshal should succeed")
    }
    if u.manager != nil {
        Errorf("JSON null should nil the pointer field")
    }
}


// TestMarshalAutoAPI covers the pointer-only Marshal(&obj) entry point:
// T must be inferred as the pointee type so Marshal(&u) resolves to the
// monomorphized json.Marshal__TaggedUser clone (previously an
// emitter-side auto-injection synthesized reflect.Type+ptr).
pub fn TestMarshalAutoAPI() {
    var u TaggedUser
    u.name = "Ada"
    u.age = 36
    u.score = 9.5
    u.active = true
    s, err := json.Marshal(&u)
    if err.message != "" {
        Errorf("Marshal(&u) should succeed")
    }
    v, perr := json.Unmarshal(s)
    if perr.message != "" {
        Errorf("Marshal(&u) output should parse")
    }
    if str.Equal(json.AsString(json.ObjectGet(v, "full_name")), "Ada") == false {
        Errorf("Marshal(&u) should apply the name= tag")
    }
    if json.AsNumber(json.ObjectGet(v, "age")) != 36 {
        Errorf("Marshal(&u) should emit the age field")
    }
}

// TestUnmarshalIntoAutoAPI covers UnmarshalInto(data, &obj) — the
// two-argument pointer form must infer T from &obj (distinct from the
// tree parser json.Unmarshal, which stays one-argument returning a
// Value).
pub fn TestUnmarshalIntoAutoAPI() {
    var u TaggedUser
    err := json.UnmarshalInto("{\"full_name\":\"Alan\",\"age\":41,\"active\":true}", &u)
    if err.message != "" {
        Errorf("UnmarshalInto(s, &u) should succeed")
    }
    if str.Equal(u.name, "Alan") == false || u.age != 41 || u.active == false {
        Errorf("UnmarshalInto(s, &u) should populate fields")
    }
}

// TestMarshalExplicitTypeArgs covers the explicit generic spelling
// json.Marshal<TaggedUser>(&u) — the same clone the inferred call
// resolves to — guarding that both type-argument syntaxes instantiate
// the marshal entry point.
pub fn TestMarshalExplicitTypeArgs() {
    var u TaggedUser
    u.name = "Bo"
    u.age = 29
    s, err := json.Marshal<TaggedUser>(&u)
    if err.message != "" {
        Errorf("Marshal<TaggedUser>(&u) should succeed")
    }
    v, perr := json.Unmarshal(s)
    if perr.message != "" {
        Errorf("Marshal<TaggedUser>(&u) output should parse")
    }
    if str.Equal(json.AsString(json.ObjectGet(v, "full_name")), "Bo") == false {
        Errorf("Marshal<TaggedUser>(&u) should apply the name= tag")
    }
    var u2 TaggedUser
    err2 := json.UnmarshalInto<TaggedUser>("{\"full_name\":\"Cy\",\"age\":12}", &u2)
    if err2.message != "" {
        Errorf("UnmarshalInto<TaggedUser>(s, &u2) should succeed")
    }
    if str.Equal(u2.name, "Cy") == false || u2.age != 12 {
        Errorf("UnmarshalInto<TaggedUser>(s, &u2) should populate fields")
    }
}

// TestAutoAPIRoundTrip exercises Marshal(&obj) + UnmarshalInto(&obj)
// over nested structs, slices, and pointers (the RecursiveUser shape).
pub fn TestAutoAPIRoundTrip() {
    var src RecursiveUser
    src.name = "boss"
    src.level = 3
    var mgr NestedAddr
    mgr.city = "london"
    mgr.zip = 1234
    src.manager = &mgr
    src.tags = append(src.tags, "a")
    src.tags = append(src.tags, "b")
    s, err := json.Marshal(&src)
    if err.message != "" {
        Errorf("Marshal(&src) should succeed")
    }
    var dst RecursiveUser
    err = json.UnmarshalInto(s, &dst)
    if err.message != "" {
        Errorf("UnmarshalInto(s, &dst) should succeed")
    }
    if str.Equal(dst.name, "boss") == false || dst.level != 3 {
        Errorf("round trip should preserve scalars")
    }
    if dst.manager == nil || str.Equal(dst.manager.city, "london") == false || dst.manager.zip != 1234 {
        Errorf("round trip should preserve nested pointer struct")
    }
    if len(dst.tags) != 2 || str.Equal(dst.tags[1], "b") == false {
        Errorf("round trip should preserve the slice field")
    }
}
