module testing_test

import "testing"

// TestAssertTruePass verifies AssertTrue passes for true.
pub fn TestAssertTruePass() {
    Reset()
    AssertTrue(true, "true should pass")
    if Failed() {
        Errorf("AssertTrue(true) should not fail")
    }
}

// TestAssertTrueFail verifies AssertTrue fails for false.
pub fn TestAssertTrueFail() {
    Reset()
    AssertTrue(false, "false should fail")
    if Failed() == false {
        Errorf("AssertTrue(false) should fail")
    }
    Reset()
}

// TestAssertFalsePass verifies AssertFalse passes for false.
pub fn TestAssertFalsePass() {
    Reset()
    AssertFalse(false, "false should pass")
    if Failed() {
        Errorf("AssertFalse(false) should not fail")
