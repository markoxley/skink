// TestFail verifies Fail sets the failed flag.
pub fn TestFail() {
    Reset()
    Fail()
    if Failed() == false {
        Errorf("Fail should set failed flag")
    }
    Reset()
}

// TestReset verifies Reset clears the failed flag.
pub fn TestReset() {
    Fail()
    Reset()
    if Failed() {
        Errorf("Reset should clear failed flag")
    }
}

// TestPassCountIncremented verifies that passCount is incremented by
// successful assertions.
pub fn TestPassCountIncremented() {
    Reset()
    before := PassCount()
    AssertTrue(true, "should pass")
    after := PassCount()
    if after <= before {
        Errorf("PassCount should increment after a passing assertion")
    }
}

// TestFailCountIncremented verifies that failCount is incremented by
// failed assertions.
pub fn TestFailCountIncremented() {
    Reset()
    before := FailCount()
    AssertTrue(false, "should fail")
    after := FailCount()
    if after <= before {
        Errorf("FailCount should increment after a failing assertion")
    }
    Reset()
}

// TestTestCountIncremented verifies that testCount is incremented by
// every assertion (pass or fail).
pub fn TestTestCountIncremented() {
    Reset()
    before := TestCount()
    AssertTrue(true, "should pass")
    AssertTrue(false, "should fail")
    after := TestCount()
    if after < before + 2 {
        Errorf("TestCount should increment for each assertion")
    }
    Reset()
}

// TestFailNowExists verifies that FailNow is a callable function.
// We cannot actually call FailNow() here because it aborts the process
// (which is the intended behavior for early-exit). This test merely
// confirms the function is linked by referencing it in a way that
// forces the linker to include it.
pub fn TestFailNowExists() {
    // FailNow aborts the process, so we only verify it's linked.
    // We use a conditional that's always false to avoid calling it.
    if false {
        FailNow()
    }
}
