module power_test

import "testing"

// TestIntPower verifies integer exponentiation operator **.
pub fn TestIntPower() {
    testing.AssertEqualInt(8, 2**3, "2**3 == 8")
    testing.AssertEqualInt(1, 5**0, "5**0 == 1")
    testing.AssertEqualInt(16, 4**2, "4**2 == 16")
    testing.AssertEqualInt(27, 3**3, "3**3 == 27")
    testing.AssertEqualInt(1000000, 10**6, "10**6 == 1000000")
}

// TestFloatPower verifies float exponentiation including fractional exponents.
pub fn TestFloatPower() {
    v := 2.0**10.0
    if v != 1024.0 {
        testing.Fail()
    }
    v2 := 9.0**0.5
    if v2 != 3.0 {
        testing.Fail()
    }
}

// TestRightAssociativity verifies ** is right-associative.
pub fn TestRightAssociativity() {
    // 2**3**2 should be 2**(3**2) = 2**9 = 512, not (2**3)**2 = 64
    testing.AssertEqualInt(512, 2**3**2, "2**3**2 == 512 (right-assoc)")
}

// TestPowerInExpression verifies ** precedence in larger expressions.
pub fn TestPowerInExpression() {
    // 2 + 3**2 should be 2 + 9 = 11
    testing.AssertEqualInt(11, 2 + 3**2, "2 + 3**2 == 11")
    // 2**3 * 3 should be 8 * 3 = 24
    testing.AssertEqualInt(24, 2**3 * 3, "2**3 * 3 == 24")
}
