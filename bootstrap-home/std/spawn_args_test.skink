module spawn_args_test

import "testing"
import "std/waitgroup"
import "std/str"

var saSum: int
var saGot: string

fn addTwo(a: int, b: int, wg: *waitgroup.WaitGroup) {
    defer wg.Done()
    saSum = a + b
}

fn echoIt(s: string, wg: *waitgroup.WaitGroup) {
    defer wg.Done()
    saGot = s
}

// TestSpawnMultiArg verifies spawn passes multiple int args correctly.
pub fn TestSpawnMultiArg() {
    wg := waitgroup.New()
    wg.Add(1)
    spawn addTwo(20, 22, &wg)
    wg.Wait()
    testing.AssertEqualInt(42, saSum, "spawned fn received both ints")
}

// TestSpawnHeapArg verifies spawn passes heap-allocated string arg.
pub fn TestSpawnHeapArg() {
    saGot = ""
    wg := waitgroup.New()
    wg.Add(1)
    spawn echoIt("heap string arg", &wg)
    wg.Wait()
    testing.AssertEqualString("heap string arg", saGot, "string arg survives spawn")
}
