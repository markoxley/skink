module slice_test

import "testing"

// TestArraySliceLowHigh verifies slice with low and high bounds.
pub fn TestArraySliceLowHigh() {
    arr := []int{1, 2, 3, 4, 5}
    sub := arr[1:3]
    testing.AssertEqualInt(2, len(sub), "arr[1:3] len")
    testing.AssertEqualInt(2, sub[0], "arr[1:3][0]")
    testing.AssertEqualInt(3, sub[1], "arr[1:3][1]")
}

// TestArraySliceHighOnly verifies slice with high bound only.
pub fn TestArraySliceHighOnly() {
    arr := []int{10, 20, 30, 40, 50}
    sub := arr[:3]
    testing.AssertEqualInt(3, len(sub), "arr[:3] len")
    testing.AssertEqualInt(10, sub[0], "arr[:3][0]")
    testing.AssertEqualInt(30, sub[2], "arr[:3][2]")
}

// TestArraySliceLowOnly verifies slice with low bound only.
pub fn TestArraySliceLowOnly() {
    arr := []int{10, 20, 30, 40, 50}
    sub := arr[2:]
    testing.AssertEqualInt(3, len(sub), "arr[2:] len")
    testing.AssertEqualInt(30, sub[0], "arr[2:][0]")
    testing.AssertEqualInt(50, sub[2], "arr[2:][2]")
}

// TestStringSlice verifies string slicing with low and high bounds.
pub fn TestStringSlice() {
    s := "Hello World"
    sub := s[0:5]
    testing.AssertEqualInt(5, len(sub), "s[0:5] len")
    sub2 := s[6:11]
    testing.AssertEqualInt(5, len(sub2), "s[6:11] len")
}

// TestStringSliceHighOnly verifies string slice with high bound only.
pub fn TestStringSliceHighOnly() {
    s := "Hello World"
    sub := s[:5]
    testing.AssertEqualInt(5, len(sub), "s[:5] len")
}

// TestStringSliceLowOnly verifies string slice with low bound only.
pub fn TestStringSliceLowOnly() {
    s := "Hello World"
    sub := s[6:]
    testing.AssertEqualInt(5, len(sub), "s[6:] len")
}

// TestFullSlice verifies full slice arr[0:len] copies all elements.
pub fn TestFullSlice() {
    arr := []int{1, 2, 3}
    sub := arr[0:3]
    testing.AssertEqualInt(3, len(sub), "arr[0:3] len")
    testing.AssertEqualInt(1, sub[0], "arr[0:3][0]")
    testing.AssertEqualInt(3, sub[2], "arr[0:3][2]")
}
