module yaml

import "std/str"
import "std/errors"

// Value is a dynamic YAML value that can represent scalar, sequence,
// or mapping types. Use the kind field to determine the active type.
pub struct Value {
    kind: int
    strVal: string
    numVal: float
    boolVal: bool
    arr: []Value
    objKeys: []string
    objVals: []Value
}

// zeroValue returns a YAML Value initialized to the null kind.
fn zeroValue() -> Value {
    var emptyStr string
    var emptyArr []Value
    var emptyKeys []string
    var emptyVals []Value
    return Value{kind: 0, strVal: emptyStr, numVal: 0.0, boolVal: false, arr: emptyArr, objKeys: emptyKeys, objVals: emptyVals}
}

// Null creates a YAML Value representing a null/empty scalar.
pub fn Null() -> Value {
    return zeroValue()
}

// FromBool creates a YAML Value representing a boolean scalar.
pub fn FromBool(b: bool) -> Value {
    v := zeroValue()
    v.kind = 1
    v.boolVal = b
    return v
}

// FromNumber creates a YAML Value representing a numeric scalar.
pub fn FromNumber(n: float) -> Value {
    v := zeroValue()
    v.kind = 2
    v.numVal = n
    return v
}

// FromString creates a YAML Value representing a string scalar.
pub fn FromString(s: string) -> Value {
    v := zeroValue()
    v.kind = 3
    v.strVal = s
    return v
}

// FromArray creates a YAML Value representing a sequence of Values.
pub fn FromArray(arr: []Value) -> Value {
    v := zeroValue()
    v.kind = 4
    v.arr = arr
    return v
}

// FromObject creates a YAML Value representing a mapping with the given
// parallel key and value slices.
pub fn FromObject(keys: []string, vals: []Value) -> Value {
    v := zeroValue()
    v.kind = 5
    v.objKeys = keys
    v.objVals = vals
    return v
}

// IsNull returns true if the Value represents a YAML null.
pub fn IsNull(v: Value) -> bool {
    return v.kind == 0
}

// AsBool extracts the boolean value from a Value of kind 1.
pub fn AsBool(v: Value) -> bool {
    return v.boolVal
}

// AsNumber extracts the floating-point value from a Value of kind 2.
pub fn AsNumber(v: Value) -> float {
    return v.numVal
}

// AsString extracts the string value from a Value of kind 3.
pub fn AsString(v: Value) -> string {
    return v.strVal
}

// ArrayLen returns the number of elements in a YAML sequence Value.
pub fn ArrayLen(v: Value) -> int {
    return len(v.arr)
}

// ArrayGet returns the element at index i in a YAML sequence Value.
pub fn ArrayGet(v: Value, i: int) -> Value {
    return v.arr[i]
}

// ObjectLen returns the number of key-value pairs in a YAML mapping Value.
pub fn ObjectLen(v: Value) -> int {
    return len(v.objKeys)
}

// ObjectGet looks up a key in a YAML mapping Value, returning Null if not found.
pub fn ObjectGet(v: Value, key: string) -> Value {
    for i := 0; i < len(v.objKeys); i = i + 1 {
        if v.objKeys[i] == key {
            return v.objVals[i]
        }
    }
    // Key not found; return null sentinel
    return Null()
}

// ObjectGetByIndex returns the key and value at index i in a YAML mapping Value.
pub fn ObjectGetByIndex(v: Value, i: int) -> (string, Value) {
    return v.objKeys[i], v.objVals[i]
}

// --- Marshal ---

// MarshalValue serializes a Value into a YAML string with indentation.
pub fn MarshalValue(v: Value) -> string {
    return marshalValueInternal(v, 0)
}

// marshalValueInternal dispatches serialization by Value kind at the given indent.
fn marshalValueInternal(v: Value, indent: int) -> string {
    if v.kind == 0 {
        return "null"
    }
    if v.kind == 1 {
        if v.boolVal {
            return "true"
        }
        return "false"
    }
    if v.kind == 2 {
        return floatToString(v.numVal)
    }
    if v.kind == 3 {
        return v.strVal
    }
    if v.kind == 4 {
        return marshalArray(v.arr, indent)
    }
    if v.kind == 5 {
        return marshalObject(v.objKeys, v.objVals, indent)
    }
    return ""
}

// marshalArray serializes a sequence with "- " item prefixes at the given indent.
fn marshalArray(arr: []Value, indent: int) -> string {
    res := ""
    prefix := indentString(indent)
    n := len(arr)
    for i := 0; i < n; i = i + 1 {
        res = str.Concat(res, prefix)
        res = str.Concat(res, "- ")
        item := marshalValueInternal(arr[i], indent + 2)
        res = str.Concat(res, item)
        res = str.Concat(res, "\n")
    }
    return res
}

// marshalObject serializes a mapping with "key: value" pairs at the given
// indent. Nested collections are placed on the following lines with deeper
// indentation.
fn marshalObject(keys: []string, vals: []Value, indent: int) -> string {
    res := ""
    prefix := indentString(indent)
    n := len(keys)
    for i := 0; i < n; i = i + 1 {
        res = str.Concat(res, prefix)
        res = str.Concat(res, keys[i])
        res = str.Concat(res, ": ")
        val := vals[i]
        if val.kind == 5 || val.kind == 4 {
            // Nested collection: emit newline then indented child block
            res = str.Concat(res, "\n")
            item := marshalValueInternal(val, indent + 2)
            res = str.Concat(res, item)
        } else {
            // Inline scalar value
            item := marshalValueInternal(val, 0)
            res = str.Concat(res, item)
        }
        res = str.Concat(res, "\n")
    }
    return res
}

// indentString returns a string of n space characters for YAML indentation.
fn indentString(n: int) -> string {
    res := ""
    for i := 0; i < n; i = i + 1 {
        res = str.Concat(res, " ")
    }
    return res
}

// floatToString converts a float to its YAML string representation.
fn floatToString(n: float) -> string {
    if n == 0.0 {
        return "0"
    }
    neg := false
    if n < 0.0 {
        neg = true
        n = -n
    }
    intPart := int(n)
    res := intToString(intPart)
    if neg {
        res = str.Concat("-", res)
    }
    return res
}

// intToString converts a non-negative integer to its decimal string form.
fn intToString(n: int) -> string {
    if n == 0 {
        return "0"
    }
    neg := false
    if n < 0 {
        neg = true
        n = -n
    }
    res := ""
    // Extract digits from least to most significant
    for n > 0 {
        d := n % 10
        res = str.Concat(charForDigit(d), res)
        n = n / 10
    }
    if neg {
        res = str.Concat("-", res)
    }
    return res
}

// charForDigit returns the single-character string for digit 0-9.
fn charForDigit(d: int) -> string {
    if d == 0 { return "0" }
    if d == 1 { return "1" }
    if d == 2 { return "2" }
    if d == 3 { return "3" }
    if d == 4 { return "4" }
    if d == 5 { return "5" }
    if d == 6 { return "6" }
    if d == 7 { return "7" }
    if d == 8 { return "8" }
    return "9"
}

// --- Unmarshal ---

// Unmarshal parses a YAML string into a Value. It supports scalars,
// sequences (lines starting with "-"), and mappings ("key: value").
// Returns an error if the input exceeds 100,000 lines (DoS protection).
pub fn Unmarshal(s: string) -> (Value, errors.Error) {
    lines := str.Split(s, "\n")
    n := len(lines)
    if n == 0 {
        return Null(), errors.New("")
    }
    // DoS protection: reject excessively many lines
    if n > 100000 {
        return Null(), errors.New("YAML input too large: exceeds 100000 lines")
    }
    // Check if first line looks like an array (starts with -)
    first := trimLeft(lines[0])
    if str.Len(first) > 0 && first[0] == 45 {
        return parseArrayLines(lines, 0, n, 0), errors.New("")
    }
    // If single line without a colon, treat as scalar
    if n == 1 {
        if str.Len(first) > 0 {
            // Check for a colon to distinguish scalar from mapping
            hasColon := false
            for j := 0; j < str.Len(first); j = j + 1 {
                if first[j] == 58 {
                    hasColon = true
                    break
                }
            }
            if !hasColon {
                return parseScalar(first), errors.New("")
            }
        } else {
            return Null(), errors.New("")
        }
    }
    return parseObjectLines(lines, 0, n, 0), errors.New("")
}

// trimLeft removes leading spaces and tabs from s.
fn trimLeft(s: string) -> string {
    i := 0
    for i < str.Len(s) && (s[i] == 32 || s[i] == 9) {
        i = i + 1
    }
    return str.Substr(s, i, str.Len(s) - i)
}

// countIndent returns the number of leading spaces and tabs in s.
fn countIndent(s: string) -> int {
    i := 0
    for i < str.Len(s) && (s[i] == 32 || s[i] == 9) {
        i = i + 1
    }
    return i
}

// parseScalar interprets a trimmed string as null, bool, number, or string.
fn parseScalar(s: string) -> Value {
    trimmed := trimLeft(s)
    // Null variants: "null", empty, or "~"
    if str.Equal(trimmed, "null") || str.Equal(trimmed, "") || str.Equal(trimmed, "~") {
        return Null()
    }
    // Boolean true variants (case-insensitive)
    if str.Equal(trimmed, "true") || str.Equal(trimmed, "True") || str.Equal(trimmed, "TRUE") {
        return FromBool(true)
    }
    // Boolean false variants (case-insensitive)
    if str.Equal(trimmed, "false") || str.Equal(trimmed, "False") || str.Equal(trimmed, "FALSE") {
        return FromBool(false)
    }
    // Try parse number
    n := parseInt(trimmed)
    if n != 0 || (str.Len(trimmed) > 0 && trimmed[0] == 48) {
        return FromNumber(float(n))
    }
    // Fall back to string
    return FromString(trimmed)
}

// parseInt parses a string of decimal digits (optionally prefixed with '-')
// into an int. Returns 0 if the string is not a valid integer.
fn parseInt(s: string) -> int {
    n := 0
    neg := false
    i := 0
    if i < str.Len(s) && s[i] == 45 {
        neg = true
        i = i + 1
    }
    for i < str.Len(s) {
        c := s[i]
        if c >= 48 && c <= 57 {
            n = n * 10 + int(c - 48)
            i = i + 1
        } else {
            // Non-digit encountered; not a valid integer
            return 0
        }
    }
    if neg {
        n = -n
    }
    return n
}

// parseArrayLines parses a YAML sequence from lines[start:end] at the given
// base indentation level. Items are lines whose trimmed content starts with "-".
fn parseArrayLines(lines: []string, start: int, end: int, baseIndent: int) -> Value {
    // DoS protection: limit nesting depth via indentation
    if baseIndent > 2000 {
        return FromArray([]Value{})
    }
    var arr []Value
    i := start
    for i < end {
        line := lines[i]
        indent := countIndent(line)
        // Stop when indentation decreases below the base level
        if indent < baseIndent && str.Len(trimLeft(line)) > 0 {
            break
        }
        // Skip blank lines
        if str.Len(trimLeft(line)) == 0 {
            i = i + 1
            continue
        }
        trimmed := trimLeft(line)
        if str.Len(trimmed) > 0 && trimmed[0] == 45 {
            // Array item: strip the "- " prefix
            itemStr := str.Substr(trimmed, 1, str.Len(trimmed) - 1)
            itemStr = trimLeft(itemStr)
            // Scan ahead for nested content belonging to this item
            j := i + 1
            for j < end {
                nextLine := lines[j]
                nextIndent := countIndent(nextLine)
                nextTrimmed := trimLeft(nextLine)
                if str.Len(nextTrimmed) == 0 {
                    j = j + 1
                    continue
                }
                // Deeper indentation means nested content
                if nextIndent <= baseIndent {
                    break
                }
                j = j + 1
            }
            if j > i + 1 {
                // Multi-line value: parse as nested object
                val := parseObjectLines(lines, i + 1, j, baseIndent + 2)
                arr = append(arr, val)
            } else {
                // Single-line scalar item
                arr = append(arr, parseScalar(itemStr))
            }
            i = j
        } else {
            i = i + 1
        }
    }
    return FromArray(arr)
}

// parseObjectLines parses a YAML mapping from lines[start:end] at the given
// base indentation level. Keys are separated from values by ":".
fn parseObjectLines(lines: []string, start: int, end: int, baseIndent: int) -> Value {
    // DoS protection: limit nesting depth via indentation
    if baseIndent > 2000 {
        return FromObject([]string{}, []Value{})
    }
    var keys []string
    var vals []Value
    i := start
    for i < end {
        line := lines[i]
        indent := countIndent(line)
        trimmed := trimLeft(line)
        // Skip blank lines
        if str.Len(trimmed) == 0 {
            i = i + 1
            continue
        }
        // Stop when indentation decreases below the base level
        if indent < baseIndent {
            break
        }
        // Find the colon separating key from value
        colonIdx := -1
        for j := 0; j < str.Len(trimmed); j = j + 1 {
            if trimmed[j] == 58 {
                colonIdx = j
                break
            }
        }
        if colonIdx >= 0 {
            key := trimLeft(str.Substr(trimmed, 0, colonIdx))
            valStr := trimLeft(str.Substr(trimmed, colonIdx + 1, str.Len(trimmed) - colonIdx - 1))
            // Scan ahead for nested content belonging to this key
            j := i + 1
            for j < end {
                nextLine := lines[j]
                nextIndent := countIndent(nextLine)
                nextTrimmed := trimLeft(nextLine)
                if str.Len(nextTrimmed) == 0 {
                    j = j + 1
                    continue
                }
                if nextIndent <= baseIndent {
                    break
                }
                j = j + 1
            }
            if j > i + 1 || (str.Len(valStr) == 0 && j > i) {
                // Nested value: determine if it's an array or object
                nextLine := ""
                if i + 1 < end {
                    nextLine = trimLeft(lines[i + 1])
                }
                if str.Len(nextLine) > 0 && nextLine[0] == 45 {
                    // Nested sequence
                    val := parseArrayLines(lines, i + 1, j, baseIndent + 2)
                    vals = append(vals, val)
                } else {
                    // Nested mapping
                    val := parseObjectLines(lines, i + 1, j, baseIndent + 2)
                    // If nested parse produced nothing, fall back to scalar
                    if ObjectLen(val) == 0 && ArrayLen(val) == 0 {
                        val = parseScalar(valStr)
                    }
                    vals = append(vals, val)
                }
                i = j
            } else {
                // Inline scalar value
                vals = append(vals, parseScalar(valStr))
                i = i + 1
            }
            keys = append(keys, key)
        } else {
            // No colon found; skip this line
            i = i + 1
        }
    }
    return FromObject(keys, vals)
}

// --- Legacy entry-based API ---

// Entry is a simple key-value pair used by the legacy entry-based YAML API.
pub struct Entry {
    key: string
    value: string

    // Key returns the entry's key string.
    pub fn Key(self: Entry) -> string {
        return self.key
    }

    // Value returns the entry's value string.
    pub fn Value(self: Entry) -> string {
        return self.value
    }
}

// MarshalEntries serializes parallel key and value slices into a YAML
// mapping string. Only the first n pairs are included.
pub fn MarshalEntries(keys: []string, values: []string, n: int) -> string {
    res := ""
    for i := 0; i < n; i = i + 1 {
        line := str.Concat(keys[i], ": ")
        line = str.Concat(line, values[i])
        line = str.Concat(line, "\n")
        res = str.Concat(res, line)
    }
    return res
}

// UnmarshalEntries parses a YAML mapping string into a slice of Entry pairs.
// Only string values are supported; non-string values yield empty strings.
pub fn UnmarshalEntries(s: string) -> ([]Entry, errors.Error) {
    v, err := Unmarshal(s)
    if err.message != "" {
        var empty []Entry
        return empty, err
    }
    var entries []Entry
    n := ObjectLen(v)
    for i := 0; i < n; i = i + 1 {
        k, val := ObjectGetByIndex(v, i)
        e := Entry{key: k, value: AsString(val)}
        entries = append(entries, e)
    }
    return entries, errors.New("")
}
