module benchmark_test

import "std/benchmark"
import "testing"

// TestNewB verifies benchmark creation.
pub fn TestNewB() {
    b := benchmark.NewB("foo")
    if b.N() != 1 {
        Errorf("NewB default N should be 1")
    }
}

// TestSetN verifies iteration count can be changed.
pub fn TestSetN() {
    b := benchmark.NewB("foo")
    b.SetN(100)
    if b.N() != 100 {
        Errorf("SetN should update iteration count")
    }
}

// TestTimerSmoke verifies StartTimer and StopTimer run without panic.
pub fn TestTimerSmoke() {
    b := benchmark.NewB("foo")
    b.StartTimer()
    b.StopTimer()
    b.Report()
}

// TestElapsed verifies that elapsed time is non-negative after timing.
pub fn TestElapsed() {
    b := benchmark.NewB("foo")
    b.StartTimer()
    b.StopTimer()
    if b.Elapsed() < 0 {
        Errorf("Elapsed should be non-negative")
    }
}

// TestPerOp verifies that PerOp divides elapsed by n.
pub fn TestPerOp() {
    b := benchmark.NewB("foo")
    b.SetN(10)
    b.StartTimer()
    b.StopTimer()
    // PerOp should be elapsed / 10, which is >= 0
    if b.PerOp() < 0 {
        Errorf("PerOp should be non-negative")
    }
}

// TestPerOpZeroN verifies that PerOp returns elapsed when n is 0.
pub fn TestPerOpZeroN() {
    b := benchmark.NewB("foo")
    b.SetN(0)
    b.StartTimer()
    b.StopTimer()
    if b.PerOp() != b.Elapsed() {
        Errorf("PerOp should equal Elapsed when n is 0")
    }
}
