module reflect_test

import "std/reflect"
import "std/str"
import "testing"

// TestTypeOfSize verifies TypeOf returns correct size via sizeof(T).
pub fn TestTypeOfSize() {
    t := reflect.TypeOf<int>(42)
    if t.size != sizeof(int) {
        Errorf("TypeOf<int> size should match sizeof(int)")
    }

    t2 := reflect.TypeOf<int64>(int64(42))
    if t2.size != sizeof(int64) {
        Errorf("TypeOf<int64> size should match sizeof(int64)")
    }
}

struct TestStruct {
    b: bool
    i: int
    i64: int64
    s: string
    f: float
}

// TestFieldEnumeration verifies the compile-time field metadata produced
// by reflect.TypeOf for a struct type, accessed via the TypeName,
// FieldCount, FieldName, FieldType, FieldByIndex and FieldByName helpers.
pub fn TestFieldEnumeration() {
    val := TestStruct{b: true, i: 42, i64: int64(100), s: "hello", f: 3.14}
    t := reflect.TypeOf<TestStruct>(val)

    // Type name should be the unqualified struct name.
    if str.Equal(reflect.TypeName(t), "TestStruct") == false {
        Errorf("TypeName should be TestStruct, got " + reflect.TypeName(t))
    }

    // TestStruct has 5 named fields.
    if reflect.FieldCount(t) != 5 {
        Errorf("FieldCount should be 5")
    }

    // Field names in declaration order.
    if str.Equal(reflect.FieldName(t, 0), "b") == false {
        Errorf("FieldName(0) should be b")
    }
    if str.Equal(reflect.FieldName(t, 1), "i") == false {
        Errorf("FieldName(1) should be i")
    }
    if str.Equal(reflect.FieldName(t, 2), "i64") == false {
        Errorf("FieldName(2) should be i64")
    }
    if str.Equal(reflect.FieldName(t, 3), "s") == false {
        Errorf("FieldName(3) should be s")
    }
    if str.Equal(reflect.FieldName(t, 4), "f") == false {
        Errorf("FieldName(4) should be f")
    }

    // Out-of-range indices return an empty string.
    if str.Equal(reflect.FieldName(t, -1), "") == false {
        Errorf("FieldName(-1) should be empty")
    }
    if str.Equal(reflect.FieldName(t, 5), "") == false {
        Errorf("FieldName(5) should be empty")
    }

    // Field type names looked up by field name.
    if str.Equal(reflect.FieldType(t, "b"), "bool") == false {
        Errorf("FieldType(b) should be bool")
    }
    if str.Equal(reflect.FieldType(t, "i"), "int") == false {
        Errorf("FieldType(i) should be int")
    }
    if str.Equal(reflect.FieldType(t, "i64"), "int64") == false {
        Errorf("FieldType(i64) should be int64")
    }
    if str.Equal(reflect.FieldType(t, "s"), "string") == false {
        Errorf("FieldType(s) should be string")
    }
    if str.Equal(reflect.FieldType(t, "f"), "float") == false {
        Errorf("FieldType(f) should be float")
    }
    // Unknown field name returns an empty string.
    if str.Equal(reflect.FieldType(t, "missing"), "") == false {
        Errorf("FieldType(missing) should be empty")
    }

    // FieldByIndex returns the full descriptor with a valid offset.
    fb := reflect.FieldByIndex(t, 1)
    if str.Equal(fb.name, "i") == false {
        Errorf("FieldByIndex(1).name should be i")
    }
    if str.Equal(fb.type_name, "int") == false {
        Errorf("FieldByIndex(1).type_name should be int")
    }
    if fb.offset < 0 {
        Errorf("FieldByIndex(1).offset should be non-negative")
    }
    // Out-of-range index yields offset -1.
    oob := reflect.FieldByIndex(t, 99)
    if oob.offset != -1 {
        Errorf("FieldByIndex(99).offset should be -1")
    }

    // FieldByName returns the full descriptor.
    fnb := reflect.FieldByName(t, "s")
    if str.Equal(fnb.name, "s") == false {
        Errorf("FieldByName(s).name should be s")
    }
    if str.Equal(fnb.type_name, "string") == false {
        Errorf("FieldByName(s).type_name should be string")
    }
    if fnb.offset < 0 {
        Errorf("FieldByName(s).offset should be non-negative")
    }
    // Unknown name yields offset -1.
    miss := reflect.FieldByName(t, "nope")
    if miss.offset != -1 {
        Errorf("FieldByName(nope).offset should be -1")
    }
}

// TestFieldAccess verifies Get/Set functions via manually created Field descriptors.
pub fn TestFieldAccess() {
    val := TestStruct{b: true, i: 42, i64: int64(100), s: "hello", f: 3.14}
    ptr := int64(&val)

    // bool at offset 0
    fBool := reflect.Field{name: "b", type_name: "bool", offset: 0, tag: ""}
    if reflect.GetBool(ptr, fBool) != true {
        Errorf("Field b should be true")
    }
    reflect.SetBool(ptr, fBool, false)
    if val.b != false {
        Errorf("Field b should have been set to false")
    }

    // int at offset 4 (after bool + 3 padding bytes)
    fInt := reflect.Field{name: "i", type_name: "int", offset: 4, tag: ""}
    if reflect.GetInt(ptr, fInt) != 42 {
        Errorf("Field i should be 42")
    }
    reflect.SetInt(ptr, fInt, 43)
    if val.i != 43 {
        Errorf("Field i should have been set to 43")
    }

    // int64 at offset 8
    fInt64 := reflect.Field{name: "i64", type_name: "int64", offset: 8, tag: ""}
    if reflect.GetInt64(ptr, fInt64) != int64(100) {
        Errorf("Field i64 should be 100")
    }
    reflect.SetInt64(ptr, fInt64, int64(200))
    if val.i64 != int64(200) {
        Errorf("Field i64 should have been set to 200")
    }

    // string at offset 16
    fStr := reflect.Field{name: "s", type_name: "string", offset: 16, tag: ""}
    if str.Equal(reflect.GetString(ptr, fStr), "hello") == false {
        Errorf("Field s should be hello")
    }
    reflect.SetString(ptr, fStr, "world")
    if str.Equal(val.s, "world") == false {
        Errorf("Field s should have been set to world")
    }

    // float at offset 24
    fFloat := reflect.Field{name: "f", type_name: "float", offset: 24, tag: ""}
    if reflect.GetFloat(ptr, fFloat) != 3.14 {
        Errorf("Field f should be 3.14")
    }
    reflect.SetFloat(ptr, fFloat, 2.71)
    if val.f != 2.71 {
        Errorf("Field f should have been set to 2.71")
    }
}

// TestHash verifies reflect.Hash.
pub fn TestHash() {
    s := "hello"
    h1 := reflect.Hash(s, "string")
    h2 := reflect.Hash(s, "string")
    if h1 != h2 {
        Errorf("Hashes of same string should be equal")
    }

    i := 42
    hi := reflect.Hash(string(i), "int")
    if hi < 0 {
        Errorf("Hash should be non-negative")
    }
}

// TaggedStruct exercises C#-style [attr] field annotations stored as tags.
struct TaggedStruct {
    [json(name=first_name)]
    name: string
    [json(name=age_years)] [db(pk)]
    age: int
    untagged: bool
    [experimental]
    flag: bool
    [json(name="quoted_name")]
    quoted: string
    [column(pk)] pub id: int

    // A method on a tagged struct must still parse and run.
    fn Greet(self: *TaggedStruct) -> string {
        return "hi " + self.name
    }
}

// TestFieldTags verifies that [attr]/[attr(args)] annotations above struct
// fields are captured by the parser and surfaced through reflect.TypeOf as
// the Field.tag text — stacked tags joined with a space.
pub fn TestFieldTags() {
    val := TaggedStruct{name: "skink", age: 4, untagged: true, flag: true, quoted: "q", id: 7}
    t := reflect.TypeOf<TaggedStruct>(val)

    if reflect.FieldCount(t) != 6 {
        Errorf("FieldCount should be 6")
    }

    // Tag text reaches reflect verbatim.
    if str.Equal(reflect.FieldTag(t, "name"), "json(name=first_name)") == false {
        Errorf("FieldTag(name) should be json(name=first_name), got " + reflect.FieldTag(t, "name"))
    }

    // Stacked attributes are space-joined.
    if str.Equal(reflect.FieldTag(t, "age"), "json(name=age_years) db(pk)") == false {
        Errorf("FieldTag(age) should join stacked tags, got " + reflect.FieldTag(t, "age"))
    }

    // Bare attribute (no parentheses) is stored as-is.
    if str.Equal(reflect.FieldTag(t, "flag"), "experimental") == false {
        Errorf("FieldTag(flag) should be experimental, got " + reflect.FieldTag(t, "flag"))
    }

    // String arguments keep their quotes.
    if str.Equal(reflect.FieldTag(t, "quoted"), "json(name=\"quoted_name\")") == false {
        Errorf("FieldTag(quoted) should preserve quoted arg, got " + reflect.FieldTag(t, "quoted"))
    }

    // Tags on pub fields land the same way; the field is still accessible.
    if str.Equal(reflect.FieldTag(t, "id"), "column(pk)") == false {
        Errorf("FieldTag(id) should be column(pk), got " + reflect.FieldTag(t, "id"))
    }
    if val.id != 7 {
        Errorf("Tagged pub field should still hold its value")
    }

    // Methods on tagged structs still work.
    if str.Equal(val.Greet(), "hi skink") == false {
        Errorf("Greet on tagged struct should return hi skink")
    }

    // Untagged fields and unknown names both yield an empty string.
    if str.Equal(reflect.FieldTag(t, "untagged"), "") == false {
        Errorf("FieldTag(untagged) should be empty")
    }
    if str.Equal(reflect.FieldTag(t, "nope"), "") == false {
        Errorf("FieldTag(nope) should be empty")
    }

    // The tag also rides along inside Field descriptors.
    fb := reflect.FieldByIndex(t, 0)
    if str.Equal(fb.tag, "json(name=first_name)") == false {
        Errorf("FieldByIndex(0).tag should carry the tag")
    }
    // FieldByIndex on an out-of-range index reports no tag either.
    if str.Equal(reflect.FieldByIndex(t, 99).tag, "") == false {
        Errorf("FieldByIndex(99).tag should be empty")
    }
}

struct InnerStructField {
    x: int
}

struct OuterPtrAndValueStruct {
    inner: InnerStructField
    pinner: *InnerStructField
    pint: *int
}

// TestPointerVsValueStructFields guards comp_error.md #135: reflect.TypeOf
// must preserve the leading "*" on pointer-to-struct field type names so
// callers can distinguish an inline struct field (T) from a pointer field (*T).
pub fn TestPointerVsValueStructFields() {
    var val OuterPtrAndValueStruct
    t := reflect.TypeOf<OuterPtrAndValueStruct>(val)

    fVal := reflect.FieldByName(t, "inner")
    fPtr := reflect.FieldByName(t, "pinner")
    fIntPtr := reflect.FieldByName(t, "pint")

    if reflect.IsPointer(fVal) {
        Errorf("value struct field 'inner' must not be reported as pointer, got " + fVal.type_name)
    }
    if reflect.IsPointer(fPtr) == false {
        Errorf("pointer struct field 'pinner' must have leading '*' in type_name, got " + fPtr.type_name)
    }
    if str.Equal(fVal.type_name, fPtr.type_name) {
        Errorf("value and pointer struct fields must have distinct type_name, both got " + fVal.type_name)
    }
    if str.Equal(reflect.ElemType(fPtr), fVal.type_name) == false {
        Errorf("ElemType(pinner) should equal inner.type_name, got " + reflect.ElemType(fPtr) + " vs " + fVal.type_name)
    }
    if str.Equal(fIntPtr.type_name, "*int") == false || reflect.IsPointer(fIntPtr) == false {
        Errorf("pointer int field 'pint' should have type_name *int, got " + fIntPtr.type_name)
    }
    if str.Equal(reflect.ElemType(fIntPtr), "int") == false {
        Errorf("ElemType(pint) should be int, got " + reflect.ElemType(fIntPtr))
    }
}
