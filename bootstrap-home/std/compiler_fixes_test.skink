module compiler_fixes_test

import "testing"
import "std/errors"
import "std/fs"
import "std/sync"
import "std/strconv"
import "std/str"
import "std/regress_helper"

// ==========================================================================
// Map codegen: map ops without make() in the same function (CHRIS bug 1)
// ==========================================================================

struct Scores {
    table: map[string]int
}

fn newScores() -> *Scores {
    s := &Scores{}
    s.table = make(map[string]int)
    return s
}

fn bump(m: map[string]int, k: string) {
    m[k] = m[k] + 1
}

// TestMapFieldOps exercises index/assign/len on a map reached through a
// struct field — these paths must emit the map type decl even though no
// make() is codegen'd at the use site.
pub fn TestMapFieldOps() {
    s := newScores()
    s.table["a"] = 1
    s.table["b"] = 2
    testing.AssertEqualInt(2, len(s.table), "struct-field map len")
    testing.AssertEqualInt(1, s.table["a"], "struct-field map index")
    s.table["a"] = 10
    testing.AssertEqualInt(10, s.table["a"], "struct-field map assign")
}

// TestMapParamOps exercises index/assign/len/delete/for-in on a map passed
// as a function parameter (no make() at the use site).
pub fn TestMapParamOps() {
    m := make(map[string]int)
    bump(m, "x")
    bump(m, "x")
    bump(m, "y")
    testing.AssertEqualInt(2, m["x"], "param map index+assign")
    testing.AssertEqualInt(2, len(m), "param map len")
    delete(m, "y")
    testing.AssertEqualInt(1, len(m), "param map delete")
}

// ==========================================================================
// for k, v in map[string]*Struct with field access (CHRIS bug 2)
// ==========================================================================

struct Hormone {
    name:      string
    effective: int
}

// TestMapPtrValueIter iterates a map of struct pointers and reads fields
// through the loop variable (previously emitted invalid IR).
pub fn TestMapPtrValueIter() {
    m := make(map[string]*Hormone)
    m["d"] = &Hormone{name: "dopamine", effective: 50}
    m["s"] = &Hormone{name: "serotonin", effective: 80}
    total := 0
    count := 0
    for k, v in m {
        if len(k) > 0 {
            total = total + v.effective
        }
        count = count + 1
    }
    testing.AssertEqualInt(2, count, "iterated both entries")
    testing.AssertEqualInt(130, total, "summed pointer struct fields")
}

// ==========================================================================
// m[k] = ptr — no double-deref on pointer lvalues (CHRIS bug 3)
// ==========================================================================

// TestMapStorePtr verifies storing &literal, pointer vars, and fn results
// into map[string]*Struct without double-dereferencing.
pub fn TestMapStorePtr() {
    m := make(map[string]*Hormone)
    m["a"] = &Hormone{name: "alpha", effective: 1}
    nh := &Hormone{name: "beta", effective: 2}
    m["b"] = nh
    m["c"] = newHormone("gamma", 3)
    testing.AssertEqualString("alpha", m["a"].name, "&literal store")
    testing.AssertEqualInt(2, m["b"].effective, "ptr var store")
    testing.AssertEqualString("gamma", m["c"].name, "fn result store")
}

fn newHormone(name: string, eff: int) -> *Hormone {
    return &Hormone{name: name, effective: eff}
}

// ==========================================================================
// Nil-map operations (CHRIS bug 5 + delete fixes)
// ==========================================================================

// TestNilMapOps verifies len(), for-in, and delete() on a nil map are
// safe no-ops returning zero (Go semantics).
pub fn TestNilMapOps() {
    var m map[string]int
    testing.AssertEqualInt(0, len(m), "len(nil map) == 0")
    iters := 0
    for k, v in m {
        iters = iters + 1 + v + len(k)
    }
    testing.AssertEqualInt(0, iters, "for-in over nil map runs zero times")
    delete(m, "missing")
    testing.AssertEqualInt(0, len(m), "delete on nil map is a no-op")
}

// TestDeleteMissingKey verifies deleting a key that is not present does
// not corrupt the map (count must be unchanged).
pub fn TestDeleteMissingKey() {
    m := make(map[string]int)
    m["a"] = 1
    m["b"] = 2
    delete(m, "zzz")
    testing.AssertEqualInt(2, len(m), "missing-key delete keeps count")
    testing.AssertEqualInt(1, m["a"], "existing entries intact")
}

// TestMapRehashRetains grows a map past its initial capacity with string
// keys/values, verifying moved entries survive the rehash.
pub fn TestMapRehashRetains() {
    m := make(map[string]string)
    i := 0
    for i < 64 {
        k := "key" + strconv.Itoa(i)
        m[k] = "val" + strconv.Itoa(i)
        i = i + 1
    }
    testing.AssertEqualInt(64, len(m), "all entries present after rehash")
    testing.AssertEqualString("val17", m["key17"], "string value survives rehash")
    testing.AssertEqualString("val63", m["key63"], "last value survives rehash")
}

// ==========================================================================
// Zero-value sync.Mutex (CHRIS bug 6)
// ==========================================================================

// TestZeroValueMutex verifies a Mutex{} / var Mutex lazily initializes
// on first Lock/TryLock instead of segfaulting.
pub fn TestZeroValueMutex() {
    var mu sync.Mutex
    mu.Lock()
    mu.Unlock()
    mu2 := sync.Mutex{}
    testing.AssertTrue(mu2.TryLock(), "TryLock on zero-value Mutex")
    mu2.Unlock()
}

// TestZeroValueMutexCond verifies NewCond on a zero-value mutex works.
pub fn TestZeroValueMutexCond() {
    mu := sync.Mutex{}
    cond := sync.NewCond(&mu)
    mu.Lock()
    cond.Signal()
    mu.Unlock()
}

// ==========================================================================
// spawn on method calls (CHRIS bug 7)
// ==========================================================================

struct SpawnWorker {
    done: chan<int>
}

pub fn loop(self: *SpawnWorker) {
    // Unbuffered send: a synchronous spawn would deadlock here.
    self.done <- 42
}

// TestSpawnMethodCall verifies `spawn w.loop()` runs the method on a
// detached thread instead of falling back to a synchronous call.
pub fn TestSpawnMethodCall() {
    ch := make(chan<int>)
    w := &SpawnWorker{done: ch}
    spawn w.loop()
    v := <-ch
    testing.AssertEqualInt(42, v, "spawned method delivered result")
}

// ==========================================================================
// chan<Struct> / chan<*Struct> payloads (CHRIS bugs 8, 9)
// ==========================================================================

struct ChanMsg {
    text: string
    val:  int
}

// TestChanStructValue verifies a by-value struct survives a channel
// round-trip with fields intact (send must box the declared elem type).
pub fn TestChanStructValue() {
    ch := make(chan<ChanMsg>, 2)
    ch <- ChanMsg{text: "hello", val: 42}
    got := <-ch
    testing.AssertEqualString("hello", got.text, "chan<Struct> text field")
    testing.AssertEqualInt(42, got.val, "chan<Struct> int field")
}

// TestChanStructPtr verifies chan<*Struct> keeps the pointer element type
// so field access on the received value is valid.
pub fn TestChanStructPtr() {
    ch := make(chan<*ChanMsg>, 2)
    ch <- &ChanMsg{text: "ptr", val: 7}
    got := <-ch
    testing.AssertEqualString("ptr", got.text, "chan<*Struct> text field")
    testing.AssertEqualInt(7, got.val, "chan<*Struct> int field")
}

// TestSelectSendStruct verifies the select send case boxes the declared
// element type for struct payloads too.
pub fn TestSelectSendStruct() {
    ch := make(chan<ChanMsg>, 1)
    sent := false
    select {
        case ch <- ChanMsg{text: "sel", val: 9}:
            sent = true
        default:
    }
    testing.AssertTrue(sent, "select send case taken")
    got := <-ch
    testing.AssertEqualString("sel", got.text, "select-send text field")
    testing.AssertEqualInt(9, got.val, "select-send int field")
}

// ==========================================================================
// Channel stored in a struct field (CHRIS bug 17)
//
// `self.out <- v` used to corrupt the outgoing value: emitter-time field
// type resolution failed for `self` (and for inferred locals like
// `oc := h.out`), so the send boxed a *pointer* into a slot sized for the
// declared by-value element type and the receiver got garbage. The
// checker now records per-expression types (Checker.exprTypes) that the
// emitter consults before boxing.
// ==========================================================================

// ChanHub holds a channel of by-value structs as a field.
struct ChanHub {
    out: chan<ChanMsg>
}

// sendSelf sends through `self.out` — the original bug-17 shape.
fn sendSelf(self: *ChanHub, v: ChanMsg) {
    self.out <- v
}

// sendCopied copies the channel field into a local first — the inferred
// local's type must also resolve to chan<ChanMsg> at emit time.
fn sendCopied(self: *ChanHub, v: ChanMsg) {
    oc := self.out
    oc <- v
}

// sendSelect sends through the field inside a select send case.
fn sendSelect(self: *ChanHub, v: ChanMsg) {
    select {
        case self.out <- v:
        default:
    }
}

// TestChanFieldSendSelf verifies a struct round-trips unchanged through a
// channel stored in a struct field and sent via `self.out <- v`.
pub fn TestChanFieldSendSelf() {
    h := &ChanHub{out: make(chan<ChanMsg>, 1)}
    h.sendSelf(ChanMsg{text: "ok", val: 33})
    got := <-h.out
    testing.AssertEqualString("ok", got.text, "field-chan send: text")
    testing.AssertEqualInt(33, got.val, "field-chan send: val")
}

// TestChanFieldSendCopied verifies the element type resolves when the
// channel is copied into an inferred local (`oc := h.out`) before send.
pub fn TestChanFieldSendCopied() {
    h := &ChanHub{out: make(chan<ChanMsg>, 1)}
    h.sendCopied(ChanMsg{text: "zz", val: 44})
    got := <-h.out
    testing.AssertEqualString("zz", got.text, "copied-chan send: text")
    testing.AssertEqualInt(44, got.val, "copied-chan send: val")
}

// TestChanFieldSendSelect verifies select send cases through a channel
// field box the declared element type.
pub fn TestChanFieldSendSelect() {
    h := &ChanHub{out: make(chan<ChanMsg>, 1)}
    h.sendSelect(ChanMsg{text: "sel", val: 55})
    got := <-h.out
    testing.AssertEqualString("sel", got.text, "select field-chan send: text")
    testing.AssertEqualInt(55, got.val, "select field-chan send: val")
}

// ChanPtrHub holds a channel of struct pointers as a field.
struct ChanPtrHub {
    out: chan<*ChanMsg>
}

// TestChanFieldStructPtr verifies chan<*Struct> stored in a field keeps
// the pointer element type through send/receive.
pub fn TestChanFieldStructPtr() {
    h := &ChanPtrHub{out: make(chan<*ChanMsg>, 1)}
    h.out <- &ChanMsg{text: "p", val: 42}
    got := <-h.out
    testing.AssertEqualString("p", got.text, "field chan<*Struct>: text")
    testing.AssertEqualInt(42, got.val, "field chan<*Struct>: val")
}

// TestChanFieldMultiSend sends several values through a field channel to
// expose layout/boxing mistakes that only show on the second+ element.
pub fn TestChanFieldMultiSend() {
    h := &ChanHub{out: make(chan<ChanMsg>, 3)}
    h.sendSelf(ChanMsg{text: "a", val: 1})
    h.sendCopied(ChanMsg{text: "b", val: 2})
    h.sendSelect(ChanMsg{text: "c", val: 3})
    a := <-h.out
    b := <-h.out
    c := <-h.out
    testing.AssertEqualString("a", a.text, "multi-send [0] text")
    testing.AssertEqualInt(1, a.val, "multi-send [0] val")
    testing.AssertEqualString("b", b.text, "multi-send [1] text")
    testing.AssertEqualInt(2, b.val, "multi-send [1] val")
    testing.AssertEqualString("c", c.text, "multi-send [2] text")
    testing.AssertEqualInt(3, c.val, "multi-send [2] val")
}

// ==========================================================================
// Const declarations: multiple blocks, pub visibility, forward refs
// ==========================================================================

const FirstBlock = "one"

const {
    SecondA = "two-a"
    SecondB = "two-b"
}

const (
    ThirdX = 3
    ThirdY = 4
)

// Forward reference: ForwardA's value is ForwardB, declared later.
const ForwardA = ForwardB
const ForwardB = "bee"

pub const ExportMe = "exported"

// TestMultipleConstBlocks verifies several const blocks may appear in one
// module (previously collided on a synthesized "module." name).
pub fn TestMultipleConstBlocks() {
    testing.AssertEqualString("one", FirstBlock, "single const")
    testing.AssertEqualString("two-a", SecondA, "brace block const")
    testing.AssertEqualString("two-b", SecondB, "brace block const 2")
    testing.AssertEqualInt(3, ThirdX, "paren block const")
    testing.AssertEqualInt(4, ThirdY, "paren block const 2")
}

// TestConstArrayUnify verifies consts of the same underlying type unify
// inside composite literals (previously each const had its own named type).
pub fn TestConstArrayUnify() {
    arr := []string{FirstBlock, SecondA, SecondB, ExportMe}
    testing.AssertEqualInt(4, len(arr), "const array length")
    testing.AssertEqualString("two-b", arr[2], "const array element")
    nums := []int{ThirdX, ThirdY}
    testing.AssertEqualInt(7, nums[0] + nums[1], "int const array sum")
}

// TestConstForwardRef verifies a const may reference a later-declared
// const and still resolve to the underlying type.
pub fn TestConstForwardRef() {
    arr := []string{ForwardA, ForwardB}
    testing.AssertEqualString("bee", arr[0], "forward-ref const value")
    testing.AssertEqualString("bee", ForwardA, "forward-ref const type")
}

// TestPubConstCrossModule verifies pub consts (single, brace block, and
// paren block) are accessible from another module.
pub fn TestPubConstCrossModule() {
    testing.AssertEqualString("px", regress_helper.PubBlockX, "pub block const")
    testing.AssertEqualString("py", regress_helper.PubBlockY, "pub block const 2")
    testing.AssertEqualString("ps", regress_helper.PubSingle, "pub single const")
    testing.AssertEqualInt(33, regress_helper.PubParenOne + regress_helper.PubParenTwo, "pub paren consts")
    arr := []string{regress_helper.PubBlockX, regress_helper.PubSingle}
    testing.AssertEqualInt(2, len(arr), "cross-module const array")
}

// TestPrivateConstSameModule verifies non-pub consts remain usable inside
// their own module (cross-module access is rejected by the checker).
pub fn TestPrivateConstSameModule() {
    testing.AssertEqualString("sasb", regress_helper.Secrets(), "private consts used internally")
    testing.AssertEqualInt(7, regress_helper.PrivateFactor(), "private const in module fn")
}

// TestPubConstSameModuleRefs verifies an exported const whose initializer
// references *same-module* symbols (private consts, private functions,
// local struct types) emits correctly at a cross-module reference site.
// emitConstExpr restores the const's owning module/file context before
// re-emitting its initializer; without that, the references below emitted
// unresolved symbols like `@secret_a`.
pub fn TestPubConstSameModuleRefs() {
    arr := regress_helper.PubSliceConsts
    testing.AssertEqualInt(2, len(arr), "exported slice const length")
    testing.AssertEqualString("sa", arr[0], "slice const private elem")
    testing.AssertEqualString("zz", arr[1], "slice const literal elem")
    testing.AssertEqualInt(10, regress_helper.PubComputed, "const calling private fn")
    testing.AssertEqualInt(3, regress_helper.PubOrigin.x, "const struct field x")
    testing.AssertEqualInt(4, regress_helper.PubOrigin.y, "const struct field y")
}

// ==========================================================================
// Private function name collisions across modules (skink-lsp)
// ==========================================================================

// helper shares its name with a private function in regress_helper —
// resolution inside this module must prefer the local declaration.
fn helper() -> int {
    return 2
}

pub fn TestPrivateFnCollision() {
    testing.AssertEqualInt(2, helper(), "local private helper wins")
    testing.AssertEqualInt(7, regress_helper.PrivateFactor(), "module's own helper used there")
}

// ==========================================================================
// Owned composite parameters (borrowed-param release fix)
// ==========================================================================

struct Term {
    name: string
    id:   int
}

fn reassignParam(t: Term) -> Term {
    // Reassigning a by-value struct param must not release the caller's
    // shared heap fields — params are owned copies.
    t = Term{name: "bob", id: 2}
    return t
}

// TestStructParamReassign verifies that assigning to a composite
// parameter does not corrupt the caller's original value.
pub fn TestStructParamReassign() {
    orig := Term{name: "alice", id: 1}
    changed := reassignParam(orig)
    testing.AssertEqualString("alice", orig.name, "caller struct name intact")
    testing.AssertEqualInt(1, orig.id, "caller struct id intact")
    testing.AssertEqualString("bob", changed.name, "reassigned param value")
}

// ==========================================================================
// make([]uint8/[]int8, n) and related slice operations (CHRIS bug 26)
// ==========================================================================

// TestByteSliceMakeLen verifies that make() creates a byte slice whose length
// is stored in the RC header, not derived via strlen on the zeroed payload.
// Previously len() on a freshly-made []uint8/[]int8 returned 0 because the
// payload bytes were all zero and len() treated i8* as a null-terminated string.
pub fn TestByteSliceMakeLen() {
    u := make([]uint8, 4)
    testing.AssertEqualInt(4, len(u), "make([]uint8,4) length")

    i := make([]int8, 4)
    testing.AssertEqualInt(4, len(i), "make([]int8,4) length")
}

// TestByteSliceIndexAndReslice verifies indexing and reslicing on make'd
// []uint8. Previously s[:n] used strlen and panicked with "slice bounds out
// of range" because the zeroed payload looked like an empty string.
pub fn TestByteSliceIndexAndReslice() {
    s := make([]uint8, 4)
    s[0] = 10
    s[1] = 20
    s[2] = 30
    s[3] = 40
    testing.AssertEqualInt(10, int(s[0]), "byte slice index 0")
    testing.AssertEqualInt(30, int(s[2]), "byte slice index 2")

    sub := s[1:3]
    testing.AssertEqualInt(2, len(sub), "byte slice reslice length")
    testing.AssertEqualInt(20, int(sub[0]), "byte slice reslice first elem")
    testing.AssertEqualInt(30, int(sub[1]), "byte slice reslice second elem")
}

// TestByteSliceAppend verifies append on make'd []uint8, including appending
// an integer literal. The checker previously rejected append(s, 9) because it
// demanded a uint8 argument; the emitter also sized elements by the value type
// rather than the slice element type, causing corrupt storage.
pub fn TestByteSliceAppend() {
    s := make([]uint8, 2)
    s = append(s, 9)
    testing.AssertEqualInt(3, len(s), "append int literal to []uint8 length")
    testing.AssertEqualInt(9, int(s[2]), "appended uint8 value")
}

// TestByteSliceSpreadAppend verifies append(s, anotherSlice...) on []uint8.
// The source slice is built with make/append so it really is []uint8.
pub fn TestByteSliceSpreadAppend() {
    a := make([]uint8, 0)
    a = append(a, 1)
    a = append(a, 2)
    a = append(a, 3)
    b := make([]uint8, 2)
    c := append(b, a...)
    testing.AssertEqualInt(5, len(c), "spread append length")
    testing.AssertEqualInt(1, int(c[2]), "spread append first new elem")
    testing.AssertEqualInt(3, int(c[4]), "spread append last new elem")
}

// TestByteSliceForIn verifies for-in over a make'd []uint8 uses the stored
// length, not strlen.
pub fn TestByteSliceForIn() {
    s := make([]uint8, 3)
    s[0] = 5
    s[1] = 6
    s[2] = 7
    sum := 0
    for v in s {
        sum = sum + int(v)
    }
    testing.AssertEqualInt(18, sum, "for-in over byte slice sum")
}

// ==========================================================================
// Nil slice reslice (CHRIS bug 23)
// ==========================================================================

// TestNilSliceReslice verifies that slicing a nil slice with zero bounds
// returns an empty slice instead of dereferencing the null header. This is
// common when an element of make([][]T, n) is never populated.
pub fn TestNilSliceReslice() {
    ss := make([][]int, 3)
    ss[0] = ss[0][:0]
    testing.AssertEqualInt(0, len(ss[0]), "nil reslice length")
    testing.AssertEqualInt(3, len(ss), "outer slice length")
}

// ==========================================================================
// Mixed signed/unsigned comparisons (CHRIS bug 27)
// ==========================================================================

// TestMixedSignCompareCast verifies that signed/unsigned integer comparisons
// work correctly when both operands are explicitly cast to a common signed
// type. Direct mixed-sign comparisons still use unsigned opcodes in the
// back-end, so comparing across signedness requires an explicit cast.
pub fn TestMixedSignCompareCast() {
    a := int32(-26)
    b := uint16(10000)
    testing.AssertTrue(int(a) < int(b), "mixed sign compare via common signed type")
    testing.AssertFalse(int(a) > int(b), "mixed sign compare via common signed type")
    testing.AssertTrue(int(a) != int(b), "mixed sign compare equality via common signed type")
}

// ==========================================================================
// Selector '<' must not be parsed as generic args (comp_error.md #29)
// ==========================================================================

// SelectorWellbeing holds an exported float field named like the CHRIS
// field whose `<` comparison was misparsed.
struct SelectorWellbeing {
    Wellbeing: float
}

// TestSelectorLessThan verifies that `out.Wellbeing < 0.0` parses as a
// comparison, not as generic type arguments on the field. Previously the
// parser consumed `<` as the start of generic args after an uppercase
// selector field, producing `if condition must be bool, got float`.
pub fn TestSelectorLessThan() {
    out := SelectorWellbeing{Wellbeing: 1.5}
    testing.AssertFalse(out.Wellbeing < 0.0, "selector < comparison false")
    testing.AssertTrue(out.Wellbeing > 0.0, "selector > comparison true")
    neg := SelectorWellbeing{Wellbeing: -2.0}
    testing.AssertTrue(neg.Wellbeing < 0.0, "selector < comparison true")
    // A selector comparison must still work in an `if` condition —
    // the original bug surfaced as a non-bool condition error.
    if neg.Wellbeing < 0.0 {
        testing.AssertTrue(true, "selector < in if condition")
    } else {
        testing.AssertTrue(false, "selector < in if condition")
    }
}

// ==========================================================================
// Byte-slice literals honor the declared element type (comp_error.md #26)
// ==========================================================================

// takesBytesLen is a helper that requires an actual []uint8 argument.
fn takesBytesLen(x: []uint8) -> int {
    return len(x)
}

// TestByteSliceLiteralType verifies that []uint8{...} literals keep their
// declared []uint8 type instead of being inferred as []int. Previously a
// literal passed to a []uint8 parameter errored with
// `argument 1 type mismatch: expected []uint8, got []int`, and assigning a
// literal to a `var t []uint8` errored with `cannot assign []int to []uint8`.
pub fn TestByteSliceLiteralType() {
    s := []uint8{1, 2, 3, 4}
    testing.AssertEqualInt(4, len(s), "[]uint8 literal length")
    testing.AssertEqualInt(3, int(s[2]), "[]uint8 literal element")

    // Passing the literal-typed slice to a []uint8 parameter is the exact
    // scenario that used to fail the checker.
    testing.AssertEqualInt(4, takesBytesLen(s), "[]uint8 literal as argument")

    var t []uint8
    t = []uint8{5, 6, 7}
    testing.AssertEqualInt(3, len(t), "[]uint8 literal assignment length")
    testing.AssertEqualInt(6, int(t[1]), "[]uint8 literal assignment element")

    // Signed byte slices get the same treatment.
    si := []int8{1, 2}
    testing.AssertEqualInt(2, len(si), "[]int8 literal length")
}

// ==========================================================================
// Calls through :=-inferred function-typed locals (comp_error.md #21)
// ==========================================================================

// doubleForCall is a plain function used as a first-class value below.
fn doubleForCall(x: int) -> int {
    return x * 2
}

// getDoubler returns a function value — the same shape as the original
// static.FileServer repro.
fn getDoubler() -> fn(int) -> int {
    return doubleForCall
}

// TestInferredFnLocalCall verifies that a function-typed local introduced
// with `:=` can be invoked. Previously the emitter treated the call target
// as a global function and emitted a malformed `call ... @h(...)` IR with
// an empty argument list, because the variable's synthetic type was not
// recorded for `:=` declarations.
pub fn TestInferredFnLocalCall() {
    // Explicit declaration — always worked.
    var h fn(int) -> int
    h = getDoubler()
    testing.AssertEqualInt(6, h(3), "call through declared fn var")

    // The bug: h2 is inferred from getDoubler()'s return type via :=.
    h2 := getDoubler()
    testing.AssertEqualInt(8, h2(4), "call through :=-inferred fn var")

    // A non-capturing function literal assigned via := must also be
    // callable the same way.
    inc := fn(x: int) -> int { return x + 1 }
    testing.AssertEqualInt(11, inc(10), "call through :=-inferred fn literal")
}

// ==========================================================================
// Function literals without captures are lifted cleanly (comp_error.md #20)
// ==========================================================================

// TestFnLitNoCapture verifies that a function literal that references only
// its own parameters (and globals) still compiles and calls correctly.
// Capturing an enclosing local is now a compile-time error — see
// comp_error.md #20 — so the positive case is what needs regression cover.
pub fn TestFnLitNoCapture() {
    f := fn(x: int, y: int) -> int { return x * y + 1 }
    testing.AssertEqualInt(11, f(2, 5), "non-capturing fn literal")
    g := fn() -> int { return 99 }
    testing.AssertEqualInt(99, g(), "non-capturing fn literal no params")
}

// ==========================================================================
// append growth: geometric capacity via Skink_slice_ensure (comp_error.md #30)
// ==========================================================================

// TestAppendManyElements appends a large number of elements to a uniquely
// owned slice and verifies length and content. Before the geometric-growth
// fix every append reallocated at exactly len+1 and copied all elements,
// making this loop O(N^2) in both copies and allocator churn (stage-2
// self-compiles were OOM-killed at ~12 GB RSS). With Skink_slice_ensure the
// unique path is amortized O(1); 200k appends must complete quickly and
// correctly.
pub fn TestAppendManyElements() {
    s := []int{}
    for i := 0; i < 200000; i = i + 1 {
        s = append(s, i)
    }
    testing.AssertEqualInt(200000, len(s), "len after 200k appends")
    testing.AssertEqualInt(0, s[0], "first element")
    testing.AssertEqualInt(199999, s[199999], "last element")
    testing.AssertEqualInt(100000, s[100000], "middle element")
}

// TestAppendSharedSlice verifies copy-on-write for shared backing arrays:
// when another variable holds a reference to the same slice, append must
// copy (refcount > 1 path) rather than grow in place, so the other owner's
// view and the appended result stay consistent.
pub fn TestAppendSharedSlice() {
    a := []int{1, 2, 3}
    b := a                       // shared backing array (refcount >= 2)
    a = append(a, 4)
    testing.AssertEqualInt(4, len(a), "appended len")
    testing.AssertEqualInt(3, len(b), "other owner len unchanged")
    testing.AssertEqualInt(4, a[3], "appended value")
    testing.AssertEqualInt(3, b[2], "other owner last element")
    // Both arrays must still hold their elements after growth.
    testing.AssertEqualInt(2, a[0] + b[0], "shared first elements")
}

// TestAppendSpread verifies append(dst, src...) appends every source
// element and that repeated spread appends grow correctly.
pub fn TestAppendSpread() {
    dst := []int{1, 2}
    src := []int{3, 4, 5}
    dst = append(dst, src...)
    testing.AssertEqualInt(5, len(dst), "spread len")
    testing.AssertEqualInt(5, dst[4], "spread last")
    dst = append(dst, src...)
    testing.AssertEqualInt(8, len(dst), "second spread len")
    testing.AssertEqualInt(5, dst[7], "second spread last")
}

// TestAppendStringSlice exercises the heap-element path: appended strings
// must be retained so the slice keeps them alive.
pub fn TestAppendStringSlice() {
    s := []string{}
    for i := 0; i < 1000; i = i + 1 {
        s = append(s, "item" + strconv.Itoa(i))
    }
    testing.AssertEqualInt(1000, len(s), "string slice len")
    testing.AssertTrue(s[999] == "item999", "last string")
}

// ==========================================================================
// Geometric append growth (comp_error.md #30) — ownership edge cases
// ==========================================================================

// TestAppendNonSelfPreservesSource guards the aliasing rule of the
// geometric-growth fix: `t = append(s, v)` where s is NOT the assign target
// must leave s untouched. The in-place grow path would bump the shared
// length header (or free s's block when realloc moved it), corrupting the
// still-live source variable; only the `x = append(x, ...)` idiom proves
// the source reference dead.
pub fn TestAppendNonSelfPreservesSource() {
    s := []int{1, 2, 3}
    t := append(s, 4)
    testing.AssertEqualInt(3, len(s), "source len unchanged")
    testing.AssertEqualInt(4, len(t), "result len")
    testing.AssertEqualInt(3, s[2], "source last element")
    testing.AssertEqualInt(4, t[3], "result last element")
    t = append(t, 5)
    testing.AssertEqualInt(3, len(s), "source len still unchanged")
    testing.AssertEqualInt(5, len(t), "grown result len")
}

// TestAppendSelfSpread guards `s = append(s, s...)`: the source and
// destination share one backing array, so the grow path must not be taken
// — the copy path must read every original element before extending.
pub fn TestAppendSelfSpread() {
    s := []int{1, 2, 3}
    s = append(s, s...)
    testing.AssertEqualInt(6, len(s), "doubled len")
    testing.AssertEqualInt(2, s[0] + s[3], "first pair")
    testing.AssertEqualInt(4, s[1] + s[4], "second pair")
    testing.AssertEqualInt(6, s[2] + s[5], "third pair")
}

// TestAppendVariadicSelfAssign guards `x = append(x, a, b, ...)`: the
// variadic chain grows the same backing array repeatedly, so ownership of
// intermediate results must stay balanced across many growth doublings.
pub fn TestAppendVariadicSelfAssign() {
    s := []int{}
    for i := 0; i < 50000; i = i + 1 {
        s = append(s, i, i * 2)
    }
    testing.AssertEqualInt(100000, len(s), "variadic len")
    testing.AssertEqualInt(49999, s[99998], "even-index element")
    testing.AssertEqualInt(99998, s[99999], "odd-index element")
}

// AppendBag exercises the struct-field self-append idiom.
struct AppendBag {
    vals: []int
}

// TestAppendFieldSelfAssign guards `t.vals = append(t.vals, v)`: field
// targets release the old field value just like variable assigns, so the
// in-place grow path and its ownership compensation must work there too.
pub fn TestAppendFieldSelfAssign() {
    var b AppendBag
    for i := 0; i < 100000; i = i + 1 {
        b.vals = append(b.vals, i)
    }
    testing.AssertEqualInt(100000, len(b.vals), "field slice len")
    testing.AssertEqualInt(99999, b.vals[99999], "field slice last")
    testing.AssertEqualInt(50000, b.vals[50000], "field slice middle")
}

// TestAppendNestedArg guards appends nested inside a self-append's value
// or slice argument: only the outermost call may consume the self-assign
// flag, so inner appends must leave the referenced slices intact.
pub fn TestAppendNestedArg() {
    m := [][]int{}
    m = append(m, []int{1})
    m = append(m, append(m[0], 2))
    testing.AssertEqualInt(2, len(m), "outer len")
    testing.AssertEqualInt(1, len(m[0]), "inner source unchanged")
    testing.AssertEqualInt(2, len(m[1]), "appended inner len")
    testing.AssertEqualInt(2, m[1][1], "appended inner element")
}

// ==========================================================================
// &local escape analysis: address-taken locals are boxed on the heap
// ==========================================================================

// escClobber tramples the stack region a just-returned frame occupied so a
// dangling &local deterministically reads garbage rather than stale bytes.
fn escClobber(depth: int) -> int {
    if depth <= 0 {
        return 0
    }
    marker := depth*2654435761 + 777
    return escClobber(depth - 1) + 1 + marker - marker
}

// escapeInt returns the address of a stack local. The escape pre-scan must
// box `x` into an RC heap block so the pointer stays valid after return.
fn escapeInt() -> *int {
    x := 41
    return &x
}

// TestEscapedScalarLocal guards `&x` returned from a function: the pointer
// used to reference the dead stack frame.
pub fn TestEscapedScalarLocal() {
    p := escapeInt()
    _ = escClobber(64)
    testing.AssertEqualInt(41, *p, "escaped int local")
}

// TestAddressOfWriteThrough verifies writes through &x reach the variable
// and vice versa — both names must address the same boxed storage.
struct EscBox {
    v: int
}
pub fn TestAddressOfWriteThrough() {
    var b EscBox
    p := &b
    p.v = 42
    testing.AssertEqualInt(42, b.v, "write through pointer visible to variable")
    b.v = 7
    testing.AssertEqualInt(7, p.v, "variable write visible through pointer")
}

// TestEscapedIntMutation covers pointer writes on boxed scalars via a
// helper that mutates through its *int parameter.
fn bumpPtr(p: *int) {
    *p = *p + 1
}
pub fn TestEscapedIntMutation() {
    x := 10
    bumpPtr(&x)
    testing.AssertEqualInt(11, x, "mutation through &param visible to local")
    bumpPtr(&x)
    bumpPtr(&x)
    testing.AssertEqualInt(13, x, "repeat mutation through &param")
}

// === Issue #31: nested generic calls re-checked exponentially ===
//
// inferGenericSubst ran checkExpr on each call argument to infer T,
// then checkCallArgs ran checkExpr on the same arguments again. A
// nested call like id(id(id(...))) was therefore checked twice per
// level — O(2^N) total — making deep nesting effectively hang the
// checker. The fix returns the arg types computed during inference and
// reuses them in checkCallArgsWithTypes.

// idOf31 is a generic identity used to nest calls.
fn idOf31<T>(v: T) -> T {
    return v
}

// TestNestedGenericCalls verifies nested generic calls still produce the
// correct inferred types and values. Ten levels deep would have cost
// ~2^10 argument re-checks before the fix; now each arg is checked once.
pub fn TestNestedGenericCalls() {
    x := idOf31(idOf31(idOf31(idOf31(idOf31(idOf31(idOf31(idOf31(idOf31(idOf31(42))))))))))
    testing.AssertEqualInt(42, x, "nested generic int result")
    s := idOf31(idOf31(idOf31("abc")))
    testing.AssertEqualString("abc", s, "nested generic string result")
    // Mixed nesting inside a non-generic call arg.
    testing.AssertEqualInt(7, len(idOf31("abcdefg")), "generic call inside len()")
}

// ==========================================================================
// Closure capture: function literals share enclosing locals (comp_error.md
// #20). Literals lift to module functions receiving a hidden env argument;
// captured variables are boxed so reads/writes alias the enclosing variable.
// ==========================================================================

// TestClosureCaptureRead verifies a literal can read an enclosing local.
pub fn TestClosureCaptureRead() {
    n := 5
    add := fn(x: int) -> int { return x + n }
    testing.AssertEqualInt(15, add(10), "captured local read")
}

// TestClosureCaptureMutation verifies writes inside a literal propagate
// back to the enclosing variable (capture is by reference).
pub fn TestClosureCaptureMutation() {
    n := 0
    bump := fn() { n = n + 1 }
    bump()
    bump()
    bump()
    testing.AssertEqualInt(3, n, "capture write propagates")
}

// makeCounter returns a closure over a local that outlives the frame.
fn makeCounter(seed: int) -> fn() -> int {
    c := seed
    return fn() -> int {
        c = c + 1
        return c
    }
}

// TestClosureCaptureAfterReturn verifies captured storage survives the
// defining frame and that distinct closures get independent envs.
pub fn TestClosureCaptureAfterReturn() {
    next := makeCounter(10)
    testing.AssertEqualInt(11, next(), "first increment")
    testing.AssertEqualInt(12, next(), "second increment")
    next2 := makeCounter(100)
    testing.AssertEqualInt(101, next2(), "independent env")
    testing.AssertEqualInt(13, next(), "first env unaffected")
}

// TestClosureCaptureString verifies heap-typed captures stay alive.
pub fn TestClosureCaptureString() {
    s := "hello"
    greet := fn(name: string) -> string { return s + ", " + name }
    testing.AssertEqualString("hello, bob", greet("bob"), "captured string")
}

// TestClosureCaptureParam verifies capturing a function parameter works.
pub fn TestClosureCaptureParam() {
    apply := fn(base: int) -> fn(int) -> int {
        return fn(x: int) -> int { return base + x }
    }
    add100 := apply(100)
    testing.AssertEqualInt(110, add100(10), "captured param")
}

// TestClosureStructField verifies captured struct fields read/write
// through the shared box.
struct closureBox {
    val: int
}

pub fn TestClosureStructField() {
    b := closureBox{val: 7}
    setVal := fn(v: int) { b.val = v }
    get := fn() -> int { return b.val }
    setVal(42)
    testing.AssertEqualInt(42, get(), "captured struct field read")
    testing.AssertEqualInt(42, b.val, "captured struct field write visible")
}

// === Issue #32: &x.ptrfield.sub skipped the pointer load ===
//
// emitAddressOf computed `&outer.inner.v` as `&outer.inner + off(v)` —
// using the pointer slot as the struct base instead of loading the
// *RegInner. Writes through the resulting pointer corrupted the slot;
// the same wrong base was used for pointer-receiver method calls on
// subfields.

struct reg32Inner {
    v: int
}

struct reg32Outer {
    inner: *reg32Inner
}

// TestPtrFieldSubfieldAddr verifies &x.ptrfield.sub writes through the
// pointee, not the pointer slot.
pub fn TestPtrFieldSubfieldAddr() {
    inn := reg32Inner{v: 1}
    out := reg32Outer{inner: &inn}
    p := &out.inner.v
    *p = 42
    testing.AssertEqualInt(42, inn.v, "&outer.inner.v writes to pointee")
    testing.AssertEqualInt(42, out.inner.v, "read back through field")
}

// === Issue #34: signed/unsigned check fired on all infix ops ===
//
// checkInfixExpr rejected any mixed signed/unsigned operand pair —
// including `uint16 >> int` (a signed shift count is conventional) and
// mixed arithmetic/bitwise ops. The check is now restricted to
// ordering/equality operators.

// TestShiftSignedCount verifies a signed `int` shift count on unsigned
// operands compiles and shifts correctly (regression for #34).
pub fn TestShiftSignedCount() {
    v := uint16(1024)
    sh := 3
    testing.AssertEqualInt(128, int(v >> sh), "uint16 >> int var")
    testing.AssertEqualInt(8192, int(v << sh), "uint16 << int var")
    w := uint(64)
    testing.AssertEqualInt(8, int(w >> sh), "uint >> int var")
}

// TestMixedSignArithmetic verifies mixed signed/unsigned arithmetic and
// bitwise ops are accepted (regression for #34; comparisons still
// require matching signedness or an explicit cast).
pub fn TestMixedSignArithmetic() {
    u := uint16(100)
    s := 30
    testing.AssertEqualInt(130, int(u + s), "uint16 + int")
    testing.AssertEqualInt(70, int(u - s), "uint16 - int")
    testing.AssertEqualInt(4, int(u & s), "uint16 & int")
    testing.AssertEqualInt(126, int(u | s), "uint16 | int")
}

// === mod.fn as a call argument coerced to i32 (comp_error.md follow-up) ===
//
// exprFieldLLType fell through to "i32" for a module-qualified function
// used as a value (`str.ToUpper` as an argument). Call-arg coercion
// then emitted `inttoptr i32` on the already-correct i8* closure handle
// — invalid LLVM IR. Fixed by falling back to the checker's recorded
// semantic type before the i32 default.

fn applyUpper(f: fn(string) -> string, s: string) -> string {
    return f(s)
}

// TestModuleFnAsCallArg verifies passing `mod.fn` as a fn-typed argument
// compiles and calls through the closure handle.
pub fn TestModuleFnAsCallArg() {
    testing.AssertEqualString("HI", applyUpper(str.ToUpper, "hi"), "mod.fn arg")
}

// === #33 follow-up: deref-assign / address-of edge cases ===
//
// The #33 fix let `*p = v` parse as a statement on its own line. These
// tests pin the adjacent statement shapes: derefs on the RHS, compound
// assigns, parenthesized/nested deref targets, and `*p = v` as the first
// statement of blocks where the Pratt-loop newline disambiguation must
// still kick in. (`(*p) = v` — leading paren before the `*` — remains a
// known parse gap; see comp_error.md.)

// TestDerefAssignDerefRHS verifies `*pa = *pb` assigns the pointed-to
// value through the pointer (both sides are derefs).
pub fn TestDerefAssignDerefRHS() {
    a := 5
    b := 9
    pa := &a
    pb := &b
    *pa = *pb
    testing.AssertEqualInt(9, a, "deref-to-deref assign")
    testing.AssertEqualInt(9, *pa, "read back through pointer")
}

// TestDerefAssignCompound verifies compound assignment operators work
// through a dereferenced pointer target.
pub fn TestDerefAssignCompound() {
    x := 10
    p := &x
    *p += 5
    testing.AssertEqualInt(15, x, "*p += 5")
    *p -= 2
    testing.AssertEqualInt(13, x, "*p -= 2")
    *p *= 3
    testing.AssertEqualInt(39, x, "*p *= 3")
    *p /= 3
    testing.AssertEqualInt(13, x, "*p /= 3")
}

// TestDerefAssignParenOperand verifies `*(p) = v` — a deref target whose
// operand is parenthesized — parses and assigns. (The mirrored form
// `(*p) = v` is a separate open parse bug.)
pub fn TestDerefAssignParenOperand() {
    x := 1
    p := &x
    *(p) = 66
    testing.AssertEqualInt(66, x, "*(p) = v writes through pointer")
}

// TestDoubleDerefOps verifies reads and writes through `**pp` and
// `*(*pp)`, plus storing a pointer through a `*pp` target.
pub fn TestDoubleDerefOps() {
    x := 1
    y := 2
    p := &x
    pp := &p
    testing.AssertEqualInt(1, **pp, "**pp read")
    testing.AssertEqualInt(1, *(*pp), "*(*pp) read")

    *(*pp) = 42
    testing.AssertEqualInt(42, x, "*(*pp) = v writes through both derefs")

    // Repoint the inner pointer, then write through the bare ** form.
    *pp = &y
    testing.AssertEqualInt(2, *p, "*pp = &y repoints inner pointer")
    **pp = 9
    testing.AssertEqualInt(9, y, "**pp = v writes to repointed target")
    testing.AssertEqualInt(42, x, "original pointee untouched")

    // `q := *pp` then `*q = v` is the same aliasing via a local copy.
    q := *pp
    *q = 7
    testing.AssertEqualInt(7, y, "*q = v after q := *pp")
}

// setThroughPtr exercises `*p = v` as the first statement of a function
// body — the statement-start `*` must parse as a deref-assign, not be
// glued onto a preceding expression.
fn setThroughPtr(p: *int) {
    *p = 5
}

// TestDerefAssignBlockPositions verifies `*p = v` parses as the first
// statement inside if/else branches and loop bodies (regression for #33,
// where a preceding expression statement could swallow the leading `*`).
pub fn TestDerefAssignBlockPositions() {
    x := 1
    setThroughPtr(&x)
    testing.AssertEqualInt(5, x, "*p = v first statement of fn body")

    p := &x
    if x > 0 {
        *p = 8
    } else {
        *p = 9
    }
    testing.AssertEqualInt(8, x, "*p = v first statement of if branch")
    if x < 0 {
        *p = 1
    } else {
        *p = 10
    }
    testing.AssertEqualInt(10, x, "*p = v first statement of else branch")

    for x < 12 {
        *p = *p + 1
    }
    testing.AssertEqualInt(12, x, "*p = v first statement of loop body")
}

// TestAddrOfStructField verifies taking the address of a stack struct's
// field yields a usable write-through pointer.
pub fn TestAddrOfStructField() {
    var b EscBox
    p := &b.v
    *p = 4
    testing.AssertEqualInt(4, b.v, "write through &b.v")
    b.v = 11
    testing.AssertEqualInt(11, *p, "field write visible through pointer")
}

// TestAddrOfSliceIndex verifies &s[i] addresses the backing-array element
// so writes through it mutate the slice.
pub fn TestAddrOfSliceIndex() {
    s := []int{1, 2, 3}
    p := &s[1]
    *p = 50
    testing.AssertEqualInt(50, s[1], "write through &s[1]")
    testing.AssertEqualInt(1, s[0], "neighbour element untouched")
}

// TestAddrOfLoopVarShared pins the semantics of `&i` where `i` is a
// C-style `for` variable: `i` is declared once by the loop init, so every
// `&i` aliases the same (boxed, escaped) variable and all collected
// pointers observe the final value 3.
pub fn TestAddrOfLoopVarShared() {
    var ptrs []*int
    for i := 0; i < 3; i = i + 1 {
        ptrs = append(ptrs, &i)
    }
    testing.AssertEqualInt(3, len(ptrs), "collected pointers")
    sum := 0
    for i := 0; i < len(ptrs); i = i + 1 {
        sum = sum + *ptrs[i]
    }
    testing.AssertEqualInt(9, sum, "all &i alias the same loop variable")
}

// === #20 follow-up: closure capture edge cases ===
//
// The lifted-literal capture machinery is exercised here on shapes beyond
// the basic read/write tests: literals inside literals, several literals
// sharing one capture, literals stored in composite containers, deferred
// literals, self-referential literals, heap-typed captures, and captures
// that must alias an `&`-taken pointer. (Loop-body captures of outer or
// loop variables are still broken — see comp_error.md.)

// TestNestedClosureFactory verifies a literal returned from inside another
// literal captures variables from both enclosing frames.
pub fn TestNestedClosureFactory() {
    a := 1
    outer := fn() -> fn() -> int {
        b := 10
        return fn() -> int { return a + b }
    }
    inner := outer()
    testing.AssertEqualInt(11, inner(), "inner reads captures from both frames")
}

// TestClosureSharedCapture verifies two literals capturing the same
// variable observe each other's writes through the shared box.
pub fn TestClosureSharedCapture() {
    n := 0
    inc := fn() { n = n + 1 }
    dec := fn() { n = n - 1 }
    inc()
    inc()
    inc()
    dec()
    testing.AssertEqualInt(2, n, "shared capture converges on one variable")
}

// TestClosureInSliceCall verifies literals stored in a slice remain
// callable through an index expression.
pub fn TestClosureInSliceCall() {
    fns := []fn() -> int{}
    fns = append(fns, fn() -> int { return 10 })
    fns = append(fns, fn() -> int { return 20 })
    testing.AssertEqualInt(30, fns[0]() + fns[1](), "index-called literals")
}

// deferCapSeen / deferCapStore observe the deferred literal's side effect
// after the helper returns.
var deferCapSeen: string

fn deferCapStore(s: string) {
    deferCapSeen = s
}

// deferCapHelper defers a capturing literal; the literal must see the
// captured variable's final value when it runs at function exit.
fn deferCapHelper() {
    msg := "not set"
    defer fn() { deferCapStore(msg) }()
    msg = "set"
}

// TestDeferCapturingLiteral verifies a deferred function literal captures
// by reference — it observes `msg` as of the deferred call, not as of the
// defer statement.
pub fn TestDeferCapturingLiteral() {
    deferCapSeen = ""
    deferCapHelper()
    testing.AssertEqualString("set", deferCapSeen, "deferred literal sees final captured value")
}

// deferBlockSeen records the value a block-scoped deferred literal reads.
var deferBlockSeen: string

fn deferBlockCapStore(s: string) {
    deferBlockSeen = s
}

// deferBlockHelper defers a literal that captures a variable declared in
// a nested block; the env must pack the block's capture box while the
// block scope is still live (comp_error.md #41 — previously the lifted
// literal degraded to a global lookup and emitted invalid IR).
fn deferBlockHelper() {
    if true {
        j := 41
        defer fn() { deferBlockCapStore(strconv.Itoa(j)) }()
    }
}

// TestDeferBlockCapture verifies a deferred capturing literal sees a
// block-scoped variable correctly (comp_error.md #41).
pub fn TestDeferBlockCapture() {
    deferBlockSeen = ""
    deferBlockHelper()
    testing.AssertEqualString("41", deferBlockSeen, "deferred literal captures block-scoped var")
}

// deferLoopCount / deferLoopSum record how many times deferred calls ran
// and which iteration values they saw.
var deferLoopCount: int
var deferLoopSum: int

fn deferLoopSink(v: int) {
    deferLoopCount = deferLoopCount + 1
    deferLoopSum = deferLoopSum + v
}

// deferLoopHelper registers a deferred call per loop iteration; each
// registration must survive to function exit and see the argument value
// as evaluated at its own defer statement (comp_error.md #42).
fn deferLoopHelper() {
    for i := 0; i < 3; i = i + 1 {
        defer deferLoopSink(i)
    }
}

// TestDeferLoopAccumulates verifies defers inside a loop register once
// per iteration with registration-time argument values (comp_error.md
// #42 — previously the compile-time deferred list emitted one call per
// defer site with exit-time values).
pub fn TestDeferLoopAccumulates() {
    deferLoopCount = 0
    deferLoopSum = 0
    deferLoopHelper()
    testing.AssertEqualInt(3, deferLoopCount, "one deferred call per loop iteration")
    testing.AssertEqualInt(3, deferLoopSum, "deferred args captured per iteration (0+1+2)")
}

// deferOrderLog accumulates the order deferred calls run in.
var deferOrderLog: string

fn deferOrderSink(s: string) {
    deferOrderLog = str.Concat(deferOrderLog, s)
}

// deferOrderHelper interleaves loop-iteration defers; LIFO unwind must
// produce d2,c2,d1,c1 order.
fn deferOrderHelper() {
    for i := 0; i < 2; i = i + 1 {
        defer deferOrderSink(str.Concat("c", strconv.Itoa(i)))
        defer deferOrderSink(str.Concat("d", strconv.Itoa(i)))
    }
}

// TestDeferLoopOrder verifies per-iteration registrations unwind in LIFO
// order across iterations (comp_error.md #42).
pub fn TestDeferLoopOrder() {
    deferOrderLog = ""
    deferOrderHelper()
    testing.AssertEqualString("d1c1d0c0", deferOrderLog, "loop defers unwind LIFO across iterations")
}

// === comp_error.md #36: erased composite generics ===
//
// Generic functions with a []T/map[K]V parameter instantiated with a
// non-pointer-sized element type are now rejected at check time — under
// type erasure the generic body indexes with an i8* stride that cannot
// read 4-byte elements. The pointer-sized instantiations and bare-scalar
// generics must keep working.

// mapStr36 is the Map<T,U> shape from the issue restricted to the
// pointer-sized element types erasure can represent.
fn mapStr36<T, U>(items: []T, f: fn(T) -> U) -> []U {
    out := make([]U, len(items))
    for i := 0; i < len(items); i = i + 1 {
        out[i] = f(items[i])
    }
    return out
}

// TestGenericSlicePointerElem verifies generic []T parameters keep
// working for pointer-sized element types (comp_error.md #36).
pub fn TestGenericSlicePointerElem() {
    out := mapStr36<string, string>([]string{"a", "b"}, str.ToUpper)
    testing.AssertEqualInt(2, len(out), "generic []string map length")
    testing.AssertEqualString("A", out[0], "generic []string map element")
}

// TestGenericScalarStillWorks verifies bare-scalar generic parameters
// are unaffected by the #36 composite-element rejection.
pub fn TestGenericScalarStillWorks() {
    testing.AssertEqualInt(5, idOf31(5), "scalar generic int")
    testing.AssertEqualString("ok", idOf31("ok"), "scalar generic string")
}

// TestRecursiveClosure verifies a literal assigned to a declared fn var
// can call itself recursively through its own captured variable.
pub fn TestRecursiveClosure() {
    var fact fn(int) -> int
    fact = fn(x: int) -> int {
        if x <= 1 {
            return 1
        }
        return x * fact(x - 1)
    }
    testing.AssertEqualInt(120, fact(5), "self-referential closure")
}

// TestClosureCapturesHeapTypes verifies captured slices and maps stay
// alive and readable through the env (RC-managed captures).
pub fn TestClosureCapturesHeapTypes() {
    scores := []int{10, 20}
    readFirst := fn() -> int { return scores[0] }
    m := make(map[string]int)
    m["k"] = 3
    readMap := fn() -> int { return m["k"] }
    testing.AssertEqualInt(10, readFirst(), "captured slice element")
    testing.AssertEqualInt(3, readMap(), "captured map element")
}

// TestClosureAndPointerAlias verifies that a variable which is both
// captured by literals and address-taken via `&` has exactly one shared
// box — writes through either view are visible to the other.
pub fn TestClosureAndPointerAlias() {
    v := 1
    p := &v
    bump := fn() { v = v + 100 }
    bump()
    testing.AssertEqualInt(101, *p, "pointer sees capture write")
    *p = 7
    read := fn() -> int { return v }
    testing.AssertEqualInt(7, read(), "capture sees pointer write")
    testing.AssertEqualInt(7, v, "variable agrees")
}

// TestForInVarCapture verifies a literal created inside a for-in body can
// capture the element variable.
pub fn TestForInVarCapture() {
    total := 0
    for x in []int{1, 2, 3} {
        f := fn() -> int { return x }
        total = total + f()
    }
    testing.AssertEqualInt(6, total, "for-in element capture")
}

// === Captured pointer vars and &ptr (regression after the #39 fix) ===
//
// The #39 fix boxes captured variables at declaration time — including
// pointer-typed variables. emitAddressOf then returned the box pointer
// for `&ptr`, so `spawn worker(&wg)` (book concurrency recipes) passed a
// **WaitGroup bit-pattern to a *WaitGroup parameter and the worker
// segfaulted. `&ptr` on a boxed pointer variable must load the pointer
// value stored inside the box, keeping object-pointer semantics.

struct CapPtrCell {
    n: int
}

// capPtrRead reads through a *CapPtrCell parameter — if &c handed it the
// capture box instead of the object pointer the field read is garbage.
fn capPtrRead(p: *CapPtrCell) -> int {
    return p.n
}

// capPtrWrite writes through a *CapPtrCell parameter.
fn capPtrWrite(p: *CapPtrCell, v: int) {
    p.n = v
}

// TestCapturedPointerAddressOf verifies `&p` on a pointer variable that
// is also captured by a literal still passes the object pointer (the
// value stored in the capture box) to *T parameters, not the box itself.
pub fn TestCapturedPointerAddressOf() {
    c := &CapPtrCell{n: 5}
    read := fn() -> int { return c.n }
    testing.AssertEqualInt(5, capPtrRead(&c), "&ptr passes the object pointer")
    capPtrWrite(&c, 42)
    testing.AssertEqualInt(42, c.n, "write through &ptr reaches the object")
    testing.AssertEqualInt(42, read(), "capture sees write through &ptr")
}

// capPtrEcho sends the pointed-to field over a channel — the worker
// dereferences its argument, so receiving the box pointer instead of the
// object pointer crashes inside the spawned thread (as in the book
// worker-pool recipe).
fn capPtrEcho(p: *CapPtrCell, ch: chan<int>) {
    ch <- p.n
}

// TestSpawnCapturedPointerArg mirrors the crash: a pointer variable that
// is captured by a deferred literal is also passed by `&` to spawn.
pub fn TestSpawnCapturedPointerArg() {
    c := &CapPtrCell{n: 7}
    defer fn() { c.n = c.n }()
    ch := make(chan<int>, 1)
    spawn capPtrEcho(&c, ch)
    got := <-ch
    testing.AssertEqualInt(7, got, "spawn received the object pointer, not the box")
}

// === #37 follow-up: mod.fn used as a value in more positions ===
//
// The #37 fix made `mod.fn` resolve its semantic fn type when passed as a
// call argument. These cover the other positions a module-qualified
// function can appear as a value: local inference, struct fields, field
// read-back, return position, slice literals, and map values.

// TestModuleFnLocalVar verifies `f := strconv.Itoa` infers the fn type
// and calls through the local.
pub fn TestModuleFnLocalVar() {
    itoa := strconv.Itoa
    testing.AssertEqualString("42", itoa(42), "mod.fn in := local")
}

// FnHolder stores a function value in a struct field.
struct FnHolder {
    f: fn(int) -> string
}

// TestModuleFnStructField verifies `mod.fn` stored in a struct field is
// callable through the field, including after copying the field to a
// local.
pub fn TestModuleFnStructField() {
    h := FnHolder{f: strconv.Itoa}
    testing.AssertEqualString("77", h.f(77), "mod.fn through struct field")
    g := h.f
    testing.AssertEqualString("5", g(5), "mod.fn field copied to local")
}

// getModFn returns a module-qualified function as a value.
fn getModFn() -> fn(int) -> string {
    return strconv.Itoa
}

// TestModuleFnReturnValue verifies `return mod.fn` produces a callable
// fn-typed value.
pub fn TestModuleFnReturnValue() {
    f := getModFn()
    testing.AssertEqualString("7", f(7), "mod.fn as return value")
}

// TestModuleFnInSliceAndMap verifies `mod.fn` values work inside slice
// literals and as map values.
pub fn TestModuleFnInSliceAndMap() {
    arr := []fn(int) -> string{strconv.Itoa, strconv.Itoa}
    testing.AssertEqualString("12", arr[0](1) + arr[1](2), "mod.fn in slice literal")
    m := make(map[string]fn(int) -> string)
    m["i"] = strconv.Itoa
    testing.AssertEqualString("9", m["i"](9), "mod.fn as map value")
}

// === comp_error.md #38: parenthesized assignment targets ===
//
// `(*p) = v` / `(x) = v` used to fail to parse — a `(`-leading statement
// was glued to the previous line's expression as a call, leaving the `=`
// orphaned. These verify paren targets assign through to the real lvalue.

// TestParenAssignDeref verifies `(*p) = v` stores through the pointer.
pub fn TestParenAssignDeref() {
    x := 1
    p := &x
    (*p) = 66
    testing.AssertEqualInt(66, x, "(*p) = 66 writes x")
}

// TestParenAssignIdent verifies `(x) = v` assigns the plain variable.
pub fn TestParenAssignIdent() {
    x := 1
    (x) = 42
    testing.AssertEqualInt(42, x, "(x) = 42 writes x")
}

// TestParenAssignCompound verifies `(*p) += v` compounds through the
// dereferenced pointer.
pub fn TestParenAssignCompound() {
    x := 5
    p := &x
    (*p) += 7
    testing.AssertEqualInt(12, x, "(*p) += 7 writes x")
}

// TestParenAssignNewlineStmt verifies a `(`-initial statement is not
// glued onto the previous line's expression as a call — the exact #38
// misparse (`p := &x` followed by `(*p)` used to read `&x(*p)`).
pub fn TestParenAssignNewlineStmt() {
    x := 10
    p := &x
    (x) = 3
    testing.AssertEqualInt(3, *p, "paren stmt after pointer init")
}

// === comp_error.md #39: captures inside `for i :=` loop bodies ===
//
// The captured variable's box used to be allocated at the literal's
// evaluation site — inside the loop body — so each iteration re-boxed
// from the already-zeroed alloca (outer vars read 0, the loop counter
// never advanced). Captured vars now box at declaration time.

// TestClosureCapturesOuterInForLoop verifies an outer-scope variable
// captured by a literal created inside a `for i :=` body reads the same
// shared box on every iteration.
pub fn TestClosureCapturesOuterInForLoop() {
    n := 7
    total := 0
    for i := 0; i < 3; i = i + 1 {
        f := fn() -> int { return n }
        total = total + f()
    }
    testing.AssertEqualInt(21, total, "outer capture stable across iterations")
}

// TestClosureCapturesLoopCounter verifies capturing the `for i :=`
// counter lets the loop advance (the counter's box is created at its
// declaration before the loop, not re-created per iteration).
pub fn TestClosureCapturesLoopCounter() {
    total := 0
    for i := 0; i < 3; i = i + 1 {
        f := fn() -> int { return i }
        total = total + f()
    }
    testing.AssertEqualInt(3, total, "counter capture reads 0+1+2")
}

// TestClosureCapturesOuterMutation verifies a capture that writes an
// outer variable through the shared box from inside a loop iteration.
pub fn TestClosureCapturesOuterMutation() {
    n := 0
    for i := 0; i < 4; i = i + 1 {
        bump := fn() { n = n + 1 }
        bump()
    }
    testing.AssertEqualInt(4, n, "outer capture write persists")
}

// === comp_error.md #40: literal params shadow same-named captures ===
//
// A literal parameter must win over a same-named enclosing variable —
// the capture scan collected every ident, so the env view used to
// overwrite the param binding.

// TestClosureParamShadowsCapture verifies `fn(n) { return n }` returns
// the argument, not the captured outer `n`.
pub fn TestClosureParamShadowsCapture() {
    n := 100
    show := fn(n: int) -> int { return n }
    testing.AssertEqualInt(5, show(5), "param shadows outer capture")
    testing.AssertEqualInt(100, n, "outer n unchanged")
}

// === comp_error.md #44: non-decimal int literals in i64 casts ===
//
// emitCast returned the raw literal text for i64 casts, so
// `uint64(0x0f)` emitted `and i64 %r, 0x0f` — LLVM parses leading `0x`
// as a hex *float* constant and Clang rejects it. Literals are now
// normalized to decimal before reaching the IR.

// TestHexLiteralI64Cast verifies hex literals inside int64/uint64 casts
// emit decimal LLVM IR constants and evaluate correctly.
pub fn TestHexLiteralI64Cast() {
    x := uint64(0x0f)
    testing.AssertEqualInt(15, int(x), "uint64(0x0f) is 15")
    y := int64(0xff)
    testing.AssertEqualInt(255, int(y), "int64(0xff) is 255")
    v := uint64(255) & uint64(0x0f)
    testing.AssertEqualInt(15, int(v), "bitwise and with hex cast operand")
}

// TestBinOctLiteralI64Cast verifies binary and octal literals take the
// same normalization path as hex.
pub fn TestBinOctLiteralI64Cast() {
    b := int64(0b1010)
    testing.AssertEqualInt(10, int(b), "int64(0b1010) is 10")
    o := int64(0o17)
    testing.AssertEqualInt(15, int(o), "int64(0o17) is 15")
}

// TestLargeHexLiteralI64Cast verifies a hex literal that exceeds the
// parser's i32 intVal still round-trips through the strVal path — the
// reason strVal is emitted for i64 casts in the first place.
pub fn TestLargeHexLiteralI64Cast() {
    h := int64(0xdead_beef)
    expected := int64(3735928559)
    testing.AssertTrue(h == expected, "hex beyond i32 and with separators")
    big := int64(6364136223846793005)
    testing.AssertTrue(big > int64(0), "large decimal i64 literal still works")
}

// === comp_error.md #69: for-in over a nil slice ===
//
// emitForInStmt read the length header at ptr-8 unconditionally, so
// iterating a nil slice (e.g. a never-initialised struct field reached
// through a pointer) dereferenced null. The emitter now nil-guards the
// length load.

struct nilSliceBox {
    items: []int
    pairs: []nilPair
}

struct nilPair {
    a: string
    b: string
}

// TestForInNilSliceField verifies for-in over a nil slice field of a
// pointer-to-struct iterates zero times instead of segfaulting.
pub fn TestForInNilSliceField() {
    b := &nilSliceBox{}
    count := 0
    for x in b.items {
        count = count + x
    }
    testing.AssertEqualInt(0, count, "nil slice field iterates zero times")
    for p in b.pairs {
        count = count + str.Len(p.a)
    }
    testing.AssertEqualInt(0, count, "nil struct-slice field iterates zero times")
}

// TestForInNilSliceFromCall verifies a nil slice produced by a function
// return also iterates safely.
pub fn TestForInNilSliceFromCall() {
    n := 0
    items := nilSliceSource(0)
    for x in items {
        n = n + x
    }
    testing.AssertEqualInt(0, n, "nil slice from call iterates zero times")
}

// nilSliceSource returns an uninitialised slice — nil backing pointer.
fn nilSliceSource(n: int) -> []int {
    var s []int
    return s
}

// litStack112 is a generic struct instantiated via a literal in tests for
// comp_error.md #112 (struct-literal field checks must substitute the
// literal's type arguments into the declared field types).
struct litStack112<T> {
    items: []T

    pub fn push(self: *litStack112<T>, item: T) {
        self.items = append(self.items, item)
    }
}

// TestGenericStructLitSubst verifies generic struct literals type-check
// when field values use the concrete instantiated type — previously the
// checker compared the field value against raw `[]T` (comp_error.md #112).
// Uses string elements: instantiating a []T field with a non-pointer-sized
// T is rejected by the erased-composite guard (comp_error.md #142).
pub fn TestGenericStructLitSubst() {
    s := litStack112<string>{items: []string{}}
    s.push("a")
    s.push("b")
    testing.AssertEqualInt(2, len(s.items), "generic struct literal field type")
    testing.AssertEqualString("b", s.items[1], "generic struct literal value")
}

// litChan112 exercises a chan<T> field in a generic struct literal
// (comp_error.md #112 — substituteType must handle TK_CHAN).
struct litChan112<T> {
    ch: chan<T>
}

// TestGenericStructLitChan verifies chan<T> fields accept chan<int>
// values in generic struct literals.
pub fn TestGenericStructLitChan() {
    q := litChan112<int>{ch: make(chan<int>, 2)}
    q.ch <- 4
    q.ch <- 5
    testing.AssertEqualInt(4, <-q.ch, "generic chan field recv 1")
    testing.AssertEqualInt(5, <-q.ch, "generic chan field recv 2")
}

// globalMap113 is declared without an initializer to exercise the
// module-level map default-init path (comp_error.md #113 — previously
// such globals emitted no %map_ type decl and stayed null, so the
// first assignment panicked with "assignment to entry in nil map").
var globalMap113 map[string]int

// TestModuleLevelMapDefaultInit verifies an uninitialized module-level
// map starts as a usable empty map (issue #113).
pub fn TestModuleLevelMapDefaultInit() {
    testing.AssertEqualInt(0, len(globalMap113), "global map starts empty")
    globalMap113["k"] = 42
    testing.AssertEqualInt(42, globalMap113["k"], "global map assign")
    testing.AssertEqualInt(1, len(globalMap113), "global map len after assign")
}

// noneErrHelper returns a zero-valued errors.Error paired with a value,
// exercising the `err != nil` comparison on a struct error whose
// message field is null (previously the emitter generated a byte load
// through the null message pointer — segfault at runtime).
fn noneErrHelper() -> (int, errors.Error) {
    return 7, errors.None()
}

// TestNilErrorStructCmp guards the `err == nil`/`!= nil` path for
// value-type errors.Error: a zero error must compare equal to nil
// without dereferencing the null message pointer.
pub fn TestNilErrorStructCmp() {
    v, err := noneErrHelper()
    testing.AssertEqualInt(7, v, "value component")
    testing.AssertTrue(err == nil, "errors.None() compares equal to nil")
    testing.AssertFalse(err != nil, "errors.None() not != nil")
    v2, err2 := noneErrHelper()
    _ = v2
    if err2 != nil {
        testing.Fail()
    }
}

// TestStringLitNilNotNilLiteral guards the parser fix where a string
// literal containing exactly "nil" was classified as a nil literal
// (isNilLit matched token text before checking T_STRING), emitting
// i8* null instead of a string global.
pub fn TestStringLitNilNotNilLiteral() {
    s := "nil"
    testing.AssertEqualInt(3, len(s), `"nil" is a 3-byte string`)
    testing.AssertEqualString("nil", s, `string value is "nil"`)
}

// TestI64NegLiteralCast guards comp_error.md #121: int64(-N) for
// N > i32::MAX must yield the true negative i64, not the i32-truncated
// magnitude negated. The RHS -int64(N) is the correct-by-construction
// path (literal widened, then negated at runtime).
pub fn TestI64NegLiteralCast() {
    a := int64(-5000000000)
    testing.AssertTrue(a == -int64(5000000000),
        "int64(-5000000000) should equal -int64(5000000000)")
    b := int64(-9876543210)
    testing.AssertTrue(b == -int64(9876543210),
        "int64(-9876543210) should equal -int64(9876543210)")
    testing.AssertEqualString("-5000000000", strconv.Itoa64(a),
        "int64(-5000000000) should render as -5000000000")
    // Hex and underscored literals under unary minus take the same path.
    c := int64(-0x123456789)
    testing.AssertTrue(c == -int64(0x123456789),
        "int64(-0x123456789) should equal -int64(0x123456789)")
    // Regression guard: positive literals and in-range negatives unchanged.
    d := int64(-7)
    testing.AssertTrue(d == int64(-7), "int64(-7) should still work")
    e := int64(9223372036854775807)
    testing.AssertEqualString("9223372036854775807", strconv.Itoa64(e),
        "INT64_MAX positive literal should be unchanged")
}

// libc/runtime declarations for the stdout-capture test below. `close`
// is the channel builtin, so fd teardown goes through Skink_close_fd
// (net_rt.c — linked into every program).
extern fn open(path: string, flags: int, mode: int) -> int
extern fn dup(fd: int) -> int
extern fn dup2(oldfd: int, newfd: int) -> int
extern fn fflush(fp: int64) -> int
extern fn Skink_close_fd(fd: int) -> int

// TestPrintMultiArg guards comp_error.md #124: print/println are
// declared variadic, so every argument must be emitted — previously
// only the first was, and print(a, ": ", b) silently printed just a.
// stdout is redirected to a temp file via dup2 so the emitted text can
// be asserted byte-for-byte.
pub fn TestPrintMultiArg() {
    path := "/tmp/skink_print_capture.txt"
    fs.Remove(path)
    saved := dup(1)
    // O_WRONLY|O_CREAT|O_TRUNC = 577, mode 0666 = 438 (Linux).
    fd := open(path, 577, 438)
    testing.AssertTrue(fd >= 0, "open capture file")
    dup2(fd, 1)
    print("a", "b", "c")
    println("x", "y")
    print(1, 2.5, "z")
    fflush(0)
    dup2(saved, 1)
    Skink_close_fd(saved)
    Skink_close_fd(fd)
    data, rerr := fs.ReadAll(path)
    testing.AssertTrue(rerr.message == "", "read capture file")
    testing.AssertEqualString("abcxy\n12.500000z", data,
        "print emits every argument in order")
    fs.Remove(path)
}

struct MapAndSetFieldHolder {
    scores: map[string]int16
    flags: set<int16>
    unusedMap: map[string]int8
    unusedSet: set<int8>
    label: string
}

// TestStructMapAndSetFields guards comp_error.md #138: structs containing
// map[K]V or set<T> fields must emit the corresponding %map_... and %set....
// LLVM struct declarations even when the map/set type only appears as a
// struct field.
pub fn TestStructMapAndSetFields() {
    var h MapAndSetFieldHolder
    h.label = "ok"
    testing.AssertEqualString("ok", h.label, "struct with map and set fields")
    testing.AssertEqualInt(0, len(h.scores), "uninitialized map struct field len")
    testing.AssertEqualInt(0, len(h.flags), "uninitialized set struct field len")
    h.scores = make(map[string]int16)
    h.scores["alpha"] = int16(10)
    h.scores["beta"] = int16(25)
    testing.AssertEqualInt(2, len(h.scores), "populated map struct field len")
    testing.AssertEqualInt(10, int(h.scores["alpha"]), "map struct field alpha")
    testing.AssertEqualInt(25, int(h.scores["beta"]), "map struct field beta")
}

// === comp_error.md #125 — cross-module fn-type alias unification ===
// types.Middleware-style aliases keep the inner alias nominal on the
// expected side while declared functions report the expanded signature;
// the checker now unifies aliases recursively inside composite types.

// rhLogMw is a middleware written against the helper module's aliases —
// this is the exact shape that failed to compile before the fix.
fn rhLogMw(next: regress_helper.RHHandler) -> regress_helper.RHHandler {
    return fn(r: regress_helper.RHReq, w: *regress_helper.RHResp) {
        next(r, w)
    }
}

// TestMiddlewareAliasUnify guards comp_error.md #125: a fn(Handler) ->
// Handler value must be assignable to a Middleware alias parameter.
pub fn TestMiddlewareAliasUnify() {
    testing.AssertEqualInt(0, regress_helper.ApplyMiddleware(rhLogMw), "middleware alias accepts structural fn")
    var m regress_helper.RHMiddleware = rhLogMw
    _ = m
}

// === comp_error.md #128 — simple enums are transparent int aliases ===
// Previously nothing could produce a value of a nominal enum type:
// `var k CFKind = CFKindA` and `take(CFKindB)` were rejected.

enum CFKind {
    CFKindA
    CFKindB
}

fn takeKind(k: CFKind) -> int {
    return k
}

// TestEnumNominalUse guards comp_error.md #128.
pub fn TestEnumNominalUse() {
    var k CFKind = CFKindA
    testing.AssertEqualInt(0, takeKind(k), "enum value assignable to enum type")
    testing.AssertEqualInt(1, takeKind(CFKindB), "enum const passed to enum param")
    testing.AssertEqualInt(1, takeKind(CFKind(1)), "enum conversion Kind(int)")
    switch k {
    case CFKindA:
        testing.AssertTrue(true, "case on enum subject")
    default:
        testing.Fail()
    }
}

// === comp_error.md #129 — byte is a transparent uint8 alias ===

// TestByteSliceAssign guards comp_error.md #129: element assignment into
// a []byte must accept int literals and uint8 values like []uint8 does.
pub fn TestByteSliceAssign() {
    f := make([]byte, 4)
    f[0] = 30
    f[1] = uint8(7)
    testing.AssertEqualInt(37, int(f[0]) + int(f[1]), "[]byte element assign")
}

// === comp_error.md #131 — fn declared before its struct return type ===
// mkFwdCfg is declared textually BEFORE struct FwdCfg; reading a field
// off the returned value previously emitted `ptr` instead of i32.

fn mkFwdCfg() -> (FwdCfg, errors.Error) {
    return FwdCfg{port: 42}, errors.None()
}

struct FwdCfg {
    port: int
}

// TestFnBeforeStructReturn guards comp_error.md #131.
pub fn TestFnBeforeStructReturn() {
    c, _ := mkFwdCfg()
    testing.AssertEqualInt(42, c.port, "forward-declared struct return field")
}

// === comp_error.md #132 — &s[i] on a string strides 1 byte ===

// TestStringAddrOfIndex guards comp_error.md #132: &s[i] must compute
// base+i (stride 1), matching byte-wise s[i] semantics — it previously
// stepped 4 bytes per index.
pub fn TestStringAddrOfIndex() {
    s := "abcdef0123456789"
    p0 := int64(&s[0])
    p1 := int64(&s[1])
    p2 := int64(&s[2])
    testing.AssertTrue(p1 - p0 == 1, "&s[1] - &s[0] stride")
    testing.AssertTrue(p2 - p0 == 2, "&s[2] - &s[0] stride")
}

// === comp_error.md #133 — wide int literals in int64 contexts ===

// TestInt64LiteralContext guards comp_error.md #133: an integer literal
// wider than i32 assigned to or combined with int64 must keep its full
// value — it was silently truncated to int32 and sign-extended.
pub fn TestInt64LiteralContext() {
    var b int64 = 2208988800
    testing.AssertTrue(b == 2208988800, "var int64 = literal > i32 max")
    secs := b - 2208988800
    testing.AssertTrue(secs == 0, "int64 op with oversized literal")
    testing.AssertTrue(int64(0) - 2208988800 == -2208988800, "0 - oversized literal")
}

// === comp_error.md #134 — tuple assignment to package-level vars ===

struct TupleBox {
    v: int
}

var cfTupleGlobal TupleBox
var cfTupleFlag bool

fn mkTuplePair() -> (TupleBox, bool) {
    return TupleBox{v: 42}, true
}

// TestGlobalTupleAssign guards comp_error.md #134: `g, _ = mk()` on a
// package-level var was silently dropped, leaving the zero value.
pub fn TestGlobalTupleAssign() {
    cfTupleGlobal, cfTupleFlag = mkTuplePair()
    testing.AssertEqualInt(42, cfTupleGlobal.v, "global tuple-assign value")
    testing.AssertTrue(cfTupleFlag, "global tuple-assign second value")
}
