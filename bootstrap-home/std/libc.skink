module libc

extern fn Skink_raw_alloc(size: int64) -> string
extern fn Skink_mem_realloc(ptr: string, size: int64) -> string
extern fn Skink_mem_free(ptr: string)
extern fn Skink_raw_calloc(num: int64, size: int64) -> string

// malloc allocates size bytes of uninitialized heap memory and returns
// a string (raw pointer) to the allocated block.
pub fn malloc(size: int) -> string {
    return Skink_raw_alloc(int64(size))
}

// realloc resizes the previously allocated block ptr to size bytes,
// copying existing contents as needed, and returns the new pointer.
pub fn realloc(ptr: string, size: int) -> string {
    return Skink_mem_realloc(ptr, int64(size))
}

// free releases a heap block previously allocated by malloc or realloc.
pub fn free(ptr: string) {
    Skink_mem_free(ptr)
}

// calloc allocates zero-initialized memory for num elements of size bytes each.
pub fn calloc(num: int, size: int) -> string {
    return Skink_raw_calloc(int64(num), int64(size))
}

// The n/size/count parameters below are size_t in C — 64-bit. Declaring
// them int (i32) leaves the upper half of the argument register
// undefined, so the callee can read a garbage length (comp_error.md
// #145). int call-site arguments sign-extend automatically.
extern fn memcpy(dest: string, src: string, n: int64) -> string
extern fn memset(dest: string, c: int, n: int64) -> string
extern fn strlen(s: string) -> int
extern fn strcmp(a: string, b: string) -> int
extern fn strstr(haystack: string, needle: string) -> string
extern fn strcpy(dest: string, src: string) -> string
extern fn strncpy(dest: string, src: string, n: int64) -> string
extern fn strcat(dest: string, src: string) -> string
extern fn strchr(s: string, c: int) -> string
extern fn tolower(c: int) -> int
extern fn toupper(c: int) -> int
