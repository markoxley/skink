module dot_norm_test

import "testing"

// TestDot verifies dot product of two float slices.
pub fn TestDot() {
    a := []float{1.0, 2.0, 3.0}
    b := []float{4.0, 5.0, 6.0}
    testing.AssertEqualFloat(32.0, dot(a, b), "1*4+2*5+3*6=32")
}

// TestNorm verifies norm (magnitude) of a float vector.
pub fn TestNorm() {
    v := []float{3.0, 4.0}
    testing.AssertEqualFloat(5.0, norm(v), "3-4-5 triangle")
}
