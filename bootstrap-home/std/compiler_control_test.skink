module compiler_control_test

import "testing"

// === If / Else ===

// TestIfTrue verifies if branch executes when condition is true.
pub fn TestIfTrue() {
    x := 5
    result := 0
    if x > 0 {
        result = 1
    }
    testing.AssertEqualInt(1, result, "if true branch")
}

// TestIfFalse verifies if body skipped when condition is false.
pub fn TestIfFalse() {
    x := -5
    result := 0
    if x > 0 {
        result = 1
    }
    testing.AssertEqualInt(0, result, "if false branch not taken")
}

// TestIfElse verifies else branch executes when condition is false.
pub fn TestIfElse() {
    x := 5
    result := 0
    if x > 10 {
        result = 1
    } else {
        result = 2
    }
    testing.AssertEqualInt(2, result, "if-else else branch")
}

// TestIfElseIf verifies else-if branch selection.
pub fn TestIfElseIf() {
    x := 15
    result := 0
    if x < 10 {
        result = 1
    } else if x < 20 {
        result = 2
    } else {
        result = 3
    }
    testing.AssertEqualInt(2, result, "if-else-if second branch")
}

// TestIfElseIfLast verifies final else branch in else-if chain.
pub fn TestIfElseIfLast() {
    x := 25
    result := 0
    if x < 10 {
        result = 1
    } else if x < 20 {
        result = 2
    } else {
        result = 3
    }
    testing.AssertEqualInt(3, result, "if-else-if final else")
}

// TestIfElseIfNoElse verifies no branch taken without else.
pub fn TestIfElseIfNoElse() {
    x := 25
    result := 0
    if x < 10 {
        result = 1
    } else if x < 20 {
        result = 2
    }
    testing.AssertEqualInt(0, result, "if-else-if no branch taken")
}

// TestNestedIf verifies nested if-else inside if branch.
pub fn TestNestedIf() {
    x := 10
    y := 20
    result := 0
    if x > 5 {
        if y > 15 {
            result = 1
        } else {
            result = 2
        }
    } else {
        result = 3
    }
    testing.AssertEqualInt(1, result, "nested if inner-true")
}

// TestIfWithComplexCondition verifies if with && and || conditions.
pub fn TestIfWithComplexCondition() {
    x := 5
    y := 10
    testing.AssertTrue(x > 0 && y > 0, "complex && condition")
    testing.AssertTrue(x > 0 || y < 0, "complex || condition")
    testing.AssertFalse(x > 10 && y > 5, "complex && false")
}

// === For Loops ===

// TestForCStyle verifies C-style for loop with init/cond/post.
pub fn TestForCStyle() {
    sum := 0
    for i := 0; i < 10; i = i + 1 {
        sum += i
    }
    testing.AssertEqualInt(45, sum, "sum 0..9 C-style for")
}

// TestForCStyleWithCompound verifies for loop with += in post position.
pub fn TestForCStyleWithCompound() {
    sum := 0
    for i := 0; i < 10; i += 1 {
        sum += i
    }
    testing.AssertEqualInt(45, sum, "sum 0..9 with += in post")
}

// TestForConditionOnly verifies for loop with condition only (no init/post).
pub fn TestForConditionOnly() {
    i := 0
    sum := 0
    for i < 5 {
        sum += i
        i = i + 1
    }
    testing.AssertEqualInt(10, sum, "condition-only for loop")
}

// TestForInfiniteWithBreak verifies infinite for loop with break.
pub fn TestForInfiniteWithBreak() {
    i := 0
    for {
        if i >= 10 {
            break
        }
        i += 1
    }
    testing.AssertEqualInt(10, i, "infinite for with break")
}

// TestForInRangeSlice verifies for-in range over slice elements.
pub fn TestForInRangeSlice() {
    arr := []int{10, 20, 30, 40, 50}
    sum := 0
    for v := range arr {
        sum += v
    }
    testing.AssertEqualInt(150, sum, "for-in range over slice")
}

// TestForInRangeString verifies for-in range over string characters.
pub fn TestForInRangeString() {
    s := "abc"
    count := 0
    for _ := range s {
        count += 1
    }
    testing.AssertEqualInt(3, count, "for-in range over string")
}

// TestForInMap verifies for-in range over map keys.
pub fn TestForInMap() {
    m := make(map[string]int)
    m["a"] = 1
    m["b"] = 2
    m["c"] = 3
    total := 0
    for k := range m {
        total += m[k]
    }
    testing.AssertEqualInt(6, total, "for-in range over map values sum")
}

// TestForWithContinue verifies continue skips iteration in for loop.
pub fn TestForWithContinue() {
    sum := 0
    for i := 0; i < 10; i = i + 1 {
        if i % 2 == 0 {
            continue
        }
        sum += i
    }
    testing.AssertEqualInt(25, sum, "sum of odd 1..9 with continue")
}

// TestForWithBreak verifies break exits for loop early.
pub fn TestForWithBreak() {
    found := -1
    arr := []int{5, 10, 15, 20, 25}
    for i := 0; i < len(arr); i = i + 1 {
        if arr[i] == 15 {
            found = i
            break
        }
    }
    testing.AssertEqualInt(2, found, "for loop with break")
}

// TestNestedForBreak verifies break in nested for only exits inner loop.
pub fn TestNestedForBreak() {
    result := 0
    for i := 0; i < 3; i = i + 1 {
        for j := 0; j < 3; j = j + 1 {
            if j == 2 {
                break
            }
            result += 1
        }
    }
    testing.AssertEqualInt(6, result, "nested for with inner break")
}

// TestNestedForContinue verifies continue in nested for skips inner body.
pub fn TestNestedForContinue() {
    result := 0
    for i := 0; i < 3; i = i + 1 {
        for j := 0; j < 3; j = j + 1 {
            if j == 1 {
                continue
            }
            result += 1
        }
    }
    testing.AssertEqualInt(6, result, "nested for with inner continue")
}

// TestForEmptyBody verifies for loop runs correct number of iterations.
pub fn TestForEmptyBody() {
    count := 0
    for i := 0; i < 5; i = i + 1 {
        count += 1
    }
    testing.AssertEqualInt(5, count, "for loop runs correct count")
}

// TestForPostDecrement verifies for loop with decrementing counter.
pub fn TestForPostDecrement() {
    sum := 0
    for i := 10; i > 0; i = i - 1 {
        sum += 1
    }
    testing.AssertEqualInt(10, sum, "for loop with decrement")
}

// === While Loops ===

// TestWhileBasic verifies while loop runs until condition is false.
pub fn TestWhileBasic() {
    i := 0
    while i < 10 {
        i = i + 1
    }
    testing.AssertEqualInt(10, i, "while loop basic")
}

// TestWhileBreak verifies while loop with break statement.
pub fn TestWhileBreak() {
    i := 0
    while true {
        if i >= 5 {
            break
        }
        i += 1
    }
    testing.AssertEqualInt(5, i, "while with break")
}

// TestWhileContinue verifies while loop with continue statement.
pub fn TestWhileContinue() {
    i := 0
    sum := 0
    while i < 10 {
        i += 1
        if i % 2 == 0 {
            continue
        }
        sum += i
    }
    testing.AssertEqualInt(25, sum, "while with continue (odd 1..9)")
}

// === Until Loops ===

// TestUntilBasic verifies until loop runs until condition is true.
pub fn TestUntilBasic() {
    i := 0
    until i >= 10 {
        i = i + 1
    }
    testing.AssertEqualInt(10, i, "until loop basic")
}

// TestUntilBreak verifies until loop with break statement.
pub fn TestUntilBreak() {
    i := 0
    until false {
        if i >= 7 {
            break
        }
        i += 1
    }
    testing.AssertEqualInt(7, i, "until with break")
}

// === Switch Statements ===

// TestSwitchBasic verifies switch statement case selection.
pub fn TestSwitchBasic() {
    x := 2
    result := 0
    switch x {
    case 1:
        result = 10
    case 2:
        result = 20
    case 3:
        result = 30
    default:
        result = 0
    }
    testing.AssertEqualInt(20, result, "switch case 2")
}

// TestSwitchDefault verifies switch default branch when no case matches.
pub fn TestSwitchDefault() {
    x := 99
    result := 0
    switch x {
    case 1:
        result = 10
    case 2:
        result = 20
    default:
        result = -1
    }
    testing.AssertEqualInt(-1, result, "switch default")
}

// TestSwitchNoMatch verifies switch keeps value when default matches.
pub fn TestSwitchNoMatch() {
    x := 99
    result := 42
    switch x {
    case 1:
        result = 10
    case 2:
        result = 20
    default:
        result = 42
    }
    testing.AssertEqualInt(42, result, "switch no match, default keeps value")
}

// TestSwitchString verifies switch on string subjects.
pub fn TestSwitchString() {
    s := "hello"
    result := 0
    switch s {
    case "hi":
        result = 1
    case "hello":
        result = 2
    case "hey":
        result = 3
    default:
        result = 0
    }
    testing.AssertEqualInt(2, result, "switch string case")
}

// TestSwitchWithBreak verifies break exits switch case early.
pub fn TestSwitchWithBreak() {
    x := 1
    result := 0
    switch x {
    case 1:
        result = 10
        break
        result = 99 // should not execute
    default:
        result = 0
    }
    testing.AssertEqualInt(10, result, "switch with break")
}

// === Defer ===

// TestDeferBasic verifies defer runs after return value is set.
pub fn TestDeferBasic() {
    result := deferHelper()
    testing.AssertEqualInt(1, result, "defer runs after return value is set")
}

fn deferHelper() -> int {
    x := 1
    defer {
        x = 99 // defer runs but doesn't change return value
    }
    return x // returns 1, then defer runs
}

// TestDeferMultiple verifies multiple defers run in LIFO order.
pub fn TestDeferMultiple() {
    result := deferMultipleHelper()
    testing.AssertEqualString("", result, "defers run after return value is set")
}

fn deferMultipleHelper() -> string {
    s := ""
    defer {
        s = str.Concat(s, "A")
    }
    defer {
        s = str.Concat(s, "B")
    }
    defer {
        s = str.Concat(s, "C")
    }
    // Defers run in LIFO order: C, B, A
    return s
}
