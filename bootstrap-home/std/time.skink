module time

import "std/str"

// C time library external declarations.
extern fn time(t: *int64) -> int64
extern fn localtime(t: *int64) -> *Tm
extern fn gmtime(t: *int64) -> *Tm
extern fn mktime(t: *Tm) -> int64
extern fn sleep(seconds: int) -> int
extern fn usleep(useconds: int) -> int
extern fn clock_gettime(clk: int, ts: *TimeSpec) -> int

// TimeSpec matches the C struct timespec used by clock_gettime.
struct TimeSpec {
    tv_sec: int64  // the seconds
    tv_nsec: int64  // the nanoseconds
}

// Tm is the C standard struct tm used by localtime/gmtime.
struct Tm {
    tm_sec: int  // the seconds (0-60)
    tm_min: int  // the minutes (0-59)
    tm_hour: int  // the hours (0-23)
    tm_mday: int  // the day of the month (1-31)
    tm_mon: int  // the month (0-11)
    tm_year: int  // the years since 1900
    tm_wday: int  // the day of the week (0-6)
    tm_yday: int  // the day of the year (0-365)
    tm_isdst: int  // the daylight-savings flag
    tm_gmtoff: int64  // the offset from GMT in seconds
    tm_zone: string  // the timezone name
}

// Nanosecond is a Duration constant representing one nanosecond.
pub const Nanosecond = int64(1)
// Microsecond is a Duration constant representing one microsecond (1000 ns).
pub const Microsecond = int64(1000)
// Millisecond is a Duration constant representing one millisecond (1,000,000 ns).
pub const Millisecond = int64(1000000)
// Second is a Duration constant representing one second (1,000,000,000 ns).
pub const Second = int64(1000000000)
// Minute is a Duration constant representing one minute (60 seconds).
pub const Minute = int64(60) * Second
// Hour is a Duration constant representing one hour (60 minutes).
pub const Hour = int64(60) * Minute

// Duration represents a length of time in nanoseconds.
pub struct Duration {
    nanoseconds: int64  // the nanoseconds

    // Nanoseconds returns the duration as an int64 nanosecond count.
    pub fn Nanoseconds(self: Duration) -> int64 {
        return self.nanoseconds
    }

    // Microseconds returns the duration as an int64 microsecond count.
    pub fn Microseconds(self: Duration) -> int64 {
        return self.nanoseconds / Microsecond
    }

    // Milliseconds returns the duration as an int64 millisecond count.
    pub fn Milliseconds(self: Duration) -> int64 {
        return self.nanoseconds / Millisecond
    }

    // Seconds returns the duration as a float second count.
    pub fn Seconds(self: Duration) -> float {
        return float(int(self.nanoseconds / Second))
    }

    // Minutes returns the duration as a float minute count.
    pub fn Minutes(self: Duration) -> float {
        return float(int(self.nanoseconds / Minute))
    }

    // Hours returns the duration as a float hour count.
    pub fn Hours(self: Duration) -> float {
        return float(int(self.nanoseconds / Hour))
    }
}

// FromNanoseconds creates a Duration from a nanosecond count.
pub fn FromNanoseconds(ns: int64) -> Duration {
    return Duration{nanoseconds: ns}
}

// FromMicroseconds creates a Duration from a microsecond count.
pub fn FromMicroseconds(us: int64) -> Duration {
    return Duration{nanoseconds: us * Microsecond}
}

// FromMilliseconds creates a Duration from a millisecond count.
pub fn FromMilliseconds(ms: int64) -> Duration {
    return Duration{nanoseconds: ms * Millisecond}
}

// FromSeconds creates a Duration from a second count.
pub fn FromSeconds(s: int64) -> Duration {
    return Duration{nanoseconds: s * Second}
}

// FromMinutes creates a Duration from a minute count.
pub fn FromMinutes(m: int64) -> Duration {
    return Duration{nanoseconds: m * Minute}
}

// FromHours creates a Duration from an hour count.
pub fn FromHours(h: int64) -> Duration {
    return Duration{nanoseconds: h * Hour}
}

// DateTime represents a calendar date and wall-clock time.
pub struct DateTime {
    year: int  // the year
    month: int  // the month
    day: int  // the day
    hour: int  // the hour
    minute: int  // the minute
    second: int  // the second
    nanosecond: int  // the nanosecond
    weekday: int  // the weekday
    yday: int  // the day of the year
    isUTC: bool  // whether utc

    // Year returns the year (e.g. 2026).
    pub fn Year(self: DateTime) -> int {
        return self.year
    }

    // Month returns the month of the year (1-12).
    pub fn Month(self: DateTime) -> int {
        return self.month
    }

    // Day returns the day of the month (1-31).
    pub fn Day(self: DateTime) -> int {
        return self.day
    }

    // Hour returns the hour of the day (0-23).
    pub fn Hour(self: DateTime) -> int {
        return self.hour
    }

    // Minute returns the minute of the hour (0-59).
    pub fn Minute(self: DateTime) -> int {
        return self.minute
    }

    // Second returns the second of the minute (0-59).
    pub fn Second(self: DateTime) -> int {
        return self.second
    }

    // Nanosecond returns the nanosecond offset within the second.
    pub fn Nanosecond(self: DateTime) -> int {
        return self.nanosecond
    }

    // Weekday returns the day of the week (0=Sunday, 6=Saturday).
    pub fn Weekday(self: DateTime) -> int {
        return self.weekday
    }

    // YDay returns the day of the year (0-365).
    pub fn YDay(self: DateTime) -> int {
        return self.yday
    }

    // IsUTC reports whether the DateTime represents a UTC time.
    pub fn IsUTC(self: DateTime) -> bool {
        return self.isUTC
    }

    // Unix converts the DateTime to a Unix timestamp (seconds since epoch).
    pub fn Unix(self: DateTime) -> int64 {
        // Build a C tm struct; tm_mon is 0-based and tm_year is years since 1900
        var tm = Tm{
            tm_sec: self.second,
            tm_min: self.minute,
            tm_hour: self.hour,
            tm_mday: self.day,
            tm_mon: self.month - 1,
            tm_year: self.year - 1900,
            tm_wday: self.weekday,
            tm_yday: self.yday,
            tm_isdst: -1, // Let mktime determine daylight saving time
            tm_gmtoff: int64(0),
            tm_zone: ""
        }
        return mktime(&tm)
    }

    // Add returns a new DateTime offset by the given Duration.
    pub fn Add(self: DateTime, d: Duration) -> DateTime {
        // Convert to total nanoseconds, add the duration, then split back
        totalNs := self.Unix() * int64(1000000000) + int64(self.nanosecond) + d.nanoseconds
        sec := totalNs / int64(1000000000)
        ns := int(totalNs % int64(1000000000))
        return FromUnixNano(sec, ns)
    }

    // Sub returns the Duration between self and other.
    pub fn Sub(self: DateTime, other: DateTime) -> Duration {
        // Compute difference in nanoseconds, accounting for both seconds and sub-second parts
        diffNs := (self.Unix() - other.Unix()) * int64(1000000000) + int64(self.nanosecond - other.nanosecond)
        return Duration{nanoseconds: diffNs}
    }

    // Format formats the DateTime according to the layout string.
    pub fn Format(self: DateTime, layout: string) -> string {
        return formatDateTime(self, layout)
    }

    // UTC returns a new DateTime representing the same instant in UTC.
    pub fn UTC(self: DateTime) -> DateTime {
        var s = self.Unix()
        var tm = gmtime(&s)
        return DateTime{
            year: tm.tm_year + 1900,
            month: tm.tm_mon + 1,
            day: tm.tm_mday,
            hour: tm.tm_hour,
            minute: tm.tm_min,
            second: tm.tm_sec,
            nanosecond: self.nanosecond,
            weekday: tm.tm_wday,
            yday: tm.tm_yday,
            isUTC: true
        }
    }
}

// Now returns the current local time as a DateTime.
pub fn Now() -> DateTime {
    var seconds int64 = int64(0)
    seconds = time(&seconds)
    var tm = localtime(&seconds)
    return DateTime{
        year: tm.tm_year + 1900,
        month: tm.tm_mon + 1,
        day: tm.tm_mday,
        hour: tm.tm_hour,
        minute: tm.tm_min,
        second: tm.tm_sec,
        nanosecond: 0,
        weekday: tm.tm_wday,
        yday: tm.tm_yday,
        isUTC: false
    }
}

// FromUnix converts a Unix timestamp (seconds since epoch) to a local DateTime.
pub fn FromUnix(sec: int64) -> DateTime {
    var s = sec
    var tm = localtime(&s)
    return DateTime{
        year: tm.tm_year + 1900,
        month: tm.tm_mon + 1,
        day: tm.tm_mday,
        hour: tm.tm_hour,
        minute: tm.tm_min,
        second: tm.tm_sec,
        nanosecond: 0,
        weekday: tm.tm_wday,
        yday: tm.tm_yday,
        isUTC: false
    }
}

// FromUnixNano converts a Unix timestamp with nanosecond offset to a local DateTime.
pub fn FromUnixNano(sec: int64, ns: int) -> DateTime {
    var s = sec
    var tm = localtime(&s)
    return DateTime{
        year: tm.tm_year + 1900,
        month: tm.tm_mon + 1,
        day: tm.tm_mday,
        hour: tm.tm_hour,
        minute: tm.tm_min,
        second: tm.tm_sec,
        nanosecond: ns,
        weekday: tm.tm_wday,
        yday: tm.tm_yday,
        isUTC: false
    }
}

// FromParts constructs a DateTime from individual calendar components.
// The values are normalized via mktime, so out-of-range fields (e.g. month=13)
// are adjusted automatically.
pub fn FromParts(year: int, month: int, day: int, hour: int, minute: int, second: int, ns: int) -> DateTime {
    var tm = Tm{
        tm_sec: second,
        tm_min: minute,
        tm_hour: hour,
        tm_mday: day,
        tm_mon: month - 1,
        tm_year: year - 1900,
        tm_wday: 0,
        tm_yday: 0,
        tm_isdst: -1, // Let mktime determine DST
        tm_gmtoff: int64(0),
        tm_zone: ""
    }
    var s = mktime(&tm)      // Normalize the fields and get a Unix timestamp
    var tm2 = localtime(&s)  // Re-decompose to get correct weekday/yday
    return DateTime{
        year: tm2.tm_year + 1900,
        month: tm2.tm_mon + 1,
        day: tm2.tm_mday,
        hour: tm2.tm_hour,
        minute: tm2.tm_min,
        second: tm2.tm_sec,
        nanosecond: ns,
        weekday: tm2.tm_wday,
        yday: tm2.tm_yday,
        isUTC: false
    }
}

// Timestamp returns the current Unix timestamp as an int (seconds since epoch).
pub fn Timestamp() -> int {
    return int(time(nil))
}

// Sleep blocks the current goroutine for the given number of seconds.
pub fn Sleep(seconds: int) {
    sleep(seconds)
}

// SleepMs blocks the current goroutine for the given number of milliseconds.
pub fn SleepMs(ms: int) {
    usleep(ms * 1000)
}

// NowUnixNano returns the current time in nanoseconds using a monotonic clock.
pub fn NowUnixNano() -> int64 {
    ts := TimeSpec{tv_sec: int64(0), tv_nsec: int64(0)}
    clock_gettime(1, &ts) // CLOCK_MONOTONIC = 1
    return ts.tv_sec * int64(1000000000) + ts.tv_nsec
}

// --- internal helpers ---

// intToString converts an integer to its decimal string representation.
fn intToString(n: int) -> string {
    if n == 0 {
        return "0"
    }
    negative := false
    if n < 0 {
        negative = true
        n = -n
    }
    result := ""
    for n > 0 {
        digit := n % 10
        result = digitToStr(digit) + result // Prepend each digit
        n = n / 10
    }
    if negative {
        result = "-" + result
    }
    return result
}

// digitToStr returns the single-character string for digit 0-9.
fn digitToStr(d: int) -> string {
    if d == 0 { return "0" }
    if d == 1 { return "1" }
    if d == 2 { return "2" }
    if d == 3 { return "3" }
    if d == 4 { return "4" }
    if d == 5 { return "5" }
    if d == 6 { return "6" }
    if d == 7 { return "7" }
    if d == 8 { return "8" }
    if d == 9 { return "9" }
    return ""
}

// padInt left-pads an integer string with zeros to the given width.
fn padInt(n: int, width: int) -> string {
    s := intToString(n)
    // Left-pad with zeros until the desired width is reached
    for str.Len(s) < width {
        s = "0" + s
    }
    return s
}

// monthAbbrName returns the abbreviated month name for month 1-12.
fn monthAbbrName(m: int) -> string {
    if m == 1 { return "Jan" }
    if m == 2 { return "Feb" }
    if m == 3 { return "Mar" }
    if m == 4 { return "Apr" }
    if m == 5 { return "May" }
    if m == 6 { return "Jun" }
    if m == 7 { return "Jul" }
    if m == 8 { return "Aug" }
    if m == 9 { return "Sep" }
    if m == 10 { return "Oct" }
    if m == 11 { return "Nov" }
    if m == 12 { return "Dec" }
    return ""
}

// monthFullName returns the full month name for month 1-12.
fn monthFullName(m: int) -> string {
    if m == 1 { return "January" }
    if m == 2 { return "February" }
    if m == 3 { return "March" }
    if m == 4 { return "April" }
    if m == 5 { return "May" }
    if m == 6 { return "June" }
    if m == 7 { return "July" }
    if m == 8 { return "August" }
    if m == 9 { return "September" }
    if m == 10 { return "October" }
    if m == 11 { return "November" }
    if m == 12 { return "December" }
    return ""
}

// weekdayAbbrName returns the abbreviated weekday name for 0-6.
fn weekdayAbbrName(wd: int) -> string {
    if wd == 0 { return "Sun" }
    if wd == 1 { return "Mon" }
    if wd == 2 { return "Tue" }
    if wd == 3 { return "Wed" }
    if wd == 4 { return "Thu" }
    if wd == 5 { return "Fri" }
    if wd == 6 { return "Sat" }
    return ""
}

// weekdayFullName returns the full weekday name for 0-6.
fn weekdayFullName(wd: int) -> string {
    if wd == 0 { return "Sunday" }
    if wd == 1 { return "Monday" }
    if wd == 2 { return "Tuesday" }
    if wd == 3 { return "Wednesday" }
    if wd == 4 { return "Thursday" }
    if wd == 5 { return "Friday" }
    if wd == 6 { return "Saturday" }
    return ""
}

// daySuffix returns the ordinal suffix ("st", "nd", "rd", "th") for a day.
fn daySuffix(day: int) -> string {
    // Special case: 11th, 12th, 13th all use "th"
    if day >= 11 && day <= 13 {
        return "th"
    }
    last := day % 10
    if last == 1 { return "st" }
    if last == 2 { return "nd" }
    if last == 3 { return "rd" }
    return "th"
}

// formatFraction formats a nanosecond value to the requested decimal places.
fn formatFraction(ns: int, places: int) -> string {
    if places <= 0 {
        return ""
    }
    if places > 9 {
        places = 9 // Cap at 9 digits (nanosecond precision)
    }
    // Compute the divisor to truncate/round to the requested number of decimal places
    divisor := 1
    for i := 0; i < 9 - places; i = i + 1 {
        divisor = divisor * 10
    }
    rounded := (ns + divisor / 2) / divisor // Round to nearest
    maxVal := 1
    for i := 0; i < places; i = i + 1 {
        maxVal = maxVal * 10
    }
    if rounded >= maxVal {
        rounded = maxVal - 1 // Clamp to avoid overflow in width
    }
    return padInt(rounded, places)
}

// computeWeekNumber returns the ISO-like week number for the given date.
fn computeWeekNumber(year: int, month: int, day: int) -> int {
    // Compute the Julian Day Number for the given date
    a := (14 - month) / 12
    y := year + 4800 - a
    m := month + 12 * a - 3
    jdn := day + (153 * m + 2) / 5 + 365 * y + y / 4 - y / 100 + y / 400 - 32045
    // Compute the Julian Day Number for January 1 of the same year
    a2 := (14 - 1) / 12
    y2 := year + 4800 - a2
    m2 := 1 + 12 * a2 - 3
    jan1 := 1 + (153 * m2 + 2) / 5 + 365 * y2 + y2 / 4 - y2 / 100 + y2 / 400 - 32045
    return (jdn - jan1) / 7 + 1
}

// formatDateTime formats a DateTime according to the layout string.
fn formatDateTime(dt: DateTime, layout: string) -> string {
    result := ""
    i := 0
    for i < str.Len(layout) {
        c := layout[i]
        matched := false
        matchLen := 0
        replacement := ""

        if c == 121 { // 'y'
            if i + 3 < str.Len(layout) && layout[i+1] == 121 && layout[i+2] == 121 && layout[i+3] == 121 {
                replacement = padInt(dt.year, 4) // yyyy = 4-digit year
                matchLen = 4
                matched = true
            } else if i + 1 < str.Len(layout) && layout[i+1] == 121 {
                replacement = padInt(dt.year % 100, 2) // yy = 2-digit year
                matchLen = 2
                matched = true
            }
        } else if c == 77 { // 'M'
            if i + 3 < str.Len(layout) && layout[i+1] == 77 && layout[i+2] == 77 && layout[i+3] == 77 {
                replacement = monthFullName(dt.month) // MMMM = full month name
                matchLen = 4
                matched = true
            } else if i + 2 < str.Len(layout) && layout[i+1] == 77 && layout[i+2] == 77 {
                replacement = monthAbbrName(dt.month) // MMM = abbreviated month name
                matchLen = 3
                matched = true
            } else if i + 1 < str.Len(layout) && layout[i+1] == 77 {
                replacement = padInt(dt.month, 2) // MM = 2-digit month
                matchLen = 2
                matched = true
            } else {
                replacement = intToString(dt.month) // M = unpadded month
                matchLen = 1
                matched = true
            }
        } else if c == 100 { // 'd'
            if i + 1 < str.Len(layout) && layout[i+1] == 100 {
                replacement = padInt(dt.day, 2) // dd = 2-digit day
                matchLen = 2
                matched = true
            } else {
                replacement = intToString(dt.day) // d = unpadded day
                matchLen = 1
                matched = true
            }
        } else if c == 104 { // 'h' (12-hour)
            hour12 := dt.hour % 12
            if hour12 == 0 {
                hour12 = 12 // 0 and 12 both map to 12 in 12-hour format
            }
            if i + 1 < str.Len(layout) && layout[i+1] == 104 {
                replacement = padInt(hour12, 2)
                matchLen = 2
                matched = true
            } else {
                replacement = intToString(hour12)
                matchLen = 1
                matched = true
            }
        } else if c == 72 { // 'H' (24-hour)
            if i + 1 < str.Len(layout) && layout[i+1] == 72 {
                replacement = padInt(dt.hour, 2)
                matchLen = 2
                matched = true
            } else {
                replacement = intToString(dt.hour)
                matchLen = 1
                matched = true
            }
        } else if c == 109 { // 'm'
            if i + 1 < str.Len(layout) && layout[i+1] == 115 { // 'ms'
                replacement = padInt(dt.nanosecond / 1000000, 3)
                matchLen = 2
                matched = true
            } else if i + 1 < str.Len(layout) && layout[i+1] == 109 {
                replacement = padInt(dt.minute, 2)
                matchLen = 2
                matched = true
            } else {
                replacement = intToString(dt.minute)
                matchLen = 1
                matched = true
            }
        } else if c == 115 { // 's'
            if i + 1 < str.Len(layout) && layout[i+1] == 115 {
                replacement = padInt(dt.second, 2)
                matchLen = 2
                matched = true
            } else {
                replacement = intToString(dt.second)
                matchLen = 1
                matched = true
            }
        } else if c == 102 { // 'f' fraction
            count := 0
            for i + count < str.Len(layout) && layout[i+count] == 102 {
                count = count + 1
            }
            if count > 7 {
                count = 7 // Cap at 7 fractional digits
            }
            replacement = formatFraction(dt.nanosecond, count)
            matchLen = count
            matched = true
        } else if c == 116 { // 't'
            if i + 1 < str.Len(layout) && layout[i+1] == 104 { // 'th'
                replacement = daySuffix(dt.day)
                matchLen = 2
                matched = true
            }
        } else if c == 117 { // 'u'
            if i + 1 < str.Len(layout) && layout[i+1] == 115 { // 'us'
                replacement = padInt(dt.nanosecond / 1000, 6)
                matchLen = 2
                matched = true
            }
        } else if c == 110 { // 'n'
            if i + 1 < str.Len(layout) && layout[i+1] == 115 { // 'ns'
                replacement = padInt(dt.nanosecond, 9)
                matchLen = 2
                matched = true
            }
        } else if c == 119 { // 'w'
            if i + 2 < str.Len(layout) && layout[i+1] == 107 && layout[i+2] == 100 { // 'wkd'
                replacement = weekdayFullName(dt.weekday)
                matchLen = 3
                matched = true
            } else if i + 1 < str.Len(layout) && layout[i+1] == 100 { // 'wd'
                replacement = weekdayAbbrName(dt.weekday)
                matchLen = 2
                matched = true
            } else if i + 1 < str.Len(layout) && layout[i+1] == 119 { // 'ww'
                wn := computeWeekNumber(dt.year, dt.month, dt.day)
                replacement = padInt(wn, 2)
                matchLen = 2
                matched = true
            } else {
                wn := computeWeekNumber(dt.year, dt.month, dt.day)
                replacement = intToString(wn)
                matchLen = 1
                matched = true
            }
        }

        if matched {
            result = result + replacement
            i = i + matchLen
        } else {
            // No format token matched; copy the character literally
            result = result + str.Substr(layout, i, 1)
            i = i + 1
        }
    }
    return result
}

// ==========================================================================
// Timer and Ticker
// ==========================================================================

// Timer fires exactly once after a specified Duration. The C channel
// receives a bool value (true) when the timer fires. Use Stop to release
// resources early; use Reset to stop and re-arm.
pub struct Timer {
    C: chan<bool>  // the channel that receives timer events
    stop: chan<bool>  // the stop

    // Stop prevents the Timer from firing. It signals the timer
    // goroutine, which closes the C channel on exit so receivers
    // observe the close. Only the goroutine closes C — closing C here
    // while the goroutine still sends would panic on send-on-closed
    // (comp_error.md #93).
    pub fn Stop(self: *Timer) {
        select {
            case self.stop <- true:
            default:
        }
    }

    // Reset changes the timer to expire after duration d. It signals the
    // old goroutine to stop (which closes the old C channel) and creates
    // a new one.
    pub fn Reset(self: *Timer, d: Duration) {
        select {
            case self.stop <- true:
            default:
        }
        self.C = make(chan<bool>, 1)
        self.stop = make(chan<bool>, 1)
        ms := int(d.Milliseconds())
        spawn timerFire(self.C, self.stop, ms)
    }
}

// NewTimer creates a Timer that will send a bool on its C channel
// after at least duration d.
pub fn NewTimer(d: Duration) -> *Timer {
    ch := make(chan<bool>, 1)
    stop := make(chan<bool>, 1)
    ms := int(d.Milliseconds())
    spawn timerFire(ch, stop, ms)
    return &Timer{C: ch, stop: stop}
}

// timerFire is the internal function spawned in a separate thread.
// It sleeps for the given milliseconds then sends true on the channel,
// or exits early on a stop signal. It always closes C on exit so
// receivers never block forever.
fn timerFire(ch: chan<bool>, stop: chan<bool>, ms: int) {
    if ms > 0 {
        SleepMs(ms)
    }
    select {
        case <-stop:
        case ch <- true:
    }
    close(ch)
}

// Ticker fires repeatedly at regular intervals, sending a bool value on
// its C channel each tick. Use Stop to halt the ticker.
pub struct Ticker {
    C: chan<bool>  // the channel that receives tick events
    stop: chan<bool>  // the stop

    // Stop turns off a ticker. It signals the ticker goroutine, which
    // closes the C channel on exit so receivers observe the close. Only
    // the goroutine closes C — closing C here while the goroutine still
    // sends would panic on send-on-closed (comp_error.md #93).
    pub fn Stop(self: *Ticker) {
        select {
            case self.stop <- true:
            default:
        }
    }

    // Reset stops a ticker and resets its period to the specified
    // duration. The old goroutine closes the old channel on exit and a
    // new one is created.
    pub fn Reset(self: *Ticker, d: Duration) {
        select {
            case self.stop <- true:
            default:
        }
        self.C = make(chan<bool>, 1)
        self.stop = make(chan<bool>, 1)
        ms := int(d.Milliseconds())
        spawn tickerLoop(self.C, self.stop, ms)
    }
}

// NewTicker returns a new Ticker containing a channel that will send
// a bool with a period specified by the duration argument.
pub fn NewTicker(d: Duration) -> *Ticker {
    ch := make(chan<bool>, 1)
    stop := make(chan<bool>, 1)
    ms := int(d.Milliseconds())
    spawn tickerLoop(ch, stop, ms)
    return &Ticker{C: ch, stop: stop}
}

// tickerLoop is the internal function spawned in a separate thread.
// It repeatedly sleeps and sends true on the channel until a stop
// signal arrives; it closes C on exit so receivers observe the close.
fn tickerLoop(ch: chan<bool>, stop: chan<bool>, ms: int) {
    running := true
    for running {
        if ms > 0 {
            SleepMs(ms)
        }
        select {
            case <-stop:
                running = false
            case ch <- true:
        }
    }
    close(ch)
}
