module xml_test

import "std/xml"
import "std/str"
import "testing"

// TestNewNode verifies node creation and tag access.
pub fn TestNewNode() {
    node := xml.NewNode("root")
    if str.Equal(node.tag, "root") == false {
        Errorf("NewNode tag should be root")
    }
}

// TestSetAttr verifies attribute setting.
pub fn TestSetAttr() {
    node := xml.NewNode("item")
    node.SetAttr("id", "42")
    if len(node.attrKeys) != 1 {
        Errorf("SetAttr should add one attribute")
    }
}

// TestSetText verifies text content setting.
pub fn TestSetText() {
    node := xml.NewNode("msg")
    node.SetText("hello")
    if str.Equal(node.text, "hello") == false {
        Errorf("SetText should store the text")
    }
}

// TestAddChild verifies child node addition.
pub fn TestAddChild() {
    parent := xml.NewNode("root")
    child := xml.NewNode("child")
    parent.AddChild(child)
    if len(parent.children) != 1 {
        Errorf("AddChild should add one child")
    }
}

// TestMarshalEmptyElement verifies self-closing tag for empty node.
pub fn TestMarshalEmptyElement() {
    node := xml.NewNode("empty")
    s := xml.MarshalNode(node)
    if str.Contains(s, "<empty/>") == false {
        Errorf("Empty node should marshal to self-closing tag")
    }
}

// TestMarshalWithText verifies text content in marshaled output.
pub fn TestMarshalWithText() {
    node := xml.NewNode("msg")
    node.SetText("hi")
    s := xml.MarshalNode(node)
    if str.Contains(s, "hi") == false {
        Errorf("Marshaled node should contain text content")
    }
}

// TestMarshalEscape verifies XML escaping of special characters.
pub fn TestMarshalEscape() {
    node := xml.NewNode("data")
    node.SetText("<>&")
    s := xml.MarshalNode(node)
    if str.Contains(s, "&lt;") == false {
        Errorf("Less-than should be escaped")
    }
    if str.Contains(s, "&gt;") == false {
        Errorf("Greater-than should be escaped")
    }
    if str.Contains(s, "&amp;") == false {
        Errorf("Ampersand should be escaped")
    }
}

// TestUnmarshalSimple verifies parsing of a simple XML element.
pub fn TestUnmarshalSimple() {
    s := "<root>hello</root>"
    node, err := xml.Unmarshal(s)
    if err.message != "" {
        Errorf("Unmarshal should not error")
    }
    if str.Equal(node.tag, "root") == false {
        Errorf("Unmarshal should extract tag name")
    }
    if str.Equal(node.text, "hello") == false {
        Errorf("Unmarshal should extract text content")
    }
}

// TestUnmarshalAttr verifies parsing of attributes.
pub fn TestUnmarshalAttr() {
    s := "<item id=\"42\"/>"
    node, err := xml.Unmarshal(s)
    if err.message != "" {
        Errorf("Unmarshal should not error")
    }
    if len(node.attrKeys) != 1 {
        Errorf("Unmarshal should extract one attribute")
    }
}

// --- Struct marshal/unmarshal via reflect + [xml] field tags ---
// Guards the reflected-struct API added alongside json.Marshal —
// elements vs [xml(attr)] attributes, nested elements, repeated
// slice elements, pointers, and base64 byte buffers.
import "std/reflect"

// XmlAddr is a nested-struct target for recursion tests.
pub struct XmlAddr {
    city: string
    zip: int
}

// XmlUser exercises attributes, elements, nested structs, slices,
// pointers, narrow ints, and byte buffers in one shape.
pub struct XmlUser {
    [xml(attr)]
    id: int
    [xml(name=display_name)]
    name: string
    addr: XmlAddr
    tags: []string
    peers: []XmlAddr
    deputy: *XmlAddr
    level: int8
}

// TestXmlMarshalStruct verifies element/attribute mapping, renames,
// nested elements, and repeated slice elements.
pub fn TestXmlMarshalStruct() {
    var u XmlUser
    u.id = 7
    u.name = "Neo"
    u.addr.city = "Zion"
    u.addr.zip = 101
    u.tags = append(u.tags, "one")
    u.tags = append(u.tags, "two")
    u.level = int8(5)
    s, err := xml.MarshalStruct(reflect.TypeOf<XmlUser>(u), int64(&u))
    if err.message != "" {
        Errorf("xml.Marshal should succeed")
        return
    }
    if str.Contains(s, "id=\"7\"") == false {
        Errorf("[xml(attr)] should emit an attribute")
    }
    if str.Contains(s, "<display_name>Neo</display_name>") == false {
        Errorf("[xml(name=display_name)] should rename the element")
    }
    if str.Contains(s, "<city>Zion</city>") == false {
        Errorf("nested struct should marshal as a child element")
    }
    if str.Contains(s, "<tags>one</tags>") == false || str.Contains(s, "<tags>two</tags>") == false {
        Errorf("slice field should emit one element per item")
    }
}

// TestXmlStructRoundTrip verifies Marshal then UnmarshalInto restores
// attributes, nested elements, slices, and pointers.
pub fn TestXmlStructRoundTrip() {
    var src XmlUser
    src.id = 42
    src.name = "Trinity"
    src.addr.city = "Metro"
    src.addr.zip = 5
    src.tags = append(src.tags, "ops")
    var p XmlAddr
    p.city = "peer1"
    p.zip = 3
    src.peers = append(src.peers, p)
    var d XmlAddr
    d.city = "dep"
    src.deputy = &d
    s, err := xml.MarshalStruct(reflect.TypeOf<XmlUser>(src), int64(&src))
    if err.message != "" {
        Errorf("marshal should succeed")
        return
    }
    var dst XmlUser
    err = xml.UnmarshalStruct(s, reflect.TypeOf<XmlUser>(dst), int64(&dst))
    if err.message != "" {
        Errorf("UnmarshalInto should succeed on own output")
        return
    }
    if dst.id != 42 || str.Equal(dst.name, "Trinity") == false {
        Errorf("attribute and element fields should round-trip")
    }
    if str.Equal(dst.addr.city, "Metro") == false || dst.addr.zip != 5 {
        Errorf("nested struct should round-trip")
    }
    if len(dst.tags) != 1 || str.Equal(dst.tags[0], "ops") == false {
        Errorf("[]string should round-trip")
    }
    if len(dst.peers) != 1 || str.Equal(dst.peers[0].city, "peer1") == false || dst.peers[0].zip != 3 {
        Errorf("[]struct should round-trip")
    }
    if dst.deputy == nil || str.Equal(dst.deputy.city, "dep") == false {
        Errorf("pointer field should round-trip")
    }
}

// TestXmlUnmarshalIntoBad verifies malformed input errors.
pub fn TestXmlUnmarshalIntoBad() {
    var u XmlUser
    err := xml.UnmarshalStruct("not xml <<<", reflect.TypeOf<XmlUser>(u), int64(&u))
    if err.message == "" {
        Errorf("malformed XML should error")
    }
}


// TestXmlMarshalAutoAPI covers the pointer-only xml.Marshal(&obj) call —
// the emitter synthesizes (reflect.Type, ptr) at the call site and
// forwards to MarshalStruct.
pub fn TestXmlMarshalAutoAPI() {
    var u XmlUser
    u.name = "Ada"
    u.level = 3
    s, err := xml.Marshal(&u)
    if err.message != "" {
        Errorf("xml.Marshal(&u) should succeed")
    }
    if str.Contains(s, "<XmlUser") == false {
        Errorf("xml.Marshal(&u) should emit the root element")
    }
    if str.Contains(s, "<display_name>Ada</display_name>") == false {
        Errorf("xml.Marshal(&u) should emit the renamed field")
    }
}

// TestXmlAutoAPIRoundTrip covers UnmarshalInto(data, &obj) — the
// two-argument pointer form with auto-injected type+ptr.
pub fn TestXmlAutoAPIRoundTrip() {
    var u XmlUser
    u.name = "round"
    u.level = 7
    var w XmlAddr
    w.city = "srv"
    w.zip = 99
    u.addr = w
    u.tags = append(u.tags, "x")
    u.tags = append(u.tags, "y")
    s, err := xml.Marshal(&u)
    if err.message != "" {
        Errorf("xml.Marshal(&u) should succeed")
    }
    var dst XmlUser
    err = xml.UnmarshalInto(s, &dst)
    if err.message != "" {
        Errorf("xml.UnmarshalInto(s, &dst) should succeed")
    }
    if str.Equal(dst.name, "round") == false || dst.level != 7 {
        Errorf("round trip should preserve scalars")
    }
    if str.Equal(dst.addr.city, "srv") == false || dst.addr.zip != 99 {
        Errorf("round trip should preserve the nested struct")
    }
    if len(dst.tags) != 2 || str.Equal(dst.tags[1], "y") == false {
        Errorf("round trip should preserve the repeated elements")
    }
}
