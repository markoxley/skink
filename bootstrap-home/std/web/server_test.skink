// Tests for std/web/server response serialization.

module server_test

import "std/str"
import "std/web/server"
import "std/web/types"
import "testing"

// TestSerializeResponseBasic checks that a basic 200 response is serialized
// with the correct status line, Content-Length, and body.
pub fn TestSerializeResponseBasic() {
    w := types.NewResponseWriter()
    w.WriteHeader(200)
    w.Write("hello")
    resp := server.SerializeResponse(w)
    if !str.StartsWith(resp, "HTTP/1.1 200 OK\r\n") {
        Errorf("status line mismatch: " + resp)
    }
    if !str.Contains(resp, "Content-Length: 5\r\n") {
        Errorf("Content-Length mismatch: " + resp)
    }
    if !str.Contains(resp, "Connection: close\r\n") {
        Errorf("Connection header missing: " + resp)
    }
    if !str.EndsWith(resp, "\r\nhello") {
        Errorf("body mismatch: " + resp)
    }
}

// TestSerializeResponseHeaders checks that custom headers set by the handler
// (e.g. Content-Type from JSON() or HTML()) are emitted in the response.
pub fn TestSerializeResponseHeaders() {
    w := types.NewResponseWriter()
    w.JSON(200, "{\"key\":\"value\"}")
    resp := server.SerializeResponse(w)
    if !str.Contains(resp, "Content-Type: application/json\r\n") {
        Errorf("Content-Type header should be emitted: " + resp)
    }
}

// TestSerializeResponseHTML checks that HTML content type is emitted.
pub fn TestSerializeResponseHTML() {
    w := types.NewResponseWriter()
    w.HTML(200, "<h1>Hi</h1>")
    resp := server.SerializeResponse(w)
    if !str.Contains(resp, "Content-Type: text/html; charset=utf-8\r\n") {
        Errorf("Content-Type text/html header should be emitted: " + resp)
    }
}

// TestSerializeResponse404 checks that a 404 status is correctly serialized.
pub fn TestSerializeResponse404() {
    w := types.NewResponseWriter()
    w.WriteHeader(404)
    w.Write("Not Found")
    resp := server.SerializeResponse(w)
    if !str.StartsWith(resp, "HTTP/1.1 404 Not Found\r\n") {
        Errorf("404 status line mismatch: " + resp)
    }
}

// TestSerializeResponseCustomHeader checks that arbitrary custom headers
// set via Header() are emitted.
pub fn TestSerializeResponseCustomHeader() {
    w := types.NewResponseWriter()
    w.WriteHeader(200)
    w.Write("ok")
    w.Header("X-Custom", "test-value")
    resp := server.SerializeResponse(w)
    if !str.Contains(resp, "X-Custom: test-value\r\n") {
        Errorf("custom header should be emitted: " + resp)
    }
}

// TestSerializeResponseEmptyBody checks that an empty body is handled correctly.
pub fn TestSerializeResponseEmptyBody() {
    w := types.NewResponseWriter()
    w.WriteHeader(204)
    resp := server.SerializeResponse(w)
    if !str.Contains(resp, "Content-Length: 0\r\n") {
        Errorf("Content-Length should be 0 for empty body: " + resp)
    }
}
