// Project: Skink — A self-hosted, statically-typed programming language
//
// Purpose: compiler-level fuzz tests. Complements fuzz_test.skink (which
// fuzzes data parsers in-process) by fuzzing the COMPILER itself:
// randomly generated token-soup programs must never crash or hang the
// compiler — any diagnostic, and even a successful compile, is a valid
// outcome. Also covers runtime churn invariants for maps and slices.

module compiler_fuzz_test

import "testing"
import "std/rand"
import "std/str"
import "std/strconv"
import "std/os"
import "std/io"

// cfzBin returns the compiler binary to invoke (SKINK_BIN, or ./skink).
fn cfzBin() -> string {
    b := os.Getenv("SKINK_BIN")
    if str.Len(b) > 0 {
        return b
    }
    return "./skink"
}

// cfzCompileCheck runs `timeout 10 skink -check path` and returns the
// child status. -1 means the compiler died on a signal (crash); 124
// means the timeout killed it (hang).
fn cfzCompileCheck(path: string) -> int {
    _, rc := os.ExecWithOutput([]string{"timeout", "10", cfzBin(), "-check", path})
    return rc
}

// cfzTokens is the token pool token-soup programs are assembled from.
// Mixes keywords, operators, delimiters and literals so most programs
// hit lexer/parser/checker paths deep enough to matter.
var cfzTokens = []string{
    "fn", "var", "if", "else", "for", "while", "return", "struct",
    "import", "module", "main", "int", "string", "bool", "chan",
    "(", ")", "{", "}", "[", "]", ",", ";", ":", ".", "=", ":=",
    "+", "-", "*", "/", "%", "==", "!=", "<", ">", "&&", "||", "!",
    "&", "*", "<-", "x", "y", "f", "0", "1", "42", "\"s\"", "true",
    "..", "spawn", "select", "case", "default", "break", "defer", "map",
}

// cfzSoup builds a random token-soup program of n tokens.
fn cfzSoup(n: int) -> string {
    src := "module fz\n"
    i := 0
    for i < n {
        src = str.Concat(src, cfzTokens[rand.Intn(len(cfzTokens))])
        src = str.Concat(src, " ")
        if rand.Intn(8) == 0 {
            src = str.Concat(src, "\n")
        }
        i = i + 1
    }
    return src
}

// TestFuzzTokenSoup feeds random token streams to the compiler. The
// compiler must always terminate without a signal death — a segfault
// (rc -1) or a hang (rc 124) on garbage input is a robustness bug.
pub fn TestFuzzTokenSoup() {
    rand.Seed(20260707)
    i := 0
    for i < 40 {
        path := str.Concat("/tmp/cfz_soup_", strconv.Itoa(i))
        path = str.Concat(path, ".skink")
        io.WriteFile(path, cfzSoup(40 + rand.Intn(60)))
        rc := cfzCompileCheck(path)
        testing.AssertTrue(rc != -1, str.Concat("compiler crashed (signal) on soup #", strconv.Itoa(i)))
        testing.AssertTrue(rc != 124, str.Concat("compiler hung on soup #", strconv.Itoa(i)))
        i = i + 1
    }
}

// cfzNest wraps `inner` in `depth` levels of a nested construct.
// kind 0: parenthesized expr; 1: nested ifs; 2: nested fors; 3: calls.
fn cfzNest(kind: int, depth: int) -> string {
    s := ""
    close := ""
    if kind == 0 {
        s = "x := "
        i := 0
        for i < depth {
            s = str.Concat(s, "(")
            close = str.Concat(close, ")")
            i = i + 1
        }
        s = str.Concat(str.Concat(s, "1"), close)
    } else if kind == 1 {
        i := 0
        for i < depth {
            s = str.Concat(s, "if true { ")
            close = str.Concat(close, " }")
            i = i + 1
        }
        s = str.Concat(s, "x := 1")
        s = str.Concat(s, close)
    } else if kind == 2 {
        i := 0
        for i < depth {
            s = str.Concat(s, "for j in 0..1 { ")
            close = str.Concat(close, " }")
            i = i + 1
        }
        s = str.Concat(s, "x := 1")
        s = str.Concat(s, close)
    } else {
        s = "x := "
        i := 0
        for i < depth {
            s = str.Concat(s, "str.Len(")
            close = str.Concat(close, ")")
            i = i + 1
        }
        s = str.Concat(str.Concat(s, "\"a\""), close)
    }
    return str.Concat("module main\nimport \"std/str\"\nfn main() -> int {\n    ", str.Concat(s, "\n    return 0\n}\n"))
}

// TestFuzzDeepNesting compiles deeply nested constructs — the parser
// and checker must bound recursion or handle depth gracefully rather
// than crashing the process. Errors are acceptable; crashes/hangs are
// not (comp_error.md: parser depth-limit regression class).
pub fn TestFuzzDeepNesting() {
    kind := 0
    for kind < 4 {
        path := str.Concat("/tmp/cfz_nest_", strconv.Itoa(kind))
        path = str.Concat(path, ".skink")
        io.WriteFile(path, cfzNest(kind, 400))
        rc := cfzCompileCheck(path)
        testing.AssertTrue(rc != -1, str.Concat("compiler crashed on nesting kind ", strconv.Itoa(kind)))
        testing.AssertTrue(rc != 124, str.Concat("compiler hung on nesting kind ", strconv.Itoa(kind)))
        kind = kind + 1
    }
}

// TestFuzzSliceChurn hammers a slice with random appends, reslices and
// writes, asserting length/bounds invariants hold throughout.
pub fn TestFuzzSliceChurn() {
    rand.Seed(777)
    a := []int{}
    expected := 0
    i := 0
    for i < 2000 {
        op := rand.Intn(4)
        if op == 0 || len(a) == 0 {
            a = append(a, i)
            expected = expected + 1
        } else if op == 1 {
            // Reslice to a random valid prefix — Skink reslices copy,
            // so `a` itself is unchanged.
            hi := rand.Intn(len(a) + 1)
            s := a[0:hi]
            testing.AssertEqualInt(hi, len(s), "reslice length")
        } else if op == 2 {
            idx := rand.Intn(len(a))
            a[idx] = idx
            testing.AssertEqualInt(idx, a[idx], "indexed write")
        } else {
            testing.AssertEqualInt(expected, len(a), "slice length invariant")
        }
        i = i + 1
    }
    testing.AssertEqualInt(expected, len(a), "final length")
}

// TestFuzzMapChurn hammers a map with random inserts, deletes and
// lookups, asserting the count invariant and get-or-zero semantics.
pub fn TestFuzzMapChurn() {
    rand.Seed(31337)
    m := make(map[string]int)
    present := make(map[string]bool)
    expected := 0
    i := 0
    for i < 3000 {
        k := str.Concat("k", strconv.Itoa(rand.Intn(200)))
        op := rand.Intn(3)
        if op == 0 {
            _, had := present[k]
            if !had {
                expected = expected + 1
            }
            m[k] = i
            present[k] = true
        } else if op == 1 {
            _, had := present[k]
            if had {
                expected = expected - 1
            }
            delete(m, k)
            delete(present, k)
        } else {
            v, ok := m[k]
            _, had := present[k]
            testing.AssertTrue(ok == had, "comma-ok matches shadow map")
            if !had {
                testing.AssertEqualInt(0, v, "absent key yields zero")
            }
        }
        i = i + 1
    }
    testing.AssertEqualInt(expected, len(m), "map count invariant")
}

// TestFuzzValidPrograms compiles small well-formed generated programs
// — they must all succeed, guarding against a compiler that rejects
// valid input (the flip side of token-soup).
pub fn TestFuzzValidPrograms() {
    rand.Seed(4242)
    i := 0
    for i < 15 {
        n := rand.Intn(500)
        src := str.Concat("module main\nfn main() -> int {\n    x := ", strconv.Itoa(n))
        src = str.Concat(src, "\n    s := 0\n    for j in 0..5 {\n        s = s + x + j\n    }\n    return s - s\n}\n")
        path := str.Concat("/tmp/cfz_valid_", strconv.Itoa(i))
        path = str.Concat(path, ".skink")
        io.WriteFile(path, src)
        rc := cfzCompileCheck(path)
        testing.AssertEqualInt(0, rc, str.Concat("valid program #", strconv.Itoa(i)))
        i = i + 1
    }
}
