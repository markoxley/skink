module json

import "std/str"
import "std/errors"
import "std/strconv"
import "std/reflect"

// Value is a dynamic JSON value that can represent any JSON type.
// Use the kind field (0=null, 1=bool, 2=number, 3=string, 4=array, 5=object)
// to determine which fields are valid.
pub struct Value {
    kind: int  // the kind
    strVal: string  // the string value
    numVal: float  // the numeric value
    boolVal: bool  // the bool value
    arr: []Value  // the array elements
    objKeys: []string  // the object keys
    objVals: []Value  // the object values
}

// zeroValue returns a JSON Value initialized to the null kind.
fn zeroValue() -> Value {
    var emptyStr string
    var emptyArr []Value
    var emptyKeys []string
    var emptyVals []Value
    return Value{kind: 0, strVal: emptyStr, numVal: 0.0, boolVal: false, arr: emptyArr, objKeys: emptyKeys, objVals: emptyVals}
}

// Constructors

// Null creates a JSON Value representing the null literal.
pub fn Null() -> Value {
    return zeroValue()
}

// FromBool creates a JSON Value representing a boolean.
pub fn FromBool(b: bool) -> Value {
    v := zeroValue()
    v.kind = 1
    v.boolVal = b
    return v
}

// FromNumber creates a JSON Value representing a floating-point number.
pub fn FromNumber(n: float) -> Value {
    v := zeroValue()
    v.kind = 2
    v.numVal = n
    return v
}

// FromString creates a JSON Value representing a string.
pub fn FromString(s: string) -> Value {
    v := zeroValue()
    v.kind = 3
    v.strVal = s
    return v
}

// FromArray creates a JSON Value representing an array of Values.
pub fn FromArray(arr: []Value) -> Value {
    v := zeroValue()
    v.kind = 4
    v.arr = arr
    return v
}

// FromObject creates a JSON Value representing an object with the given
// parallel key and value slices.
pub fn FromObject(keys: []string, vals: []Value) -> Value {
    v := zeroValue()
    v.kind = 5
    v.objKeys = keys
    v.objVals = vals
    return v
}

// Accessors

// IsNull returns true if the Value represents a JSON null.
pub fn IsNull(v: Value) -> bool {
    return v.kind == 0
}

// AsBool extracts the boolean value from a Value of kind 1.
pub fn AsBool(v: Value) -> bool {
    return v.boolVal
}

// AsNumber extracts the floating-point value from a Value of kind 2.
pub fn AsNumber(v: Value) -> float {
    return v.numVal
}

// AsString extracts the string value from a Value of kind 3.
pub fn AsString(v: Value) -> string {
    return v.strVal
}

// ArrayLen returns the number of elements in a JSON array Value.
pub fn ArrayLen(v: Value) -> int {
    return len(v.arr)
}

// ArrayGet returns the element at index i in a JSON array Value.
pub fn ArrayGet(v: Value, i: int) -> Value {
    return v.arr[i]
}

// ObjectLen returns the number of key-value pairs in a JSON object Value.
pub fn ObjectLen(v: Value) -> int {
    return len(v.objKeys)
}

// ObjectGet looks up a key in a JSON object Value, returning Null if not found.
pub fn ObjectGet(v: Value, key: string) -> Value {
    for i := 0; i < len(v.objKeys); i = i + 1 {
        if v.objKeys[i] == key {
            return v.objVals[i]
        }
    }
    // Key not found; return null sentinel
    return Null()
}

// ObjectGetByIndex returns the key and value at index i in a JSON object Value.
pub fn ObjectGetByIndex(v: Value, i: int) -> (string, Value) {
    return v.objKeys[i], v.objVals[i]
}

// --- Convenience Get helpers ---

// GetString retrieves a string field from a JSON object.
pub fn GetString(v: Value, key: string) -> string {
    field := ObjectGet(v, key)
    return AsString(field)
}

// GetNumber retrieves a number field from a JSON object.
pub fn GetNumber(v: Value, key: string) -> float {
    field := ObjectGet(v, key)
    return AsNumber(field)
}

// GetInt retrieves an integer field from a JSON object.
pub fn GetInt(v: Value, key: string) -> int {
    field := ObjectGet(v, key)
    return int(AsNumber(field))
}

// GetBool retrieves a boolean field from a JSON object.
pub fn GetBool(v: Value, key: string) -> bool {
    field := ObjectGet(v, key)
    return AsBool(field)
}

// GetObject retrieves a nested object field from a JSON object.
pub fn GetObject(v: Value, key: string) -> Value {
    return ObjectGet(v, key)
}

// GetArray retrieves an array field from a JSON object.
pub fn GetArray(v: Value, key: string) -> Value {
    return ObjectGet(v, key)
}

// --- Marshal ---

// MarshalValue serializes a Value into a JSON string.
pub fn MarshalValue(v: Value) -> string {
    return marshalValueInternal(v)
}

// marshalValueInternal dispatches serialization by Value kind.
fn marshalValueInternal(v: Value) -> string {
    if v.kind == 0 {
        return "null"
    }
    if v.kind == 1 {
        if v.boolVal {
            return "true"
        }
        return "false"
    }
    if v.kind == 2 {
        return floatToString(v.numVal)
    }
    if v.kind == 3 {
        return escapeString(v.strVal)
    }
    if v.kind == 4 {
        return marshalArray(v.arr)
    }
    if v.kind == 5 {
        return marshalObject(v.objKeys, v.objVals)
    }
    // Unknown kind; default to null
    return "null"
}

// marshalArray serializes a slice of Values as a JSON array string.
fn marshalArray(arr: []Value) -> string {
    res := "["
    n := len(arr)
    for i := 0; i < n; i = i + 1 {
        if i > 0 {
            // Separate elements with a comma
            res = str.Concat(res, ",")
        }
        res = str.Concat(res, marshalValueInternal(arr[i]))
    }
    res = str.Concat(res, "]")
    return res
}

// marshalObject serializes parallel key/value slices as a JSON object string.
fn marshalObject(keys: []string, vals: []Value) -> string {
    res := "{"
    n := len(keys)
    for i := 0; i < n; i = i + 1 {
        if i > 0 {
            // Separate pairs with a comma
            res = str.Concat(res, ",")
        }
        res = str.Concat(res, escapeString(keys[i]))
        res = str.Concat(res, ":")
        res = str.Concat(res, marshalValueInternal(vals[i]))
    }
    res = str.Concat(res, "}")
    return res
}

// escapeString wraps s in double quotes and escapes special characters
// per the JSON specification (RFC 8259).
fn escapeString(s: string) -> string {
    res := "\""
    n := str.Len(s)
    for i := 0; i < n; i = i + 1 {
        c := s[i]
        if c == 34 { // \"
            res = str.Concat(res, "\\\"")
        } else if c == 92 { // \
            res = str.Concat(res, "\\\\")
        } else if c == 8 { // \b
            res = str.Concat(res, "\\b")
        } else if c == 12 { // \f
            res = str.Concat(res, "\\f")
        } else if c == 10 { // \n
            res = str.Concat(res, "\\n")
        } else if c == 13 { // \r
            res = str.Concat(res, "\\r")
        } else if c == 9 { // \t
            res = str.Concat(res, "\\t")
        } else {
            // Pass through printable characters unchanged
            res = str.Concat(res, str.Substr(s, i, 1))
        }
    }
    res = str.Concat(res, "\"")
    return res
}

// floatToString converts a float to its JSON string representation.
// It emits up to 6 fractional digits, stripping trailing zeros.
fn floatToString(n: float) -> string {
    if n == 0.0 {
        return "0"
    }
    neg := false
    if n < 0.0 {
        neg = true
        n = -n
    }
    intPart := int(n)
    frac := n - float(intPart)
    res := intToString(intPart)
    if frac > 0.0001 {
        // Emit fractional digits one at a time
        res = str.Concat(res, ".")
        for i := 0; i < 6; i = i + 1 {
            frac = frac * 10.0
            d := int(frac)
            res = str.Concat(res, intToString(d))
            frac = frac - float(d)
            // Stop once remaining fraction is negligible
            if frac < 0.0001 {
                break
            }
        }
    }
    if neg {
        res = str.Concat("-", res)
    }
    return res
}

// intToString converts a non-negative integer to its decimal string form.
fn intToString(n: int) -> string {
    if n == 0 {
        return "0"
    }
    neg := false
    if n < 0 {
        neg = true
        n = -n
    }
    res := ""
    // Extract digits from least to most significant
    for n > 0 {
        d := n % 10
        res = str.Concat(charForDigit(d), res)
        n = n / 10
    }
    if neg {
        res = str.Concat("-", res)
    }
    return res
}

// charForDigit returns the single-character string for digit 0-9.
fn charForDigit(d: int) -> string {
    if d == 0 { return "0" }
    if d == 1 { return "1" }
    if d == 2 { return "2" }
    if d == 3 { return "3" }
    if d == 4 { return "4" }
    if d == 5 { return "5" }
    if d == 6 { return "6" }
    if d == 7 { return "7" }
    if d == 8 { return "8" }
    return "9"
}

// --- Unmarshal ---

// Unmarshal parses a JSON string into a Value. Returns an error if the
// input is not valid JSON or contains trailing data after the root value.
pub fn Unmarshal(s: string) -> (Value, errors.Error) {
    p := Parser{s: s, pos: 0, len: str.Len(s)}
    v := p.parseValue()
    if str.Len(p.errMsg) > 0 {
        // Parser encountered an error during parsing
        return v, errors.New(p.errMsg)
    }
    p.skipWhitespace()
    if p.pos != p.len {
        // Extra characters after the root value are not allowed
        return v, errors.New("invalid JSON: trailing data")
    }
    return v, errors.New("")
}

// Parser holds the state for JSON parsing: input, position, depth, and error.
struct Parser {
    s: string  // the input string
    pos: int  // the position
    len: int  // the length
    depth: int  // the depth
    errMsg: string  // the error message

    fn peek(self: *Parser) -> int {
        self.skipWhitespace()
        if self.pos >= self.len {
            return 0
        }
        return int(self.s[self.pos])
    }

    fn skipWhitespace(self: *Parser) {
        // Advance past spaces, tabs, newlines, and carriage returns
        for self.pos < self.len {
            c := self.s[self.pos]
            if c == 32 || c == 9 || c == 10 || c == 13 {
                self.pos = self.pos + 1
            } else {
                break
            }
        }
    }

    fn consume(self: *Parser) -> int {
        if self.pos >= self.len {
            return 0
        }
        c := self.s[self.pos]
        self.pos = self.pos + 1
        return int(c)
    }

    fn parseValue(self: *Parser) -> Value {
        self.skipWhitespace()
        if self.pos >= self.len {
            return Null()
        }
        // DoS protection: reject excessively deep nesting
        if self.depth > 1000 {
            self.errMsg = "JSON nesting depth exceeded"
            return Null()
        }
        // Dispatch based on the first character
        c := self.s[self.pos]
        if c == 123 { // {
            return self.parseObject()
        }
        if c == 91 { // [
            return self.parseArray()
        }
        if c == 34 { // \"
            return self.parseString()
        }
        if c == 116 { // t
            return self.parseTrue()
        }
        if c == 102 { // f
            return self.parseFalse()
        }
        if c == 110 { // n
            return self.parseNull()
        }
        // Default: treat as number
        return self.parseNumber()
    }

    fn parseObject(self: *Parser) -> Value {
        self.depth = self.depth + 1
        self.consume() // {
        var keys []string
        var vals []Value
        for {
            self.skipWhitespace()
            if self.pos < self.len && self.s[self.pos] == 125 { // }
                self.consume()
                break
            }
            // Keys must be strings in JSON
            keyVal := self.parseString()
            self.skipWhitespace()
            if self.pos < self.len && self.s[self.pos] == 58 { // :
                self.consume()
            }
            val := self.parseValue()
            keys = append(keys, keyVal.strVal)
            vals = append(vals, val)
            self.skipWhitespace()
            if self.pos < self.len && self.s[self.pos] == 44 { // ,
                self.consume()
            } else if self.pos < self.len && self.s[self.pos] == 125 { // }
                self.consume()
                break
            } else {
                break
            }
        }
        self.depth = self.depth - 1
        return FromObject(keys, vals)
    }

    fn parseArray(self: *Parser) -> Value {
        self.depth = self.depth + 1
        self.consume() // [
        var arr []Value
        for {
            self.skipWhitespace()
            if self.pos < self.len && self.s[self.pos] == 93 { // ]
                self.consume()
                break
            }
            val := self.parseValue()
            arr = append(arr, val)
            self.skipWhitespace()
            if self.pos < self.len && self.s[self.pos] == 44 { // ,
                self.consume()
            } else if self.pos < self.len && self.s[self.pos] == 93 { // ]
                self.consume()
                break
            } else {
                break
            }
        }
        self.depth = self.depth - 1
        return FromArray(arr)
    }

    fn parseString(self: *Parser) -> Value {
        if self.pos >= self.len || self.s[self.pos] != 34 {
            // Not a string; return empty without consuming.
            return Value{kind: 3, strVal: ""}
        }
        self.consume() // \"
        b := str.NewBuilder(16)
        for self.pos < self.len {
            c := self.s[self.pos]
            if c == 34 { // \"
                self.consume()
                break
            }
            if c == 92 { // \
                self.consume()
                if self.pos >= self.len {
                    break
                }
                // Decode escape sequence
                esc := self.s[self.pos]
                if esc == 34 {
                    str.WriteByte(&b, 34)
                } else {
                    if esc == 92 {
                        str.WriteByte(&b, 92)
                    } else {
                        if esc == 47 {
                            str.WriteByte(&b, 47)
                        } else {
                            if esc == 98 {
                                str.WriteByte(&b, 8)
                            } else {
                                if esc == 102 {
                                    str.WriteByte(&b, 12)
                                } else {
                                    if esc == 110 {
                                        str.WriteByte(&b, 10)
                                    } else {
                                        if esc == 114 {
                                            str.WriteByte(&b, 13)
                                        } else {
                                            if esc == 116 {
                                                str.WriteByte(&b, 9)
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                self.consume()
            } else {
                // Regular character
                str.WriteByte(&b, int(c))
                self.consume()
            }
        }
        res := str.String(b)
        str.Free(&b)
        return FromString(res)
    }

    fn parseTrue(self: *Parser) -> Value {
        // Validate "true" exactly
        if self.pos + 4 > self.len {
            return Null()
        }
        if self.s[self.pos] != 116 || self.s[self.pos + 1] != 114 ||
           self.s[self.pos + 2] != 117 || self.s[self.pos + 3] != 101 {
            return Null()
        }
        self.pos = self.pos + 4
        return FromBool(true)
    }

    fn parseFalse(self: *Parser) -> Value {
        // Validate "false" exactly
        if self.pos + 5 > self.len {
            return Null()
        }
        if self.s[self.pos] != 102 || self.s[self.pos + 1] != 97 ||
           self.s[self.pos + 2] != 108 || self.s[self.pos + 3] != 115 ||
           self.s[self.pos + 4] != 101 {
            return Null()
        }
        self.pos = self.pos + 5
        return FromBool(false)
    }

    fn parseNull(self: *Parser) -> Value {
        // Validate "null" exactly
        if self.pos + 4 > self.len {
            return Null()
        }
        if self.s[self.pos] != 110 || self.s[self.pos + 1] != 117 ||
           self.s[self.pos + 2] != 108 || self.s[self.pos + 3] != 108 {
            return Null()
        }
        self.pos = self.pos + 4
        return Null()
    }

    fn parseNumber(self: *Parser) -> Value {
        start := self.pos
        neg := false
        if self.pos < self.len && self.s[self.pos] == 45 { // -
            neg = true
            self.consume()
        }
        // Consume integer digits (0-9)
        for self.pos < self.len && self.s[self.pos] >= 48 && self.s[self.pos] <= 57 {
            self.consume()
        }
        hasFrac := false
        if self.pos < self.len && self.s[self.pos] == 46 { // .
            hasFrac = true
            self.consume()
            // Consume fractional digits
            for self.pos < self.len && self.s[self.pos] >= 48 && self.s[self.pos] <= 57 {
                self.consume()
            }
        }
        // Handle exponent (e/E +/- digits)
        if self.pos < self.len && (self.s[self.pos] == 101 || self.s[self.pos] == 69) {
            hasFrac = true
            self.consume()
            // Optional sign in exponent
            if self.pos < self.len && (self.s[self.pos] == 43 || self.s[self.pos] == 45) {
                self.consume()
            }
            for self.pos < self.len && self.s[self.pos] >= 48 && self.s[self.pos] <= 57 {
                self.consume()
            }
        }
        numStr := str.Substr(self.s, start, self.pos - start)
        if hasFrac {
            // Use ParseFloat for numbers with fractional or exponent parts
            f, ok := strconv.ParseFloat(numStr)
            if ok {
                return FromNumber(f)
            }
            return FromNumber(0.0)
        }
        // Simple integer parse
        n := parseInt(numStr)
        val := float(n)
        if neg {
            val = -val
        }
        return FromNumber(val)
    }
}

// parseInt parses a string of decimal digits into an int.
fn parseInt(s: string) -> int {
    n := 0
    for i := 0; i < str.Len(s); i = i + 1 {
        c := s[i]
        if c >= 48 && c <= 57 {
            n = n * 10 + int(c - 48)
        }
    }
    return n
}

// --- Legacy entry-based API ---

// Entry is a simple key-value pair used by the legacy entry-based JSON API.
pub struct Entry {
    key: string  // the key
    value: string  // the value

    // Key returns the entry's key string.
    pub fn Key(self: Entry) -> string {
        return self.key
    }

    // Value returns the entry's value string.
    pub fn Value(self: Entry) -> string {
        return self.value
    }
}

// MarshalEntries serializes parallel key and value slices into a JSON object
// string. Only the first n pairs are included.
pub fn MarshalEntries(keys: []string, values: []string, n: int) -> string {
    res := "{"
    for i := 0; i < n; i = i + 1 {
        if i > 0 {
            res = str.Concat(res, ",")
        }
        res = str.Concat(res, escapeString(keys[i]))
        res = str.Concat(res, ":")
        res = str.Concat(res, escapeString(values[i]))
    }
    res = str.Concat(res, "}")
    return res
}

// UnmarshalEntries parses a JSON object string into a slice of Entry pairs.
// Only string values are supported; non-string values yield empty strings.
pub fn UnmarshalEntries(s: string) -> ([]Entry, errors.Error) {
    v, err := Unmarshal(s)
    if err.message != "" {
        var empty []Entry
        return empty, err
    }
    var entries []Entry
    n := v.ObjectLen()
    for i := 0; i < n; i = i + 1 {
        k, val := v.ObjectGetByIndex(i)
        e := Entry{key: k, value: val.AsString()}
        entries = append(entries, e)
    }
    return entries, errors.New("")
}

// --- Struct marshal/unmarshal via reflect + [json] field tags ---

// jsonScalarType reports whether typeName is a field type MarshalStruct
// supports: int, int64, string, float, or bool.
fn jsonScalarType(typeName: string) -> bool {
    return str.Equal(typeName, "int") || str.Equal(typeName, "int64") ||
        str.Equal(typeName, "string") || str.Equal(typeName, "float") ||
        str.Equal(typeName, "bool")
}

// jsonFieldName resolves a field's JSON key: [json(name=x)] wins,
// otherwise the field name itself.
fn jsonFieldName(f: reflect.Field) -> string {
    if name, ok := reflect.TagKey(f.tag, "json", "name"); ok {
        return name
    }
    return f.name
}

// unsupportedFieldErr builds the field-type error shared by
// MarshalStruct and UnmarshalInto.
fn unsupportedFieldErr(f: reflect.Field) -> errors.Error {
    return errors.New(str.Concat(str.Concat("json: unsupported field type \"", f.type_name), str.Concat("\" on field \"", str.Concat(f.name, "\" — only int, int64, string, float, bool are supported"))))
}

// isEmptyValue reports whether the field on the struct at ptr holds its
// zero value — used by the [json(omitempty)] flag.
fn isEmptyValue(ptr: int64, f: reflect.Field) -> bool {
    if str.Equal(f.type_name, "int") {
        return reflect.GetInt(ptr, f) == 0
    }
    if str.Equal(f.type_name, "int64") {
        return reflect.GetInt64(ptr, f) == int64(0)
    }
    if str.Equal(f.type_name, "string") {
        return str.Len(reflect.GetString(ptr, f)) == 0
    }
    if str.Equal(f.type_name, "float") {
        return reflect.GetFloat(ptr, f) == 0.0
    }
    if str.Equal(f.type_name, "bool") {
        return reflect.GetBool(ptr, f) == false
    }
    return false
}

// marshalField converts one scalar struct field to a JSON Value.
fn marshalField(ptr: int64, f: reflect.Field) -> Value {
    if str.Equal(f.type_name, "string") {
        return FromString(reflect.GetString(ptr, f))
    }
    if str.Equal(f.type_name, "bool") {
        return FromBool(reflect.GetBool(ptr, f))
    }
    if str.Equal(f.type_name, "int") {
        return FromNumber(float(reflect.GetInt(ptr, f)))
    }
    if str.Equal(f.type_name, "int64") {
        return FromNumber(float(reflect.GetInt64(ptr, f)))
    }
    return FromNumber(reflect.GetFloat(ptr, f))
}

// MarshalStruct serializes the struct at ptr (pass int64(&obj)) to a
// JSON object string, reading fields through the reflected type t.
// Field names map to JSON keys by name unless overridden:
//   [json(name=x)]    rename the key to x
//   [json(ignore)]    omit the field entirely
//   [json(omitempty)] omit the field when it holds its zero value
// Only scalar fields are supported (int, int64, string, float, bool);
// a nested-struct, slice, map, or pointer field returns an error
// naming the field.
pub fn MarshalStruct(t: reflect.Type, ptr: int64) -> (string, errors.Error) {
    var keys []string
    var vals []Value
    n := reflect.FieldCount(t)
    for i := 0; i < n; i = i + 1 {
        f := reflect.FieldByIndex(t, i)
        if reflect.TagHasFlag(f.tag, "json", "ignore") {
            continue
        }
        if jsonScalarType(f.type_name) == false {
            return "", unsupportedFieldErr(f)
        }
        if reflect.TagHasFlag(f.tag, "json", "omitempty") && isEmptyValue(ptr, f) {
            continue
        }
        keys = append(keys, jsonFieldName(f))
        vals = append(vals, marshalField(ptr, f))
    }
    return MarshalValue(FromObject(keys, vals)), errors.None()
}

// unmarshalField writes one JSON value into the field on the struct at
// ptr, converting the JSON kind to the field's declared type.
fn unmarshalField(ptr: int64, f: reflect.Field, v: Value) {
    if str.Equal(f.type_name, "int") {
        reflect.SetInt(ptr, f, int(AsNumber(v)))
    } else if str.Equal(f.type_name, "int64") {
        reflect.SetInt64(ptr, f, int64(AsNumber(v)))
    } else if str.Equal(f.type_name, "string") {
        reflect.SetString(ptr, f, AsString(v))
    } else if str.Equal(f.type_name, "float") {
        reflect.SetFloat(ptr, f, AsNumber(v))
    } else if str.Equal(f.type_name, "bool") {
        reflect.SetBool(ptr, f, AsBool(v))
    }
}

// UnmarshalInto parses s as a JSON object and writes each matching key
// into the struct at ptr (pass int64(&obj)) using the reflected type t.
// Keys not present in the JSON leave their fields unchanged; JSON keys
// with no matching field are ignored. Honours [json(name=x)] and
// [json(ignore)]; unsupported field types return an error naming the
// field.
pub fn UnmarshalInto(s: string, t: reflect.Type, ptr: int64) -> errors.Error {
    v, err := Unmarshal(s)
    if err.message != "" {
        return err
    }
    if v.kind != 5 {
        return errors.New("json: expected a JSON object")
    }
    n := reflect.FieldCount(t)
    for i := 0; i < n; i = i + 1 {
        f := reflect.FieldByIndex(t, i)
        if reflect.TagHasFlag(f.tag, "json", "ignore") {
            continue
        }
        if jsonScalarType(f.type_name) == false {
            return unsupportedFieldErr(f)
        }
        fv := ObjectGet(v, jsonFieldName(f))
        if IsNull(fv) {
            continue
        }
        unmarshalField(ptr, f, fv)
    }
    return errors.None()
}
