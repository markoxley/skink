module spi

import "std/errors"
extern fn Skink_mem_byte(ptr: string, idx: int64) -> int
import "std/libc"

extern fn Skink_mem_write_byte(ptr: string, idx: int64, val: int)
import "std/strconv"

extern fn open(path: string, flags: int) -> int
extern fn ioctl(fd: int, request: int64, arg: int64) -> int
extern fn Skink_close_fd(fd: int) -> int

// Linux <linux/spi/spidev.h> ioctl request codes.
pub const SPI_IOC_MESSAGE_1        = 0x40206B00
pub const SPI_IOC_WR_MODE          = 0x40016B01
pub const SPI_IOC_WR_BITS_PER_WORD = 0x40016B03
pub const SPI_IOC_WR_MAX_SPEED_HZ  = 0x40046B04

// pack_u32_le writes a 32-bit little-endian integer into buf at byte offset off.
fn pack_u32_le(buf: string, off: int, v: int) {
    // Raw writes: buf is an ioctl parameter block, not a string.
    Skink_mem_write_byte(buf, int64(off), v & 255)
    Skink_mem_write_byte(buf, int64(off + 1), (v >> 8) & 255)
    Skink_mem_write_byte(buf, int64(off + 2), (v >> 16) & 255)
    Skink_mem_write_byte(buf, int64(off + 3), (v >> 24) & 255)
}

// pack_u64_le writes a 64-bit little-endian integer into buf at byte offset off.
fn pack_u64_le(buf: string, off: int, v: int64) {
    for i := 0; i < 8; i = i + 1 {
        Skink_mem_write_byte(buf, int64(off + i), int((v >> (i * 8)) & 255))
    }
}

// Device represents an SPI device connection on a /dev/spidevB.C node.
//
//   - fd:      the kernel file descriptor for /dev/spidevB.C (or 1 in
//              workstation fallback mode; 0 when closed).
//   - speedHz: the max bus clock in Hz requested at Open time.
//   - mode:    the SPI mode (MODE_0..MODE_3) requested at Open time.
//   - bits:    bits per word (typically 8).
//   - hw:      true when fd is a live /dev/spidevB.C descriptor.
pub struct Device {
    fd: int  // the file descriptor
    speedHz: int  // the speed hz
    mode: int  // the mode
    bits: int  // the bits
    hw: bool  // whether backed by a real /dev/spidevB.C descriptor

    // Transfer performs a full-duplex transfer of len bytes: tx is clocked out
    // while rx is clocked in simultaneously. The returned string is the received
    // bytes (NUL-terminated) and must be freed with libc.free.
    pub fn Transfer(self: *Device, tx: string, len: int) -> (string, errors.Error) {
        rx := libc.malloc(len + 1)
        if self.hw {
            // struct spi_ioc_transfer (32 bytes on Linux):
            //   0..7:   u64 tx_buf
            //   8..15:  u64 rx_buf
            //   16..19: u32 len
            //   20..23: u32 speed_hz
            //   24..25: u16 delay_usecs
            //   26:     u8  bits_per_word
            tr := libc.malloc(32)
            libc.memset(tr, 0, 32)
            pack_u64_le(tr, 0, int64(tx))
            pack_u64_le(tr, 8, int64(rx))
            pack_u32_le(tr, 16, len)
            pack_u32_le(tr, 20, self.speedHz)
            Skink_mem_write_byte(tr, int64(26), self.bits & 255)
            rc := ioctl(self.fd, int64(SPI_IOC_MESSAGE_1), int64(tr))
            libc.free(tr)
            if rc < 0 {
                Skink_mem_write_byte(rx, int64(0), 0)
                return rx, errors.New("spi transfer ioctl failed")
            }
            Skink_mem_write_byte(rx, int64(len), 0)
            return rx, errors.New("")
        }
        // Workstation fallback: loopback tx into rx so callers can test
        // full-duplex buffer handling without hardware.
        for i := 0; i < len; i = i + 1 {
            Skink_mem_write_byte(rx, int64(i), Skink_mem_byte(tx, int64(i)))
        }
        Skink_mem_write_byte(rx, int64(len), 0)
        return rx, errors.New("")
    }

    // Write sends len bytes and discards the received data.
    // Returns the number of bytes written.
    pub fn Write(self: *Device, data: string, len: int) -> int {
        rx, err := self.Transfer(data, len)
        libc.free(rx)
        if err.message != "" {
            return 0
        }
        return len
    }

    // Read clocks out zero bytes and returns up to len received bytes. The
    // returned string is heap-allocated and must be freed with libc.free.
    pub fn Read(self: *Device, len: int) -> (string, errors.Error) {
        tx := libc.malloc(len + 1)
        libc.memset(tx, 0, len + 1)
        rx, err := self.Transfer(tx, len)
        libc.free(tx)
        return rx, err
    }

    // Close releases the device file descriptor. It is idempotent.
    pub fn Close(self: *Device) -> errors.Error {
        if self.fd != 0 {
            if self.hw {
                Skink_close_fd(self.fd)
            }
            self.fd = 0
            self.hw = false
        }
        return errors.New("")
    }

    // Fd returns the underlying kernel file descriptor, or 0 when closed.
    pub fn Fd(self: Device) -> int {
        return self.fd
    }

    // Speed returns the configured bus clock in Hz.
    pub fn Speed(self: Device) -> int {
        return self.speedHz
    }

    // Mode returns the configured SPI mode (MODE_0..MODE_3).
    pub fn Mode(self: Device) -> int {
        return self.mode
    }

    // Bits returns the configured bits per word.
    pub fn Bits(self: Device) -> int {
        return self.bits
    }
}

// Open opens /dev/spidev{bus}.{chipSelect} and configures mode, bits-per-word
// (8), and speedHz via ioctl. When the device node is absent or inaccessible
// (e.g. on a workstation), it falls back to an in-memory loopback Device.
pub fn Open(bus: int, chipSelect: int, speedHz: int, mode: int) -> (Device, errors.Error) {
    if bus < 0 || chipSelect < 0 || speedHz <= 0 || mode < 0 || mode > 3 {
        return Device{fd: 0, speedHz: speedHz, mode: mode, bits: 8, hw: false}, errors.New("invalid spi parameters")
    }
    path := "/dev/spidev" + strconv.Itoa(bus) + "." + strconv.Itoa(chipSelect)
    fd := open(path, 2) // O_RDWR = 2
    if fd >= 0 {
        buf := libc.malloc(4)
        Skink_mem_write_byte(buf, int64(0), mode & 255)
        ioctl(fd, int64(SPI_IOC_WR_MODE), int64(buf))
        Skink_mem_write_byte(buf, int64(0), 8)
        ioctl(fd, int64(SPI_IOC_WR_BITS_PER_WORD), int64(buf))
        pack_u32_le(buf, 0, speedHz)
        ioctl(fd, int64(SPI_IOC_WR_MAX_SPEED_HZ), int64(buf))
        libc.free(buf)
        return Device{fd: fd, speedHz: speedHz, mode: mode, bits: 8, hw: true}, errors.New("")
    }
    return Device{fd: 1, speedHz: speedHz, mode: mode, bits: 8, hw: false}, errors.New("")
}

// SPI mode constants (CPOL/CPHA combinations, from <linux/spi/spi.h>).
//   - MODE_0: CPOL=0, CPHA=0 (clock idle low, sample on leading edge).
//   - MODE_1: CPOL=0, CPHA=1 (clock idle low, sample on trailing edge).
//   - MODE_2: CPOL=1, CPHA=0 (clock idle high, sample on leading edge).
//   - MODE_3: CPOL=1, CPHA=1 (clock idle high, sample on trailing edge).
pub const MODE_0 = 0
pub const MODE_1 = 1  // 1 mode
pub const MODE_2 = 2  // 2 mode
pub const MODE_3 = 3  // 3 mode

// Bit order constants.
pub const MSB_FIRST = 0
pub const LSB_FIRST = 1  // the lsb first

// Common SPI clock speeds (Hz), for convenience.
pub const SPEED_100KHZ = 100000
pub const SPEED_1MHZ = 1000000  // the speed 1 mhz
pub const SPEED_5MHZ = 5000000  // the speed 5 mhz
pub const SPEED_10MHZ = 10000000  // the speed 10 mhz
pub const SPEED_20MHZ = 20000000  // the speed 20 mhz
