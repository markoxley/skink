module rand_test

import "std/rand"
import "std/libc"
import "testing"

// TestIntnRange verifies Intn returns a value in [0, n).
pub fn TestIntnRange() {
    rand.Seed(int64(42))
    v := rand.Intn(10)
    if v < 0 {
        Errorf("Intn should be non-negative")
    }
    if v >= 10 {
        Errorf("Intn should be less than n")
    }
}

// TestIntnZero verifies Intn(0) returns 0.
pub fn TestIntnZero() {
    v := rand.Intn(0)
    if v != 0 {
        Errorf("Intn(0) should return 0")
    }
}

// TestIntnOne verifies Intn(1) returns 0.
pub fn TestIntnOne() {
    v := rand.Intn(1)
    if v != 0 {
        Errorf("Intn(1) should return 0")
    }
}

// TestInt verifies Int returns a non-negative value.
pub fn TestInt() {
    rand.Seed(int64(42))
    v := rand.Int()
    if v < 0 {
        Errorf("Int should be non-negative")
    }
}

// TestIntnDistribution verifies multiple calls stay in range.
pub fn TestIntnDistribution() {
    rand.Seed(int64(42))
    for i := 0; i < 100; i = i + 1 {
        v := rand.Intn(5)
        if v < 0 || v >= 5 {
            Errorf("Intn distribution out of range")
        }
    }
}

// TestInt8 verifies Int8 returns a value in [-128, 127].
pub fn TestInt8() {
    rand.Seed(int64(42))
    for i := 0; i < 100; i = i + 1 {
        v := rand.Int8()
        if v < int8(-128) || v > int8(127) {
            Errorf("Int8 out of range")
        }
    }
}

// TestInt8n verifies Int8n returns a value in [0, n).
pub fn TestInt8n() {
    rand.Seed(int64(42))
    for i := 0; i < 100; i = i + 1 {
        v := rand.Int8n(int8(10))
        if v < 0 || v >= int8(10) {
            Errorf("Int8n out of range")
        }
    }
}

