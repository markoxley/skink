// TestFloatRange verifies Float returns [0.0, 1.0).
pub fn TestFloatRange() {
    rand.Seed(int64(42))
    for i := 0; i < 100; i = i + 1 {
        f := rand.Float()
        if f < 0.0 {
            Errorf("Float should be >= 0")
        }
        if f >= 1.0 {
            Errorf("Float should be < 1")
        }
    }
}

// TestFloat64Range verifies Float64 returns [0.0, 1.0).
pub fn TestFloat64Range() {
    rand.Seed(int64(42))
    for i := 0; i < 100; i = i + 1 {
        f := rand.Float64()
        if f < 0.0 {
            Errorf("Float64 should be >= 0")
        }
        if f >= 1.0 {
            Errorf("Float64 should be < 1")
        }
    }
}

// TestFloatn verifies Floatn returns [0.0, n).
pub fn TestFloatn() {
    rand.Seed(int64(42))
    for i := 0; i < 100; i = i + 1 {
        f := rand.Floatn(10.0)
        if f < 0.0 || f >= 10.0 {
            Errorf("Floatn out of range")
        }
    }
}

// TestBytes verifies Bytes writes the requested number of bytes.
pub fn TestBytes() {
    rand.Seed(int64(42))
    buf := libc.malloc(16)
    n := rand.Bytes(buf, 16)
    if n != 16 {
        Errorf("Bytes should return requested length")
    }
    libc.free(buf)
}

// TestBytesZeroLength verifies Bytes with len 0 returns 0.
pub fn TestBytesZeroLength() {
    buf := libc.malloc(1)
    n := rand.Bytes(buf, 0)
    if n != 0 {
        Errorf("Bytes(0) should return 0")
    }
    libc.free(buf)
}

// TestRead verifies Read fills a slice.
pub fn TestRead() {
    rand.Seed(int64(42))
    buf := make([]int, 32)
    n := rand.Read(buf)
    if n != 32 {
        Errorf("Read should return slice length")
    }
}

// TestPerm verifies Perm returns a valid permutation.
pub fn TestPerm() {
    rand.Seed(int64(42))
    p := rand.Perm(10)
    if len(p) != 10 {
        Errorf("Perm should return n elements")
    }
    // Verify all values 0..9 are present exactly once
    seen := make([]bool, 10)
    for i := 0; i < 10; i = i + 1 {
        v := p[i]
        if v < 0 || v >= 10 {
            Errorf("Perm contains out-of-range value")
        }
        if seen[v] {
            Errorf("Perm contains duplicate value")
        }
        seen[v] = true
    }
}

// TestPermZero verifies Perm(0) returns an empty slice.
pub fn TestPermZero() {
    p := rand.Perm(0)
    if len(p) != 0 {
        Errorf("Perm(0) should return empty slice")
    }
}

// TestSeedReproducibility verifies that the same seed produces the same sequence.
pub fn TestSeedReproducibility() {
    rand.Seed(int64(123))
    a1 := rand.Intn(1000)
    a2 := rand.Intn(1000)
    rand.Seed(int64(123))
    b1 := rand.Intn(1000)
    b2 := rand.Intn(1000)
    if a1 != b1 {
        Errorf("Same seed should produce same first value")
    }
    if a2 != b2 {
        Errorf("Same seed should produce same second value")
    }
}
