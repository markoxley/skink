// bytesEqual compares two raw byte buffers by length and content.
// Unlike str.Equal (which uses strcmp), this handles buffers that may
// contain embedded null bytes.
fn bytesEqual(a: string, b: string, len: int) -> bool {
    if len <= 0 {
        return true
    }
    for i := 0; i < len; i = i + 1 {
        if a[i] != b[i] {
            return false
        }
    }
    return true
}

// TestAES128Roundtrip verifies AES-128-GCM encrypt then decrypt restores
// the original plaintext.
pub fn TestAES128Roundtrip() {
    aes := encrypt.NewAES(aesKey128)
    plaintext := "hello world"
    result, e1 := aes.Encrypt(plaintext, 11)
    if e1.message != "" {
        Errorf("AES-128 Encrypt should not error: " + e1.message)
    }
    // GCM: 12 (nonce) + 16 (tag) + 11 (ciphertext) = 39
    if result.length != 39 {
        Errorf("AES-128 ciphertext+nonce+tag should be 39 bytes, got " + strconv.Itoa(result.length))
    }
    restored, e2 := aes.Decrypt(result.data, result.length)
    if e2.message != "" {
        Errorf("AES-128 Decrypt should not error: " + e2.message)
    }
    if restored.length != 11 {
        Errorf("AES-128 restored length should be 11, got " + strconv.Itoa(restored.length))
    }
    if bytesEqual(restored.data, plaintext, restored.length) == false {
        Errorf("AES-128 roundtrip should restore plaintext")
    }
}

// TestAES256Roundtrip verifies AES-256-GCM encrypt then decrypt.
pub fn TestAES256Roundtrip() {
    aes := encrypt.NewAES(aesKey256)
    plaintext := "hello world"
    result, e1 := aes.Encrypt(plaintext, 11)
    if e1.message != "" {
        Errorf("AES-256 Encrypt should not error: " + e1.message)
    }
    restored, e2 := aes.Decrypt(result.data, result.length)
    if e2.message != "" {
        Errorf("AES-256 Decrypt should not error: " + e2.message)
    }
    if restored.length != 11 {
        Errorf("AES-256 restored length should be 11, got " + strconv.Itoa(restored.length))
    }
    if bytesEqual(restored.data, plaintext, restored.length) == false {
        Errorf("AES-256 roundtrip should restore plaintext")
    }
}

// TestAESEmptyData verifies AES-GCM with empty data.
pub fn TestAESEmptyData() {
    aes := encrypt.NewAES(aesKey128)
    result, e1 := aes.Encrypt("", 0)
    if e1.message != "" {
        Errorf("AES Encrypt empty should not error: " + e1.message)
    }
    // GCM: 12 (nonce) + 16 (tag) + 0 (ciphertext) = 28
    if result.length != 28 {
        Errorf("AES empty encrypt should produce 28 bytes, got " + strconv.Itoa(result.length))
    }
    restored, e2 := aes.Decrypt(result.data, result.length)
    if e2.message != "" {
        Errorf("AES Decrypt empty should not error: " + e2.message)
    }
    if restored.length != 0 {
        Errorf("AES empty roundtrip should restore length 0, got " + strconv.Itoa(restored.length))
    }
}

// TestAESDifferentKeys verifies different keys produce different ciphertext.
pub fn TestAESDifferentKeys() {
    key1 := "0123456789abcdef"
    key2 := "fedcba9876543210"
    aes1 := encrypt.NewAES(key1)
    aes2 := encrypt.NewAES(key2)
    plain := "hello world"
    r1, _ := aes1.Encrypt(plain, 11)
    r2, _ := aes2.Encrypt(plain, 11)
    if r1.length != r2.length {
        Errorf("Ciphertext lengths should match")
    }
    same := true
    for i := 0; i < r1.length; i = i + 1 {
        if r1.data[i] != r2.data[i] {
            same = false
        }
    }
    if same == true {
        Errorf("Different keys should produce different ciphertext")
    }
}

// TestAESWrongKey verifies decryption with wrong key fails.
pub fn TestAESWrongKey() {
    aes1 := encrypt.NewAES("0123456789abcdef")
    aes2 := encrypt.NewAES("fedcba9876543210")
    result, _ := aes1.Encrypt("secret data", 11)
    _, e := aes2.Decrypt(result.data, result.length)
    if e.message == "" {
        Errorf("Decryption with wrong key should fail")
    }
}

// TestAESInvalidKey verifies invalid key lengths are rejected.
pub fn TestAESInvalidKey() {
    aes := encrypt.NewAES("short")
    _, e := aes.Encrypt("data", 4)
    if e.message == "" {
        Errorf("Invalid key length should be rejected")
    }
}

// TestRSARoundtrip verifies RSA encrypt then decrypt restores the message.
pub fn TestRSARoundtrip() {
    rsa := encrypt.NewRSA(rsaPubKey, rsaPrivKey)
    msg := "test message"
    result, e1 := rsa.Encrypt(msg, 11)
    if e1.message != "" {
        Errorf("RSA Encrypt should not error: " + e1.message)
    }
    if result.length <= 0 {
        Errorf("RSA ciphertext length should be positive, got " + strconv.Itoa(result.length))
    }
    restored, e2 := rsa.Decrypt(result.data, result.length)
    if e2.message != "" {
        Errorf("RSA Decrypt should not error: " + e2.message)
    }
    if restored.length != 11 {
        Errorf("RSA restored length should be 11, got " + strconv.Itoa(restored.length))
    }
    if bytesEqual(restored.data, msg, restored.length) == false {
        Errorf("RSA roundtrip should restore message")
    }
}

// TestRSANoPrivateKey verifies decryption fails without a private key.
pub fn TestRSANoPrivateKey() {
    rsa := encrypt.NewRSA(rsaPubKey, "")
    _, e := rsa.Decrypt("dummy", 5)
    if e.message == "" {
        Errorf("RSA Decrypt without private key should fail")
    }
}

// TestRSANoPublicKey verifies encryption fails without a public key.
pub fn TestRSANoPublicKey() {
    rsa := encrypt.NewRSA("", rsaPrivKey)
    _, e := rsa.Encrypt("dummy", 5)
    if e.message == "" {
        Errorf("RSA Encrypt without public key should fail")
    }
}
