module encrypt_test

import "std/encrypt"
import "std/str"
import "std/strconv"
import "testing"

// Test AES key must be exactly 16, 24, or 32 bytes.
const aesKey128 = "0123456789abcdef"
const aesKey256 = "0123456789abcdef0123456789abcdef"

