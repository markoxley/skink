module testing_apis_test

import "testing"

// TestAssertEqualFloatAPI verifies AssertEqualFloat testing helper.
pub fn TestAssertEqualFloatAPI() {
    testing.AssertEqualFloat(1.0, 1.0, "exact")
    testing.AssertEqualFloat(100.0, 100.005, "within eps")
    testing.AssertEqualFloat(0.0, 0.0, "zero")
}

// TestAssertNotNilGeneric verifies AssertNil and AssertNotNil helpers.
pub fn TestAssertNotNilGeneric() {
    s := "hello"
    testing.AssertNotNil(s, "string non-null")
    var p *int
    p = nil
    testing.AssertNil(p, "nil pointer")
    testing.AssertNotNil(s, "generic any")
}
