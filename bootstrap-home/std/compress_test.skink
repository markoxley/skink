module compress_test

import "std/compress"
import "testing"

// TestGzipWriterCreate verifies that a GzipWriter can be created and
// written to without crashing.
pub fn TestGzipWriterCreate() {
    gw := compress.NewGzipWriter(6)
    n, err := gw.Write("hello", 5)
    if err.message != "" {
        Errorf("GzipWriter Write returned unexpected error")
    }
    if n != 5 {
        Errorf("GzipWriter Write should return bytes written")
    }
    _, cerr := gw.Close()
    if cerr.message != "" {
        Errorf("GzipWriter Close returned unexpected error")
    }
}

// TestDeflaterCompress verifies that Deflater.Compress returns compressed data.
pub fn TestDeflaterCompress() {
    d := compress.Deflater{windowBits: 15, memLevel: 8}
    out, outLen := d.Compress("abc", 3)
    if out == "" {
        Errorf("Deflater should return non-empty output")
    }
    if outLen == 0 {
        Errorf("Deflater should return positive length")
    }
}

// TestInflaterDecompress verifies that Inflater.Decompress returns data.
pub fn TestInflaterDecompress() {
    d := compress.Deflater{windowBits: 15, memLevel: 8}
    compressed, compLen := d.Compress("abc", 3)
    i := compress.Inflater{}
    out := i.Decompress(compressed, compLen, 12)
    if out == "" {
        Errorf("Inflater should return non-empty output")
    }
}

// TestDeflaterInflaterRoundtrip verifies compression and decompression roundtrip.
pub fn TestDeflaterInflaterRoundtrip() {
    data := "hello world"
    d := compress.Deflater{windowBits: 15, memLevel: 8}
    compressed, compLen := d.Compress(data, 11)
    if compressed == "" || compLen == 0 {
        Errorf("Compress should produce non-empty output")
    }
    i := compress.Inflater{}
    decompressed := i.Decompress(compressed, compLen, 11)
    if decompressed == "" {
        Errorf("Decompress should return non-empty output")
    }
}

// TestDeflaterEmptyData verifies compression of empty data.
pub fn TestDeflaterEmptyData() {
    d := compress.Deflater{windowBits: 15, memLevel: 8}
    compressed, compLen := d.Compress("", 0)
    if compressed == "" && compLen == 0 {
        Errorf("Compress of empty data should not crash")
    }
}

// TestGzipWriterEmpty verifies GzipWriter with no data.
pub fn TestGzipWriterEmpty() {
    gw := compress.NewGzipWriter(6)
    _, cerr := gw.Close()
    if cerr.message != "" {
        Errorf("GzipWriter Close with no data should not error")
    }
}

// TestInflaterEmptyData verifies Inflater handles empty data without crashing.
pub fn TestInflaterEmptyData() {
    i := compress.Inflater{}
    out := i.Decompress("", 0, 1)
    if str.Equal(out, "") == false {
        Errorf("Inflater empty data should return empty output")
    }
}

// --- VULN-13 security regressions ---

// packedLen reads the compressed-length field out of a Compress() blob
// so callers can supply the real byte length to DecompressBuf — the
// blob contains NUL bytes so str.Len cannot report it.
fn packedLen(packed: string) -> int {
    clen := int(packed[4]) | (int(packed[5]) << 8) | (int(packed[6]) << 16) | (int(packed[7]) << 24)
    return 8 + clen
}

// TestDecompressBufRoundtrip guards VULN-13: the length-explicit API
// round-trips Compress output.
pub fn TestDecompressBufRoundtrip() {
    src := "hello hello hello hello"
    packed, err := compress.Compress(src)
    testing.AssertTrue(err.message == "", "compress ok")
    back, derr := compress.DecompressBuf(packed, packedLen(packed))
    testing.AssertTrue(derr.message == "", "DecompressBuf ok")
    testing.AssertEqualString(src, back, "DecompressBuf roundtrip")
}

// TestDecompressBufRejectsShort guards VULN-13: fewer than 8 input
// bytes must be an error, not an out-of-bounds header read.
pub fn TestDecompressBufRejectsShort() {
    _, err := compress.DecompressBuf("abc", 3)
    testing.AssertTrue(err.message != "", "short input must error")
    _, err2 := compress.DecompressBuf("abcdefg", 7)
    testing.AssertTrue(err2.message != "", "7-byte input must error")
}

// TestDecompressBufRejectsBadLength guards VULN-13: a header claiming
// more compressed bytes than the caller's length must error instead of
// reading past the buffer.
pub fn TestDecompressBufRejectsBadLength() {
    src := "hello hello hello hello"
    packed, err := compress.Compress(src)
    testing.AssertTrue(err.message == "", "compress ok")
    total := packedLen(packed)
    // Claim fewer bytes than the blob actually carries: clen > len-8
    // must be rejected.
    _, derr := compress.DecompressBuf(packed, total - 1)
    testing.AssertTrue(derr.message != "", "truncated length must error")
}

// TestDecompressBufRejectsBomb guards VULN-13: a header claiming a
// giant original size must be rejected before any multi-hundred-MB
// "decompression bomb" allocation is attempted.
pub fn TestDecompressBufRejectsBomb() {
    packed, err := compress.Compress("tiny")
    testing.AssertTrue(err.message == "", "compress ok")
    // Corrupt origSize to ~2 GiB (little-endian byte 3 = 0x7F).
    packed[3] = 127
    _, derr := compress.DecompressBuf(packed, packedLen(packed))
    testing.AssertTrue(derr.message != "", "origSize bomb must error")
}
