module context_test

import "std/context"
import "std/time"
import "testing"

// TestBackground verifies a background context is not cancelled.
pub fn TestBackground() {
    ctx := context.Background()
    if ctx.Done() == true {
        testing.Errorf("Background context should not be done")
    }
}

// TestCancel verifies Cancel marks a context as done.
pub fn TestCancel() {
    ctx := context.Background()
    ctx.Cancel()
    if ctx.Done() == false {
        testing.Errorf("Cancelled context should be done")
    }
}

// TestWithCancel verifies child context creation and propagation.
pub fn TestWithCancel() {
    parent := context.Background()
    child := context.WithCancel(&parent)
    if child.Done() == true {
        testing.Errorf("New child context should not be done")
    }

    parent.Cancel()
    if child.Done() == false {
        testing.Errorf("Child context should be done when parent is cancelled")
    }
}

// TestWithDeadline verifies automatic deadline cancellation.
pub fn TestWithDeadline() {
    parent := context.Background()
    // Set a deadline in the past.
    child := context.WithDeadline(&parent, time.NowUnixNano() - int64(1000000))
    if child.Done() == false {
        testing.Errorf("Deadline context should be done if deadline is in the past")
    }
}

// TestWithTimeout verifies timeout functionality.
pub fn TestWithTimeout() {
    parent := context.Background()
    // Set a timeout of 0, which should be immediately done.
    // Using a direct struct init if factory fails.
    var d time.Duration
    child := context.WithTimeout(&parent, d)
    if child.Done() == false {
        testing.Errorf("Timeout context should be done with 0 timeout")
    }
}

// TestWithValue verifies value storage and retrieval.
pub fn TestWithValue() {
    ctx1 := context.Background()
    ctx2 := context.WithValue(&ctx1, "key1", "val1")
    ctx3 := context.WithValue(&ctx2, "key2", "val2")

    if ctx3.Value("key1") != "val1" {
        testing.Errorf("Value key1 should be val1")
    }
    if ctx3.Value("key2") != "val2" {
        testing.Errorf("Value key2 should be val2")
    }
    if ctx3.Value("key3") != "" {
        testing.Errorf("Value key3 should be empty")
    }
}

// TestDoneChan verifies that DoneChan works with select.
pub fn TestDoneChan() {
    parent := context.Background()
    ctx := context.WithCancel(&parent)

    // Initially not done
    if ctx.Done() == true {
        testing.Errorf("Context should not be done yet")
    }

    ctx.Cancel()

    // Now it should be done
    if ctx.Done() == false {
        testing.Errorf("Context should be done after Cancel")
    }
}

// ==========================================================================
// Issue #16 regression: &local escaping into a heap struct field
// ==========================================================================

// CtxPtrHolder mirrors the reported bug shape: a struct holds a
// *context.Context field populated with the address of a constructor's
// local variable.
struct CtxPtrHolder {
    ctx: *context.Context
}

// newCtxPtrHolder stores &ctx — the address of a stack local — into a
// value that outlives this frame. Before the escape-analysis fix this
// stored a raw stack address that dangled as soon as the frame returned;
// Done() then read garbage and could recurse on a corrupt parent pointer
// until the worker's stack overflowed.
fn newCtxPtrHolder() -> CtxPtrHolder {
    ctx := context.Background()
    return CtxPtrHolder{ctx: &ctx}
}

// clobberStack tramples the stack region a just-returned frame occupied,
// so a dangling &local deterministically reads garbage rather than
// accidentally seeing its own stale bytes.
fn clobberStack(depth: int) -> int {
    if depth <= 0 {
        return 0
    }
    marker := depth*2654435761 + 12345
    return clobberStack(depth - 1) + 1 + marker - marker
}

// TestEscapedContextField guards issue #16: self.ctx.Done() through a
// *context.Context field read garbage / segfaulted because &ctx stored a
// stack address that died with the constructor's frame.
pub fn TestEscapedContextField() {
    h := newCtxPtrHolder()
    _ = clobberStack(64)
    if h.ctx.Done() == true {
        testing.Errorf("escaped *context.Context returned garbage from Done")
    }
    h.ctx.Cancel()
    if h.ctx.Done() == false {
        testing.Errorf("Cancel through escaped *context.Context not visible")
    }
}

var watchChan16 chan<int>

// ctxWatch polls Done() on a *Context — the spawned-thread side of the
// #16 reproducer.
fn ctxWatch(c: *context.Context) {
    ticks := 0
    for ticks < 2000000 {
        if c.Done() {
            watchChan16 <- ticks
            return
        }
        ticks = ticks + 1
    }
    watchChan16 <- -1
}

// TestSpawnedEscapedContextField verifies a spawned worker can read a
// *Context field whose backing local escaped a dead frame.
pub fn TestSpawnedEscapedContextField() {
    h := newCtxPtrHolder()
    _ = clobberStack(64)
    watchChan16 = make(chan<int>, 1)
    spawn ctxWatch(h.ctx)
    time.SleepMs(20)
    h.ctx.Cancel()
    t := <-watchChan16
    if t < 0 {
        testing.Errorf("spawned worker never observed Cancel")
    }
}
