module db

import "std/str"
import "std/errors"

// SQLite C runtime wrappers (compiler/runtime/db_rt.c).
extern fn Skink_db_open(filename: string) -> int64
extern fn Skink_db_close(handle: int64) -> int
extern fn Skink_db_errmsg(handle: int64) -> string
extern fn Skink_db_exec(handle: int64, sql: string) -> int64
extern fn Skink_db_prepare(handle: int64, sql: string) -> int64
extern fn Skink_db_step(stmt: int64) -> int
extern fn Skink_db_column_count(stmt: int64) -> int
extern fn Skink_db_column_text(stmt: int64, col: int) -> string
extern fn Skink_db_column_name(stmt: int64, col: int) -> string
extern fn Skink_db_finalize(stmt: int64)
extern fn Skink_db_bind_text(stmt: int64, idx: int, value: string) -> int
extern fn Skink_db_bind_int(stmt: int64, idx: int, value: int) -> int
extern fn Skink_db_bind_int64(stmt: int64, idx: int, value: int64) -> int
extern fn Skink_db_bind_double(stmt: int64, idx: int, value: float) -> int
extern fn Skink_db_bind_null(stmt: int64, idx: int) -> int
extern fn Skink_db_reset(stmt: int64) -> int

// Row represents a single database row.
pub struct Row {
    values: []string  // the values
}

// Result holds query results.
// Use Next to advance through rows and Scan to read column values.
pub struct Result {
    rows: []Row  // the rows
    columns: []string  // the columns
    affected: int64  // the affected
    stmt: int64  // the statement
    hasRow: bool  // whether row

    // Next advances the result to the next row and reports whether one exists.
    pub fn Next(self: *Result) -> bool {
        if self.stmt == int64(0) {
            self.hasRow = false
            return false
        }
        rc := Skink_db_step(self.stmt)
        if rc == 100 { // SQLITE_ROW
            self.hasRow = true
            return true
        }
        Skink_db_finalize(self.stmt)
        self.stmt = int64(0)
        self.hasRow = false
        return false
    }

    // Scan returns column idx's value as a string.
    pub fn Scan(self: Result, idx: int) -> (string, errors.Error) {
        if self.stmt == int64(0) {
            return "", errors.New("no active query")
        }
        if self.hasRow == false {
            return "", errors.New("Scan called before Next")
        }
        return Skink_db_column_text(self.stmt, idx), errors.New("")
    }

    // BindText binds a string value to the 1-indexed parameter slot.
    pub fn BindText(self: *Result, idx: int, value: string) -> errors.Error {
        if self.stmt == int64(0) {
            return errors.New("no active statement")
        }
        if Skink_db_bind_text(self.stmt, idx, value) != 0 {
            return errors.New("bind text failed")
        }
        return errors.New("")
    }

    // BindInt binds an integer value to the 1-indexed parameter slot.
    pub fn BindInt(self: *Result, idx: int, value: int) -> errors.Error {
        if self.stmt == int64(0) {
            return errors.New("no active statement")
        }
        if Skink_db_bind_int(self.stmt, idx, value) != 0 {
            return errors.New("bind int failed")
        }
        return errors.New("")
    }

    // BindInt64 binds a 64-bit integer value to the 1-indexed parameter slot.
    pub fn BindInt64(self: *Result, idx: int, value: int64) -> errors.Error {
        if self.stmt == int64(0) {
            return errors.New("no active statement")
        }
        if Skink_db_bind_int64(self.stmt, idx, value) != 0 {
            return errors.New("bind int64 failed")
        }
        return errors.New("")
    }

    // BindFloat binds a double value to the 1-indexed parameter slot.
    pub fn BindFloat(self: *Result, idx: int, value: float) -> errors.Error {
        if self.stmt == int64(0) {
            return errors.New("no active statement")
        }
        if Skink_db_bind_double(self.stmt, idx, value) != 0 {
            return errors.New("bind float failed")
        }
        return errors.New("")
    }

    // BindNull binds a NULL value to the 1-indexed parameter slot.
    pub fn BindNull(self: *Result, idx: int) -> errors.Error {
        if self.stmt == int64(0) {
            return errors.New("no active statement")
        }
        if Skink_db_bind_null(self.stmt, idx) != 0 {
            return errors.New("bind null failed")
        }
        return errors.New("")
    }

    // Reset clears bindings and resets the statement for re-execution.
    pub fn Reset(self: *Result) -> errors.Error {
        if self.stmt == int64(0) {
            return errors.New("no active statement")
        }
        if Skink_db_reset(self.stmt) != 0 {
            return errors.New("reset failed")
        }
        return errors.New("")
    }

    // ColumnCount returns the number of columns in the result set.
    pub fn ColumnCount(self: Result) -> int {
        return len(self.columns)
    }

    // ColumnName returns the name of column idx in the result set,
    // or an empty string when idx is out of range.
    pub fn ColumnName(self: Result, idx: int) -> string {
        if idx < 0 || idx >= len(self.columns) {
            return ""
        }
        return self.columns[idx]
    }

    // Close finalizes the prepared statement early, releasing it before
    // the rows are fully consumed. Safe to call after Next has finished.
    pub fn Close(self: *Result) {
        if self.stmt != int64(0) {
            Skink_db_finalize(self.stmt)
            self.stmt = int64(0)
            self.hasRow = false
        }
    }
}

// Connection is a SQLite database connection.
pub struct Connection {
    driver: string  // the driver
    dsn: string  // the dsn
    handle: int64  // the handle

    // Exec executes a SQL statement that returns no rows.
    pub fn Exec(self: *Connection, sql: string) -> (Result, errors.Error) {
        var emptyRows []Row
        var emptyCols []string
        if self.handle == int64(0) {
            return Result{rows: emptyRows, columns: emptyCols, affected: int64(0), stmt: int64(0), hasRow: false}, errors.New("not connected")
        }
        affected := Skink_db_exec(self.handle, sql)
        return Result{rows: emptyRows, columns: emptyCols, affected: affected, stmt: int64(0), hasRow: false}, errors.New("")
    }

    // Query executes sql and returns the resulting rows.
    pub fn Query(self: *Connection, sql: string) -> (Result, errors.Error) {
        var emptyRows []Row
        var emptyCols []string
        if self.handle == int64(0) {
            return Result{rows: emptyRows, columns: emptyCols, affected: int64(0), stmt: int64(0), hasRow: false}, errors.New("not connected")
        }
        stmt := Skink_db_prepare(self.handle, sql)
        if stmt == int64(0) {
            return Result{rows: emptyRows, columns: emptyCols, affected: int64(0), stmt: int64(0), hasRow: false}, errors.New("prepare failed")
        }
        count := Skink_db_column_count(stmt)
        for i := 0; i < count; i = i + 1 {
            emptyCols = append(emptyCols, Skink_db_column_name(stmt, i))
        }
        return Result{rows: emptyRows, columns: emptyCols, affected: int64(0), stmt: stmt, hasRow: false}, errors.New("")
    }

    // Close releases the connection and its resources.
    pub fn Close(self: *Connection) -> errors.Error {
        if self.handle != int64(0) {
            rc := Skink_db_close(self.handle)
            self.handle = int64(0)
            if rc == 0 {
                return errors.New("")
            }
            return errors.New("close failed")
        }
        return errors.New("not connected")
    }

    // LastError returns the most recent error message.
    pub fn LastError(self: Connection) -> string {
        if self.handle == int64(0) {
            return "not connected"
        }
        return Skink_db_errmsg(self.handle)
    }
}

// Open creates a database connection.
pub fn Open(driver: string, dsn: string) -> (Connection, errors.Error) {
    if driver != "sqlite3" {
        return Connection{driver: driver, dsn: dsn, handle: int64(0)}, errors.New("unsupported driver")
    }
    handle := Skink_db_open(dsn)
    if handle == int64(0) {
        return Connection{driver: driver, dsn: dsn, handle: int64(0)}, errors.New("open failed")
    }
    return Connection{driver: driver, dsn: dsn, handle: handle}, errors.New("")
}

// Deprecated: QuoteString is a naive SQL string escaper that is not safe
// against all injection attacks. Use parameterized queries with BindText
// instead (prepare with "?" placeholders, then call BindText).
pub fn QuoteString(s: string) -> string {
    sLen := str.Len(s)
    result := "'"
    for i := 0; i < sLen; i = i + 1 {
        if s[i] == 39 {
            result = str.Concat(result, "''")
        } else {
            result = str.Concat(result, str.Substr(s, i, 1))
        }
    }
    return str.Concat(result, "'")
}
