pub fn LocalStorageGet(key: string) -> string {
    return ""
}

// LocalStorageSet writes `key = val` to `window.localStorage`.
pub fn LocalStorageSet(key: string, val: string) {
}

// LocalStorageRemove deletes `key` from `window.localStorage`.
pub fn LocalStorageRemove(key: string) {
}

// LocalStorageClear clears all entries in `window.localStorage`.
pub fn LocalStorageClear() {
}

// SessionStorageGet reads `key` from `window.sessionStorage` (returns `""` if absent).
pub fn SessionStorageGet(key: string) -> string {
    return ""
}

// SessionStorageSet writes `key = val` to `window.sessionStorage`.
pub fn SessionStorageSet(key: string, val: string) {
}

// SessionStorageRemove deletes `key` from `window.sessionStorage`.
pub fn SessionStorageRemove(key: string) {
}

// === Fetch, WebSocket & Canvas2D ===

// FetchText performs an asynchronous HTTP GET `fetch(url)` and invokes `onSuccess(body)` or `onError(errMsg)`.
pub fn FetchText(url: string, onSuccess: fn(string), onError: fn(string)) {
}

// FetchJSON performs an asynchronous HTTP `fetch(url, { method, headers, body })` and invokes `onSuccess(responseText, statusCode)` or `onError(errMsg)`.
pub fn FetchJSON(url: string, method: string, body: string, onSuccess: fn(string, int), onError: fn(string)) {
}

// ConnectWebSocket opens a browser `WebSocket` connection to `url` and wires lifecycle callbacks.
pub fn ConnectWebSocket(url: string, onOpen: fn(), onMessage: fn(string), onClose: fn()) -> WebSocket {
    return WebSocket{handle: 1}
}

// GetCanvas2D obtains the 2D rendering context (`canvas.getContext("2d")`) for a `<canvas>` element.
pub fn GetCanvas2D(canvasEl: Element) -> Canvas2D {
    return Canvas2D{handle: 1}
}
