module gpio

import "std/errors"
import "std/fs"
import "std/strconv"
import "std/str"

// Pin represents a single GPIO pin identified by its BCM number.
//
//   - number: the BCM GPIO number passed to PinFactory.
//   - mode:   the current pin direction (INPUT, OUTPUT, or PWM_MODE).
//   - value:  the last level written to (or read from) the pin.
//   - hw:     true when backed by /sys/class/gpio/gpioN on a Linux board;
//             false when running against the in-memory workstation fallback.
pub struct Pin {
    number: int  // the number
    mode: int  // the mode
    value: int  // the value
    hw: bool  // whether sysfs hardware backend is active

    // SetOutput configures the pin as a digital output.
    pub fn SetOutput(self: *Pin) {
        self.mode = OUTPUT
        if self.hw {
            p := "/sys/class/gpio/gpio" + strconv.Itoa(self.number) + "/direction"
            fs.WriteAll(p, "out")
        }
    }

    // SetInput configures the pin as a digital input.
    pub fn SetInput(self: *Pin) {
        self.mode = INPUT
        if self.hw {
            p := "/sys/class/gpio/gpio" + strconv.Itoa(self.number) + "/direction"
            fs.WriteAll(p, "in")
        }
    }

    // Write drives the pin to the given level (LOW or HIGH).
    pub fn Write(self: *Pin, val: int) {
        self.value = val
        if self.hw {
            p := "/sys/class/gpio/gpio" + strconv.Itoa(self.number) + "/value"
            if val != 0 {
                fs.WriteAll(p, "1")
            } else {
                fs.WriteAll(p, "0")
            }
        }
    }

    // Read returns the current level of the pin (LOW or HIGH).
    pub fn Read(self: Pin) -> int {
        if self.hw {
            p := "/sys/class/gpio/gpio" + strconv.Itoa(self.number) + "/value"
            s, err := fs.ReadAll(p)
            if err.message == "" && str.Len(s) > 0 {
                if s[0] == 49 { // '1'
                    return HIGH
                }
                return LOW
            }
        }
        return self.value
    }

    // PWM sets the duty cycle (0..100) for hardware pulse-width modulation.
    // When /sys/class/pwm/pwmchip0 is present on Linux, configures a 50 Hz
    // (20,000,000 ns) frame and writes the corresponding duty_cycle in ns;
    // otherwise records the clamped duty in self.value for simulation.
    pub fn PWM(self: *Pin, duty: int) {
        d := duty
        if d < 0 { d = 0 }
        if d > 100 { d = 100 }
        self.value = d
        if fs.Exists("/sys/class/pwm/pwmchip0") {
            ch := "/sys/class/pwm/pwmchip0/pwm0"
            if !fs.Exists(ch) {
                fs.WriteAll("/sys/class/pwm/pwmchip0/export", "0")
            }
            fs.WriteAll(ch + "/period", "20000000")
            fs.WriteAll(ch + "/duty_cycle", strconv.Itoa(d * 200000))
            fs.WriteAll(ch + "/enable", "1")
        }
    }

    // Number returns the BCM GPIO number of this pin.
    pub fn Number(self: Pin) -> int {
        return self.number
    }

    // Mode returns the current pin direction (INPUT, OUTPUT, or PWM_MODE).
    pub fn Mode(self: Pin) -> int {
        return self.mode
    }

    // SetMode sets the pin direction: INPUT, OUTPUT, or PWM_MODE.
    pub fn SetMode(self: *Pin, mode: int) {
        if mode == INPUT {
            self.SetInput()
        } else if mode == PWM_MODE {
            self.mode = PWM_MODE
        } else {
            self.SetOutput()
        }
    }

    // SetPull configures the internal pull resistor: 0=off, 1=down, 2=up.
    pub fn SetPull(self: *Pin, pull: int) {
        // sysfs does not expose pull-resistor control; retained for API compatibility.
    }
}

// Setup initializes the GPIO subsystem. Succeeds on both sysfs-equipped
// Linux boards and workstation fallback environments.
pub fn Setup() -> errors.Error {
    return errors.New("")
}

// PinFactory creates a Pin by its BCM number. When /sys/class/gpio is
// writable on the host, the pin is exported and backed by sysfs; otherwise
// an in-memory pin is returned so code can run on any workstation.
pub fn PinFactory(bcmNumber: int) -> Pin {
    pinDir := "/sys/class/gpio/gpio" + strconv.Itoa(bcmNumber)
    if fs.Exists("/sys/class/gpio/export") && !fs.Exists(pinDir) {
        fs.WriteAll("/sys/class/gpio/export", strconv.Itoa(bcmNumber))
    }
    hasHw := fs.Exists(pinDir + "/value")
    return Pin{number: bcmNumber, mode: INPUT, value: LOW, hw: hasHw}
}

// Pin direction constants used by SetInput/SetOutput and Mode.
pub const INPUT = 0
pub const OUTPUT = 1  // the output
pub const PWM_MODE = 2  // the pwm mode

// Cleanup releases GPIO resources. The stub backend is a no-op; on
// wiringPi/pigpio it unexports pins and releases the backend.
pub fn Cleanup() {
    // no-op on the stub backend
}

// Pin level constants used by Write/Read.
pub const LOW = 0
pub const HIGH = 1  // the high

// Pull resistor constants for future SetPull support.
// On wiringPi these map to PUD_OFF/PUD_DOWN/PUD_UP via pullUpDnControl.
pub const PULL_OFF = 0
pub const PULL_DOWN = 1  // the pull down
pub const PULL_UP = 2  // the pull up
