module rules_engine_test

import "testing"
import "std/rules"

var engFired: int

fn engineFire() {
    engFired = engFired + 1
}

var engTemp: float

fn isHot() -> bool {
    return engTemp > 30.0
}

fn isCold() -> bool {
    return engTemp < 10.0
}

// TestEngineEval verifies rules engine fires actions on matching conditions.
pub fn TestEngineEval() {
    engFired = 0
    engTemp = 35.0
    e := rules.NewEngine()
    e.AddRule("hot", isHot)
    e.AddRule("cold", isCold)
    e.AddAction("hot", engineFire)
    e.Evaluate()
    testing.AssertEqualInt(1, engFired, "hot rule fired once")
    e.Evaluate()
    testing.AssertEqualInt(2, engFired, "hot rule fires each tick")
    engTemp = 5.0
    e.Evaluate()
    testing.AssertEqualInt(2, engFired, "cold has no action")
}
