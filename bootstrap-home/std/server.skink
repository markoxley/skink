extern fn Skink_mem_write_byte(ptr: string, idx: int64, val: int)
import "std/sync"
import "std/time"
import "std/waitgroup"
import "std/web/types"
import "std/web/router"

extern fn Skink_tls_ctx_create() -> int64
extern fn Skink_tls_ctx_use_certificate_file(ctx: int64, certPath: string) -> int
extern fn Skink_tls_ctx_use_private_key_file(ctx: int64, keyPath: string) -> int
extern fn Skink_tls_ctx_check_private_key(ctx: int64) -> int
extern fn Skink_tls_ctx_add_cert(ctx: int64, hostname: string, certPath: string, keyPath: string) -> int
extern fn Skink_tls_accept(ctx: int64, fd: int) -> int64
extern fn Skink_tls_read(ssl: int64, buf: string, len: int) -> int
extern fn Skink_tls_write(ssl: int64, buf: string, len: int) -> int
extern fn Skink_tls_write_all(ssl: int64, buf: string, len: int) -> int
extern fn Skink_tls_close(ssl: int64)
extern fn Skink_tls_ctx_free(ctx: int64)
extern fn Skink_web_spawn_conn(handler: string, server: string, fd: int)
extern fn Skink_web_spawn_tls_conn(handler: string, server: string, fd: int, ctx: int64)
extern fn Skink_close_fd(fd: int) -> int
extern fn shutdown(fd: int, how: int) -> int
extern fn Skink_mem_alloc(size: int64) -> string
extern fn Skink_mem_realloc(ptr: string, size: int64) -> string

// TLSConfig holds certificate and private key file paths for HTTPS.
pub struct TLSConfig {
    certFile: string  // the certificate file
    keyFile:  string  // the key file
}

// SniCert binds an extra certificate to a hostname for SNI-based
// selection — the server picks this cert when the client's TLS
// ClientHello carries the matching servername (comp_error.md #67).
pub struct SniCert {
    hostname: string  // the hostname
    certFile: string  // the certificate file
    keyFile:  string  // the key file
}

// Server wraps a TCP listener and a router to serve HTTP requests,
// optionally over TLS. maxRequestBytes bounds a single request
// (headers + body); 0 selects the 1 MiB default (comp_error.md #49).
// readTimeoutMs/writeTimeoutMs bound each socket read/write; 0 selects
// 30 seconds (#48). maxConns bounds concurrent connections; 0 selects
// 512 (#61). Shutdown() stops the accept loop and drains in-flight
// handlers (#63).
pub struct Server {
    port:            int  // the port
    handler:         *router.Router  // the handler
    tls:             *TLSConfig  // the TLS
    maxRequestBytes: int  // the maximum request bytes
    readTimeoutMs:   int  // the read timeout in milliseconds
    writeTimeoutMs:  int  // the write timeout in milliseconds
    maxConns:        int  // the maximum connections
    listenFd:        int  // the listen file descriptor
    shuttingDown:    int  // the shutting down
    trackConns:      int  // the track conns
    slotMu:          *sync.Mutex  // the slot mutex
    slotCond:        sync.Cond  // the slot cond
    activeConns:     int  // the active conns
    maxConnsEff:     int  // the maximum conns eff
    wg:              *waitgroup.WaitGroup  // the wait group
    sniCerts:        []SniCert  // the sni certs

    // initConcurrency prepares the connection-limit semaphore (a
    // mutex+condvar counter — Skink channels are unbounded queues, not
    // counting semaphores), the drain WaitGroup, and the shutdown flag.
    // Called once per ListenAndServe[TLS] invocation (#61, #63).
    fn initConcurrency(self: *Server) {
        self.maxConnsEff = self.maxConns
        if self.maxConnsEff <= 0 {
            self.maxConnsEff = 512
        }
        self.slotMu = sync.NewMutex()
        self.slotCond = sync.NewCond(self.slotMu)
        self.activeConns = 0
        self.wg = waitgroup.New()
        self.trackConns = 1
        sync.AtomicStore(&self.shuttingDown, 0)
    }

    // acquireConnSlot blocks until fewer than maxConnsEff connections
    // are active, then takes one slot (comp_error.md #61).
    fn acquireConnSlot(self: *Server) {
        self.slotMu.Lock()
        for self.activeConns >= self.maxConnsEff {
            self.slotCond.Wait()
        }
        self.activeConns = self.activeConns + 1
        self.slotMu.Unlock()
    }

    // releaseConnSlot frees a connection slot and wakes a waiter.
    fn releaseConnSlot(self: *Server) {
        self.slotMu.Lock()
        self.activeConns = self.activeConns - 1
        self.slotMu.Unlock()
        self.slotCond.Signal()
    }

    // SetLimits configures the server's resource limits before
    // ListenAndServe[TLS]. Each value selects the documented default
    // when <= 0: maxRequestBytes bounds a single request head+body
    // (default 1 MiB — raise for file-upload routes), readTimeoutMs and
    // writeTimeoutMs bound each socket operation (default 30 s), and
    // maxConns bounds concurrent connections (default 512).
    pub fn SetLimits(self: *Server, maxRequestBytes: int, readTimeoutMs: int, writeTimeoutMs: int, maxConns: int) {
        self.maxRequestBytes = maxRequestBytes
        self.readTimeoutMs = readTimeoutMs
        self.writeTimeoutMs = writeTimeoutMs
        self.maxConns = maxConns
    }

    // AddTLSCertificate registers an additional cert/key pair served
    // when clients send the matching SNI hostname. Call before
    // ListenAndServeTLS; the certFile/keyFile passed there remain the
    // default for clients with no (or unmatched) SNI (comp_error.md #67).
    pub fn AddTLSCertificate(self: *Server, hostname: string, certFile: string, keyFile: string) {
        self.sniCerts = append(self.sniCerts, SniCert{hostname: hostname, certFile: certFile, keyFile: keyFile})
    }

    // Shutdown stops accepting new connections and lets ListenAndServe
    // return once in-flight handlers drain. shutdown() wakes a blocked
    // accept() — close() alone does not reliably interrupt an
    // in-progress accept on Linux (comp_error.md #63).
    pub fn Shutdown(self: *Server) {
        sync.AtomicStore(&self.shuttingDown, 1)
        if self.listenFd != 0 {
            shutdown(self.listenFd, 2) // SHUT_RDWR (== SD_BOTH on Windows)
            Skink_close_fd(self.listenFd)
            self.listenFd = 0
        }
    }

    // ListenAndServe starts the HTTP server on the configured port,
    // spawning a new thread per accepted connection for concurrency.
    // It returns after Shutdown() is called and in-flight connections
    // drain.
    pub fn ListenAndServe(self: *Server) -> errors.Error {
        listener, err := net.Listen("0.0.0.0", self.port)
        if err.message != "" {
            return err
        }
        self.listenFd = listener.fd
        self.initConcurrency()
        // Accept loop: each connection is handled in its own thread,
        // bounded by the connSlots semaphore.
        acceptErrs := 0
        for sync.AtomicLoad(&self.shuttingDown) == 0 {
            conn, err := net.Accept(listener)
            if err.message != "" {
                if sync.AtomicLoad(&self.shuttingDown) != 0 {
                    break
                }
                // Back off on persistent accept failures (e.g. EMFILE)
                // instead of spinning at 100% CPU (comp_error.md #62).
                acceptErrs = acceptErrs + 1
                backoff := 50 * acceptErrs
                if backoff > 1000 {
                    backoff = 1000
                }
                time.SleepMs(backoff)
                continue
            }
            acceptErrs = 0
            // Take a handler slot before spawning; once maxConns
            // connections are active this blocks so the kernel backlog
            // absorbs the burst (comp_error.md #61).
            self.acquireConnSlot()
            self.wg.Add(1)
            Skink_web_spawn_conn(handleConnThread, self, conn.fd)
        }
        // Drain in-flight connection handlers before returning.
        self.wg.Wait()
        if self.listenFd != 0 {
            Skink_close_fd(listener.fd)
            self.listenFd = 0
        }
        return errors.New("")
    }

    // ListenAndServeTLS starts the HTTPS server using the provided
    // certificate and private key files, spawning a new thread per
    // accepted TLS connection. It returns after Shutdown() is called and
    // in-flight connections drain.
    pub fn ListenAndServeTLS(self: *Server, certFile: string, keyFile: string) -> errors.Error {
        self.tls = &TLSConfig{certFile: certFile, keyFile: keyFile}
        listener, err := net.Listen("0.0.0.0", self.port)
        if err.message != "" {
            return err
        }
        self.listenFd = listener.fd
        self.initConcurrency()
        // Create the TLS context and load certificate/key material.
        ctx := Skink_tls_ctx_create()
        if ctx == 0 {
            return errors.New("failed to create TLS context")
        }
        if Skink_tls_ctx_use_certificate_file(ctx, certFile) != 0 {
            Skink_tls_ctx_free(ctx)
            return errors.New("failed to load certificate")
        }
        if Skink_tls_ctx_use_private_key_file(ctx, keyFile) != 0 {
            Skink_tls_ctx_free(ctx)
            return errors.New("failed to load private key")
        }
        // Verify that the certificate and key match.
        if Skink_tls_ctx_check_private_key(ctx) != 0 {
            Skink_tls_ctx_free(ctx)
            return errors.New("private key does not match certificate")
        }
        // Register per-hostname certs for SNI selection (#67).
        for c in self.sniCerts {
            if Skink_tls_ctx_add_cert(ctx, c.hostname, c.certFile, c.keyFile) != 0 {
                Skink_tls_ctx_free(ctx)
                return errors.New("failed to load SNI certificate for " + c.hostname)
            }
        }
        // Accept loop: each TLS connection is handled in its own thread,
        // bounded by the connSlots semaphore.
        acceptErrs := 0
        for sync.AtomicLoad(&self.shuttingDown) == 0 {
            conn, err := net.Accept(listener)
            if err.message != "" {
                if sync.AtomicLoad(&self.shuttingDown) != 0 {
                    break
                }
                acceptErrs = acceptErrs + 1
                backoff := 50 * acceptErrs
                if backoff > 1000 {
                    backoff = 1000
                }
                time.SleepMs(backoff)
                continue
            }
            acceptErrs = 0
            self.acquireConnSlot()
            self.wg.Add(1)
            Skink_web_spawn_tls_conn(handleTLSConnThread, self, conn.fd, ctx)
        }
        self.wg.Wait()
        if self.listenFd != 0 {
            Skink_close_fd(listener.fd)
            self.listenFd = 0
        }
        Skink_tls_ctx_free(ctx)
        return errors.New("")
    }

    // effectiveLimits resolves the zero-means-default limit fields.
    fn effectiveLimits(self: *Server) -> (int, int, int) {
        maxReq := self.maxRequestBytes
        if maxReq <= 0 { maxReq = 1048576 }
        rto := self.readTimeoutMs
        if rto <= 0 { rto = 30000 }
        wto := self.writeTimeoutMs
        if wto <= 0 { wto = 30000 }
        return maxReq, rto, wto
    }

    // handleConn serves HTTP requests on one accepted TCP connection.
    // It loops for keep-alive: each iteration parses one request, runs
    // the handler, and writes the response (comp_error.md #45, #64).
    // A panic anywhere in the handler is recovered and answered with
    // 500 so it cannot take the whole process down (#46).
    fn handleConn(self: *Server, conn: net.Connection) {
        defer fn() {
            if str.Len(recover()) > 0 {
                sendErrorConn(conn, 500)
            }
        }()
        maxReq, rto, wto := self.effectiveLimits()
        conn.SetTimeouts(rto, wto)
        // RC buffer: Skink_str_len is then O(1) and deterministic (size-1)
        // for the indexed header scans and the compaction loop.
        r := connReader{conn: conn, ssl: 0, buf: Skink_mem_alloc(int64(8192)), bufCap: 8192, len: 0, head: 0, max: maxReq}
        hijacked := self.serveRequests(&r)
        libc.free(r.buf)
        if !hijacked {
            conn.Close()
        }
    }

    // handleTLSConn wraps an accepted connection in TLS, then serves
    // keep-alive HTTP requests over the encrypted channel.
    fn handleTLSConn(self: *Server, conn: net.Connection, ctx: int64) {
        maxReq, rto, wto := self.effectiveLimits()
        conn.SetTimeouts(rto, wto)
        // Perform the TLS handshake over the accepted TCP socket.
        ssl := Skink_tls_accept(ctx, conn.fd)
        defer fn() {
            if str.Len(recover()) > 0 && ssl != 0 {
                sendErrorTLS(ssl, 500)
            }
        }()
        if ssl == 0 {
            conn.Close()
            return
        }
        r := connReader{conn: conn, ssl: ssl, buf: Skink_mem_alloc(int64(8192)), bufCap: 8192, len: 0, head: 0, max: maxReq}
        hijacked := self.serveRequests(&r)
        libc.free(r.buf)
        if !hijacked {
            Skink_tls_close(ssl)
            conn.Close()
        }
    }

    // serveRequests runs the keep-alive request loop shared by the
    // plain-TCP and TLS paths. Returns true when a handler hijacked the
    // connection via ResponseWriter.Hijack — in that case the callback
    // owns the connection (and TLS handle) and the caller must not
    // close either.
    fn serveRequests(self: *Server, r: *connReader) -> bool {
        for {
            req, code := self.readRequest(r)
            if code == 400 {
                self.sendError(r, 400)
                return false
            }
            if code == 413 {
                self.sendError(r, 413)
                return false
            }
            if code != 200 {
                // Connection closed or timed out — nothing more to send.
                return false
            }
            w := types.ResponseWriter{status: 200, headers: make(map[string]string), body: "", bodyBuf: "", bodyLen: 0, bodyCap: 0}
            self.handler.ServeHTTP(req, &w)
            if w.Hijacked() {
                // The handler takes over the connection: hand it the
                // socket, the TLS handle (0 for plain HTTP), and any
                // bytes the buffered reader already consumed past the
                // end of this request — those bytes belong to the
                // hijacked protocol (e.g. the first WebSocket frames
                // pipelined with the Upgrade request).
                leftoverLen := r.len - r.head
                leftover := ""
                if leftoverLen > 0 {
                    lb := libc.malloc(leftoverLen + 1)
                    libc.memcpy(lb, string(int64(r.buf) + int64(r.head)), leftoverLen)
                    Skink_mem_write_byte(lb, int64(leftoverLen), 0)
                    leftover = lb
                }
                w.hijackFn(r.conn, r.ssl, leftover, leftoverLen)
                return true
            }
            keepAlive := wantsKeepAlive(req)
            if !self.sendResponse(r, &w, keepAlive, str.ToUpper(req.Method()) == "HEAD") {
                return false
            }
            if !keepAlive {
                return false
            }
        }
        return false
    }

    // readRequest parses one complete HTTP request from the buffered
    // reader, consuming exactly the bytes that form it. Returns
    // (Request, code) where code is 200 on success, 400 for a malformed
    // request, 413 when the request exceeds the size cap, and 0 when the
    // connection closed or timed out (comp_error.md #45, #49, #51).
    fn readRequest(self: *Server, r: *connReader) -> (types.Request, int) {
        empty := types.NewRequest("", "", "", make(map[string]string), "")
        // 1. Read until the header terminator is buffered.
        bodyStart := -1
        for bodyStart < 0 {
            bodyStart = indexOfHeaderEnd(r.buf, r.head, r.len)
            if bodyStart < 0 {
                n := r.fill()
                if n == -2 { return empty, 413 }
                if n <= 0 { return empty, 0 }
            }
        }
        // bodyStart is an absolute index just past the "\r\n\r\n" (4
        // bytes) or "\n\n" (2 bytes) delimiter.
        delimLen := 2
        if bodyStart - r.head >= 4 && r.buf[bodyStart - 4] == 13 {
            delimLen = 4
        }
        headLen := bodyStart - delimLen - r.head
        if headLen <= 0 {
            return empty, 400
        }
        // 2. Copy the header block into a NUL-terminated string — it is
        // pure ASCII, so strlen-based parsing is safe there.
        hbuf := libc.malloc(headLen + 1)
        libc.memcpy(hbuf, string(int64(r.buf) + int64(r.head)), headLen)
        Skink_mem_write_byte(hbuf, int64(headLen), 0)
        req := parseRequestHead(hbuf)
        libc.free(hbuf)
        if str.Len(req.Method()) == 0 || str.Len(req.Path()) == 0 {
            return empty, 400
        }
        // Duplicate Content-Length headers make the body boundary
        // ambiguous (request smuggling behind a proxy, comp_error.md
        // #155) — reject outright.
        if req.DupCL() {
            return empty, 400
        }
        // 3. Determine body framing.
        contentLen := 0
        clStr := req.Header("Content-Length")
        if str.Len(clStr) > 0 {
            // Strict Content-Length: RFC 9110 allows DIGITs only, parsed
            // in int64 so >2GB values are rejected rather than wrapping
            // the i32 contentLen into a small copy bound (VULN-14).
            n64, ok := parseContentLength(clStr)
            if !ok {
                return empty, 400
            }
            if n64 > int64(r.max) {
                return empty, 413
            }
            contentLen = int(n64)
        }
        // Transfer-Encoding must contain "chunked" as an exact comma-
        // list token — a substring match let "xchunkedx" smuggle a
        // chunked body past the CL path (VULN-14).
        chunked := hasChunkedToken(str.ToLower(req.Header("Transfer-Encoding")))
        if chunked && str.Len(clStr) > 0 {
            // CL and TE chunked together are ambiguous — front-end and
            // back-end can disagree on the body boundary (request
            // smuggling). Reject outright per RFC 9112 §6.3.3.
            return empty, 400
        }
        if int64(bodyStart - r.head) + int64(contentLen) > int64(r.max) {
            return empty, 413
        }
        // 4. Answer Expect: 100-continue so the client proceeds with the
        // body (comp_error.md #56). Only sent after the size checks so we
        // never invite a body we will reject.
        if (contentLen > 0 || chunked) && str.Contains(str.ToLower(req.Header("Expect")), "100-continue") {
            // Length computed via str.Len — a hardcoded count that is off
            // by one desyncs the whole keep-alive stream (found by
            // TestLiveExpect100).
            cont := "HTTP/1.1 100 Continue\r\n\r\n"
            r.writeAll(cont, str.Len(cont))
        }
        // 5. Read the body into a managed buffer. Two views are stored:
        // bodyBuf/bodyLen for binary-safe access and body as the
        // NUL-terminated text view (#51).
        if chunked {
            body, blen, code := r.readChunkedBody(bodyStart)
            if code != 200 {
                return empty, code
            }
            Skink_mem_write_byte(body, int64(blen), 0)
            req.bodyBuf = body
            req.bodyLen = blen
            req.body = body
        } else {
            for r.len - bodyStart < contentLen {
                n := r.fill()
                if n == -2 { return empty, 413 }
                if n <= 0 { return empty, 0 }
            }
            bbuf := Skink_mem_alloc(int64(contentLen + 1))
            if contentLen > 0 {
                libc.memcpy(bbuf, string(int64(r.buf) + int64(bodyStart)), contentLen)
            }
            Skink_mem_write_byte(bbuf, int64(contentLen), 0)
            req.bodyBuf = bbuf
            req.bodyLen = contentLen
            req.body = bbuf
            r.head = bodyStart + contentLen
        }
        // Record the real socket peer — the only client-address value
        // that cannot be forged in headers (comp_error.md #146).
        peerIP, peerPort := r.conn.PeerAddr()
        if str.Len(peerIP) > 0 {
            req.SetPeer(str.Concat(peerIP,
                str.Concat(":", strconv.Itoa64(int64(peerPort)))))
        }
        return req, 200
    }

    // sendResponse writes the serialized headers (and body, unless the
    // method was HEAD — comp_error.md #57). Returns false on write
    // failure, which ends the keep-alive loop.
    fn sendResponse(self: *Server, r: *connReader, w: *types.ResponseWriter, keepAlive: bool, isHead: bool) -> bool {
        head := serializeHeaders(*w, keepAlive)
        hlen := str.Len(head)
        if r.writeAll(head, hlen) != hlen {
            return false
        }
        if !isHead {
            blen := str.Len(w.body)
            if blen > 0 && r.writeAll(w.body, blen) != blen {
                return false
            }
            // Buffered bytes (Write/WriteBytes) — explicit length, so
            // binary bodies with embedded NULs are sent intact (#51).
            if w.bodyLen > 0 && r.writeAll(w.bodyBuf, w.bodyLen) != w.bodyLen {
                return false
            }
        }
        return true
    }

    // sendError writes a minimal error response without router
    // involvement, used for 400/413 rejections and the panic path.
    fn sendError(self: *Server, r: *connReader, code: int) {
        body := statusText(code)
        resp := "HTTP/1.1 " + fmt.Itoa(code) + " " + body + "\r\n"
        resp = str.Concat(resp, "Content-Length: " + fmt.Itoa(str.Len(body)) + "\r\n")
        resp = str.Concat(resp, "Connection: close\r\n\r\n")
        resp = str.Concat(resp, body)
        r.writeAll(resp, str.Len(resp))
    }
}

// connReader buffers one connection's inbound bytes so the keep-alive
// loop can read several requests and carry leftover (pipelined) bytes
// between them. When ssl is non-zero, reads and writes go through TLS.
struct connReader {
    conn:   net.Connection  // the connection
    ssl:    int64  // the ssl
    buf:    string  // the buffer
    bufCap: int  // the buffer capacity
    len:    int  // the length
    head:   int  // the head
    max:    int  // the maximum

    // fill reads more bytes into the buffer, compacting consumed bytes
    // and growing up to the max request size. Returns bytes read, 0 on
    // close/timeout, -1 on error, and -2 when the cap is exceeded.
    fn fill(self: *connReader) -> int {
        if self.head > 0 && (self.head == self.len || self.len == self.bufCap) {
            // Compact consumed bytes back to the front. A byte-wise move
            // is used because the regions may overlap.
            for i := 0; i < self.len - self.head; i = i + 1 {
                self.buf[i] = self.buf[self.head + i]
            }
            self.len = self.len - self.head
            self.head = 0
        }
        if self.len == self.bufCap {
            if self.bufCap >= self.max {
                return -2
            }
            newCap := self.bufCap * 2
            if newCap > self.max { newCap = self.max }
            self.buf = libc.realloc(self.buf, newCap)
            self.bufCap = newCap
        }
        n := 0
        if self.ssl != 0 {
            n = Skink_tls_read(self.ssl, string(int64(self.buf) + int64(self.len)), self.bufCap - self.len)
        } else {
            n = self.conn.Read(string(int64(self.buf) + int64(self.len)), self.bufCap - self.len)
        }
        if n > 0 {
            self.len = self.len + n
        }
        return n
    }

    // writeAll sends every byte through TCP or TLS depending on the
    // connection type (comp_error.md #47).
    fn writeAll(self: *connReader, data: string, n: int) -> int {
        if self.ssl != 0 {
            return Skink_tls_write_all(self.ssl, data, n)
        }
        return self.conn.SendAll(data, n)
    }

    // readChunkedBody decodes a chunked transfer-encoded body that
    // begins at absolute offset bodyStart, advancing self.head past the
    // terminating chunk. Returns (body, bodyLen, code) with code 200 on
    // success, 400 malformed, 413 over the cap, 0 if the connection
    // died (comp_error.md #65).
    fn readChunkedBody(self: *connReader, bodyStart: int) -> (string, int, int) {
        pos := bodyStart
        body := Skink_mem_alloc(int64(1024))
        bodyCap := 1024
        bodyLen := 0
        for {
            // Chunk-size line ends at the next LF.
            lineEnd := indexOfByte(self.buf, pos, self.len, 10)
            for lineEnd < 0 {
                n := self.fill()
                if n == -2 { return body, 0, 413 }
                if n <= 0 { return body, 0, 0 }
                lineEnd = indexOfByte(self.buf, pos, self.len, 10)
            }
            size := parseChunkSize(self.buf, pos, lineEnd)
            if size < 0 {
                return body, 0, 400
            }
            pos = lineEnd + 1
            if size == 0 {
                // Consume any trailer headers up to the final blank line.
                for {
                    le := indexOfByte(self.buf, pos, self.len, 10)
                    for le < 0 {
                        n := self.fill()
                        if n == -2 { return body, 0, 413 }
                        if n <= 0 { return body, 0, 0 }
                        le = indexOfByte(self.buf, pos, self.len, 10)
                    }
                    if le == pos || (le == pos + 1 && self.buf[pos] == 13) {
                        self.head = le + 1
                        return body, bodyLen, 200
                    }
                    pos = le + 1
                }
            }
            if int64(bodyLen) + int64(size) > int64(self.max) {
                return body, 0, 413
            }
            // Wait for the chunk data plus its trailing line ending.
            for self.len - pos < size + 1 {
                n := self.fill()
                if n == -2 { return body, 0, 413 }
                if n <= 0 { return body, 0, 0 }
            }
            // Reserve one extra byte for the caller's NUL terminator:
            // bodyLen + size == bodyCap previously left no room, so
            // body[blen]=0 wrote one byte past the allocation (VULN-14).
            if bodyLen + size + 1 > bodyCap {
                for bodyLen + size + 1 > bodyCap {
                    bodyCap = bodyCap * 2
                }
                body = Skink_mem_realloc(body, int64(bodyCap))
            }
            libc.memcpy(string(int64(body) + int64(bodyLen)), string(int64(self.buf) + int64(pos)), size)
            bodyLen = bodyLen + size
            pos = pos + size
            // Skip the chunk terminator: "\r\n" or a bare "\n".
            if self.buf[pos] == 13 {
                pos = pos + 1
                for self.len - pos < 1 {
                    n := self.fill()
                    if n <= 0 { return body, 0, 0 }
                }
            }
            if self.buf[pos] == 10 {
                pos = pos + 1
            }
        }
        return body, 0, 400
    }
}

// indexOfHeaderEnd scans buf[start..to) for the first "\r\n\r\n" or
// "\n\n" delimiter and returns the index just past it, or -1 if the
// header block is not yet complete.
fn indexOfHeaderEnd(buf: string, start: int, to: int) -> int {
    i := start
    for i + 1 < to {
        if buf[i] == 10 && buf[i + 1] == 10 {
            return i + 2
        }
        if i + 3 < to && buf[i] == 13 && buf[i + 1] == 10 && buf[i + 2] == 13 && buf[i + 3] == 10 {
            return i + 4
        }
        i = i + 1
    }
    return -1
}

// indexOfByte returns the index of the first occurrence of byte c in
// buf[start..to), or -1.
fn indexOfByte(buf: string, start: int, to: int, c: int) -> int {
    for i := start; i < to; i = i + 1 {
        if buf[i] == c {
            return i
        }
    }
    return -1
}

// hexVal converts an ASCII hex digit to its value, or -1 if invalid.
fn hexVal(c: int) -> int {
    if c >= 48 && c <= 57 { return c - 48 }
    if c >= 65 && c <= 70 { return c - 55 }
    if c >= 97 && c <= 102 { return c - 87 }
    return -1
}

// parseContentLength parses a Content-Length header value: ASCII digits
// only (no sign, no whitespace), accumulated in int64 so values beyond
// 2 GiB are rejected instead of wrapping (VULN-14). Returns (value, ok).
fn parseContentLength(s: string) -> (int64, bool) {
    n := int(libc.strlen(s))
    // 18 digits max: at most 999999999999999999, comfortably inside
    // int64, so accumulation cannot overflow before a bound check.
    if n == 0 || n > 18 {
        return int64(0), false
    }
    result := int64(0)
    for i := 0; i < n; i = i + 1 {
        c := int(s[i])
        if c < 48 || c > 57 {
            return int64(0), false
        }
        result = result * 10 + int64(c - 48)
    }
    return result, true
}

// hasChunkedToken reports whether the Transfer-Encoding header value
// contains "chunked" as a whole comma-separated list element (allowing
// surrounding whitespace), preventing substring bypasses like
// "xchunkedx" (VULN-14). s must already be lowercased.
fn hasChunkedToken(s: string) -> bool {
    n := int(libc.strlen(s))
    tokLen := 0
    i := 0
    for i <= n {
        c := 44 // ','
        if i < n {
            c = int(s[i])
        }
        if c == 44 || i == n {
            // Examine the just-ended token s[i-tokLen..i), trimming
            // spaces and tabs.
            t0 := i - tokLen
            t1 := i
            for t0 < t1 && (s[t0] == 32 || s[t0] == 9) {
                t0 = t0 + 1
            }
            for t1 > t0 && (s[t1 - 1] == 32 || s[t1 - 1] == 9) {
                t1 = t1 - 1
            }
            if t1 - t0 == 7 {
                eq := true
                exp := "chunked"
                for j := 0; j < 7; j = j + 1 {
                    if s[t0 + j] != exp[j] {
                        eq = false
                        break
                    }
                }
                if eq {
                    return true
                }
            }
            tokLen = 0
        } else {
            tokLen = tokLen + 1
        }
        i = i + 1
    }
    return false
}

// parseChunkSize parses a hexadecimal chunk-size line buf[start..end),
// ignoring an optional ";ext" chunk extension and a trailing CR.
// Returns -1 on malformed input.
fn parseChunkSize(buf: string, start: int, end: int) -> int {
    v := 0
    seen := false
    for i := start; i < end; i = i + 1 {
        c := buf[i]
        if c == 59 {
            break // ';' begins the chunk extension
        }
        if c == 13 || c == 32 {
            continue
        }
        d := hexVal(c)
        if d < 0 {
            return -1
        }
        v = v * 16 + d
        seen = true
        // Reject absurd chunk sizes before they can overflow the int.
        if v > 1073741824 {
            return -1
        }
    }
    if !seen {
        return -1
    }
    return v
}

// wantsKeepAlive reports whether the connection should stay open for
// another request: HTTP/1.1 defaults to keep-alive unless
// "Connection: close", while HTTP/1.0 defaults to close unless
// "Connection: keep-alive" (comp_error.md #64).
fn wantsKeepAlive(req: types.Request) -> bool {
    connHdr := str.ToLower(req.Header("Connection"))
    if req.Proto() == "HTTP/1.0" {
        return str.Contains(connHdr, "keep-alive")
    }
    return !str.Contains(connHdr, "close")
}

// sendErrorConn writes a bare error response on a raw socket — used by
// the panic-recovery defer in handleConn, where the connReader may be in
// an unknown state (comp_error.md #46).
fn sendErrorConn(conn: net.Connection, code: int) {
    body := statusText(code)
    resp := "HTTP/1.1 " + fmt.Itoa(code) + " " + body + "\r\n"
    resp = str.Concat(resp, "Content-Length: " + fmt.Itoa(str.Len(body)) + "\r\n")
    resp = str.Concat(resp, "Connection: close\r\n\r\n")
    resp = str.Concat(resp, body)
    conn.SendAll(resp, str.Len(resp))
}

// sendErrorTLS is the TLS counterpart of sendErrorConn.
fn sendErrorTLS(ssl: int64, code: int) {
    body := statusText(code)
    resp := "HTTP/1.1 " + fmt.Itoa(code) + " " + body + "\r\n"
    resp = str.Concat(resp, "Content-Length: " + fmt.Itoa(str.Len(body)) + "\r\n")
    resp = str.Concat(resp, "Connection: close\r\n\r\n")
    resp = str.Concat(resp, body)
    Skink_tls_write_all(ssl, resp, str.Len(resp))
}

// NewServer creates a Server on the given port backed by the provided
// router with a 1 MiB request cap and 30 second I/O timeouts.
pub fn NewServer(port: int, r: *router.Router) -> Server {
    return Server{port: port, handler: r, tls: nil, maxRequestBytes: 1048576, readTimeoutMs: 30000, writeTimeoutMs: 30000}
}

// Serve starts an HTTP server on the given address and routes requests
// through r. The address may be ":8080" or "8080" (host defaults to all
// interfaces). Convenience wrapper matching the book's server.Serve usage.
pub fn Serve(addr: string, r: router.Router) -> errors.Error {
    portStr := addr
    if str.StartsWith(addr, ":") {
        portStr = str.Substr(addr, 1, str.Len(addr) - 1)
    }
    port, ok := strconv.ParseInt(portStr)
    if !ok {
        return errors.New("server.Serve: invalid address " + addr)
    }
    s := NewServer(port, &r)
    return s.ListenAndServe()
}

// handleConnThread is the thread entry point for concurrent connection
// handling. It reconstructs a Connection from the fd and delegates to
// the Server's handleConn method, then releases the concurrency slot and
// marks the WaitGroup done so Shutdown can drain (comp_error.md #61, #63).
fn handleConnThread(server: *Server, fd: int) {
    conn := net.Connection{fd: fd}
    server.handleConn(conn)
    if server.trackConns != 0 {
        server.releaseConnSlot()
        server.wg.Done()
    }
}

// handleTLSConnThread is the thread entry point for concurrent TLS
// connection handling. It reconstructs a Connection from the fd and
// delegates to the Server's handleTLSConn method, then releases the
// concurrency slot and marks the WaitGroup done.
fn handleTLSConnThread(server: *Server, fd: int, ctx: int64) {
    conn := net.Connection{fd: fd}
    server.handleTLSConn(conn, ctx)
    if server.trackConns != 0 {
        server.releaseConnSlot()
        server.wg.Done()
    }
}

// parseRequestHead parses the NUL-terminated header block of an HTTP
// request (request line + headers, no body) into a Request. Header keys
// are stored lowercased so Header() lookups are case-insensitive
// (comp_error.md #54); the path is percent-decoded (#53).
fn parseRequestHead(headStr: string) -> types.Request {
    method := ""
    path := ""
    query := ""
    proto := "HTTP/1.0"
    headers := make(map[string]string)
    dupCL := false

    // Pick the line ending style: prefer CRLF, tolerate bare LF.
    sep := "\r\n"
    if !str.Contains(headStr, "\r\n") {
        sep = "\n"
    }
    firstLineEnd := str.IndexOf(headStr, sep)
    if firstLineEnd < 0 {
        // The block is a single line (request line, no headers).
        firstLineEnd = str.Len(headStr)
    }
    firstLine := str.Substr(headStr, 0, firstLineEnd)
    // Parse: METHOD PATH HTTP/1.x
    parts := str.Split(firstLine, " ")
    if len(parts) >= 2 {
        method = parts[0]
        fullPath := parts[1]
        // Split the path from the query string at "?".
        qIdx := str.IndexOf(fullPath, "?")
        if qIdx >= 0 {
            path = str.Substr(fullPath, 0, qIdx)
            query = str.Substr(fullPath, qIdx + 1, str.Len(fullPath) - qIdx - 1)
        } else {
            path = fullPath
        }
    }
    if len(parts) >= 3 {
        proto = parts[2]
    }
    // Percent-decode the path before routing; '+' stays literal in paths.
    path = types.URLDecode(path, false)

    // Parse headers; keys are lowercased for case-insensitive lookup.
    // A second Content-Length header marks the request ambiguous (a
    // front-end proxy and this server could disagree on the body
    // boundary — request smuggling, comp_error.md #155) — the header map
    // would otherwise silently keep only the last value.
    if firstLineEnd < str.Len(headStr) {
        headerBlock := str.Substr(headStr, firstLineEnd + str.Len(sep), str.Len(headStr) - firstLineEnd - str.Len(sep))
        headerLines := str.Split(headerBlock, sep)
        clSeen := false
        for i := 0; i < len(headerLines); i = i + 1 {
            line := headerLines[i]
            colon := str.IndexOf(line, ":")
            if colon >= 0 {
                key := str.ToLower(str.Substr(line, 0, colon))
                value := str.Trim(str.Substr(line, colon + 1, str.Len(line) - colon - 1))
                if str.Equal(key, "content-length") {
                    if clSeen {
                        dupCL = true
                    }
                    clSeen = true
                }
                headers[key] = value
            }
        }
    }

    return types.Request{method: method, path: path, query: query, proto: proto, headers: headers, params: make(map[string]string), body: "", bodyBuf: "", bodyLen: 0, dupCL: dupCL}
}

// statusText returns the standard HTTP reason phrase for a status code
// (comp_error.md #58).
fn statusText(code: int) -> string {
    if code == 100 { return "Continue" }
    if code == 101 { return "Switching Protocols" }
    if code == 200 { return "OK" }
    if code == 201 { return "Created" }
    if code == 202 { return "Accepted" }
    if code == 203 { return "Non-Authoritative Information" }
    if code == 204 { return "No Content" }
    if code == 205 { return "Reset Content" }
    if code == 206 { return "Partial Content" }
    if code == 300 { return "Multiple Choices" }
    if code == 301 { return "Moved Permanently" }
    if code == 302 { return "Found" }
    if code == 303 { return "See Other" }
    if code == 304 { return "Not Modified" }
    if code == 307 { return "Temporary Redirect" }
    if code == 308 { return "Permanent Redirect" }
    if code == 400 { return "Bad Request" }
    if code == 401 { return "Unauthorized" }
    if code == 402 { return "Payment Required" }
    if code == 403 { return "Forbidden" }
    if code == 404 { return "Not Found" }
    if code == 405 { return "Method Not Allowed" }
    if code == 406 { return "Not Acceptable" }
    if code == 407 { return "Proxy Authentication Required" }
    if code == 408 { return "Request Timeout" }
    if code == 409 { return "Conflict" }
    if code == 410 { return "Gone" }
    if code == 411 { return "Length Required" }
    if code == 412 { return "Precondition Failed" }
    if code == 413 { return "Payload Too Large" }
    if code == 414 { return "URI Too Long" }
    if code == 415 { return "Unsupported Media Type" }
    if code == 416 { return "Range Not Satisfiable" }
    if code == 417 { return "Expectation Failed" }
    if code == 418 { return "I'm a teapot" }
    if code == 422 { return "Unprocessable Entity" }
    if code == 425 { return "Too Early" }
    if code == 426 { return "Upgrade Required" }
    if code == 428 { return "Precondition Required" }
    if code == 429 { return "Too Many Requests" }
    if code == 431 { return "Request Header Fields Too Large" }
    if code == 451 { return "Unavailable For Legal Reasons" }
    if code == 500 { return "Internal Server Error" }
    if code == 501 { return "Not Implemented" }
    if code == 502 { return "Bad Gateway" }
    if code == 503 { return "Service Unavailable" }
    if code == 504 { return "Gateway Timeout" }
    if code == 505 { return "HTTP Version Not Supported" }
    if code == 507 { return "Insufficient Storage" }
    if code == 511 { return "Network Authentication Required" }
    return "Unknown"
}

// SerializeResponse builds an HTTP response string from a ResponseWriter
// with "Connection: close" framing. Exported for testing and for use by
// custom server implementations.
pub fn SerializeResponse(w: types.ResponseWriter) -> string {
    return str.Concat(serializeHeaders(w, false), w.ResponseBody())
}

// stripCRLF removes carriage-return and line-feed bytes from a header
// name or value so a handler cannot inject extra headers or split the
// response (comp_error.md #55). RC-managed so the stripped copy is
// reclaimed with the response temporaries (a raw malloc leaked once per
// header per response — comp_error.md #153).
fn stripCRLF(v: string) -> string {
    n := str.Len(v)
    out := Skink_mem_alloc(int64(n + 1))
    j := 0
    for i := 0; i < n; i = i + 1 {
        c := v[i]
        if c != 13 && c != 10 {
            Skink_mem_write_byte(out, int64(j), c)
            j = j + 1
        }
    }
    Skink_mem_write_byte(out, int64(j), 0)
    return out
}

// serializeHeaders builds the status line + headers (through the blank
// line) for a ResponseWriter. The body is sent separately so binary
// bodies are never routed through strlen-based concatenation
// (comp_error.md #51).
fn serializeHeaders(w: types.ResponseWriter, keepAlive: bool) -> string {
    // Build the status line: HTTP/1.1 <code> <reason>\r\n
    response := "HTTP/1.1 " + fmt.Itoa(w.status) + " " + statusText(w.status) + "\r\n"

    // Content-Length is required for keep-alive framing. It counts both
    // the text body and the buffered Write/WriteBytes bytes.
    bodyLen := str.Len(w.body) + w.bodyLen
    response = str.Concat(response, "Content-Length: " + fmt.Itoa(bodyLen) + "\r\n")
    if keepAlive {
        response = str.Concat(response, "Connection: keep-alive\r\n")
    } else {
        response = str.Concat(response, "Connection: close\r\n")
    }

    // Custom headers — emit all headers set by the handler (e.g.
    // Content-Type set by ResponseWriter.JSON() or ResponseWriter.HTML()),
    // with CR/LF stripped to prevent header injection (#55).
    // Note: map iteration order is not guaranteed in Skink.
    for key := range w.headers {
        value := w.headers[key]
        response = str.Concat(response, stripCRLF(key) + ": " + stripCRLF(value) + "\r\n")
    }

    // Blank line separates headers from body.
    response = str.Concat(response, "\r\n")
    return response
}
