module compress_roundtrip_test

import "testing"
import "std/compress"
import "std/str"

// TestCompressRoundTrip verifies compress then decompress returns original.
pub fn TestCompressRoundTrip() {
    src := "hello hello hello hello hello"
    packed, err := compress.Compress(src)
    testing.AssertTrue(err.message == "", "compress ok")
    testing.AssertTrue(str.Len(packed) > 0, "compressed non-empty")
    back, derr := compress.Decompress(packed)
    testing.AssertTrue(derr.message == "", "decompress ok")
    testing.AssertEqualString(src, back, "round trip")
}
