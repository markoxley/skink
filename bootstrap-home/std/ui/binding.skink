// ============================================================================
// Selection bindings — ComboBox/RadioGroup/ListBox <-> Observable(int)
// ============================================================================

// BoundCombo keeps a ComboBox selection in sync with an int observable.
pub struct BoundCombo {
    Cb:  *ui.ComboBox  // the bound combo box widget
    Obs: *Observable  // the bound observable

    // Draw renders the widget.
    pub fn Draw(self: *BoundCombo, h: int64) {
        if self.Cb.Selected() != self.Obs.GetInt() {
            self.Cb.Select(self.Obs.GetInt())
        }
        self.Cb.Draw(h)
        if self.Cb.Selected() != self.Obs.GetInt() {
            self.Obs.SetInt(self.Cb.Selected())
        }
    }

    // Height returns the widget's height in pixels.
    pub fn Height(self: *BoundCombo) -> int {
        return self.Cb.Height()
    }
}

// BindCombo wires a ComboBox selection index to an int observable.
pub fn BindCombo(cb: *ui.ComboBox, obs: *Observable) -> *BoundCombo {
    b := BoundCombo{Cb: cb, Obs: obs}
    cb.Select(obs.GetInt())
    return &b
}

// BoundRadio keeps a RadioGroup selection in sync with an int
// observable.
pub struct BoundRadio {
    Rg:  *ui.RadioGroup  // the bound radio group widget
    Obs: *Observable  // the bound observable

    // Draw renders the widget.
    pub fn Draw(self: *BoundRadio, h: int64) {
        if self.Rg.Selected() != self.Obs.GetInt() {
            self.Rg.Select(self.Obs.GetInt())
        }
        self.Rg.Draw(h)
        if self.Rg.Selected() != self.Obs.GetInt() {
            self.Obs.SetInt(self.Rg.Selected())
        }
    }

    // Height returns the widget's height in pixels.
    pub fn Height(self: *BoundRadio) -> int {
        return self.Rg.Height()
    }
}

// BindRadio wires a RadioGroup selection index to an int observable.
pub fn BindRadio(rg: *ui.RadioGroup, obs: *Observable) -> *BoundRadio {
    b := BoundRadio{Rg: rg, Obs: obs}
    rg.Select(obs.GetInt())
    return &b
}

// BoundList keeps a ListBox selection in sync with an int observable.
pub struct BoundList {
    Lb:  *ui.ListBox  // the bound list box widget
    Obs: *Observable  // the bound observable

    // Draw renders the widget.
    pub fn Draw(self: *BoundList, h: int64) {
        // Selection observable syncs the highlighted row; Items are
        // already re-read every frame, so mutating Lb.Items is how a
        // dynamic source updates the list.
        self.Lb.Draw(h)
        if self.Lb.Selected() != self.Obs.GetInt() {
            self.Obs.SetInt(self.Lb.Selected())
        }
    }

    // Height returns the widget's height in pixels.
    pub fn Height(self: *BoundList) -> int {
        return self.Lb.Height()
    }
}

// BindList wires a ListBox selection index to an int observable.
pub fn BindList(lb: *ui.ListBox, obs: *Observable) -> *BoundList {
    b := BoundList{Lb: lb, Obs: obs}
    return &b
}

// ============================================================================
// One-way bindings (display only)
// ============================================================================

// BoundLabel renders a computed string every frame — the cheapest way
// to surface live state ("counter", status text, formatted values).
pub struct BoundLabel {
    Src: fn() -> string  // the source

    // Draw renders the widget.
    pub fn Draw(self: *BoundLabel, h: int64) {
        Skink_ui_label(h, self.Src(), 0)
    }

    // Height returns the widget's height in pixels.
    pub fn Height(self: *BoundLabel) -> int {
        return 24
    }
}

// BindLabel makes a label that re-reads `src` every frame.
pub fn BindLabel(src: fn() -> string) -> *BoundLabel {
    l := BoundLabel{Src: src}
    return &l
}

// BoundProgress shows an int observable as a progress bar.
pub struct BoundProgress {
    Obs: *Observable  // the bound observable
    Max: int  // the maximum

    // Draw renders the widget.
    pub fn Draw(self: *BoundProgress, h: int64) {
        mx := self.Max
        if mx <= 0 {
            mx = 100
        }
        Skink_ui_progress(h, int64(self.Obs.GetInt()), int64(mx), 0)
    }

    // Height returns the widget's height in pixels.
    pub fn Height(self: *BoundProgress) -> int {
        return 22
    }
}

// BindProgress wires an int observable to a progress bar (one-way).
pub fn BindProgress(obs: *Observable, max: int) -> *BoundProgress {
    b := BoundProgress{Obs: obs, Max: max}
    return &b
}

// BoundColor keeps a ColorPicker in sync with an int64 RGBA observable.
pub struct BoundColor {
    Cp:  *ui.ColorPicker  // the bound color picker widget
    Obs: *Observable  // the bound observable

    // Draw renders the widget.
    pub fn Draw(self: *BoundColor, h: int64) {
        if self.Cp.RGBA != self.Obs.GetInt64() {
            self.Cp.RGBA = self.Obs.GetInt64()
        }
        self.Cp.Draw(h)
        if self.Cp.RGBA != self.Obs.GetInt64() {
            self.Obs.SetInt64(self.Cp.RGBA)
        }
    }

    // Height returns the widget's height in pixels.
    pub fn Height(self: *BoundColor) -> int {
        return self.Cp.Height()
    }
}

// BindColor wires a ColorPicker to an int64 (0xRRGGBBAA) observable.
pub fn BindColor(cp: *ui.ColorPicker, obs: *Observable) -> *BoundColor {
    b := BoundColor{Cp: cp, Obs: obs}
    cp.RGBA = obs.GetInt64()
    return &b
}

// ============================================================================
// RowModel adapters — expose data sources to ui.Table
// ============================================================================

// SliceModel backs a Table from a [][]string — the simplest source.
// Mutate `rows` any time; the table re-queries each frame.
pub struct SliceModel {
    Rows: [][]string  // the rows

    // RowCount returns the count.
    pub fn RowCount(self: *SliceModel) -> int {
        return len(self.Rows)
    }

    // CellText returns the text.
    pub fn CellText(self: *SliceModel, row: int, col: int) -> string {
        if row < 0 || row >= len(self.Rows) {
            return ""
        }
        r := self.Rows[row]
        if col < 0 || col >= len(r) {
            return ""
        }
        return r[col]
    }
}

// FromSlice adapts [][]string rows to a ui.RowModel for ui.NewTable.
pub fn FromSlice(rows: [][]string) -> *SliceModel {
    m := SliceModel{Rows: rows}
    return &m
}

// FuncModel backs a Table from callbacks — the "any source" adapter:
// wire db queries, file contents, computed views, remote data.
pub struct FuncModel {
    CountFn: fn() -> int  // the count function
    CellFn:  fn(int, int) -> string  // the cell function

    // RowCount returns the count.
    pub fn RowCount(self: *FuncModel) -> int {
        return self.CountFn()
    }

    // CellText returns the text.
    pub fn CellText(self: *FuncModel, row: int, col: int) -> string {
        return self.CellFn(row, col)
    }
}

// FromFunc adapts count/cell callbacks to a ui.RowModel.
pub fn FromFunc(count: fn() -> int, cell: fn(int, int) -> string) -> *FuncModel {
    m := FuncModel{CountFn: count, CellFn: cell}
    return &m
}

// ChanModel drains a chan<string> into rows — feed a table (or list)
// from producers without coupling them to the frame loop.
pub struct ChanModel {
    ch:   chan<string>  // the channel
    col:  int  // the column
    Rows: [][]string  // the rows

    // drain moves every pending channel message into Rows. Called by
    // RowCount each frame, so senders never block on the UI.
    // drain moves every queued channel value into Rows. len() is used as
    // the loop guard rather than a select/default probe because a closed
    // channel stays "ready" forever — select would loop infinitely.
    fn drain(self: *ChanModel) {
        for len(self.ch) > 0 {
            s := <-self.ch
            var row []string
            row = append(row, s)
            self.Rows = append(self.Rows, row)
        }
    }

    // RowCount returns the count.
    pub fn RowCount(self: *ChanModel) -> int {
        self.drain()
        return len(self.Rows)
    }

    // CellText returns the text.
    pub fn CellText(self: *ChanModel, row: int, col: int) -> string {
        if row < 0 || row >= len(self.Rows) {
            return ""
        }
        if col >= len(self.Rows[row]) {
            return ""
        }
        return self.Rows[row][col]
    }
}

// FromChan adapts a chan<string> to a ui.RowModel; each message becomes
// a one-column row appended to the table.
pub fn FromChan(ch: chan<string>) -> *ChanModel {
    m := ChanModel{ch: ch}
    return &m
}

// ============================================================================
// Convenience: bound column lists for dynamic item sets
// ============================================================================

// ItemsOf refreshes a ListBox's Items from a callback every frame —
// for sources that change identity as well as content.
pub struct ItemsOf {
    Src: fn() -> []string  // the item-source callback
    Lb:  *ui.ListBox  // the bound list box widget

    // Draw renders the widget.
    pub fn Draw(self: *ItemsOf, h: int64) {
        self.Lb.Items = self.Src()
        self.Lb.Draw(h)
    }

    // Height returns the widget's height in pixels.
    pub fn Height(self: *ItemsOf) -> int {
        return self.Lb.Height()
    }
}

// BindItems refreshes ListBox items from `src` every frame.
pub fn BindItems(lb: *ui.ListBox, src: fn() -> []string) -> *ItemsOf {
    i := ItemsOf{Src: src, Lb: lb}
    return &i
}

// ============================================================================
// Format helpers for BoundLabel
// ============================================================================

// IntText returns a fn producing an observable's int value as text.
pub fn IntText(obs: *Observable) -> fn() -> string {
    // NB: closing over obs keeps the pointer live; each call re-reads.
    return fn() -> string {
        return strconv.Itoa(obs.GetInt())
    }
}

// StrText returns a fn producing an observable's string value.
pub fn StrText(obs: *Observable) -> fn() -> string {
    return fn() -> string {
        return obs.Get()
    }
}
