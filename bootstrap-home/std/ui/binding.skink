// Project: Skink — A self-hosted, statically-typed programming language
//          targeting LLVM IR, designed for systems programming with
//          modern ergonomics and a Go-inspired syntax.
//
// File:    std/ui/binding.skink
// Purpose: Data binding for the ui toolkit. `Observable` is a mutable
//          cell with subscribers; `Bind*` adapters wrap ui controls so
//          widget state and application data stay in sync both ways.
//          `RowModel` adapters expose tables from slices, functions, or
//          channels — the table re-queries its model every frame, so
//          source changes show up without explicit refresh calls.
//
//          Two-way sync is poll-based: each Draw frame compares widget
//          state to the observable and writes whichever side changed.
//          No copy is needed for read-only views — implement
//          ui.RowModel directly for custom sources (db rows, files,
//          remote data).
//
// Author:  Mark Oxley
// Created: 2026

module binding

import "std/ui"
import "std/str"
import "std/strconv"

// Re-declared externs — C symbols are global, so bound widgets can draw
// straight to the frame handle without owning a *ui.Window.
extern fn Skink_ui_label(h: int64, s: string, align: int)
extern fn Skink_ui_progress(h: int64, cur: int64, max: int64, modifiable: int64) -> int64

// ============================================================================
// Observable — mutable cell + subscribers
// ============================================================================

// Kind tags for the value stored in an Observable.
pub const OBS_STRING = 0
pub const OBS_INT    = 1  // int observable kind
pub const OBS_FLOAT  = 2  // float observable kind
pub const OBS_BOOL   = 3  // bool observable kind

// Observable is a mutable value cell. `Set`/`SetInt`/`SetInt64`/
// `SetFloat`/`SetBool` write and invoke every subscriber — but only
// when the stored value actually changes (kind or content); a same-
// value set is a no-op. Bound widgets pick changes up on their next
// Draw frame (per-frame polling keeps widgets and data in sync without
// an event queue).
pub struct Observable {
    kind: int  // the value kind (OBS_*)
    s:    string  // the string value
    i:    int64  // the int value
    f:    float  // the float value
    b:    bool  // the bool value
    subs: []fn()  // the subscriber callbacks

    // Get reads the string value.
    pub fn Get(self: Observable) -> string {
        return self.s
    }

    // GetInt reads the int value.
    pub fn GetInt(self: Observable) -> int {
        return int(self.i)
    }

    // GetInt64 reads the int64 value.
    pub fn GetInt64(self: Observable) -> int64 {
        return self.i
    }

    // GetFloat reads the float value.
    pub fn GetFloat(self: Observable) -> float {
        return self.f
    }

    // GetBool reads the bool value.
    pub fn GetBool(self: Observable) -> bool {
        return self.b
    }

    // Kind reports the stored value's type tag (OBS_*).
    pub fn Kind(self: Observable) -> int {
        return self.kind
    }

    // Set writes a string and notifies subscribers. A set that would not
    // change the observable (same kind AND same value) is a no-op —
    // subscribers fire only on actual changes.
    pub fn Set(self: *Observable, v: string) {
        if self.kind == OBS_STRING && self.s == v {
            return
        }
        self.kind = OBS_STRING
        self.s = v
        self.Notify()
    }

    // SetInt writes an int and notifies subscribers on change only.
    pub fn SetInt(self: *Observable, v: int) {
        if self.kind == OBS_INT && self.i == int64(v) {
            return
        }
        self.kind = OBS_INT
        self.i = int64(v)
        self.Notify()
    }

    // SetInt64 writes an int64 and notifies subscribers on change only.
    pub fn SetInt64(self: *Observable, v: int64) {
        if self.kind == OBS_INT && self.i == v {
            return
        }
        self.kind = OBS_INT
        self.i = v
        self.Notify()
    }

    // SetFloat writes a float and notifies subscribers on change only.
    pub fn SetFloat(self: *Observable, v: float) {
        if self.kind == OBS_FLOAT && self.f == v {
            return
        }
        self.kind = OBS_FLOAT
        self.f = v
        self.Notify()
    }

    // SetBool writes a bool and notifies subscribers on change only.
    pub fn SetBool(self: *Observable, v: bool) {
        if self.kind == OBS_BOOL && self.b == v {
            return
        }
        self.kind = OBS_BOOL
        self.b = v
        self.Notify()
    }

    // Subscribe registers fn to run on every value change.
    pub fn Subscribe(self: *Observable, cb: fn()) {
        self.subs = append(self.subs, cb)
    }

    // Notify runs all subscribers (called by every Set).
    pub fn Notify(self: *Observable) {
        i := 0
        for i < len(self.subs) {
            self.subs[i]()
            i = i + 1
        }
    }
}

// NewObservable makes a string observable.
pub fn NewObservable(v: string) -> *Observable {
    o := Observable{kind: OBS_STRING, s: v}
    return &o
}

// NewObservableInt makes an int observable.
pub fn NewObservableInt(v: int) -> *Observable {
    o := Observable{kind: OBS_INT, i: int64(v)}
    return &o
}

// NewObservableFloat makes a float observable.
pub fn NewObservableFloat(v: float) -> *Observable {
    o := Observable{kind: OBS_FLOAT, f: v}
    return &o
}

// NewObservableBool makes a bool observable.
pub fn NewObservableBool(v: bool) -> *Observable {
    o := Observable{kind: OBS_BOOL, b: v}
    return &o
}

// ============================================================================
// BoundTextBox — TextBox <-> Observable(string), two-way
// ============================================================================

// BoundTextBox keeps a ui.TextBox and a string Observable in sync.
// While the box is being edited, user input wins (push); otherwise
// observable writes update the box (pull).
pub struct BoundTextBox {
    Win:  *ui.Window  // the bound window
    Box:  *ui.TextBox  // the bound text box widget
    Obs:  *Observable  // the bound observable

    // Draw renders the widget.
    pub fn Draw(self: *BoundTextBox, h: int64) {
        cur := self.Box.Text(self.Win)
        obs := self.Obs.Get()
        // Pull: data changed elsewhere → refresh the editor unless the
        // user is actively typing in a text field right now.
        if cur != obs && !ui.AnyTextActive(self.Win) {
            self.Box.SetText(self.Win, obs)
            cur = obs
        }
        self.Box.Draw(h)
        // Push: editor differs → write back.
        after := self.Box.Text(self.Win)
        if after != obs {
            self.Obs.Set(after)
        }
    }

    // Height returns the widget's height in pixels.
    pub fn Height(self: *BoundTextBox) -> int {
        return self.Box.Height()
    }
}

// BindTextBox wires a TextBox to a string observable.
pub fn BindTextBox(win: *ui.Window, box: *ui.TextBox, obs: *Observable) -> *BoundTextBox {
    b := BoundTextBox{Win: win, Box: box, Obs: obs}
    box.SetText(win, obs.Get())
    return &b
}

// ============================================================================
// BoundCheck — CheckBoxC <-> Observable(bool)
// ============================================================================

// BoundCheck keeps a checkbox and a bool observable in sync both ways.
pub struct BoundCheck {
    Cb:  *ui.CheckBoxC  // the bound checkbox widget
    Obs: *Observable  // the bound observable

    // Draw renders the widget.
    pub fn Draw(self: *BoundCheck, h: int64) {
        if self.Cb.Checked != self.Obs.GetBool() {
            self.Cb.Checked = self.Obs.GetBool()
        }
        self.Cb.Draw(h)
        if self.Cb.Checked != self.Obs.GetBool() {
            self.Obs.SetBool(self.Cb.Checked)
        }
    }

    // Height returns the widget's height in pixels.
    pub fn Height(self: *BoundCheck) -> int {
        return self.Cb.Height()
    }
}

// BindCheck wires a checkbox to a bool observable.
pub fn BindCheck(cb: *ui.CheckBoxC, obs: *Observable) -> *BoundCheck {
    b := BoundCheck{Cb: cb, Obs: obs}
    cb.Checked = obs.GetBool()
    return &b
}

// ============================================================================
// BoundSliderInt / BoundSliderFloat — sliders <-> numeric observables
// ============================================================================

// BoundSliderInt keeps an int slider in sync with an int observable.
pub struct BoundSliderInt {
    S:   *ui.SliderInt  // the bound slider widget
    Obs: *Observable  // the bound observable

    // Draw renders the widget.
    pub fn Draw(self: *BoundSliderInt, h: int64) {
        if self.S.Value != self.Obs.GetInt() {
            self.S.Value = self.Obs.GetInt()
        }
        self.S.Draw(h)
        if self.S.Value != self.Obs.GetInt() {
            self.Obs.SetInt(self.S.Value)
        }
    }

    // Height returns the widget's height in pixels.
    pub fn Height(self: *BoundSliderInt) -> int {
        return self.S.Height()
    }
}

// BindSliderInt wires a slider to an int observable.
pub fn BindSliderInt(s: *ui.SliderInt, obs: *Observable) -> *BoundSliderInt {
    b := BoundSliderInt{S: s, Obs: obs}
    s.Value = obs.GetInt()
    return &b
}

// BoundSliderFloat keeps a float slider in sync with a float observable.
pub struct BoundSliderFloat {
    S:   *ui.SliderFloat  // the bound slider widget
    Obs: *Observable  // the bound observable

    // Draw renders the widget.
    pub fn Draw(self: *BoundSliderFloat, h: int64) {
        if self.S.Value != self.Obs.GetFloat() {
            self.S.Value = self.Obs.GetFloat()
        }
        self.S.Draw(h)
        if self.S.Value != self.Obs.GetFloat() {
            self.Obs.SetFloat(self.S.Value)
        }
    }

    // Height returns the widget's height in pixels.
    pub fn Height(self: *BoundSliderFloat) -> int {
        return self.S.Height()
    }
}

// BindSliderFloat wires a float slider to a float observable.
pub fn BindSliderFloat(s: *ui.SliderFloat, obs: *Observable) -> *BoundSliderFloat {
    b := BoundSliderFloat{S: s, Obs: obs}
    s.Value = obs.GetFloat()
    return &b
}

