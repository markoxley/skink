// Copyright 2026 Mark Oxley. All rights reserved.
//
// Project: Skink — A self-hosted, statically-typed programming language
//          targeting LLVM IR, designed for systems programming with
//          modern ergonomics and a Go-inspired syntax.
//
// File:    std/ui/ui.skink
// Purpose: Cross-platform GUI toolkit. Wraps the SDL2+Nuklear runtime
//          shim (std/runtime/ui_rt.c) with an idiomatic Skink API:
//          Window management, per-frame immediate-mode helpers, a
//          retained `Widget` template interface, and ready-made control
//          structs (Label, Button, TextBox, CheckBox, RadioGroup,
//          Slider, ProgressBar, PropertyInt, ComboBox, ListBox, Table,
//          Group, TreeNode, MenuBar, TabStrip, ColorPicker).
//
//          Two usage styles mix freely inside the frame loop:
//            a) immediate — call ui.Row/ui.Button between BeginFrame and
//               EndFrame.
//            b) retained — create controls, win.Add(&w), call win.Draw()
//               (or ui.Run(win)) each frame.
//
//          Requires SDL2 development files (sdl2-devel / libsdl2-dev).
//          ui_rt.c and -lSDL2 are linked only when this module is
//          imported, so headless programs carry no GUI dependency.
//
// Author:  Mark Oxley
// Created: 2026

module ui

