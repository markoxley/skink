module fs_proc_test

import "testing"
import "std/os"
import "std/str"

// TestExecWithOutputBadProgram verifies bad program reports non-zero status.
pub fn TestExecWithOutputBadProgram() {
    out, status := os.ExecWithOutput([]string{"/nonexistent-program-xyz"})
    // execvp fails -> child exits 127; output empty
    testing.AssertTrue(status != 0, "bad program must report non-zero status")
    _ = out
}

// TestExecWithOutputOk verifies exec with valid program returns output.
pub fn TestExecWithOutputOk() {
    out, status := os.ExecWithOutput([]string{"/bin/echo", "hi"})
    testing.AssertEqualInt(0, status, "echo status")
    testing.AssertTrue(str.Len(out) > 0, "echo output non-empty")
}
