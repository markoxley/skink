module str_test

import "std/str"
import "testing"

// TestLen verifies the string length function for empty and non-empty strings.
pub fn TestLen() {
    if str.Len("") != 0 {
        Errorf("Len empty string failed")
    }
    if str.Len("hello") != 5 {
        Errorf("Len hello failed")
    }
    if str.Len("abc") != 3 {
        Errorf("Len abc failed")
    }
}

// TestEqual checks equality comparison for same, different, and empty strings.
pub fn TestEqual() {
    if str.Equal("a", "a") == false {
        Errorf("Equal same strings failed")
    }
    if str.Equal("a", "b") == true {
        Errorf("Equal different strings failed")
    }
    if str.Equal("", "") == false {
        Errorf("Equal empty strings failed")
    }
}

// TestCompare verifies lexicographic ordering of strings.
pub fn TestCompare() {
    if str.Compare("a", "b") >= 0 {
        Errorf("Compare a < b failed")
    }
    if str.Compare("b", "a") <= 0 {
        Errorf("Compare b > a failed")
    }
    if str.Compare("a", "a") != 0 {
        Errorf("Compare equal failed")
    }
}

// TestStartsWith checks prefix detection.
pub fn TestStartsWith() {
    if str.StartsWith("hello", "he") == false {
        Errorf("StartsWith he failed")
    }
    if str.StartsWith("hello", "lo") == true {
        Errorf("StartsWith lo should be false")
    }
}

// TestEndsWith checks suffix detection.
pub fn TestEndsWith() {
    if str.EndsWith("hello", "lo") == false {
        Errorf("EndsWith lo failed")
    }
    if str.EndsWith("hello", "he") == true {
        Errorf("EndsWith he should be false")
    }
}

// TestTrim verifies whitespace removal from both ends.
pub fn TestTrim() {
    trimmed := str.Trim("  hello  ")
    if str.Equal(trimmed, "hello") == false {
        Errorf("Trim failed")
    }
}

// TestRepeat checks string repetition.
pub fn TestRepeat() {
    repeated := str.Repeat("ab", 3)
    if str.Equal(repeated, "ababab") == false {
        Errorf("Repeat failed")
    }
}

// TestConcat verifies string concatenation.
pub fn TestConcat() {
    result := str.Concat("hello", " world")
    if str.Equal(result, "hello world") == false {
        Errorf("Concat failed")
    }
}

// TestSubstr checks substring extraction.
pub fn TestSubstr() {
    result := str.Substr("hello", 1, 3)
    if str.Equal(result, "ell") == false {
        Errorf("Substr failed")
    }
}


// --- VULN-11 / VULN-25 security regressions ---

var stPanicMsg: string

// stSavePanic captures the panic message recovered inside stInvoke.
fn stSavePanic(s: string) { stPanicMsg = s }

// stInvoke runs f inside a recoverable frame.
fn stInvoke(f: fn()) {
    defer fn() { stSavePanic(recover()) }()
    f()
}

// stExpectPanic asserts that f panics (VULN-11 converts silent
// size-overflow corruption into panics).
fn stExpectPanic(f: fn(), what: string) {
    stPanicMsg = ""
    stInvoke(f)
    if str.Len(stPanicMsg) == 0 {
        Errorf("expected panic: " + what)
    }
}

fn stRepeatOverflow() {
    // 2 * 2e9 bytes exceeds INT_MAX — used to wrap the size computation
    // and memcpy past a tiny allocation (VULN-11).
    _ = str.Repeat("ab", 2000000000)
}

fn stRepeatBoundary() {
    // n*count == INT_MAX leaves no room for the NUL terminator.
    _ = str.Repeat("x", 2147483647)
}

// TestRepeatSizeSafety guards VULN-11: pathological repeat sizes panic
// instead of overflowing the backing allocation; negative and ordinary
// counts keep working.
pub fn TestRepeatSizeSafety() {
    stExpectPanic(stRepeatOverflow, "str.Repeat with overflowing size")
    stExpectPanic(stRepeatBoundary, "str.Repeat at INT_MAX boundary")
    if str.Len(str.Repeat("x", -1)) != 0 {
        Errorf("str.Repeat with negative count should return empty")
    }
    if str.Len(str.Repeat("ab", 3)) != 6 {
        Errorf("str.Repeat normal case broken")
    }
}

// TestContainsIndexSafety guards VULN-25: Contains/IndexOf must compare
// 64-bit pointer differences — the old int() truncation returned wrong
// results for hits past 4 GiB. The pointer math is asserted here via
// functional correctness (a >4 GiB haystack is impractical in a test).
pub fn TestContainsIndexSafety() {
    if !str.Contains("hello world", "world") {
        Errorf("Contains should find 'world'")
    }
    if str.Contains("hello", "zz") {
        Errorf("Contains should not find 'zz'")
    }
    if str.IndexOf("abcabc", "c") != 2 {
        Errorf("IndexOf should return first hit")
    }
    if str.IndexOf("abc", "z") != -1 {
        Errorf("IndexOf miss should be -1")
    }
    if !str.Contains("", "") {
        Errorf("Contains of empty needle should be true")
    }
}
