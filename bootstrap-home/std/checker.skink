}

// strBoolTable is a string→bool hash table.
struct strBoolTable {
    idx:  stridx.StrIndex  // the index
    vals: []bool  // the values

    fn Get(self: *strBoolTable, key: string) -> bool {
        i := self.idx.Find(key)
        if i < 0 {
            return false
        }
        return self.vals[i]
    }

    fn Set(self: *strBoolTable, key: string, v: bool) {
        i := self.idx.Ensure(key)
        if i >= len(self.vals) {
            // See bindingTable.Set: grow geometrically — append() is O(N)
            // realloc-per-element and makes this O(N^2).
            newLen := len(self.vals) * 2
            if newLen < i + 1 {
                newLen = i + 1
            }
            nv := make([]bool, newLen)
            for j := 0; j < len(self.vals); j = j + 1 {
                nv[j] = self.vals[j]
            }
            self.vals = nv
        }
        self.vals[i] = v
    }

    fn Has(self: *strBoolTable, key: string) -> bool {
        return self.idx.Find(key) >= 0
    }
}

// === Scope Binding ===

// Binding holds a variable's type and usage metadata in a scope.
struct Binding {
    typ:     TType  // the typ
    used:    bool  // the used
    isParam: bool  // whether param
    isBlank: bool  // whether blank
}

// Scope is a lexical scope with ordered names for iteration.
struct Scope {
    bindings: bindingTable  // the bindings
    names:    []string  // the names
}

// scopeMake creates an empty Scope.
fn scopeMake() -> Scope {
    s := Scope{}
    s.names = []string{}
    return s
}

// scopeSet adds or updates a binding in the scope.
// Optimization: check existence via the bindings table instead of linear-scanning
// the names slice. The hash lookup is O(1) (comp_error.md #22) and replaces
// a separate O(N) scan of names.
fn scopeSet(s: *Scope, name: string, b: Binding) {
    if s == nil {
        return
    }
    if !s.bindings.Has(name) {
        // New binding — add to the names list for ordered iteration.
        s.names = append(s.names, name)
    }
    s.bindings.Set(name, b)
}

// SymbolInfo records a resolved symbol's type, mutability, kind, and declaring module.
pub struct SymbolInfo {
    moduleName: string  // the module name
    isPub:  bool  // whether pub
}

// === Checker ===

// Checker carries the type checker's state while validating a resolved program.
pub struct Checker {
    errors:        []string  // the errors
    scopes:        []Scope  // the scopes
    scopeDepth:    int  // the scope depth
    loopDepth:     int  // the loop depth
    breakDepth:    int  // the break depth
    currentFn:     []TType  // the current function
    currentFnRetNames: []string  // the current function return value names
    structs:       declTable  // the structs
    fnDecls:       declTable  // the function decls
    services:      ttypeTable  // the services
    rulesets:      ttypeTable  // the rulesets
    templates:     declTable  // the templates
    templateNamesList: []string  // the template names list
    aliases:       ttypeTable  // the aliases
    taggedUnions:  declTable  // the tagged unions
    symbolInfo:    symInfoTable  // the symbol info
    currentModule: string  // the current module
    imports:       strSliceTable  // the imports
    importModules: []string  // the import modules
    importAliases: strStrTable  // the import aliases
    usedImports:   strBoolTable  // the used imports
    currentFile:   string  // the current file
    currentLine:   int  // the current line
    currentCol:    int  // the current column
    // chanElemTypes maps "line:col" of <-ch expressions to the channel's
    // element type, for use by the emitter.
    chanElemTypes: ttypeTable
    // matchResultTypes maps "line:col" of match expressions to their
    // result type, for use by the emitter (arm bodies reference
    // pattern-bound variables that aren't in scope when the emitter
    // pre-computes the result type).
    matchResultTypes: ttypeTable
    // awaitElemTypes maps "line:col" of await expressions to the future's
    // element type, for use by the emitter to unbox the awaited value.
    awaitElemTypes: ttypeTable
    // exprTypes maps "file line:col" of each checked expression to its
    // resolved type, for emitter-side lookups (channel element types,
    // integer signedness) that can't be re-derived at emit time. The
    // file is included because line:col collides across modules.
    exprTypes: ttypeTable
    // suppressExprTypes disables exprTypes recording — set while the
    // emitter re-checks expressions via resolveFieldType, where the
    // checker's stale file/scope state would otherwise misfile entries.
    suppressExprTypes: bool
    // typeCache caches resolved types by qualified name to avoid
    // repeated scope-chain walks for the same global symbol.
    typeCache: ttypeTable
    // constExprs maps each (qualified) constant's name to its initializer
    // expression so that untyped integer constants can be range-checked
    // when they flow into narrow integer targets (comp_error.md #28).
    constExprs: exprTable
}

// newChecker creates a Checker with a global scope pre-populated with builtins.
pub fn newChecker() -> Checker {
    c := Checker{}
    c.errors = []string{}
    c.scopes = make([]Scope, 0)
    c.scopeDepth = 0
    c.importModules = []string{}

    global := scopeMake()
    scopeSet(&global, "print", Binding{typ: makeVariadicFn([]TType{anyType()}, []TType{voidType()}), isBlank: true})
    scopeSet(&global, "println", Binding{typ: makeVariadicFn([]TType{anyType()}, []TType{voidType()}), isBlank: true})
    scopeSet(&global, "len", Binding{typ: functionType([]TType{anyType()}, []TType{builtinType("int")}), isBlank: true})
    scopeSet(&global, "assert", Binding{typ: functionType([]TType{builtinType("bool")}, []TType{voidType()}), isBlank: true})
    scopeSet(&global, "append", Binding{typ: functionType([]TType{anyType(), anyType()}, []TType{anyType()}), isBlank: true})
    scopeSet(&global, "close", Binding{typ: functionType([]TType{anyType()}, []TType{voidType()}), isBlank: true})
    scopeSet(&global, "delete", Binding{typ: functionType([]TType{anyType(), anyType()}, []TType{voidType()}), isBlank: true})
    scopeSet(&global, "copy", Binding{typ: functionType([]TType{anyType()}, []TType{anyType()}), isBlank: true})
    scopeSet(&global, "panic", Binding{typ: functionType([]TType{builtinType("string")}, []TType{voidType()}), isBlank: true})
    scopeSet(&global, "recover", Binding{typ: functionType([]TType{}, []TType{builtinType("string")}), isBlank: true})
    scopeSet(&global, "sin", Binding{typ: functionType([]TType{builtinType("float")}, []TType{builtinType("float")}), isBlank: true})
    scopeSet(&global, "cos", Binding{typ: functionType([]TType{builtinType("float")}, []TType{builtinType("float")}), isBlank: true})
    scopeSet(&global, "tan", Binding{typ: functionType([]TType{builtinType("float")}, []TType{builtinType("float")}), isBlank: true})
    scopeSet(&global, "sqrt", Binding{typ: functionType([]TType{builtinType("float")}, []TType{builtinType("float")}), isBlank: true})
    scopeSet(&global, "pow", Binding{typ: functionType([]TType{builtinType("float"), builtinType("float")}, []TType{builtinType("float")}), isBlank: true})
    scopeSet(&global, "dot", Binding{typ: functionType([]TType{arrayType(builtinType("float")), arrayType(builtinType("float"))}, []TType{builtinType("float")}), isBlank: true})
    scopeSet(&global, "norm", Binding{typ: functionType([]TType{arrayType(builtinType("float"))}, []TType{builtinType("float")}), isBlank: true})

    c.scopes = append(c.scopes, global)
    return c
}

// makeVariadicFn builds a variadic function type from params and return types.
fn makeVariadicFn(params: []TType, retTypes: []TType) -> TType {
    t := functionType(params, retTypes)
    t.variadic = true
    return t
}

// setSymbolInfo sets the checker's symbol-info table.
pub fn setSymbolInfo(c: *Checker, info: symInfoTable) {
    c.symbolInfo = info
}

// NewSymbolInfo constructs a SymbolInfo with module name and visibility.
pub fn NewSymbolInfo(moduleName: string, isPub: bool) -> SymbolInfo {
    return SymbolInfo{moduleName: moduleName, isPub: isPub}
}

// registerConstVisibility records a constant's owning module and pub flag so
// that cross-module references to non-pub constants can be rejected.
fn registerConstVisibility(c: *Checker, name: string, isPub: bool) {
    moduleName := c.currentModule
    if str.Len(moduleName) == 0 {
        moduleName = "main"
    }
    c.symbolInfo.Set(name, NewSymbolInfo(moduleName, isPub))
}

// Errors returns the list of accumulated compilation errors.
pub fn Errors(c: *Checker) -> []string {
    return c.errors
}

// templateNames returns the list of registered template names.
pub fn templateNames(c: *Checker) -> []string {
    return c.templateNamesList
}

// importsFor returns the list of import aliases for a given module name.
pub fn importsFor(c: *Checker, moduleName: string) -> []string {
    imps := c.imports.Get(moduleName)
    return imps
}

// getTemplate returns the declaration for a template by name.
pub fn getTemplate(c: *Checker, name: string) -> ast.Decl {
    return c.templates.Get(name)
}

// hasTemplate returns true if a template with the given name is registered.
pub fn hasTemplate(c: *Checker, name: string) -> bool {
    return c.templates.Get(name).kind != 0
}

// report appends an error message with the current file:line:col prefix.
fn report(c: *Checker, msg: string) {
    if str.Len(c.currentFile) > 0 {
        prefix := str.Concat(str.Concat(c.currentFile, " "), str.Concat(str.Concat(itoa(c.currentLine), ":"), str.Concat(itoa(c.currentCol), ": ")))
        msg = str.Concat(prefix, msg)
    }
    c.errors = append(c.errors, msg)
}

// warn prints a non-fatal diagnostic to stderr; the compile continues.
fn warn(c: *Checker, msg: string) {
    full := msg
    if str.Len(c.currentFile) > 0 {
        full = str.Concat(str.Concat(c.currentFile, " "), str.Concat(str.Concat(itoa(c.currentLine), ":"), str.Concat(itoa(c.currentCol), ": warning: ")))
        full = str.Concat(full, msg)
    } else {
        full = str.Concat("warning: ", msg)
    }
    io.PrintErrorLine(full)
}

// reportAt appends an error message at a specific line and column.
fn reportAt(c: *Checker, line: int, col: int, msg: string) {
    full := str.Concat(str.Concat(str.Concat(str.Concat(itoa(line), ":"), itoa(col)), ": "), msg)
    if str.Len(c.currentFile) > 0 {
        full = str.Concat(str.Concat(c.currentFile, " "), full)
    }
    c.errors = append(c.errors, full)
}

// itoa converts an integer to its decimal string representation.
fn itoa(n: int) -> string {
    if n == 0 {
        return "0"
    }
    neg := false
    if n < 0 {
        neg = true
        n = -n
    }
    digits := ""
    for n > 0 {
        d := n % 10
        ch := str.Substr("0123456789", d, 1)
        digits = str.Concat(ch, digits)
        n = n / 10
    }
    if neg {
        digits = str.Concat("-", digits)
    }
    return digits
}

// === Scope Management ===

// pushScope creates a new lexical scope at the current depth.
fn pushScope(c: *Checker) {
    c.scopeDepth = c.scopeDepth + 1
    scope := scopeMake()
    if len(c.scopes) > c.scopeDepth {
        c.scopes[c.scopeDepth] = scope
    } else {
        c.scopes = append(c.scopes, scope)
    }
}

// popScope removes the current scope and warns about unused variables.
fn popScope(c: *Checker) {
    if c.scopeDepth <= 0 {
        return
    }
    current := &c.scopes[c.scopeDepth]
    for i := 0; i < len(current.names); i = i + 1 {
        name := current.names[i]
        b := current.bindings.Get(name)
        if !b.isBlank && !b.isParam && !b.used {
            warn(c, str.Concat("unused variable \"", str.Concat(name, "\"")))
        }
    }
    c.scopeDepth = c.scopeDepth - 1
}

// declare adds or updates a variable binding in the current scope.
fn declare(c: *Checker, name: string, typ: TType) {
    current := &c.scopes[c.scopeDepth]
    existing := current.bindings.Get(name)
    if existing.typ.kind != 0 && !str.Equal(name, "_") {
        // Allow a function to share a name with a struct type. The struct
        // is still accessible via c.structs for struct literals and type
        // annotations; the function binding in the scope is used for call
        // expressions. This enables methods like errors.Error() where the
        // method name matches the struct name.
        if existing.typ.kind == TK_NAMED && typ.kind == TK_FUNCTION {
            b := Binding{typ: typ}
            b.used = true
            scopeSet(current, name, b)
            return
        }
        report(c, str.Concat("variable \"", str.Concat(name, "\" already declared in this scope")))
        return
    }
    isLocal := c.scopeDepth > 0
    isBlank := str.Equal(name, "_")
    b := Binding{typ: typ}
    b.isBlank = isBlank
    b.used = !isLocal || isBlank
    scopeSet(current, name, b)
}

// declareParam adds a function parameter binding to the current scope.
fn declareParam(c: *Checker, name: string, typ: TType) {
    current := &c.scopes[c.scopeDepth]
    existing := current.bindings.Get(name)
    if existing.typ.kind != 0 && !str.Equal(name, "_") {
        report(c, str.Concat("parameter \"", str.Concat(name, "\" already declared in this scope")))
        return
    }
    b := Binding{typ: typ}
    b.isParam = true
    b.used = true
    scopeSet(current, name, b)
}

// resolveWithKey looks up a name in the scope chain, handling qualified names.
// Optimization: uses the binding already fetched from the map instead of
// calling scopeHasBinding (which would do a second map lookup for the same key).
// Also caches the result of qualified-name probing (the expensive part that
// tries module-qualified names) since the global scope doesn't change during
// type checking.
fn resolveWithKey(c: *Checker, name: string) -> TType {
    for i := c.scopeDepth; i >= 0; i = i - 1 {
        b := c.scopes[i].bindings.Get(name)
        if b.typ.kind != 0 {
            if i > 0 {
                b.used = true
                scopeSet(&c.scopes[i], name, b)
            }
            if i == 0 {
                // At global scope an unqualified name may collide with a
                // private declaration of the current module. Prefer the
                // current module's own qualified binding — foreign private
                // symbols must not shadow it (e.g. a user-defined `report`
                // must not hijack checker-internal calls to `report`).
                if str.IndexOf(name, ".") < 0 && str.Len(c.currentModule) > 0 &&
                   !str.Equal(c.currentModule, "main") {
                    qualified := str.Concat(str.Concat(c.currentModule, "."), name)
                    qb := c.scopes[0].bindings.Get(qualified)
                    if qb.typ.kind != 0 {
                        return qb.typ
                    }
                }
                info := c.symbolInfo.Get(name)
                if info.moduleName != "" {
                    if str.Len(info.moduleName) > 0 && !str.Equal(info.moduleName, c.currentModule) && !info.isPub {
                        report(c, str.Concat("cannot access private symbol \"", str.Concat(name, str.Concat("\" from module \"", str.Concat(info.moduleName, "\"")))))
                    }
                }
            }
            return b.typ
        }
    }
    // Check the type cache before doing qualified-name probing.
    // The cache is safe because the global scope, current module, and imports
    // don't change during the type-checking pass. The cache key includes the
    // current module since qualified-name probing depends on it.
    cacheKey := str.Concat(c.currentModule, str.Concat(":", name))
    cached := c.typeCache.Get(cacheKey)
    if cached.kind != 0 {
        return cached
    }
    if str.Len(c.currentModule) > 0 && !str.Equal(c.currentModule, "main") {
        qualified := str.Concat(str.Concat(c.currentModule, "."), name)
        b := c.scopes[0].bindings.Get(qualified)
        if b.typ.kind != 0 {
            c.typeCache.Set(cacheKey, b.typ)
            return b.typ
        }
    }
    if str.Len(c.currentModule) > 0 {
        cm := c.currentModule
        imps := c.imports.Get(cm)
        if len(imps) > 0 {
            j := 0
            for j < len(imps) {
                impName := imps[j]
                qualified := str.Concat(str.Concat(impName, "."), name)
                b := c.scopes[0].bindings.Get(qualified)
                if b.typ.kind != 0 {
                    info := c.symbolInfo.Get(qualified)
                    if info.moduleName != "" {
                        if str.Len(info.moduleName) > 0 && !str.Equal(info.moduleName, c.currentModule) && !info.isPub {
                            report(c, str.Concat("cannot access private symbol \"", str.Concat(qualified, str.Concat("\" from module \"", str.Concat(info.moduleName, "\"")))))
                        }
                    }
                    markImportUsed(c, impName)
                    c.typeCache.Set(cacheKey, b.typ)
                    return b.typ
                }
                j = j + 1
            }
        }
    }
    return TType{kind: TK_UNKNOWN}
}

// resolve looks up a name, falling back to its unqualified part if needed.
fn resolve(c: *Checker, name: string) -> TType {
    typ := resolveWithKey(c, name)
    if typ.kind == TK_UNKNOWN && str.Contains(name, ".") {
        idx := lastIndexOf(name, ".")
        if idx >= 0 {
            short := str.Substr(name, idx + 1, str.Len(name) - idx - 1)
            typ = resolveWithKey(c, short)
        }
    }
    return typ
}

// markVarUsed marks a variable binding as used in its scope.
// Optimization: uses the binding already fetched from the map.
fn markVarUsed(c: *Checker, name: string) {
    for i := c.scopeDepth; i >= 0; i = i - 1 {
        b := c.scopes[i].bindings.Get(name)
        if b.typ.kind != 0 {
            b.used = true
            scopeSet(&c.scopes[i], name, b)
            return
        }
    }
}

// markImportUsed marks an import alias as referenced.
fn markImportUsed(c: *Checker, alias: string) {
    c.usedImports.Set(alias, true)
    c.usedImports.Set(str.Concat(alias, "."), true)
}

// resolveImportAlias maps an import alias to its real module name.
fn resolveImportAlias(c: *Checker, name: string) -> string {
    real := c.importAliases.Get(name)
    if real != "" {
        return real
    }
    return name
}

// markInterpolatedVars marks variables referenced in a string interpolation as used.
fn markInterpolatedVars(c: *Checker, s: string) {
    i := 0
    for i < str.Len(s) {
        ch := str.Substr(s, i, 1)
        if str.Equal(ch, "{") {
            j := i + 1
            for j < str.Len(s) && !str.Equal(str.Substr(s, j, 1), "}") {
                j = j + 1
            }
            if j < str.Len(s) {
                id := str.Substr(s, i + 1, j - i - 1)
                dotIdx := str.IndexOf(id, ".")
                if dotIdx >= 0 {
                    id = str.Substr(id, 0, dotIdx)
                }
                if str.Len(id) > 0 && !str.Equal(id, "_") {
                    markVarUsed(c, id)
                }
                i = j + 1
                continue
            }
        }
        i = i + 1
    }
}

// === String Helpers ===

// splitOnFirstDot splits a string at the first dot into two parts.
fn splitOnFirstDot(s: string) -> []string {
    idx := str.IndexOf(s, ".")
    if idx < 0 {
        return []string{s, ""}
    }
    return []string{str.Substr(s, 0, idx), str.Substr(s, idx + 1, str.Len(s) - idx - 1)}
}

// splitOnLastDot splits a string at the last dot into two parts.
fn splitOnLastDot(s: string) -> []string {
    idx := lastIndexOf(s, ".")
    if idx < 0 {
        return []string{"", s}
    }
    return []string{str.Substr(s, 0, idx), str.Substr(s, idx + 1, str.Len(s) - idx - 1)}
}

// === AST Type to TType ===

// astTypeToType converts an AST type node to a TType.
pub fn astTypeToType(c: *Checker, t: ast.Type) -> TType {
    if t.kind == 0 && str.Len(t.name) == 0 && len(t.elem) == 0 && len(t.paramTypes) == 0 && len(t.tupleTypes) == 0 {
        return voidType()
    }
    if t.kind == ast.TY_NAMED {
        result := astNamedToType(c, t)
        // Preserve generic type arguments for generic struct instantiations
        if len(t.genericArgs) > 0 && result.kind == TK_NAMED {
            var gargs []TType
            for i := 0; i < len(t.genericArgs); i = i + 1 {
                gargs = append(gargs, astTypeToType(c, t.genericArgs[i]))
            }
            result.genericArgs = gargs
        }
        return result
    }
    if t.kind == ast.TY_POINTER { return pointerType(astTypeToType(c, ast.typeOpt(t.elem))) }
    if t.kind == ast.TY_ARRAY { return arrayType(astTypeToType(c, ast.typeOpt(t.elem))) }
    if t.kind == ast.TY_SET { return setType(astTypeToType(c, ast.typeOpt(t.elem))) }
    if t.kind == ast.TY_MAP { return mapType(astTypeToType(c, ast.typeOpt(t.keyType)), astTypeToType(c, ast.typeOpt(t.elem))) }
    if t.kind == ast.TY_CHAN { return chanType(astTypeToType(c, ast.typeOpt(t.elem))) }
    if t.kind == ast.TY_TENSOR { return tensorType(astTypeToType(c, ast.typeOpt(t.elem))) }
    if t.kind == ast.TY_FUNC { return astFuncTypeToType(c, t) }
    if t.kind == ast.TY_TUPLE { return astTupleTypeToType(c, t) }
    return unknownType()
}

// astNamedToType resolves a named AST type to a TType, checking aliases and templates.
fn astNamedToType(c: *Checker, t: ast.Type) -> TType {
    name := t.name
    if str.Contains(name, ".") {
        parts := splitOnFirstDot(name)
        resolved := resolveImportAlias(c, parts[0])
        if !str.Equal(resolved, parts[0]) {
            name = str.Concat(str.Concat(resolved, "."), parts[1])
        }
    }
    // Tagged unions take priority over generic named-type resolution — a
    // TU binding must keep its TK_TAGGED_UNION kind so match arms can bind
    // payload variables.
    {
        tuKey := name
        tuDecl := c.taggedUnions.Get(name)
        hasTU := tuDecl.kind != 0
        if !hasTU && str.Len(c.currentModule) > 0 && !str.Contains(name, ".") {
            qualified := str.Concat(str.Concat(c.currentModule, "."), name)
            qualifiedDecl := c.taggedUnions.Get(qualified)
            if qualifiedDecl.kind != 0 {
                hasTU = true
                tuKey = qualified
            }
        }
        if !hasTU && str.Contains(name, ".") {
            dot := str.LastIndexOf(name, ".")
            short := str.Substr(name, dot + 1, str.Len(name) - dot - 1)
            shortDecl := c.taggedUnions.Get(short)
            if shortDecl.kind != 0 {
                hasTU = true
                tuKey = short
            }
        }
        if hasTU {
            b := c.scopes[0].bindings.Get(tuKey)
            if b.typ.kind == TK_TAGGED_UNION {
                return b.typ
            }
        }
    }
    if str.Len(c.currentModule) > 0 && !str.Equal(c.currentModule, "main") && !str.Contains(name, ".") {
        qualified := str.Concat(str.Concat(c.currentModule, "."), name)
        b := c.scopes[0].bindings.Get(qualified)
        if b.typ.kind != 0 {
            return lookupType(qualified)
        }
    }
    if str.Len(c.currentModule) > 0 && !str.Contains(name, ".") {
        cm := c.currentModule
        imps := c.imports.Get(cm)
        if len(imps) > 0 {
            j := 0
            for j < len(imps) {
                impName := imps[j]
                qualified := str.Concat(str.Concat(impName, "."), name)
                b := c.scopes[0].bindings.Get(qualified)
                if b.typ.kind != 0 {
                    markImportUsed(c, impName)
                    return lookupType(qualified)
                }
                j = j + 1
            }
        }
    }
    if c.templates.Get(name).kind != 0 {
        // Mark import as used for qualified template names (e.g. "reader.Reader")
        if str.Contains(name, ".") {
            parts := splitOnFirstDot(name)
            markImportUsed(c, parts[0])
        }
        tt := TType{kind: TK_TEMPLATE}
        tt.name = name
        return tt
    }
    // Try module-qualified name for unqualified type references
    if str.Len(c.currentModule) > 0 && !str.Contains(name, ".") {
        qualified := str.Concat(str.Concat(c.currentModule, "."), name)
        if c.templates.Get(qualified).kind != 0 {
            tt := TType{kind: TK_TEMPLATE}
            tt.name = qualified
            return tt
        }
    }
    if str.Contains(name, ".") {
        parts := splitOnFirstDot(name)
        // Try the full qualified name first (templates are stored qualified)
        if c.templates.Get(name).kind != 0 {
            markImportUsed(c, parts[0])
            tt := TType{kind: TK_TEMPLATE}
            tt.name = name
            return tt
        }
        // Also try the unqualified part
        if c.templates.Get(parts[1]).kind != 0 {
            markImportUsed(c, parts[0])
            tt := TType{kind: TK_TEMPLATE}
            tt.name = parts[1]
            return tt
        }
        markImportUsed(c, parts[0])
    }
    aliased := c.aliases.Get(name)
    if aliased.kind != 0 {
        return aliased
    }
    // For module-qualified names (e.g. "types.Handler"), also try the
    // unqualified part ("Handler") since aliases are registered with
    // their short name within their defining module.
    if str.Contains(name, ".") {
        dot := str.LastIndexOf(name, ".")
        if dot >= 0 {
            short := str.Substr(name, dot + 1, str.Len(name) - dot - 1)
            shortAliased := c.aliases.Get(short)
            if shortAliased.kind != 0 {
                return shortAliased
            }
        }
    }
    // `any` is the universal top type: any value is assignable to it.
    if str.Equal(name, "any") {
        return anyType()
    }
    isTU := c.taggedUnions.Get(name).kind != 0
    tuKey := name
    if !isTU && str.Len(c.currentModule) > 0 && !str.Contains(name, ".") {
        // The resolver qualifies enum names with their module
        // (e.g. "main.Shape"), so an unqualified reference in the same
        // module must be looked up under the qualified key.
        qualified := str.Concat(str.Concat(c.currentModule, "."), name)
        if c.taggedUnions.Get(qualified).kind != 0 {
            isTU = true
            tuKey = qualified
        }
    }
    if isTU {
        b := c.scopes[0].bindings.Get(tuKey)
        if b.typ.kind == TK_TAGGED_UNION {
            return b.typ
        }
    }
    return lookupType(name)
}

// astFuncTypeToType converts an AST function type node to a TType.
fn astFuncTypeToType(c: *Checker, t: ast.Type) -> TType {
    params := make([]TType, 0)
    for i := 0; i < len(t.paramTypes); i = i + 1 {
        params = append(params, astTypeToType(c, t.paramTypes[i]))
    }
    var retTypes []TType
    if len(t.retTypes) > 0 {
        retTypes = []TType{}
        for i := 0; i < len(t.retTypes); i = i + 1 {
            retTypes = append(retTypes, astTypeToType(c, t.retTypes[i]))
        }
    } else {
        retTypes = []TType{voidType()}
    }
    return functionType(params, retTypes)
}

// astTupleTypeToType converts an AST tuple type node to a TType.
fn astTupleTypeToType(c: *Checker, t: ast.Type) -> TType {
    types := []TType{}
    for i := 0; i < len(t.tupleTypes); i = i + 1 {
        types = append(types, astTypeToType(c, t.tupleTypes[i]))
    }
    return tupleType(types)
}

// === Assignability with interface/template duck-typing ===

// checkerIsAssignable checks assignability with alias, interface, and template support.
fn checkerIsAssignable(c: *Checker, dst: TType, src: TType) -> bool {
    dst = resolveAlias(c, dst)
    src = resolveAlias(c, src)
    if isAssignable(dst, src) {
        return true
    }
    // Auto-dereference: a pointer to T is assignable to T (the emitter
    // emits a load from the pointer when a by-value struct is expected).
    if src.kind == TK_POINTER {
        inner := typeOptT(src.elem)
        inner = resolveAlias(c, inner)
        if isAssignable(dst, inner) {
            return true
        }
    }
    // Generic type parameters (unqualified TK_NAMED that aren't known
    // structs/tagged-unions/templates) are assignable to each other
    // only if they have the same name. Different type parameters (T vs K)
    // should NOT be considered compatible, as they may represent different
    // concrete types at call sites.
    // Also, generic type params are assignable to string (i8*) since
    // they are erased to i8* in the LLVM backend.
    if dst.kind == TK_NAMED && src.kind == TK_NAMED {
        if !str.Contains(dst.name, ".") && !str.Contains(src.name, ".") {
            dstStructDecl := c.structs.Get(dst.name)
            dstTUDecl := c.taggedUnions.Get(dst.name)
            dstTmplDecl := c.templates.Get(dst.name)
            srcStructDecl := c.structs.Get(src.name)
            srcTUDecl := c.taggedUnions.Get(src.name)
            srcTmplDecl := c.templates.Get(src.name)
            dstIsStruct := dstStructDecl.kind != 0
            dstIsTU := dstTUDecl.kind != 0
            dstIsTmpl := dstTmplDecl.kind != 0
            srcIsStruct := srcStructDecl.kind != 0
            srcIsTU := srcTUDecl.kind != 0
            srcIsTmpl := srcTmplDecl.kind != 0
            if !dstIsStruct && !dstIsTU && !dstIsTmpl && !srcIsStruct && !srcIsTU && !srcIsTmpl {
                // Both are generic type parameters. Only allow assignment
                // if they have the same name (e.g., T -> T, K -> K).
                return str.Equal(dst.name, src.name)
            }
            // Generic type param assignable to string (both erased to i8*)
            if dst.kind == TK_BUILTIN && str.Equal(dst.name, "string") {
                if !srcIsStruct && !srcIsTU && !srcIsTmpl {
                    return true
                }
            }
        }
    }
    // Also handle: dst is string (TK_BUILTIN), src is generic type param (TK_NAMED)
    if dst.kind == TK_BUILTIN && str.Equal(dst.name, "string") && src.kind == TK_NAMED {
        if !str.Contains(src.name, ".") {
            srcIsStruct := c.structs.Get(src.name).kind != 0
            srcIsTU := c.taggedUnions.Get(src.name).kind != 0
            srcIsTmpl := c.templates.Get(src.name).kind != 0
            if !srcIsStruct && !srcIsTU && !srcIsTmpl {
                return true
            }
        }
    }
    // Any pointer type is assignable to string (i8*): the emitter bitcasts.
    // This allows passing struct pointers and function pointers to extern
    // functions that accept void* (e.g. threading helpers).
    if dst.kind == TK_BUILTIN && str.Equal(dst.name, "string") && src.kind == TK_POINTER {
        return true
    }
    // Function types are assignable to string (i8*): the emitter bitcasts.
    if dst.kind == TK_BUILTIN && str.Equal(dst.name, "string") && src.kind == TK_FUNCTION {
        return true
    }
    if dst.kind == TK_INTERFACE || dst.kind == TK_ERROR {
        typeName := ""
        if src.kind == TK_NAMED {
            typeName = src.name
        } else if src.kind == TK_POINTER {
            inner := typeOptT(src.elem)
            if inner.kind == TK_NAMED {
                typeName = inner.name
            }
        }
        if str.Len(typeName) == 0 {
            return false
        }
        for i := 0; i < len(dst.methodNames); i = i + 1 {
            methodName := dst.methodNames[i]
            found := false
            ft := resolve(c, str.Concat(str.Concat(typeName, "."), methodName))
            if ft.kind != TK_UNKNOWN {
                found = true
            }
            if !found && str.Contains(typeName, ".") {
                parts := splitOnLastDot(typeName)
                ft = resolve(c, str.Concat(str.Concat(parts[0], "."), methodName))
                if ft.kind != TK_UNKNOWN {
                    found = true
                }
            }
            if !found {
                parts := splitOnLastDot(typeName)
                ft = resolve(c, str.Concat(str.Concat(parts[1], "."), methodName))
                if ft.kind != TK_UNKNOWN {
                    found = true
                }
            }
            if !found {
                ft = resolve(c, methodName)
                if ft.kind != TK_UNKNOWN {
                    found = true
                }
            }
            if !found {
                return false
            }
        }
        return true
    }
    if dst.kind == TK_TEMPLATE {
        tmpl := c.templates.Get(dst.name)
        if tmpl.kind == 0 {
            return false
        }
        typeName := ""
        if src.kind == TK_NAMED {
            typeName = src.name
        } else if src.kind == TK_POINTER {
            inner := typeOptT(src.elem)
            if inner.kind == TK_NAMED {
                typeName = inner.name
            }
        }
        if str.Len(typeName) == 0 {
            return false
        }
        for i := 0; i < len(tmpl.templateMethods); i = i + 1 {
            methodName := tmpl.templateMethods[i].fnName
            found := false
            ft := resolve(c, str.Concat(str.Concat(typeName, "."), methodName))
            if ft.kind != TK_UNKNOWN {
                found = true
            }
            var moduleName string
            var structName string
            if str.Contains(typeName, ".") {
                parts := splitOnLastDot(typeName)
                moduleName = parts[0]
                structName = parts[1]
            } else {
                structName = typeName
            }
            if !found && str.Len(moduleName) > 0 {
                ft = resolve(c, str.Concat(str.Concat(moduleName, "."), methodName))
                if ft.kind != TK_UNKNOWN {
                    found = true
                }
            }
            if !found && str.Len(structName) > 0 {
                ft = resolve(c, str.Concat(str.Concat(structName, "."), methodName))
                if ft.kind != TK_UNKNOWN {
                    found = true
                }
            }
            if !found {
                ft = resolve(c, methodName)
                if ft.kind != TK_UNKNOWN {
                    found = true
                }
            }
            if !found {
                return false
            }
        }
        return true
    }
    // Pointer to template: *RuleSource — check if src (a pointer to a struct)
    // implements all methods of the template.
    if dst.kind == TK_POINTER {
        dstInner := typeOptT(dst.elem)
        if dstInner.kind == TK_TEMPLATE {
            tmpl := c.templates.Get(dstInner.name)
            if tmpl.kind == 0 {
                return false
            }
            typeName := ""
            if src.kind == TK_NAMED {
                typeName = src.name
            } else if src.kind == TK_POINTER {
                inner := typeOptT(src.elem)
                if inner.kind == TK_NAMED {
                    typeName = inner.name
                }
            }
            if str.Len(typeName) == 0 {
                return false
            }
            for i := 0; i < len(tmpl.templateMethods); i = i + 1 {
                methodName := tmpl.templateMethods[i].fnName
                found := false
                ft := resolve(c, str.Concat(str.Concat(typeName, "."), methodName))
                if ft.kind != TK_UNKNOWN {
                    found = true
                }
                if !found {
                    ft = resolve(c, methodName)
                    if ft.kind != TK_UNKNOWN {
                        found = true
                    }
                }
                if !found {
                    return false
                }
            }
            return true
        }
    }
    return false
}

// resolveAlias follows type alias chains to the underlying type.
pub fn resolveAlias(c: *Checker, t: TType) -> TType {
    visited := make(map[string]bool)
    for {
        if t.kind != TK_NAMED {
            return t
        }
        alias := c.aliases.Get(t.name)
        // For module-qualified names, also try the unqualified part.
        if alias.kind == 0 && str.Contains(t.name, ".") {
            dot := str.LastIndexOf(t.name, ".")
            if dot >= 0 {
                short := str.Substr(t.name, dot + 1, str.Len(t.name) - dot - 1)
                alias = c.aliases.Get(short)
            }
        }
        if alias.kind == 0 {
            return t
        }
        if visited[t.name] {
            return t
        }
        visited[t.name] = true
        t = alias
    }
}

// === Function Type from Decl ===

// fnTypeFromDecl builds a function TType from a function declaration.
fn fnTypeFromDecl(c: *Checker, fnDecl: ast.Decl) -> TType {
    params := make([]TType, 0)
    for i := 0; i < len(fnDecl.fnParams); i = i + 1 {
        pt := unknownType()
        if len(fnDecl.fnParams[i].typ) > 0 {
            pt = astTypeToType(c, fnDecl.fnParams[i].typ[0])
        }
        params = append(params, pt)
    }
    var retTypes []TType
    if len(fnDecl.fnRetTypes) > 0 {
        retTypes = []TType{}
        for i := 0; i < len(fnDecl.fnRetTypes); i = i + 1 {
            retTypes = append(retTypes, astTypeToType(c, fnDecl.fnRetTypes[i]))
        }
    } else {
        retTypes = []TType{voidType()}
    }
    ft := functionType(params, retTypes)
    return ft
}

// === Main Entry Point ===

// checkProgram runs the two-pass type checker over all top-level declarations.
pub fn checkProgram(c: *Checker, decls: []ast.Stmt) -> bool {
    // Pre-pass: collect all top-level type names
    c.currentModule = ""
    for i := 0; i < len(decls); i = i + 1 {
        decl := decls[i]
        if decl.kind == ast.ST_MODULE {
            c.currentModule = decl.decl.moduleName
            continue
        }
        setModuleFromDecl(c, decl)
        if decl.kind == ast.ST_STRUCT {
            d := decl.decl
            // Qualify struct name with current module to avoid conflicts
            // between modules that define structs with the same name
            // (e.g. json.Parser vs parser.Parser)
            if str.Len(c.currentModule) > 0 && !str.Contains(d.structName, ".") {
                d.structName = str.Concat(c.currentModule, str.Concat(".", d.structName))
            }
            declare(c, d.structName, namedType(d.structName))
            c.structs.Set(d.structName, d)
            // Also register under short name for backward compatibility
            // (only if not already taken by another struct)
            shortName := d.structName
            dotIdx := str.LastIndexOf(d.structName, ".")
            if dotIdx > 0 {
                shortName = str.Substr(d.structName, dotIdx + 1, str.Len(d.structName) - dotIdx - 1)
            }
            hasShort := c.structs.Get(shortName).kind != 0
            if !hasShort {
                c.structs.Set(shortName, d)
            }
        } else if decl.kind == ast.ST_ENUM {
            d := decl.decl
            hasPayload := false
            for j := 0; j < len(d.enumVariants); j = j + 1 {
                if len(d.enumVariants[j].payloads) > 0 {
                    hasPayload = true
                    break
                }
            }
            if hasPayload || len(d.enumGenerics) > 0 {
                tu := TType{kind: TK_TAGGED_UNION}
                tu.name = d.enumName
                c.taggedUnions.Set(d.enumName, d)
                var variants []TaggedVariant
                for j := 0; j < len(d.enumVariants); j = j + 1 {
                    v := TaggedVariant{name: d.enumVariants[j].name}
                    var pts []TType
                    for k := 0; k < len(d.enumVariants[j].payloads); k = k + 1 {
                        pts = append(pts, astTypeToType(c, d.enumVariants[j].payloads[k]))
                    }
                    v.payloadType = pts
                    variants = append(variants, v)
                }
                tu.variants = variants
                // Declare AFTER populating variants — declare() stores a
                // copy of the TType, so ordering matters here.
                declare(c, d.enumName, tu)
                for j := 0; j < len(d.enumVariants); j = j + 1 {
                    if len(d.enumVariants[j].payloads) > 0 {
                        var pts []TType
                        for k := 0; k < len(d.enumVariants[j].payloads); k = k + 1 {
                            pts = append(pts, astTypeToType(c, d.enumVariants[j].payloads[k]))
                        }
                        var rets []TType
                        rets = append(rets, tu)
                        ctor := functionType(pts, rets)
                        declare(c, d.enumVariants[j].name, ctor)
                    } else {
                        declare(c, d.enumVariants[j].name, tu)
                    }
                }
            } else {
                declare(c, d.enumName, namedType(d.enumName))
            }
        } else if decl.kind == ast.ST_SERVICE {
            d := decl.decl
            if str.Len(d.serviceForType) == 0 {
                svc := TType{kind: TK_SERVICE}
                svc.name = d.serviceName
                declare(c, d.serviceName, svc)
            }
        } else if decl.kind == ast.ST_RULESET {
            d := decl.decl
            rs := TType{kind: TK_RULESET}
            rs.name = d.rulesetName
            declare(c, d.rulesetName, rs)
        } else if decl.kind == ast.ST_TEMPLATE {
            c.templates.Set(decl.decl.templateName, decl.decl)
            c.templateNamesList = append(c.templateNamesList, decl.decl.templateName)
        } else if decl.kind == ast.ST_TYPEALIAS {
            d := decl.decl
            if len(d.aliasType) > 0 {
                resolved := astTypeToType(c, d.aliasType[0])
                if resolved.kind != TK_UNKNOWN {
                    c.aliases.Set(d.aliasName, resolved)
                    declare(c, d.aliasName, resolved)
                }
            }
        } else if decl.kind == ast.ST_CONST {
            d := decl.decl
            // Block-form consts have an empty constName — declaring it
            // would collide across multiple const blocks.
            if str.Len(d.constName) > 0 {
                declare(c, d.constName, namedType(d.constName))
                registerConstVisibility(c, d.constName, d.constIsPub)
            }
            for j := 0; j < len(d.constBlock); j = j + 1 {
                declare(c, d.constBlock[j].name, namedType(d.constBlock[j].name))
                registerConstVisibility(c, d.constBlock[j].name, d.constIsPub)
            }
        }
    }

    // First pass: register all top-level names and types
    for i := 0; i < len(decls); i = i + 1 {
        decl := decls[i]
        if decl.kind == ast.ST_MODULE {
            c.currentModule = decl.decl.moduleName
            continue
        }
        setModuleFromDecl(c, decl)

        if decl.kind == ast.ST_IMPORT {
            d := decl.decl
            realName := d.importPath
            lastSlash := lastIndexOf(realName, "/")
            if lastSlash >= 0 {
                realName = str.Substr(realName, lastSlash + 1, str.Len(realName) - lastSlash - 1)
            }
            realName = str.Replace(realName, ".skink", "")
            atIdx := str.IndexOf(realName, "@")
            if atIdx >= 0 {
                realName = str.Substr(realName, 0, atIdx)
            }
            realName = str.Replace(realName, "-", "_")
            alias := d.importAlias
            if str.Len(alias) == 0 {
                alias = realName
            }
            moduleKey := c.currentModule
            if str.Len(moduleKey) == 0 {
                moduleKey = "main"
            }
            exists := false
            imps := c.imports.Get(moduleKey)
            if len(imps) > 0 {
                ei := 0
                for ei < len(imps) {
                    if str.Equal(imps[ei], alias) {
                        exists = true
                        break
                    }
                    ei = ei + 1
                }
            }
            existingMod := c.importAliases.Get(alias)
            if existingMod != "" && !str.Equal(existingMod, realName) {
                report(c, str.Concat("duplicate import alias \"", str.Concat(alias, "\"")))
            } else if exists {
                report(c, str.Concat("duplicate import alias \"", str.Concat(alias, str.Concat("\" in module \"", str.Concat(moduleKey, "\"")))))
            } else {
                c.imports.Set(moduleKey, append(c.imports.Get(moduleKey), alias))
                // Track module keys for iteration
                found := false
                for mk in c.importModules {
                    if str.Equal(mk, moduleKey) {
                        found = true
                    }
                }
                if !found {
                    c.importModules = append(c.importModules, moduleKey)
                }
            }
            if str.StartsWith(d.importPath, "C:") {
                markImportUsed(c, alias)
            }
            if str.Len(d.importAlias) > 0 && !str.Equal(d.importAlias, realName) {
                c.importAliases.Set(d.importAlias, realName)
            }
        } else if decl.kind == ast.ST_FN {
            d := decl.decl
            fnType := fnTypeFromDecl(c, d)
            declare(c, d.fnName, fnType)
            c.fnDecls.Set(d.fnName, d)
            if str.Len(c.currentModule) > 0 {
                c.fnDecls.Set(str.Concat(str.Concat(c.currentModule, "."), d.fnName), d)
            }
        } else if decl.kind == ast.ST_CONST {
            // Consts are pre-registered in the pre-pass; their types are
            // resolved during the const-evaluation pass below.
            continue
        } else if decl.kind == ast.ST_STRUCT {
            d := decl.decl
            for j := 0; j < len(d.structMethods); j = j + 1 {
                fnType := fnTypeFromDecl(c, d.structMethods[j])
                declare(c, str.Concat(str.Concat(d.structName, "."), d.structMethods[j].fnName), fnType)
            }
        } else if decl.kind == ast.ST_ENUM {
            d := decl.decl
            isTaggedUnion := false
            for j := 0; j < len(d.enumVariants); j = j + 1 {
                if len(d.enumVariants[j].payloads) > 0 {
                    isTaggedUnion = true
                    break
                }
            }
            if len(d.enumGenerics) > 0 {
                isTaggedUnion = true
            }
            if !isTaggedUnion {
                for j := 0; j < len(d.enumVariants); j = j + 1 {
                    declare(c, d.enumVariants[j].name, builtinType("int"))
                }
            }
        } else if decl.kind == ast.ST_SERVICE {
            d := decl.decl
            if str.Len(d.serviceForType) == 0 {
                for j := 0; j < len(d.serviceMethods); j = j + 1 {
                    fnType := fnTypeFromDecl(c, d.serviceMethods[j])
                    declare(c, d.serviceMethods[j].fnName, fnType)
                }
                svc := TType{kind: TK_SERVICE}
                svc.name = d.serviceName
                b := c.scopes[0].bindings.Get(d.serviceName)
                if b.typ.kind != 0 {
                    b.typ = svc
                    scopeSet(&c.scopes[0], d.serviceName, b)
                }
                c.services.Set(d.serviceName, svc)
            } else {
                forType := d.serviceForType
                if str.Len(c.currentModule) > 0 && !str.Equal(c.currentModule, "main") && !str.Contains(forType, ".") {
                    qualified := str.Concat(str.Concat(c.currentModule, "."), forType)
                    qb := c.scopes[0].bindings.Get(qualified)
                    if qb.typ.kind != 0 {
                        forType = qualified
                    }
                }
                for j := 0; j < len(d.serviceMethods); j = j + 1 {
                    fnType := fnTypeFromDecl(c, d.serviceMethods[j])
                    declare(c, str.Concat(str.Concat(forType, "."), d.serviceMethods[j].fnName), fnType)
                }
            }
        } else if decl.kind == ast.ST_RULESET {
            d := decl.decl
            c.rulesets.Set(d.rulesetName, namedType(d.rulesetName))
            implicitMethods := []string{"start", "stop", "restart", "reset"}
            for j := 0; j < len(implicitMethods); j = j + 1 {
                declare(c, str.Concat(str.Concat(d.rulesetName, "."), implicitMethods[j]), functionType([]TType{}, []TType{voidType()}))
            }
            // registerRule takes a pointer to a RuleSource implementation.
            // The emitter generates wrapper functions and passes them internally.
            registerRuleType := functionType([]TType{anyType()}, []TType{voidType()})
            declare(c, str.Concat(str.Concat(d.rulesetName, "."), "registerRule"), registerRuleType)
        } else if decl.kind == ast.ST_TEMPLATE {
            c.templates.Set(decl.decl.templateName, decl.decl)
            c.templateNamesList = append(c.templateNamesList, decl.decl.templateName)
        } else if decl.kind == ast.ST_VARDECL {
            // Infer the type from the type annotation or the initializer value.
            if len(decl.varType) > 0 {
                declare(c, decl.varName, astTypeToType(c, decl.varType[0]))
            } else if len(decl.varValue) > 0 {
                // Defer initializer inference until after the const
                // resolution pass: the initializer may reference consts
                // that still hold placeholder named types at this point
                // (e.g. `var x = []string{A, B}` would report a spurious
                // "expected A, got B" element mismatch). Declare an `any`
                // placeholder so the name resolves; the var-inference
                // pass below fills in the real type once const bindings
                // are known.
                declare(c, decl.varName, anyType())
            } else {
                // Module-level var without type annotation or initializer
                // is a compile-time error (previously defaulted to any).
                reportAt(c, decl.line, decl.col, str.Concat("module-level var '", str.Concat(decl.varName, "' has no type annotation or initializer")))
                declare(c, decl.varName, anyType())
            }
        } else if decl.kind == ast.ST_EXTERN {
            d := decl.decl
            fnType := fnTypeFromDecl(c, d)
            declare(c, d.fnName, fnType)
            c.fnDecls.Set(d.fnName, d)
            if str.Len(c.currentModule) > 0 {
                c.fnDecls.Set(str.Concat(str.Concat(c.currentModule, "."), d.fnName), d)
            }
        }
    }

    // Second pass: evaluate const declarations first
    for i := 0; i < len(decls); i = i + 1 {
        decl := decls[i]
        if decl.kind == ast.ST_MODULE {
            c.currentModule = decl.decl.moduleName
            continue
        }
        setModuleFromDecl(c, decl)
        if decl.kind == ast.ST_CONST {
            checkDeclaration(c, decl)
        }
    }

    // Resolve any const bindings still holding a placeholder named type.
    // A forward reference such as `const A = B` (B declared later) captures
    // B's pre-registration named type before B's own binding is inferred.
    for i := 0; i < len(decls); i = i + 1 {
        decl := decls[i]
        if decl.kind == ast.ST_CONST {
            d := decl.decl
            if str.Len(d.constName) > 0 {
                resolveConstNamedType(c, d.constName)
            }
            for j := 0; j < len(d.constBlock); j = j + 1 {
                resolveConstNamedType(c, d.constBlock[j].name)
            }
        }
    }

    // Const evaluation mutated global bindings, so any qualified-name
    // resolutions cached during the pass may hold stale placeholder types.
    c.typeCache = ttypeTable{}

    // Var-inference pass: module-level vars declared without a type
    // annotation were given an `any` placeholder in the first pass.
    // Now that const bindings hold their resolved types, run the real
    // inference so every declaration checked below sees the final type
    // regardless of declaration order. checkVarDecl re-checks the
    // initializer in the main pass and reports genuine errors there.
    for i := 0; i < len(decls); i = i + 1 {
        decl := decls[i]
        if decl.kind == ast.ST_MODULE {
            c.currentModule = decl.decl.moduleName
            continue
        }
        setModuleFromDecl(c, decl)
        if decl.kind == ast.ST_VARDECL && len(decl.varType) == 0 && len(decl.varValue) > 0 {
            // Suppress errors from this inference-only check: checkVarDecl
            // re-checks the initializer in the main pass and reports any
            // genuine problems there.
            savedErrs := c.errors
            c.errors = []string{}
            vt := checkExpr(c, decl.varValue[0])
            c.errors = savedErrs
            if vt.kind != TK_UNKNOWN {
                b := c.scopes[0].bindings.Get(decl.varName)
                if b.typ.kind != 0 {
                    b.typ = vt
                    scopeSet(&c.scopes[0], decl.varName, b)
                    c.typeCache = ttypeTable{}
                }
            }
        }
    }

    // Second pass continued: check everything else
    for i := 0; i < len(decls); i = i + 1 {
        decl := decls[i]
        if decl.kind == ast.ST_MODULE {
            c.currentModule = decl.decl.moduleName
            continue
        }
        setModuleFromDecl(c, decl)
        if decl.kind == ast.ST_CONST {
            continue
        }
        checkDeclaration(c, decl)
    }

    // Report unused imports
    for mi := 0; mi < len(c.importModules); mi = mi + 1 {
        modName := c.importModules[mi]
        imps := c.imports.Get(modName)
        ii := 0
        for ii < len(imps) {
            imp := imps[ii]
            if str.Equal(imp, "_") {
                ii = ii + 1
                continue
            }
            if !c.usedImports.Get(imp) && !str.EndsWith(imp, ".") {
                warn(c, str.Concat("unused import \"", str.Concat(imp, str.Concat("\" in module \"", str.Concat(modName, "\"")))))
            }
            ii = ii + 1
        }
    }

    return len(c.errors) == 0
}

// setModuleFromDecl updates the checker's current module and source location.
fn setModuleFromDecl(c: *Checker, decl: ast.Stmt) {
    if decl.kind == ast.ST_MODULE {
        c.currentModule = decl.decl.moduleName
    }
    c.currentFile = decl.filePath
    c.currentLine = decl.line
    c.currentCol = decl.col
}

// === Declaration Checking ===

// checkDeclaration dispatches a top-level declaration to its type-checker.
fn checkDeclaration(c: *Checker, stmt: ast.Stmt) {
    if stmt.kind == ast.ST_FN {
        checkFnDecl(c, stmt.decl)
    } else if stmt.kind == ast.ST_CONST {
        checkConstDecl(c, stmt.decl)
    } else if stmt.kind == ast.ST_STRUCT {
        checkStructDecl(c, stmt.decl)
    } else if stmt.kind == ast.ST_SERVICE {
        d := stmt.decl
        for i := 0; i < len(d.serviceMethods); i = i + 1 {
            checkFnDecl(c, d.serviceMethods[i])
        }
    } else if stmt.kind == ast.ST_RULESET {
        d := stmt.decl
        for i := 0; i < len(d.rulesetRules); i = i + 1 {
            if len(d.rulesetRules[i].condition) > 0 {
                condType := checkExpr(c, d.rulesetRules[i].condition[0])
                if condType.kind != TK_UNKNOWN && !typeEquals(condType, builtinType("bool")) {
                    report(c, str.Concat("rule \"", str.Concat(d.rulesetRules[i].name, str.Concat("\" condition must be bool, got ", typeString(condType)))))
                }
            }
            checkBlockStmt(c, d.rulesetRules[i].ruleAction)
        }
    } else if stmt.kind == ast.ST_TEMPLATE {
        checkTemplateDecl(c, stmt.decl)
    } else if stmt.kind == ast.ST_VARDECL {
        checkVarDecl(c, stmt)
    }
}

// checkVarDecl infers and updates the type of a module-level var declaration.
fn checkVarDecl(c: *Checker, s: ast.Stmt) {
    if len(s.varValue) > 0 {
        valType := checkExpr(c, s.varValue[0])
        b := c.scopes[0].bindings.Get(s.varName)
        if b.typ.kind != 0 {
            b.typ = valType
            scopeSet(&c.scopes[0], s.varName, b)
            // The binding's type changed — drop cached qualified-name
            // resolutions that may hold the previous placeholder type.
            c.typeCache = ttypeTable{}
        }
    }
}

// checkConstDecl infers and updates the type of a constant declaration.
fn checkConstDecl(c: *Checker, d: ast.Decl) {
    if len(d.constValue) > 0 {
        c.constExprs.Set(d.constName, d.constValue[0])
        valType := checkExpr(c, d.constValue[0])
        if valType.kind == TK_UNKNOWN {
            report(c, str.Concat("cannot infer type for constant \"", str.Concat(d.constName, "\"")))
            return
        }
        b := c.scopes[0].bindings.Get(d.constName)
        if b.typ.kind != 0 {
            b.typ = valType
            scopeSet(&c.scopes[0], d.constName, b)
            // The binding's type changed — drop cached qualified-name
            // resolutions that may hold the previous placeholder type.
            c.typeCache = ttypeTable{}
        }
    }
    for i := 0; i < len(d.constBlock); i = i + 1 {
        if len(d.constBlock[i].value) > 0 {
            c.constExprs.Set(d.constBlock[i].name, d.constBlock[i].value[0])
            valType := checkExpr(c, d.constBlock[i].value[0])
            if valType.kind == TK_UNKNOWN {
                report(c, str.Concat("cannot infer type for constant \"", str.Concat(d.constBlock[i].name, "\"")))
            } else {
                b := c.scopes[0].bindings.Get(d.constBlock[i].name)
                if b.typ.kind != 0 {
                    b.typ = valType
                    scopeSet(&c.scopes[0], d.constBlock[i].name, b)
                    c.typeCache = ttypeTable{}
                }
            }
        }
    }
}

// resolveConstNamedType rewrites a const binding whose type is still a
// placeholder named type — produced when the initializer referenced another
// const before that const's own binding was inferred — to the referenced
// binding's resolved type. Self-referential named types (e.g. a const holding
// a struct value) are left alone.
fn resolveConstNamedType(c: *Checker, name: string) {
    b := c.scopes[0].bindings.Get(name)
    t := b.typ
    depth := 0
    for t.kind == TK_NAMED && depth < 32 {
        target := c.scopes[0].bindings.Get(t.name)
        if target.typ.kind == 0 {
            return
        }
        if target.typ.kind != TK_NAMED {
            b.typ = target.typ
            scopeSet(&c.scopes[0], name, b)
            return
        }
        if str.Equal(target.typ.name, t.name) {
            return
        }
        t = target.typ
        depth = depth + 1
    }
}

// checkStructDecl validates struct field types and checks its methods.
fn checkStructDecl(c: *Checker, d: ast.Decl) {
    for i := 0; i < len(d.structFields); i = i + 1 {
        // Duplicate field names silently shadow the earlier slot
        // (comp_error.md #89) — reject them at declaration time.
        for j := 0; j < i; j = j + 1 {
            if str.Equal(d.structFields[j].name, d.structFields[i].name) {
                reportAt(c, c.currentLine, c.currentCol, str.Concat("duplicate field \"", str.Concat(d.structFields[i].name, str.Concat("\" in struct \"", str.Concat(d.structName, "\"")))))
            }
        }
        if len(d.structFields[i].typ) == 0 {
            reportAt(c, 0, 0, str.Concat("field \"", str.Concat(d.structFields[i].name, str.Concat("\" in struct \"", str.Concat(d.structName, "\" has no type")))))
            continue
        }
        ft := astTypeToType(c, d.structFields[i].typ[0])
        if ft.kind == TK_UNKNOWN {
            reportAt(c, 0, 0, str.Concat("unknown type for field \"", str.Concat(d.structFields[i].name, str.Concat("\" in struct \"", str.Concat(d.structName, "\"")))))
        }
    }
    c.structs.Set(d.structName, d)
    // Also register under short name if not already taken
    shortName := d.structName
    dotIdx := str.LastIndexOf(d.structName, ".")
    if dotIdx > 0 {
        shortName = str.Substr(d.structName, dotIdx + 1, str.Len(d.structName) - dotIdx - 1)
    }
    hasShort := c.structs.Get(shortName).kind != 0
    if !hasShort {
        c.structs.Set(shortName, d)
    }
    for i := 0; i < len(d.structMethods); i = i + 1 {
        checkFnDecl(c, d.structMethods[i])
    }
}

// checkTemplateDecl validates a template declaration's method signatures.
fn checkTemplateDecl(c: *Checker, d: ast.Decl) {
    for i := 0; i < len(d.templateMethods); i = i + 1 {
        m := d.templateMethods[i]
        if len(m.fnParams) == 0 {
            report(c, str.Concat("template method \"", str.Concat(m.fnName, "\" must have a receiver parameter")))
            continue
        }
        fnTypeFromDecl(c, m)
    }
}

// checkFnDecl type-checks a function body, including params and return paths.
fn checkFnDecl(c: *Checker, fnDecl: ast.Decl) {
    fnType := fnTypeFromDecl(c, fnDecl)
    oldFn := c.currentFn
    c.currentFn = singleTType(fnType)
    oldRetNames := c.currentFnRetNames
    c.currentFnRetNames = fnDecl.fnRetNames
    pushScope(c)
    for i := 0; i < len(fnDecl.fnParams); i = i + 1 {
        pt := unknownType()
        if len(fnDecl.fnParams[i].typ) > 0 {
            pt = astTypeToType(c, fnDecl.fnParams[i].typ[0])
        }
        declareParam(c, fnDecl.fnParams[i].name, pt)
        if i < len(fnType.params) {
            fnType.params[i] = pt
        }
    }
    // Declare named return variables.
    for i := 0; i < len(fnDecl.fnRetNames); i = i + 1 {
        if str.Len(fnDecl.fnRetNames[i]) > 0 && i < len(fnType.retTypes) {
            declare(c, fnDecl.fnRetNames[i], fnType.retTypes[i])
        }
    }
    if len(fnDecl.fnBody) > 0 {
        checkBlockStmt(c, fnDecl.fnBody)
        if len(fnType.retTypes) == 1 && !typeEquals(fnType.retTypes[0], voidType()) {
            if !stmtAlwaysReturnsBlock(c, fnDecl.fnBody) {
                // Check for implicit return: last statement is an expression
                // whose type matches the return type.
                hasImplicitReturn := false
                if len(fnDecl.fnBody) > 0 {
                    last := fnDecl.fnBody[len(fnDecl.fnBody) - 1]
                    if last.kind == ast.ST_EXPR && ast.hasExpr(last.expr) {
                        lastType := checkExpr(c, last.expr[0])
                        if typeEquals(lastType, fnType.retTypes[0]) || checkerIsAssignable(c, fnType.retTypes[0], lastType) {
                            hasImplicitReturn = true
                        }
                    }
                }
                if !hasImplicitReturn {
                    report(c, str.Concat("missing return at end of function \"", str.Concat(fnDecl.fnName, str.Concat("\" (expected ", str.Concat(typeString(fnType.retTypes[0]), ")")))))
                }
            }
        }
    }
    popScope(c)
    c.currentFn = oldFn
    c.currentFnRetNames = oldRetNames
}

// === Statement Checking ===

// checkBlockStmt type-checks a sequence of statements in a new scope.
fn checkBlockStmt(c: *Checker, stmts: []ast.Stmt) {
    pushScope(c)
    for i := 0; i < len(stmts); i = i + 1 {
        checkStatement(c, stmts[i])
    }
    popScope(c)
}

// checkStatement dispatches a statement to its type-checker.
fn checkStatement(c: *Checker, stmt: ast.Stmt) {
    c.currentLine = stmt.line
    c.currentCol = stmt.col
    if stmt.kind == ast.ST_VAR {
        checkVarStmt(c, stmt)
    } else if stmt.kind == ast.ST_ASSIGN {
        checkAssignStmt(c, stmt)
    } else if stmt.kind == ast.ST_TUPLEASSIGN {
        checkTupleAssignStmt(c, stmt)
    } else if stmt.kind == ast.ST_RETURN {
        checkReturnStmt(c, stmt)
    } else if stmt.kind == ast.ST_IF {
        checkIfStmt(c, stmt)
    } else if stmt.kind == ast.ST_FOR {
        checkForStmt(c, stmt)
    } else if stmt.kind == ast.ST_WHILE {
        checkWhileStmt(c, stmt)
    } else if stmt.kind == ast.ST_UNTIL {
        checkUntilStmt(c, stmt)
    } else if stmt.kind == ast.ST_EXPR {
        checkExprStmt(c, stmt)
    } else if stmt.kind == ast.ST_BLOCK {
        checkBlockStmt(c, stmt.thenBody)
    } else if stmt.kind == ast.ST_DEFER {
        checkDeferStmt(c, stmt)
    } else if stmt.kind == ast.ST_SPAWN {
        checkSpawnStmt(c, stmt)
    } else if stmt.kind == ast.ST_SELECT {
        checkSelectStmt(c, stmt)
    } else if stmt.kind == ast.ST_SWITCH {
        checkSwitchStmt(c, stmt)
    } else if stmt.kind == ast.ST_MATCH {
        checkMatchStmt(c, stmt)
    } else if stmt.kind == ast.ST_BREAK {
        // break is valid inside loops, switch and select bodies — all
        // three push a breakable label in the emitter. Outside them the
        // emitter branches to a nonexistent label (comp_error.md #88).
        if c.breakDepth == 0 {
            reportAt(c, stmt.line, stmt.col, "break is not in a loop, switch, or select")
        }
    } else if stmt.kind == ast.ST_CONTINUE {
        if c.loopDepth == 0 {
            reportAt(c, stmt.line, stmt.col, "continue is not in a loop")
        }
    }
}

// checkVarStmt type-checks a variable declaration statement.
fn checkVarStmt(c: *Checker, stmt: ast.Stmt) {
    if len(stmt.varNames) > 0 {
        valType := unknownType()
        if len(stmt.varValue) > 0 {
            valType = checkExpr(c, stmt.varValue[0])
        }
        // Handle channel receive comma-ok: v, ok := <-ch
        if len(stmt.varNames) == 2 && len(stmt.varValue) > 0 {
            ve := stmt.varValue[0]
            if ve.kind == ast.EX_PREFIX && str.Equal(ve.prefixOp, "<-") {
                // First variable gets the element type, second gets bool.
                declare(c, stmt.varNames[0], valType)
                declare(c, stmt.varNames[1], builtinType("bool"))
                return
            }
            // Handle map comma-ok: v, ok := m[key]
            if ve.kind == ast.EX_INDEX {
                targetType := checkExpr(c, ve.indexTarget[0])
                if targetType.kind == TK_MAP {
                    // First variable gets the value type, second gets bool.
                    declare(c, stmt.varNames[0], typeOptT(targetType.elem))
                    declare(c, stmt.varNames[1], builtinType("bool"))
                    return
                }
            }
        }
        // Go-style := semantics: at least one name must be new in this
        // scope; already-declared names are redeclared only when the
        // statement introduces at least one new variable.
        anyNew := false
        for i := 0; i < len(stmt.varNames); i = i + 1 {
            cur := &c.scopes[c.scopeDepth]
            if cur.bindings.Get(stmt.varNames[i]).typ.kind == 0 || str.Equal(stmt.varNames[i], "_") {
                anyNew = true
            }
        }
        for i := 0; i < len(stmt.varNames); i = i + 1 {
            itemType := unknownType()
            if valType.kind == TK_TUPLE && i < len(valType.tupleTypes) {
                itemType = valType.tupleTypes[i]
            }
            // Multi-expression form: a, b := 10, 20 — each name takes the
            // type of its own RHS expression. (Only when the RHS count
            // matches; a single tuple-returning call is handled above.)
            if len(stmt.varValue) == len(stmt.varNames) && len(stmt.varValue) > 1 {
                et := checkExpr(c, stmt.varValue[i])
                if et.kind != TK_UNKNOWN {
                    itemType = et
                }
            }
            cur := &c.scopes[c.scopeDepth]
            if cur.bindings.Get(stmt.varNames[i]).typ.kind != 0 && anyNew && !str.Equal(stmt.varNames[i], "_") {
                // Reuse: redeclare by updating the binding's type.
                scopeSet(cur, stmt.varNames[i], Binding{typ: itemType})
                continue
            }
            declare(c, stmt.varNames[i], itemType)
        }
        return
    }
    if len(stmt.varType) > 0 {
        annotType := astTypeToType(c, stmt.varType[0])
        if len(stmt.varValue) > 0 {
            valType := checkExpr(c, stmt.varValue[0])
            if !checkerIsAssignable(c, annotType, valType) {
                reportAt(c, stmt.line, stmt.col, str.Concat("cannot assign ", str.Concat(typeString(valType), str.Concat(" to ", str.Concat(typeString(annotType), str.Concat(" for variable \"", str.Concat(stmt.varName, "\"")))))))
            }
            checkIntLitFits(c, stmt.varValue[0], annotType)
        }
        declare(c, stmt.varName, annotType)
    } else if len(stmt.varValue) > 0 {
        valType := checkExpr(c, stmt.varValue[0])
        if valType.kind == TK_UNKNOWN {
            reportAt(c, stmt.line, stmt.col, str.Concat("cannot infer type for variable \"", str.Concat(stmt.varName, "\"")))
            declare(c, stmt.varName, unknownType())
        } else {
            declare(c, stmt.varName, valType)
        }
    } else {
        declare(c, stmt.varName, unknownType())
    }
}

// checkAssignStmt type-checks an assignment statement.
fn checkAssignStmt(c: *Checker, stmt: ast.Stmt) {
    // Unwrap parenthesized targets — `(x) = v` / `(*p) = v` wrap the
    // lvalue in EX_PAREN (comp_error.md #38).
    var target ast.Expr
    if len(stmt.assignTarget) > 0 {
        target = stmt.assignTarget[0]
        for target.kind == ast.EX_PAREN && len(target.inner) > 0 {
            target = target.inner[0]
        }
    }
    // `_ = expr` discards the value — check the RHS only.
    if target.kind == ast.EX_IDENT && str.Equal(target.ident, "_") {
        if len(stmt.assignValue) > 0 {
            checkExpr(c, stmt.assignValue[0])
        }
        return
    }
    lvalType := checkExpr(c, target)
    if lvalType.kind == TK_UNKNOWN {
        return
    }
    valType := checkExpr(c, stmt.assignValue[0])
    if valType.kind == TK_UNKNOWN {
        return
    }
    if str.Equal(stmt.assignOp, "=") {
        if !checkerIsAssignable(c, lvalType, valType) {
            reportAt(c, stmt.line, stmt.col, str.Concat("cannot assign ", str.Concat(typeString(valType), str.Concat(" to ", typeString(lvalType)))))
        }
        checkIntLitFits(c, stmt.assignValue[0], lvalType)
    } else {
        isBitwise := str.Equal(stmt.assignOp, "&=") || str.Equal(stmt.assignOp, "|=") || str.Equal(stmt.assignOp, "^=") || str.Equal(stmt.assignOp, "<<=") || str.Equal(stmt.assignOp, ">>=")
        if isBitwise {
            if !isInteger(lvalType) || !isInteger(valType) {
                reportAt(c, stmt.line, stmt.col, str.Concat("bitwise compound assignment ", str.Concat(stmt.assignOp, " requires integer operands")))
            }
        } else if !isNumeric(lvalType) || !isNumeric(valType) {
            reportAt(c, stmt.line, stmt.col, str.Concat("compound assignment ", str.Concat(stmt.assignOp, " requires numeric operands")))
        }
    }
}

// checkTupleAssignStmt type-checks a multi-target tuple assignment statement.
fn checkTupleAssignStmt(c: *Checker, stmt: ast.Stmt) {
    // Per-target form: a, b = x, y — check each pair independently.
    if len(stmt.assignValue) == len(stmt.tupleTargets) && len(stmt.assignValue) > 1 {
        for i := 0; i < len(stmt.tupleTargets); i = i + 1 {
            vt := checkExpr(c, stmt.assignValue[i])
            tgt := stmt.tupleTargets[i]
            if tgt.kind == ast.EX_IDENT && str.Equal(tgt.ident, "_") {
                continue
            }
            lt := checkExpr(c, tgt)
            if vt.kind == TK_UNKNOWN || lt.kind == TK_UNKNOWN {
                continue
            }
            if !checkerIsAssignable(c, lt, vt) {
                reportAt(c, stmt.line, stmt.col, str.Concat("cannot assign ", str.Concat(typeString(vt), str.Concat(" to ", str.Concat(typeString(lt), str.Concat(" in tuple assignment at position ", itoa(i)))))))
            }
        }
        return
    }
    valType := checkExpr(c, stmt.assignValue[0])
    if valType.kind == TK_UNKNOWN {
        return
    }
    if valType.kind != TK_TUPLE {
        reportAt(c, stmt.line, stmt.col, str.Concat("cannot use tuple assignment with non-tuple value of type ", typeString(valType)))
        return
    }
    if len(stmt.tupleTargets) != len(valType.tupleTypes) {
        reportAt(c, stmt.line, stmt.col, "tuple assignment count mismatch")
        return
    }
    for i := 0; i < len(stmt.tupleTargets); i = i + 1 {
        tgt2 := stmt.tupleTargets[i]
        if tgt2.kind == ast.EX_IDENT && str.Equal(tgt2.ident, "_") {
            continue
        }
        lvalType := checkExpr(c, tgt2)
        if lvalType.kind == TK_UNKNOWN {
            continue
        }
        if !checkerIsAssignable(c, lvalType, valType.tupleTypes[i]) {
            reportAt(c, stmt.line, stmt.col, str.Concat("cannot assign ", str.Concat(typeString(valType.tupleTypes[i]), str.Concat(" to ", str.Concat(typeString(lvalType), str.Concat(" in tuple assignment at position ", itoa(i)))))))
        }
    }
}

// checkReturnStmt type-checks a return statement against the function's return types.
fn checkReturnStmt(c: *Checker, stmt: ast.Stmt) {
    if len(c.currentFn) == 0 {
        report(c, "return outside of function")
        return
    }
    fnType := typeOptT(c.currentFn)
    expected := fnType.retTypes
    if len(expected) == 1 {
        exp := expected[0]
        if len(stmt.returnValues) == 0 {
            if !typeEquals(exp, voidType()) {
                reportAt(c, stmt.line, stmt.col, str.Concat("missing return value (expected ", str.Concat(typeString(exp), ")")))
            }
            return
        }
        if len(stmt.returnValues) > 1 {
            reportAt(c, stmt.line, stmt.col, "too many return values (expected 1)")
            return
        }
        actual := checkExpr(c, stmt.returnValues[0])
        if actual.kind != TK_UNKNOWN && !checkerIsAssignable(c, exp, actual) {
            reportAt(c, stmt.line, stmt.col, str.Concat("return type mismatch: expected ", str.Concat(typeString(exp), str.Concat(", got ", typeString(actual)))))
        }
        checkIntLitFits(c, stmt.returnValues[0], exp)
        return
    }
    if len(stmt.returnValues) != len(expected) {
        // Allow bare return if the function has named return values.
        if len(stmt.returnValues) == 0 && len(c.currentFnRetNames) > 0 {
            return
        }
        if len(stmt.returnValues) == 1 {
            actual := checkExpr(c, stmt.returnValues[0])
            if actual.kind == TK_TUPLE && len(actual.tupleTypes) == len(expected) {
                for i := 0; i < len(expected); i = i + 1 {
                    if !checkerIsAssignable(c, expected[i], actual.tupleTypes[i]) {
                        reportAt(c, stmt.line, stmt.col, str.Concat("return type mismatch at position ", str.Concat(itoa(i), str.Concat(": expected ", str.Concat(typeString(expected[i]), str.Concat(", got ", typeString(actual.tupleTypes[i])))))))
                    }
                }
                return
            }
        }
        reportAt(c, stmt.line, stmt.col, str.Concat("return value count mismatch: expected ", str.Concat(itoa(len(expected)), str.Concat(", got ", itoa(len(stmt.returnValues))))))
        return
    }
    for i := 0; i < len(stmt.returnValues); i = i + 1 {
        actual := checkExpr(c, stmt.returnValues[i])
        if actual.kind != TK_UNKNOWN && !checkerIsAssignable(c, expected[i], actual) {
            reportAt(c, stmt.line, stmt.col, str.Concat("return type mismatch at position ", str.Concat(itoa(i), str.Concat(": expected ", str.Concat(typeString(expected[i]), str.Concat(", got ", typeString(actual)))))))
        }
        checkIntLitFits(c, stmt.returnValues[i], expected[i])
    }
}

// checkIfStmt type-checks an if statement's condition and branches.
fn checkIfStmt(c: *Checker, stmt: ast.Stmt) {
    pushScope(c)
    if len(stmt.ifInit) > 0 {
        checkStatement(c, stmt.ifInit[0])
    }
    if len(stmt.cond) > 0 {
        condType := checkExpr(c, stmt.cond[0])
        if condType.kind != TK_UNKNOWN && !typeEquals(condType, builtinType("bool")) {
            reportAt(c, stmt.line, stmt.col, str.Concat("if condition must be bool, got ", typeString(condType)))
        }
    }
    checkBlockStmt(c, stmt.thenBody)
    if len(stmt.elseBody) > 0 {
        checkBlockStmt(c, stmt.elseBody)
    }
    popScope(c)
}

// checkWhileStmt type-checks a while loop's condition and body.
fn checkWhileStmt(c: *Checker, stmt: ast.Stmt) {
    if len(stmt.cond) > 0 {
        condType := checkExpr(c, stmt.cond[0])
        if condType.kind != TK_UNKNOWN && !typeEquals(condType, builtinType("bool")) {
            reportAt(c, stmt.line, stmt.col, str.Concat("while condition must be bool, got ", typeString(condType)))
        }
    }
    c.loopDepth = c.loopDepth + 1
    c.breakDepth = c.breakDepth + 1
    checkBlockStmt(c, stmt.thenBody)
    c.loopDepth = c.loopDepth - 1
    c.breakDepth = c.breakDepth - 1
}

// checkUntilStmt type-checks an until loop's condition and body.
fn checkUntilStmt(c: *Checker, stmt: ast.Stmt) {
    if len(stmt.cond) > 0 {
        condType := checkExpr(c, stmt.cond[0])
        if condType.kind != TK_UNKNOWN && !typeEquals(condType, builtinType("bool")) {
            reportAt(c, stmt.line, stmt.col, str.Concat("until condition must be bool, got ", typeString(condType)))
        }
    }
    c.loopDepth = c.loopDepth + 1
    c.breakDepth = c.breakDepth + 1
    checkBlockStmt(c, stmt.thenBody)
    c.loopDepth = c.loopDepth - 1
    c.breakDepth = c.breakDepth - 1
}

// checkForStmt type-checks a for loop, including iterator and range forms.
fn checkForStmt(c: *Checker, stmt: ast.Stmt) {
    pushScope(c)
    if len(stmt.forIterExpr) > 0 {
        iterType := checkExpr(c, stmt.forIterExpr[0])
        hasTwoVars := str.Len(stmt.forIterVar2) > 0
        if iterType.kind == TK_ARRAY {
            if hasTwoVars {
                // for i, v in array: i is int (index), v is element
                declare(c, stmt.forIterVar, builtinType("int"))
                declare(c, stmt.forIterVar2, typeOptT(iterType.elem))
            } else {
                declare(c, stmt.forIterVar, typeOptT(iterType.elem))
            }
        } else if iterType.kind == TK_SET {
            declare(c, stmt.forIterVar, typeOptT(iterType.elem))
        } else if iterType.kind == TK_CHAN {
            declare(c, stmt.forIterVar, typeOptT(iterType.elem))
        } else if iterType.kind == TK_MAP {
            if hasTwoVars {
                // for k, v in map: k is key type, v is value type
                declare(c, stmt.forIterVar, typeOptT(iterType.keyType))
                declare(c, stmt.forIterVar2, typeOptT(iterType.elem))
            } else {
                // For-in over a map iterates over the keys.
                declare(c, stmt.forIterVar, typeOptT(iterType.keyType))
            }
        } else if iterType.kind == TK_BUILTIN && str.Equal(iterType.name, "string") {
            // String iteration yields byte values; two-var form gives
            // (index, byte).
            if hasTwoVars {
                declare(c, stmt.forIterVar, builtinType("int"))
                declare(c, stmt.forIterVar2, builtinType("int"))
            } else {
                declare(c, stmt.forIterVar, builtinType("int"))
            }
        } else if isInteger(iterType) {
            // A bare integer is not a valid iterable — the supported
            // range form is `for i in a..b`. Without this rejection the
            // emitter nil-compares the int and produces invalid LLVM IR
            // (comp_error.md #76).
            report(c, str.Concat("cannot iterate over ", str.Concat(typeString(iterType), "; use a range: for i in 0..n")))
            declare(c, stmt.forIterVar, builtinType("int"))
        } else {
            declare(c, stmt.forIterVar, anyType())
            if hasTwoVars {
                declare(c, stmt.forIterVar2, anyType())
            }
        }
        c.loopDepth = c.loopDepth + 1
        c.breakDepth = c.breakDepth + 1
        checkBlockStmt(c, stmt.thenBody)
        c.loopDepth = c.loopDepth - 1
        c.breakDepth = c.breakDepth - 1
    } else {
        if len(stmt.forInit) > 0 {
            checkStatement(c, stmt.forInit[0])
        }
        if len(stmt.cond) > 0 {
            condType := checkExpr(c, stmt.cond[0])
            if condType.kind != TK_UNKNOWN && !typeEquals(condType, builtinType("bool")) {
                reportAt(c, stmt.line, stmt.col, str.Concat("for condition must be bool, got ", typeString(condType)))
            }
        }
        if len(stmt.forPost) > 0 {
            checkStatement(c, stmt.forPost[0])
        }
        c.loopDepth = c.loopDepth + 1
        c.breakDepth = c.breakDepth + 1
        checkBlockStmt(c, stmt.thenBody)
        c.loopDepth = c.loopDepth - 1
        c.breakDepth = c.breakDepth - 1
    }
    popScope(c)
}

// checkExprStmt type-checks an expression used as a statement.
fn checkExprStmt(c: *Checker, stmt: ast.Stmt) {
    if len(stmt.expr) > 0 {
        checkExpr(c, stmt.expr[0])
    }
}

// checkDeferStmt type-checks a deferred statement.
fn checkDeferStmt(c: *Checker, stmt: ast.Stmt) {
    if len(stmt.deferStmt) > 0 {
        checkStatement(c, stmt.deferStmt[0])
    }
}

// checkSpawnStmt type-checks a spawn (goroutine) statement.
fn checkSpawnStmt(c: *Checker, stmt: ast.Stmt) {
    if len(stmt.spawnCall) > 0 {
        checkExpr(c, stmt.spawnCall[0])
    }
}

// checkSelectStmt type-checks a select statement's channel cases.
fn checkSelectStmt(c: *Checker, stmt: ast.Stmt) {
    // Select bodies are breakable in the emitter — allow `break` here
    // (comp_error.md #88).
    c.breakDepth = c.breakDepth + 1
    for i := 0; i < len(stmt.selectCases); i = i + 1 {
        sc := stmt.selectCases[i]
        if !sc.isDefault && len(sc.cond) > 0 {
            condExpr := sc.cond[0]
            // Handle send case: case ch <- val
            // The infix <- operator is a channel send. Check that the left
            // operand is a channel and the right operand matches its element type.
            if condExpr.kind == ast.EX_INFIX && str.Equal(condExpr.infixOp, "<-") {
                chType := checkExpr(c, condExpr.infixLeft[0])
                valType := checkExpr(c, condExpr.infixRight[0])
                if chType.kind == TK_CHAN && len(chType.elem) > 0 {
                    elemT := typeOptT(chType.elem)
                    if !typeEquals(elemT, valType) && valType.kind != TK_UNKNOWN {
                        reportAt(c, condExpr.line, condExpr.col,
                            str.Concat("select send case value type ",
                            str.Concat(typeString(valType),
                            str.Concat(" does not match channel element type ",
                            typeString(elemT)))))
                    }
                }
                checkBlockStmt(c, sc.body)
                continue
            }
            // Handle receive case: case val := <-ch  or  case <-ch
            checkExpr(c, condExpr)
            if str.Len(sc.recvVar) > 0 && !str.Equal(sc.recvVar, "_") {
                if condExpr.kind == ast.EX_PREFIX && str.Equal(condExpr.prefixOp, "<-") {
                    chElemType := checkExpr(c, condExpr.prefixRight[0])
                    if chElemType.kind == TK_CHAN {
                        pushScope(c)
                        declare(c, sc.recvVar, typeOptT(chElemType.elem))
                        checkBlockStmt(c, sc.body)
                        popScope(c)
                        continue
                    }
                }
                pushScope(c)
                declare(c, sc.recvVar, unknownType())
                checkBlockStmt(c, sc.body)
                popScope(c)
                continue
            }
        }
        checkBlockStmt(c, sc.body)
    }
    c.breakDepth = c.breakDepth - 1
}

// checkSwitchStmt type-checks a switch statement's cases and default.
fn checkSwitchStmt(c: *Checker, stmt: ast.Stmt) {
    var subjType TType
    if len(stmt.cond) > 0 {
        subjType = checkExpr(c, stmt.cond[0])
    }
    hasDefault := false
    // Switch bodies are breakable (break exits the switch) — allow it
    // here (comp_error.md #88).
    c.breakDepth = c.breakDepth + 1
    for i := 0; i < len(stmt.selectCases); i = i + 1 {
        sc := stmt.selectCases[i]
        if sc.isDefault {
            hasDefault = true
        }
        for j := 0; j < len(sc.cond); j = j + 1 {
            valType := checkExpr(c, sc.cond[j])
            if subjType.kind != TK_UNKNOWN && valType.kind != TK_UNKNOWN {
                if !typeEquals(subjType, valType) {
                    reportAt(c, stmt.line, stmt.col, str.Concat("switch case value type ", str.Concat(typeString(valType), str.Concat(" does not match subject type ", typeString(subjType)))))
                }
            }
        }
        checkBlockStmt(c, sc.body)
    }
    c.breakDepth = c.breakDepth - 1
    if !hasDefault {
        reportAt(c, stmt.line, stmt.col, "switch statement must have a default case")
    }
}

// checkMatchStmt type-checks a match statement's arms and variant coverage.
fn checkMatchStmt(c: *Checker, stmt: ast.Stmt) {
    var subjectType TType
    if len(stmt.matchSubject) > 0 {
        subjectType = checkExpr(c, stmt.matchSubject[0])
    }
    hasWildcard := false
    for i := 0; i < len(stmt.matchArms); i = i + 1 {
        arm := stmt.matchArms[i]
        if arm.isWildcard {
            hasWildcard = true
        }
        if arm.pattern.kind == ast.PK_VARIANT && subjectType.kind == TK_TAGGED_UNION {
            variant := findVariant(subjectType, arm.pattern.variantName)
            if variant.name == "" {
                reportAt(c, stmt.line, stmt.col, str.Concat("match variant \"", str.Concat(arm.pattern.variantName, str.Concat("\" does not exist in enum \"", str.Concat(subjectType.name, "\"")))))
            } else {
                if len(variant.payloadType) > 0 && len(arm.pattern.bindings) > 0 {
                    pushScope(c)
                    for j := 0; j < len(arm.pattern.bindings); j = j + 1 {
                        if j < len(variant.payloadType) {
                            declare(c, arm.pattern.bindings[j], variant.payloadType[j])
                        } else {
                            declare(c, arm.pattern.bindings[j], variant.payloadType[0])
                        }
                    }
                }
            }
        }
        if len(arm.guard) > 0 {
            guardType := checkExpr(c, arm.guard[0])
            if guardType.kind != TK_UNKNOWN && !typeEquals(guardType, builtinType("bool")) {
                reportAt(c, stmt.line, stmt.col, str.Concat("match guard must be bool, got ", typeString(guardType)))
            }
        }
        checkBlockStmt(c, arm.body)
        if arm.pattern.kind == ast.PK_VARIANT && subjectType.kind == TK_TAGGED_UNION {
            variant := findVariant(subjectType, arm.pattern.variantName)
            if variant.name != "" && len(variant.payloadType) > 0 && len(arm.pattern.bindings) > 0 {
                popScope(c)
            }
        }
    }
    if !hasWildcard && subjectType.kind == TK_TAGGED_UNION {
        covered := make(map[string]bool)
        for i := 0; i < len(stmt.matchArms); i = i + 1 {
            if stmt.matchArms[i].pattern.kind == ast.PK_VARIANT {
                covered[stmt.matchArms[i].pattern.variantName] = true
            }
            if stmt.matchArms[i].pattern.kind == ast.PK_IDENT {
                idName := stmt.matchArms[i].pattern.identName
                if findVariant(subjectType, idName).name != "" {
                    covered[idName] = true
                }
            }
        }
        allCovered := true
        for i := 0; i < len(subjectType.variants); i = i + 1 {
            if !covered[subjectType.variants[i].name] {
                allCovered = false
                break
            }
        }
        if !allCovered {
            reportAt(c, stmt.line, stmt.col, str.Concat("match expression on enum \"", str.Concat(subjectType.name, "\" must have a wildcard (_) arm or cover all variants")))
        }
    } else if !hasWildcard {
        reportAt(c, stmt.line, stmt.col, "match expression must have a wildcard (_) arm")
    }
}

// findVariant looks up a variant by name in a tagged-union type.
fn findVariant(tu: TType, name: string) -> TaggedVariant {
    for i := 0; i < len(tu.variants); i = i + 1 {
        if str.Equal(tu.variants[i].name, name) {
            return tu.variants[i]
        }
    }
    return TaggedVariant{}
}

// === Expression Checking ===

// checkExpr type-checks an expression and returns its inferred type,
// recording the result in exprTypes keyed by "file line:col" so the
// emitter can recover types it can't re-derive (channel elements,
// integer signedness). Internal recursion also flows through this
// wrapper, so nested expressions are recorded too.
fn checkExpr(c: *Checker, e: ast.Expr) -> TType {
    t := checkExprImpl(c, e)
    if !c.suppressExprTypes && t.kind != 0 && t.kind != TK_UNKNOWN && e.line > 0 {
        key := str.Concat(c.currentFile, str.Concat(" ", str.Concat(strconv.Itoa(e.line), str.Concat(":", strconv.Itoa(e.col)))))
        c.exprTypes.Set(key, t)
    }
    return t
}

// checkExprImpl type-checks an expression and returns its inferred type.
fn checkExprImpl(c: *Checker, e: ast.Expr) -> TType {
    c.currentLine = e.line
    c.currentCol = e.col
    if e.kind == ast.EX_INT { return builtinType("int") }
    if e.kind == ast.EX_FLOAT { return builtinType("float") }
    if e.kind == ast.EX_STRING { return checkStringLit(c, e) }
    if e.kind == ast.EX_BOOL { return builtinType("bool") }
    if e.kind == ast.EX_NIL { return nilType() }
    if e.kind == ast.EX_IDENT { return checkIdent(c, e) }
    if e.kind == ast.EX_PREFIX { return checkPrefixExpr(c, e) }
    if e.kind == ast.EX_INFIX { return checkInfixExpr(c, e) }
    if e.kind == ast.EX_CALL { return checkCallExpr(c, e) }
    if e.kind == ast.EX_INDEX { return checkIndexExpr(c, e) }
    if e.kind == ast.EX_FIELD { return checkFieldAccessExpr(c, e) }
    if e.kind == ast.EX_ARRAY_LIT { return checkArrayLit(c, e) }
    if e.kind == ast.EX_MAP_LIT { return checkMapLit(c, e) }
    if e.kind == ast.EX_SET_LIT { return checkSetLit(c, e) }
    if e.kind == ast.EX_STRUCT_LIT { return checkStructLit(c, e) }
    if e.kind == ast.EX_SLICE { return checkSliceExpr(c, e) }
    if e.kind == ast.EX_RANGE { return checkRangeExpr(c, e) }
    if e.kind == ast.EX_FN_LIT { return checkFnLit(c, e) }
    if e.kind == ast.EX_IF_EXPR { return checkIfExpr(c, e) }
    if e.kind == ast.EX_MATCH_EXPR { return checkMatchExpr(c, e) }
    if e.kind == ast.EX_MAKE { return checkMakeExpr(c, e) }
    if e.kind == ast.EX_SIZEOF { return builtinType("int") }
    if e.kind == ast.EX_ALIGNOF { return builtinType("int") }
    if e.kind == ast.EX_SPREAD { return checkExpr(c, e.spreadExpr[0]) }
    if e.kind == ast.EX_ERROR_PROP { return checkErrorProp(c, e) }
    if e.kind == ast.EX_NONNULL { return checkNonNullAssert(c, e) }
    if e.kind == ast.EX_AWAIT {
        if len(e.awaitExpr) == 0 {
            report(c, "await requires an expression")
            return unknownType()
        }
        it := checkExpr(c, e.awaitExpr[0])
        if it.kind == TK_NAMED && str.Equal(it.name, "future") && len(it.elem) > 0 {
            key := str.Concat(strconv.Itoa(e.line), str.Concat(":", strconv.Itoa(e.col)))
            elemT := typeOptT(it.elem)
            c.awaitElemTypes.Set(key, elemT)
            // Awaiting a void call yields the raw (null) handle value.
            if elemT.kind == TK_BUILTIN && str.Equal(elemT.name, "void") {
                return anyType()
            }
            return elemT
        }
        report(c, "await requires a future — the result of async f(...)")
        return unknownType()
    }
    if e.kind == ast.EX_ASYNC {
        if len(e.inner) == 0 || e.inner[0].kind != ast.EX_CALL {
            report(c, "async requires a function call — e.g. async f(x)")
            return unknownType()
        }
        if len(e.inner[0].callFunc) == 0 || e.inner[0].callFunc[0].kind != ast.EX_IDENT {
            report(c, "async requires a named function call — e.g. async f(x)")
            return unknownType()
        }
        inner := checkExpr(c, e.inner[0])
        if inner.kind == TK_TUPLE {
            if len(inner.tupleTypes) > 1 {
                report(c, "async calls must return a single value — return a struct or map for multiple results")
                return unknownType()
            }
            inner = voidType()
        }
        ft := TType{kind: TK_NAMED}
        ft.name = "future"
        ft.elem = singleTType(inner)
        return ft
    }
    if e.kind == ast.EX_FROM_END {
        // Check target and index expressions to mark variables as used.
        targetType := checkExpr(c, e.indexTarget[0])
        if len(e.indexExpr) > 0 {
            checkExpr(c, e.indexExpr[0])
        }
        // Return the element type of the target (same as normal indexing).
        if targetType.kind == TK_ARRAY {
            return typeOptT(targetType.elem)
        }
        return builtinType("int")
    }
    if e.kind == ast.EX_PAREN { return checkExpr(c, e.inner[0]) }
    if e.kind == ast.EX_TUPLE { return checkTupleExpr(c, e) }
    if e.kind == ast.EX_INTERP { return checkInterpExpr(c, e) }
    return unknownType()
}

// checkStringLit type-checks a string literal, marking interpolated vars.
fn checkStringLit(c: *Checker, e: ast.Expr) -> TType {
    markInterpolatedVars(c, e.strVal)
    return builtinType("string")
}

// checkIdent type-checks an identifier reference.
fn checkIdent(c: *Checker, e: ast.Expr) -> TType {
    typ := resolveWithKey(c, e.ident)
    if typ.kind == TK_UNKNOWN {
        reportAt(c, e.line, e.col, str.Concat("undefined variable: ", e.ident))
        return unknownType()
    }
    return typ
}

// checkPrefixExpr type-checks a unary prefix expression.
fn checkPrefixExpr(c: *Checker, e: ast.Expr) -> TType {
    operand := checkExpr(c, e.prefixRight[0])
    if operand.kind == TK_UNKNOWN {
        return unknownType()
    }
    if e.prefixOp == "-" { return checkNumericPrefix(c, e.prefixOp, operand) }
    if e.prefixOp == "+" { return checkNumericPrefix(c, e.prefixOp, operand) }
    if e.prefixOp == "!" { return checkBoolPrefix(c, operand) }
    if e.prefixOp == "~" { return checkIntPrefix(c, e.prefixOp, operand) }
    if e.prefixOp == "*" { return checkDerefPrefix(c, operand) }
    if e.prefixOp == "&" {
        // &m[k] is meaningless: map element slots move on rehash, and the
        // emitter treats the map pointer as an array base producing
        // invalid LLVM IR. Reject it; &a[i] on slices stays legal —
        // element addresses are stable in the backing array
        // (comp_error.md #77).
        inner := e.prefixRight[0]
        if inner.kind == ast.EX_INDEX && len(inner.indexTarget) > 0 {
            tgtT := checkExpr(c, inner.indexTarget[0])
            if tgtT.kind == TK_MAP {
                report(c, "cannot take the address of a map element")
                return unknownType()
            }
        }
        return pointerType(operand)
    }
    if e.prefixOp == "<-" {
        elemType := checkRecvPrefix(c, operand)
        if operand.kind == TK_CHAN && len(operand.elem) > 0 {
            key := str.Concat(strconv.Itoa(e.line), str.Concat(":", strconv.Itoa(e.col)))
            c.chanElemTypes.Set(key, typeOptT(operand.elem))
        }
        return elemType
    }
    return unknownType()
}

// checkNumericPrefix validates a unary +/- on a numeric operand.
fn checkNumericPrefix(c: *Checker, op: string, operand: TType) -> TType {
    if !isNumeric(operand) {
        report(c, str.Concat("unary ", str.Concat(op, str.Concat(" requires numeric operand, got ", typeString(operand)))))
        return unknownType()
    }
    return operand
}

// checkBoolPrefix validates a unary ! on a bool operand.
fn checkBoolPrefix(c: *Checker, operand: TType) -> TType {
    if !typeEquals(operand, builtinType("bool")) {
        report(c, str.Concat("! requires bool, got ", typeString(operand)))
        return unknownType()
    }
    return builtinType("bool")
}

// checkIntPrefix validates a unary ~ on an integer operand.
fn checkIntPrefix(c: *Checker, op: string, operand: TType) -> TType {
    if !isInteger(operand) {
        report(c, str.Concat("~ requires integer, got ", typeString(operand)))
        return unknownType()
    }
    return operand
}

// checkDerefPrefix validates a pointer dereference, returning the pointee type.
fn checkDerefPrefix(c: *Checker, operand: TType) -> TType {
    if operand.kind != TK_POINTER {
        report(c, str.Concat("cannot dereference non-pointer ", typeString(operand)))
        return unknownType()
    }
    return typeOptT(operand.elem)
}

// checkRecvPrefix validates a channel receive, returning the element type.
fn checkRecvPrefix(c: *Checker, operand: TType) -> TType {
    if operand.kind == TK_CHAN {
        return typeOptT(operand.elem)
    }
    report(c, str.Concat("cannot receive from non-channel ", typeString(operand)))
    return unknownType()
}

// literalExprFitsUnsignedType reports whether e is an integer literal (or
// a single const alias to one) whose value is non-negative and fits in the
// named unsigned type. It lets safe comparisons like `uint == 0` through.
fn literalExprFitsUnsignedType(c: *Checker, e: ast.Expr, unsignedName: string) -> bool {
    mag, neg, ok := intLiteralSignedValue(c, e)
    if !ok || neg { return false }
    width, _ := intTypeWidthAndSign(unsignedName)
    if width == 0 { return false }
    if width >= 64 {
        // Any non-negative value representable by the parser fits in 64 bits.
        return true
    }
    var maxUnsigned int64 = 1
    i := 0
    for i < width {
        maxUnsigned = maxUnsigned * 2
        i = i + 1
    }
    return mag <= maxUnsigned - 1
}

// checkInfixExpr type-checks a binary infix expression by operator.
fn checkInfixExpr(c: *Checker, e: ast.Expr) -> TType {
    left := checkExpr(c, e.infixLeft[0])
    right := checkExpr(c, e.infixRight[0])
    if left.kind == TK_UNKNOWN || right.kind == TK_UNKNOWN {
        return unknownType()
    }
    op := e.infixOp

    // Mixed signed/unsigned comparisons are unsafe (unsigned semantics invert
    // ordering for negative signed values). Allow them only when one operand
    // is an unsigned-compatible non-negative integer literal. The check is
    // restricted to ordering/equality operators: arithmetic and bitwise ops
    // (notably `>>`/`<<`, where a signed shift count is conventional) accept
    // mixed signedness.
    isCmp := op == "==" || op == "!=" || op == "<" || op == "<=" || op == ">" || op == ">="
    if isCmp && isInteger(left) && isInteger(right) && ((isSignedInt(left) && isUnsignedInt(right)) || (isUnsignedInt(left) && isSignedInt(right))) {
        var unsignedName string
        if isUnsignedInt(left) {
            unsignedName = left.name
        } else {
            unsignedName = right.name
        }
        if !literalExprFitsUnsignedType(c, e.infixLeft[0], unsignedName) && !literalExprFitsUnsignedType(c, e.infixRight[0], unsignedName) {
            report(c, "cannot compare signed and unsigned integer operands without explicit cast")
            return unknownType()
        }
    }

    // Set operations take priority over bitwise/arithmetic
    if str.Equal(op, "&") || str.Equal(op, "|") || str.Equal(op, "-") {
        if left.kind == TK_SET && right.kind == TK_SET {
            leftElem := typeOptT(left.elem)
            rightElem := typeOptT(right.elem)
            if !typeEquals(leftElem, rightElem) {
                report(c, str.Concat("set operation ", str.Concat(op, str.Concat(" requires matching element types, got ", str.Concat(typeString(leftElem), str.Concat(" and ", typeString(rightElem)))))))
                return unknownType()
            }
            return left
        }
    }

    if op == "+" { return checkAdd(c, left, right) }
    if op == "-" { return checkArith(c, op, left, right) }
    if op == "*" { return checkArith(c, op, left, right) }
    if op == "/" { return checkArith(c, op, left, right) }
    if op == "%" { return checkArith(c, op, left, right) }
    if op == "**" { return checkPower(c, left, right) }
    if op == "<" { return checkComparison(c, op, left, right) }
    if op == ">" { return checkComparison(c, op, left, right) }
    if op == "<=" { return checkComparison(c, op, left, right) }
    if op == ">=" { return checkComparison(c, op, left, right) }
    if op == "==" { return checkEquality(c, op, left, right) }
    if op == "!=" { return checkEquality(c, op, left, right) }
    if op == "&&" { return checkLogical(c, op, left, right) }
    if op == "||" { return checkLogical(c, op, left, right) }
    if op == "in" { return checkInOp(c, left, right) }
    if op == "&" { return checkBitwise(c, op, left, right) }
    if op == "|" { return checkBitwise(c, op, left, right) }
    if op == "^" { return checkBitwise(c, op, left, right) }
    if op == "<<" { return checkBitwise(c, op, left, right) }
    if op == ">>" { return checkBitwise(c, op, left, right) }
    if op == "@" { return checkMatmul(c, left, right) }
    if op == "<-" { return checkChannelSend(c, left, right) }
    return unknownType()
}

// checkAdd type-checks the + operator (string concat, pointer arith, arithmetic).
fn checkAdd(c: *Checker, left: TType, right: TType) -> TType {
    if typeEquals(left, builtinType("string")) && typeEquals(right, builtinType("string")) {
        return builtinType("string")
    }
    if left.kind == TK_POINTER && isInteger(right) {
        return left
    }
    if right.kind == TK_POINTER && isInteger(left) {
        return right
    }
    return checkArith(c, "+", left, right)
}

// checkArith type-checks arithmetic operators on numeric operands.
fn checkArith(c: *Checker, op: string, left: TType, right: TType) -> TType {
    if !isNumeric(left) || !isNumeric(right) {
        report(c, str.Concat("operator ", str.Concat(op, str.Concat(" requires numeric operands, got ", str.Concat(typeString(left), str.Concat(" and ", typeString(right)))))))
        return unknownType()
    }
    if typeEquals(left, builtinType("float")) || typeEquals(right, builtinType("float")) {
        return builtinType("float")
    }
    return left
}

// checkPower type-checks the ** operator on numeric operands.
fn checkPower(c: *Checker, left: TType, right: TType) -> TType {
    if !isNumeric(left) || !isNumeric(right) {
        report(c, "** requires numeric operands")
        return unknownType()
    }
    if typeEquals(left, builtinType("float")) || typeEquals(right, builtinType("float")) {
        return builtinType("float")
    }
    return left
}

// checkComparison type-checks ordering comparisons on numeric or string operands.
fn checkComparison(c: *Checker, op: string, left: TType, right: TType) -> TType {
    if !isNumeric(left) || !isNumeric(right) {
        if !typeEquals(left, builtinType("string")) || !typeEquals(right, builtinType("string")) {
            report(c, str.Concat("comparison requires numeric or string operands, got ", str.Concat(typeString(left), str.Concat(" and ", typeString(right)))))
            return unknownType()
        }
    }
    return builtinType("bool")
}

// checkEquality type-checks == and != comparisons including nil checks.
fn checkEquality(c: *Checker, op: string, left: TType, right: TType) -> TType {
    if isNumeric(left) && isNumeric(right) {
        return builtinType("bool")
    }
    if left.kind == TK_NIL || right.kind == TK_NIL {
        if left.kind == TK_NIL && right.kind == TK_NIL {
            return builtinType("bool")
        }
        var nonNil TType
        if left.kind == TK_NIL {
            nonNil = right
        } else {
            nonNil = left
        }
        if nonNil.kind == TK_ERROR || (nonNil.kind == TK_BUILTIN && str.Equal(nonNil.name, "string")) {
            return builtinType("bool")
        }
        // Allow nil comparison for named struct types that have a
        // `message: string` field (e.g. errors.Error). The emitter
        // handles this by comparing the message field to null.
        if nonNil.kind == TK_NAMED {
            sd := c.structs.Get(nonNil.name)
            if sd.kind != 0 {
                for fi := 0; fi < len(sd.structFields); fi = fi + 1 {
                    if str.Equal(sd.structFields[fi].name, "message") {
                        return builtinType("bool")
                    }
                }
            }
        }
        if nonNil.kind == TK_POINTER || nonNil.kind == TK_ARRAY || nonNil.kind == TK_CHAN || nonNil.kind == TK_MAP || nonNil.kind == TK_FUNCTION || nonNil.kind == TK_ANY {
            return builtinType("bool")
        }
        report(c, str.Concat("cannot compare ", str.Concat(typeString(nonNil), " with nil")))
        return unknownType()
    }
    if !typeEquals(left, right) {
        report(c, str.Concat("cannot compare ", str.Concat(typeString(left), str.Concat(" with ", typeString(right)))))
        return unknownType()
    }
    // Struct-by-value equality compiles to an address/identity compare —
    // two identical structs compare unequal. Reject it; pointer equality
    // (*T == *T) stays legal and meaningful (comp_error.md #81).
    if left.kind == TK_NAMED {
        sd := c.structs.Get(left.name)
        if sd.kind != 0 {
            report(c, str.Concat("cannot compare struct values with ", str.Concat(op, "; compare fields individually or compare pointers")))
            return unknownType()
        }
    }
    return builtinType("bool")
}

// checkLogical type-checks && and || on bool operands.
fn checkLogical(c: *Checker, op: string, left: TType, right: TType) -> TType {
    if !typeEquals(left, builtinType("bool")) || !typeEquals(right, builtinType("bool")) {
        report(c, str.Concat("logical operator ", str.Concat(op, " requires bool operands")))
        return unknownType()
    }
    return builtinType("bool")
}

// checkInOp type-checks the `in` set-membership operator.
fn checkInOp(c: *Checker, left: TType, right: TType) -> TType {
    if right.kind == TK_SET {
        leftElem := typeOptT(right.elem)
        if !typeEquals(left, leftElem) {
            report(c, str.Concat("cannot check membership of ", str.Concat(typeString(left), str.Concat(" in set<", str.Concat(typeString(leftElem), ">")))))
            return unknownType()
        }
        return builtinType("bool")
    }
    report(c, str.Concat("'in' requires a set on the right side, got ", typeString(right)))
    return unknownType()
}

// checkBitwise type-checks bitwise operators on integer operands.
fn checkBitwise(c: *Checker, op: string, left: TType, right: TType) -> TType {
    if !isInteger(left) || !isInteger(right) {
        report(c, str.Concat("bitwise operator ", str.Concat(op, " requires integer operands")))
        return unknownType()
    }
    return left
}

// checkMatmul type-checks the @ matrix-multiply operator on tensors.
fn checkMatmul(c: *Checker, left: TType, right: TType) -> TType {
    if left.kind != TK_TENSOR {
        report(c, str.Concat("operator @ requires tensor operands, got ", typeString(left)))
        return unknownType()
    }
    if right.kind != TK_TENSOR {
        report(c, str.Concat("operator @ requires tensor operands, got ", typeString(right)))
        return unknownType()
    }
    return left
}

// checkChannelSend type-checks a channel send (ch <- val) operation.
fn checkChannelSend(c: *Checker, left: TType, right: TType) -> TType {
    if left.kind != TK_CHAN {
        report(c, str.Concat("cannot send on non-channel ", typeString(left)))
        return unknownType()
    }
    chElem := typeOptT(left.elem)
    if !typeEquals(chElem, right) {
        report(c, str.Concat("cannot send ", str.Concat(typeString(right), str.Concat(" on channel of ", typeString(chElem)))))
        return unknownType()
    }
    return voidType()
}

// substituteType replaces generic type parameters in a TType with concrete types.
// paramMap maps type parameter names (e.g. "K", "V", "T") to their concrete TType.
fn substituteType(t: TType, paramMap: map[string]TType) -> TType {
    if t.kind == TK_NAMED {
        concrete := paramMap[t.name]
        if concrete.kind != 0 {
            return concrete
        }
        // Also substitute inside generic args on the named type
        if len(t.genericArgs) > 0 {
            result := t
            var newArgs []TType
            for i := 0; i < len(t.genericArgs); i = i + 1 {
                newArgs = append(newArgs, substituteType(t.genericArgs[i], paramMap))
            }
            result.genericArgs = newArgs
            return result
        }
        return t
    }
    if t.kind == TK_POINTER {
        inner := substituteType(typeOptT(t.elem), paramMap)
        return pointerType(inner)
    }
    if t.kind == TK_ARRAY {
        inner := substituteType(typeOptT(t.elem), paramMap)
        return arrayType(inner)
    }
    if t.kind == TK_MAP {
        k := substituteType(typeOptT(t.keyType), paramMap)
        v := substituteType(typeOptT(t.elem), paramMap)
        return mapType(k, v)
    }
    if t.kind == TK_CHAN {
        return chanType(substituteType(typeOptT(t.elem), paramMap))
    }
    if t.kind == TK_SET {
        return setType(substituteType(typeOptT(t.elem), paramMap))
    }
    if t.kind == TK_FUNCTION {
        newParams := make([]TType, 0)
        for i := 0; i < len(t.params); i = i + 1 {
            newParams = append(newParams, substituteType(t.params[i], paramMap))
        }
        newRets := make([]TType, 0)
        for i := 0; i < len(t.retTypes); i = i + 1 {
            newRets = append(newRets, substituteType(t.retTypes[i], paramMap))
        }
        ft := functionType(newParams, newRets)
        ft.variadic = t.variadic
        return ft
    }
    if t.kind == TK_TUPLE {
        newTypes := make([]TType, 0)
        for i := 0; i < len(t.tupleTypes); i = i + 1 {
            newTypes = append(newTypes, substituteType(t.tupleTypes[i], paramMap))
        }
        return tupleType(newTypes)
    }
    return t
}

// buildGenericSubstMap builds a substitution map from a function's generic
// type parameters to the concrete types provided at the call site.
fn buildGenericSubstMap(c: *Checker, fnDecl: ast.Decl, genericArgs: []ast.Type) -> map[string]TType {
    paramMap := make(map[string]TType)
    n := len(fnDecl.fnGenerics)
    if n > len(genericArgs) {
        n = len(genericArgs)
    }
    for i := 0; i < n; i = i + 1 {
        concrete := astTypeToType(c, genericArgs[i])
        paramMap[fnDecl.fnGenerics[i].name] = concrete
    }
    return paramMap
}

// applyGenericSubst looks up a function declaration by name, builds a
// substitution map from its generic params to the call's generic args, and
// returns a new function type with the substitution applied.
fn applyGenericSubst(c: *Checker, fnName: string, fnType: TType, genericArgs: []ast.Type) -> TType {
    if len(genericArgs) == 0 {
        return fnType
    }
    fnDecl := genericFnDecl(c, fnName)
    if fnDecl.kind == 0 {
        return fnType
    }
    if len(fnDecl.fnGenerics) == 0 {
        return fnType
    }
    // Explicit type args must match the declared generic arity —
    // previously extras were silently ignored (comp_error.md #90).
    if len(genericArgs) != len(fnDecl.fnGenerics) {
        report(c, str.Concat("generic function \"", str.Concat(fnName, str.Concat("\" expects ", str.Concat(itoa(len(fnDecl.fnGenerics)), str.Concat(" type argument(s), got ", itoa(len(genericArgs))))))))
        return fnType
    }
    paramMap := buildGenericSubstMap(c, fnDecl, genericArgs)
    checkGenericErasureSafety(c, fnDecl, paramMap)
    return substituteType(fnType, paramMap)
}

// isErasureSafeType reports whether a concrete type keeps the uniform
// i8* representation generic code assumes. Type erasure lowers every
// type parameter to i8*, so a composite []T/map[K]V instantiation is
// only correct when the substituted element type is pointer-sized —
// the generic body indexes the backing store with an 8-byte stride
// (comp_error.md #36).
fn isErasureSafeType(c: *Checker, t: TType) -> bool {
    if t.kind == TK_BUILTIN {
        // string/bytes/any are i8*; the numeric and bool builtins have
        // narrower erased representations (i32, double, i1, ...).
        return str.Equal(t.name, "string") || str.Equal(t.name, "bytes") || str.Equal(t.name, "any")
    }
    if t.kind == TK_NAMED {
        // future<T> handles are opaque i8*.
        if str.Equal(t.name, "future") {
            return true
        }
        resolved := resolveAlias(c, t)
        if resolved.kind != TK_NAMED {
            return isErasureSafeType(c, resolved)
        }
        // A named type backed by a struct declaration erases to a
        // %struct value — wider than i8* and unsafe in erased
        // composites. Other named types are opaque pointers.
        return c.structs.Get(t.name).kind == 0
    }
    // Struct/union/aggregate values are wider than i8*; everything else
    // (pointers, slices, maps, sets, chans, tensors, functions, any,
    // nil) is already a single pointer.
    return t.kind != TK_ERROR && t.kind != TK_TAGGED_UNION && t.kind != TK_TUPLE
}

// checkErasureType walks a pre-substitution param/return type and
// validates every erased composite element slot.
fn checkErasureType(c: *Checker, t: TType, paramMap: map[string]TType) {
    if t.kind == TK_ARRAY {
        checkErasureElem(c, typeOptT(t.elem), paramMap)
        return
    }
    if t.kind == TK_MAP {
        checkErasureElem(c, typeOptT(t.keyType), paramMap)
        checkErasureElem(c, typeOptT(t.elem), paramMap)
    }
}

// checkErasureElem validates one composite element slot: when the slot
// holds a generic type parameter its concrete substitution must be
// pointer-sized; nested composites ([][]T, map[string][]T) recurse.
fn checkErasureElem(c: *Checker, t: TType, paramMap: map[string]TType) {
    if t.kind == TK_NAMED && paramMap[t.name].kind != 0 {
        concrete := paramMap[t.name]
        if !isErasureSafeType(c, concrete) {
            report(c, str.Concat("generic parameter ", str.Concat(t.name,
                str.Concat(" instantiated with non-pointer-sized type ",
                    str.Concat(typeString(concrete),
                        " — erased composite generics ([]T, map[K]V) require pointer-sized element types")))))
        }
        return
    }
    checkErasureType(c, t, paramMap)
}

// checkGenericErasureSafety rejects generic instantiations where a type
// parameter substituted into a composite element position resolves to a
// non-pointer-sized concrete type. Under type erasure the generic body
// reads and writes such elements with a uniform i8* stride, so the call
// would silently corrupt data — a clean error beats bad codegen until
// call-site reboxing or monomorphization lands (comp_error.md #36).
fn checkGenericErasureSafety(c: *Checker, fnDecl: ast.Decl, paramMap: map[string]TType) {
    for i := 0; i < len(fnDecl.fnParams); i = i + 1 {
        if len(fnDecl.fnParams[i].typ) > 0 {
            checkErasureType(c, astTypeToType(c, fnDecl.fnParams[i].typ[0]), paramMap)
        }
    }
    for i := 0; i < len(fnDecl.fnRetTypes); i = i + 1 {
        checkErasureType(c, astTypeToType(c, fnDecl.fnRetTypes[i]), paramMap)
    }
}

// genericFnDecl finds the declaration of a possibly-generic function.
// The resolver qualifies top-level names with their owning module
// ("idOf" → "sometest.idOf"), so an unqualified call-site name must be
// looked up under the current module as well as verbatim — otherwise
// generic calls in non-main modules silently skip substitution and
// report "expected T" mismatches.
fn genericFnDecl(c: *Checker, fnName: string) -> ast.Decl {
    fnDecl := c.fnDecls.Get(fnName)
    if fnDecl.kind == 0 && str.Len(c.currentModule) > 0 && !str.Contains(fnName, ".") {
        fnDecl = c.fnDecls.Get(str.Concat(str.Concat(c.currentModule, "."), fnName))
    }
    return fnDecl
}

// isGenericParamName reports whether name is one of the declaration's
// generic type parameters (e.g. "T" in `fn TypeOf<T>(v: T)`).
fn isGenericParamName(fnDecl: ast.Decl, name: string) -> bool {
    for i := 0; i < len(fnDecl.fnGenerics); i = i + 1 {
        if str.Equal(fnDecl.fnGenerics[i].name, name) {
            return true
        }
    }
    return false
}

// inferGenericSubst infers generic type arguments from the call's argument
// types when no explicit <T> list was written — e.g. `TypeOf(0)` binds
// T=int. Returns the substituted function type.
fn inferGenericSubst(c: *Checker, fnName: string, fnType: TType, args: []ast.Expr) -> (TType, []TType) {
    // checked[i] records the type of args[i] when this pass already
    // checked it, so checkCallArgsWithTypes can reuse it instead of
    // re-checking. Without reuse, every nested generic call like
    // id(id(id(x))) is checked twice per level — O(2^N) total
    // (comp_error.md #31).
    checked := []TType{}
    for i := 0; i < len(args); i = i + 1 {
        checked = append(checked, TType{})
    }
    fnDecl := genericFnDecl(c, fnName)
    if fnDecl.kind == 0 || len(fnDecl.fnGenerics) == 0 {
        return fnType, checked
    }
    paramMap := make(map[string]TType)
    n := len(fnType.params)
    if len(args) < n {
        n = len(args)
    }
    for i := 0; i < n; i = i + 1 {
        pt := fnType.params[i]
        if pt.kind == TK_NAMED && isGenericParamName(fnDecl, pt.name) {
            if paramMap[pt.name].kind == 0 {
                at := checkExpr(c, args[i])
                checked[i] = at
                if at.kind != TK_UNKNOWN {
                    paramMap[pt.name] = at
                }
            }
        }
        if pt.kind == TK_ARRAY && len(pt.elem) > 0 {
            et := typeOptT(pt.elem)
            if et.kind == TK_NAMED && isGenericParamName(fnDecl, et.name) {
                if paramMap[et.name].kind == 0 {
                    at := checkExpr(c, args[i])
                    checked[i] = at
                    if at.kind == TK_ARRAY && len(at.elem) > 0 {
                        paramMap[et.name] = typeOptT(at.elem)
                    }
                }
            }
        }
    }
    if len(paramMap) == 0 {
        return fnType, checked
    }
    checkGenericErasureSafety(c, fnDecl, paramMap)
    return substituteType(fnType, paramMap), checked
}

// checkCallExpr type-checks a function call, including builtins and generics.
fn checkCallExpr(c: *Checker, e: ast.Expr) -> TType {
    if e.callFunc[0].kind == ast.EX_IDENT && str.Equal(e.callFunc[0].ident, "len") {
        if len(e.callArgs) != 1 {
            report(c, str.Concat("len() takes exactly 1 argument, got ", itoa(len(e.callArgs))))
            return builtinType("int")
        }
        argType := checkExpr(c, e.callArgs[0])
        if argType.kind != TK_UNKNOWN &&
            argType.kind != TK_ARRAY && argType.kind != TK_MAP &&
            argType.kind != TK_SET && argType.kind != TK_CHAN &&
            !typeEquals(argType, builtinType("string")) {
            report(c, str.Concat("len() requires a slice, map, set, channel, or string, got ", typeString(argType)))
        }
        return builtinType("int")
    }
    if e.callFunc[0].kind == ast.EX_IDENT && str.Equal(e.callFunc[0].ident, "close") {
        if len(e.callArgs) != 1 {
            report(c, str.Concat("close() takes exactly 1 argument, got ", itoa(len(e.callArgs))))
            return voidType()
        }
        argType := checkExpr(c, e.callArgs[0])
        if argType.kind != TK_UNKNOWN && argType.kind != TK_CHAN {
            report(c, str.Concat("close() requires a channel, got ", typeString(argType)))
        }
        return voidType()
    }
    if e.callFunc[0].kind == ast.EX_IDENT && str.Equal(e.callFunc[0].ident, "delete") {
        if len(e.callArgs) == 1 {
            // delete(x): release a heap-allocated value.
            checkExpr(c, e.callArgs[0])
            return voidType()
        }
        if len(e.callArgs) == 2 {
            // delete(m, k): remove key k from map m.
            mapType := checkExpr(c, e.callArgs[0])
            if mapType.kind != TK_UNKNOWN && mapType.kind != TK_MAP {
                report(c, str.Concat("delete() with two arguments requires a map, got ", typeString(mapType)))
            }
            keyType := checkExpr(c, e.callArgs[1])
            if mapType.kind == TK_MAP && len(mapType.keyType) > 0 && keyType.kind != TK_UNKNOWN {
                wantKey := typeOptT(mapType.keyType)
                if !isAssignable(wantKey, keyType) && !typeEquals(wantKey, keyType) {
                    report(c, str.Concat("delete() key type mismatch: expected ", str.Concat(typeString(wantKey), str.Concat(", got ", typeString(keyType)))))
                }
            }
            return voidType()
        }
        report(c, str.Concat("delete() takes 1 or 2 arguments, got ", itoa(len(e.callArgs))))
        return voidType()
    }
    if e.callFunc[0].kind == ast.EX_IDENT && isBuiltinTypeName(e.callFunc[0].ident) {
        return checkTypeCast(c, e)
    }
    if e.callFunc[0].kind == ast.EX_IDENT && str.Equal(e.callFunc[0].ident, "append") {
        return checkAppendCall(c, e)
    }
    if e.callFunc[0].kind == ast.EX_IDENT && str.Equal(e.callFunc[0].ident, "copy") {
        return checkCopyCall(c, e)
    }
    if e.callFunc[0].kind == ast.EX_IDENT && str.Equal(e.callFunc[0].ident, "panic") {
        return checkPanicCall(c, e)
    }
    if e.callFunc[0].kind == ast.EX_IDENT && str.Equal(e.callFunc[0].ident, "recover") {
        return builtinType("string")
    }
    if e.callFunc[0].kind == ast.EX_FIELD {
        return checkMethodCall(c, e)
    }
    fnType := checkExpr(c, e.callFunc[0])
    if fnType.kind == TK_UNKNOWN {
        return unknownType()
    }
    if fnType.kind != TK_FUNCTION {
        reportAt(c, e.line, e.col, str.Concat("cannot call non-function ", typeString(fnType)))
        return unknownType()
    }
    // Apply generic type substitution if generic args are present
    if e.callFunc[0].kind == ast.EX_IDENT && len(e.genericArgs) > 0 {
        fnType = applyGenericSubst(c, e.callFunc[0].ident, fnType, e.genericArgs)
    } else if e.callFunc[0].kind == ast.EX_IDENT {
        var preChecked []TType
        fnType, preChecked = inferGenericSubst(c, e.callFunc[0].ident, fnType, e.callArgs)
        // Args already checked during inference must not be re-checked —
        // that second pass is what made nested generic calls exponential.
        return checkCallArgsWithTypes(c, e, fnType, false, preChecked)
    }
    return checkCallArgs(c, e, fnType, false)
}

// checkTypeCast type-checks a builtin type conversion (cast) expression.
fn checkTypeCast(c: *Checker, e: ast.Expr) -> TType {
    castName := e.callFunc[0].ident
    castType := lookupType(castName)
    if castType.kind == TK_UNKNOWN {
        return castType
    }
    if len(e.callArgs) != 1 {
        report(c, str.Concat("type cast requires exactly 1 argument, got ", itoa(len(e.callArgs))))
        return castType
    }
    argType := checkExpr(c, e.callArgs[0])
    if argType.kind == TK_UNKNOWN {
        return castType
    }
    if isNumeric(castType) && isNumeric(argType) {
        return castType
    }
    if typeEquals(castType, builtinType("bool")) && (isInteger(argType) || typeEquals(argType, builtinType("float"))) {
        return castType
    }
    if (isInteger(castType) || typeEquals(castType, builtinType("float"))) && typeEquals(argType, builtinType("bool")) {
        return castType
    }
    if isInteger(castType) && argType.kind == TK_POINTER {
        return castType
    }
    if castType.kind == TK_POINTER {
        if isInteger(argType) || argType.kind == TK_POINTER || argType.kind == TK_NIL {
            return castType
        }
    }
    if typeEquals(castType, builtinType("string")) && typeEquals(argType, builtinType("bytes")) {
        return castType
    }
    if typeEquals(castType, builtinType("bytes")) && typeEquals(argType, builtinType("string")) {
        return castType
    }
    if (typeEquals(castType, builtinType("string")) || typeEquals(castType, builtinType("bytes"))) && isInteger(argType) {
        return castType
    }
    if isInteger(castType) && (typeEquals(argType, builtinType("string")) || typeEquals(argType, builtinType("bytes"))) {
        return castType
    }
    report(c, str.Concat("cannot cast ", str.Concat(typeString(argType), str.Concat(" to ", typeString(castType)))))
    return castType
}

// checkAppendCall type-checks an append() builtin call.
fn checkAppendCall(c: *Checker, e: ast.Expr) -> TType {
    if len(e.callArgs) < 2 {
        report(c, str.Concat("append() takes at least 2 arguments, got ", itoa(len(e.callArgs))))
        return unknownType()
    }
    arrType := checkExpr(c, e.callArgs[0])
    // Handle spread: append(slice, anotherSlice...)
    if e.callArgs[1].kind == ast.EX_SPREAD {
        if len(e.callArgs) != 2 {
            report(c, "append with spread (...) takes exactly 2 arguments")
            return unknownType()
        }
        spreadType := checkExpr(c, e.callArgs[1].spreadExpr[0])
        if arrType.kind == TK_ARRAY && spreadType.kind == TK_ARRAY {
            arrElem := typeOptT(arrType.elem)
            spreadElem := typeOptT(spreadType.elem)
            if !typeEquals(arrElem, spreadElem) && arrElem.kind != TK_ANY && spreadElem.kind != TK_ANY {
                report(c, str.Concat("append spread type mismatch: expected []", str.Concat(typeString(arrElem), str.Concat(", got []", typeString(spreadElem)))))
            }
            return arrType
        }
        return arrType
    }
    // Variadic: every extra argument must match the element type.
    for i := 1; i < len(e.callArgs); i = i + 1 {
        valType := checkExpr(c, e.callArgs[i])
        if arrType.kind == TK_ARRAY {
            arrElem := typeOptT(arrType.elem)
            if !typeEquals(arrElem, valType) && valType.kind != TK_ANY && arrElem.kind != TK_ANY {
                // Integer literals are compatible with any integer element type
                // (e.g. append([]uint8{}, 9)), matching Go-style untyped-constant
                // behaviour for the common slice literal / append idiom.
                isIntLit := e.callArgs[i].kind == ast.EX_INT
                if !(isIntLit && isInteger(arrElem) && typeEquals(valType, builtinType("int"))) {
                    report(c, str.Concat("append value type mismatch: expected ", str.Concat(typeString(arrElem), str.Concat(", got ", typeString(valType)))))
                }
            }
        }
    }
    if arrType.kind == TK_ARRAY {
        return arrType
    }
    report(c, str.Concat("append requires an array as first argument, got ", typeString(arrType)))
    return unknownType()
}

// checkCopyCall type-checks a copy() builtin call.
fn checkCopyCall(c: *Checker, e: ast.Expr) -> TType {
    if len(e.callArgs) != 1 {
        report(c, str.Concat("copy() takes exactly 1 argument, got ", itoa(len(e.callArgs))))
        return unknownType()
    }
    argType := checkExpr(c, e.callArgs[0])
    if argType.kind != TK_ARRAY && argType.kind != TK_MAP && argType.kind != TK_ANY {
        report(c, str.Concat("copy() requires a slice or map argument, got ", typeString(argType)))
    }
    return argType
}

// checkPanicCall type-checks a panic() builtin call.
fn checkPanicCall(c: *Checker, e: ast.Expr) -> TType {
    if len(e.callArgs) != 1 {
        report(c, str.Concat("panic() takes exactly 1 argument, got ", itoa(len(e.callArgs))))
        return voidType()
    }
    argType := checkExpr(c, e.callArgs[0])
    if argType.kind != TK_UNKNOWN && !typeEquals(argType, builtinType("string")) {
        report(c, str.Concat("panic() argument must be string, got ", typeString(argType)))
    }
    return voidType()
}

// checkMethodCall type-checks a method call (receiver.method or module.func).
fn checkMethodCall(c: *Checker, e: ast.Expr) -> TType {
    fa := e.callFunc[0]
    // Handle module-qualified top-level function call
    if fa.fieldTarget[0].kind == ast.EX_IDENT {
        ident := fa.fieldTarget[0]
        moduleName := resolveImportAlias(c, ident.ident)
        isModuleName := false
        if str.Len(c.currentModule) > 0 {
            cm := c.currentModule
        imps := c.imports.Get(cm)
            if len(imps) > 0 {
                ii := 0
                for ii < len(imps) {
                    if str.Equal(imps[ii], ident.ident) {
                        isModuleName = true
                        break
                    }
                    ii = ii + 1
                }
            }
        }
        if !isModuleName {
            fqName := str.Concat(str.Concat(moduleName, "."), fa.fieldName)
            exactType := resolveWithKey(c, fqName)
            if exactType.kind != TK_UNKNOWN {
                isModuleName = true
            }
        }
        if isModuleName {
            markImportUsed(c, ident.ident)
            fqName := str.Concat(str.Concat(moduleName, "."), fa.fieldName)
            typ := resolve(c, fqName)
            if typ.kind == TK_UNKNOWN {
                typ = resolve(c, fa.fieldName)
            }
            if typ.kind != TK_UNKNOWN {
                if typ.kind != TK_FUNCTION {
                    report(c, str.Concat("cannot call non-function ", typeString(typ)))
                    return unknownType()
                }
                // Apply generic type substitution for module-qualified generic calls
                if len(e.genericArgs) > 0 {
                    fqNameForSubst := str.Concat(str.Concat(moduleName, "."), fa.fieldName)
                    typ = applyGenericSubst(c, fqNameForSubst, typ, e.genericArgs)
                    return checkCallArgs(c, e, typ, false)
                }
                var preChecked []TType
                typ, preChecked = inferGenericSubst(c, fqName, typ, e.callArgs)
                return checkCallArgsWithTypes(c, e, typ, false, preChecked)
            }
            report(c, str.Concat("module \"", str.Concat(moduleName, str.Concat("\" has no exported symbol \"", str.Concat(fa.fieldName, "\"")))))
            return unknownType()
        }
    }

    recvType := checkExpr(c, fa.fieldTarget[0])
    if recvType.kind == TK_UNKNOWN {
        return unknownType()
    }
    if recvType.kind == TK_SERVICE {
        return checkServiceMethodCall(c, e, recvType, fa.fieldName)
    }
    if recvType.kind == TK_RULESET {
        fnType := resolve(c, str.Concat(str.Concat(recvType.name, "."), fa.fieldName))
        if fnType.kind == TK_UNKNOWN {
            report(c, str.Concat("unknown method \"", str.Concat(fa.fieldName, str.Concat("\" on ruleset \"", str.Concat(recvType.name, "\"")))))
            return unknownType()
        }
        return checkCallArgs(c, e, fnType, false)
    }
    if recvType.kind == TK_TEMPLATE {
        return checkTemplateMethodCall(c, e, recvType, fa.fieldName)
    }
    if recvType.kind == TK_INTERFACE || recvType.kind == TK_ERROR {
        return checkInterfaceMethodCall(c, e, recvType, fa.fieldName)
    }

    var structName string
    if recvType.kind == TK_NAMED {
        structName = recvType.name
    } else if recvType.kind == TK_POINTER {
        inner := typeOptT(recvType.elem)
        if inner.kind == TK_NAMED {
            structName = inner.name
        }
    }
    var fnType TType
    if str.Len(structName) > 0 {
        fnType = resolve(c, str.Concat(str.Concat(structName, "."), fa.fieldName))
    }
    if fnType.kind == TK_UNKNOWN && str.Contains(structName, ".") {
        // Try the unqualified struct name too — methods are registered
        // under the name the struct decl carried at registration time,
        // which may be unqualified when the defining module was loaded
        // transitively.
        parts := splitOnLastDot(structName)
        fnType = resolve(c, str.Concat(str.Concat(parts[1], "."), fa.fieldName))
    }
    if fnType.kind == TK_UNKNOWN && !str.Contains(structName, ".") && str.Len(c.currentModule) > 0 {
        // Try current-module qualification — structs in the same module
        // are registered under "module.Type" but receiver types may carry
        // the short name.
        fnType = resolve(c, str.Concat(str.Concat(str.Concat(c.currentModule, "."), structName), str.Concat(".", fa.fieldName)))
    }
    if fnType.kind == TK_UNKNOWN {
        fnType = resolve(c, fa.fieldName)
    }
    if fnType.kind == TK_UNKNOWN && str.Len(structName) > 0 {
        // The "method" may be a fn-typed struct field: h.f(args) calls
        // the closure handle stored in the field rather than a
        // registered method. Type-check args against the field's
        // signature; the emitter routes these through the indirect
        // closure-call path.
        decl := c.structs.Get(structName)
        if decl.kind != 0 {
            for i := 0; i < len(decl.structFields); i = i + 1 {
                if str.Equal(decl.structFields[i].name, fa.fieldName) && len(decl.structFields[i].typ) > 0 {
                    fieldType := resolveAlias(c, astTypeToType(c, decl.structFields[i].typ[0]))
                    if fieldType.kind == TK_FUNCTION {
                        // Record the field access's type so the emitter's
                        // exprSkinkType routes the call through the
                        // indirect closure-call path.
                        if !c.suppressExprTypes && fa.line > 0 {
                            key := str.Concat(c.currentFile, str.Concat(" ", str.Concat(strconv.Itoa(fa.line), str.Concat(":", strconv.Itoa(fa.col)))))
                            c.exprTypes.Set(key, fieldType)
                        }
                        return checkCallArgs(c, e, fieldType, false)
                    }
                }
            }
        }
    }
    if fnType.kind == TK_UNKNOWN {
        report(c, str.Concat("unknown method \"", str.Concat(fa.fieldName, str.Concat("\" on type ", typeString(recvType)))))
        return unknownType()
    }
    if fnType.kind != TK_FUNCTION {
        reportAt(c, e.line, e.col, str.Concat("cannot call non-function ", typeString(fnType)))
        return unknownType()
    }
    // Apply generic type substitution for methods on generic structs.
    // If the receiver type has genericArgs (e.g. HashMap<int, int>), and the
    // struct declaration has structGenerics (e.g. <K, V>), build a substitution
    // map and apply it to the method's function type.
    if str.Len(structName) > 0 {
        structDecl := c.structs.Get(structName)
        if structDecl.kind != 0 {
            if len(structDecl.structGenerics) > 0 {
                // Determine the receiver's generic args
                var recvGenericArgs []TType
                if recvType.kind == TK_NAMED {
                    recvGenericArgs = recvType.genericArgs
                } else if recvType.kind == TK_POINTER {
                    inner := typeOptT(recvType.elem)
                    if inner.kind == TK_NAMED {
                        recvGenericArgs = inner.genericArgs
                    }
                }
                if len(recvGenericArgs) > 0 {
                    paramMap := make(map[string]TType)
                    n := len(structDecl.structGenerics)
                    if n > len(recvGenericArgs) {
                        n = len(recvGenericArgs)
                    }
                    for i := 0; i < n; i = i + 1 {
                        paramMap[structDecl.structGenerics[i].name] = recvGenericArgs[i]
                    }
                    fnType = substituteType(fnType, paramMap)
                }
            }
        }
    }
    isStaticCall := false
    if str.Len(structName) > 0 {
        hasStruct := c.structs.Get(structName).kind != 0
        if hasStruct && fa.fieldTarget[0].kind == ast.EX_IDENT {
            hasVar := false
            for i := c.scopeDepth; i >= 0; i = i - 1 {
                b := c.scopes[i].bindings.Get(fa.fieldTarget[0].ident)
                if b.typ.kind == 0 && i == 0 && str.Len(c.currentModule) > 0 && !str.Equal(c.currentModule, "main") {
                    // Module-level vars in non-main modules are
                    // registered under the module-qualified name
                    // (comp_error.md #86) — without this probe, method
                    // calls on globals are misclassified as static
                    // Type.Method() calls and self is wrongly counted.
                    b = c.scopes[0].bindings.Get(str.Concat(str.Concat(c.currentModule, "."), fa.fieldTarget[0].ident))
                }
                if b.typ.kind != 0 {
                    // Distinguish a type-name binding (static call like
                    // Type.Method()) from a variable of named type
                    // (method call like v.Method()). A type binding's
                    // TType name matches the identifier itself (possibly
                    // module-qualified); a variable's does not.
                    isTypeBinding := false
                    if b.typ.kind == TK_NAMED || b.typ.kind == TK_TEMPLATE || b.typ.kind == TK_TAGGED_UNION {
                        if str.Equal(b.typ.name, fa.fieldTarget[0].ident) ||
                            str.EndsWith(b.typ.name, str.Concat(".", fa.fieldTarget[0].ident)) {
                            isTypeBinding = true
                        }
                    }
                    if !isTypeBinding {
                        hasVar = true
                    }
                    break
                }
            }
            if !hasVar {
                isStaticCall = true
            }
        }
    }
    if isStaticCall {
        return checkCallArgs(c, e, fnType, false)
    }
    return checkCallArgs(c, e, fnType, true)
}

// checkServiceMethodCall type-checks a method call on a service type.
fn checkServiceMethodCall(c: *Checker, e: ast.Expr, svcType: TType, methodName: string) -> TType {
    for i := 0; i < len(svcType.methodNames); i = i + 1 {
        if str.Equal(svcType.methodNames[i], methodName) {
            return checkCallArgs(c, e, svcType.methodTypes[i], false)
        }
    }
    report(c, str.Concat("unknown method \"", str.Concat(methodName, str.Concat("\" on service \"", str.Concat(svcType.name, "\"")))))
    return unknownType()
}

// checkTemplateMethodCall type-checks a method call on a template type.
fn checkTemplateMethodCall(c: *Checker, e: ast.Expr, tmplType: TType, methodName: string) -> TType {
    tmpl := c.templates.Get(tmplType.name)
    if tmpl.kind == 0 && str.Len(c.currentModule) > 0 && !str.Contains(tmplType.name, ".") {
        qualified := str.Concat(c.currentModule, str.Concat(".", tmplType.name))
        qualifiedTmpl := c.templates.Get(qualified)
        if qualifiedTmpl.kind != 0 {
            tmpl = qualifiedTmpl
        }
    }
    if tmpl.kind == 0 {
        report(c, str.Concat("unknown template type ", typeString(tmplType)))
        return unknownType()
    }
    for i := 0; i < len(tmpl.templateMethods); i = i + 1 {
        if str.Equal(tmpl.templateMethods[i].fnName, methodName) {
            ft := fnTypeFromDecl(c, tmpl.templateMethods[i])
            return checkCallArgs(c, e, ft, true)
        }
    }
    report(c, str.Concat("template ", str.Concat(typeString(tmplType), str.Concat(" has no method \"", str.Concat(methodName, "\"")))))
    return unknownType()
}

// checkInterfaceMethodCall type-checks a method call on an interface type.
fn checkInterfaceMethodCall(c: *Checker, e: ast.Expr, ifaceType: TType, methodName: string) -> TType {
    for i := 0; i < len(ifaceType.methodNames); i = i + 1 {
        if str.Equal(ifaceType.methodNames[i], methodName) {
            return checkCallArgs(c, e, ifaceType.methodTypes[i], true)
        }
    }
    report(c, str.Concat("interface has no method \"", str.Concat(methodName, "\"")))
    return unknownType()
}

// checkCallArgs validates call arguments against a function type's parameters.
fn checkCallArgs(c: *Checker, e: ast.Expr, fnType: TType, skipReceiver: bool) -> TType {
    return checkCallArgsWithTypes(c, e, fnType, skipReceiver, []TType{})
}

// checkCallArgsWithTypes is checkCallArgs with a hint table: when
// preChecked[i].kind != 0 the argument at index i was already type-checked
// (by generic inference) and its recorded type is reused instead of
// re-running checkExpr — re-checking nested generic calls made
// id(id(id(x)))-style expressions cost O(2^N) (comp_error.md #31).
fn checkCallArgsWithTypes(c: *Checker, e: ast.Expr, fnType: TType, skipReceiver: bool, preChecked: []TType) -> TType {
    paramStart := 0
    if skipReceiver {
        paramStart = 1
    }
    numParams := len(fnType.params) - paramStart
    minArgs := numParams
    if fnType.variadic {
        minArgs = minArgs - 1
    }
    if len(e.callArgs) < minArgs {
        if fnType.variadic {
            report(c, str.Concat("wrong number of arguments: expected at least ", str.Concat(itoa(minArgs), str.Concat(", got ", itoa(len(e.callArgs))))))
        } else {
            report(c, str.Concat("wrong number of arguments: expected ", str.Concat(itoa(numParams), str.Concat(", got ", itoa(len(e.callArgs))))))
        }
        return unknownType()
    }
    if !fnType.variadic && len(e.callArgs) > numParams {
        report(c, str.Concat("wrong number of arguments: expected ", str.Concat(itoa(numParams), str.Concat(", got ", itoa(len(e.callArgs))))))
        return unknownType()
    }
    for i := 0; i < len(e.callArgs); i = i + 1 {
        var argType TType
        if i < len(preChecked) && preChecked[i].kind != 0 {
            argType = preChecked[i]
        } else {
            argType = checkExpr(c, e.callArgs[i])
        }
        paramIdx := paramStart + i
        if paramIdx < len(fnType.params) {
            if !checkerIsAssignable(c, fnType.params[paramIdx], argType) {
                report(c, str.Concat("argument ", str.Concat(itoa(i + 1), str.Concat(" type mismatch: expected ", str.Concat(typeString(fnType.params[paramIdx]), str.Concat(", got ", typeString(argType)))))))
            }
            checkIntLitFits(c, e.callArgs[i], fnType.params[paramIdx])
        }
    }
    if len(fnType.retTypes) == 1 {
        return fnType.retTypes[0]
    }
    return tupleType(fnType.retTypes)
}

// checkIndexExpr type-checks an index expression (array, map, string, pointer).
fn checkIndexExpr(c: *Checker, e: ast.Expr) -> TType {
    leftType := checkExpr(c, e.indexTarget[0])
    indexType := checkExpr(c, e.indexExpr[0])
    if leftType.kind == TK_UNKNOWN {
        return unknownType()
    }
    if leftType.kind == TK_ARRAY {
        if indexType.kind != TK_UNKNOWN && !isInteger(indexType) {
            report(c, str.Concat("array index must be integer, got ", typeString(indexType)))
        }
        return typeOptT(leftType.elem)
    }
    if leftType.kind == TK_MAP {
        keyType := typeOptT(leftType.keyType)
        if indexType.kind != TK_UNKNOWN && !typeEquals(keyType, indexType) && !checkerIsAssignable(c, keyType, indexType) {
            report(c, str.Concat("map key type mismatch: expected ", str.Concat(typeString(keyType), str.Concat(", got ", typeString(indexType)))))
        }
        return typeOptT(leftType.elem)
    }
    if leftType.kind == TK_POINTER {
        if indexType.kind != TK_UNKNOWN && !isInteger(indexType) {
            report(c, str.Concat("pointer index must be integer, got ", typeString(indexType)))
        }
        return typeOptT(leftType.elem)
    }
    if leftType.kind == TK_BUILTIN && str.Equal(leftType.name, "string") {
        if indexType.kind != TK_UNKNOWN && !isInteger(indexType) {
            report(c, str.Concat("string index must be integer, got ", typeString(indexType)))
        }
        return builtinType("int")
    }
    // Indexing a generic function usually means the writer used
    // f[T](args) where the generic-call form f<T>(args) was meant —
    // give that hint instead of the opaque "cannot index" (#122).
    if leftType.kind == TK_FUNCTION && e.indexTarget[0].kind == ast.EX_IDENT {
        fnDecl := genericFnDecl(c, e.indexTarget[0].ident)
        if fnDecl.kind != 0 && len(fnDecl.fnGenerics) > 0 {
            name := e.indexTarget[0].ident
            report(c, str.Concat(str.Concat("cannot index generic function \"", str.Concat(name, "\" — generic arguments use <...>, e.g. ")), str.Concat(name, "<T>(...)")))
            return unknownType()
        }
    }
    report(c, str.Concat("cannot index type ", typeString(leftType)))
    return unknownType()
}

// checkSliceExpr type-checks a slice expression (a[low:high]).
fn checkSliceExpr(c: *Checker, e: ast.Expr) -> TType {
    leftType := checkExpr(c, e.sliceTarget[0])
    if len(e.sliceLow) > 0 {
        startType := checkExpr(c, e.sliceLow[0])
        if startType.kind != TK_UNKNOWN && !isInteger(startType) {
            report(c, str.Concat("slice start must be integer, got ", typeString(startType)))
        }
    }
    if len(e.sliceHigh) > 0 {
        endType := checkExpr(c, e.sliceHigh[0])
        if endType.kind != TK_UNKNOWN && !isInteger(endType) {
            report(c, str.Concat("slice end must be integer, got ", typeString(endType)))
        }
    }
    if leftType.kind == TK_ARRAY {
        return leftType
    }
    if leftType.kind == TK_BUILTIN && str.Equal(leftType.name, "string") {
        return builtinType("string")
    }
    if leftType.kind == TK_UNKNOWN {
        return unknownType()
    }
    report(c, str.Concat("cannot slice type ", typeString(leftType)))
    return unknownType()
}

// checkRangeExpr type-checks a range expression (low..high).
fn checkRangeExpr(c: *Checker, e: ast.Expr) -> TType {
    startType := checkExpr(c, e.rangeLow[0])
    endType := checkExpr(c, e.rangeHigh[0])
    if startType.kind != TK_UNKNOWN && !isInteger(startType) {
        report(c, str.Concat("range start must be integer, got ", typeString(startType)))
    }
    if endType.kind != TK_UNKNOWN && !isInteger(endType) {
        report(c, str.Concat("range end must be integer, got ", typeString(endType)))
    }
    return arrayType(builtinType("int"))
}

// checkArrayLit type-checks an array/slice literal. A declared element type
// ([]T{...}) takes precedence over inference so that []uint8{1,2,3} is a
// []uint8, not []int (comp_error.md #26). Integer literals are allowed to
// satisfy any integer-typed target like Go-style untyped constants.
fn checkArrayLit(c: *Checker, e: ast.Expr) -> TType {
    var expected TType
    hasExpected := false
    if len(e.arrayType) > 0 {
        expected = astTypeToType(c, e.arrayType[0])
        hasExpected = expected.kind != 0 && expected.kind != TK_UNKNOWN
    }
    if len(e.arrayElems) == 0 {
        if hasExpected {
            return arrayType(expected)
        }
        return arrayType(anyType())
    }
    var firstType TType
    for i := 0; i < len(e.arrayElems); i = i + 1 {
        elem := e.arrayElems[i]
        if elem.kind == ast.EX_SPREAD {
            spreadType := checkExpr(c, elem.spreadExpr[0])
            if spreadType.kind != TK_ARRAY {
                report(c, str.Concat("spread operand must be an array, got ", typeString(spreadType)))
                if firstType.kind == 0 {
                    firstType = anyType()
                }
                continue
            }
            arrElem := typeOptT(spreadType.elem)
            if hasExpected {
                if !typeEquals(expected, arrElem) {
                    report(c, str.Concat("spread element type mismatch: expected ", str.Concat(typeString(expected), str.Concat(", got ", typeString(arrElem)))))
                }
            } else if firstType.kind == 0 {
                firstType = arrElem
            } else if !typeEquals(firstType, arrElem) {
                report(c, str.Concat("spread element type mismatch: expected ", str.Concat(typeString(firstType), str.Concat(", got ", typeString(arrElem)))))
            }
            continue
        }
        elemType := checkExpr(c, elem)
        if hasExpected {
            if !typeEquals(expected, elemType) {
                isIntLit := elem.kind == ast.EX_INT || (elem.kind == ast.EX_PREFIX && len(elem.prefixRight) > 0 && elem.prefixRight[0].kind == ast.EX_INT)
                if !(isIntLit && isInteger(expected) && typeEquals(elemType, builtinType("int"))) {
                    report(c, str.Concat("array element ", str.Concat(itoa(i + 1), str.Concat(" type mismatch: expected ", str.Concat(typeString(expected), str.Concat(", got ", typeString(elemType)))))))
                }
            }
            checkIntLitFits(c, elem, expected)
            continue
        }
        if firstType.kind == 0 {
            firstType = elemType
        } else if !typeEquals(firstType, elemType) {
            report(c, str.Concat("array element ", str.Concat(itoa(i + 1), str.Concat(" type mismatch: expected ", str.Concat(typeString(firstType), str.Concat(", got ", typeString(elemType)))))))
        }
    }
    if hasExpected {
        return arrayType(expected)
    }
    if firstType.kind == 0 {
        firstType = anyType()
    }
    return arrayType(firstType)
}

// checkMapLit type-checks a map literal, unifying key and value types.
fn checkMapLit(c: *Checker, e: ast.Expr) -> TType {
    if len(e.mapKeys) == 0 {
        return mapType(anyType(), anyType())
    }
    firstKeyType := checkExpr(c, e.mapKeys[0])
    firstValType := checkExpr(c, e.mapVals[0])
    for i := 1; i < len(e.mapKeys); i = i + 1 {
        keyType := checkExpr(c, e.mapKeys[i])
        valType := checkExpr(c, e.mapVals[i])
        if !typeEquals(firstKeyType, keyType) {
            report(c, str.Concat("map key ", str.Concat(itoa(i + 1), str.Concat(" type mismatch: expected ", str.Concat(typeString(firstKeyType), str.Concat(", got ", typeString(keyType)))))))
        }
        if !typeEquals(firstValType, valType) {
            report(c, str.Concat("map value ", str.Concat(itoa(i + 1), str.Concat(" type mismatch: expected ", str.Concat(typeString(firstValType), str.Concat(", got ", typeString(valType)))))))
        }
    }
    return mapType(firstKeyType, firstValType)
}

// checkSetLit type-checks a set literal, unifying element types.
fn checkSetLit(c: *Checker, e: ast.Expr) -> TType {
    if len(e.setElems) == 0 {
        return setType(anyType())
    }
    firstType := checkExpr(c, e.setElems[0])
    for i := 1; i < len(e.setElems); i = i + 1 {
        elemType := checkExpr(c, e.setElems[i])
        if !typeEquals(firstType, elemType) {
            report(c, str.Concat("set element ", str.Concat(itoa(i + 1), str.Concat(" type mismatch: expected ", str.Concat(typeString(firstType), str.Concat(", got ", typeString(elemType)))))))
        }
    }
    return setType(firstType)
}

// checkStructLit type-checks a struct literal, validating field names and types.
fn checkStructLit(c: *Checker, e: ast.Expr) -> TType {
    structName := e.structLitName
    // Mark import as used for qualified struct literals (e.g. streams.LimitReader{...})
    if str.Contains(structName, ".") {
        parts := splitOnFirstDot(structName)
        markImportUsed(c, parts[0])
    }
    if str.Len(c.currentModule) > 0 && !str.Equal(c.currentModule, "main") && !str.Contains(structName, ".") {
        qualified := str.Concat(str.Concat(c.currentModule, "."), structName)
        if c.structs.Get(qualified).kind != 0 {
            structName = qualified
            e.structLitName = qualified
        }
    }
    if str.Len(c.currentModule) > 0 && !str.Contains(structName, ".") {
        cm := c.currentModule
        imps := c.imports.Get(cm)
        if len(imps) > 0 {
            ii := 0
            for ii < len(imps) {
                impName := imps[ii]
                qualified := str.Concat(str.Concat(impName, "."), structName)
                if c.structs.Get(qualified).kind != 0 {
                    structName = qualified
                    e.structLitName = qualified
                    break
                }
                ii = ii + 1
            }
        }
    }
    decl := c.structs.Get(structName)
    if decl.kind == 0 {
        return namedType(structName)
    }
    // Generic struct literals (e.g. Stack<int>{items: []int{}}) must
    // substitute the literal's type args into the declared field types
    // before comparing — otherwise []T never matches []int (comp_error.md #112).
    var litParamMap map[string]TType
    if len(e.genericArgs) > 0 && len(decl.structGenerics) > 0 {
        litParamMap = make(map[string]TType)
        gn := len(decl.structGenerics)
        if gn > len(e.genericArgs) {
            gn = len(e.genericArgs)
        }
        for gi := 0; gi < gn; gi = gi + 1 {
            litParamMap[decl.structGenerics[gi].name] = astTypeToType(c, e.genericArgs[gi])
        }
    }
    for i := 0; i < len(e.structLitFields); i = i + 1 {
        fieldName := e.structLitFields[i].name
        found := false
        for j := 0; j < len(decl.structFields); j = j + 1 {
            if str.Equal(decl.structFields[j].name, fieldName) {
                found = true
                if len(e.structLitFields[i].value) > 0 && len(decl.structFields[j].typ) > 0 {
                    ft := astTypeToType(c, decl.structFields[j].typ[0])
                    if len(litParamMap) > 0 {
                        ft = substituteType(ft, litParamMap)
                    }
                    vt := checkExpr(c, e.structLitFields[i].value[0])
                    if ft.kind != TK_UNKNOWN && vt.kind != TK_UNKNOWN && !checkerIsAssignable(c, ft, vt) {
                        report(c, str.Concat("field \"", str.Concat(fieldName, str.Concat("\" type mismatch: expected ", str.Concat(typeString(ft), str.Concat(", got ", typeString(vt)))))))
                    }
                    checkIntLitFits(c, e.structLitFields[i].value[0], ft)
                }
                break
            }
        }
        if !found {
            report(c, str.Concat("unknown field \"", str.Concat(fieldName, str.Concat("\" in struct init for \"", str.Concat(structName, "\"")))))
        }
    }
    result := namedType(structName)
    if len(e.genericArgs) > 0 {
        var gargs []TType
        for i := 0; i < len(e.genericArgs); i = i + 1 {
            gargs = append(gargs, astTypeToType(c, e.genericArgs[i]))
        }
        result.genericArgs = gargs
    }
    return result
}

// checkFieldAccessExpr type-checks a field access (struct field or module symbol).
fn checkFieldAccessExpr(c: *Checker, e: ast.Expr) -> TType {
    if e.fieldTarget[0].kind == ast.EX_IDENT {
        ident := e.fieldTarget[0]
        moduleName := resolveImportAlias(c, ident.ident)
        isModuleName := false
        if str.Len(c.currentModule) > 0 {
            cm := c.currentModule
        imps := c.imports.Get(cm)
            if len(imps) > 0 {
                ii := 0
                for ii < len(imps) {
                    if str.Equal(imps[ii], ident.ident) {
                        isModuleName = true
                        break
                    }
                    ii = ii + 1
                }
            }
        }
        if !isModuleName {
            fqName := str.Concat(str.Concat(moduleName, "."), e.fieldName)
            exactType := resolveWithKey(c, fqName)
            if exactType.kind != TK_UNKNOWN {
                isModuleName = true
            }
        }
        if isModuleName {
            markImportUsed(c, ident.ident)
            fqName := str.Concat(str.Concat(moduleName, "."), e.fieldName)
            typ := resolve(c, fqName)
            if typ.kind != TK_UNKNOWN {
                return typ
            }
            typ = resolve(c, e.fieldName)
            if typ.kind != TK_UNKNOWN {
                return typ
            }
            report(c, str.Concat("module \"", str.Concat(moduleName, str.Concat("\" has no exported symbol \"", str.Concat(e.fieldName, "\"")))))
            return unknownType()
        }
    }

    leftType := checkExpr(c, e.fieldTarget[0])
    if leftType.kind == TK_UNKNOWN {
        return unknownType()
    }
    if leftType.kind == TK_ERROR {
        for i := 0; i < len(leftType.methodNames); i = i + 1 {
            if str.Equal(leftType.methodNames[i], e.fieldName) {
                return leftType.methodTypes[i]
            }
        }
        report(c, str.Concat("error interface has no method \"", str.Concat(e.fieldName, "\"")))
        return unknownType()
    }
    if leftType.kind == TK_TENSOR {
        if str.Equal(e.fieldName, "T") {
            return leftType
        }
        report(c, str.Concat("tensor type has no property \"", str.Concat(e.fieldName, "\"")))
        return unknownType()
    }
    if leftType.kind == TK_SERVICE {
        for i := 0; i < len(leftType.methodNames); i = i + 1 {
            if str.Equal(leftType.methodNames[i], e.fieldName) {
                return leftType.methodTypes[i]
            }
        }
        report(c, str.Concat("service \"", str.Concat(leftType.name, str.Concat("\" has no method \"", str.Concat(e.fieldName, "\"")))))
        return unknownType()
    }
    if leftType.kind == TK_RULESET {
        fnType := resolve(c, str.Concat(str.Concat(leftType.name, "."), e.fieldName))
        if fnType.kind != TK_UNKNOWN {
            return fnType
        }
        report(c, str.Concat("ruleset \"", str.Concat(leftType.name, str.Concat("\" has no method \"", str.Concat(e.fieldName, "\"")))))
        return unknownType()
    }
    if leftType.kind == TK_TEMPLATE {
        tmpl := c.templates.Get(leftType.name)
        if tmpl.kind == 0 {
            report(c, str.Concat("unknown template type ", typeString(leftType)))
            return unknownType()
        }
        for i := 0; i < len(tmpl.templateMethods); i = i + 1 {
            if str.Equal(tmpl.templateMethods[i].fnName, e.fieldName) {
                return fnTypeFromDecl(c, tmpl.templateMethods[i])
            }
        }
        report(c, str.Concat("template ", str.Concat(typeString(leftType), str.Concat(" has no method \"", str.Concat(e.fieldName, "\"")))))
        return unknownType()
    }

    var structName string
    if leftType.kind == TK_NAMED {
        structName = leftType.name
    } else if leftType.kind == TK_POINTER {
        inner := typeOptT(leftType.elem)
        if inner.kind == TK_NAMED {
            structName = inner.name
        }
    }
    if str.Len(structName) == 0 {
        report(c, str.Concat("cannot access field on non-struct type ", typeString(leftType)))
        return unknownType()
    }
    decl := c.structs.Get(structName)
    if decl.kind == 0 {
        report(c, str.Concat("unknown struct type \"", str.Concat(structName, "\"")))
        return unknownType()
    }
    // Generic struct instances carry their type args on the receiver type
    // (e.g. Stack<int>). Field lookups must substitute the declared type
    // params — otherwise s.items reports []T instead of []int (#112).
    var fieldParamMap map[string]TType
    if len(decl.structGenerics) > 0 {
        var recvArgs []TType
        if leftType.kind == TK_NAMED {
            recvArgs = leftType.genericArgs
        } else if leftType.kind == TK_POINTER {
            recvArgs = typeOptT(leftType.elem).genericArgs
        }
        if len(recvArgs) > 0 {
            fieldParamMap = make(map[string]TType)
            gn := len(decl.structGenerics)
            if gn > len(recvArgs) {
                gn = len(recvArgs)
            }
            for gi := 0; gi < gn; gi = gi + 1 {
                fieldParamMap[decl.structGenerics[gi].name] = recvArgs[gi]
            }
        }
    }
    for i := 0; i < len(decl.structFields); i = i + 1 {
        if str.Equal(decl.structFields[i].name, e.fieldName) {
            if len(decl.structFields[i].typ) > 0 {
                ft := astTypeToType(c, decl.structFields[i].typ[0])
                if len(fieldParamMap) > 0 {
                    ft = substituteType(ft, fieldParamMap)
                }
                return ft
            }
            return unknownType()
        }
    }
    for i := 0; i < len(decl.structMethods); i = i + 1 {
        if str.Equal(decl.structMethods[i].fnName, e.fieldName) {
            // Method calls (x.m()) are handled by checkMethodCall, so
            // reaching here means the method name is being used as a
            // value — which would resolve to the unbound function
            // taking an explicit receiver. Bound method values are not
            // supported; reject clearly (comp_error.md #79).
            report(c, str.Concat("method value \"", str.Concat(e.fieldName, "\" is not supported (bound methods do not exist); call it directly or wrap it in a fn literal")))
            return unknownType()
        }
    }
    report(c, str.Concat("struct \"", str.Concat(structName, str.Concat("\" has no field \"", str.Concat(e.fieldName, "\"")))))
    return unknownType()
}

// resolveFieldType resolves the type of a field access expression (EX_FIELD)
// without reporting errors. Used by the emitter to determine channel element
// types for receive operations on struct fields.
pub fn resolveFieldType(c: *Checker, e: ast.Expr) -> TType {
    if e.kind != ast.EX_FIELD {
        return unknownType()
    }
    if len(e.fieldTarget) == 0 {
        return unknownType()
    }
    // Suppress exprTypes recording — this runs at emit time with stale
    // checker state, and the results must not overwrite real entries.
    c.suppressExprTypes = true
    leftType := checkExpr(c, e.fieldTarget[0])
    c.suppressExprTypes = false
    if leftType.kind == TK_UNKNOWN {
        return unknownType()
    }
    var structName string
    if leftType.kind == TK_NAMED {
        structName = leftType.name
    } else if leftType.kind == TK_POINTER {
        inner := typeOptT(leftType.elem)
        if inner.kind == TK_NAMED {
            structName = inner.name
        }
    }
    if str.Len(structName) == 0 {
        return unknownType()
    }
    decl := c.structs.Get(structName)
    if decl.kind == 0 {
        return unknownType()
    }
    var fieldParamMap map[string]TType
    if len(decl.structGenerics) > 0 {
        var recvArgs []TType
        if leftType.kind == TK_NAMED {
            recvArgs = leftType.genericArgs
        } else if leftType.kind == TK_POINTER {
            recvArgs = typeOptT(leftType.elem).genericArgs
        }
        if len(recvArgs) > 0 {
            fieldParamMap = make(map[string]TType)
            gn := len(decl.structGenerics)
            if gn > len(recvArgs) {
                gn = len(recvArgs)
            }
            for gi := 0; gi < gn; gi = gi + 1 {
                fieldParamMap[decl.structGenerics[gi].name] = recvArgs[gi]
            }
        }
    }
    for i := 0; i < len(decl.structFields); i = i + 1 {
        if str.Equal(decl.structFields[i].name, e.fieldName) {
            if len(decl.structFields[i].typ) > 0 {
                ft := astTypeToType(c, decl.structFields[i].typ[0])
                if len(fieldParamMap) > 0 {
                    ft = substituteType(ft, fieldParamMap)
                }
                return ft
            }
            return unknownType()
        }
    }
    return unknownType()
}

// chanElemTypeLookup returns the element type for a <-ch expression
// at the given line:col, or a zero TType (kind == 0) if not found.
pub fn chanElemTypeLookup(c: *Checker, line: int, col: int) -> TType {
    key := str.Concat(strconv.Itoa(line), str.Concat(":", strconv.Itoa(col)))
    return c.chanElemTypes.Get(key)
}

// exprTypeLookup returns the recorded checker type of the expression at
// file:line:col, or a zero TType (kind == 0) if not found.
pub fn exprTypeLookup(c: *Checker, file: string, line: int, col: int) -> TType {
    key := str.Concat(file, str.Concat(" ", str.Concat(strconv.Itoa(line), str.Concat(":", strconv.Itoa(col)))))
    return c.exprTypes.Get(key)
}

// exprTypeLookupAt returns the recorded type of the idx-th interpolation
// part of the interpolated-string expression at file line:col.
// checkInterpExpr records part types under this "file line:col#idx" key
// because sub-parsed part exprs carry fragment-relative positions that
// would collide across parts.
pub fn exprTypeLookupAt(c: *Checker, file: string, line: int, col: int, idx: int) -> TType {
    key := str.Concat(file, str.Concat(" ", str.Concat(strconv.Itoa(line), str.Concat(":", str.Concat(strconv.Itoa(col), str.Concat("#", strconv.Itoa(idx)))))))
    return c.exprTypes.Get(key)
}

// checkFnLit type-checks a function literal (anonymous function).
fn checkFnLit(c: *Checker, e: ast.Expr) -> TType {
    params := make([]TType, 0)
    for i := 0; i < len(e.fnLitParams); i = i + 1 {
        pt := unknownType()
        if len(e.fnLitParams[i].typ) > 0 {
            pt = astTypeToType(c, e.fnLitParams[i].typ[0])
        }
        params = append(params, pt)
    }
    var ret TType
    ret = voidType()
    if len(e.fnLitRetTypes) > 0 {
        ret = astTypeToType(c, e.fnLitRetTypes[0])
    }
    var fnRets []TType
    fnRets = append(fnRets, ret)
    fnType := functionType(params, fnRets)
    oldFn := c.currentFn
    c.currentFn = singleTType(fnType)
    // Function literals may freely reference enclosing locals — the
    // emitter turns them into closures (comp_error.md #20).
    pushScope(c)
    for i := 0; i < len(e.fnLitParams); i = i + 1 {
        pt := unknownType()
        if len(e.fnLitParams[i].typ) > 0 {
            pt = astTypeToType(c, e.fnLitParams[i].typ[0])
        }
        declareParam(c, e.fnLitParams[i].name, pt)
    }
    checkBlockStmt(c, e.fnLitBody)
    popScope(c)
    c.currentFn = oldFn
    return fnType
}

// checkIfExpr type-checks an if expression, unifying branch types.
fn checkIfExpr(c: *Checker, e: ast.Expr) -> TType {
    if len(e.ifCond) > 0 {
        condType := checkExpr(c, e.ifCond[0])
        if condType.kind != TK_UNKNOWN && !typeEquals(condType, builtinType("bool")) {
            report(c, str.Concat("if condition must be bool, got ", typeString(condType)))
        }
    }
    trueType := checkExpr(c, e.ifThen[0])
    if len(e.ifElse) > 0 {
        falseType := checkExpr(c, e.ifElse[0])
        if trueType.kind == TK_UNKNOWN {
            return falseType
        }
        if falseType.kind == TK_UNKNOWN {
            return trueType
        }
        if !typeEquals(trueType, falseType) {
            report(c, str.Concat("if expression branches have different types: ", str.Concat(typeString(trueType), str.Concat(" and ", typeString(falseType)))))
        }
        return trueType
    }
    return trueType
}

// checkMatchExpr type-checks a match expression, unifying arm result types.
fn checkMatchExpr(c: *Checker, e: ast.Expr) -> TType {
    var subjectType TType
    if len(e.matchExprSubject) > 0 {
        subjectType = checkExpr(c, e.matchExprSubject[0])
    }
    var resultType TType
    hasWildcard := false
    for i := 0; i < len(e.matchExprArms); i = i + 1 {
        arm := e.matchExprArms[i]
        if arm.isWildcard {
            hasWildcard = true
        }
        if arm.pattern.kind == ast.PK_VARIANT && subjectType.kind == TK_TAGGED_UNION {
            variant := findVariant(subjectType, arm.pattern.variantName)
            if variant.name == "" {
                report(c, str.Concat("match variant \"", str.Concat(arm.pattern.variantName, str.Concat("\" does not exist in enum \"", str.Concat(subjectType.name, "\"")))))
            } else {
                if len(variant.payloadType) > 0 && len(arm.pattern.bindings) > 0 {
                    pushScope(c)
                    for j := 0; j < len(arm.pattern.bindings); j = j + 1 {
                        if j < len(variant.payloadType) {
                            declare(c, arm.pattern.bindings[j], variant.payloadType[j])
                        } else {
                            declare(c, arm.pattern.bindings[j], variant.payloadType[0])
                        }
                    }
                }
            }
        }
        if len(arm.guard) > 0 {
            guardType := checkExpr(c, arm.guard[0])
            if guardType.kind != TK_UNKNOWN && !typeEquals(guardType, builtinType("bool")) {
                report(c, str.Concat("match guard must be bool, got ", typeString(guardType)))
            }
        }
        armType := blockLastExprType(c, arm.body)
        if arm.pattern.kind == ast.PK_VARIANT && subjectType.kind == TK_TAGGED_UNION {
            variant := findVariant(subjectType, arm.pattern.variantName)
            if variant.name != "" && len(variant.payloadType) > 0 && len(arm.pattern.bindings) > 0 {
                popScope(c)
            }
        }
        if i == 0 {
            resultType = armType
        } else if resultType.kind != TK_UNKNOWN && armType.kind != TK_UNKNOWN && !typeEquals(resultType, armType) {
            if !typeEquals(resultType, voidType()) && !typeEquals(armType, voidType()) {
                report(c, str.Concat("match arm ", str.Concat(itoa(i + 1), str.Concat(" has different type ", str.Concat(typeString(armType), str.Concat(" (expected ", str.Concat(typeString(resultType), ")")))))))
            }
        }
    }
    if !hasWildcard && subjectType.kind == TK_TAGGED_UNION {
        covered := make(map[string]bool)
        for i := 0; i < len(e.matchExprArms); i = i + 1 {
            if e.matchExprArms[i].pattern.kind == ast.PK_VARIANT {
                covered[e.matchExprArms[i].pattern.variantName] = true
            }
            // Bare variant pattern (no payload parens): `RegEmpty => ...`
            if e.matchExprArms[i].pattern.kind == ast.PK_IDENT {
                idName := e.matchExprArms[i].pattern.identName
                if findVariant(subjectType, idName).name != "" {
                    covered[idName] = true
                }
            }
        }
        allCovered := true
        for i := 0; i < len(subjectType.variants); i = i + 1 {
            if !covered[subjectType.variants[i].name] {
                allCovered = false
                break
            }
        }
        if !allCovered {
            report(c, str.Concat("match expression on enum \"", str.Concat(subjectType.name, "\" must have a wildcard (_) arm or cover all variants")))
        }
    } else if !hasWildcard {
        report(c, "match expression must have a wildcard (_) arm")
    }
    key := str.Concat(itoa(e.line), str.Concat(":", itoa(e.col)))
    c.matchResultTypes.Set(key, resultType)
    return resultType
}

// blockLastExprType returns the type of the last expression in a statement block.
fn blockLastExprType(c: *Checker, stmts: []ast.Stmt) -> TType {
    if len(stmts) == 0 {
        return voidType()
    }
    for i := 0; i < len(stmts) - 1; i = i + 1 {
        checkStatement(c, stmts[i])
    }
    last := stmts[len(stmts) - 1]
    if last.kind == ast.ST_EXPR && len(last.expr) > 0 {
        return checkExpr(c, last.expr[0])
    }
    checkStatement(c, last)
    return voidType()
}

// checkMakeExpr type-checks a make() expression, returning the constructed type.
fn checkMakeExpr(c: *Checker, e: ast.Expr) -> TType {
    if len(e.makeType) > 0 {
        return astTypeToType(c, e.makeType[0])
    }
    return unknownType()
}

// isErrorLike reports whether t can act as an error value: either the
// builtin error type or a named struct carrying a `message` field (the
// convention errors.Error follows).
fn isErrorLike(c: *Checker, t: TType) -> bool {
    if typeEquals(t, errorType()) {
        return true
    }
    if t.kind == TK_NAMED {
        sd := c.structs.Get(t.name)
        if sd.kind != 0 {
            for fi := 0; fi < len(sd.structFields); fi = fi + 1 {
                if str.Equal(sd.structFields[fi].name, "message") {
                    return true
                }
            }
        }
    }
    return false
}

// checkErrorProp type-checks the ? error-propagation operator on a call.
fn checkErrorProp(c: *Checker, e: ast.Expr) -> TType {
    if e.postfixTarget[0].kind != ast.EX_CALL {
        report(c, "? can only be applied to function calls")
        return unknownType()
    }
    if len(c.currentFn) == 0 {
        report(c, "? can only be used inside a function that returns an error")
        return unknownType()
    }
    fnType := typeOptT(c.currentFn)
    if len(fnType.retTypes) == 0 {
        report(c, "? can only be used inside a function that returns an error")
        return unknownType()
    }
    lastRet := fnType.retTypes[len(fnType.retTypes) - 1]
    if !isErrorLike(c, lastRet) {
        report(c, "? requires the enclosing function to return an error as its last value")
        return unknownType()
    }
    call := e.postfixTarget[0]
    calleeFnType := checkExpr(c, call.callFunc[0])
    if calleeFnType.kind == TK_UNKNOWN {
        return unknownType()
    }
    if calleeFnType.kind != TK_FUNCTION {
        report(c, "? can only be applied to function calls")
        return unknownType()
    }
    if len(calleeFnType.retTypes) < 2 {
        report(c, "? requires a function that returns multiple values with error as the last")
        return unknownType()
    }
    lastCalleeRet := calleeFnType.retTypes[len(calleeFnType.retTypes) - 1]
    if !isErrorLike(c, lastCalleeRet) {
        report(c, str.Concat("? requires the callee to return an error as the last value, got ", typeString(lastCalleeRet)))
        return unknownType()
    }
    if len(calleeFnType.retTypes) == 2 {
        return calleeFnType.retTypes[0]
    }
    var rest []TType
    for i := 0; i < len(calleeFnType.retTypes) - 1; i = i + 1 {
        rest = append(rest, calleeFnType.retTypes[i])
    }
    return tupleType(rest)
}

// checkNonNullAssert type-checks the ! non-null assertion on a pointer.
fn checkNonNullAssert(c: *Checker, e: ast.Expr) -> TType {
    innerType := checkExpr(c, e.postfixTarget[0])
    if innerType.kind == TK_UNKNOWN {
        return unknownType()
    }
    if innerType.kind != TK_POINTER {
        report(c, str.Concat("! can only be applied to pointer types, got ", typeString(innerType)))
        return unknownType()
    }
    return typeOptT(innerType.elem)
}

// checkTupleExpr type-checks a tuple expression, returning a tuple type.
fn checkTupleExpr(c: *Checker, e: ast.Expr) -> TType {
    types := []TType{}
    for i := 0; i < len(e.tupleElems); i = i + 1 {
        types = append(types, checkExpr(c, e.tupleElems[i]))
    }
    return tupleType(types)
}

// checkInterpExpr type-checks an interpolated string expression.
// Each expression part is checked for validity. The result is always
// string type.
fn checkInterpExpr(c: *Checker, e: ast.Expr) -> TType {
    for i := 0; i < len(e.interpParts); i = i + 1 {
        part := e.interpParts[i]
        if part.isExpr {
            t := checkExpr(c, part.expr[0])
            // Part exprs are sub-parsed from the literal text, so their
            // line:col are fragment-relative and collide across parts.
            // Record each under the string's real position + "#index".
            if t.kind != 0 && t.kind != TK_UNKNOWN && e.line > 0 {
                key := str.Concat(c.currentFile, str.Concat(" ", str.Concat(strconv.Itoa(e.line), str.Concat(":", str.Concat(strconv.Itoa(e.col), str.Concat("#", strconv.Itoa(i)))))))
                c.exprTypes.Set(key, t)
            }
        }
    }
    return builtinType("string")
}

// === Flow Analysis ===

// stmtAlwaysReturnsBlock reports whether any statement in a block always returns.
fn stmtAlwaysReturnsBlock(c: *Checker, stmts: []ast.Stmt) -> bool {
    for i := 0; i < len(stmts); i = i + 1 {
        if stmtAlwaysReturns(c, stmts[i]) {
            return true
        }
    }
    return false
}

// stmtAlwaysReturns reports whether a statement always transfers control.
fn stmtAlwaysReturns(c: *Checker, stmt: ast.Stmt) -> bool {
    if stmt.kind == ast.ST_RETURN || stmt.kind == ast.ST_BREAK || stmt.kind == ast.ST_CONTINUE {
        return true
    }
    if stmt.kind == ast.ST_BLOCK {
        return stmtAlwaysReturnsBlock(c, stmt.thenBody)
    }
    if stmt.kind == ast.ST_IF {
        if len(stmt.elseBody) == 0 {
            return false
        }
        if !stmtAlwaysReturnsBlock(c, stmt.thenBody) {
            return false
        }
        for i := 0; i < len(stmt.elseBody); i = i + 1 {
            if !stmtAlwaysReturns(c, stmt.elseBody[i]) {
                return false
            }
        }
        return true
    }
    if stmt.kind == ast.ST_SWITCH {
        hasDefault := false
        for i := 0; i < len(stmt.selectCases); i = i + 1 {
            if stmt.selectCases[i].isDefault {
                hasDefault = true
            }
            if !stmtAlwaysReturnsBlock(c, stmt.selectCases[i].body) {
                return false
            }
        }
        return hasDefault
    }
    if stmt.kind == ast.ST_FOR {
        // Infinite for loop (no condition, no iterator) always transfers control
        if len(stmt.cond) == 0 && len(stmt.forIterExpr) == 0 {
            return true
        }
        return false
    }
    if stmt.kind == ast.ST_WHILE {
        // while true is an infinite loop
        if len(stmt.cond) > 0 && stmt.cond[0].kind == ast.EX_BOOL && stmt.cond[0].boolVal {
            return true
        }
        return false
    }
    if stmt.kind == ast.ST_MATCH {
        hasWildcard := false
        for i := 0; i < len(stmt.matchArms); i = i + 1 {
            arm := stmt.matchArms[i]
            if arm.isWildcard {
                hasWildcard = true
            }
            producesValue := len(arm.body) > 0 && arm.body[len(arm.body) - 1].kind == ast.ST_EXPR
            if !stmtAlwaysReturnsBlock(c, arm.body) && !producesValue {
                return false
            }
        }
        return hasWildcard
    }
    if stmt.kind == ast.ST_EXPR && len(stmt.expr) > 0 {
        // panic() call transfers control
        if stmt.expr[0].kind == ast.EX_CALL && stmt.expr[0].callFunc[0].kind == ast.EX_IDENT {
            name := stmt.expr[0].callFunc[0].ident
            if str.Equal(name, "panic") || str.Equal(name, "exit") || str.Equal(name, "abort") {
                return true
            }
        }
        // match expression in statement context
        if stmt.expr[0].kind == ast.EX_MATCH_EXPR {
            return matchExprAlwaysReturns(c, stmt.expr[0])
        }
        return false
    }
    return false
}

// matchExprAlwaysReturns reports whether a match expression always returns.
fn matchExprAlwaysReturns(c: *Checker, e: ast.Expr) -> bool {
    hasWildcard := false
    for i := 0; i < len(e.matchExprArms); i = i + 1 {
        arm := e.matchExprArms[i]
        if arm.isWildcard {
            hasWildcard = true
        }
        if !stmtAlwaysReturnsBlock(c, arm.body) {
            return false
        }
    }
    return hasWildcard
}
