// Type checker for Skink, written in Skink.
//
// This module implements a two-pass type checker that validates type
// correctness of Skink programs. It is a port of the Go type checker
// in skink-lang/compiler/types, adapted to use the self-hosted AST
// (std/ast) and tagged-union type representations instead of Go interfaces.
//
// Pass 1: Collect all top-level declarations (functions, structs, enums,
//         constants, variables, services, rulesets, templates) and build
//         a global symbol table.
// Pass 2: Type-check every function body, validating expressions, statements,
//         and declarations against Skink's type rules.

module checker

import "std/str"
import "std/ast"
import "std/stridx"
import "std/io"

// === Type Kind Constants ===

pub const TK_BUILTIN      = 1  // builtin type kind
pub const TK_POINTER      = 2  // pointer type kind
pub const TK_ARRAY        = 3  // array type kind
pub const TK_SET          = 4  // set type kind
pub const TK_MAP          = 5  // map type kind
pub const TK_CHAN         = 6  // chan type kind
pub const TK_TENSOR       = 7  // tensor type kind
pub const TK_NAMED        = 8  // named type kind
pub const TK_FUNCTION     = 9  // function type kind
pub const TK_TUPLE        = 10  // tuple type kind
pub const TK_NIL          = 11  // nil type kind
pub const TK_INTERFACE    = 12  // interface type kind
pub const TK_ERROR        = 13  // error type kind
pub const TK_ANY          = 14  // any type kind
pub const TK_UNKNOWN      = 15  // unknown type kind
pub const TK_SERVICE      = 16  // service type kind
pub const TK_RULESET      = 17  // ruleset type kind
pub const TK_TEMPLATE     = 18  // template type kind
pub const TK_TAGGED_UNION = 19  // tagged union type kind

// === Type Representation ===

// TType is the checker's internal representation of a Skink type: kind tag, name, and composite element/field/parameter data.
pub struct TType {
    kind: int  // the kind
    name: string  // the name
    elem: []TType  // the element
    keyType: []TType  // the key type
    params:   []TType  // the params
    retTypes: []TType  // the return value types
    variadic: bool  // the variadic
    tupleTypes: []TType  // the tuple types
    variants: []TaggedVariant  // the variants
    methodNames: []string  // the method names
    methodTypes: []TType  // the method types
    genericArgs: []TType  // the generic arguments
}

// TaggedVariant describes one variant of an enum declaration: its name and payload field types.
pub struct TaggedVariant {
    name:        string  // the name
    payloadType: []TType  // the payload type
}

// === Type Constructors ===

// builtinType constructs a builtin named type (int, string, bool, etc.).
pub fn builtinType(name: string) -> TType {
    t := TType{kind: TK_BUILTIN}
    t.name = name
    return t
}

// pointerType constructs a pointer-to-elem type.
pub fn pointerType(elem: TType) -> TType {
    t := TType{kind: TK_POINTER}
    t.elem = singleTType(elem)
    return t
}

// arrayType constructs a slice (dynamic array) of elem type.
pub fn arrayType(elem: TType) -> TType {
    t := TType{kind: TK_ARRAY}
    t.elem = singleTType(elem)
    return t
}

// setType constructs a set of elem type.
pub fn setType(elem: TType) -> TType {
    t := TType{kind: TK_SET}
    t.elem = singleTType(elem)
    return t
}

// mapType constructs a map with the given key and element types.
pub fn mapType(key: TType, elem: TType) -> TType {
    t := TType{kind: TK_MAP}
    t.keyType = singleTType(key)
    t.elem = singleTType(elem)
    return t
}

// chanType constructs a channel of elem type.
pub fn chanType(elem: TType) -> TType {
    t := TType{kind: TK_CHAN}
    t.elem = singleTType(elem)
    return t
}

// tensorType constructs a tensor of elem type.
pub fn tensorType(elem: TType) -> TType {
    t := TType{kind: TK_TENSOR}
    t.elem = singleTType(elem)
    return t
}

// namedType constructs a named (user-defined) type.
pub fn namedType(name: string) -> TType {
    t := TType{kind: TK_NAMED}
    t.name = name
    return t
}

// functionType constructs a function type from params and return types.
pub fn functionType(params: []TType, retTypes: []TType) -> TType {
    t := TType{kind: TK_FUNCTION}
    t.params = params
    t.retTypes = retTypes
    return t
}

// tupleType constructs a tuple type from the given element types.
pub fn tupleType(types: []TType) -> TType {
    t := TType{kind: TK_TUPLE}
    t.tupleTypes = types
    return t
}

// nilType returns the nil type.
pub fn nilType() -> TType {
    return TType{kind: TK_NIL}
}

// anyType returns the universal top type that any value is assignable to.
pub fn anyType() -> TType {
    return TType{kind: TK_ANY}
}

// unknownType returns the unknown type used for inference failures.
pub fn unknownType() -> TType {
    return TType{kind: TK_UNKNOWN}
}

// errorType returns the builtin error interface type.
pub fn errorType() -> TType {
    t := TType{kind: TK_ERROR}
    t.name = "error"
    return t
}

// voidType returns the void (no-value) builtin type.
pub fn voidType() -> TType {
    return builtinType("void")
}

// === TType Slice Helpers ===

// singleTType wraps a single TType in a slice.
pub fn singleTType(t: TType) -> []TType {
    s := []TType{}
    s = append(s, t)
    return s
}

// typeOptT returns the first element of a TType slice, or an empty TType.
pub fn typeOptT(s: []TType) -> TType {
    if len(s) > 0 {
        return s[0]
    }
    return TType{}
}

// === Map Key Existence Helpers ===
// Skink does not support comma-ok map access, so we use helper functions
// that check key existence by comparing the returned value to its zero value.

// scopeHasBinding reports whether a scope has a real binding for name.
fn scopeHasBinding(s: *Scope, name: string) -> bool {
    if s == nil {
        return false
    }
    if str.Len(name) == 0 {
        return false
    }
    return s.bindings.Has(name)
}

// scopeGetBinding returns the binding for name in the scope.
fn scopeGetBinding(s: *Scope, name: string) -> Binding {
    return s.bindings.Get(name)
}

// checkerHasBinding reports whether a scope index has a binding for name.
fn checkerHasBinding(c: *Checker, scopeIdx: int, name: string) -> bool {
    return scopeHasBinding(&c.scopes[scopeIdx], name)
}

// mapStringDeclHasKey reports whether a Decl map has a real entry for key.
fn mapStringDeclHasKey(m: map[string]ast.Decl, key: string) -> bool {
    v := m[key]
    // Zero Decl has empty structName, fnName, etc.
    // Use != "" (null-safe with emitter fix) to check if the entry is real.
    if v.structName != "" || v.fnName != "" || v.enumName != "" || v.aliasName != "" || v.templateName != "" || v.rulesetName != "" || v.serviceName != "" || v.constName != "" {
        return true
    }
    return false
}

// mapStringTTypeHasKey reports whether a TType map has a real entry for key.
fn mapStringTTypeHasKey(m: map[string]TType, key: string) -> bool {
    v := m[key]
    return v.kind != 0
}

// mapStringStringSliceHasKey reports whether a string-slice map has an entry for key.
fn mapStringStringSliceHasKey(m: map[string][]string, key: string) -> bool {
    v := m[key]
    return len(v) > 0
}

// mapStringStringHasKey reports whether a string map has a real entry for key.
fn mapStringStringHasKey(m: map[string]string, key: string) -> bool {
    v := m[key]
    return v != ""
}

// mapStringBoolHasKey reports whether a bool map has a true entry for key.
fn mapStringBoolHasKey(m: map[string]bool, key: string) -> bool {
    v := m[key]
    return v
}

// mapStringSymbolInfoHasKey reports whether a SymbolInfo map has an entry for key.
fn mapStringSymbolInfoHasKey(m: map[string]SymbolInfo, key: string) -> bool {
    v := m[key]
    return v.moduleName != ""
}

// lastIndexOf finds the last occurrence of substr in s, or -1 if not found.
fn lastIndexOf(s: string, substr: string) -> int {
    if str.Len(substr) == 0 {
        return str.Len(s)
    }
    if str.Len(substr) > str.Len(s) {
        return -1
    }
    lastPos := str.Len(s) - str.Len(substr)
    for lastPos >= 0 {
        candidate := str.Substr(s, lastPos, str.Len(substr))
        if str.Equal(candidate, substr) {
            return lastPos
        }
        lastPos = lastPos - 1
    }
    return -1
}

// === Type String and Equality ===

// typeString returns a human-readable string representation of a TType.
pub fn typeString(t: TType) -> string {
    if t.kind == TK_BUILTIN { return t.name }
    if t.kind == TK_POINTER { return str.Concat("*", typeString(typeOptT(t.elem))) }
    if t.kind == TK_ARRAY { return str.Concat("[]", typeString(typeOptT(t.elem))) }
    if t.kind == TK_SET { return str.Concat(str.Concat("set<", typeString(typeOptT(t.elem))), ">") }
    if t.kind == TK_MAP { return str.Concat(str.Concat(str.Concat("map[", typeString(typeOptT(t.keyType))), "]"), typeString(typeOptT(t.elem))) }
    if t.kind == TK_CHAN { return str.Concat(str.Concat("chan<", typeString(typeOptT(t.elem))), ">") }
    if t.kind == TK_TENSOR { return str.Concat(str.Concat("tensor<", typeString(typeOptT(t.elem))), ">") }
    if t.kind == TK_NAMED { return t.name }
    if t.kind == TK_FUNCTION { return functionTypeString(t) }
    if t.kind == TK_TUPLE { return tupleTypeString(t.tupleTypes) }
    if t.kind == TK_NIL { return "nil" }
    if t.kind == TK_INTERFACE { return t.name }
    if t.kind == TK_ERROR { return "error" }
    if t.kind == TK_ANY { return "any" }
    if t.kind == TK_UNKNOWN { return "<unknown>" }
    if t.kind == TK_SERVICE { return str.Concat("service ", t.name) }
    if t.kind == TK_RULESET { return str.Concat("ruleset ", t.name) }
    if t.kind == TK_TEMPLATE { return str.Concat("template ", t.name) }
    if t.kind == TK_TAGGED_UNION { return t.name }
    return "<invalid>"
}

// functionTypeString renders a function type in source syntax,
// `fn(P, ...) -> R`, so mismatch errors show the differing signatures
// instead of an opaque `<function>` placeholder (#43).
fn functionTypeString(t: TType) -> string {
    s := "fn("
    for i := 0; i < len(t.params); i = i + 1 {
        if i > 0 {
            s = str.Concat(s, ", ")
        }
        s = str.Concat(s, typeString(t.params[i]))
    }
    s = str.Concat(s, ")")
    if len(t.retTypes) == 0 {
        return s
    }
    if len(t.retTypes) == 1 {
        return str.Concat(str.Concat(s, " -> "), typeString(t.retTypes[0]))
    }
    return str.Concat(str.Concat(s, " -> "), tupleTypeString(t.retTypes))
}

// tupleTypeString renders a tuple type list as a parenthesised string.
fn tupleTypeString(types: []TType) -> string {
    if len(types) == 0 {
        return "()"
    }
    s := str.Concat("(", typeString(types[0]))
    for i := 1; i < len(types); i = i + 1 {
        s = str.Concat(str.Concat(s, ", "), typeString(types[i]))
    }
    return str.Concat(s, ")")
}

// typeEquals reports whether two TType values are structurally equal.
pub fn typeEquals(a: TType, b: TType) -> bool {
    if a.kind != b.kind {
        if a.kind == TK_NAMED && b.kind == TK_TAGGED_UNION {
            return normalizeName(a.name) == normalizeName(b.name)
        }
        if a.kind == TK_TAGGED_UNION && b.kind == TK_NAMED {
            return normalizeName(a.name) == normalizeName(b.name)
        }
        return false
    }
    if a.kind == TK_BUILTIN { return str.Equal(a.name, b.name) }
    if a.kind == TK_NAMED { return normalizeName(a.name) == normalizeName(b.name) }
    if a.kind == TK_POINTER { return typeEquals(typeOptT(a.elem), typeOptT(b.elem)) }
    if a.kind == TK_ARRAY { return typeEquals(typeOptT(a.elem), typeOptT(b.elem)) }
    if a.kind == TK_SET { return typeEquals(typeOptT(a.elem), typeOptT(b.elem)) }
    if a.kind == TK_CHAN { return typeEquals(typeOptT(a.elem), typeOptT(b.elem)) }
    if a.kind == TK_TENSOR { return typeEquals(typeOptT(a.elem), typeOptT(b.elem)) }
    if a.kind == TK_MAP { return typeEquals(typeOptT(a.keyType), typeOptT(b.keyType)) && typeEquals(typeOptT(a.elem), typeOptT(b.elem)) }
    if a.kind == TK_NIL { return true }
    if a.kind == TK_ANY { return true }
    if a.kind == TK_UNKNOWN { return true }
    if a.kind == TK_ERROR { return true }
    if a.kind == TK_SERVICE { return str.Equal(a.name, b.name) }
    if a.kind == TK_RULESET { return str.Equal(a.name, b.name) }
    if a.kind == TK_TEMPLATE { return str.Equal(a.name, b.name) }
    if a.kind == TK_TAGGED_UNION { return normalizeName(a.name) == normalizeName(b.name) }
    if a.kind == TK_INTERFACE { return str.Equal(a.name, b.name) }
    if a.kind == TK_FUNCTION { return functionTypeEquals(a, b) }
    if a.kind == TK_TUPLE { return tupleTypeEquals(a.tupleTypes, b.tupleTypes) }
    return false
}

// functionTypeEquals compares two function types for equality.
fn functionTypeEquals(a: TType, b: TType) -> bool {
    if len(a.params) != len(b.params) {
        return false
    }
    if len(a.retTypes) != len(b.retTypes) {
        return false
    }
    for i := 0; i < len(a.params); i = i + 1 {
        if !typeEquals(a.params[i], b.params[i]) {
            return false
        }
    }
    for i := 0; i < len(a.retTypes); i = i + 1 {
        if !typeEquals(a.retTypes[i], b.retTypes[i]) {
            return false
        }
    }
    return a.variadic == b.variadic
}

// tupleTypeEquals compares two tuple element lists for equality.
fn tupleTypeEquals(a: []TType, b: []TType) -> bool {
    if len(a) != len(b) {
        return false
    }
    for i := 0; i < len(a); i = i + 1 {
        if !typeEquals(a[i], b[i]) {
            return false
        }
    }
    return true
}

// normalizeName replaces dots with underscores in a qualified type name.
fn normalizeName(s: string) -> string {
    return str.Replace(s, ".", "_")
}

// === Type Classification ===

// isNumeric reports whether t is an integer or float builtin type.
pub fn isNumeric(t: TType) -> bool {
    if t.kind != TK_BUILTIN {
        return false
    }
    if t.name == "int" { return true }
    if t.name == "int8" { return true }
    if t.name == "int16" { return true }
    if t.name == "int32" { return true }
    if t.name == "int64" { return true }
    if t.name == "uint" { return true }
    if t.name == "uint8" { return true }
    if t.name == "uint16" { return true }
    if t.name == "uint32" { return true }
    if t.name == "uint64" { return true }
    if t.name == "float" { return true }
    return false
}

// isInteger reports whether t is any integer builtin type.
pub fn isInteger(t: TType) -> bool {
    if t.kind != TK_BUILTIN {
        return false
    }
    if t.name == "int" { return true }
    if t.name == "int8" { return true }
    if t.name == "int16" { return true }
    if t.name == "int32" { return true }
    if t.name == "int64" { return true }
    if t.name == "uint" { return true }
    if t.name == "uint8" { return true }
    if t.name == "uint16" { return true }
    if t.name == "uint32" { return true }
    if t.name == "uint64" { return true }
    return false
}

// isFloatType reports whether t is the built-in float type.
fn isFloatType(t: TType) -> bool {
    return t.kind == TK_BUILTIN && str.Equal(t.name, "float")
}

// isSignedInt reports whether t is a signed integer builtin type.
fn isSignedInt(t: TType) -> bool {
    if t.kind != TK_BUILTIN { return false }
    if str.Equal(t.name, "int") { return true }
    if str.Equal(t.name, "int8") { return true }
    if str.Equal(t.name, "int16") { return true }
    if str.Equal(t.name, "int32") { return true }
    if str.Equal(t.name, "int64") { return true }
    return false
}

// isUnsignedInt reports whether t is an unsigned integer builtin type.
fn isUnsignedInt(t: TType) -> bool {
    if t.kind != TK_BUILTIN { return false }
    if str.Equal(t.name, "uint") { return true }
    if str.Equal(t.name, "uint8") { return true }
    if str.Equal(t.name, "uint16") { return true }
    if str.Equal(t.name, "uint32") { return true }
    if str.Equal(t.name, "uint64") { return true }
    return false
}

// isBuiltinTypeName reports whether name is a recognised builtin type.
pub fn isBuiltinTypeName(name: string) -> bool {
    if name == "int" { return true }
    if name == "int8" { return true }
    if name == "int16" { return true }
    if name == "int32" { return true }
    if name == "int64" { return true }
    if name == "uint" { return true }
    if name == "uint8" { return true }
    if name == "uint16" { return true }
    if name == "uint32" { return true }
    if name == "uint64" { return true }
    if name == "float" { return true }
    if name == "bool" { return true }
    if name == "string" { return true }
    if name == "bytes" { return true }
    return false
}

// lookupType resolves a builtin or named type from its name.
pub fn lookupType(name: string) -> TType {
    if name == "int" { return builtinType("int") }
    if name == "int8" { return builtinType("int8") }
    if name == "int16" { return builtinType("int16") }
    if name == "int32" { return builtinType("int32") }
    if name == "int64" { return builtinType("int64") }
    if name == "uint" { return builtinType("uint") }
    if name == "uint8" { return builtinType("uint8") }
    if name == "uint16" { return builtinType("uint16") }
    if name == "uint32" { return builtinType("uint32") }
    if name == "uint64" { return builtinType("uint64") }
    if name == "float" { return builtinType("float") }
    if name == "bool" { return builtinType("bool") }
    if name == "string" { return builtinType("string") }
    if name == "bytes" { return builtinType("bytes") }
    if name == "void" { return builtinType("void") }
    if name == "error" { return errorType() }
    return namedType(name)
}

// === Assignability ===

// isAssignable reports whether src can be assigned to dst.
pub fn isAssignable(dst: TType, src: TType) -> bool {
    if typeEquals(dst, src) {
        return true
    }
    if dst.kind == TK_ANY {
        return true
    }
    if isInteger(dst) && isInteger(src) {
        return true
    }
    if src.kind == TK_ANY && isInteger(dst) {
        return true
    }
    if src.kind == TK_ANY && dst.kind == TK_BUILTIN && str.Equal(dst.name, "float") {
        return true
    }
    // Numeric widening: integer values coerce to float.
    if dst.kind == TK_BUILTIN && str.Equal(dst.name, "float") && isInteger(src) {
        return true
    }
    if src.kind == TK_BUILTIN && str.Equal(src.name, "bool") && isInteger(dst) {
        return true
    }
    if src.kind == TK_NIL {
        if dst.kind == TK_ERROR {
            return true
        }
        if dst.kind == TK_BUILTIN && str.Equal(dst.name, "string") {
            return true
        }
        if dst.kind == TK_POINTER || dst.kind == TK_ARRAY || dst.kind == TK_CHAN || dst.kind == TK_MAP {
            return true
        }
    }
    if dst.kind == TK_MAP && src.kind == TK_MAP {
        srcKey := typeOptT(src.keyType)
        dstKey := typeOptT(dst.keyType)
        srcElem := typeOptT(src.elem)
        dstElem := typeOptT(dst.elem)
        keyCompatible := typeEquals(srcKey, dstKey) || srcKey.kind == TK_ANY
        valCompatible := typeEquals(srcElem, dstElem) || srcElem.kind == TK_ANY
        if keyCompatible && valCompatible {
            return true
        }
    }
    if src.kind == TK_ARRAY {
        srcElem := typeOptT(src.elem)
        if srcElem.kind == TK_ANY && dst.kind == TK_ARRAY {
            return true
        }
    }
    return false
}

// digitVal returns the numeric value of an ASCII hex digit, or -1.
fn digitVal(ch: int) -> int {
    if ch >= 48 && ch <= 57 { return ch - 48 }
    if ch >= 65 && ch <= 70 { return ch - 55 }
    if ch >= 97 && ch <= 102 { return ch - 87 }
    return -1
}

// parseIntLiteralText parses a decimal or hex integer literal string into
// an int64 value. It only accepts the forms the Skink parser produces for
// EX_INT nodes. Returns (value, ok).
fn parseIntLiteralText(s: string) -> (int64, bool) {
    n := str.Len(s)
    if n == 0 { return 0, false }
    base := 10
    start := 0
    if n > 2 && s[0] == 48 && (s[1] == 120 || s[1] == 88) {
        base = 16
        start = 2
    }
    var v int64 = 0
    i := start
    for i < n {
        d := digitVal(int(s[i]))
        if d < 0 || d >= base { return 0, false }
        v = v * int64(base) + int64(d)
        i = i + 1
    }
    return v, true
}

// intTypeWidthAndSign returns (bitWidth, isSigned) for an integer builtin
// type name. Width 0 means the type is not a finite-width integer we range
// check here (e.g. int64/uint64 — any literal the parser accepted fits).
fn intTypeWidthAndSign(name: string) -> (int, bool) {
    if str.Equal(name, "int8") { return 8, true }
    if str.Equal(name, "int16") { return 16, true }
    if str.Equal(name, "int32") { return 32, true }
    if str.Equal(name, "int") { return 32, true }
    if str.Equal(name, "uint8") { return 8, false }
    if str.Equal(name, "uint16") { return 16, false }
    if str.Equal(name, "uint32") { return 32, false }
    if str.Equal(name, "uint") { return 32, false }
    if str.Equal(name, "int64") { return 64, true }
    if str.Equal(name, "uint64") { return 64, false }
    return 0, false
}

// resolvedIntLiteralExpr unwraps a const reference to its initializer
// expression so untyped integer constants can be range-checked. It only
// follows one const link to avoid cycles.
fn resolvedIntLiteralExpr(c: *Checker, e: ast.Expr) -> (ast.Expr, bool) {
    if e.kind == ast.EX_INT { return e, true }
    if e.kind == ast.EX_PREFIX && str.Equal(e.prefixOp, "-") && len(e.prefixRight) > 0 {
        _, ok := resolvedIntLiteralExpr(c, e.prefixRight[0])
        if ok { return e, true }
    }
    if e.kind == ast.EX_IDENT {
        cached := c.constExprs.Get(e.ident)
        if cached.kind != 0 { return cached, true }
    }
    var zero ast.Expr
    return zero, false
}

// intLiteralSignedValue returns the magnitude, sign, and ok flag for an
// integer literal expression (possibly prefix-negated or a const alias).
fn intLiteralSignedValue(c: *Checker, e: ast.Expr) -> (int64, bool, bool) {
    resolved, ok := resolvedIntLiteralExpr(c, e)
    if !ok { return 0, false, false }
    if resolved.kind == ast.EX_INT {
        mag, ok2 := parseIntLiteralText(resolved.strVal)
        return mag, false, ok2
    }
    if resolved.kind == ast.EX_PREFIX && str.Equal(resolved.prefixOp, "-") && len(resolved.prefixRight) > 0 {
        inner, ok2 := resolvedIntLiteralExpr(c, resolved.prefixRight[0])
        if ok2 {
            mag, neg, ok3 := intLiteralSignedValue(c, inner)
            return mag, !neg, ok3
        }
    }
    return 0, false, false
}

// checkIntLitFits reports a compile error if an integer literal expression
// does not fit into the target narrow integer type.
fn checkIntLitFits(c: *Checker, e: ast.Expr, target: TType) {
    if target.kind != TK_BUILTIN {
        return
    }
    width, signed := intTypeWidthAndSign(target.name)
    if width == 0 || width >= 64 {
        return
    }
    mag, neg, ok := intLiteralSignedValue(c, e)
    if !ok { return }

    // Compute 2^(width-1) using int64 multiplication.
    var halfPower int64 = 1
    for i := 0; i < width - 1; i = i + 1 {
        halfPower = halfPower * 2
    }
    if signed {
        if neg {
            if mag > halfPower {
                report(c, str.Concat("constant overflows ", target.name))
            }
            return
        }
        // Positive values must fit in [0, halfPower - 1].
        if mag > halfPower - 1 {
            report(c, str.Concat("constant overflows ", target.name))
        }
        return
    }
    // Unsigned target.
    if neg {
        report(c, str.Concat("constant overflows ", target.name))
        return
    }
    var maxUnsigned int64 = 1
    for i := 0; i < width; i = i + 1 {
        maxUnsigned = maxUnsigned * 2
    }
    if mag > maxUnsigned - 1 {
        report(c, str.Concat("constant overflows ", target.name))
    }
}

// === String-keyed hash tables (comp_error.md #22) ===
//
// The built-in map[string]V is a linear-scan table — O(N) strcmp per
// lookup — which made the checker effectively quadratic on the ~725
// declarations in a self-compile. Generic containers can't hold struct
// values (generic type parameters erase to i8*), so each table is
// monomorphic: a shared stridx.StrIndex maps a key to a stable slot and
// the value lives at vals[slot]. Get returns the zero value for missing
// keys, matching built-in map semantics.

// bindingTable is a string→Binding hash table.
struct bindingTable {
    idx:  stridx.StrIndex  // the index
    vals: []Binding  // the values

    fn Get(self: *bindingTable, key: string) -> Binding {
        var zero Binding
        i := self.idx.Find(key)
        if i < 0 {
            return zero
        }
        return self.vals[i]
    }

    fn Set(self: *bindingTable, key: string, v: Binding) {
        i := self.idx.Ensure(key)
        if i >= len(self.vals) {
            // Grow geometrically rather than appending one slot: append()
            // reallocates the backing array at exactly len+1 and copies
            // every element (slices carry no capacity field), so one
            // append per key is O(N^2). Slots are assigned sequentially
            // and Get only reads slots that idx.Find returns, so
            // over-allocating vals is safe.
            newLen := len(self.vals) * 2
            if newLen < i + 1 {
                newLen = i + 1
            }
            nv := make([]Binding, newLen)
            for j := 0; j < len(self.vals); j = j + 1 {
                nv[j] = self.vals[j]
            }
            self.vals = nv
        }
        self.vals[i] = v
    }

    fn Has(self: *bindingTable, key: string) -> bool {
        return self.idx.Find(key) >= 0
    }
}

// ttypeTable is a string→TType hash table.
struct ttypeTable {
    idx:  stridx.StrIndex  // the index
    vals: []TType  // the values

    fn Get(self: *ttypeTable, key: string) -> TType {
        var zero TType
        i := self.idx.Find(key)
        if i < 0 {
            return zero
        }
        return self.vals[i]
    }

    fn Set(self: *ttypeTable, key: string, v: TType) {
        i := self.idx.Ensure(key)
        if i >= len(self.vals) {
            // See bindingTable.Set: grow geometrically — append() is O(N)
            // realloc-per-element and makes this O(N^2).
            newLen := len(self.vals) * 2
            if newLen < i + 1 {
                newLen = i + 1
            }
            nv := make([]TType, newLen)
            for j := 0; j < len(self.vals); j = j + 1 {
                nv[j] = self.vals[j]
            }
            self.vals = nv
        }
        self.vals[i] = v
    }

    fn Has(self: *ttypeTable, key: string) -> bool {
        return self.idx.Find(key) >= 0
    }
}

// declTable is a string→ast.Decl hash table.
struct declTable {
    idx:  stridx.StrIndex  // the index
