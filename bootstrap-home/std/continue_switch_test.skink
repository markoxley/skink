module continue_switch_test

import "testing"

// TestContinueInSwitch verifies continue inside switch targets the loop.
pub fn TestContinueInSwitch() {
    count := 0
    for i := 0; i < 10; i = i + 1 {
        switch i {
        case 3:
            continue  // must skip to next loop iteration, not break the loop
        default:
            count = count + 1
        }
    }
    testing.AssertEqualInt(9, count, "continue inside switch skips iteration")
}

// TestContinueInNested verifies continue in nested switch skips iteration.
pub fn TestContinueInNested() {
    outer := 0
    for i := 0; i < 3; i = i + 1 {
        for j := 0; j < 3; j = j + 1 {
            switch j {
            case 1:
                continue
            default:
                outer = outer + 1
            }
        }
    }
    testing.AssertEqualInt(6, outer, "nested continue")
}
