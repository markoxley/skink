{
    // bootstrap-home/ is a byte-for-byte mirror of std/ used only for the
    // stage-0 bootstrap build. Excluding it from search prevents the Skink
    // test explorer (which discovers **/*_test.skink) from listing every
    // test suite twice and from compiling the mirrored copies.
    "search.exclude": {
        "**/bootstrap-home/**": true
    },
    "makefile.configureOnOpen": false
}
