module main

import "std/nn"
import "std/io"
import "std/strconv"

pub fn main() {
    // Create a 2-input, 4-hidden, 1-output network
    net := nn.NewNetwork(2, 4, 1)
    net.SetLearningRate(0.5)

    // Training data for the AND function
    // AND(0,0)=0  AND(0,1)=0  AND(1,0)=0  AND(1,1)=1
    inputs := make([][]float, 4)
    inputs[0] = make([]float, 2)
    inputs[0][0] = 0.0
    inputs[0][1] = 0.0
    inputs[1] = make([]float, 2)
    inputs[1][0] = 0.0
    inputs[1][1] = 1.0
    inputs[2] = make([]float, 2)
    inputs[2][0] = 1.0
    inputs[2][1] = 0.0
    inputs[3] = make([]float, 2)
    inputs[3][0] = 1.0
    inputs[3][1] = 1.0

    targets := make([][]float, 4)
    targets[0] = make([]float, 1)
    targets[0][0] = 0.0
    targets[1] = make([]float, 1)
    targets[1][0] = 0.0
    targets[2] = make([]float, 1)
    targets[2][0] = 0.0
    targets[3] = make([]float, 1)
    targets[3][0] = 1.0

    io.PrintLine("Training neural network on AND function...")
    io.PrintLine("Architecture: 2 inputs, 4 hidden, 1 output")
    io.PrintLine("Learning rate: 0.5")
    io.PrintLine("")

    // Train for 2000 iterations
    iter := 0
    for iter < 2000 {
        sample := 0
        for sample < 4 {
            net.Train(inputs[sample], targets[sample])
            sample = sample + 1
        }
        iter = iter + 1
    }

    // Test the trained network
    io.PrintLine("=== Results after training ===")
    i := 0
    for i < 4 {
        out := net.Predict(inputs[i])
        io.PrintString("AND(")
        io.PrintString(strconv.Itoa(int(inputs[i][0])))
        io.PrintString(", ")
        io.PrintString(strconv.Itoa(int(inputs[i][1])))
        io.PrintString(") = ")
        io.PrintLine(strconv.FormatFloat(out[0], 4))
        i = i + 1
    }
}
