module main

import "std/json"
import "std/io"
import "std/strconv"

pub fn main() {
    // Parse a JSON string
    input := "{\"name\": \"Alice\", \"age\": 30, \"active\": true, \"tags\": [\"dev\", \"skink\"]}"
    io.PrintLine("Input JSON: " + input)

    v, err := json.Unmarshal(input)
    if err.message != "" {
        io.PrintErrorLine("Parse error: " + err.message)
        return
    }

    // Access object fields
    nameVal := json.ObjectGet(v, "name")
    io.PrintLine("name: " + json.AsString(nameVal))

    ageVal := json.ObjectGet(v, "age")
    age := json.AsNumber(ageVal)
    io.PrintLine("age: " + strconv.Itoa(int(age)))

    activeVal := json.ObjectGet(v, "active")
    if json.AsBool(activeVal) {
        io.PrintLine("active: true")
    } else {
        io.PrintLine("active: false")
    }

    // Access array elements
    tagsVal := json.ObjectGet(v, "tags")
    n := json.ArrayLen(tagsVal)
    io.PrintString("tags: ")
    i := 0
    for i < n {
        tag := json.ArrayGet(tagsVal, i)
        io.PrintString(json.AsString(tag))
        if i < n - 1 {
            io.PrintString(", ")
        }
        i = i + 1
    }
    io.PrintLine("")

    // Build a JSON value programmatically
    io.PrintLine("")
    io.PrintLine("=== Building JSON ===")
    keys := []string{"product", "price", "inStock"}
    vals := []json.Value{
        json.FromString("Skink Compiler"),
        json.FromNumber(99.99),
        json.FromBool(true),
    }
    obj := json.FromObject(keys, vals)
    output := json.MarshalValue(obj)
    io.PrintLine("Output: " + output)
}
