module main

import "std/log"
import "std/io"

pub fn main() {
    // Create a logger with a prefix
    logger := log.NewLogger("[APP] ")

    // Log at different levels (default level is INFO, so Debug is filtered)
    io.PrintLine("=== Default level (INFO) ===")
    logger.Debug("This debug message is filtered out")
    logger.Info("Application started")
    logger.Warn("Low disk space warning")
    logger.Error("Failed to connect to database")

    // Change the log level to see debug messages
    io.PrintLine("")
    io.PrintLine("=== Debug level ===")
    logger.SetLevel(log.LevelDebug)
    logger.Debug("Debugging mode enabled")
    logger.Info("Processing request")
    logger.Warn("Cache miss for key 'user:42'")

    // Formatted logging with an int argument
    io.PrintLine("")
    io.PrintLine("=== Formatted logging ===")
    logger.Printf("Processed {} requests", 42)

    // Create a logger at WARN level (only WARN, ERROR, FATAL shown)
    io.PrintLine("")
    io.PrintLine("=== WARN level logger ===")
    warnLogger := log.NewLoggerWithLevel("[WARN] ", log.LevelWarn)
    warnLogger.Info("This info is filtered")
    warnLogger.Warn("This warning is shown")
    warnLogger.Error("This error is shown")

    // File-based logging
    io.PrintLine("")
    io.PrintLine("=== File logging ===")
    fw := log.NewFileWriter("/tmp/skink_app.log")
    if fw.Open() {
        io.PrintLine("Opened /tmp/skink_app.log for writing")
        fw.Write("[INFO] Application started")
        fw.Write("[WARN] Low memory warning")
        fw.Write("[ERROR] Connection timeout")
        fw.Close()
        io.PrintLine("Closed log file")
    } else {
        io.PrintErrorLine("Failed to open log file")
    }

    // Package-level functions
    io.PrintLine("")
    io.PrintLine("=== Package-level functions ===")
    log.Print("This uses the package-level Print function")
    log.Printf("Formatted: count = {}", 100)
}
