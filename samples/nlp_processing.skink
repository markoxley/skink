module main

import "std/nlp"
import "std/io"
import "std/strconv"

pub fn main() {
    text := "The quick brown fox quickly jumps over the lazy dog. It is running fast!"

    // Tokenization
    io.PrintLine("=== Tokenization ===")
    io.PrintLine("Input: " + text)
    tokens := nlp.Tokenize(text)
    io.PrintString("Tokens: ")
    i := 0
    for i < len(tokens) {
        io.PrintString(tokens[i].Text())
        if i < len(tokens) - 1 {
            io.PrintString(" | ")
        }
        i = i + 1
    }
    io.PrintLine("")
    io.PrintLine("Token count: " + strconv.Itoa(len(tokens)))
    io.PrintLine("Word count:  " + strconv.Itoa(nlp.WordCount(text)))

    // Sentence segmentation
    io.PrintLine("")
    io.PrintLine("=== Sentence Segmentation ===")
    sentences := nlp.SentenceSegment(text)
    i = 0
    for i < len(sentences) {
        io.PrintLine(strconv.Itoa(i + 1) + ". " + sentences[i])
        i = i + 1
    }

    // Part-of-speech tagging
    io.PrintLine("")
    io.PrintLine("=== POS Tagging ===")
    tagged := nlp.TagPOS(tokens)
    i = 0
    for i < len(tagged) {
        io.PrintLine(tagged[i].Text() + " -> " + tagged[i].Tag())
        i = i + 1
    }

    // Extract just the words
    io.PrintLine("")
    io.PrintLine("=== Extracted Words ===")
    words := nlp.ExtractWords(text)
    io.PrintString("Words: ")
    i = 0
    for i < len(words) {
        io.PrintString(words[i])
        if i < len(words) - 1 {
            io.PrintString(", ")
        }
        i = i + 1
    }
    io.PrintLine("")
}
