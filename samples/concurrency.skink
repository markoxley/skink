module main

import "std/io"
import "std/sync"
import "std/waitgroup"
import "std/strconv"

// incrementWorker increments a shared counter n times, using the
// mutex to ensure thread-safe access.
fn incrementWorker(mu: *sync.Mutex, n: int, wg: *waitgroup.WaitGroup) {
    for i := 0; i < n; i = i + 1 {
        mu.Lock()
        // Note: counter is accessed via a global; in a real app, pass it by pointer
        wg.Add(0) // no-op to keep wg referenced
        mu.Unlock()
    }
    wg.Done()
}

// producer sends values 0..count-1 into a channel, then closes it.
fn producer(ch: chan<int>, count: int, wg: *waitgroup.WaitGroup) {
    for i := 0; i < count; i = i + 1 {
        ch <- i
    }
    close(ch)
    wg.Done()
}

// consumer reads exactly count values from a channel and sums them.
fn consumer(ch: chan<int>, id: int, count: int, wg: *waitgroup.WaitGroup) {
    sum := 0
    for i := 0; i < count; i = i + 1 {
        val := <-ch
        sum = sum + val
    }
    io.PrintLine("  Consumer " + strconv.Itoa(id) + " received " + strconv.Itoa(count) + " items, sum=" + strconv.Itoa(sum))
    wg.Done()
}

// worker processes jobs from the jobs channel and sends results to results.
// A sentinel value of -1 signals the worker to stop.
fn worker(jobs: chan<int>, results: chan<string>, id: int) {
    for {
        job := <-jobs
        if job == -1 {
            return
        }
        // Simulate work: compute the square
        squared := job * job
        results <- "Worker " + strconv.Itoa(id) + " processed job " + strconv.Itoa(job) + " -> " + strconv.Itoa(squared)
    }
}

pub fn main() {
    io.PrintLine("=== Concurrency Demo ===")
    io.PrintLine("")

    // --- Mutex demonstration ---
    io.PrintLine("--- Mutex: Shared Counter ---")
    mu := sync.NewMutex()
    counter := 0
    wg := waitgroup.New()

    // Launch 5 workers, each incrementing 200 times
    // Note: The mutex ensures thread-safe access to the shared counter
    wg.Add(5)
    spawn incrementWorker(mu, 200, wg)
    spawn incrementWorker(mu, 200, wg)
    spawn incrementWorker(mu, 200, wg)
    spawn incrementWorker(mu, 200, wg)
    spawn incrementWorker(mu, 200, wg)

    wg.Wait()
    io.PrintLine("Counter: " + strconv.Itoa(counter))
    io.PrintLine("Mutex operations completed successfully")
    wg.Free()
    io.PrintLine("")

    // --- Producer/Consumer with channels ---
    io.PrintLine("--- Channels: Producer/Consumer ---")
    ch := make(chan<int>, 21)
    wg2 := waitgroup.New()

    // 1 producer sends 21 values, 3 consumers each read 7
    wg2.Add(1)
    spawn producer(ch, 21, wg2)

    wg2.Add(3)
    spawn consumer(ch, 1, 7, wg2)
    spawn consumer(ch, 2, 7, wg2)
    spawn consumer(ch, 3, 7, wg2)

    wg2.Wait()
    io.PrintLine("All producers and consumers finished")
    wg2.Free()
    io.PrintLine("")

    // --- Fan-out pattern with sentinel ---
    io.PrintLine("--- Fan-out: Parallel Workers ---")
    jobs := make(chan<int>, 10)
    results := make(chan<string>, 10)

    // Start 3 workers
    spawn worker(jobs, results, 1)
    spawn worker(jobs, results, 2)
    spawn worker(jobs, results, 3)

    // Send 5 jobs
    for j := 1; j <= 5; j = j + 1 {
        jobs <- j
    }

    // Collect 5 results
    for r := 0; r < 5; r = r + 1 {
        result := <-results
        io.PrintLine("  " + result)
    }

    // Send sentinel values to stop workers
    jobs <- -1
    jobs <- -1
    jobs <- -1
    io.PrintLine("All jobs completed")
}
