module main

import "std/time"
import "std/io"
import "std/strconv"

pub fn main() {
    io.PrintLine("=== Timer & Ticker Demo ===")
    io.PrintLine("")

    // --- Duration creation and conversion ---
    io.PrintLine("--- Durations ---")
    d := time.FromSeconds(3)
    io.PrintLine("3 seconds = " + strconv.Itoa64(d.Nanoseconds()) + " ns")
    io.PrintLine("3 seconds = " + strconv.FormatFloat(d.Seconds(), 1) + " s")

    d2 := time.FromMilliseconds(500)
    io.PrintLine("500 ms = " + strconv.Itoa64(d2.Milliseconds()) + " ms")
    io.PrintLine("")

    // --- Timer: fires once after a duration ---
    io.PrintLine("--- Timer (fires once after 200ms) ---")
    timer := time.NewTimer(time.FromMilliseconds(200))
    io.PrintLine("Waiting for timer...")
    <-timer.C
    io.PrintLine("Timer fired!")
    timer.Stop()
    io.PrintLine("")

    // --- Timer with Reset ---
    io.PrintLine("--- Timer with Reset (100ms) ---")
    timer2 := time.NewTimer(time.FromSeconds(10))
    timer2.Reset(time.FromMilliseconds(100))
    io.PrintLine("Waiting for reset timer...")
    <-timer2.C
    io.PrintLine("Reset timer fired!")
    timer2.Stop()
    io.PrintLine("")

    // --- Ticker: fires repeatedly at intervals ---
    io.PrintLine("--- Ticker (fires every 100ms, 3 times) ---")
    ticker := time.NewTicker(time.FromMilliseconds(100))
    for i := 0; i < 3; i = i + 1 {
        <-ticker.C
        io.PrintLine("  Tick " + strconv.Itoa(i + 1))
    }
    ticker.Stop()
    io.PrintLine("Ticker stopped")
    io.PrintLine("")

    // --- Current time ---
    io.PrintLine("--- Current Time ---")
    now := time.Now()
    io.PrintLine("Year: " + strconv.Itoa(now.Year()))
    io.PrintLine("Month: " + strconv.Itoa(now.Month()))
    io.PrintLine("Day: " + strconv.Itoa(now.Day()))
    io.PrintLine("Hour: " + strconv.Itoa(now.Hour()))
    ts := time.Timestamp()
    io.PrintLine("Unix timestamp: " + strconv.Itoa(ts))
    nano := time.NowUnixNano()
    io.PrintLine("Unix nano: " + strconv.Itoa64(nano))
}
