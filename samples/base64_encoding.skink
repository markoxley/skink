module main

import "std/base64"
import "std/io"
import "std/str"
import "std/fmt"

pub fn main() {
    io.PrintLine("=== Base64 Encoding Demo ===")
    io.PrintLine("")

    // --- Encode a simple string ---
    io.PrintLine("--- Encoding ---")
    message := "Hello, Skink!"
    encoded := base64.Encode(message, str.Len(message))
    io.PrintLine("Original: " + message)
    io.PrintLine("Encoded:  " + encoded)
    io.PrintLine("")

    // --- Decode it back ---
    io.PrintLine("--- Decoding ---")
    decoded, err := base64.Decode(encoded)
    if err.message != "" {
        io.PrintErrorLine("Decode error: " + err.message)
        return
    }
    io.PrintLine("Decoded:  " + decoded)
    io.PrintLine("Round-trip match: " + fmt.Btoa(str.Equal(message, decoded)))
    io.PrintLine("")

    // --- Encode various data ---
    io.PrintLine("--- Various Encodings ---")
    testStrings := []string{
        "Skink",
        "The quick brown fox",
        "Base64 encoding is useful for binary data",
        "",
    }

    for i := 0; i < len(testStrings); i = i + 1 {
        s := testStrings[i]
        enc := base64.Encode(s, str.Len(s))
        dec, dErr := base64.Decode(enc)
        status := "FAIL"
        if dErr.message == "" && str.Equal(s, dec) {
            status = "OK"
        }
        io.PrintLine("  \"" + s + "\" -> \"" + enc + "\" [" + status + "]")
    }
    io.PrintLine("")

    // --- Practical use: encoding credentials ---
    io.PrintLine("--- Practical: Basic Auth Header ---")
    username := "admin"
    password := "secretpass"
    credentials := username + ":" + password
    b64Creds := base64.Encode(credentials, str.Len(credentials))
    io.PrintLine("Credentials: " + credentials)
    io.PrintLine("Authorization: Basic " + b64Creds)
}
