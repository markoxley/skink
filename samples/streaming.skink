module main

import "std/fs"
import "std/io"
import "std/buf"
import "std/streams"
import "std/reader"
import "std/str"
import "std/strconv"

pub fn main() {
    io.PrintLine("=== Streaming Demo ===")
    io.PrintLine("")

    srcPath := "/tmp/skink_stream_src.txt"
    data := "The quick brown fox jumps over the lazy dog."

    // -- 1. Write bytes to disk via the Writer interface --
    io.PrintLine("--- 1. Writing bytes to disk (File as Writer) ---")
    fs.Remove(srcPath)
    f, wErr := fs.Open(srcPath, "w")
    if wErr.message != "" {
        io.PrintErrorLine("Open error: " + wErr.message)
        return
    }
    n := f.Write(data, str.Len(data))
    f.Close()
    io.PrintLine("Wrote " + strconv.Itoa(n) + " bytes to " + srcPath)
    io.PrintLine("")

    // -- 2. Read bytes from disk via the Reader interface --
    io.PrintLine("--- 2. Reading bytes from disk (File as Reader) ---")
    f2, rErr := fs.Open(srcPath, "r")
    if rErr.message != "" {
        io.PrintErrorLine("Open error: " + rErr.message)
        return
    }
    // reader.ReadAll calls f2.Read repeatedly until EOF.
    contents := reader.ReadAll(&f2)
    f2.Close()
    io.PrintLine("Read " + strconv.Itoa(str.Len(contents)) + " bytes")
    io.PrintLine("Contents: " + contents)
    io.PrintLine("")

    // -- 3. Copy disk to in-memory buffer (stream-to-stream) --
    io.PrintLine("--- 3. Copying disk to buffer (streams.Pipe) ---")
    f3, _ := fs.Open(srcPath, "r")
    memBuf := buf.NewBuffer()
    copied := streams.Pipe(&f3, &memBuf, 4096)
    f3.Close()
    io.PrintLine("Copied " + strconv.Itoa64(copied) + " bytes into buffer")
    bufContents := memBuf.String()
    io.PrintLine("Buffer: " + bufContents)
    io.PrintLine("")

    // -- 4. Copy in-memory buffer to disk (stream-to-disk) --
    io.PrintLine("--- 4. Copying buffer to disk (streams.Pipe) ---")
    copyPath := "/tmp/skink_stream_copy.txt"
    fs.Remove(copyPath)
    f4, _ := fs.Open(copyPath, "w")
    copied2 := streams.Pipe(&memBuf, &f4, 4096)
    f4.Close()
    memBuf.Free()
    io.PrintLine("Copied " + strconv.Itoa64(copied2) + " bytes to " + copyPath)
    verify, _ := fs.ReadAll(copyPath)
    io.PrintLine("Verified: " + verify)
    io.PrintLine("")

    // -- 5. File-to-file copy (disk-to-disk streaming) --
    io.PrintLine("--- 5. File-to-file copy (disk-to-disk) ---")
    f2fPath := "/tmp/skink_stream_f2f.txt"
    fs.Remove(f2fPath)
    fIn, _ := fs.Open(srcPath, "r")
    fOut, _ := fs.Open(f2fPath, "w")
    copied3 := streams.Pipe(&fIn, &fOut, 4096)
    fIn.Close()
    fOut.Close()
    io.PrintLine("Copied " + strconv.Itoa64(copied3) + " bytes via file-to-file stream")
    f2fContent, _ := fs.ReadAll(f2fPath)
    io.PrintLine("Destination: " + f2fContent)
    io.PrintLine("")

    // -- 6. TeeReader: read from a stream and duplicate to a Writer --
    io.PrintLine("--- 6. TeeReader (read + duplicate to Writer) ---")
    f5, _ := fs.Open(srcPath, "r")
    teeBuf := buf.NewBuffer()
    // TeeReader copies all read data to teeBuf while returning it to the caller.
    tee := streams.TeeReader{r: &f5, w: &teeBuf}
    teeResult := reader.ReadAll(&tee)
    f5.Close()
    teeCapture := teeBuf.String()
    teeBuf.Free()
    io.PrintLine("Read " + strconv.Itoa(str.Len(teeResult)) + " bytes through TeeReader")
    io.PrintLine("Tee capture: " + teeCapture)
    io.PrintLine("")

    // -- 7. LimitReader: read only N bytes from a stream --
    io.PrintLine("--- 7. LimitReader (read first N bytes) ---")
    f6, _ := fs.Open(srcPath, "r")
    limiter := streams.LimitReader{r: &f6, n: int64(10)}
    limited := reader.ReadAll(&limiter)
    f6.Close()
    io.PrintLine("LimitReader returned " + strconv.Itoa(str.Len(limited)) + " bytes (limit was 10)")
    io.PrintLine("First 10 bytes: " + limited)
    io.PrintLine("")

    // -- 8. MultiWriter: write to multiple destinations at once --
    io.PrintLine("--- 8. MultiWriter (fan-out writes) ---")
    multi1Path := "/tmp/skink_stream_multi1.txt"
    multi2Path := "/tmp/skink_stream_multi2.txt"
    fs.Remove(multi1Path)
    fs.Remove(multi2Path)
    f7, _ := fs.Open(multi1Path, "w")
    f8, _ := fs.Open(multi2Path, "w")
    multi := streams.NewMultiWriter(&f7, &f8)
    payload := "broadcast message"
    multi.Write(payload, str.Len(payload))
    f7.Close()
    f8.Close()
    m1, _ := fs.ReadAll(multi1Path)
    m2, _ := fs.ReadAll(multi2Path)
    io.PrintLine("MultiWriter target 1: " + m1)
    io.PrintLine("MultiWriter target 2: " + m2)
    io.PrintLine("")

    // -- 9. io.Copy: high-level stream copy helper --
    io.PrintLine("--- 9. io.Copy (high-level stream copy) ---")
    f9, _ := fs.Open(srcPath, "r")
    copyBuf := buf.NewBuffer()
    ioCopied := io.Copy(&copyBuf, &f9)
    f9.Close()
    io.PrintLine("io.Copy transferred " + strconv.Itoa64(ioCopied) + " bytes")
    copyResult := copyBuf.String()
    copyBuf.Free()
    io.PrintLine("Result: " + copyResult)
    io.PrintLine("")

    // -- Cleanup --
    io.PrintLine("--- Cleanup ---")
    fs.Remove(srcPath)
    fs.Remove(copyPath)
    fs.Remove(f2fPath)
    fs.Remove(multi1Path)
    fs.Remove(multi2Path)
    io.PrintLine("All temporary files removed")
    io.PrintLine("")
    io.PrintLine("=== Streaming Demo Complete ===")
}
