module main

import "std/web/router"
import "std/web/server"
import "std/web/types"
import "std/io"

// homeHandler responds with a plain-text greeting.
fn homeHandler(req: types.Request, w: *types.ResponseWriter) {
    w.WriteHeader(200)
    w.Write("Welcome to the Skink web server!")
}

// jsonHandler responds with a JSON object.
fn jsonHandler(req: types.Request, w: *types.ResponseWriter) {
    w.JSON(200, "{\"message\": \"hello\", \"status\": \"ok\"}")
}

// echoHandler echoes back the request body.
fn echoHandler(req: types.Request, w: *types.ResponseWriter) {
    w.Header("Content-Type", "text/plain")
    w.WriteHeader(200)
    w.Write(req.Body())
}

pub fn main() {
    r := router.NewRouter()
    r.Get("/", homeHandler)
    r.Get("/json", jsonHandler)
    r.Post("/echo", echoHandler)

    io.PrintLine("Starting server on :8080")
    io.PrintLine("  GET  /       - home page")
    io.PrintLine("  GET  /json   - JSON response")
    io.PrintLine("  POST /echo   - echo body")

    s := server.NewServer(8080, &r)
    err := s.ListenAndServe()
    if err.message != "" {
        io.PrintErrorLine("Server error: " + err.message)
    }
}
