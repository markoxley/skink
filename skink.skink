module main

import "std/ast"
import "std/checker"
import "std/emitter"
import "std/fs"
import "std/linkspec"
import "std/os"
import "std/resolver"
import "std/str"
import "std/strconv"
import "std/path"
import "version"

extern fn _skink_runtime_get_argc() -> int
extern fn _skink_runtime_get_argv() -> []string

extern fn getenv(name: string) -> string
extern fn remove(path: string) -> int
extern fn fputs(s: string, fp: int64) -> int
extern fn Skink_fs_mktemp(prefix: string, suffix: string) -> string
extern fn Skink_fs_mktemp_fopen(prefix: string, suffix: string, pathBuf: string) -> int64

// usage prints the command-line usage message for the compiler.
fn usage() {
    println("usage: skink [-v | -version] [-t <target>] [-b <target>] [-o <output>] [-cov] [-c <dir>] [-check | -emit-ll] <file.skink>")
    println("       skink js <args...>      — run the skinkjs backend")
    println("       skink scales <args...>  — run the scales package manager")
    println("       skink fmt <args...>     — run the skinkfmt formatter")
    println("       skink cover <args...>   — run the skinkcov coverage reporter")
}

// projectEntry resolves a -c project directory to (entryFile, outName,
// errMsg). The manifest's [package] entry/name fields win when present;
// otherwise the entry defaults to <dir>/main.skink and the binary name
// to the entry file's basename. -c <file.skink> is accepted as a
// shortcut for compiling that file directly.
fn projectEntry(dir: string) -> (string, string, string) {
    if !fs.IsDir(dir) {
        if fs.Exists(dir) && str.EndsWith(dir, ".skink") {
            out := path.Base(dir)
            dot := str.LastIndexOf(out, ".")
            if dot >= 0 {
                out = str.Substr(out, 0, dot)
            }
            return dir, out, ""
        }
        return "", "", str.Concat("no such project directory: ", dir)
    }
    entry := "main.skink"
    name := ""
    tomlPath := str.Concat(dir, "/skink.toml")
    if fs.Exists(tomlPath) {
        data, rerr := fs.ReadAll(tomlPath)
        if str.Len(rerr.message) == 0 {
            // Minimal [package] scan: only name/entry keys are needed,
            // so a full TOML parser would be overkill here. Keys are
            // honoured only inside the [package] table.
            inPkg := false
            lines := str.Split(data, "\n")
            li := 0
            for li < len(lines) {
                l := str.Trim(lines[li])
                li = li + 1
                if str.StartsWith(l, "[") {
                    inPkg = str.Equal(l, "[package]")
                    continue
                }
                if !inPkg {
                    continue
                }
                eq := str.IndexOf(l, "=")
                if eq < 0 {
                    continue
                }
                key := str.Trim(str.Substr(l, 0, eq))
                q1 := str.IndexOf(l, "\"")
                if q1 < 0 {
                    continue
                }
                rest := str.Substr(l, q1 + 1, str.Len(l) - q1 - 1)
                q2 := str.IndexOf(rest, "\"")
                if q2 < 0 {
                    continue
                }
                val := str.Substr(rest, 0, q2)
                if str.Equal(key, "entry") {
                    entry = val
                }
                if str.Equal(key, "name") {
                    name = val
                }
            }
        }
    }
    src := str.Concat(dir, str.Concat("/", entry))
    if !fs.Exists(src) {
        return "", "", str.Concat("no entry file: ", src)
    }
    if str.Len(name) == 0 {
        name = path.Base(entry)
        dot := str.LastIndexOf(name, ".")
        if dot >= 0 {
            name = str.Substr(name, 0, dot)
        }
    }
    return src, str.Concat(dir, str.Concat("/", name)), ""
}

// findHarnessScript locates a helper script (skink_test.sh / skink_bench.sh)
// that must sit beside the compiler binary. When argv[0] is a bare name
// (the common `skink -t` case where the binary was found via PATH), the
// PATH entries are searched for the script directly.
fn findHarnessScript(argv0: string, name: string) -> string {
    if str.Contains(argv0, "/") {
        binDir := path.Dir(argv0)
        return str.Concat(binDir, str.Concat("/", name))
    }
    pathEnv := getenv("PATH")
    if int64(pathEnv) != 0 && str.Len(pathEnv) > 0 {
        dirs := str.Split(pathEnv, ":")
        for i := 0; i < len(dirs); i = i + 1 {
            candidate := str.Concat(dirs[i], str.Concat("/", name))
            if fs.Exists(candidate) {
                return candidate
            }
        }
    }
    return str.Concat("./", name)
}

// main is the compiler entry point; it dispatches to the test/bench
// harnesses or performs a full compile-and-link cycle.
fn main() -> int {
    argc := _skink_runtime_get_argc()
    argv := _skink_runtime_get_argv()

    // Handle the -v / -version flag to print the version string.
    if argc == 2 && (argv[1] == "-v" || argv[1] == "-version") {
        println(version.Version)
        return 0
    }

    // Subcommand dispatch: `skink js`→skinkjs, `skink scales`→scales,
    // `skink fmt`→skinkfmt, `skink cover`→skinkcov — binaries are
    // resolved beside argv[0] or on PATH via findHarnessScript.
    if argc >= 2 && (argv[1] == "js" || argv[1] == "scales" ||
                     argv[1] == "fmt" || argv[1] == "cover" || argv[1] == "cov") {
        binName := "skinkjs"
        if argv[1] == "scales" {
            binName = "scales"
        }
        if argv[1] == "fmt" {
            binName = "skinkfmt"
        }
        if argv[1] == "cover" || argv[1] == "cov" {
            binName = "skinkcov"
        }
        sub := findHarnessScript(argv[0], binName)
        if !fs.Exists(sub) {
            println("skink: cannot find " + binName + " (expected beside " +
                argv[0] + " or on PATH)")
            return 1
        }
        var subArgs []string
        subArgs = append(subArgs, sub)
        for i := 2; i < argc; i = i + 1 {
            subArgs = append(subArgs, argv[i])
        }
        return os.Exec(subArgs)
    }

    // Determine the Skink standard library root from SKINK_HOME,
    // falling back to the default system installation path.
    skinkHome := getenv("SKINK_HOME")
    if int64(skinkHome) == 0 || str.Len(skinkHome) == 0 {
        skinkHome = "/usr/local/lib/skink"
    }

    // Delegate to the test harness script when -t is given. The script
    // is exec'd directly with an argv array — the old code interpolated
    // argv[0], SKINK_HOME, and argv[2] into a shell command string, so a
    // metacharacter anywhere in those values ran arbitrary commands
    // (VULN-01).
    if argc >= 3 && argv[1] == "-t" {
        selfBin := argv[0]
        script := findHarnessScript(selfBin, "skink_test.sh")
        os.Setenv("SKINK", selfBin)
        os.Setenv("SKINK_HOME", skinkHome)
        testRc := os.Exec([]string{script, argv[2]})
        if testRc == 0 {
            return 0
        }
        return 1
    }

    // Delegate to the benchmark harness script when -b is given.
    if argc >= 3 && argv[1] == "-b" {
        selfBin := argv[0]
        script := findHarnessScript(selfBin, "skink_bench.sh")
        os.Setenv("SKINK", selfBin)
        os.Setenv("SKINK_HOME", skinkHome)
        benchRc := os.Exec([]string{script, argv[2]})
        if benchRc == 0 {
            return 0
        }
        return 1
    }

    if argc < 2 {
        usage()
        return 1
    }

    outName := ""
    checkOnly := false
    emitOnly := false
    debugInfo := false
    covEnabled := false
    projDir := ""

    // Parse flags that precede the input file path.
    i := 1
    for i < argc - 1 {
        arg := argv[i]
        if arg == "-o" {
            // -o may consume the final positional when -c supplies the
            // compilation target (skink -c dir -o out); a bare `skink
            // -o` still errors via the missing-input check below.
            if i + 1 >= argc {
                println("missing -o argument")
                return 1
            }
            outName = argv[i + 1]
            i = i + 2
            continue
        }
        if arg == "-check" {
            checkOnly = true
            i = i + 1
            continue
        }
        if arg == "-emit-ll" {
            emitOnly = true
            i = i + 1
            continue
        }
        if arg == "-g" {
            debugInfo = true
            i = i + 1
            continue
        }
        // -cov instruments every executable statement with a coverage
        // counter; the instrumented binary writes <prog>.skinkcov (or
        // $SKINK_COV_OUT) at exit. See std/runtime/cov_rt.c.
        if arg == "-cov" {
            covEnabled = true
            i = i + 1
            continue
        }
        // -c compiles a project directory: the entry file and binary
        // name come from skink.toml's [package] section (entry/name),
        // falling back to <dir>/main.skink and the entry basename.
        if arg == "-c" {
            if i + 1 >= argc {
                println("missing -c argument")
                return 1
            }
            projDir = argv[i + 1]
            i = i + 2
            continue
        }
        println(str.Concat("unknown flag: ", arg))
        usage()
        return 1
    }

    // The last argument is always the input source file.
    fileName := argv[argc - 1]
    if fileName == "-o" || fileName == "-check" || fileName == "-emit-ll" || fileName == "-g" || fileName == "-cov" || fileName == "-c" {
        println("missing input file")
        usage()
        return 1
    }

    // -c <dir> compiles a whole project: resolve the entry file and
    // default output name from the directory's skink.toml (or
    // main.skink when no manifest exists). An explicit -o still wins.
    if str.Len(projDir) > 0 {
        ent, oname, perr := projectEntry(projDir)
        if str.Len(perr) > 0 {
            println(perr)
            return 1
        }
        fileName = ent
        if str.Len(outName) == 0 {
            outName = oname
        }
    }

    // Derive the output binary name from the input file name if -o was not given.
    if outName == "" {
        outName = path.Base(fileName)
        dot := str.LastIndexOf(outName, ".")
        if dot >= 0 {
            outName = str.Substr(outName, 0, dot)
        }
    }

    // Resolve all transitive imports and collect top-level declarations.
    decls, resolveErrs := resolver.Resolve(fileName, skinkHome)
    if len(resolveErrs) > 0 {
        j := 0
        for j < len(resolveErrs) {
            println(resolveErrs[j])
            j = j + 1
        }
        return 1
    }
    c := checker.newChecker()
    ok := checker.checkProgram(&c, decls)
    if !ok {
        errs := checker.Errors(&c)
        j := 0
        for j < len(errs) {
            println(errs[j])
            j = j + 1
        }
        return 1
    }

    // In -check mode we stop after type checking succeeds.
    if checkOnly {
        println("type check passed")
        return 0
    }

    // Generate LLVM IR from the type-checked program.
    cg := emitter.newCodeGen(&c, debugInfo, covEnabled)
    ir := emitter.emitProgram(&cg, decls)
    emitErrs := emitter.Errors(&cg)
    if len(emitErrs) > 0 {
        j := 0
        for j < len(emitErrs) {
            println(emitErrs[j])
            j = j + 1
        }
        return 1
    }

    // In -emit-ll mode we print the IR to stdout and exit.
    if emitOnly {
        print(ir)
        return 0
    }

    // Write the IR to a uniquely-named file in the system temp dir for
    // clang to consume. The old code used <outName>.ll in the working
    // directory, which could clobber a user file or collide
    // predictably between concurrent compiles (VULN-01).
    // Skink_fs_mktemp_fopen creates the file with O_CREAT|O_EXCL|0600 and
    // returns a FILE* on that same descriptor — there is no close-and-
    // reopen window in which another process could swap the path for a
    // symlink (comp_error.md #153). The created path is copied into
    // llPathBuf so it can be removed after clang consumes it.
    llPathBuf := str.Repeat(" ", 4096)
    fp := Skink_fs_mktemp_fopen("skink", ".ll", llPathBuf)
    if fp == 0 {
        println("cannot create temporary .ll file")
        return 1
    }
    llPath := llPathBuf
    fputs(ir, fp)
    fclose(fp)

    // Assemble the full runtime C source list that every Skink binary links against.
    var rt []string
    rt = append(rt, str.Concat(skinkHome, "/runtime/rc_rt.c"))
    rt = append(rt, str.Concat(skinkHome, "/runtime/fs_rt.c"))
    rt = append(rt, str.Concat(skinkHome, "/runtime/regex_rt.c"))
    rt = append(rt, str.Concat(skinkHome, "/runtime/sync_rt.c"))
    rt = append(rt, str.Concat(skinkHome, "/runtime/tensor_rt.c"))
    rt = append(rt, str.Concat(skinkHome, "/runtime/compress_rt.c"))
    rt = append(rt, str.Concat(skinkHome, "/runtime/conc_rt.c"))
    rt = append(rt, str.Concat(skinkHome, "/runtime/db_rt.c"))
    rt = append(rt, str.Concat(skinkHome, "/runtime/reflect_rt.c"))
    rt = append(rt, str.Concat(skinkHome, "/runtime/rules_rt.c"))
    rt = append(rt, str.Concat(skinkHome, "/runtime/panic_rt.c"))
    rt = append(rt, str.Concat(skinkHome, "/runtime/net_rt.c"))
    rt = append(rt, str.Concat(skinkHome, "/runtime/llm_rt.c"))
    rt = append(rt, str.Concat(skinkHome, "/runtime/mqtt_rt.c"))
    rt = append(rt, str.Concat(skinkHome, "/runtime/tls_rt.c"))
    rt = append(rt, str.Concat(skinkHome, "/runtime/sys_rt.c"))
    rt = append(rt, str.Concat(skinkHome, "/runtime/template_bridge.ll"))

    // Detect whether the program imports the UI library — its runtime
    // shim (ui_rt.c) and SDL2 are only linked in that case so headless
    // binaries carry no GUI dependency. Covers "std/ui" itself and any
    // sub-module ("std/ui/binding", ...).
    needsUI := false
    uiScan := 0
    for uiScan < len(decls) {
        ud := decls[uiScan]
        if ud.kind == ast.ST_IMPORT {
            if str.Equal(ud.decl.importPath, "std/ui") || str.StartsWith(ud.decl.importPath, "std/ui/") {
                needsUI = true
            }
        }
        uiScan = uiScan + 1
    }
    if needsUI {
        rt = append(rt, str.Concat(skinkHome, "/runtime/ui_rt.c"))
    }

    // Coverage builds link the counter/dump runtime — it is only
    // needed when -cov instrumentation was emitted (VULN-free: no
    // conditional symbols in uninstrumented binaries).
    if covEnabled {
        rt = append(rt, str.Concat(skinkHome, "/runtime/cov_rt.c"))
    }

    // Collect [link] requirements (extra C/C++ sources, -I/-L paths,
    // -l libraries, frameworks, and raw flags) declared by the nearest
    // ancestor skink.toml of every resolved source file — the project's
    // own manifest plus each cached mod/<owner>/<repo> package. A
    // malformed [link] section fails the build rather than silently
    // dropping flags.
    linkArgs, linkErrs := linkspec.ArgsForDecls(path.Dir(fileName), decls)
    if len(linkErrs) > 0 {
        ei := 0
        for ei < len(linkErrs) {
            println(linkErrs[ei])
            ei = ei + 1
        }
        return 1
    }

    // Detect platform at runtime to choose appropriate linker flags.
    // Windows sets the OS environment variable to "Windows_NT".
    osEnv := getenv("OS")
    isWindows := str.Equal(osEnv, "Windows_NT")
    // Build the clang argv array — exec without a shell so no argument
    // (file name, -o path, SKINK_HOME, SKINK_CLANG_FLAGS) can inject
    // shell syntax (VULN-01).
    var clangArgs []string
    clangArgs = append(clangArgs, "clang")
    clangArgs = append(clangArgs, "-Wno-override-module")
    if !isWindows {
        clangArgs = append(clangArgs, "-march=native")
    }
    if debugInfo {
        clangArgs = append(clangArgs, "-g")
        clangArgs = append(clangArgs, "-O0")
    } else {
        clangArgs = append(clangArgs, "-O2")
    }
    // SKINK_CLANG_FLAGS supplies extra flags for the sanitizer harness
    // (-fsanitize=address etc.); word-split on spaces preserves its
    // former shell-expansion semantics.
    extraFlags := getenv("SKINK_CLANG_FLAGS")
    if str.Len(extraFlags) > 0 {
        flagParts := str.Split(extraFlags, " ")
        fi := 0
        for fi < len(flagParts) {
            if str.Len(flagParts[fi]) > 0 {
                clangArgs = append(clangArgs, flagParts[fi])
            }
            fi = fi + 1
        }
    }
    clangArgs = append(clangArgs, "-o")
    clangArgs = append(clangArgs, outName)
    clangArgs = append(clangArgs, llPath)
    ri := 0
    for ri < len(rt) {
        clangArgs = append(clangArgs, rt[ri])
        ri = ri + 1
    }
    if isWindows {
        // Windows (MinGW): winpthreads instead of pthread, Winsock2,
        // no dl (Windows uses LoadLibrary), bcrypt for OpenSSL 3.x.
        clangArgs = append(clangArgs, "-lwinpthread")
        clangArgs = append(clangArgs, "-lws2_32")
        clangArgs = append(clangArgs, "-lssl")
        clangArgs = append(clangArgs, "-lcrypto")
        clangArgs = append(clangArgs, "-lz")
        clangArgs = append(clangArgs, "-lsqlite3")
        clangArgs = append(clangArgs, "-lbcrypt")
    } else {
        clangArgs = append(clangArgs, "-lpthread")
        clangArgs = append(clangArgs, "-ldl")
        clangArgs = append(clangArgs, "-lm")
        clangArgs = append(clangArgs, "-lssl")
        clangArgs = append(clangArgs, "-lcrypto")
        clangArgs = append(clangArgs, "-lz")
        clangArgs = append(clangArgs, "-lsqlite3")
    }
    if needsUI {
        // SDL2 headers/libs must be installed (sdl2-devel / libsdl2-dev).
        clangArgs = append(clangArgs, "-lSDL2")
    }
    // Module-supplied link arguments go last so package libraries can
    // satisfy references from package sources and from the .ll object.
    li := 0
    for li < len(linkArgs) {
        clangArgs = append(clangArgs, linkArgs[li])
        li = li + 1
    }
    rc := os.Exec(clangArgs)
    remove(llPath)
    if rc != 0 {
        println("clang failed")
        return 1
    }
    println(str.Concat("built ", outName))
    return 0
}
