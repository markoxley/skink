// bytesEqual compares two raw byte buffers by length and content.
// Unlike str.Equal (which uses strcmp), this handles buffers that may
// contain embedded null bytes.
fn bytesEqual(a: string, b: string, len: int) -> bool {
    if len <= 0 {
        return true
    }
    for i := 0; i < len; i = i + 1 {
        if a[i] != b[i] {
            return false
        }
    }
    return true
}

// TestAES128Roundtrip verifies AES-128-GCM encrypt then decrypt restores
// the original plaintext.
pub fn TestAES128Roundtrip() {
    aes := encrypt.NewAES(aesKey128)
    plaintext := "hello world"
    result, e1 := aes.Encrypt(plaintext, 11)
    if e1.message != "" {
        Errorf("AES-128 Encrypt should not error: " + e1.message)
    }
    // GCM: 12 (nonce) + 16 (tag) + 11 (ciphertext) = 39
    if result.length != 39 {
        Errorf("AES-128 ciphertext+nonce+tag should be 39 bytes, got " + strconv.Itoa(result.length))
    }
    restored, e2 := aes.Decrypt(result.data, result.length)
    if e2.message != "" {
        Errorf("AES-128 Decrypt should not error: " + e2.message)
    }
    if restored.length != 11 {
        Errorf("AES-128 restored length should be 11, got " + strconv.Itoa(restored.length))
    }
    if bytesEqual(restored.data, plaintext, restored.length) == false {
        Errorf("AES-128 roundtrip should restore plaintext")
    }
}

// TestAES256Roundtrip verifies AES-256-GCM encrypt then decrypt.
pub fn TestAES256Roundtrip() {
    aes := encrypt.NewAES(aesKey256)
    plaintext := "hello world"
    result, e1 := aes.Encrypt(plaintext, 11)
    if e1.message != "" {
        Errorf("AES-256 Encrypt should not error: " + e1.message)
    }
    restored, e2 := aes.Decrypt(result.data, result.length)
    if e2.message != "" {
        Errorf("AES-256 Decrypt should not error: " + e2.message)
    }
    if restored.length != 11 {
        Errorf("AES-256 restored length should be 11, got " + strconv.Itoa(restored.length))
    }
    if bytesEqual(restored.data, plaintext, restored.length) == false {
        Errorf("AES-256 roundtrip should restore plaintext")
    }
}

// TestAESEmptyData verifies AES-GCM with empty data.
pub fn TestAESEmptyData() {
    aes := encrypt.NewAES(aesKey128)
    result, e1 := aes.Encrypt("", 0)
    if e1.message != "" {
        Errorf("AES Encrypt empty should not error: " + e1.message)
    }
    // GCM: 12 (nonce) + 16 (tag) + 0 (ciphertext) = 28
    if result.length != 28 {
        Errorf("AES empty encrypt should produce 28 bytes, got " + strconv.Itoa(result.length))
    }
    restored, e2 := aes.Decrypt(result.data, result.length)
    if e2.message != "" {
        Errorf("AES Decrypt empty should not error: " + e2.message)
    }
    if restored.length != 0 {
        Errorf("AES empty roundtrip should restore length 0, got " + strconv.Itoa(restored.length))
    }
}

// TestAESDifferentKeys verifies different keys produce different ciphertext.
pub fn TestAESDifferentKeys() {
    key1 := "0123456789abcdef"
    key2 := "fedcba9876543210"
    aes1 := encrypt.NewAES(key1)
    aes2 := encrypt.NewAES(key2)
    plain := "hello world"
    r1, _ := aes1.Encrypt(plain, 11)
    r2, _ := aes2.Encrypt(plain, 11)
    if r1.length != r2.length {
        Errorf("Ciphertext lengths should match")
    }
    same := true
    for i := 0; i < r1.length; i = i + 1 {
        if Skink_mem_byte(r1.data, int64(i)) != Skink_mem_byte(r2.data, int64(i)) {
            same = false
        }
    }
    if same == true {
        Errorf("Different keys should produce different ciphertext")
    }
}

// TestAESWrongKey verifies decryption with wrong key fails.
pub fn TestAESWrongKey() {
    aes1 := encrypt.NewAES("0123456789abcdef")
    aes2 := encrypt.NewAES("fedcba9876543210")
    result, _ := aes1.Encrypt("secret data", 11)
    _, e := aes2.Decrypt(result.data, result.length)
    if e.message == "" {
        Errorf("Decryption with wrong key should fail")
    }
}

// TestAESInvalidKey verifies invalid key lengths are rejected.
pub fn TestAESInvalidKey() {
    aes := encrypt.NewAES("short")
    _, e := aes.Encrypt("data", 4)
    if e.message == "" {
        Errorf("Invalid key length should be rejected")
    }
}

// TestRSARoundtrip verifies RSA encrypt then decrypt restores the message.
pub fn TestRSARoundtrip() {
    rsa := encrypt.NewRSA(rsaPubKey, rsaPrivKey)
    msg := "test message"
    result, e1 := rsa.Encrypt(msg, 11)
    if e1.message != "" {
        Errorf("RSA Encrypt should not error: " + e1.message)
    }
    if result.length <= 0 {
        Errorf("RSA ciphertext length should be positive, got " + strconv.Itoa(result.length))
    }
    restored, e2 := rsa.Decrypt(result.data, result.length)
    if e2.message != "" {
        Errorf("RSA Decrypt should not error: " + e2.message)
    }
    if restored.length != 11 {
        Errorf("RSA restored length should be 11, got " + strconv.Itoa(restored.length))
    }
    if bytesEqual(restored.data, msg, restored.length) == false {
        Errorf("RSA roundtrip should restore message")
    }
}

// TestRSANoPrivateKey verifies decryption fails without a private key.
pub fn TestRSANoPrivateKey() {
    rsa := encrypt.NewRSA(rsaPubKey, "")
    _, e := rsa.Decrypt("dummy", 5)
    if e.message == "" {
        Errorf("RSA Decrypt without private key should fail")
    }
}

// TestRSANoPublicKey verifies encryption fails without a public key.
pub fn TestRSANoPublicKey() {
    rsa := encrypt.NewRSA("", rsaPrivKey)
    _, e := rsa.Encrypt("dummy", 5)
    if e.message == "" {
        Errorf("RSA Encrypt without public key should fail")
    }
}

// --- VULN-22 security regressions ---

// TestAESLenNulKey guards VULN-22: keys containing NUL bytes were
// measured with strlen, silently truncating the key material. Two keys
// that differ only after an interior NUL must produce different
// ciphers — proven by a cross-decrypt that must fail authentication.
pub fn TestAESLenNulKey() {
    k1 := libc.malloc(16)
    k2 := libc.malloc(16)
    for i := 0; i < 16; i = i + 1 {
        Skink_mem_write_byte(k1, int64(i), 65)
        Skink_mem_write_byte(k2, int64(i), 65)
    }
    Skink_mem_write_byte(k1, int64(5), 0)
    Skink_mem_write_byte(k2, int64(5), 0)
    Skink_mem_write_byte(k1, int64(6), 66) // differ only after the NUL
    Skink_mem_write_byte(k2, int64(6), 67)
    c1 := encrypt.NewAESLen(k1, 16)
    c2 := encrypt.NewAESLen(k2, 16)
    plaintext := "secret data"
    enc, e1 := c1.Encrypt(plaintext, 11)
    if e1.message != "" {
        Errorf("AESLen encrypt failed: " + e1.message)
    }
    // Decrypting under the post-NUL-differing key must fail GCM auth —
    // with strlen keys both truncated to "AAAAA" and this would succeed.
    _, e2 := c2.Decrypt(enc.data, enc.length)
    if e2.message == "" {
        Errorf("post-NUL key difference was ignored (strlen key truncation)")
    }
    libc.free(k1)
    libc.free(k2)
}

// TestAESGCMTagReject guards VULN-22: a corrupted authentication tag
// must fail decryption and leave no unauthenticated plaintext behind.
pub fn TestAESGCMTagReject() {
    aes := encrypt.NewAES(aesKey128)
    enc, e1 := aes.Encrypt("authenticated", 13)
    if e1.message != "" {
        Errorf("encrypt failed: " + e1.message)
    }
    // Layout is nonce(12) || tag(16) || ciphertext — corrupt a tag byte.
    Skink_mem_write_byte(enc.data, int64(20), (int(Skink_mem_byte(enc.data, int64(20))) + 1) % 256)
    _, e2 := aes.Decrypt(enc.data, enc.length)
    if e2.message == "" {
        Errorf("corrupted GCM tag decrypted successfully")
    }
}

// --- AES-GCM additional authenticated data (AAD) ---

// TestAESGCMAADRoundtrip verifies EncryptAAD/DecryptAAD restore the
// plaintext when the same AAD is supplied on both sides.
pub fn TestAESGCMAADRoundtrip() {
    aes := encrypt.NewAES(aesKey128)
    aad := "header:v1"
    enc, e1 := aes.EncryptAAD("hello world", 11, aad, 9)
    if e1.message != "" {
        Errorf("EncryptAAD should not error: " + e1.message)
    }
    dec, e2 := aes.DecryptAAD(enc.data, enc.length, aad, 9)
    if e2.message != "" {
        Errorf("DecryptAAD should not error: " + e2.message)
    }
    if dec.length != 11 || bytesEqual(dec.data, "hello world", 11) == false {
        Errorf("AAD roundtrip should restore plaintext")
    }
}

// TestAESGCMAADMismatch verifies the GCM tag covers the AAD: decrypting
// with a different AAD must fail authentication.
pub fn TestAESGCMAADMismatch() {
    aes := encrypt.NewAES(aesKey128)
    enc, e1 := aes.EncryptAAD("secret", 6, "v1", 2)
    if e1.message != "" {
        Errorf("EncryptAAD should not error: " + e1.message)
    }
    _, e2 := aes.DecryptAAD(enc.data, enc.length, "v2", 2)
    if e2.message == "" {
        Errorf("DecryptAAD with wrong AAD should fail authentication")
    }
}

// TestAESGCMAADRequired verifies AAD-bound ciphertext cannot be opened
// without the AAD, and AAD-less ciphertext rejects a supplied AAD.
pub fn TestAESGCMAADRequired() {
    aes := encrypt.NewAES(aesKey128)
    enc, _ := aes.EncryptAAD("secret", 6, "meta", 4)
    _, e1 := aes.Decrypt(enc.data, enc.length)
    if e1.message == "" {
        Errorf("Decrypt without AAD should reject AAD-bound ciphertext")
    }
    enc2, _ := aes.Encrypt("secret", 6)
    _, e2 := aes.DecryptAAD(enc2.data, enc2.length, "meta", 4)
    if e2.message == "" {
        Errorf("DecryptAAD with AAD should reject AAD-less ciphertext")
    }
}

// TestAESGCMAADEmpty verifies EncryptAAD with aadLen 0 produces a
// ciphertext the no-AAD Decrypt accepts — an empty AAD is no AAD.
pub fn TestAESGCMAADEmpty() {
    aes := encrypt.NewAES(aesKey128)
    enc, e1 := aes.EncryptAAD("data", 4, "", 0)
    if e1.message != "" {
        Errorf("EncryptAAD with empty AAD should not error: " + e1.message)
    }
    dec, e2 := aes.Decrypt(enc.data, enc.length)
    if e2.message != "" {
        Errorf("Decrypt of empty-AAD ciphertext should not error: " + e2.message)
    }
    if dec.length != 4 || bytesEqual(dec.data, "data", 4) == false {
        Errorf("empty-AAD roundtrip should restore plaintext")
    }
}

// --- RSA key generation and signing ---

// TestRSAKeyGenerate verifies GenerateRSAKeyPair emits PEM-labelled keys
// that round-trip through Encrypt/Decrypt.
pub fn TestRSAKeyGenerate() {
    kp, e := encrypt.GenerateRSAKeyPair(2048)
    if e.message != "" {
        Errorf("GenerateRSAKeyPair should not error: " + e.message)
    }
    if str.Contains(kp.publicKey, "BEGIN PUBLIC KEY") == false {
        Errorf("generated public key should carry the PUBLIC KEY PEM label")
    }
    if str.Contains(kp.privateKey, "BEGIN RSA PRIVATE KEY") == false {
        Errorf("generated private key should carry the RSA PRIVATE KEY PEM label")
    }
    rsa := encrypt.NewRSA(kp.publicKey, kp.privateKey)
    enc, e1 := rsa.Encrypt("hi", 2)
    if e1.message != "" {
        Errorf("generated-pair Encrypt should not error: " + e1.message)
    }
    dec, e2 := rsa.Decrypt(enc.data, enc.length)
    if e2.message != "" {
        Errorf("generated-pair Decrypt should not error: " + e2.message)
    }
    if dec.length != 2 || bytesEqual(dec.data, "hi", 2) == false {
        Errorf("generated RSA pair should round-trip plaintext")
    }
}

// TestRSAKeyGenerateRejectsSmallBits guards the modulus-size floor:
// below 512 bits a SHA-256 DigestInfo cannot fit a v1.5 signature.
pub fn TestRSAKeyGenerateRejectsSmallBits() {
    _, e := encrypt.GenerateRSAKeyPair(256)
    if e.message == "" {
        Errorf("GenerateRSAKeyPair(256) should be rejected")
    }
}

// TestRSAKeyGenerateUnique verifies successive generations produce
// different key material.
pub fn TestRSAKeyGenerateUnique() {
    a, _ := encrypt.GenerateRSAKeyPair(1024)
    b, _ := encrypt.GenerateRSAKeyPair(1024)
    if str.Equal(a.publicKey, b.publicKey) {
        Errorf("two generated key pairs should differ")
    }
}

// TestRSASignVerify verifies Sign→Verify across separate private/public
// cipher instances built from a generated pair.
pub fn TestRSASignVerify() {
    kp, e := encrypt.GenerateRSAKeyPair(2048)
    if e.message != "" {
        Errorf("GenerateRSAKeyPair should not error: " + e.message)
    }
    signer := encrypt.NewRSA("", kp.privateKey)
    verifier := encrypt.NewRSA(kp.publicKey, "")
    msg := "sign this message"
    sig, e1 := signer.Sign(msg, str.Len(msg))
    if e1.message != "" {
        Errorf("RSA Sign should not error: " + e1.message)
    }
    if sig.length != 256 {
        Errorf("2048-bit RSA signature should be 256 bytes, got " + strconv.Itoa(sig.length))
    }
    ok, e2 := verifier.Verify(msg, str.Len(msg), sig.data, sig.length)
    if e2.message != "" {
        Errorf("RSA Verify should not error: " + e2.message)
    }
    if ok == false {
        Errorf("valid signature should verify")
    }
}

// TestRSASignVerifyStaticKey exercises Sign/Verify on the fixed PEM pair.
pub fn TestRSASignVerifyStaticKey() {
    rsa := encrypt.NewRSA(rsaPubKey, rsaPrivKey)
    msg := "static key message"
    sig, e1 := rsa.Sign(msg, str.Len(msg))
    if e1.message != "" {
        Errorf("Sign with static key should not error: " + e1.message)
    }
    ok, _ := rsa.Verify(msg, str.Len(msg), sig.data, sig.length)
    if ok == false {
        Errorf("static-key signature should verify")
    }
}

// TestRSASignVerifyTamperedMessage verifies a signature does not verify
// against a modified message.
pub fn TestRSASignVerifyTamperedMessage() {
    rsa := encrypt.NewRSA(rsaPubKey, rsaPrivKey)
    sig, _ := rsa.Sign("original", 8)
    ok, _ := rsa.Verify("originaL", 8, sig.data, sig.length)
    if ok {
        Errorf("signature for a different message should not verify")
    }
}

// TestRSASignVerifyTamperedSig verifies flipping a signature byte fails
// verification.
pub fn TestRSASignVerifyTamperedSig() {
    rsa := encrypt.NewRSA(rsaPubKey, rsaPrivKey)
    msg := "immutable"
    sig, _ := rsa.Sign(msg, str.Len(msg))
    Skink_mem_write_byte(sig.data, int64(0), (int(Skink_mem_byte(sig.data, int64(0))) + 1) % 256)
    ok, _ := rsa.Verify(msg, str.Len(msg), sig.data, sig.length)
    if ok {
        Errorf("corrupted signature should not verify")
    }
}

// TestRSASignVerifyWrongKey verifies a signature does not verify under
// an unrelated public key.
pub fn TestRSASignVerifyWrongKey() {
    kp, _ := encrypt.GenerateRSAKeyPair(2048)
    signer := encrypt.NewRSA("", kp.privateKey)
    msg := "authentic"
    sig, e1 := signer.Sign(msg, str.Len(msg))
    if e1.message != "" {
        Errorf("Sign should not error: " + e1.message)
    }
    verifier := encrypt.NewRSA(rsaPubKey, "")
    ok, _ := verifier.Verify(msg, str.Len(msg), sig.data, sig.length)
    if ok {
        Errorf("signature should not verify under a different key")
    }
}

// TestRSASignNoPrivateKey verifies signing requires a private key.
pub fn TestRSASignNoPrivateKey() {
    rsa := encrypt.NewRSA(rsaPubKey, "")
    _, e := rsa.Sign("msg", 3)
    if e.message == "" {
        Errorf("Sign without private key should fail")
    }
}

// TestRSAVerifyNoPublicKey verifies verification requires a public key.
pub fn TestRSAVerifyNoPublicKey() {
    rsa := encrypt.NewRSA("", rsaPrivKey)
    _, e := rsa.Verify("msg", 3, "sig", 3)
    if e.message == "" {
        Errorf("Verify without public key should fail")
    }
}
