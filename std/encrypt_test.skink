module encrypt_test

import "std/encrypt"
extern fn Skink_mem_write_byte(ptr: string, idx: int64, val: int)
extern fn Skink_mem_byte(ptr: string, idx: int64) -> int
import "std/libc"
import "std/str"
import "std/strconv"
import "testing"

// Test AES key must be exactly 16, 24, or 32 bytes.
const aesKey128 = "0123456789abcdef"
const aesKey256 = "0123456789abcdef0123456789abcdef"

