module resolver

import "std/ast"
import "std/lexer"
import "std/parser"
import "std/str"

extern fn fopen(path: string, mode: string) -> int64
extern fn fclose(fp: int64) -> int
extern fn fread(buf: string, size: int64, count: int64, fp: int64) -> int
extern fn fseek(fp: int64, offset: int64, whence: int) -> int
extern fn ftell(fp: int64) -> int64
extern fn getenv(name: string) -> string
extern fn Skink_fs_isdir(path: string) -> int
extern fn Skink_fs_opendir(path: string) -> int64
extern fn Skink_fs_readdir(dir: int64, buf: string, bufSize: int, isDir: string) -> int
extern fn Skink_fs_closedir(dir: int64) -> int

// FileInfo holds the parsed contents of a single resolved source file.
struct FileInfo {
    path: string  // the path
    moduleName: string  // the module name
    declarations: []ast.Stmt  // the declarations
}

// Resolver tracks loaded files, their load state (unvisited / in-progress /
// done), accumulated errors, and the standard-library search root.
struct Resolver {
    files: []FileInfo  // the files
    states: map[string]int  // the states
    fileModules: map[string]string  // normalized file path -> declared module name
    errors: []string  // the errors
    searchRoot: string  // the search root
}

// joinPath concatenates two path components, inserting a "/" separator
// only when the first component is non-empty and does not already end with "/".
fn joinPath(a: string, b: string) -> string {
    if str.Len(a) == 0 {
        return b
    }
    if str.Substr(a, str.Len(a) - 1, 1) == "/" {
        return str.Concat(a, b)
    }
    return str.Concat(str.Concat(a, "/"), b)
}

// lastSlash returns the index of the final "/" in p, or -1 if none.
fn lastSlash(p: string) -> int {
    for i := str.Len(p) - 1; i >= 0; i = i - 1 {
        if str.Substr(p, i, 1) == "/" {
            return i
        }
    }
    return -1
}

// dirName returns the directory portion of p, equivalent to POSIX dirname.
fn dirName(p: string) -> string {
    idx := lastSlash(p)
    if idx < 0 {
        return "."
    }
    if idx == 0 {
        return "/"
    }
    return str.Substr(p, 0, idx)
}

// baseName returns the final path component of p, equivalent to POSIX basename.
fn baseName(p: string) -> string {
    idx := lastSlash(p)
    if idx < 0 {
        return p
    }
    return str.Substr(p, idx + 1, str.Len(p) - idx - 1)
}

// normalizePath produces a canonical spelling of p by collapsing duplicate
// slashes, dropping "." components, and resolving ".." against earlier
// segments. The same physical file reached through different relative
// spellings (e.g. "./lib/x.skink" vs "././lib/x.skink") yields a single
// canonical path, which is what allows loadFile's state map to deduplicate
// diamond imports (comp_error.md #25).
fn normalizePath(p: string) -> string {
    if str.Len(p) == 0 {
        return p
    }
    absolute := str.StartsWith(p, "/")
    parts := str.Split(p, "/")
    var out []string
    for i := 0; i < len(parts); i = i + 1 {
        seg := parts[i]
        if str.Len(seg) == 0 || str.Equal(seg, ".") {
            continue
        }
        if str.Equal(seg, "..") {
            if len(out) > 0 && !str.Equal(out[len(out) - 1], "..") {
                // Pop the last segment: "a/b/.." → "a".
                var popped []string
                for j := 0; j < len(out) - 1; j = j + 1 {
                    popped = append(popped, out[j])
                }
                out = popped
            } else if !absolute {
                // Leading ".." in a relative path cannot be resolved.
                out = append(out, seg)
            }
            continue
        }
        out = append(out, seg)
    }
    result := str.Join(out, "/")
    if absolute {
        result = str.Concat("/", result)
    }
    if str.Len(result) == 0 {
        if absolute {
            return "/"
        }
        return "."
    }
    return result
}

// fileExists reports whether a regular file exists at the given path.
fn fileExists(p: string) -> bool {
    fp := fopen(p, "r")
    if fp == 0 {
        return false
    }
    fclose(fp)
    return true
}

// readFile reads the entire file at p into a string, or returns "" on failure.
fn readFile(p: string) -> string {
    path := str.Substr(p, 0, str.Len(p))
    mode := str.Substr("r", 0, 1)
    fp := fopen(path, mode)
    if fp == 0 {
        return ""
    }
    // Seek to end to measure size, then rewind.
    fseek(fp, int64(0), 2)
    size := ftell(fp)
    fseek(fp, int64(0), 0)
    if size <= 0 {
        fclose(fp)
        return ""
    }
    count := int(size)
    // Allocate one extra byte for a null terminator.
    buf := str.Repeat(" ", count + 1)
    got := fread(buf, 1, count, fp)
    fclose(fp)
    if got <= 0 {
        return ""
    }
    // Null-terminate the buffer so C string functions see the correct length.
    buf[got] = 0
    return buf
}

// tryPath attempts to locate a source file for importPath relative to base,
// checking three candidate locations: direct file, main.skink in a directory,
// and a file named after the last path component.
fn tryPath(base: string, importPath: string) -> string {
    candidate := joinPath(base, str.Concat(importPath, ".skink"))
    if fileExists(candidate) {
        return candidate
    }
    candidate = joinPath(joinPath(base, importPath), "main.skink")
    if fileExists(candidate) {
        return candidate
    }
    candidate = joinPath(joinPath(base, importPath), str.Concat(baseName(importPath), ".skink"))
    if fileExists(candidate) {
        return candidate
    }
    return ""
}

// dirExists reports whether a directory exists at the given path.
fn dirExists(p: string) -> bool {
    return Skink_fs_isdir(p) != 0
}

// listDirNames returns the entry names inside directory p.
// If dirsOnly is true, only subdirectories are returned; otherwise only files.
fn listDirNames(p: string, dirsOnly: bool) -> []string {
    var result []string
    dir := Skink_fs_opendir(p)
    if dir == 0 {
        return result
    }
    nameBuf := str.Repeat(" ", 260)
    isDirBuf := str.Repeat(" ", 8)
    for {
        rc := Skink_fs_readdir(dir, nameBuf, 256, isDirBuf)
        if rc <= 0 {
            break
        }
        n := str.Len(nameBuf)
        if n == 0 {
            continue
        }
        name := str.Substr(nameBuf, 0, n)
        if str.StartsWith(name, ".") {
            continue
        }
        isDir := int(isDirBuf[0]) != 0
        if dirsOnly && isDir {
            result = append(result, name)
        } else if !dirsOnly && !isDir {
            result = append(result, name)
        }
    }
    Skink_fs_closedir(dir)
    return result
}

// parsePositiveInt parses a non-negative decimal integer string, returning -1 on error.
fn parsePositiveInt(s: string) -> int {
    t := str.Trim(s)
    n := str.Len(t)
    if n == 0 {
        return -1
    }
    val := 0
    for i := 0; i < n; i = i + 1 {
        c := int(t[i])
        if c < 48 || c > 57 {
            return -1
        }
        val = val * 10 + (c - 48)
    }
    return val
}

// parseSemverParts extracts (major, minor, patch, preRelease, valid) from a version string.
fn parseSemverParts(raw: string) -> (int, int, int, string, bool) {
    s := str.Trim(raw)
    if str.StartsWith(s, "v") || str.StartsWith(s, "V") {
        s = str.Substr(s, 1, str.Len(s) - 1)
    }
    plusIdx := str.IndexOf(s, "+")
    if plusIdx >= 0 {
        s = str.Substr(s, 0, plusIdx)
    }
    pre := ""
    dashIdx := str.IndexOf(s, "-")
    if dashIdx >= 0 {
        pre = str.Substr(s, dashIdx + 1, str.Len(s) - dashIdx - 1)
        s = str.Substr(s, 0, dashIdx)
    }
    parts := str.Split(s, ".")
    if len(parts) < 1 || len(parts) > 3 {
        return 0, 0, 0, pre, false
    }
    maj := parsePositiveInt(parts[0])
    if maj < 0 {
        return 0, 0, 0, pre, false
    }
    min := 0
    if len(parts) >= 2 {
        min = parsePositiveInt(parts[1])
        if min < 0 {
            return 0, 0, 0, pre, false
        }
    }
    pat := 0
    if len(parts) == 3 {
        pat = parsePositiveInt(parts[2])
        if pat < 0 {
            return 0, 0, 0, pre, false
        }
    }
    return maj, min, pat, pre, true
}

// compareVersions compares two version strings according to SemVer precedence.
fn compareVersions(a: string, b: string) -> int {
    amaj, amin, apat, apre, aok := parseSemverParts(a)
    bmaj, bmin, bpat, bpre, bok := parseSemverParts(b)
    if aok && !bok {
        return 1
    }
    if !aok && bok {
        return -1
    }
    if !aok && !bok {
        return str.Compare(a, b)
    }
    if amaj != bmaj {
        if amaj < bmaj { return -1 }
        return 1
    }
    if amin != bmin {
        if amin < bmin { return -1 }
        return 1
    }
    if apat != bpat {
        if apat < bpat { return -1 }
        return 1
    }
    if str.Len(apre) == 0 && str.Len(bpre) == 0 {
        return 0
    }
    if str.Len(apre) == 0 {
        return 1
    }
    if str.Len(bpre) == 0 {
        return -1
    }
    return str.Compare(apre, bpre)
}

// matchesConstraint checks whether candidate satisfies a version constraint
// from an import specifier or skink.toml.
fn matchesConstraint(candidate: string, constraint: string) -> bool {
    c := str.Trim(constraint)
    if str.Len(c) == 0 || str.Equal(c, "*") || str.Equal(c, "latest") {
        return true
    }
    cmaj, cmin, cpat, _, cok := parseSemverParts(candidate)
    if !cok {
        return str.Equal(candidate, c)
    }
    if str.StartsWith(c, "^") {
        tmaj, tmin, tpat, _, tok := parseSemverParts(str.Substr(c, 1, str.Len(c) - 1))
        if !tok || compareVersions(candidate, str.Substr(c, 1, str.Len(c) - 1)) < 0 {
            return false
        }
        if tmaj > 0 { return cmaj == tmaj }
        if tmin > 0 { return cmaj == 0 && cmin == tmin }
        return cmaj == 0 && cmin == 0 && cpat == tpat
    }
    if str.StartsWith(c, "~") {
        tmaj, tmin, _, _, tok := parseSemverParts(str.Substr(c, 1, str.Len(c) - 1))
        if !tok || compareVersions(candidate, str.Substr(c, 1, str.Len(c) - 1)) < 0 {
            return false
        }
        return cmaj == tmaj && cmin == tmin
    }
    if str.StartsWith(c, ">=") {
        return compareVersions(candidate, str.Substr(c, 2, str.Len(c) - 2)) >= 0
    }
    if str.StartsWith(c, "<=") {
        return compareVersions(candidate, str.Substr(c, 2, str.Len(c) - 2)) <= 0
    }
    if str.StartsWith(c, ">") {
        return compareVersions(candidate, str.Substr(c, 1, str.Len(c) - 1)) > 0
    }
    if str.StartsWith(c, "<") {
        return compareVersions(candidate, str.Substr(c, 1, str.Len(c) - 1)) < 0
    }
    if str.StartsWith(c, "=") {
        return compareVersions(candidate, str.Substr(c, 1, str.Len(c) - 1)) == 0
    }
    return compareVersions(candidate, c) == 0
}

// unquoteToml strips surrounding quotes from a TOML string literal.
fn unquoteToml(s: string) -> string {
    t := str.Trim(s)
    n := str.Len(t)
    if n >= 2 && ((t[0] == 34 && t[n - 1] == 34) || (t[0] == 39 && t[n - 1] == 39)) {
        return str.Substr(t, 1, n - 2)
    }
    return t
}

// lookupManifestVersion walks up from baseDir looking for skink.lock or
// skink.toml (or skink.mod) to find a pinned or constrained version for
// mod/<owner>/<repo>, plus any manifest entry file when inspecting a package dir.
fn lookupManifestVersion(baseDir: string, owner: string, repo: string) -> string {
    modKey := str.Concat("mod/", str.Concat(owner, str.Concat("/", repo)))
    shortKey := str.Concat(owner, str.Concat("/", repo))
    cur := baseDir
    for {
        // 1. Check skink.lock first for an exact pinned version.
        lockPath := joinPath(cur, "skink.lock")
        if fileExists(lockPath) {
            lockSrc := readFile(lockPath)
            lines := str.Split(lockSrc, "\n")
            curName := ""
            curVer := ""
            for i := 0; i < len(lines); i = i + 1 {
                line := str.Trim(str.Replace(lines[i], "\r", ""))
                if str.Equal(line, "[[package]]") {
                    if (str.Equal(curName, modKey) || str.Equal(curName, shortKey)) && str.Len(curVer) > 0 {
                        return curVer
                    }
                    curName = ""
                    curVer = ""
                } else {
                    eq := str.IndexOf(line, "=")
                    if eq > 0 {
                        k := unquoteToml(str.Substr(line, 0, eq))
                        v := unquoteToml(str.Substr(line, eq + 1, str.Len(line) - eq - 1))
                        if str.Equal(k, "name") || str.Equal(k, "key") {
                            curName = v
                        } else if str.Equal(k, "version") {
                            curVer = v
                        }
                    }
                }
            }
            if (str.Equal(curName, modKey) || str.Equal(curName, shortKey)) && str.Len(curVer) > 0 {
                return curVer
            }
        }
        // 2. Check skink.toml [dependencies] section.
        tomlPath := joinPath(cur, "skink.toml")
        if fileExists(tomlPath) {
            tomlSrc := readFile(tomlPath)
            lines := str.Split(tomlSrc, "\n")
            inDeps := false
            for i := 0; i < len(lines); i = i + 1 {
                line := str.Trim(str.Replace(lines[i], "\r", ""))
                if str.StartsWith(line, "#") || str.Len(line) == 0 {
                    continue
                }
                if str.StartsWith(line, "[") && str.EndsWith(line, "]") {
                    sec := str.Trim(str.Substr(line, 1, str.Len(line) - 2))
                    inDeps = str.Equal(sec, "dependencies")
                    continue
                }
                if inDeps {
                    eq := str.IndexOf(line, "=")
                    if eq > 0 {
                        k := unquoteToml(str.Substr(line, 0, eq))
                        v := str.Trim(str.Substr(line, eq + 1, str.Len(line) - eq - 1))
                        if str.Equal(k, modKey) || str.Equal(k, shortKey) {
                            if str.StartsWith(v, "{") {
                                vIdx := str.IndexOf(v, "version")
                                if vIdx >= 0 {
                                    rest := str.Substr(v, vIdx + 7, str.Len(v) - vIdx - 7)
                                    veq := str.IndexOf(rest, "=")
                                    if veq >= 0 {
                                        afterEq := str.Substr(rest, veq + 1, str.Len(rest) - veq - 1)
                                        comma := str.IndexOf(afterEq, ",")
                                        if comma >= 0 {
                                            afterEq = str.Substr(afterEq, 0, comma)
                                        }
                                        brace := str.IndexOf(afterEq, "}")
                                        if brace >= 0 {
                                            afterEq = str.Substr(afterEq, 0, brace)
                                        }
                                        return unquoteToml(afterEq)
                                    }
                                }
                            } else {
                                return unquoteToml(v)
                            }
                        }
                    }
                }
            }
        }
        parent := dirName(cur)
        if str.Equal(parent, cur) {
            break
        }
        cur = parent
    }
    return ""
}

// readPackageEntryField reads the optional `entry = "..."` field from
// `<pkgDir>/skink.toml` if present.
fn readPackageEntryField(pkgDir: string) -> string {
    tomlPath := joinPath(pkgDir, "skink.toml")
    if !fileExists(tomlPath) {
        return ""
    }
    tomlSrc := readFile(tomlPath)
    lines := str.Split(tomlSrc, "\n")
    inPkg := false
    for i := 0; i < len(lines); i = i + 1 {
        line := str.Trim(str.Replace(lines[i], "\r", ""))
        if str.StartsWith(line, "[") && str.EndsWith(line, "]") {
            sec := str.Trim(str.Substr(line, 1, str.Len(line) - 2))
            inPkg = str.Equal(sec, "package")
            continue
        }
        if inPkg {
            eq := str.IndexOf(line, "=")
            if eq > 0 {
                k := unquoteToml(str.Substr(line, 0, eq))
                if str.Equal(k, "entry") {
                    return unquoteToml(str.Substr(line, eq + 1, str.Len(line) - eq - 1))
                }
            }
        }
    }
    return ""
}

// resolvePackageEntryFile locates the .skink entry file inside an extracted
// package directory (and optional subpath).
fn resolvePackageEntryFile(pkgDir: string, repo: string, subpath: string) -> string {
    targetDir := pkgDir
    if str.Len(subpath) > 0 {
        direct := tryPath(pkgDir, subpath)
        if str.Len(direct) > 0 {
            return direct
        }
        targetDir = joinPath(pkgDir, subpath)
    } else {
        entryField := readPackageEntryField(pkgDir)
        if str.Len(entryField) > 0 {
            entryPath := joinPath(pkgDir, entryField)
            if fileExists(entryPath) {
                return entryPath
            }
        }
    }

    // 1. <repo>.skink
    c1 := joinPath(targetDir, str.Concat(repo, ".skink"))
    if fileExists(c1) {
        return c1
    }
    // 2. Sanitized <repo_underscore>.skink
    sanitized := str.Replace(str.Replace(repo, "-", "_"), ".", "_")
    c2 := joinPath(targetDir, str.Concat(sanitized, ".skink"))
    if fileExists(c2) {
        return c2
    }
    // 3. Stripped "skink-" prefix (e.g. "skink-orm" -> "orm.skink")
    if str.StartsWith(repo, "skink-") && str.Len(repo) > 6 {
        shortName := str.Substr(repo, 6, str.Len(repo) - 6)
        c3 := joinPath(targetDir, str.Concat(shortName, ".skink"))
        if fileExists(c3) {
            return c3
        }
    }
    // 4. lib.skink or main.skink
    c4 := joinPath(targetDir, "lib.skink")
    if fileExists(c4) {
        return c4
    }
    c5 := joinPath(targetDir, "main.skink")
    if fileExists(c5) {
        return c5
    }
    // 5. src/ subdirectory
    srcDir := joinPath(targetDir, "src")
    if dirExists(srcDir) {
        s1 := joinPath(srcDir, str.Concat(repo, ".skink"))
        if fileExists(s1) { return s1 }
        s2 := joinPath(srcDir, str.Concat(sanitized, ".skink"))
        if fileExists(s2) { return s2 }
        s3 := joinPath(srcDir, "lib.skink")
        if fileExists(s3) { return s3 }
        s4 := joinPath(srcDir, "main.skink")
        if fileExists(s4) { return s4 }
    }
    // 6. First non-test .skink file in targetDir
    files := listDirNames(targetDir, false)
    for i := 0; i < len(files); i = i + 1 {
        f := files[i]
        if str.EndsWith(f, ".skink") && !str.EndsWith(f, "_test.skink") {
            return joinPath(targetDir, f)
        }
    }
    return ""
}

// resolveModImport resolves a third-party package import of the form
// `import "mod/<github_owner>/<repo_name>[@version][/<subpath>]"` against
// the project's skink.toml / skink.lock and the local scales package cache.
fn resolveModImport(r: *Resolver, importPath: string, baseDir: string) -> string {
    normImp := str.Replace(importPath, "\\", "/")
    if !str.StartsWith(normImp, "mod/") {
        return ""
    }
    rest := str.Substr(normImp, 4, str.Len(normImp) - 4)
    parts := str.Split(rest, "/")
    if len(parts) < 2 {
        return ""
    }
    owner := parts[0]
    repoAndVer := parts[1]
    repo := repoAndVer
    version := ""
    atIdx := str.IndexOf(repoAndVer, "@")
    if atIdx >= 0 {
        repo = str.Substr(repoAndVer, 0, atIdx)
        version = str.Substr(repoAndVer, atIdx + 1, str.Len(repoAndVer) - atIdx - 1)
    }
    var subParts []string
    for i := 2; i < len(parts); i = i + 1 {
        seg := parts[i]
        if i == len(parts) - 1 && str.Len(version) == 0 {
            segAt := str.IndexOf(seg, "@")
            if segAt >= 0 {
                version = str.Substr(seg, segAt + 1, str.Len(seg) - segAt - 1)
                seg = str.Substr(seg, 0, segAt)
            }
        }
        if str.Len(seg) > 0 {
            subParts = append(subParts, seg)
        }
    }
    subpath := str.Join(subParts, "/")
    if str.Len(owner) == 0 || str.Len(repo) == 0 {
        return ""
    }

    // If @version was omitted in source code, check skink.lock / skink.toml.
    constraint := version
    if str.Len(constraint) == 0 {
        constraint = lookupManifestVersion(baseDir, owner, repo)
    }
    if str.Len(constraint) == 0 {
        constraint = "latest"
    }

    // Collect candidate scales cache roots in priority order.
    var cacheRoots []string
    envCache := getenv("SCALES_CACHE_DIR")
    if int64(envCache) != 0 && str.Len(envCache) > 0 {
        cacheRoots = append(cacheRoots, str.Replace(envCache, "\\", "/"))
    }
    envPrefix := getenv("SKINK_PREFIX")
    if int64(envPrefix) != 0 && str.Len(envPrefix) > 0 {
        cacheRoots = append(cacheRoots, joinPath(str.Replace(envPrefix, "\\", "/"), "scales"))
    }
    if str.Len(r.searchRoot) > 0 {
        cacheRoots = append(cacheRoots, joinPath(dirName(r.searchRoot), "scales"))
    }
    home := getenv("HOME")
    if int64(home) != 0 && str.Len(home) > 0 {
        cacheRoots = append(cacheRoots, joinPath(str.Replace(home, "\\", "/"), ".local/skink/scales"))
    }
    userProfile := getenv("USERPROFILE")
    if int64(userProfile) != 0 && str.Len(userProfile) > 0 {
        cacheRoots = append(cacheRoots, joinPath(str.Replace(userProfile, "\\", "/"), ".local/skink/scales"))
    }

    for ri := 0; ri < len(cacheRoots); ri = ri + 1 {
        repoDir := joinPath(joinPath(joinPath(cacheRoots[ri], "packages"), owner), repo)
        if !dirExists(repoDir) {
            continue
        }
        vers := listDirNames(repoDir, true)
        if len(vers) == 0 {
            continue
        }
        // Sort cached versions descending (newest first) and pick the highest
        // version satisfying the constraint.
        for a := 0; a < len(vers); a = a + 1 {
            for b := a + 1; b < len(vers); b = b + 1 {
                if compareVersions(vers[b], vers[a]) > 0 {
                    tmp := vers[a]
                    vers[a] = vers[b]
                    vers[b] = tmp
                }
            }
        }
        for vi := 0; vi < len(vers); vi = vi + 1 {
            if matchesConstraint(vers[vi], constraint) {
                pkgDir := joinPath(repoDir, vers[vi])
                entry := resolvePackageEntryFile(pkgDir, repo, subpath)
                if str.Len(entry) > 0 {
                    return entry
                }
            }
        }
    }
    return ""
}

// resolveImport searches for the physical file backing an import path,
// walking up the directory tree and checking vendor, cache, scales, and std dirs.
fn resolveImport(r: *Resolver, importPath: string, baseDir: string) -> string {
    // C: imports are special C-linkage declarations, not Skink files.
    if str.StartsWith(importPath, "C:") {
        return ""
    }
    // Resolve third-party `mod/<owner>/<repo>[@version]` imports via scales cache.
    if str.StartsWith(importPath, "mod/") {
        modCandidate := resolveModImport(r, importPath, baseDir)
        if str.Len(modCandidate) > 0 {
            return modCandidate
        }
        // Also strip @version when falling back to local vendor/ or .skink/cache/ directories.
        atIdx := str.IndexOf(importPath, "@")
        if atIdx >= 0 {
            importPath = str.Substr(importPath, 0, atIdx)
        }
    }
    // Rewrite the bare "testing" import to its canonical std path.
    if str.Equal(importPath, "testing") {
        importPath = "std/testing"
    }
    // For std/ imports, first check an overlay directory derived from searchRoot.
    if str.StartsWith(importPath, "std/") && str.Len(r.searchRoot) > 0 {
        overlay := dirName(r.searchRoot)
        candidate := tryPath(overlay, importPath)
        if str.Len(candidate) > 0 {
            return candidate
        }
    }
    // Try the importing file's own directory first.
    candidate := tryPath(baseDir, importPath)
    if str.Len(candidate) > 0 {
        return candidate
    }

    // Walk up the directory tree, checking vendor, cache, and std at each level.
    current := baseDir
    for {
        candidate = tryPath(joinPath(current, "vendor"), importPath)
        if str.Len(candidate) > 0 {
            return candidate
        }
        candidate = tryPath(joinPath(joinPath(current, ".skink"), "cache"), importPath)
        if str.Len(candidate) > 0 {
            return candidate
        }
        candidate = tryPath(joinPath(current, "std"), importPath)
        if str.Len(candidate) > 0 {
            return candidate
        }
        candidate = tryPath(current, importPath)
        if str.Len(candidate) > 0 {
            return candidate
        }
        // Stop when we reach the filesystem root (dirname returns itself).
        parent := dirName(current)
        if str.Equal(parent, current) {
            break
        }
        current = parent
    }

    // Final fallback: check the configured search root and its cache subdirectory.
    if str.Len(r.searchRoot) > 0 {
        candidate = tryPath(r.searchRoot, importPath)
        if str.Len(candidate) > 0 {
            return candidate
        }
        candidate = tryPath(joinPath(r.searchRoot, "cache"), importPath)
        if str.Len(candidate) > 0 {
            return candidate
        }
    }
    return ""
}

// addError appends an error message to the resolver's error list.
fn addError(r: *Resolver, message: string) {
    r.errors = append(r.errors, message)
}

// qualify prefixes a declaration name with its module name, unless the
// module is "main" or the name already contains a dot qualifier.
fn qualify(moduleName: string, name: string) -> string {
    if str.Len(moduleName) == 0 || str.Equal(moduleName, "main") || str.Contains(name, ".") {
        return name
    }
    return str.Concat(str.Concat(moduleName, "."), name)
}

// qualifyDeclaration rewrites the name field of a single top-level
// declaration so it is qualified with the owning module name.
fn qualifyDeclaration(stmt: *ast.Stmt, moduleName: string) {
    d := stmt.decl
    // Record the owning module on every declaration so downstream passes
    // (emitter module-context switches, library-main detection) can
    // recover it without tracking ambient state (comp_error.md #117).
    d.moduleName = moduleName
    if stmt.kind == ast.ST_FN {
        d.fnName = qualify(moduleName, d.fnName)
    } else if stmt.kind == ast.ST_STRUCT {
        d.structName = qualify(moduleName, d.structName)
    } else if stmt.kind == ast.ST_ENUM {
        d.enumName = qualify(moduleName, d.enumName)
    } else if stmt.kind == ast.ST_CONST {
        // Block-form const declarations have no single name — qualify()
        // would turn "" into "module.", colliding across blocks.
        if str.Len(d.constName) > 0 {
            d.constName = qualify(moduleName, d.constName)
        }
        // Qualify every constant inside a const block as well.
        for i := 0; i < len(d.constBlock); i = i + 1 {
            d.constBlock[i].name = qualify(moduleName, d.constBlock[i].name)
        }
    } else if stmt.kind == ast.ST_VARDECL {
        stmt.varName = qualify(moduleName, stmt.varName)
    } else if stmt.kind == ast.ST_TYPEALIAS {
        d.aliasName = qualify(moduleName, d.aliasName)
    } else if stmt.kind == ast.ST_EXTERN {
        d.fnName = qualify(moduleName, d.fnName)
    } else if stmt.kind == ast.ST_TEMPLATE {
        d.templateName = qualify(moduleName, d.templateName)
    } else if stmt.kind == ast.ST_RULESET {
        d.rulesetName = qualify(moduleName, d.rulesetName)
    } else if stmt.kind == ast.ST_SERVICE {
        d.serviceName = qualify(moduleName, d.serviceName)
    }
    stmt.decl = d
}

// loadFile parses a single source file, recursively loads its imports,
// qualifies all declarations, and records the result in the resolver.
// State 0 = unvisited, 1 = in-progress (used for cycle detection), 2 = done.
fn loadFile(r: *Resolver, filePath: string) {
    // Canonicalize so that the same file reached via different textual
    // paths (diamond imports like ./x and ././x) deduplicates correctly.
    filePath = normalizePath(filePath)
    state := r.states[filePath]
    if state == 2 {
        return
    }
    // State 1 means we re-entered a file currently being loaded → import cycle.
    if state == 1 {
        addError(r, str.Concat(str.Concat(filePath, " 0:0: import cycle involving "), filePath))
        return
    }
    r.states[filePath] = 1

    source := readFile(filePath)
    if str.Len(source) == 0 {
        addError(r, str.Concat(filePath, " 0:0: cannot read file"))
        r.states[filePath] = 2
        return
    }

    // Lex and parse the source file into top-level declarations.
    tokens := lexer.Tokenize(source)
    p := parser.New(tokens)
    declarations := parser.ParseFile(&p)
    parseErrors := parser.Errors(&p)
    if len(parseErrors) > 0 {
        for i := 0; i < len(parseErrors); i = i + 1 {
            addError(r, str.Concat(str.Concat(filePath, " "), parseErrors[i]))
        }
        r.states[filePath] = 2
        return
    }

    // Extract the module name and import list from the parsed declarations.
    moduleName := "main"
    for i := 0; i < len(declarations); i = i + 1 {
        stmt := declarations[i]
        if stmt.kind == ast.ST_MODULE {
            moduleName = stmt.decl.moduleName
        }
    }
    if str.Len(moduleName) == 0 {
        moduleName = "main"
    }
    r.fileModules[filePath] = moduleName

    // Recursively resolve and load every imported module.
    baseDir := dirName(filePath)
    for i := 0; i < len(declarations); i = i + 1 {
        stmt := declarations[i]
        if stmt.kind != ast.ST_IMPORT {
            continue
        }
        impPath := stmt.decl.importPath
        imported := resolveImport(r, impPath, baseDir)
        if str.Len(imported) == 0 {
            // Suppress errors for C: imports since they are not Skink files.
            if !str.StartsWith(impPath, "C:") {
                addError(r, str.Concat(str.Concat(filePath, " 0:0: cannot resolve import \""), str.Concat(impPath, "\"")))
            }
        } else {
            normImp := normalizePath(imported)
            loadFile(r, normImp)
            targetMod := r.fileModules[normImp]
            // Rewrite third-party `mod/<owner>/<repo>[@version]` import paths
            // so the trailing segment matches the resolved module's declared
            // module name for the checker and emitter.
            if (str.StartsWith(impPath, "mod/") || str.Contains(impPath, "@")) && str.Len(targetMod) > 0 && !str.Equal(targetMod, "main") {
                d := stmt.decl
                d.importPath = str.Concat("mod/", targetMod)
                stmt.decl = d
                declarations[i] = stmt
            }
        }
    }

    // Qualify all declarations with the module name before recording.
    for i := 0; i < len(declarations); i = i + 1 {
        stmt := declarations[i]
        stmt.filePath = filePath
        qualifyDeclaration(&stmt, moduleName)
        declarations[i] = stmt
    }
    r.files = append(r.files, FileInfo{path: filePath, moduleName: moduleName, declarations: declarations})
    r.states[filePath] = 2
}

// Resolve is the public entry point: given a root source file and the
// standard-library search root, it loads all transitive imports and
// returns the merged list of qualified top-level declarations.
pub fn Resolve(entry: string, searchRoot: string) -> ([]ast.Stmt, []string) {
    r := Resolver{}
    r.files = []FileInfo{}
    r.states = make(map[string]int)
    r.fileModules = make(map[string]string)
    r.errors = []string{}
    r.searchRoot = searchRoot
    if str.Len(entry) == 0 {
        addError(&r, str.Concat(entry, " 0:0: empty entry path"))
        return []ast.Stmt{}, r.errors
    }
    loadFile(&r, entry)

    // Flatten all loaded files' declarations into a single slice.
    // Files without an explicit `module` line get a synthetic module
    // declaration prepended so the checker resets its current module
    // between files (otherwise declarations from a module-less file would
    // be attributed to whatever module was processed before it).
    merged := []ast.Stmt{}
    for i := 0; i < len(r.files); i = i + 1 {
        hasModule := len(r.files[i].declarations) > 0 && r.files[i].declarations[0].kind == ast.ST_MODULE
        if !hasModule {
            d := ast.newDecl(ast.ST_MODULE)
            d.moduleName = r.files[i].moduleName
            modDecl := ast.Stmt{kind: ast.ST_MODULE, filePath: r.files[i].path, decl: d}
            merged = append(merged, modDecl)
        }
        for j := 0; j < len(r.files[i].declarations); j = j + 1 {
            merged = append(merged, r.files[i].declarations[j])
        }
    }
    return merged, r.errors
}
