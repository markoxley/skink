module builtin_args_test

import "testing"

// TestBuiltinValidCalls verifies len, append, copy, make, delete builtins.
pub fn TestBuiltinValidCalls() {
    s := "hello"
    testing.AssertEqualInt(5, len(s), "len(string)")
    a := []int{1, 2}
    testing.AssertEqualInt(2, len(a), "len(slice)")
    a = append(a, 3)
    testing.AssertEqualInt(3, len(a), "append grows")
    b := copy(a)
    testing.AssertEqualInt(3, len(b), "copy slice")
    m := make(map[string]int)
    m["k"] = 1
    delete(m, "k")
    testing.AssertEqualInt(0, len(m), "delete map key")
}
