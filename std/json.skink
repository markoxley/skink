module json

import "std/str"
import "std/errors"
import "std/strconv"
import "std/reflect"
import "std/base64"

// Value is a dynamic JSON value that can represent any JSON type.
// Use the kind field (0=null, 1=bool, 2=number, 3=string, 4=array, 5=object)
// to determine which fields are valid.
pub struct Value {
    kind: int  // the kind
    strVal: string  // the string value
    numVal: float  // the numeric value
    boolVal: bool  // the bool value
    arr: []Value  // the array elements
    objKeys: []string  // the object keys
    objVals: []Value  // the object values
}

// zeroValue returns a JSON Value initialized to the null kind.
fn zeroValue() -> Value {
    var emptyStr string
    var emptyArr []Value
    var emptyKeys []string
    var emptyVals []Value
    return Value{kind: 0, strVal: emptyStr, numVal: 0.0, boolVal: false, arr: emptyArr, objKeys: emptyKeys, objVals: emptyVals}
}

// Constructors

// Null creates a JSON Value representing the null literal.
pub fn Null() -> Value {
    return zeroValue()
}

// FromBool creates a JSON Value representing a boolean.
pub fn FromBool(b: bool) -> Value {
    v := zeroValue()
    v.kind = 1
    v.boolVal = b
    return v
}

// FromNumber creates a JSON Value representing a floating-point number.
pub fn FromNumber(n: float) -> Value {
    v := zeroValue()
    v.kind = 2
    v.numVal = n
    return v
}

// FromString creates a JSON Value representing a string.
pub fn FromString(s: string) -> Value {
    v := zeroValue()
    v.kind = 3
    v.strVal = s
    return v
}

// FromArray creates a JSON Value representing an array of Values.
pub fn FromArray(arr: []Value) -> Value {
    v := zeroValue()
    v.kind = 4
    v.arr = arr
    return v
}

// FromObject creates a JSON Value representing an object with the given
// parallel key and value slices.
pub fn FromObject(keys: []string, vals: []Value) -> Value {
    v := zeroValue()
    v.kind = 5
    v.objKeys = keys
    v.objVals = vals
    return v
}

// Accessors

// Kind tags for the kind field — returned by Kind(v).
pub const KIND_NULL   = 0
pub const KIND_BOOL   = 1
pub const KIND_NUMBER = 2
pub const KIND_STRING = 3
pub const KIND_ARRAY  = 4
pub const KIND_OBJECT = 5

// Kind returns the value's kind tag (KIND_* constants).
pub fn Kind(v: Value) -> int {
    return v.kind
}

// IsNull returns true if the Value represents a JSON null.
pub fn IsNull(v: Value) -> bool {
    return v.kind == 0
}

// AsBool extracts the boolean value from a Value of kind 1.
pub fn AsBool(v: Value) -> bool {
    return v.boolVal
}

// AsNumber extracts the floating-point value from a Value of kind 2.
pub fn AsNumber(v: Value) -> float {
    return v.numVal
}

// AsString extracts the string value from a Value of kind 3.
pub fn AsString(v: Value) -> string {
    return v.strVal
}

// ArrayLen returns the number of elements in a JSON array Value.
pub fn ArrayLen(v: Value) -> int {
    return len(v.arr)
}

// ArrayGet returns the element at index i in a JSON array Value.
pub fn ArrayGet(v: Value, i: int) -> Value {
    return v.arr[i]
}

// ObjectLen returns the number of key-value pairs in a JSON object Value.
pub fn ObjectLen(v: Value) -> int {
    return len(v.objKeys)
}

// ObjectGet looks up a key in a JSON object Value, returning Null if not found.
pub fn ObjectGet(v: Value, key: string) -> Value {
    for i := 0; i < len(v.objKeys); i = i + 1 {
        if v.objKeys[i] == key {
            return v.objVals[i]
        }
    }
    // Key not found; return null sentinel
    return Null()
}

// ObjectGetByIndex returns the key and value at index i in a JSON object Value.
pub fn ObjectGetByIndex(v: Value, i: int) -> (string, Value) {
    return v.objKeys[i], v.objVals[i]
}

// --- Convenience Get helpers ---

// GetString retrieves a string field from a JSON object.
pub fn GetString(v: Value, key: string) -> string {
    field := ObjectGet(v, key)
    return AsString(field)
}

// GetNumber retrieves a number field from a JSON object.
pub fn GetNumber(v: Value, key: string) -> float {
    field := ObjectGet(v, key)
    return AsNumber(field)
}

// GetInt retrieves an integer field from a JSON object.
pub fn GetInt(v: Value, key: string) -> int {
    field := ObjectGet(v, key)
    return int(AsNumber(field))
}

// GetBool retrieves a boolean field from a JSON object.
pub fn GetBool(v: Value, key: string) -> bool {
    field := ObjectGet(v, key)
    return AsBool(field)
}

// GetObject retrieves a nested object field from a JSON object.
pub fn GetObject(v: Value, key: string) -> Value {
    return ObjectGet(v, key)
}

// GetArray retrieves an array field from a JSON object.
pub fn GetArray(v: Value, key: string) -> Value {
    return ObjectGet(v, key)
}

// --- Marshal ---

// MarshalValue serializes a Value into a JSON string.
pub fn MarshalValue(v: Value) -> string {
    return marshalValueInternal(v)
}

// marshalValueInternal dispatches serialization by Value kind.
fn marshalValueInternal(v: Value) -> string {
    if v.kind == 0 {
        return "null"
    }
    if v.kind == 1 {
        if v.boolVal {
            return "true"
        }
        return "false"
    }
    if v.kind == 2 {
        return floatToString(v.numVal)
    }
    if v.kind == 3 {
        return escapeString(v.strVal)
    }
    if v.kind == 4 {
        return marshalArray(v.arr)
    }
    if v.kind == 5 {
        return marshalObject(v.objKeys, v.objVals)
    }
    // Unknown kind; default to null
    return "null"
}

// marshalArray serializes a slice of Values as a JSON array string.
fn marshalArray(arr: []Value) -> string {
    res := "["
    n := len(arr)
    for i := 0; i < n; i = i + 1 {
        if i > 0 {
            // Separate elements with a comma
            res = str.Concat(res, ",")
        }
        res = str.Concat(res, marshalValueInternal(arr[i]))
    }
    res = str.Concat(res, "]")
    return res
}

// marshalObject serializes parallel key/value slices as a JSON object string.
fn marshalObject(keys: []string, vals: []Value) -> string {
    res := "{"
    n := len(keys)
    for i := 0; i < n; i = i + 1 {
        if i > 0 {
            // Separate pairs with a comma
            res = str.Concat(res, ",")
        }
        res = str.Concat(res, escapeString(keys[i]))
        res = str.Concat(res, ":")
        res = str.Concat(res, marshalValueInternal(vals[i]))
    }
    res = str.Concat(res, "}")
    return res
}

// escapeString wraps s in double quotes and escapes special characters
// per the JSON specification (RFC 8259).
fn escapeString(s: string) -> string {
    res := "\""
    n := str.Len(s)
    for i := 0; i < n; i = i + 1 {
        c := s[i]
        if c == 34 { // \"
            res = str.Concat(res, "\\\"")
        } else if c == 92 { // \
            res = str.Concat(res, "\\\\")
        } else if c == 8 { // \b
            res = str.Concat(res, "\\b")
        } else if c == 12 { // \f
            res = str.Concat(res, "\\f")
        } else if c == 10 { // \n
            res = str.Concat(res, "\\n")
        } else if c == 13 { // \r
            res = str.Concat(res, "\\r")
        } else if c == 9 { // \t
            res = str.Concat(res, "\\t")
        } else {
            // Pass through printable characters unchanged
            res = str.Concat(res, str.Substr(s, i, 1))
        }
    }
    res = str.Concat(res, "\"")
    return res
}

// floatToString converts a float to its JSON string representation.
// It emits up to 6 fractional digits, stripping trailing zeros.
fn floatToString(n: float) -> string {
    if n == 0.0 {
        return "0"
    }
    neg := false
    if n < 0.0 {
        neg = true
        n = -n
    }
    intPart := int(n)
    frac := n - float(intPart)
    res := intToString(intPart)
    if frac > 0.0001 {
        // Emit fractional digits one at a time
        res = str.Concat(res, ".")
        for i := 0; i < 6; i = i + 1 {
            frac = frac * 10.0
            d := int(frac)
            res = str.Concat(res, intToString(d))
            frac = frac - float(d)
            // Stop once remaining fraction is negligible
            if frac < 0.0001 {
                break
            }
        }
    }
    if neg {
        res = str.Concat("-", res)
    }
    return res
}

// intToString converts a non-negative integer to its decimal string form.
fn intToString(n: int) -> string {
    if n == 0 {
        return "0"
    }
    neg := false
    if n < 0 {
        neg = true
        n = -n
    }
    res := ""
    // Extract digits from least to most significant
    for n > 0 {
        d := n % 10
        res = str.Concat(charForDigit(d), res)
        n = n / 10
    }
    if neg {
        res = str.Concat("-", res)
    }
    return res
}

// charForDigit returns the single-character string for digit 0-9.
fn charForDigit(d: int) -> string {
    if d == 0 { return "0" }
    if d == 1 { return "1" }
    if d == 2 { return "2" }
    if d == 3 { return "3" }
    if d == 4 { return "4" }
    if d == 5 { return "5" }
    if d == 6 { return "6" }
    if d == 7 { return "7" }
    if d == 8 { return "8" }
    return "9"
}

// --- Unmarshal ---

// Unmarshal parses a JSON string into a Value. Returns an error if the
// input is not valid JSON or contains trailing data after the root value.
pub fn Unmarshal(s: string) -> (Value, errors.Error) {
    p := Parser{s: s, pos: 0, len: str.Len(s)}
    v := p.parseValue()
    if str.Len(p.errMsg) > 0 {
        // Parser encountered an error during parsing
        return v, errors.New(p.errMsg)
    }
    p.skipWhitespace()
    if p.pos != p.len {
        // Extra characters after the root value are not allowed
        return v, errors.New("invalid JSON: trailing data")
    }
    return v, errors.New("")
}

// Parser holds the state for JSON parsing: input, position, depth, and error.
struct Parser {
    s: string  // the input string
    pos: int  // the position
    len: int  // the length
    depth: int  // the depth
    errMsg: string  // the error message

    fn peek(self: *Parser) -> int {
        self.skipWhitespace()
        if self.pos >= self.len {
            return 0
        }
        return int(self.s[self.pos])
    }

    fn skipWhitespace(self: *Parser) {
        // Advance past spaces, tabs, newlines, and carriage returns
        for self.pos < self.len {
            c := self.s[self.pos]
            if c == 32 || c == 9 || c == 10 || c == 13 {
                self.pos = self.pos + 1
            } else {
                break
            }
        }
    }

    fn consume(self: *Parser) -> int {
        if self.pos >= self.len {
            return 0
        }
        c := self.s[self.pos]
        self.pos = self.pos + 1
        return int(c)
    }

    fn parseValue(self: *Parser) -> Value {
        self.skipWhitespace()
        if self.pos >= self.len {
            return Null()
        }
        // DoS protection: reject excessively deep nesting
        if self.depth > 1000 {
            self.errMsg = "JSON nesting depth exceeded"
            return Null()
        }
        // Dispatch based on the first character
        c := self.s[self.pos]
        if c == 123 { // {
            return self.parseObject()
        }
        if c == 91 { // [
            return self.parseArray()
        }
        if c == 34 { // \"
            return self.parseString()
        }
        if c == 116 { // t
            return self.parseTrue()
        }
        if c == 102 { // f
            return self.parseFalse()
        }
        if c == 110 { // n
            return self.parseNull()
        }
        // Default: treat as number
        return self.parseNumber()
    }

    fn parseObject(self: *Parser) -> Value {
        self.depth = self.depth + 1
        self.consume() // {
        var keys []string
        var vals []Value
        for {
            self.skipWhitespace()
            if self.pos < self.len && self.s[self.pos] == 125 { // }
                self.consume()
                break
            }
            // Keys must be strings in JSON
            keyVal := self.parseString()
            self.skipWhitespace()
            if self.pos < self.len && self.s[self.pos] == 58 { // :
                self.consume()
            }
            val := self.parseValue()
            keys = append(keys, keyVal.strVal)
            vals = append(vals, val)
            self.skipWhitespace()
            if self.pos < self.len && self.s[self.pos] == 44 { // ,
                self.consume()
            } else if self.pos < self.len && self.s[self.pos] == 125 { // }
                self.consume()
                break
            } else {
                break
            }
        }
        self.depth = self.depth - 1
        return FromObject(keys, vals)
    }

    fn parseArray(self: *Parser) -> Value {
        self.depth = self.depth + 1
        self.consume() // [
        var arr []Value
        for {
            self.skipWhitespace()
            if self.pos < self.len && self.s[self.pos] == 93 { // ]
                self.consume()
                break
            }
            val := self.parseValue()
            arr = append(arr, val)
            self.skipWhitespace()
            if self.pos < self.len && self.s[self.pos] == 44 { // ,
                self.consume()
            } else if self.pos < self.len && self.s[self.pos] == 93 { // ]
                self.consume()
                break
            } else {
                break
            }
        }
        self.depth = self.depth - 1
        return FromArray(arr)
    }

    fn parseString(self: *Parser) -> Value {
        if self.pos >= self.len || self.s[self.pos] != 34 {
            // Not a string; return empty without consuming.
            return Value{kind: 3, strVal: ""}
        }
        self.consume() // \"
        b := str.NewBuilder(16)
        for self.pos < self.len {
            c := self.s[self.pos]
            if c == 34 { // \"
                self.consume()
                break
            }
            if c == 92 { // \
                self.consume()
                if self.pos >= self.len {
                    break
                }
                // Decode escape sequence
                esc := self.s[self.pos]
                if esc == 117 {
                    // \uXXXX — decode the 4-hex-digit codepoint, combining
                    // surrogate pairs; lone surrogates become U+FFFD.
                    self.consume() // 'u'
                    cp := self.readHex4()
                    if cp >= 55296 && cp <= 56319 &&
                       self.pos + 1 < self.len &&
                       self.s[self.pos] == 92 && self.s[self.pos + 1] == 117 {
                        save := self.pos
                        self.consume()
                        self.consume()
                        lo := self.readHex4()
                        if lo >= 56320 && lo <= 57343 {
                            cp = 65536 + (cp - 55296) * 1024 + (lo - 56320)
                        } else {
                            self.pos = save
                            cp = 65533
                        }
                    } else if cp >= 55296 && cp <= 57343 {
                        cp = 65533
                    }
                    writeUtf8(&b, cp)
                    continue
                }
                if esc == 34 {
                    str.WriteByte(&b, 34)
                } else {
                    if esc == 92 {
                        str.WriteByte(&b, 92)
                    } else {
                        if esc == 47 {
                            str.WriteByte(&b, 47)
                        } else {
                            if esc == 98 {
                                str.WriteByte(&b, 8)
                            } else {
                                if esc == 102 {
                                    str.WriteByte(&b, 12)
                                } else {
                                    if esc == 110 {
                                        str.WriteByte(&b, 10)
                                    } else {
                                        if esc == 114 {
                                            str.WriteByte(&b, 13)
                                        } else {
                                            if esc == 116 {
                                                str.WriteByte(&b, 9)
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                self.consume()
            } else {
                // Regular character
                str.WriteByte(&b, int(c))
                self.consume()
            }
        }
        res := str.String(b)
        str.Free(&b)
        return FromString(res)
    }

    // readHex4 consumes up to 4 hex digits and returns their value.
    fn readHex4(self: *Parser) -> int {
        cp := 0
        for k := 0; k < 4 && self.pos < self.len; k = k + 1 {
            hv := hexVal(self.s[self.pos])
            if hv < 0 {
                break
            }
            cp = cp * 16 + hv
            self.pos = self.pos + 1
        }
        return cp
    }

    fn parseTrue(self: *Parser) -> Value {
        // Validate "true" exactly
        if self.pos + 4 > self.len {
            return Null()
        }
        if self.s[self.pos] != 116 || self.s[self.pos + 1] != 114 ||
           self.s[self.pos + 2] != 117 || self.s[self.pos + 3] != 101 {
            return Null()
        }
        self.pos = self.pos + 4
        return FromBool(true)
    }

    fn parseFalse(self: *Parser) -> Value {
        // Validate "false" exactly
        if self.pos + 5 > self.len {
            return Null()
        }
        if self.s[self.pos] != 102 || self.s[self.pos + 1] != 97 ||
           self.s[self.pos + 2] != 108 || self.s[self.pos + 3] != 115 ||
           self.s[self.pos + 4] != 101 {
            return Null()
        }
        self.pos = self.pos + 5
        return FromBool(false)
    }

    fn parseNull(self: *Parser) -> Value {
        // Validate "null" exactly
        if self.pos + 4 > self.len {
            return Null()
        }
        if self.s[self.pos] != 110 || self.s[self.pos + 1] != 117 ||
           self.s[self.pos + 2] != 108 || self.s[self.pos + 3] != 108 {
            return Null()
        }
        self.pos = self.pos + 4
        return Null()
    }

    fn parseNumber(self: *Parser) -> Value {
        start := self.pos
        neg := false
        if self.pos < self.len && self.s[self.pos] == 45 { // -
            neg = true
            self.consume()
        }
        // Consume integer digits (0-9)
        for self.pos < self.len && self.s[self.pos] >= 48 && self.s[self.pos] <= 57 {
            self.consume()
        }
        hasFrac := false
        if self.pos < self.len && self.s[self.pos] == 46 { // .
            hasFrac = true
            self.consume()
            // Consume fractional digits
            for self.pos < self.len && self.s[self.pos] >= 48 && self.s[self.pos] <= 57 {
                self.consume()
            }
        }
        // Handle exponent (e/E +/- digits)
        if self.pos < self.len && (self.s[self.pos] == 101 || self.s[self.pos] == 69) {
            hasFrac = true
            self.consume()
            // Optional sign in exponent
            if self.pos < self.len && (self.s[self.pos] == 43 || self.s[self.pos] == 45) {
                self.consume()
            }
            for self.pos < self.len && self.s[self.pos] >= 48 && self.s[self.pos] <= 57 {
                self.consume()
            }
        }
        numStr := str.Substr(self.s, start, self.pos - start)
        if hasFrac {
            // Use ParseFloat for numbers with fractional or exponent parts
            f, ok := strconv.ParseFloat(numStr)
            if ok {
                return FromNumber(f)
            }
            return FromNumber(0.0)
        }
        // Simple integer parse
        n := parseInt(numStr)
        val := float(n)
        if neg {
            val = -val
        }
        return FromNumber(val)
    }
}

// hexVal returns the value of an ASCII hex digit, or -1.
fn hexVal(c: int) -> int {
    if c >= 48 && c <= 57 {
        return c - 48
    }
    if c >= 97 && c <= 102 {
        return c - 87
    }
    if c >= 65 && c <= 70 {
        return c - 55
    }
    return -1
}

// writeUtf8 appends the UTF-8 encoding of codepoint cp to b.
fn writeUtf8(b: *str.Builder, cp: int) {
    if cp < 128 {
        str.WriteByte(b, cp)
    } else if cp < 2048 {
        str.WriteByte(b, 192 + cp / 64)
        str.WriteByte(b, 128 + cp % 64)
    } else if cp < 65536 {
        str.WriteByte(b, 224 + cp / 4096)
        str.WriteByte(b, 128 + (cp / 64) % 64)
        str.WriteByte(b, 128 + cp % 64)
    } else {
        str.WriteByte(b, 240 + cp / 262144)
        str.WriteByte(b, 128 + (cp / 4096) % 64)
        str.WriteByte(b, 128 + (cp / 64) % 64)
        str.WriteByte(b, 128 + cp % 64)
    }
}

// parseInt parses a string of decimal digits into an int.
fn parseInt(s: string) -> int {
    n := 0
    for i := 0; i < str.Len(s); i = i + 1 {
        c := s[i]
        if c >= 48 && c <= 57 {
            n = n * 10 + int(c - 48)
        }
    }
    return n
}

// --- Legacy entry-based API ---

// Entry is a simple key-value pair used by the legacy entry-based JSON API.
pub struct Entry {
    key: string  // the key
    value: string  // the value

    // Key returns the entry's key string.
    pub fn Key(self: Entry) -> string {
        return self.key
    }

    // Value returns the entry's value string.
    pub fn Value(self: Entry) -> string {
        return self.value
    }
}

// MarshalEntries serializes parallel key and value slices into a JSON object
// string. Only the first n pairs are included.
pub fn MarshalEntries(keys: []string, values: []string, n: int) -> string {
    res := "{"
    for i := 0; i < n; i = i + 1 {
        if i > 0 {
            res = str.Concat(res, ",")
        }
        res = str.Concat(res, escapeString(keys[i]))
        res = str.Concat(res, ":")
        res = str.Concat(res, escapeString(values[i]))
    }
    res = str.Concat(res, "}")
    return res
}

// UnmarshalEntries parses a JSON object string into a slice of Entry pairs.
// Only string values are supported; non-string values yield empty strings.
pub fn UnmarshalEntries(s: string) -> ([]Entry, errors.Error) {
    v, err := Unmarshal(s)
    if err.message != "" {
        var empty []Entry
        return empty, err
    }
    var entries []Entry
    n := v.ObjectLen()
    for i := 0; i < n; i = i + 1 {
        k, val := v.ObjectGetByIndex(i)
        e := Entry{key: k, value: val.AsString()}
        entries = append(entries, e)
    }
    return entries, errors.New("")
}

// --- Struct marshal/unmarshal via reflect + [json] field tags ---

// jsonIntSize maps integer type names to their byte size, or 0 when
// typeName is not an integer type. Covers signed/unsigned widths plus
// the byte/rune aliases used in reflected type_names.
fn jsonIntSize(typeName: string) -> int {
    if str.Equal(typeName, "int") || str.Equal(typeName, "uint") || str.Equal(typeName, "int32") || str.Equal(typeName, "uint32") {
        return 4
    }
    if str.Equal(typeName, "int8") || str.Equal(typeName, "uint8") || str.Equal(typeName, "char") {
        return 1
    }
    if str.Equal(typeName, "int16") || str.Equal(typeName, "uint16") {
        return 2
    }
    if str.Equal(typeName, "int64") || str.Equal(typeName, "uint64") {
        return 8
    }
    return 0
}

// jsonBytesType reports whether typeName is a byte-buffer field type
// ([]int8/[]uint8/bytes — all lowered to a plain NUL-terminated i8* by
// the compiler, like Go's []byte). Byte fields marshal as base64
// strings, matching encoding/json's convention.
fn jsonBytesType(typeName: string) -> bool {
    return str.Equal(typeName, "[]int8") || str.Equal(typeName, "[]uint8") || str.Equal(typeName, "bytes")
}

// jsonScalarType reports whether typeName is a scalar field type the
// struct serializers support: any integer width, float, bool, string.
fn jsonScalarType(typeName: string) -> bool {
    if jsonIntSize(typeName) > 0 {
        return true
    }
    return str.Equal(typeName, "string") || str.Equal(typeName, "float") ||
        str.Equal(typeName, "double") || str.Equal(typeName, "bool")
}

// jsonFieldName resolves a field's JSON key: [json(name=x)] wins,
// otherwise the field name itself.
fn jsonFieldName(f: reflect.Field) -> string {
    if name, ok := reflect.TagKey(f.tag, "json", "name"); ok {
        return name
    }
    return f.name
}

// unsupportedFieldErr builds the field-type error shared by
// MarshalStruct and UnmarshalInto.
fn unsupportedFieldErr(f: reflect.Field) -> errors.Error {
    return errors.New(str.Concat(str.Concat("json: unsupported field type \"", f.type_name), str.Concat("\" on field \"", str.Concat(f.name, "\" — supported: integers, float, bool, string, byte buffers, pointers, slices, nested structs"))))
}

// isEmptyValue reports whether the field on the struct at ptr holds its
// zero value — used by the [json(omitempty)] flag.
fn isEmptyValue(ptr: int64, f: reflect.Field) -> bool {
    addr := reflect.FieldAddr(ptr, f)
    if str.StartsWith(f.type_name, "*") {
        return reflect.ReadPtr(addr) == 0
    }
    if jsonBytesType(f.type_name) {
        return str.Len(reflect.ReadString(addr)) == 0
    }
    if str.StartsWith(f.type_name, "[]") {
        hdr := reflect.ReadPtr(addr)
        return hdr == 0 || reflect.ReadInt64(hdr + 8) == int64(0)
    }
    isz := jsonIntSize(f.type_name)
    if isz == 4 {
        return reflect.ReadInt(addr) == 0
    }
    if isz == 8 {
        return reflect.ReadInt64(addr) == int64(0)
    }
    if isz > 0 {
        return reflect.ReadInt16(addr) == 0 && reflect.ReadInt8(addr) == 0
    }
    if str.Equal(f.type_name, "string") {
        return str.Len(reflect.ReadString(addr)) == 0
    }
    if str.Equal(f.type_name, "float") || str.Equal(f.type_name, "double") {
        return reflect.ReadFloat(addr) == 0.0
    }
    if str.Equal(f.type_name, "bool") {
        return reflect.ReadBool(addr) == false
    }
    return false
}

// elemField derives the element Field descriptor for pointer and slice
// fields: same nested Type metadata and name, with the elem type_name
// (ElemType strips one "*" or "[]" level) and offset 0. Recursive
// marshal/unmarshal then treats the pointed-at or element storage the
// same way as a real struct field.
fn elemField(f: reflect.Field) -> reflect.Field {
    return reflect.Field{name: f.name, type_name: reflect.ElemType(f), offset: 0, tag: f.tag, typ: f.typ}
}

// elemSize returns the byte size of one element of a slice field,
// resolving struct elements through the embedded nested Type size.
fn elemSize(f: reflect.Field) -> int {
    ef := elemField(f)
    return valSize(ef)
}

// valSize returns the in-memory size of a value described by f — used
// for slice element strides and pointer-element allocation.
fn valSize(f: reflect.Field) -> int {
    tn := f.type_name
    isz := jsonIntSize(tn)
    if isz > 0 {
        return isz
    }
    if str.Equal(tn, "float") || str.Equal(tn, "double") || str.Equal(tn, "string") {
        return 8
    }
    if str.Equal(tn, "bool") {
        return 1
    }
    if str.StartsWith(tn, "*") {
        return 8
    }
    if str.StartsWith(tn, "[]") {
        return 32
    }
    if str.Len(f.typ.name) > 0 {
        return f.typ.size
    }
    return 8
}

// marshalVal serializes the reflected value stored at addr into a JSON
// Value, dispatching on f.type_name: scalars, byte buffers (base64),
// pointers (null or dereferenced element), fat slices (arrays), and
// nested structs (objects, via the embedded reflect.Type metadata).
// Unsupported kinds (maps, sets, enums without metadata) produce an
// error naming the field.
fn marshalVal(addr: int64, f: reflect.Field) -> (Value, errors.Error) {
    tn := f.type_name
    if str.StartsWith(tn, "*") {
        p := reflect.ReadPtr(addr)
        if p == 0 {
            return Null(), errors.None()
        }
        return marshalVal(p, elemField(f))
    }
    if jsonBytesType(tn) {
        s := reflect.ReadString(addr)
        if s == nil {
            return FromString(""), errors.None()
        }
        return FromString(base64.Encode(s, str.Len(s))), errors.None()
    }
    if str.StartsWith(tn, "[]") {
        hdr := reflect.ReadPtr(addr)
        var vals []Value
        if hdr == 0 {
            return FromArray(vals), errors.None()
        }
        data := reflect.ReadInt64(hdr)
        n := int(reflect.ReadInt64(hdr + 8))
        ef := elemField(f)
        esz := valSize(ef)
        i := 0
        for i < n {
            ev, err := marshalVal(data + int64(i * esz), ef)
            if err.message != "" {
                return Null(), err
            }
            vals = append(vals, ev)
            i = i + 1
        }
        return FromArray(vals), errors.None()
    }
    nt, isStruct := reflect.NestedType(f)
    if isStruct {
        return marshalStructValue(nt, addr)
    }
    isz := jsonIntSize(tn)
    if isz == 4 {
        return FromNumber(float(reflect.ReadInt(addr))), errors.None()
    }
    if isz == 8 {
        return FromNumber(float(reflect.ReadInt64(addr))), errors.None()
    }
    if isz == 2 {
        return FromNumber(float(reflect.ReadInt16(addr))), errors.None()
    }
    if isz == 1 {
        return FromNumber(float(reflect.ReadInt8(addr))), errors.None()
    }
    if str.Equal(tn, "string") {
        return FromString(reflect.ReadString(addr)), errors.None()
    }
    if str.Equal(tn, "float") || str.Equal(tn, "double") {
        return FromNumber(reflect.ReadFloat(addr)), errors.None()
    }
    if str.Equal(tn, "bool") {
        return FromBool(reflect.ReadBool(addr)), errors.None()
    }
    return Null(), unsupportedFieldErr(f)
}

// marshalStructValue serializes the struct at addr into a JSON object
// Value — the recursion target shared by Marshal and nested fields.
fn marshalStructValue(t: reflect.Type, addr: int64) -> (Value, errors.Error) {
    var keys []string
    var vals []Value
    n := reflect.FieldCount(t)
    for i := 0; i < n; i = i + 1 {
        f := reflect.FieldByIndex(t, i)
        if reflect.TagHasFlag(f.tag, "json", "ignore") {
            continue
        }
        if reflect.TagHasFlag(f.tag, "json", "omitempty") && isEmptyValue(addr, f) {
            continue
        }
        v, err := marshalVal(reflect.FieldAddr(addr, f), f)
        if err.message != "" {
            return Null(), err
        }
        keys = append(keys, jsonFieldName(f))
        vals = append(vals, v)
    }
    return FromObject(keys, vals), errors.None()
}

// Marshal serializes the struct pointed to by v to a JSON object
// string:
//
//   s, err := json.Marshal(&u)
//
// T binds to the pointee struct type — inferred from the argument, so
// the call site never needs explicit type arguments. Inside the
// monomorphized clone reflect.TypeOf<T> emits real type metadata and
// the pointer forwards to MarshalStruct as int64 — no compiler
// injection required.
// The returned string is Skink's byte-buffer type — equivalent to
// ([]byte, error) elsewhere.
//
// Supported field types: every integer width, float/double, bool,
// string, byte buffers ([]int8/[]uint8/bytes, base64-encoded like
// encoding/json), pointers (*T → null or dereferenced), slices
// ([]T including []struct), and nested structs via the reflected
// metadata emitted by TypeOf. Map/set/enum fields produce an error
// naming the field.
//
// Field names map to JSON keys by name unless overridden:
//   [json(name=x)]    rename the key to x
//   [json(ignore)]    omit the field entirely
//   [json(omitempty)] omit the field when it holds its zero value
pub fn Marshal<T>(v: *T) -> (string, errors.Error) {
    return MarshalStruct(reflect.TypeOf<T>(*v), int64(v))
}

// MarshalStruct serializes the struct at ptr (pass int64(&obj)) to a
// JSON object string using the explicitly supplied reflected type t —
// the low-level entry point Marshal auto-injects to, also useful when
// marshalling through a reflect.Type obtained by other means.
pub fn MarshalStruct(t: reflect.Type, ptr: int64) -> (string, errors.Error) {
    v, err := marshalStructValue(t, ptr)
    if err.message != "" {
        return "", err
    }
    return MarshalValue(v), errors.None()
}

// unmarshalVal writes one JSON value into the reflected storage at
// addr, dispatching on f.type_name the same way marshalVal does.
// JSON null leaves the target unchanged.
fn unmarshalVal(addr: int64, f: reflect.Field, v: Value) -> errors.Error {
    tn := f.type_name
    if str.StartsWith(tn, "*") {
        if IsNull(v) {
            reflect.WritePtr(addr, 0)
            return errors.None()
        }
        ef := elemField(f)
        p := reflect.Alloc(int64(valSize(ef)))
        reflect.WritePtr(addr, p)
        return unmarshalVal(p, ef, v)
    }
    if jsonBytesType(tn) {
        if v.kind != 3 {
            return errors.New(str.Concat(str.Concat("json: expected base64 string for field \"", f.name), "\""))
        }
        dec, derr := base64.Decode(AsString(v))
        if derr.message != "" {
            return derr
        }
        reflect.WriteString(addr, dec)
        return errors.None()
    }
    if str.StartsWith(tn, "[]") {
        if v.kind != 4 {
            return errors.New(str.Concat(str.Concat("json: expected array for field \"", f.name), "\""))
        }
        n := ArrayLen(v)
        ef := elemField(f)
        esz := valSize(ef)
        data := int64(0)
        if n > 0 {
            data = reflect.Alloc(int64(n * esz))
        }
        // The field stores a pointer to a registered fat-slice header;
        // MakeSlice wraps the backing store so len()/indexing resolve.
        reflect.WritePtr(addr, reflect.MakeSlice(data, n))
        i := 0
        for i < n {
            err := unmarshalVal(data + int64(i * esz), ef, ArrayGet(v, i))
            if err.message != "" {
                return err
            }
            i = i + 1
        }
        return errors.None()
    }
    nt, isStruct := reflect.NestedType(f)
    if isStruct {
        return unmarshalStructValue(nt, addr, v)
    }
    isz := jsonIntSize(tn)
    if isz == 4 {
        reflect.WriteInt(addr, int(AsNumber(v)))
    } else if isz == 8 {
        reflect.WriteInt64(addr, int64(AsNumber(v)))
    } else if isz == 2 {
        reflect.WriteInt16(addr, int(AsNumber(v)))
    } else if isz == 1 {
        reflect.WriteInt8(addr, int(AsNumber(v)))
    } else if str.Equal(tn, "string") {
        reflect.WriteString(addr, AsString(v))
    } else if str.Equal(tn, "float") || str.Equal(tn, "double") {
        reflect.WriteFloat(addr, AsNumber(v))
    } else if str.Equal(tn, "bool") {
        reflect.WriteBool(addr, AsBool(v))
    } else {
        return unsupportedFieldErr(f)
    }
    return errors.None()
}

// unmarshalStructValue writes a JSON object Value into the struct at
// addr — the recursion target shared by UnmarshalInto and nested fields.
fn unmarshalStructValue(t: reflect.Type, addr: int64, v: Value) -> errors.Error {
    if v.kind != 5 {
        return errors.New("json: expected a JSON object")
    }
    n := reflect.FieldCount(t)
    for i := 0; i < n; i = i + 1 {
        f := reflect.FieldByIndex(t, i)
        if reflect.TagHasFlag(f.tag, "json", "ignore") {
            continue
        }
        fv := ObjectGet(v, jsonFieldName(f))
        if IsNull(fv) {
            // Pointer fields still receive the null (as nil); other
            // field kinds keep their existing value on JSON null.
            if str.StartsWith(f.type_name, "*") {
                err := unmarshalVal(reflect.FieldAddr(addr, f), f, fv)
                if err.message != "" {
                    return err
                }
            }
            continue
        }
        err := unmarshalVal(reflect.FieldAddr(addr, f), f, fv)
        if err.message != "" {
            return err
        }
    }
    return errors.None()
}

// UnmarshalInto parses data as a JSON object and writes each matching
// key into the struct pointed to by obj:
//
//   err := json.UnmarshalInto(data, &u)
//
// Like Marshal, T binds to the pointee struct type — inferred from the
// argument. (UnmarshalInto rather than Unmarshal because json.Unmarshal
// is the existing Value-tree parser.)
//
// Supports the same field-type matrix as Marshal: integers of every
// width, float/double, bool, string, base64 byte buffers, pointers
// (allocated on demand, null → nil), slices, and nested structs.
// Keys not present in the JSON leave their fields unchanged; JSON keys
// with no matching field are ignored. Honours [json(name=x)] and
// [json(ignore)].
pub fn UnmarshalInto<T>(data: string, v: *T) -> errors.Error {
    return UnmarshalStruct(data, reflect.TypeOf<T>(*v), int64(v))
}

// UnmarshalStruct parses s as a JSON object and writes each matching
// key into the struct at ptr (pass int64(&obj)) using the explicitly
// supplied reflected type t — the low-level entry point UnmarshalInto
// auto-injects to.
pub fn UnmarshalStruct(s: string, t: reflect.Type, ptr: int64) -> errors.Error {
    v, err := Unmarshal(s)
    if err.message != "" {
        return err
    }
    return unmarshalStructValue(t, ptr, v)
}
