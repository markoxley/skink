module spi

import "std/errors"
import "std/libc"

// Device represents an SPI device connection on a /dev/spidevB.C node.
//
//   - fd:      the kernel file descriptor for /dev/spidevB.C (0 when closed).
//   - speedHz: the max bus clock in Hz requested at Open time.
//   - mode:    the SPI mode (MODE_0..MODE_3) requested at Open time.
//   - bits:    bits per word (typically 8).
pub struct Device {
    fd: int
    speedHz: int
    mode: int
    bits: int

    // Transfer performs a full-duplex transfer of len bytes: tx is clocked out
    // while rx is clocked in simultaneously. The returned string is the received
    // bytes (NUL-terminated) and must be freed with libc.free.
    //
    // Backend behavior:
    //   - rx := libc.malloc(len + 1)
    //   - tr := spi_ioc_transfer{tx_buf: tx, rx_buf: rx, len: len,
    //       speed_hz: self.speedHz, bits_per_word: self.bits}
    //   - ioctl(self.fd, SPI_IOC_MESSAGE(1), &tr)
    //   - rx[len] = 0
    //
    // The stub echoes tx into rx (loopback) so callers can verify round-trip
    // behavior without hardware.
    pub fn Transfer(self: *Device, tx: string, len: int) -> (string, errors.Error) {
        rx := libc.malloc(len + 1)
        // Real implementation: ioctl(self.fd, SPI_IOC_MESSAGE(1), &tr)
        for i := 0; i < len; i = i + 1 {
            rx[i] = tx[i]
        }
        rx[len] = 0
        return rx, errors.New("")
    }

    // Write sends len bytes (half-duplex) and discards the received data.
    // Returns the number of bytes written.
    //
    // Backend behavior:
    //   - same ioctl as Transfer, but the rx buffer is ignored.
    //
    // The stub delegates to Transfer and returns len.
    pub fn Write(self: *Device, data: string, len: int) -> int {
        self.Transfer(data, len)
        return len
    }

    // Read clocks out zero bytes and returns up to len received bytes. The
    // returned string is heap-allocated and must be freed with libc.free.
    //
    // Backend behavior:
    //   - tx := zeroed buffer of len bytes
    //   - ioctl(self.fd, SPI_IOC_MESSAGE(1), &tr) with tx_buf = tx.
    //
    // The stub builds a zeroed transmit buffer and delegates to Transfer.
    pub fn Read(self: *Device, len: int) -> (string, errors.Error) {
        tx := libc.malloc(len)
        for i := 0; i < len; i = i + 1 {
            tx[i] = 0
        }
        return self.Transfer(tx, len)
    }

    // Close releases the device file descriptor. It is idempotent: calling
    // Close on an already-closed Device returns a nil error and does nothing.
    //
    // Backend behavior:
    //   - close(self.fd) when fd != 0.
    pub fn Close(self: *Device) -> errors.Error {
        if self.fd != 0 {
            // Real implementation: close(self.fd)
            self.fd = 0
        }
        return errors.New("")
    }

    // Fd returns the underlying kernel file descriptor, or 0 when closed.
    pub fn Fd(self: Device) -> int {
        return self.fd
    }

    // Speed returns the configured bus clock in Hz.
    pub fn Speed(self: Device) -> int {
        return self.speedHz
    }

    // Mode returns the configured SPI mode (MODE_0..MODE_3).
    pub fn Mode(self: Device) -> int {
        return self.mode
    }

    // Bits returns the configured bits per word.
    pub fn Bits(self: Device) -> int {
        return self.bits
    }
}

// Open opens the SPI device at /dev/spidev{bus}.{chipSelect} and configures it
// with the given speed (Hz), mode (MODE_0..MODE_3), and 8 bits per word.
//
// Backend behavior:
//   - fd := open("/dev/spidev{bus}.{chipSelect}", O_RDWR)
//   - ioctl(fd, SPI_IOC_WR_MODE, &mode)
//   - ioctl(fd, SPI_IOC_WR_MAX_SPEED_HZ, &speedHz)
//   - ioctl(fd, SPI_IOC_WR_BITS_PER_WORD, &8)
//
// The stub returns a Device with a non-zero fake fd so callers can exercise
// the API without hardware. A real backend should return fd <= 0 with a
// non-empty error when the device node cannot be opened.
pub fn Open(bus: int, chipSelect: int, speedHz: int, mode: int) -> (Device, errors.Error) {
    // Real implementation: open("/dev/spidevB.C", O_RDWR) + ioctl for speed/mode
    return Device{fd: 1, speedHz: speedHz, mode: mode, bits: 8}, errors.New("")
}

// SPI mode constants (CPOL/CPHA combinations, from <linux/spi/spi.h>).
//   - MODE_0: CPOL=0, CPHA=0 (clock idle low, sample on leading edge).
//   - MODE_1: CPOL=0, CPHA=1 (clock idle low, sample on trailing edge).
//   - MODE_2: CPOL=1, CPHA=0 (clock idle high, sample on leading edge).
//   - MODE_3: CPOL=1, CPHA=1 (clock idle high, sample on trailing edge).
pub const MODE_0 = 0
pub const MODE_1 = 1
pub const MODE_2 = 2
pub const MODE_3 = 3

// Bit order constants.
pub const MSB_FIRST = 0
pub const LSB_FIRST = 1

// Common SPI clock speeds (Hz), for convenience.
pub const SPEED_100KHZ = 100000
pub const SPEED_1MHZ = 1000000
pub const SPEED_5MHZ = 5000000
pub const SPEED_10MHZ = 10000000
pub const SPEED_20MHZ = 20000000
