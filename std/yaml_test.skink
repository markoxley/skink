module yaml_test

import "std/yaml"
import "std/str"
import "testing"

// TestNull verifies the Null constructor.
pub fn TestNull() {
    v := yaml.Null()
    if yaml.IsNull(v) == false {
        Errorf("Null value should report IsNull true")
    }
}

// TestBool verifies boolean construction and access.
pub fn TestBool() {
    v := yaml.FromBool(true)
    if yaml.AsBool(v) != true {
        Errorf("FromBool(true) should yield true")
    }
    v2 := yaml.FromBool(false)
    if yaml.AsBool(v2) != false {
        Errorf("FromBool(false) should yield false")
    }
}

// TestNumber verifies number construction and access.
pub fn TestNumber() {
    v := yaml.FromNumber(7.0)
    if yaml.AsNumber(v) != 7.0 {
        Errorf("FromNumber should preserve the value")
    }
}

// TestString verifies string construction and access.
pub fn TestString() {
    v := yaml.FromString("hello")
    if str.Equal(yaml.AsString(v), "hello") == false {
        Errorf("FromString should preserve the string")
    }
}

// TestMarshalNull verifies null marshals to "null".
pub fn TestMarshalNull() {
    s := yaml.MarshalValue(yaml.Null())
    if str.Equal(s, "null") == false {
        Errorf("Marshal null should be null")
    }
}

// TestMarshalBool verifies boolean marshaling.
pub fn TestMarshalBool() {
    s := yaml.MarshalValue(yaml.FromBool(true))
    if str.Equal(s, "true") == false {
        Errorf("Marshal true should be true")
    }
    s2 := yaml.MarshalValue(yaml.FromBool(false))
    if str.Equal(s2, "false") == false {
        Errorf("Marshal false should be false")
    }
}

// TestMarshalString verifies string marshaling.
pub fn TestMarshalString() {
    s := yaml.MarshalValue(yaml.FromString("hi"))
    if str.Equal(s, "hi") == false {
        Errorf("Marshal string should preserve value")
    }
}

// TestUnmarshalNull verifies parsing of null.
pub fn TestUnmarshalNull() {
    v, err := yaml.Unmarshal("null")
    if err.message != "" {
        Errorf("Unmarshal null should not error")
    }
    if yaml.IsNull(v) == false {
        Errorf("Unmarshal null should produce null value")
    }
}

// TestUnmarshalBool verifies parsing of booleans.
pub fn TestUnmarshalBool() {
    v, err := yaml.Unmarshal("true")
    if err.message != "" {
        Errorf("Unmarshal true should not error")
    }
    if yaml.AsBool(v) != true {
        Errorf("Unmarshal true should yield true")
    }
    v2, err2 := yaml.Unmarshal("false")
    if err2.message != "" {
        Errorf("Unmarshal false should not error")
    }
    if yaml.AsBool(v2) != false {
        Errorf("Unmarshal false should yield false")
    }
}

// TestUnmarshalNumber verifies parsing of an integer number.
pub fn TestUnmarshalNumber() {
    v, err := yaml.Unmarshal("42")
    if err.message != "" {
        Errorf("Unmarshal 42 should not error")
    }
    if yaml.AsNumber(v) != 42.0 {
        Errorf("Unmarshal 42 should yield 42")
    }
}

// TestRoundtripObject verifies marshal-then-unmarshal of a simple mapping.
pub fn TestRoundtripObject() {
    keys := ["name"]
    vals := [yaml.FromString("skink")]
    obj := yaml.FromObject(keys, vals)
    s := yaml.MarshalValue(obj)
    v2, err := yaml.Unmarshal(s)
    if err.message != "" {
        Errorf("Unmarshal should not error")
    }
    if yaml.ObjectLen(v2) != 1 {
        Errorf("Roundtrip object should preserve one key")
    }
    val := yaml.ObjectGet(v2, "name")
    if str.Equal(yaml.AsString(val), "skink") == false {
        Errorf("Roundtrip object should preserve string value")
    }
}

// --- Struct marshal/unmarshal via reflect + [yaml] field tags ---
// Guards the reflected-struct API added alongside json.Marshal —
// nested structs, slices, pointers, and base64 byte buffers must
// round-trip through yaml.Marshal/yaml.UnmarshalInto.
import "std/reflect"

// YamlAddr is a nested-struct target for recursion tests.
pub struct YamlAddr {
    city: string
    zip: int
}

// YamlConfig exercises nested structs, scalar slices, struct slices,
// pointers, narrow ints, byte buffers, and yaml tags in one shape.
pub struct YamlConfig {
    [yaml(ignore)]
    id: int64
    [yaml(name=display_name)]
    name: string
    [yaml(omitempty)]
    note: string
    addr: YamlAddr
    ports: []int
    hosts: []string
    peers: []YamlAddr
    fallback: *YamlAddr
    level: int8
    blob: []byte
}

// TestYamlMarshalStruct verifies object output honours renames,
// ignores, and produces nested mappings + sequences.
pub fn TestYamlMarshalStruct() {
    var c YamlConfig
    c.name = "svc"
    c.addr.city = "DC"
    c.addr.zip = 42
    c.ports = append(c.ports, 80)
    c.ports = append(c.ports, 443)
    c.level = int8(2)
    s, err := yaml.MarshalStruct(reflect.TypeOf<YamlConfig>(c), int64(&c))
    if err.message != "" {
        Errorf("yaml.Marshal should succeed")
        return
    }
    if str.Contains(s, "display_name") == false {
        Errorf("[yaml(name=display_name)] should rename the key")
    }
    if str.Contains(s, "city") == false || str.Contains(s, "DC") == false {
        Errorf("nested struct should marshal as a mapping")
    }
    if str.Contains(s, "80") == false || str.Contains(s, "443") == false {
        Errorf("[]int should marshal as a sequence")
    }
    if str.Contains(s, "id:") {
        Errorf("[yaml(ignore)] field should not appear")
    }
    if str.Contains(s, "note") {
        Errorf("empty omitempty field should be omitted")
    }
}

// TestYamlStructRoundTrip verifies Marshal then UnmarshalInto restores
// nested structs, slices, pointers, and byte buffers.
pub fn TestYamlStructRoundTrip() {
    var src YamlConfig
    src.name = "gw"
    src.note = "keep"
    src.addr.city = "HQ"
    src.addr.zip = 7
    src.ports = append(src.ports, 8080)
    src.hosts = append(src.hosts, "h1")
    var p YamlAddr
    p.city = "peer1"
    src.peers = append(src.peers, p)
    var f YamlAddr
    f.city = "fb"
    f.zip = 9
    src.fallback = &f
    s, err := yaml.MarshalStruct(reflect.TypeOf<YamlConfig>(src), int64(&src))
    if err.message != "" {
        Errorf("marshal should succeed")
        return
    }
    var dst YamlConfig
    err = yaml.UnmarshalStruct(s, reflect.TypeOf<YamlConfig>(dst), int64(&dst))
    if err.message != "" {
        Errorf("UnmarshalInto should succeed on own output")
        return
    }
    if str.Equal(dst.name, "gw") == false || str.Equal(dst.note, "keep") == false {
        Errorf("scalar fields should round-trip")
    }
    if str.Equal(dst.addr.city, "HQ") == false || dst.addr.zip != 7 {
        Errorf("nested struct should round-trip")
    }
    if len(dst.ports) != 1 || dst.ports[0] != 8080 {
        Errorf("[]int should round-trip")
    }
    if len(dst.hosts) != 1 || str.Equal(dst.hosts[0], "h1") == false {
        Errorf("[]string should round-trip")
    }
    if len(dst.peers) != 1 || str.Equal(dst.peers[0].city, "peer1") == false {
        Errorf("[]struct should round-trip")
    }
    if dst.fallback == nil || str.Equal(dst.fallback.city, "fb") == false || dst.fallback.zip != 9 {
        Errorf("pointer field should round-trip")
    }
    if dst.id != int64(0) {
        Errorf("[yaml(ignore)] field should not be set")
    }
}

// TestYamlUnmarshalIntoBad verifies malformed and non-mapping input errors.
pub fn TestYamlUnmarshalIntoBad() {
    var c YamlConfig
    err := yaml.UnmarshalStruct("- 1\n- 2\n", reflect.TypeOf<YamlConfig>(c), int64(&c))
    if err.message == "" {
        Errorf("non-mapping YAML should error")
    }
}


// TestYamlMarshalAutoAPI covers the pointer-only yaml.Marshal(&obj)
// call — the emitter synthesizes (reflect.Type, ptr) at the call site
// and forwards to MarshalStruct.
pub fn TestYamlMarshalAutoAPI() {
    var c YamlConfig
    c.name = "svc"
    c.level = 5
    var a YamlAddr
    a.city = "york"
    a.zip = 7001
    c.addr = a
    s, err := yaml.Marshal(&c)
    if err.message != "" {
        Errorf("yaml.Marshal(&c) should succeed")
    }
    if str.Contains(s, "display_name: svc") == false {
        Errorf("yaml.Marshal(&c) should emit the renamed field")
    }
    if str.Contains(s, "addr:") == false {
        Errorf("yaml.Marshal(&c) should emit the nested struct")
    }
}

// TestYamlAutoAPIRoundTrip covers UnmarshalInto(data, &obj) —
// the two-argument pointer form with auto-injected type+ptr.
pub fn TestYamlAutoAPIRoundTrip() {
    var c YamlConfig
    c.name = "round"
    c.level = 4
    var a YamlAddr
    a.city = "h"
    a.zip = 42
    c.addr = a
    c.ports = append(c.ports, 1)
    c.ports = append(c.ports, 2)
    s, err := yaml.Marshal(&c)
    if err.message != "" {
        Errorf("yaml.Marshal(&c) should succeed")
    }
    var dst YamlConfig
    err = yaml.UnmarshalInto(s, &dst)
    if err.message != "" {
        Errorf("yaml.UnmarshalInto(s, &dst) should succeed")
    }
    if str.Equal(dst.name, "round") == false || dst.level != 4 {
        Errorf("round trip should preserve scalars")
    }
    if str.Equal(dst.addr.city, "h") == false || dst.addr.zip != 42 {
        Errorf("round trip should preserve the nested struct")
    }
    if len(dst.ports) != 2 || dst.ports[0] != 1 || dst.ports[1] != 2 {
        Errorf("round trip should preserve the slice")
    }
}
