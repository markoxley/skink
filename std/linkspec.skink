// Project: Skink — A self-hosted, statically-typed programming language
//          targeting LLVM IR, designed for systems programming with
//          modern ergonomics and a Go-inspired syntax.
//
// File:    std/linkspec.skink
// Purpose: Parses and validates the [link] section of a skink.toml
//          manifest, which lets a package declare native link and
//          compile requirements — libraries, library and include search
//          paths, compile/link flags, and C/C++ source files that clang
//          compiles and links in the same invocation.
//
//          The compiler driver applies the [link] section of the nearest
//          ancestor skink.toml of every resolved source file: the
//          project's own manifest plus each cached mod/<owner>/<repo>
//          package (including subpath packages carrying their own
//          manifest). This gives scales-installed modules a declarative
//          way to require native dependencies such as OpenCV or SDL2.
//
//          Example:
//
//            [link]
//            libs = ["opencv_core", "opencv_imgproc"]
//            lib_paths = ["native/lib"]          # -> -L<dir>
//            include_paths = ["native/include"]  # -> -I<dir>
//            sources = ["native/shim.cpp"]       # compiled into the binary
//            cflags = ["-fPIC"]
//            ldflags = ["-Wl,-rpath,/opt/lib"]
//            frameworks = ["Cocoa"]              # macOS only
//
//          Validation rejects absolute paths, parent traversals, and
//          flag values that do not start with '-', so a crafted manifest
//          cannot smuggle extra positional arguments into the clang
//          argv array (the driver execs argv directly, no shell).
//
// Author:  Mark Oxley
// Created: 2026
//
