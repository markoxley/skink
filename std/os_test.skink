module os_test

import "std/os"
import "testing"

// TestArgsCount verifies that ArgsCount returns a positive value.
pub fn TestArgsCount() {
    count := os.ArgsCount()
    if count < 1 {
        Errorf("ArgsCount should be at least 1")
    }
}

// TestArgs checks that the Args slice length matches ArgsCount.
pub fn TestArgs() {
    args := os.Args()
    count := os.ArgsCount()
    if len(args) != count {
        Errorf("Args length mismatch")
    }
    if count > 0 {
        if len(args[0]) == 0 {
            Errorf("First arg should not be empty")
        }
    }
}

// TestRunWithOutput verifies that a shell command's stdout is captured.
pub fn TestRunWithOutput() {
    out, status := os.RunWithOutput("echo hello")
    if status != 0 {
        Errorf("RunWithOutput should return status 0")
    }
    if len(out) == 0 {
        Errorf("RunWithOutput should capture stdout")
    }
}

// TestGetenvPath verifies PATH is set.
pub fn TestGetenvPath() {
    path := os.Getenv("PATH")
    if len(path) == 0 {
        Errorf("PATH should be set")
    }
}

// TestGetwd verifies Getwd returns a non-empty string.
pub fn TestGetwd() {
    wd := os.Getwd()
    if len(wd) == 0 {
        Errorf("Getwd should return non-empty")
    }
}

// TestSetenvRoundtrip verifies Setenv and Unsetenv work.
pub fn TestSetenvRoundtrip() {
    name := "SKINK_TEST_VAR_42"
    os.Setenv(name, "testvalue")
    val := os.Getenv(name)
    if val != "testvalue" {
        Errorf("Setenv should persist value")
    }
    os.Unsetenv(name)
    val2 := os.Getenv(name)
    if val2 != "" {
        Errorf("Unsetenv should clear value")
    }
}

// --- VULN-05 security regression ---

extern fn getpid() -> int
extern fn kill(pid: int, sig: int) -> int

var osSigFired = 0

// osSigHandler is registered as the SIGUSR1 (10) handler. It only sets
// a flag — a Skink fn() is a closure handle ({code, env}), not a C
// function pointer, so invoking it directly jumped into data memory
// before VULN-05 was fixed.
fn osSigHandler() {
    osSigFired = 1
}

// TestOnSignalFires guards VULN-05: registering a Skink fn() as a
// signal handler must dispatch through the closure code pointer.
// Pre-fix this crashed (or executed garbage) on signal delivery.
pub fn TestOnSignalFires() {
    osSigFired = 0
    if !os.OnSignal(10, osSigHandler) {
        Errorf("OnSignal registration failed")
        return
    }
    if kill(getpid(), 10) != 0 {
        Errorf("kill failed")
        return
    }
    // Signal delivery is synchronous on the receiving thread but may
    // land on another thread — poll briefly.
    for i := 0; i < 1000000; i = i + 1 {
        if osSigFired == 1 {
            return
        }
    }
    Errorf("signal handler did not run")
}
