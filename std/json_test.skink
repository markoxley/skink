module json_test

import "std/json"
import "std/reflect"
import "std/strconv"
import "std/str"
import "testing"

// TestNull verifies the Null constructor.
pub fn TestNull() {
    v := json.Null()
    if json.IsNull(v) == false {
        Errorf("Null value should report IsNull true")
    }
}

// TestBool verifies boolean construction and access.
pub fn TestBool() {
    v := json.FromBool(true)
    if json.AsBool(v) != true {
        Errorf("FromBool(true) should yield true")
    }
    v2 := json.FromBool(false)
    if json.AsBool(v2) != false {
        Errorf("FromBool(false) should yield false")
    }
}

// TestNumber verifies number construction and access.
pub fn TestNumber() {
    v := json.FromNumber(42.0)
    if json.AsNumber(v) != 42.0 {
        Errorf("FromNumber should preserve the value")
    }
}

// TestString verifies string construction and access.
pub fn TestString() {
    v := json.FromString("hello")
    if str.Equal(json.AsString(v), "hello") == false {
        Errorf("FromString should preserve the string")
    }
}

// TestMarshalNull verifies null marshals to "null".
pub fn TestMarshalNull() {
    s := json.MarshalValue(json.Null())
    if str.Equal(s, "null") == false {
        Errorf("Marshal null should be null")
    }
}

// TestMarshalBool verifies boolean marshaling.
pub fn TestMarshalBool() {
    s := json.MarshalValue(json.FromBool(true))
    if str.Equal(s, "true") == false {
        Errorf("Marshal true should be true")
    }
    s2 := json.MarshalValue(json.FromBool(false))
    if str.Equal(s2, "false") == false {
        Errorf("Marshal false should be false")
    }
}

// TestMarshalString verifies string marshaling with quotes.
pub fn TestMarshalString() {
    s := json.MarshalValue(json.FromString("hi"))
    if str.Equal(s, "\"hi\"") == false {
        Errorf("Marshal string should include quotes")
    }
}

// TestUnmarshalNull verifies parsing of null.
pub fn TestUnmarshalNull() {
    v, err := json.Unmarshal("null")
    if err.message != "" {
        Errorf("Unmarshal null should not error")
    }
    if json.IsNull(v) == false {
        Errorf("Unmarshal null should produce null value")
    }
}

// TestUnmarshalBool verifies parsing of booleans.
pub fn TestUnmarshalBool() {
    v, err := json.Unmarshal("true")
    if err.message != "" {
        Errorf("Unmarshal true should not error")
    }
    if json.AsBool(v) != true {
        Errorf("Unmarshal true should yield true")
    }
    v2, err2 := json.Unmarshal("false")
    if err2.message != "" {
        Errorf("Unmarshal false should not error")
    }
    if json.AsBool(v2) != false {
        Errorf("Unmarshal false should yield false")
    }
}

// TestUnmarshalUnicodeEscape guards the \uXXXX decode regression — escape
// sequences previously consumed 'u' and emitted the hex digits as literal
// text ("\u2022" became "2022").
pub fn TestUnmarshalUnicodeEscape() {
    v, err := json.Unmarshal("\"\\u2022 \\u00e9\"")
    if err.message != "" {
        Errorf("Unmarshal \\u escape should not error")
    }
    s := json.AsString(v)
    // U+2022 = e2 80 a2, U+00E9 = c3 a9
    if str.Len(s) != 6 {
        Errorf("expected 6 bytes, got " + strconv.Itoa(str.Len(s)))
    }
    if s[0] != 226 || s[1] != 128 || s[2] != 162 {
        Errorf("expected U+2022 UTF-8 bytes")
    }
    if s[3] != 32 || s[4] != 195 || s[5] != 169 {
        Errorf("expected space + U+00E9 UTF-8 bytes")
    }

    // Surrogate pair: \uD83D\uDE00 = U+1F600 = f0 9f 98 80
    v2, _ := json.Unmarshal("\"\\uD83D\\uDE00\"")
    s2 := json.AsString(v2)
    if str.Len(s2) != 4 || s2[0] != 240 || s2[1] != 159 || s2[2] != 152 || s2[3] != 128 {
        Errorf("expected U+1F600 surrogate-pair decode")
    }

    // Lone surrogate becomes U+FFFD = ef bf bd
    v3, _ := json.Unmarshal("\"\\uD800x\"")
    s3 := json.AsString(v3)
    if str.Len(s3) != 4 || s3[0] != 239 || s3[1] != 191 || s3[2] != 189 || s3[3] != 120 {
        Errorf("expected U+FFFD + 'x' for lone surrogate")
    }
}

// TestUnmarshalNumber verifies parsing of an integer number.
pub fn TestUnmarshalNumber() {
    v, err := json.Unmarshal("123")
    if err.message != "" {
        Errorf("Unmarshal 123 should not error")
    }
    if json.AsNumber(v) != 123.0 {
        Errorf("Unmarshal 123 should yield 123")
    }
}

// TestRoundtripObject verifies marshal-then-unmarshal of a simple object.
pub fn TestRoundtripObject() {
    keys := ["name"]
    vals := [json.FromString("skink")]
    obj := json.FromObject(keys, vals)
    s := json.MarshalValue(obj)
    v2, err := json.Unmarshal(s)
    if err.message != "" {
        Errorf("Unmarshal should not error")
    }
    if json.ObjectLen(v2) != 1 {
        Errorf("Roundtrip object should preserve one key")
    }
    val := json.ObjectGet(v2, "name")
    if str.Equal(json.AsString(val), "skink") == false {
        Errorf("Roundtrip object should preserve string value")
    }
}

// --- MarshalStruct / UnmarshalInto: struct <-> JSON via [json] tags ---

// TaggedUser exercises every [json] flag: rename, ignore, omitempty.
pub struct TaggedUser {
    [json(ignore)]
    id: int64
    [json(name=full_name)]
    name: string
    age: int
    [json(omitempty)]
    nickname: string
    score: float
    active: bool
}

// BadJSON has an unmappable field type; MarshalStruct must reject it.
pub struct BadJSON {
    id: int64
    tags: []string
}

// TestMarshalStruct verifies object output honors renames and ignores.
pub fn TestMarshalStruct() {
    var u TaggedUser
    u.id = int64(7)
    u.name = "Ada"
    u.age = 36
    u.nickname = "ace"
    u.score = 9.5
    u.active = true
    s, err := json.MarshalStruct(reflect.TypeOf<TaggedUser>(u), int64(&u))
    if err.message != "" {
        Errorf("MarshalStruct should succeed")
    }
    if str.Contains(s, "full_name") == false {
        Errorf("[json(name=full_name)] should rename the key")
    }
    if str.Contains(s, "\"Ada\"") == false {
        Errorf("marshal should include the name value")
    }
    if str.Contains(s, "id") {
        Errorf("[json(ignore)] field should not appear")
    }
    if str.Contains(s, "nickname") == false {
        Errorf("non-empty omitempty field should appear")
    }
}

// TestMarshalStructOmitEmpty verifies zero-valued omitempty fields drop.
pub fn TestMarshalStructOmitEmpty() {
    var u TaggedUser
    u.name = "x"
    s, err := json.MarshalStruct(reflect.TypeOf<TaggedUser>(u), int64(&u))
    if err.message != "" {
        Errorf("MarshalStruct should succeed")
    }
    if str.Contains(s, "nickname") {
        Errorf("empty omitempty field should be omitted")
    }
    if str.Contains(s, "age") == false {
        Errorf("non-omitempty zero field should still appear")
    }
}

// TestMarshalStructUnsupported verifies unmappable types error out.
pub fn TestMarshalStructUnsupported() {
    var b BadJSON
    _, err := json.MarshalStruct(reflect.TypeOf<BadJSON>(b), int64(&b))
    if err.message == "" {
        Errorf("MarshalStruct should reject a slice field")
    }
    if str.Contains(err.message, "tags") == false {
        Errorf("error should name the offending field")
    }
}

// TestUnmarshalInto verifies object keys write into struct fields by
// (renamed) name, absent keys leave fields unchanged, unknown JSON
// keys are ignored.
pub fn TestUnmarshalInto() {
    var u TaggedUser
    u.age = 99
    err := json.UnmarshalInto("{\"full_name\":\"Grace\",\"score\":8.25,\"unknown\":1}", reflect.TypeOf<TaggedUser>(u), int64(&u))
    if err.message != "" {
        Errorf("UnmarshalInto should succeed")
    }
    if str.Equal(u.name, "Grace") == false {
        Errorf("[json(name=full_name)] should map to the name field")
    }
    if u.score != 8.25 {
        Errorf("float field should unmarshal")
    }
    if u.age != 99 {
        Errorf("absent keys should leave fields unchanged")
    }
    if u.id != int64(0) {
        Errorf("[json(ignore)] field should not be set")
    }
}

// TestUnmarshalIntoBad verifies malformed and non-object input errors.
pub fn TestUnmarshalIntoBad() {
    var u TaggedUser
    err := json.UnmarshalInto("not json", reflect.TypeOf<TaggedUser>(u), int64(&u))
    if err.message == "" {
        Errorf("malformed JSON should error")
    }
    err = json.UnmarshalInto("[1,2]", reflect.TypeOf<TaggedUser>(u), int64(&u))
    if err.message == "" {
        Errorf("non-object JSON should error")
    }
}

// TestStructRoundTrip verifies marshal then unmarshal restores fields.
pub fn TestStructRoundTrip() {
    var src TaggedUser
    src.name = "Katherine"
    src.age = 41
    src.score = 7.5
    src.active = true
    src.nickname = "kat"
    s, err := json.MarshalStruct(reflect.TypeOf<TaggedUser>(src), int64(&src))
    if err.message != "" {
        Errorf("MarshalStruct should succeed")
    }
    var dst TaggedUser
    err = json.UnmarshalInto(s, reflect.TypeOf<TaggedUser>(dst), int64(&dst))
    if err.message != "" {
        Errorf("UnmarshalInto should succeed")
    }
    if str.Equal(dst.name, "Katherine") == false || dst.age != 41 ||
        dst.score != 7.5 || dst.active == false ||
        str.Equal(dst.nickname, "kat") == false {
        Errorf("roundtrip should preserve all mapped fields")
    }
}
