module os

import "std/buf"
import "std/libc"

// C library and runtime wrappers.
extern fn system(cmd: string) -> int
extern fn exit(code: int)
extern fn getenv(name: string) -> string
extern fn setenv(name: string, value: string, overwrite: int) -> int
extern fn unsetenv(name: string) -> int
extern fn getcwd(buf: string, size: int64) -> string
extern fn chdir(path: string) -> int
extern fn popen(cmd: string, mode: string) -> int64
extern fn pclose(fp: int64) -> int
extern fn fread(buf: string, size: int64, nmemb: int64, fp: int64) -> int
extern fn feof(fp: int64) -> int
extern fn ferror(fp: int64) -> int
extern fn _skink_runtime_get_argc() -> int
extern fn _skink_runtime_get_argv() -> []string
extern fn Skink_os_exec(argv: string, argc: int) -> int
extern fn Skink_os_exec_with_output(argv: string, argc: int, statusOut: string) -> string
extern fn Skink_signal_handle(sig: int, handler: fn()) -> int

// System executes a shell command and returns its exit status.
// Deprecated: System passes the command through a shell, making it
// vulnerable to command injection if the command string includes
// untrusted input. Use Exec instead, which takes an argument array
// and does not invoke a shell.
pub fn System(cmd: string) -> int {
    return system(cmd)
}

// Exit terminates the process with the given exit code.
pub fn Exit(code: int) {
    exit(code)
}

// Getenv returns the value of the named environment variable,
// or an empty string if the variable is not set.
pub fn Getenv(name: string) -> string {
    return getenv(name)
}

// ArgsCount returns the number of command-line arguments.
pub fn ArgsCount() -> int {
    return _skink_runtime_get_argc()
}

// Args returns the command-line argument strings.
// The returned slice has length ArgsCount(); indexing beyond that is undefined.
pub fn Args() -> []string {
    return _skink_runtime_get_argv()
}

// Run executes a shell command and returns its exit status.
// Deprecated: Run passes the command through a shell, making it
// vulnerable to command injection. Use Exec instead.
pub fn Run(cmd: string) -> int {
    return system(cmd)
}

// Setenv sets an environment variable.
pub fn Setenv(name: string, value: string) -> bool {
    return setenv(name, value, 1) == 0
}

// Unsetenv removes an environment variable.
pub fn Unsetenv(name: string) -> bool {
    return unsetenv(name) == 0
}

// Getwd returns the current working directory.
pub fn Getwd() -> string {
    buf := libc.malloc(4096)
    result := getcwd(buf, 4096)
    if result == "" {
        libc.free(buf)
        return "" // getcwd failed; return empty string
    }
    return result
}

// Chdir changes the current working directory.
pub fn Chdir(path: string) -> bool {
    return chdir(path) == 0
}

// RunWithOutput executes a shell command and returns its stdout and exit status.
// Deprecated: RunWithOutput passes the command through a shell, making it
// vulnerable to command injection. Use ExecWithOutput instead.
pub fn RunWithOutput(cmd: string) -> (string, int) {
    fp := popen(cmd, "r")
    if fp == 0 {
        return "", -1 // popen failed
    }
    b := buf.NewBuffer()
    chunk := libc.malloc(256)
    for {
        n := fread(chunk, 1, 256, fp)
        if n <= 0 {
            break // EOF or error
        }
        b.Write(chunk, int(n))
    }
    libc.free(chunk)
    result := b.String()
    b.Free()
    status := pclose(fp)
    return result, status
}

// Exec runs a program with the given argument array without invoking a
// shell, preventing command injection. args[0] is the program path.
// Returns the child exit status, or -1 on error.
pub fn Exec(args: []string) -> int {
    if len(args) == 0 {
        return -1
    }
    // Build a NULL-terminated char** array from the Skink slice.
    // Each element is a pointer to a C string (i8*), which is 8 bytes.
    n := len(args)
    argvBuf := libc.malloc((n + 1) * 8)
    i := 0
    for i < n {
        slotAddr := string(int64(argvBuf) + int64(i * 8))
        // Store the POINTER to the C string, not the string contents.
        libc.memcpy(slotAddr, &args[i], 8)
        i = i + 1
    }
    // NULL-terminate the array (write 8 zero bytes)
    nullAddr := string(int64(argvBuf) + int64(n * 8))
    zero := libc.malloc(8)
    j := 0
    for j < 8 {
        zero[j] = 0
        j = j + 1
    }
    libc.memcpy(nullAddr, zero, 8)
    libc.free(zero)
    rc := Skink_os_exec(argvBuf, n)
    libc.free(argvBuf)
    return rc
}

// ExecWithOutput runs a program with the given argument array without
// invoking a shell, capturing stdout. args[0] is the program path.
// Returns the captured stdout and the child exit status.
pub fn ExecWithOutput(args: []string) -> (string, int) {
    if len(args) == 0 {
        return "", -1
    }
    n := len(args)
    argvBuf := libc.malloc((n + 1) * 8)
    i := 0
    for i < n {
        slotAddr := string(int64(argvBuf) + int64(i * 8))
        libc.memcpy(slotAddr, &args[i], 8)
        i = i + 1
    }
    nullAddr := string(int64(argvBuf) + int64(n * 8))
    zero := libc.malloc(8)
    j := 0
    for j < 8 {
        zero[j] = 0
        j = j + 1
    }
    libc.memcpy(nullAddr, zero, 8)
    libc.free(zero)
    statusBuf := libc.malloc(4)
    output := Skink_os_exec_with_output(argvBuf, n, statusBuf)
    // Reassemble the 4-byte exit status from individual bytes (little-endian)
    status := int(statusBuf[0]) | (int(statusBuf[1]) << 8) | (int(statusBuf[2]) << 16) | (int(statusBuf[3]) << 24)
    libc.free(statusBuf)
    libc.free(argvBuf)
    if int64(output) == 0 {
        return "", status // No output captured
    }
    return output, status
}


// OnSignal registers handler to be invoked when the process receives the
// given POSIX signal number (e.g. 2 for SIGINT). Returns false if the
// handler could not be installed. Handlers run on the interrupted thread;
// keep them minimal (set a flag) to stay async-signal-safe.
pub fn OnSignal(sig: int, handler: fn()) -> bool {
    return Skink_signal_handle(sig, handler) == 0
}
