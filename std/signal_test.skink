module signal_test

import "testing"
import "std/os"

var sigSeen: bool

fn onInt() {
    sigSeen = true
}

// TestOnSignalInstalls verifies os.OnSignal installs a signal handler.
pub fn TestOnSignalInstalls() {
    sigSeen = false
    ok := os.OnSignal(2, onInt) // SIGINT
    testing.AssertTrue(ok, "handler installs")
}
