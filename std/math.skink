module math

import "std/errors"

// Pi is the ratio of a circle's circumference to its diameter.
pub const Pi = 3.141592653589793
// E is the base of the natural logarithm.
pub const E = 2.718281828459045
// Sqrt2 is the square root of 2.
pub const Sqrt2 = 1.4142135623730951
// Ln2 is the natural logarithm of 2.
pub const Ln2 = 0.6931471805599453
// Ln10 is the natural logarithm of 10.
pub const Ln10 = 2.302585092994046

// C math library external declarations.
extern fn exp(x: float) -> float
extern fn log(x: float) -> float
extern fn log10(x: float) -> float
extern fn ceil(x: float) -> float
extern fn floor(x: float) -> float
extern fn atan(x: float) -> float
extern fn asin(x: float) -> float
extern fn acos(x: float) -> float
extern fn atan2(y: float, x: float) -> float
extern fn sinh(x: float) -> float
extern fn cosh(x: float) -> float
extern fn tanh(x: float) -> float
extern fn fabs(x: float) -> float
extern fn round(x: float) -> float

// Sqrt returns the square root of x.
pub fn Sqrt(x: float) -> float {
    return sqrt(x)
}

// Sin returns the sine of x (argument in radians).
pub fn Sin(x: float) -> float {
    return sin(x)
}

// Cos returns the cosine of x (argument in radians).
pub fn Cos(x: float) -> float {
    return cos(x)
}

// Tan returns the tangent of x (argument in radians).
pub fn Tan(x: float) -> float {
    return tan(x)
}

// Pow returns x raised to the power y.
pub fn Pow(x: float, y: float) -> float {
    return pow(x, y)
}

// Exp returns e raised to the power x.
pub fn Exp(x: float) -> float {
    return exp(x)
}

// Log returns the natural logarithm of x.
pub fn Log(x: float) -> float {
    return log(x)
}

// Log10 returns the base-10 logarithm of x.
pub fn Log10(x: float) -> float {
    return log10(x)
}

// Ceil returns the smallest integer value >= x.
pub fn Ceil(x: float) -> float {
    return ceil(x)
}

// Floor returns the largest integer value <= x.
pub fn Floor(x: float) -> float {
    return floor(x)
}

// Abs returns the absolute value of x.
pub fn Abs(x: float) -> float {
    return fabs(x)
}

// Round returns the nearest integer to x, rounding half away from zero.
pub fn Round(x: float) -> float {
    return round(x)
}

// Atan returns the arc-tangent of x (result in radians).
pub fn Atan(x: float) -> float {
    return atan(x)
}

// Asin returns the arc-sine of x (result in radians).
pub fn Asin(x: float) -> float {
    return asin(x)
}

// Acos returns the arc-cosine of x (result in radians).
pub fn Acos(x: float) -> float {
    return acos(x)
}

// Atan2 returns the arc-tangent of y/x, using the signs of both
// arguments to determine the correct quadrant (result in radians).
pub fn Atan2(y: float, x: float) -> float {
    return atan2(y, x)
}

// Sinh returns the hyperbolic sine of x.
pub fn Sinh(x: float) -> float {
    return sinh(x)
}

// Cosh returns the hyperbolic cosine of x.
pub fn Cosh(x: float) -> float {
    return cosh(x)
}

// Tanh returns the hyperbolic tangent of x.
pub fn Tanh(x: float) -> float {
    return tanh(x)
}

// Min returns the smaller of a and b.
pub fn Min(a: float, b: float) -> float {
    if a < b {
        return a
    }
    return b
}

// Max returns the larger of a and b.
pub fn Max(a: float, b: float) -> float {
    if a > b {
        return a
    }
    return b
}

// Clamp restricts x to the inclusive range [min, max].
pub fn Clamp(x: float, min: float, max: float) -> float {
    if x < min {
        return min
    }
    if x > max {
        return max
    }
    return x
}

// Degrees converts radians to degrees.
pub fn Degrees(radians: float) -> float {
    return radians * 180.0 / Pi
}

// Radians converts degrees to radians.
pub fn Radians(degrees: float) -> float {
    return degrees * Pi / 180.0
}

// Sign returns -1.0 if x < 0, 1.0 if x > 0, and 0.0 otherwise.
pub fn Sign(x: float) -> float {
    if x < 0.0 {
        return -1.0
    }
    if x > 0.0 {
        return 1.0
    }
    return 0.0
}

// ============================================================================
// Vector operations
// ============================================================================

// VectorDot computes the dot product of two float slices.
pub fn VectorDot(a: []float, b: []float) -> float {
    n := len(a)
    if len(b) < n {
        n = len(b) // Use the shorter length to avoid out-of-bounds
    }
    sum := 0.0
    for i := 0; i < n; i = i + 1 {
        sum = sum + a[i] * b[i]
    }
    return sum
}

// VectorNorm computes the L2 (Euclidean) norm of a vector.
pub fn VectorNorm(a: []float) -> float {
    return Sqrt(VectorDot(a, a))
}

// VectorNormalize returns the unit vector of a.
pub fn VectorNormalize(a: []float) -> []float {
    n := VectorNorm(a)
    if n == 0.0 {
        return a // Zero vector; return as-is to avoid division by zero
    }
    result := make([]float, len(a))
    for i := 0; i < len(a); i = i + 1 {
        result[i] = a[i] / n
    }
    return result
}

// VectorScale multiplies vector a by scalar s.
pub fn VectorScale(a: []float, s: float) -> []float {
    result := make([]float, len(a))
    for i := 0; i < len(a); i = i + 1 {
        result[i] = a[i] * s
    }
    return result
}

// VectorAdd adds two vectors element-wise.
pub fn VectorAdd(a: []float, b: []float) -> []float {
    n := len(a)
    if len(b) < n {
        n = len(b) // Use the shorter length
    }
    result := make([]float, n)
    for i := 0; i < n; i = i + 1 {
        result[i] = a[i] + b[i]
    }
    return result
}

// VectorSub subtracts vector b from vector a element-wise.
pub fn VectorSub(a: []float, b: []float) -> []float {
    n := len(a)
    if len(b) < n {
        n = len(b) // Use the shorter length
    }
    result := make([]float, n)
    for i := 0; i < n; i = i + 1 {
        result[i] = a[i] - b[i]
    }
    return result
}

// VectorDistance computes the Euclidean distance between two vectors.
pub fn VectorDistance(a: []float, b: []float) -> float {
    return VectorNorm(VectorSub(a, b))
}

// VectorLerp performs linear interpolation between a and b with parameter t.
pub fn VectorLerp(a: []float, b: []float, t: float) -> []float {
    n := len(a)
    if len(b) < n {
        n = len(b) // Use the shorter length
    }
    result := make([]float, n)
    for i := 0; i < n; i = i + 1 {
        result[i] = a[i] + t * (b[i] - a[i])
    }
    return result
}

// VectorSum returns the sum of all elements.
pub fn VectorSum(a: []float) -> float {
    sum := 0.0
    for i := 0; i < len(a); i = i + 1 {
        sum = sum + a[i]
    }
    return sum
}

// VectorMean returns the arithmetic mean of elements.
pub fn VectorMean(a: []float) -> float {
    if len(a) == 0 {
        return 0.0
    }
    return VectorSum(a) / float(len(a))
}

// ============================================================================
// Matrix type and operations
// ============================================================================

// Matrix is a dense matrix stored in row-major order.
pub struct Matrix {
    Rows:   int  // the rows
    Cols:   int  // the number of columns
    data:   []float  // row-major: element (i,j) at data[i*Cols + j]

    // At returns the element at row i, column j.
    pub fn At(self: Matrix, i: int, j: int) -> float {
        return self.data[i * self.Cols + j]
    }

    // Set sets the element at row i, column j.
    pub fn Set(self: *Matrix, i: int, j: int, v: float) {
        self.data[i * self.Cols + j] = v
    }

    // Row returns a copy of row i.
    pub fn Row(self: Matrix, i: int) -> []float {
        result := make([]float, self.Cols)
        for j := 0; j < self.Cols; j = j + 1 {
            result[j] = self.data[i * self.Cols + j]
        }
        return result
    }

    // Col returns a copy of column j.
    pub fn Col(self: Matrix, j: int) -> []float {
        result := make([]float, self.Rows)
        for i := 0; i < self.Rows; i = i + 1 {
            result[i] = self.data[i * self.Cols + j]
        }
        return result
    }

    // Add returns the sum of two matrices.
    pub fn Add(self: Matrix, other: Matrix) -> Matrix {
        result := NewMatrix(self.Rows, self.Cols)
        for i := 0; i < len(self.data); i = i + 1 {
            result.data[i] = self.data[i] + other.data[i]
        }
        return result
    }

    // Sub returns the difference of two matrices.
    pub fn Sub(self: Matrix, other: Matrix) -> Matrix {
        result := NewMatrix(self.Rows, self.Cols)
        for i := 0; i < len(self.data); i = i + 1 {
            result.data[i] = self.data[i] - other.data[i]
        }
        return result
    }

    // Scale returns the matrix multiplied by a scalar.
    pub fn Scale(self: Matrix, s: float) -> Matrix {
        result := NewMatrix(self.Rows, self.Cols)
        for i := 0; i < len(self.data); i = i + 1 {
            result.data[i] = self.data[i] * s
        }
        return result
    }

    // Mul returns the matrix product of self and other.
    pub fn Mul(self: Matrix, other: Matrix) -> Matrix {
        result := NewMatrix(self.Rows, other.Cols)
        for i := 0; i < self.Rows; i = i + 1 {
            for j := 0; j < other.Cols; j = j + 1 {
                sum := 0.0
                // Standard O(n^3) matrix multiplication inner loop
                for k := 0; k < self.Cols; k = k + 1 {
                    sum = sum + self.data[i * self.Cols + k] * other.data[k * other.Cols + j]
                }
                result.data[i * result.Cols + j] = sum
            }
        }
        return result
    }

    // Transpose returns the transpose of the matrix.
    pub fn Transpose(self: Matrix) -> Matrix {
        result := NewMatrix(self.Cols, self.Rows)
        for i := 0; i < self.Rows; i = i + 1 {
            for j := 0; j < self.Cols; j = j + 1 {
                result.data[j * self.Rows + i] = self.data[i * self.Cols + j]
            }
        }
        return result
    }

    // Trace returns the trace (sum of diagonal elements).
    pub fn Trace(self: Matrix) -> float {
        n := self.Rows
        if n > self.Cols {
            n = self.Cols // Use the smaller dimension for non-square matrices
        }
        sum := 0.0
        for i := 0; i < n; i = i + 1 {
            sum = sum + self.data[i * self.Cols + i]
        }
        return sum
    }

    // Det returns the determinant via Gaussian elimination.
    pub fn Det(self: Matrix) -> float {
        n := self.Rows
        if n != self.Cols {
            return 0.0 // Determinant is only defined for square matrices
        }
        if n == 1 {
            return self.data[0]
        }
        if n == 2 {
            // 2x2 determinant: ad - bc
            return self.data[0] * self.data[3] - self.data[1] * self.data[2]
        }
        // Copy data into a working buffer for in-place elimination
        a := make([]float, n * n)
        for i := 0; i < n * n; i = i + 1 {
            a[i] = self.data[i]
        }
        det := 1.0
        for col := 0; col < n; col = col + 1 {
            // Partial pivoting: find the row with the largest absolute value in this column
            pivot := col
            maxVal := Abs(a[col * n + col])
            for row := col + 1; row < n; row = row + 1 {
                val := Abs(a[row * n + col])
                if val > maxVal {
                    maxVal = val
                    pivot = row
                }
            }
            if maxVal == 0.0 {
                return 0.0 // Singular matrix
            }
            // Swap rows if needed; each swap negates the determinant
            if pivot != col {
                for j := 0; j < n; j = j + 1 {
                    tmp := a[col * n + j]
                    a[col * n + j] = a[pivot * n + j]
                    a[pivot * n + j] = tmp
                }
                det = -det
            }
            det = det * a[col * n + col]
            // Eliminate below the pivot
            for row := col + 1; row < n; row = row + 1 {
                factor := a[row * n + col] / a[col * n + col]
                for j := col; j < n; j = j + 1 {
                    a[row * n + j] = a[row * n + j] - factor * a[col * n + j]
                }
            }
        }
        return det
    }

    // Inverse returns the inverse via Gauss-Jordan elimination.
    pub fn Inverse(self: Matrix) -> (Matrix, errors.Error) {
        n := self.Rows
        if n != self.Cols {
            return NewMatrix(0, 0), errors.New("matrix is not square")
        }
        // Build augmented matrix [A | I] with 2n columns
        aug := make([]float, n * n * 2)
        for i := 0; i < n; i = i + 1 {
            for j := 0; j < n; j = j + 1 {
                aug[i * 2 * n + j] = self.data[i * n + j]
            }
            aug[i * 2 * n + n + i] = 1.0 // Identity on the right half
        }
        for col := 0; col < n; col = col + 1 {
            // Partial pivoting
            pivot := col
            maxVal := Abs(aug[col * 2 * n + col])
            for row := col + 1; row < n; row = row + 1 {
                val := Abs(aug[row * 2 * n + col])
                if val > maxVal {
                    maxVal = val
                    pivot = row
                }
            }
            if maxVal == 0.0 {
                return NewMatrix(0, 0), errors.New("matrix is singular")
            }
            // Swap rows in the augmented matrix
            if pivot != col {
                for j := 0; j < 2 * n; j = j + 1 {
                    tmp := aug[col * 2 * n + j]
                    aug[col * 2 * n + j] = aug[pivot * 2 * n + j]
                    aug[pivot * 2 * n + j] = tmp
                }
            }
            // Scale pivot row so the pivot element becomes 1
            pivotVal := aug[col * 2 * n + col]
            for j := 0; j < 2 * n; j = j + 1 {
                aug[col * 2 * n + j] = aug[col * 2 * n + j] / pivotVal
            }
            // Eliminate all other rows
            for row := 0; row < n; row = row + 1 {
                if row == col {
                    continue
                }
                factor := aug[row * 2 * n + col]
                for j := 0; j < 2 * n; j = j + 1 {
                    aug[row * 2 * n + j] = aug[row * 2 * n + j] - factor * aug[col * 2 * n + j]
                }
            }
        }
        // Extract the inverse from the right half of the augmented matrix
        result := NewMatrix(n, n)
        for i := 0; i < n; i = i + 1 {
            for j := 0; j < n; j = j + 1 {
                result.data[i * n + j] = aug[i * 2 * n + n + j]
            }
        }
        return result, errors.New("")
    }

    // Solve solves the linear system Ax = b and returns x.
    pub fn Solve(self: Matrix, b: []float) -> ([]float, errors.Error) {
        inv, err := self.Inverse()
        if err.message != "" {
            return [], err
        }
        n := self.Rows
        result := make([]float, n)
        // x = A^{-1} * b
        for i := 0; i < n; i = i + 1 {
            sum := 0.0
            for j := 0; j < n; j = j + 1 {
                sum = sum + inv.data[i * n + j] * b[j]
            }
            result[i] = sum
        }
        return result, errors.New("")
    }

    // MatrixNorm returns the Frobenius norm of the matrix.
    pub fn MatrixNorm(self: Matrix) -> float {
        sum := 0.0
        for i := 0; i < len(self.data); i = i + 1 {
            sum = sum + self.data[i] * self.data[i]
        }
        return Sqrt(sum)
    }

    // MulVec multiplies the matrix by a column vector.
    pub fn MulVec(self: Matrix, v: []float) -> []float {
        result := make([]float, self.Rows)
        for i := 0; i < self.Rows; i = i + 1 {
            sum := 0.0
            for j := 0; j < self.Cols; j = j + 1 {
                sum = sum + self.data[i * self.Cols + j] * v[j]
            }
            result[i] = sum
        }
        return result
    }
}

// NewMatrix creates a new r×c matrix initialized to zero.
pub fn NewMatrix(rows: int, cols: int) -> Matrix {
    return Matrix{Rows: rows, Cols: cols, data: make([]float, rows * cols)}
}

// IdentityMatrix creates an n×n identity matrix.
pub fn IdentityMatrix(n: int) -> Matrix {
    m := NewMatrix(n, n)
    for i := 0; i < n; i = i + 1 {
        m.data[i * n + i] = 1.0
    }
    return m
}

// MatrixFromRows creates a matrix from a slice of row slices.
pub fn MatrixFromRows(rows: [][]float) -> Matrix {
    r := len(rows)
    if r == 0 {
        return NewMatrix(0, 0)
    }
    c := len(rows[0])
    m := NewMatrix(r, c)
    for i := 0; i < r; i = i + 1 {
        for j := 0; j < c; j = j + 1 {
            m.data[i * c + j] = rows[i][j]
        }
    }
    return m
}

// ============================================================================
// Statistics
// ============================================================================

// Mean returns the arithmetic mean of a data slice.
pub fn Mean(data: []float) -> float {
    if len(data) == 0 {
        return 0.0
    }
    return VectorSum(data) / float(len(data))
}

// MinVal returns the minimum value in a data slice.
pub fn MinVal(data: []float) -> float {
    if len(data) == 0 {
        return 0.0
    }
    m := data[0]
    for i := 1; i < len(data); i = i + 1 {
        if data[i] < m {
            m = data[i]
        }
    }
    return m
}

// MaxVal returns the maximum value in a data slice.
pub fn MaxVal(data: []float) -> float {
    if len(data) == 0 {
        return 0.0
    }
    m := data[0]
    for i := 1; i < len(data); i = i + 1 {
        if data[i] > m {
            m = data[i]
        }
    }
    return m
}

// Variance returns the population variance of a data slice.
pub fn Variance(data: []float) -> float {
    n := len(data)
    if n == 0 {
        return 0.0
    }
    mu := Mean(data)
    sumSq := 0.0
    for i := 0; i < n; i = i + 1 {
        diff := data[i] - mu
        sumSq = sumSq + diff * diff
    }
    return sumSq / float(n)
}

// StdDev returns the population standard deviation of a data slice.
pub fn StdDev(data: []float) -> float {
    return Sqrt(Variance(data))
}

// SampleVariance returns the sample variance (with Bessel's correction).
pub fn SampleVariance(data: []float) -> float {
    n := len(data)
    if n <= 1 {
        return 0.0 // Need at least 2 data points for sample variance
    }
    mu := Mean(data)
    sumSq := 0.0
    for i := 0; i < n; i = i + 1 {
        diff := data[i] - mu
        sumSq = sumSq + diff * diff
    }
    return sumSq / float(n - 1) // Bessel's correction: divide by n-1
}

// SampleStdDev returns the sample standard deviation.
pub fn SampleStdDev(data: []float) -> float {
    return Sqrt(SampleVariance(data))
}

// Median returns the median of a data slice.
// The input is sorted in-place.
pub fn Median(data: []float) -> float {
    n := len(data)
    if n == 0 {
        return 0.0
    }
    // Copy and sort using insertion sort
    sorted := make([]float, n)
    for i := 0; i < n; i = i + 1 {
        sorted[i] = data[i]
    }
    for i := 1; i < n; i = i + 1 {
        key := sorted[i]
        j := i - 1
        for j >= 0 && sorted[j] > key {
            sorted[j + 1] = sorted[j]
            j = j - 1
        }
        sorted[j + 1] = key
    }
    mid := n / 2
    if n % 2 == 0 {
        // Even count: average the two middle elements
        return (sorted[mid - 1] + sorted[mid]) / 2.0
    }
    return sorted[mid]
}

// Percentile returns the p-th percentile (0 <= p <= 100) of the data.
pub fn Percentile(data: []float, p: float) -> float {
    n := len(data)
    if n == 0 {
        return 0.0
    }
    // Copy and sort using insertion sort
    sorted := make([]float, n)
    for i := 0; i < n; i = i + 1 {
        sorted[i] = data[i]
    }
    for i := 1; i < n; i = i + 1 {
        key := sorted[i]
        j := i - 1
        for j >= 0 && sorted[j] > key {
            sorted[j + 1] = sorted[j]
            j = j - 1
        }
        sorted[j + 1] = key
    }
    if p <= 0.0 {
        return sorted[0]
    }
    if p >= 100.0 {
        return sorted[n - 1]
    }
    // Linear interpolation between the two nearest data points
    rank := p / 100.0 * float(n - 1)
    lower := int(rank)
    frac := rank - float(lower)
    if lower + 1 >= n {
        return sorted[n - 1]
    }
    return sorted[lower] + frac * (sorted[lower + 1] - sorted[lower])
}

// Covariance returns the covariance of two data slices.
pub fn Covariance(x: []float, y: []float) -> float {
    n := len(x)
    if len(y) < n {
        n = len(y) // Use the shorter length
    }
    if n == 0 {
        return 0.0
    }
    mx := Mean(x)
    my := Mean(y)
    sumCov := 0.0
    for i := 0; i < n; i = i + 1 {
        sumCov = sumCov + (x[i] - mx) * (y[i] - my)
    }
    return sumCov / float(n)
}

// Correlation returns the Pearson correlation coefficient of two data slices.
pub fn Correlation(x: []float, y: []float) -> float {
    cov := Covariance(x, y)
    sx := StdDev(x)
    sy := StdDev(y)
    if sx == 0.0 || sy == 0.0 {
        return 0.0 // Avoid division by zero for constant data
    }
    return cov / (sx * sy)
}

// Sum returns the sum of all elements in a data slice.
pub fn Sum(data: []float) -> float {
    return VectorSum(data)
}

// ============================================================================
// Numerical integration (simplified — no function pointers)
// ============================================================================

// TrapezoidalIntegrate computes the integral using the trapezoidal rule.
// Takes pre-computed function values at evenly spaced points.
pub fn TrapezoidalIntegrate(values: []float, a: float, b: float) -> float {
    n := len(values)
    if n < 2 {
        return 0.0
    }
    h := (b - a) / float(n - 1)
    // Average the first and last points, then sum the interior points
    sum := (values[0] + values[n - 1]) / 2.0
    for i := 1; i < n - 1; i = i + 1 {
        sum = sum + values[i]
    }
    return sum * h
}

// SimpsonIntegrate computes the integral using Simpson's rule.
// Takes pre-computed function values at evenly spaced points.
// n must be odd (even number of intervals).
pub fn SimpsonIntegrate(values: []float, a: float, b: float) -> float {
    n := len(values)
    if n < 3 {
        return 0.0
    }
    h := (b - a) / float(n - 1)
    sum := values[0] + values[n - 1]
    for i := 1; i < n - 1; i = i + 1 {
        if i % 2 == 0 {
            sum = sum + 2.0 * values[i] // Even-index points get weight 2
        } else {
            sum = sum + 4.0 * values[i] // Odd-index points get weight 4
        }
    }
    return sum * h / 3.0
}

// ============================================================================
// Probability distributions
// ============================================================================

// NormalPDF returns the probability density function of N(mu, sigma) at x.
pub fn NormalPDF(x: float, mu: float, sigma: float) -> float {
    if sigma <= 0.0 {
        return 0.0
    }
    z := (x - mu) / sigma
    return Exp(-0.5 * z * z) / (sigma * Sqrt(2.0 * Pi))
}

// NormalCDF returns the cumulative distribution function of N(mu, sigma) at x.
// Uses the error function approximation.
pub fn NormalCDF(x: float, mu: float, sigma: float) -> float {
    if sigma <= 0.0 {
        return 0.0
    }
    z := (x - mu) / (sigma * Sqrt2)
    // Approximation of erf using tanh
    // erf(z) ≈ tanh(2/sqrt(pi) * z * (1 + 0.044715 * z^2))
    // This is a rough approximation
    return 0.5 * (1.0 + Tanh(1.1283791670955126 * z))
}

// LogisticSigmoid returns 1 / (1 + exp(-x)).
pub fn LogisticSigmoid(x: float) -> float {
    return 1.0 / (1.0 + Exp(-x))
}

// Softmax returns the softmax of a slice (numerically stable).
pub fn Softmax(a: []float) -> []float {
    if len(a) == 0 {
        return a
    }
    // Find max for numerical stability (prevents overflow in exp)
    m := a[0]
    for i := 1; i < len(a); i = i + 1 {
        if a[i] > m {
            m = a[i]
        }
    }
    // Compute exp(x - max) and sum
    exps := make([]float, len(a))
    sum := 0.0
    for i := 0; i < len(a); i = i + 1 {
        exps[i] = Exp(a[i] - m)
        sum = sum + exps[i]
    }
    // Normalize by the sum to get probabilities
    for i := 0; i < len(a); i = i + 1 {
        exps[i] = exps[i] / sum
    }
    return exps
}
