module time_test

import "std/time"
import "testing"

// TestTimestamp verifies that the current Unix timestamp is positive.
pub fn TestTimestamp() {
    ts := time.Timestamp()
    if ts <= 0 {
        Errorf("Timestamp should be positive")
    }
}

// TestNowUnixNano verifies nanosecond timestamp is positive.
pub fn TestNowUnixNano() {
    ns := time.NowUnixNano()
    if ns <= int64(0) {
        Errorf("NowUnixNano should be positive")
    }
}

// TestDurationFromSeconds verifies Duration creation.
pub fn TestDurationFromSeconds() {
    d := time.FromSeconds(int64(5))
    if d.nanoseconds != int64(5) * time.Second {
        Errorf("Duration from seconds should match 5 * Second")
    }
}

// TestDateTimeNow verifies Now returns a valid year.
pub fn TestDateTimeNow() {
    dt := time.Now()
    if dt.Year() < 2026 {
        Errorf("Current year should be >= 2026")
    }
    if dt.Month() < 1 || dt.Month() > 12 {
        Errorf("Month should be in range 1-12")
    }
    if dt.Day() < 1 || dt.Day() > 31 {
        Errorf("Day should be in range 1-31")
    }
}

// TestDurationNanoseconds verifies nanosecond accessor.
pub fn TestDurationNanoseconds() {
    d := time.FromMilliseconds(int64(1500))
    if d.Milliseconds() != int64(1500) {
        Errorf("Duration milliseconds should be 1500")
    }
}

// TestDateTimeUnixRoundtrip verifies Unix timestamp roundtrip.
pub fn TestDateTimeUnixRoundtrip() {
    dt := time.Now()
    unix := dt.Unix()
    dt2 := time.FromUnix(unix)
    if dt2.Unix() != unix {
        Errorf("Unix roundtrip should preserve timestamp")
    }
}

// TestTimerFires verifies that a Timer fires after the specified duration.
pub fn TestTimerFires() {
    t := time.NewTimer(time.FromMilliseconds(int64(100)))
    v := <-t.C
    if !v {
        Errorf("Timer should fire with true")
    }
}

// TestTickerTicks verifies that a Ticker fires multiple times.
pub fn TestTickerTicks() {
    tk := time.NewTicker(time.FromMilliseconds(int64(50)))
    count := 0
    for count < 3 {
        <-tk.C
        count = count + 1
    }
    tk.Stop()
    if count != 3 {
        Errorf("Ticker should have ticked 3 times")
    }
}

// TestTickerStop verifies that Stop halts the ticker.
pub fn TestTickerStop() {
    tk := time.NewTicker(time.FromMilliseconds(int64(100)))
    // Receive one tick
    <-tk.C
    // Stop the ticker
    tk.Stop()
    // If Stop works, the ticker goroutine will exit after closing the channel.
    // We can't easily test "no more ticks" without timing out, so just
    // verify Stop doesn't crash.
}

// TestTimerReset verifies that Reset re-arms the timer.
pub fn TestTimerReset() {
    t := time.NewTimer(time.FromMilliseconds(int64(50)))
    // Wait for first fire
    v := <-t.C
    if !v {
        Errorf("Timer should fire initially")
    }
    // Reset and wait again
    t.Reset(time.FromMilliseconds(int64(50)))
    v2 := <-t.C
    if !v2 {
        Errorf("Timer should fire after reset")
    }
}
