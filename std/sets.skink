// Element comparisons never use `==` or `in` on the generic element type:
// under type erasure `T` lowers to i8*, and the built-in comparison paths
// treat i8* as a string (strcmp), which crashes on non-string elements.
// Instead every comparison goes through reflect.Equals and membership
// lookups go through the reflect-aware hashing in std/hashmap — the same
// technique the HashMap module uses to support erased int/string keys.
module sets

import "std/hashmap"
import "std/reflect"

// Set is a mutable collection of unique elements backed by an
// open-addressed hash map (std/hashmap) for membership tests and an
// insertion-ordered element list for iteration. Elements may be any
// type usable with reflect.Equals — strings, integers, bools, floats,
// and pointers all behave correctly.
pub struct Set<T> {
    members: hashmap.HashMap<T, int>  // presence map; the int value is unused
    elems: []T                        // insertion-ordered elements

    // Add inserts v into the set. Returns true when v was newly added,
    // false when it was already present.
    fn Add(self: *Set<T>, v: T) -> bool {
        if self.members.Has(v) {
            return false
        }
        self.members.Put(v, 1)
        self.elems = append(self.elems, v)
        return true
    }

    // Remove deletes v from the set. Returns true when v was present,
    // false otherwise. Removal is a swap-remove on the element list, so
    // iteration order is not preserved for elements after the removed one.
    fn Remove(self: *Set<T>, v: T) -> bool {
        if !self.members.Has(v) {
            return false
        }
        self.members.Delete(v)
        t := reflect.TypeOf<T>(v)
        n := len(self.elems)
        i := 0
        for i < n {
            if reflect.Equals(self.elems[i], v, t.name) {
                self.elems[i] = self.elems[n - 1]
                self.elems = self.elems[:n - 1]
                return true
            }
            i = i + 1
        }
        // Unreachable in practice: members and elems are kept in sync.
        return true
    }

    // Has reports whether v is an element of the set.
    fn Has(self: *Set<T>, v: T) -> bool {
        return self.members.Has(v)
    }

    // Len returns the number of elements in the set.
    fn Len(self: *Set<T>) -> int {
        return self.members.Len()
    }

    // Clear removes every element from the set.
    fn Clear(self: *Set<T>) {
        self.members = hashmap.New<T, int>()
        var e []T
        self.elems = e
    }

    // ToSlice returns a fresh slice containing every element of the set
    // in insertion order.
    fn ToSlice(self: *Set<T>) -> []T {
        var out []T
        i := 0
        n := len(self.elems)
        for i < n {
            out = append(out, self.elems[i])
            i = i + 1
        }
        return out
    }

    // Union returns a new set containing every element of self and other.
    fn Union(self: *Set<T>, other: Set<T>) -> Set<T> {
        r := New<T>()
        i := 0
        n := len(self.elems)
        for i < n {
            r.Add(self.elems[i])
            i = i + 1
        }
        i = 0
        n = len(other.elems)
        for i < n {
            r.Add(other.elems[i])
            i = i + 1
        }
        return r
    }

    // Intersection returns a new set containing only the elements present
    // in both self and other.
    fn Intersection(self: *Set<T>, other: Set<T>) -> Set<T> {
        r := New<T>()
        i := 0
        n := len(self.elems)
        for i < n {
            if other.members.Has(self.elems[i]) {
                r.Add(self.elems[i])
            }
            i = i + 1
        }
        return r
    }

    // Difference returns a new set containing the elements of self that
    // are not present in other.
    fn Difference(self: *Set<T>, other: Set<T>) -> Set<T> {
        r := New<T>()
        i := 0
        n := len(self.elems)
        for i < n {
            if !other.members.Has(self.elems[i]) {
                r.Add(self.elems[i])
            }
            i = i + 1
        }
        return r
    }

    // SymmetricDifference returns a new set containing the elements that
    // are in exactly one of self or other.
    fn SymmetricDifference(self: *Set<T>, other: Set<T>) -> Set<T> {
        r := self.Difference(other)
        otherHalf := other.Difference(self)
        i := 0
        n := len(otherHalf.elems)
        for i < n {
            r.Add(otherHalf.elems[i])
            i = i + 1
        }
        return r
    }

    // IsSubset reports whether every element of self is also in other.
    fn IsSubset(self: *Set<T>, other: Set<T>) -> bool {
        i := 0
        n := len(self.elems)
        for i < n {
            if !other.members.Has(self.elems[i]) {
                return false
            }
            i = i + 1
        }
        return true
    }

    // IsSuperset reports whether self contains every element of other.
    fn IsSuperset(self: *Set<T>, other: Set<T>) -> bool {
        return other.IsSubset(self)
    }

    // IsDisjoint reports whether self and other share no elements.
    fn IsDisjoint(self: *Set<T>, other: Set<T>) -> bool {
        i := 0
        n := len(self.elems)
        for i < n {
            if other.members.Has(self.elems[i]) {
                return false
            }
            i = i + 1
        }
        return true
    }

    // Equals reports whether self and other contain exactly the same
    // elements.
    fn Equals(self: *Set<T>, other: Set<T>) -> bool {
        if self.Len() != other.Len() {
            return false
        }
        return self.IsSubset(other)
    }
}

// New returns an empty Set. The backing map allocates lazily on the
// first Add.
//
//   s := sets.New[int]()
pub fn New<T>() -> Set<T> {
    var elems []T
    return Set<T>{
        members: hashmap.New<T, int>(),
        elems: elems
    }
}

// FromSlice returns a Set containing the elements of items with
// duplicates removed.
pub fn FromSlice<T>(items: []T) -> Set<T> {
    r := New<T>()
    i := 0
    for i < len(items) {
        r.Add(items[i])
        i = i + 1
    }
    return r
}

// FromSet converts a built-in set literal into a mutable Set. A null or
// empty set produces an empty Set.
//
//   s := sets.FromSet(set{1, 2, 3})
pub fn FromSet<T>(s: set<T>) -> Set<T> {
    r := New<T>()
    for v in s {
        r.Add(v)
    }
    return r
}

// Contains reports whether v is an element of the built-in set s. This
// is the generic-safe equivalent of `v in s` (which uses a string
// comparison under type erasure and cannot be used inside generic code
// for non-string elements).
pub fn Contains<T>(s: set<T>, v: T) -> bool {
    t := reflect.TypeOf<T>(v)
    for e in s {
        if reflect.Equals(e, v, t.name) {
            return true
        }
    }
    return false
}

// Elements returns a fresh slice containing every element of the
// built-in set s.
pub fn Elements<T>(s: set<T>) -> []T {
    var out []T
    for v in s {
        out = append(out, v)
    }
    return out
}

// Union returns a new Set containing every element of the built-in sets
// a and b.
pub fn Union<T>(a: set<T>, b: set<T>) -> Set<T> {
    r := New<T>()
    for v in a {
        r.Add(v)
    }
    for v in b {
        r.Add(v)
    }
    return r
}

// Intersection returns a new Set containing only the elements present in
// both built-in sets a and b.
pub fn Intersection<T>(a: set<T>, b: set<T>) -> Set<T> {
    r := New<T>()
    for v in a {
        if Contains<T>(b, v) {
            r.Add(v)
        }
    }
    return r
}

// Difference returns a new Set containing the elements of built-in set a
// that are not present in b.
pub fn Difference<T>(a: set<T>, b: set<T>) -> Set<T> {
    r := New<T>()
    for v in a {
        if !Contains<T>(b, v) {
            r.Add(v)
        }
    }
    return r
}

// SymmetricDifference returns a new Set containing the elements that are
// in exactly one of the built-in sets a or b.
pub fn SymmetricDifference<T>(a: set<T>, b: set<T>) -> Set<T> {
    r := Difference<T>(a, b)
    otherHalf := Difference<T>(b, a)
    for v in otherHalf.elems {
        r.Add(v)
    }
    return r
}

// IsSubset reports whether every element of built-in set a is also in b.
pub fn IsSubset<T>(a: set<T>, b: set<T>) -> bool {
    for v in a {
        if !Contains<T>(b, v) {
            return false
        }
    }
    return true
}

// IsSuperset reports whether built-in set a contains every element of b.
pub fn IsSuperset<T>(a: set<T>, b: set<T>) -> bool {
    return IsSubset<T>(b, a)
}

// IsDisjoint reports whether built-in sets a and b share no elements.
pub fn IsDisjoint<T>(a: set<T>, b: set<T>) -> bool {
    for v in a {
        if Contains<T>(b, v) {
            return false
        }
    }
    return true
}

// Equal reports whether built-in sets a and b contain exactly the same
// elements.
pub fn Equal<T>(a: set<T>, b: set<T>) -> bool {
    return IsSubset<T>(a, b) && IsSubset<T>(b, a)
}
