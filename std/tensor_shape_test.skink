module tensor_shape_test

import "testing"
import "std/str"
import "std/tensor" as tsr

var caughtMsg: string

fn storeMsg(m: string) {
    caughtMsg = m
}

fn badMatMul() {
    defer fn() {
        storeMsg(recover())
    }()
    a := tsr.Zeros([2, 3])
    b := tsr.Zeros([2, 3]) // wrong inner dim
    c := tsr.MatMul(a, b)
    _ = c
}

// TestMatMulMismatchPanics verifies mismatched MatMul dimensions panic.
pub fn TestMatMulMismatchPanics() {
    caughtMsg = ""
    badMatMul()
    testing.AssertTrue(str.Len(caughtMsg) > 0, "mismatched MatMul must panic")
}

// TestMatMulOk verifies correct MatMul result shape for valid dims.
pub fn TestMatMulOk() {
    a := tsr.Zeros([2, 3])
    b := tsr.Zeros([3, 4])
    c := tsr.MatMul(a, b)
    s := c.Shape()
    testing.AssertEqualInt(2, s[0], "result rows")
    testing.AssertEqualInt(4, s[1], "result cols")
}
