module compiler_arith_test

import "testing"

// === Arithmetic Operators ===

// TestAddInt verifies integer addition with various operands.
pub fn TestAddInt() {
    testing.AssertEqualInt(5, 2 + 3, "2 + 3")
    testing.AssertEqualInt(0, 0 + 0, "0 + 0")
    testing.AssertEqualInt(-1, -3 + 2, "-3 + 2")
    testing.AssertEqualInt(1000000, 500000 + 500000, "large add")
}

// TestSubInt verifies integer subtraction with various operands.
pub fn TestSubInt() {
    testing.AssertEqualInt(2, 5 - 3, "5 - 3")
    testing.AssertEqualInt(0, 5 - 5, "5 - 5")
    testing.AssertEqualInt(-5, 0 - 5, "0 - 5")
    testing.AssertEqualInt(7, 10 - 3, "10 - 3")
}

// TestMulInt verifies integer multiplication including negatives.
pub fn TestMulInt() {
    testing.AssertEqualInt(6, 2 * 3, "2 * 3")
    testing.AssertEqualInt(0, 0 * 100, "0 * 100")
    testing.AssertEqualInt(1, 1 * 1, "1 * 1")
    testing.AssertEqualInt(-6, -2 * 3, "-2 * 3")
    testing.AssertEqualInt(6, -2 * -3, "-2 * -3")
}

// TestDivInt verifies integer division and truncation behavior.
pub fn TestDivInt() {
    testing.AssertEqualInt(2, 6 / 3, "6 / 3")
    testing.AssertEqualInt(3, 10 / 3, "10 / 3 (integer division)")
    testing.AssertEqualInt(0, 1 / 2, "1 / 2 (integer division)")
    testing.AssertEqualInt(-2, -6 / 3, "-6 / 3")
}

// TestModInt verifies integer modulo/remainder operator.
pub fn TestModInt() {
    testing.AssertEqualInt(1, 7 % 3, "7 % 3")
    testing.AssertEqualInt(0, 6 % 3, "6 % 3")
    testing.AssertEqualInt(2, 10 % 4, "10 % 4")
    testing.AssertEqualInt(0, 100 % 10, "100 % 10")
}

// TestPowerInt verifies integer exponentiation and right-associativity.
pub fn TestPowerInt() {
    testing.AssertEqualInt(8, 2 ** 3, "2 ** 3")
    testing.AssertEqualInt(1, 5 ** 0, "5 ** 0")
    testing.AssertEqualInt(16, 4 ** 2, "4 ** 2")
    testing.AssertEqualInt(512, 2 ** 3 ** 2, "2 ** 3 ** 2 (right-assoc)")
}

// TestArithmeticPrecedence verifies operator precedence in expressions.
pub fn TestArithmeticPrecedence() {
    // Multiplication binds tighter than addition
    testing.AssertEqualInt(14, 2 + 3 * 4, "2 + 3 * 4")
    testing.AssertEqualInt(20, (2 + 3) * 4, "(2 + 3) * 4")
    // Power binds tighter than multiplication
    testing.AssertEqualInt(11, 2 + 3 ** 2, "2 + 3 ** 2")
    testing.AssertEqualInt(24, 2 ** 3 * 3, "2 ** 3 * 3")
    // Division and multiplication same precedence, left-to-right
    testing.AssertEqualInt(3, 12 / 2 / 2, "12 / 2 / 2")
    testing.AssertEqualInt(8, 2 * 4 / 1, "2 * 4 / 1")
}

// TestFloatArithmetic verifies float add, sub, mul, div operations.
pub fn TestFloatArithmetic() {
    v := 1.5 + 2.5
    if v != 4.0 {
        testing.Fail()
    }
    v2 := 10.0 - 3.0
    if v2 != 7.0 {
        testing.Fail()
    }
    v3 := 2.5 * 4.0
    if v3 != 10.0 {
        testing.Fail()
    }
    v4 := 9.0 / 2.0
    if v4 != 4.5 {
        testing.Fail()
    }
}

// TestInt64Arithmetic verifies int64 multiplication without overflow.
pub fn TestInt64Arithmetic() {
    big := int64(6364136223846793005)
    testing.AssertEqualInt(0, int(big % int64(1)), "i64 mod 1")
    // Verify no overflow for large i64 constants
    // Note: big * 2 overflows i64, so test with a smaller multiplication
    small := int64(1000000)
    result := small * int64(1000)
    testing.AssertEqualInt(1000000000, int(result), "i64 multiplication no overflow")
}

// === Comparison Operators ===

// TestEqualInt verifies integer equality comparison.
pub fn TestEqualInt() {
    testing.AssertTrue(3 == 3, "3 == 3")
    testing.AssertTrue(0 == 0, "0 == 0")
    testing.AssertFalse(3 == 4, "3 != 4")
    testing.AssertFalse(-1 == 1, "-1 != 1")
}

// TestNotEqualInt verifies integer inequality comparison.
pub fn TestNotEqualInt() {
    testing.AssertTrue(3 != 4, "3 != 4")
    testing.AssertFalse(3 != 3, "3 == 3")
    testing.AssertTrue(0 != 1, "0 != 1")
}

// TestLessThan verifies integer less-than comparison.
pub fn TestLessThan() {
    testing.AssertTrue(2 < 3, "2 < 3")
    testing.AssertFalse(3 < 2, "3 < 2")
    testing.AssertFalse(3 < 3, "3 < 3")
    testing.AssertTrue(-5 < 0, "-5 < 0")
}

// TestGreaterThan verifies integer greater-than comparison.
pub fn TestGreaterThan() {
    testing.AssertTrue(3 > 2, "3 > 2")
    testing.AssertFalse(2 > 3, "2 > 3")
    testing.AssertFalse(3 > 3, "3 > 3")
    testing.AssertTrue(0 > -5, "0 > -5")
}

// TestLessEqual verifies integer less-than-or-equal comparison.
pub fn TestLessEqual() {
    testing.AssertTrue(2 <= 3, "2 <= 3")
    testing.AssertTrue(3 <= 3, "3 <= 3")
    testing.AssertFalse(4 <= 3, "4 <= 3")
}

// TestGreaterEqual verifies integer greater-than-or-equal comparison.
pub fn TestGreaterEqual() {
    testing.AssertTrue(3 >= 2, "3 >= 2")
    testing.AssertTrue(3 >= 3, "3 >= 3")
    testing.AssertFalse(2 >= 4, "2 >= 4")
}

// TestStringEquality verifies string equality and inequality.
pub fn TestStringEquality() {
    testing.AssertTrue("hello" == "hello", "string eq")
    testing.AssertFalse("hello" == "world", "string neq")
    testing.AssertTrue("" == "", "empty string eq")
}

// TestStringComparison verifies string lexicographic comparison.
pub fn TestStringComparison() {
    testing.AssertTrue("abc" < "abd", "abc < abd")
    testing.AssertFalse("abc" < "abc", "abc < abc false")
    testing.AssertTrue("abd" > "abc", "abd > abc")
}

// TestFloatComparison verifies float equality and ordering comparisons.
pub fn TestFloatComparison() {
    testing.AssertTrue(3.0 == 3.0, "float eq")
    testing.AssertTrue(3.5 > 3.0, "float gt")
    testing.AssertTrue(2.5 < 3.0, "float lt")
    testing.AssertFalse(3.0 != 3.0, "float neq false")
}

// === Logical Operators ===

// TestLogicalAnd verifies logical AND operator truth table.
pub fn TestLogicalAnd() {
    testing.AssertTrue(true && true, "true && true")
    testing.AssertFalse(true && false, "true && false")
    testing.AssertFalse(false && true, "false && true")
    testing.AssertFalse(false && false, "false && false")
}

// TestLogicalOr verifies logical OR operator truth table.
pub fn TestLogicalOr() {
    testing.AssertTrue(true || true, "true || true")
    testing.AssertTrue(true || false, "true || false")
    testing.AssertTrue(false || true, "false || true")
    testing.AssertFalse(false || false, "false || false")
}

// TestLogicalNot verifies logical NOT and double-NOT operator.
pub fn TestLogicalNot() {
    testing.AssertFalse(!true, "!true")
    testing.AssertTrue(!false, "!false")
    testing.AssertTrue(!!true, "!!true")
}

// TestLogicalShortCircuit verifies && and || short-circuit evaluation.
pub fn TestLogicalShortCircuit() {
    // If short-circuit works, this won't crash (division by zero would)
    x := 0
    if x != 0 && 10 / x > 0 {
        testing.Fail() // Should not reach here
    }
    if x == 0 || 10 / x > 0 {
        testing.AssertTrue(true, "short-circuit || worked")
    }
}

// TestLogicalPrecedence verifies AND binds tighter than OR.
pub fn TestLogicalPrecedence() {
    // AND binds tighter than OR
    testing.AssertTrue(true || false && false, "true || false && false")
    testing.AssertFalse(false || false && false, "false || false && false")
    testing.AssertTrue(true && true || false, "true && true || false")
}

// === Bitwise Operators ===

// TestBitwiseAnd verifies bitwise AND operator.
pub fn TestBitwiseAnd() {
    testing.AssertEqualInt(0, 0xFF & 0x00, "0xFF & 0x00")
    testing.AssertEqualInt(0x0F, 0xFF & 0x0F, "0xFF & 0x0F")
    testing.AssertEqualInt(5, 7 & 5, "7 & 5")
    testing.AssertEqualInt(0, 0 & 0, "0 & 0")
}

// TestBitwiseOr verifies bitwise OR operator.
pub fn TestBitwiseOr() {
    testing.AssertEqualInt(0xFF, 0xF0 | 0x0F, "0xF0 | 0x0F")
    testing.AssertEqualInt(7, 3 | 5, "3 | 5")
    testing.AssertEqualInt(0, 0 | 0, "0 | 0")
}

// TestBitwiseXor verifies bitwise XOR operator.
pub fn TestBitwiseXor() {
    testing.AssertEqualInt(0xFF, 0xFF ^ 0x00, "0xFF ^ 0x00")
    testing.AssertEqualInt(0x00, 0xFF ^ 0xFF, "0xFF ^ 0xFF")
    testing.AssertEqualInt(6, 3 ^ 5, "3 ^ 5")
}

// TestBitwiseNot verifies bitwise NOT (complement) operator.
pub fn TestBitwiseNot() {
    testing.AssertEqualInt(-1, ~0, "~0")
    testing.AssertEqualInt(-6, ~5, "~5")
}

// TestLeftShift verifies left shift operator.
pub fn TestLeftShift() {
    testing.AssertEqualInt(8, 1 << 3, "1 << 3")
    testing.AssertEqualInt(16, 2 << 3, "2 << 3")
    testing.AssertEqualInt(0, 0 << 10, "0 << 10")
}

// TestRightShift verifies right shift operator.
pub fn TestRightShift() {
    testing.AssertEqualInt(2, 8 >> 2, "8 >> 2")
    testing.AssertEqualInt(3, 12 >> 2, "12 >> 2")
    testing.AssertEqualInt(0, 1 >> 1, "1 >> 1")
}

// TestBitwisePrecedence verifies bitwise operator precedence rules.
pub fn TestBitwisePrecedence() {
    // & binds tighter than |
    testing.AssertEqualInt(0x0F, 0x0F | 0xF0 & 0x0F, "0x0F | 0xF0 & 0x0F")
    // ^ binds tighter than |
    testing.AssertEqualInt(0xF0, 0xF0 | 0x0F ^ 0x0F, "0xF0 | 0x0F ^ 0x0F")
    // In Skink, + has higher precedence than << (PREC_SUM=11 > PREC_SHIFT=10)
    // So 1 + 1 << 3 = (1 + 1) << 3 = 16
    testing.AssertEqualInt(16, 1 + 1 << 3, "1 + 1 << 3 == (1+1)<<3 == 16")
}

// === Compound Assignment Operators ===

// TestCompoundAdd verifies += compound assignment operator.
pub fn TestCompoundAdd() {
    x := 10
    x += 5
    testing.AssertEqualInt(15, x, "x += 5")
}

// TestCompoundSub verifies -= compound assignment operator.
pub fn TestCompoundSub() {
    x := 10
    x -= 3
    testing.AssertEqualInt(7, x, "x -= 3")
}

// TestCompoundMul verifies *= compound assignment operator.
pub fn TestCompoundMul() {
    x := 10
    x *= 3
    testing.AssertEqualInt(30, x, "x *= 3")
}

// TestCompoundDiv verifies /= compound assignment operator.
pub fn TestCompoundDiv() {
    x := 20
    x /= 4
    testing.AssertEqualInt(5, x, "x /= 4")
}

// TestCompoundMod verifies %= compound assignment operator.
pub fn TestCompoundMod() {
    x := 17
    x %= 5
    testing.AssertEqualInt(2, x, "x %= 5")
}

// TestCompoundBitwiseAnd verifies &= compound assignment operator.
pub fn TestCompoundBitwiseAnd() {
    x := 0xFF
    x &= 0x0F
    testing.AssertEqualInt(15, x, "x &= 0x0F")
}

// TestCompoundBitwiseOr verifies |= compound assignment operator.
pub fn TestCompoundBitwiseOr() {
    x := 0x0F
    x |= 0x30
    testing.AssertEqualInt(63, x, "x |= 0x30")
}

// TestCompoundBitwiseXor verifies ^= compound assignment operator.
pub fn TestCompoundBitwiseXor() {
    x := 0xFF
    x ^= 0x0F
    testing.AssertEqualInt(240, x, "x ^= 0x0F")
}

// TestCompoundLeftShift verifies <<= compound assignment operator.
pub fn TestCompoundLeftShift() {
    x := 1
    x <<= 4
    testing.AssertEqualInt(16, x, "x <<= 4")
}

// TestCompoundRightShift verifies >>= compound assignment operator.
pub fn TestCompoundRightShift() {
    x := 64
    x >>= 2
    testing.AssertEqualInt(16, x, "x >>= 2")
}

// TestCompoundAssignInForLoop verifies += in for-loop post position.
pub fn TestCompoundAssignInForLoop() {
    // This was the original bug: i += 1 in for-loop post position
    sum := 0
    for i := 0; i < 5; i += 1 {
        sum += i
    }
    testing.AssertEqualInt(10, sum, "sum 0..4 with += in for loop")
}

// TestCompoundAssignArrayElement verifies compound ops on array elements.
pub fn TestCompoundAssignArrayElement() {
    arr := []int{1, 2, 3}
    arr[1] += 10
    testing.AssertEqualInt(12, arr[1], "arr[1] += 10")
    arr[0] *= 5
    testing.AssertEqualInt(5, arr[0], "arr[0] *= 5")
}

// TestCompoundAssignStructField verifies compound ops on struct fields.
pub fn TestCompoundAssignStructField() {
    c := Counter{n: 0}
    c.n += 7
    testing.AssertEqualInt(7, c.n, "c.n += 7")
    c.n *= 3
    testing.AssertEqualInt(21, c.n, "c.n *= 3")
}

// === Prefix Operators ===

// TestNegateInt verifies unary negation of integers.
pub fn TestNegateInt() {
    testing.AssertEqualInt(-5, -5, "-5")
    testing.AssertEqualInt(5, -(-5), "-(-5)")
    testing.AssertEqualInt(0, -0, "-0")
}

// TestNegateFloat verifies unary negation of floats.
pub fn TestNegateFloat() {
    v := -3.5
    if v != -3.5 {
        testing.Fail()
    }
    v2 := -(-3.5)
    if v2 != 3.5 {
        testing.Fail()
    }
}

// TestDereference verifies pointer dereference returns pointed-to value.
pub fn TestDereference() {
    x := 42
    p := &x
    testing.AssertEqualInt(42, *p, "*p == 42")
}

// TestAddressOfAndDereference verifies address-of and dereference round trip.
pub fn TestAddressOfAndDereference() {
    val := 99
    ptr := &val
    testing.AssertEqualInt(99, *ptr, "*ptr")
    val2 := *ptr + 1
    testing.AssertEqualInt(100, val2, "*ptr + 1")
}

// === Type Conversions ===

// TestIntToFloat verifies int-to-float type conversion.
pub fn TestIntToFloat() {
    f := float(42)
    if f != 42.0 {
        testing.Fail()
    }
}

// TestFloatToInt verifies float-to-int conversion truncates toward zero.
pub fn TestFloatToInt() {
    n := int(3.7)
    testing.AssertEqualInt(3, n, "int(3.7) truncates")
}

// TestIntToString verifies int-to-string conversion via string().
pub fn TestIntToString() {
    // string() on an int converts to the string representation of the number
    s := string(65)
    testing.AssertEqualString("65", s, "string(65) == '65'")
}

// TestInt64Conversion verifies int64 to int conversion with overflow wrap.
pub fn TestInt64Conversion() {
    big := int64(2147483648)
    if big <= int64(0) {
        testing.Fail()
    }
    n := int(big)
    testing.AssertEqualInt(-2147483648, n, "int64 overflow to int wraps")
}

// === Helper struct for compound assignment tests ===

struct Counter {
    n: int
}
