module range_test

import "testing"

// TestRangeSum verifies for-in range sums integers correctly.
pub fn TestRangeSum() {
    sum := 0
    for i in 0..5 {
        sum = sum + i
    }
    testing.AssertEqualInt(10, sum, "0..5 sums to 0+1+2+3+4")
}

// TestRangeEmpty verifies empty range does not iterate.
pub fn TestRangeEmpty() {
    ran := false
    for i in 5..5 {
        ran = true
    }
    testing.AssertTrue(!ran, "empty range does not iterate")
}
