module compress

import "std/errors"
extern fn Skink_mem_byte(ptr: string, idx: int64) -> int
import "std/libc"

extern fn Skink_mem_write_byte(ptr: string, idx: int64, val: int)
import "std/str"

// External C functions for DEFLATE compression and CRC32 checksum.
extern fn Skink_compress_bound(srcLen: int) -> int
extern fn Skink_compress(src: string, srcLen: int, dest: string, destCap: int) -> int
extern fn Skink_uncompress(src: string, srcLen: int, dest: string, destCap: int) -> int
extern fn Skink_crc32(data: string, len: int) -> int

// writeLE32 writes a 32-bit little-endian integer into buf at offset.
fn writeLE32(buf: string, offset: int, val: int) {
    // Raw writes: buf is a freshly allocated binary buffer, not a
    // NUL-terminated string (comp_error.md #149).
    Skink_mem_write_byte(buf, int64(offset), val & 255)
    Skink_mem_write_byte(buf, int64(offset + 1), (val >> 8) & 255)
    Skink_mem_write_byte(buf, int64(offset + 2), (val >> 16) & 255)
    Skink_mem_write_byte(buf, int64(offset + 3), (val >> 24) & 255)
}

// GzipWriter wraps a writer and applies gzip compression.
pub struct GzipWriter {
    level: int  // the level
    buf: string  // the buffer
    bufLen: int  // the buffer length
    bufCap: int  // the buffer capacity
    closed: bool  // the closed

    // Write appends data to the internal buffer, growing it as needed.
    // Returns an error if the writer has already been closed.
    pub fn Write(self: *GzipWriter, data: string, len: int) -> (int, errors.Error) {
        if self.closed {
            return 0, errors.New("write to closed GzipWriter")
        }
        if len < 0 {
            return 0, errors.New("GzipWriter.Write: negative length")
        }
        // 64-bit math: bufLen + len can wrap int32, defeating the growth
        // check and letting the copy write past the buffer (VULN-13).
        if int64(self.bufLen) + int64(len) > int64(2147483647) {
            return 0, errors.New("GzipWriter: size overflow")
        }
        // Grow buffer until it can hold the new data
        for self.bufLen + len > self.bufCap {
            self.grow()
        }
        // Copy incoming bytes into the buffer
        for i := 0; i < len; i = i + 1 {
            Skink_mem_write_byte(self.buf, int64(self.bufLen + i), Skink_mem_byte(data, int64(i)))
        }
        self.bufLen = self.bufLen + len
        return len, errors.New("")
    }

    // Close finalizes the gzip stream by compressing the buffered data
    // and prepending a gzip header (with CRC32 and original size trailer).
    // Returns the compressed gzip data or an error.
    pub fn Close(self: *GzipWriter) -> (string, errors.Error) {
        if self.closed {
            return "", errors.New("GzipWriter already closed")
        }
        self.closed = true
        // Allocate output buffer with worst-case bound. Skink_compress_bound
        // returns -1 for a negative length or one whose bound overflows
        // int32 (near 2 GiB) — reject instead of passing a wrapped size
        // to zlib (comp_error.md #154).
        bound := Skink_compress_bound(self.bufLen)
        if bound <= 0 {
            libc.free(self.buf)
            return "", errors.New("compression failed")
        }
        compressed := libc.calloc(bound, 1)
        if int64(compressed) == 0 {
            libc.free(self.buf)
            return "", errors.New("out of memory")
        }
        compressedLen := Skink_compress(self.buf, self.bufLen, compressed, bound)
        if compressedLen < 0 {
            libc.free(compressed)
            libc.free(self.buf)
            return "", errors.New("compression failed")
        }
        // Compute CRC32 of the original uncompressed data
        crc := Skink_crc32(self.buf, self.bufLen)
        // gzip format: 10-byte header + compressed data + 8-byte trailer
        outLen := 10 + compressedLen + 8
        out := libc.calloc(outLen + 1, 1)
        // gzip header: magic, deflate method, no flags, no timestamps
        Skink_mem_write_byte(out, int64(0), 31)   // 0x1f
        Skink_mem_write_byte(out, int64(1), 139)  // 0x8b
        Skink_mem_write_byte(out, int64(2), 8)    // deflate
        Skink_mem_write_byte(out, int64(3), 0)    // flags
        for i := 4; i < 10; i = i + 1 {
            Skink_mem_write_byte(out, int64(i), 0)
        }
        // Copy compressed payload after the header
        libc.memcpy(string(int64(out) + int64(10)), compressed, compressedLen)
        // Trailer: CRC32 (4 bytes LE) + original size (4 bytes LE)
        writeLE32(out, 10 + compressedLen, crc)
        writeLE32(out, 10 + compressedLen + 4, self.bufLen)
        libc.free(compressed)
        libc.free(self.buf)
        return out, errors.New("")
    }

    fn grow(self: *GzipWriter) {
        // Double capacity, with a minimum of 256 bytes. int64 math so
        // bufCap * 2 cannot wrap negative near INT32_MAX (VULN-13).
        newCap := int64(self.bufCap) * 2
        if newCap < 256 {
            newCap = 256
        }
        if newCap > int64(2147483647) {
            panic("GzipWriter: size overflow")
        }
        self.buf = libc.realloc(self.buf, int(newCap))
        self.bufCap = int(newCap)
    }
}

// Deflater performs raw DEFLATE compression.
pub struct Deflater {
    windowBits: int  // the window bits
    memLevel: int  // the memory level

    // Compress returns the compressed data and its byte length.
    pub fn Compress(self: *Deflater, data: string, len: int) -> (string, int) {
        if len < 0 {
            // A negative len became a huge uLong in zlib — bounds-check
            // before it reaches C (VULN-13).
            return "", 0
        }
        bound := Skink_compress_bound(len)
        if bound <= 0 {
            return "", 0
        }
        out := libc.calloc(bound + 1, 1)
        if int64(out) == 0 {
            return "", 0
        }
        compressedLen := Skink_compress(data, len, out, bound)
        if compressedLen < 0 {
            // Compression failed; clean up and return empty
            libc.free(out)
            return "", 0
        }
        return out, compressedLen
    }
}

// Inflater performs raw DEFLATE decompression.
pub struct Inflater {
    // Decompress inflates data of length dataLen into a buffer of capacity outCap.
    pub fn Decompress(self: Inflater, data: string, dataLen: int, outCap: int) -> string {
        // Negative sizes became huge uLong values in zlib — a caller-
        // supplied outCap of -1 made calloc(0) succeed and then zlib
        // wrote unboundedly (VULN-13). outCap near INT_MAX also wraps
        // the +1 in the allocation and hands zlib a huge destLen with a
        // tiny (or NULL) buffer (comp_error.md #154).
        if dataLen < 0 || outCap <= 0 || outCap > 1073741824 {
            return ""
        }
        out := libc.calloc(outCap + 1, 1)
        if int64(out) == 0 {
            return ""
        }
        rc := Skink_uncompress(data, dataLen, out, outCap)
        if rc < 0 {
            // Decompression failed; clean up and return empty
            libc.free(out)
            return ""
        }
        return out
    }
}

// NewGzipWriter creates a GzipWriter with the given compression level
// and an initial 256-byte buffer.
pub fn NewGzipWriter(level: int) -> GzipWriter {
    return GzipWriter{
        level: level,
        buf: libc.malloc(256),
        bufLen: 0,
        bufCap: 256,
        closed: false
    }
}

// Compress is a one-shot convenience wrapper: deflate `data` and return
// the compressed bytes as a string prefixed with an 8-byte header holding
// the original and compressed sizes (both little-endian u32), so
// Decompress can recover lengths that strlen() cannot report on binary
// data. Matches the book's compress.Compress().
pub fn Compress(data: string) -> (string, errors.Error) {
    n := str.Len(data)
    bound := Skink_compress_bound(n)
    if bound <= 0 {
        return "", errors.New("compression failed")
    }
    out := libc.calloc(bound + 9, 1)
    if int64(out) == 0 {
        return "", errors.New("out of memory")
    }
    dest := string(int64(out) + int64(8))
    clen := Skink_compress(data, n, dest, bound)
    if clen < 0 {
        libc.free(out)
        return "", errors.New("compression failed")
    }
    writeLE32(out, 0, n)
    writeLE32(out, 4, clen)
    return out, errors.New("")
}

// DecompressBuf reverses Compress: reads the 8-byte size header and
// inflates the zlib payload back to the original bytes. dataLen is the
// real byte length of data (which may contain NULs); it bounds every
// header and payload read, and the claimed sizes are validated before
// any allocation — a crafted header can no longer cause an OOB read,
// an origSize+1 wrap, or a multi-gigabyte "decompression bomb"
// allocation (VULN-13).
pub fn DecompressBuf(data: string, dataLen: int) -> (string, errors.Error) {
    if dataLen < 8 {
        return "", errors.New("not a compress.Compress buffer")
    }
    origSize := int64(Skink_mem_byte(data, int64(0))) | (int64(Skink_mem_byte(data, int64(1))) << 8) | (int64(Skink_mem_byte(data, int64(2))) << 16) | (int64(Skink_mem_byte(data, int64(3))) << 24)
    clen := int64(Skink_mem_byte(data, int64(4))) | (int64(Skink_mem_byte(data, int64(5))) << 8) | (int64(Skink_mem_byte(data, int64(6))) << 16) | (int64(Skink_mem_byte(data, int64(7))) << 24)
    // The header fields are u32: reject sign-bit values, a payload
    // extending past the caller-provided length, and absurd output sizes.
    if origSize < 0 || origSize > int64(268435456) {
        return "", errors.New("not a compress.Compress buffer")
    }
    if clen <= 0 || clen > int64(dataLen) - 8 {
        return "", errors.New("not a compress.Compress buffer")
    }
    payload := libc.malloc(int(clen) + 1)
    for i := 0; i < int(clen); i = i + 1 {
        Skink_mem_write_byte(payload, int64(i), Skink_mem_byte(data, int64(i + 8)))
    }
    out := libc.calloc(int(origSize) + 1, 1)
    rc := Skink_uncompress(payload, int(clen), out, int(origSize))
    libc.free(payload)
    if rc < 0 {
        libc.free(out)
        return "", errors.New("decompression failed")
    }
    return out, errors.New("")
}

// Decompress reverses Compress.
//
// Deprecated: unsafe — a string cannot carry the real byte length of
// data containing NULs, so this delegates with str.Len(data), which
// stops at the first NUL and rejects most real Compress output rather
// than reading out of bounds. Use DecompressBuf with the true length.
pub fn Decompress(data: string) -> (string, errors.Error) {
    return DecompressBuf(data, str.Len(data))
}
