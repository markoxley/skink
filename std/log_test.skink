module log_test

import "std/log"
import "std/str"
import "testing"

// TestNewLogger verifies logger creation.
pub fn TestNewLogger() {
    l := log.NewLogger("[TEST] ")
    l.Print("hello")
}

// TestLoggerPrintf verifies formatted logging does not panic.
pub fn TestLoggerPrintf() {
    l := log.NewLogger("")
    l.Printf("value {}", 42)
}

// TestLogLevels verifies that log levels filter messages correctly.
pub fn TestLogLevels() {
    l := log.NewLogger("")
    l.SetLevel(log.LevelWarn)
    // Debug and Info should be filtered out (below Warn)
    l.Debug("debug message")
    l.Info("info message")
    // Warn and Error should pass
    l.Warn("warn message")
    l.Error("error message")
}

// TestNewLoggerWithLevel verifies logger creation with a specific level.
pub fn TestNewLoggerWithLevel() {
    l := log.NewLoggerWithLevel("[APP] ", log.LevelError)
    l.Info("this should be filtered")
    l.Error("this should appear")
}

// TestFileWriter verifies that FileWriter can be created and opened.
pub fn TestFileWriter() {
    fw := log.NewFileWriter("/tmp/skink_test_log.log")
    if fw.path != "/tmp/skink_test_log.log" {
        Errorf("FileWriter should store path")
    }
}

// TestLevelConstants verifies that log level constants are distinct.
pub fn TestLevelConstants() {
    if log.LevelDebug != 0 {
        Errorf("LevelDebug should be 0")
    }
    if log.LevelInfo != 1 {
        Errorf("LevelInfo should be 1")
    }
    if log.LevelWarn != 2 {
        Errorf("LevelWarn should be 2")
    }
    if log.LevelError != 3 {
        Errorf("LevelError should be 3")
    }
    if log.LevelFatal != 4 {
        Errorf("LevelFatal should be 4")
    }
}
