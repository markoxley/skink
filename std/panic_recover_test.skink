module panic_recover_test

import "testing"
import "std/str"

var prMsg: string

fn recSave(m: string) {
    prMsg = m
}

fn willPanic() {
    defer fn() {
        recSave(recover())
    }()
    panic("boom")
}

// TestRecoverMessage verifies recover captures the panic message.
pub fn TestRecoverMessage() {
    prMsg = ""
    willPanic()
    testing.AssertEqualString("boom", prMsg, "recover captures panic msg")
}

var prOrder: int

fn defA() {
    prOrder = prOrder * 10 + 1
}

fn defB() {
    prOrder = prOrder * 10 + 2
    r := recover()
    if str.Len(r) > 0 {
        prOrder = prOrder * 10 + 9
    }
}

fn panicWithTwoDefers() {
    defer defA()
    defer defB()
    panic("two")
}

// TestDefersRunOnPanic verifies deferred functions run LIFO on panic.
pub fn TestDefersRunOnPanic() {
    prOrder = 0
    panicWithTwoDefers()
    // defB runs first (LIFO), sees the panic; then defA
    testing.AssertEqualInt(291, prOrder, "deferred fns run LIFO on panic")
}

// TestRecoverOutsidePanic verifies recover outside panic returns empty.
pub fn TestRecoverOutsidePanic() {
    r := recover()
    testing.AssertEqualString("", r, "recover outside panic returns empty")
}
