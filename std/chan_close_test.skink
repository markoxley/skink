module chan_close_test

import "testing"

// TestCommaOkOnClosed verifies comma-ok receive on a closed channel.
pub fn TestCommaOkOnClosed() {
    ch := make(chan<int>, 2)
    ch <- 42
    close(ch)
    v, ok := <-ch
    testing.AssertEqualInt(42, v, "buffered value survives close")
    testing.AssertTrue(ok, "ok true with buffered value")
    v2, ok2 := <-ch
    testing.AssertEqualInt(0, v2, "zero value on closed+empty")
    testing.AssertTrue(!ok2, "ok false on closed+empty")
}

// TestPlainRecvOnClosed verifies plain receive on a closed channel.
pub fn TestPlainRecvOnClosed() {
    ch := make(chan<int>, 1)
    close(ch)
    v := <-ch
    testing.AssertEqualInt(0, v, "plain recv on closed returns zero value")
}
