module encrypt_roundtrip_test

import "testing"
import "std/encrypt"

// TestAESRoundTrip verifies AES encrypt then decrypt returns original.
pub fn TestAESRoundTrip() {
    key := "0123456789abcdef" // 16 bytes = AES-128
    pt := "secret message"
    ct, err := encrypt.AESEncrypt(key, pt)
    testing.AssertTrue(err.message == "", "encrypt ok")
    res, derr := encrypt.AESDecrypt(key, ct.Data(), ct.Length())
    testing.AssertTrue(derr.message == "", "decrypt ok")
    testing.AssertEqualString(pt, res.Data(), "round trip")
}
