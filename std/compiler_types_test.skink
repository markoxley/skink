module compiler_types_test

import "testing"
import "std/strconv"

// === Struct Basics ===

// TestStructLiteral verifies struct literal construction and field access.
pub fn TestStructLiteral() {
    p := Point{x: 3, y: 4}
    testing.AssertEqualInt(3, p.x, "Point.x")
    testing.AssertEqualInt(4, p.y, "Point.y")
}

// TestStructFieldAccess verifies struct field read access.
pub fn TestStructFieldAccess() {
    p := Point{x: 10, y: 20}
    testing.AssertEqualInt(10, p.x, "field access x")
    testing.AssertEqualInt(20, p.y, "field access y")
}

// TestStructFieldMutation verifies struct field mutation via assignment.
pub fn TestStructFieldMutation() {
    p := Point{x: 1, y: 2}
    p.x = 100
    p.y = 200
    testing.AssertEqualInt(100, p.x, "mutated x")
    testing.AssertEqualInt(200, p.y, "mutated y")
}

// TestStructWithStrings verifies struct with string and int fields.
pub fn TestStructWithStrings() {
    p := Person{name: "Alice", age: 30}
    testing.AssertEqualString("Alice", p.name, "Person.name")
    testing.AssertEqualInt(30, p.age, "Person.age")
}

// TestStructWithSlice verifies struct with slice field.
pub fn TestStructWithSlice() {
    list := IntList{items: []int{1, 2, 3, 4, 5}}
    testing.AssertEqualInt(5, len(list.items), "slice field len")
    testing.AssertEqualInt(3, list.items[2], "slice field element")
}

// TestStructNested verifies nested struct field access.
pub fn TestStructNested() {
    outer := Outer{inner: Point{x: 5, y: 10}, label: "test"}
    testing.AssertEqualInt(5, outer.inner.x, "nested struct field x")
    testing.AssertEqualInt(10, outer.inner.y, "nested struct field y")
    testing.AssertEqualString("test", outer.label, "nested struct label")
}

// TestStructPointer verifies struct pointer field access and mutation.
pub fn TestStructPointer() {
    p := Point{x: 7, y: 8}
    ptr := &p
    testing.AssertEqualInt(7, ptr.x, "pointer field access x")
    ptr.x = 99
    testing.AssertEqualInt(99, p.x, "pointer mutation reflects on struct")
}

// === Struct Methods ===

// TestStructMethod verifies struct method call by value.
pub fn TestStructMethod() {
    p := Point{x: 3, y: 4}
    testing.AssertEqualInt(25, p.DistanceSq(), "Point.DistanceSq()")
}

// TestStructMethodMutation verifies struct method mutates fields via pointer.
pub fn TestStructMethodMutation() {
    p := Point{x: 1, y: 2}
    p.Move(10, 20)
    testing.AssertEqualInt(11, p.x, "Move x")
    testing.AssertEqualInt(22, p.y, "Move y")
}

// TestStructMethodOnPointer verifies method call via struct pointer.
pub fn TestStructMethodOnPointer() {
    p := Point{x: 5, y: 10}
    ptr := &p
    testing.AssertEqualInt(125, ptr.DistanceSq(), "method via pointer")
}

// TestStructMethodWithReturn verifies struct method returning string.
pub fn TestStructMethodWithReturn() {
    p := Person{name: "Bob", age: 25}
    testing.AssertEqualString("Bob (25)", p.Describe(), "Person.Describe()")
}

// === Struct with pub fields ===

// TestStructPubFields verifies public struct field access and mutation.
pub fn TestStructPubFields() {
    acc := Account{balance: 1000}
    testing.AssertEqualInt(1000, acc.balance, "pub field access")
    acc.balance -= 200
    testing.AssertEqualInt(800, acc.balance, "pub field mutation")
}

// === Enums ===

// TestEnumConstants verifies enum variants are int constants from 0.
pub fn TestEnumConstants() {
    // Simple enums declare variants as int constants starting from 0
    testing.AssertEqualInt(0, int(ColorRed), "ColorRed == 0")
    testing.AssertEqualInt(1, int(ColorGreen), "ColorGreen == 1")
    testing.AssertEqualInt(2, int(ColorBlue), "ColorBlue == 2")
}

// TestEnumInSwitch verifies enum used in switch statement.
pub fn TestEnumInSwitch() {
    c := ColorGreen
    result := ""
    switch c {
    case ColorRed:
        result = "red"
    case ColorGreen:
        result = "green"
    case ColorBlue:
        result = "blue"
    default:
        result = "unknown"
    }
    testing.AssertEqualString("green", result, "enum in switch")
}

// === Const Declarations ===

// TestConstInt verifies integer const declarations.
pub fn TestConstInt() {
    testing.AssertEqualInt(42, TheAnswer, "const int")
    testing.AssertEqualInt(0, Zero, "const zero")
}

// TestConstString verifies string const declarations.
pub fn TestConstString() {
    testing.AssertEqualString("hello", Greeting, "const string")
    testing.AssertEqualString("", EmptyConst, "const empty string")
}

// TestConstBlock verifies const block declarations.
pub fn TestConstBlock() {
    testing.AssertEqualInt(0, FirstConst, "const block first")
    testing.AssertEqualInt(1, SecondConst, "const block second")
    testing.AssertEqualInt(2, ThirdConst, "const block third")
}

// TestConstInExpression verifies consts used in expressions.
pub fn TestConstInExpression() {
    testing.AssertEqualInt(42 + 1, TheAnswer + 1, "const in expression")
    testing.AssertEqualInt(84, TheAnswer * 2, "const in multiplication")
}

// === Type Aliases ===
// Note: Type aliases work for declarations but casting aliased types
// back to their underlying type is not supported in module context.

// TestTypeAlias verifies type alias declaration and usage.
pub fn TestTypeAlias() {
    var score Score = 95
    testing.AssertEqualInt(95, score, "type alias Score value")
}

// === Generic Struct ===
// Note: Generic structs with type parameters (e.g. Box<T>) have limitations
// in the self-hosted compiler due to type erasure. The HashMap module works
// because it uses reflect.TypeOf and runtime heuristics. Here we test
// non-generic struct patterns instead.

// TestGenericStructInt verifies generic struct with int field.
pub fn TestGenericStructInt() {
    box := IntBox{value: 42}
    testing.AssertEqualInt(42, box.value, "IntBox.value")
    testing.AssertEqualInt(42, box.Get(), "IntBox.Get()")
}

// TestGenericStructString verifies generic struct with string field.
pub fn TestGenericStructString() {
    box := StringBox{value: "hello"}
    testing.AssertEqualString("hello", box.value, "StringBox.value")
    testing.AssertEqualString("hello", box.Get(), "StringBox.Get()")
}

// TestGenericStructSet verifies generic struct Set method via pointer.
pub fn TestGenericStructSet() {
    box := IntBox{value: 10}
    box.Set(99)
    testing.AssertEqualInt(99, box.value, "IntBox.Set() updates value")
}

// === Generic Function ===

// TestGenericFunction verifies generic max function with ints.
pub fn TestGenericFunction() {
    testing.AssertEqualInt(5, MaxInt(3, 5), "Max(3, 5)")
    testing.AssertEqualInt(10, MaxInt(10, 2), "Max(10, 2)")
    testing.AssertEqualInt(-1, MaxInt(-1, -5), "Max(-1, -5)")
}

// TestGenericStructFieldAccess guards comp_error.md #142: a field access
// on an instantiated generic struct (GenWrap<int>) previously reported the
// erased declared slot type, so a scalar T field read its raw inttoptr
// box as a pointer instead of unboxing the integer value.
pub fn TestGenericStructFieldAccess() {
    w := GenWrap<int>{v: 5}
    testing.AssertEqualInt(5, w.v, "GenWrap<int>.v unboxes scalar field")
    ws := GenWrap<string>{v: "hi"}
    testing.AssertEqualString("hi", ws.v, "GenWrap<string>.v")
}

// TestGenericStructFieldWrite also guards comp_error.md #142 on the write
// side: plain and compound scalar assignment must box/unbox through the
// erased i8* slot correctly.
pub fn TestGenericStructFieldWrite() {
    w := GenWrap<int>{v: 0}
    w.v = 42
    testing.AssertEqualInt(42, w.v, "w.v = 42")
    w.v += 8
    testing.AssertEqualInt(50, w.v, "w.v += 8")
    ws := GenWrap<string>{v: "a"}
    ws.v = "b"
    testing.AssertEqualString("b", ws.v, "ws.v = \"b\"")
}

// TestGenericStructSliceField verifies a []T field on an instantiated
// generic struct. Pointer-sized elements (string) are the legal
// instantiation under the erased-composite guard — index, append, len,
// and for-in must all see the substituted element type.
pub fn TestGenericStructSliceField() {
    w := GenSliceBox<string>{elems: []string{"a", "b"}}
    testing.AssertEqualString("a", w.elems[0], "GenSliceBox<string>.elems[0]")
    testing.AssertEqualInt(2, len(w.elems), "len(GenSliceBox<string>.elems)")
    w.elems[0] = "z"
    testing.AssertEqualString("z", w.elems[0], "w.elems[0] = \"z\"")
    w.elems = append(w.elems, "c")
    testing.AssertEqualInt(3, len(w.elems), "len after append to w.elems")
    n := 0
    for _ := range w.elems {
        n = n + 1
    }
    testing.AssertEqualInt(3, n, "for-in over w.elems")
}

// TestGenericStructNestedFields checks substitution through a nested
// generic struct field (Outer<int>.inner.val).
pub fn TestGenericStructNestedFields() {
    o := GenOuter<int>{inner: GenInner<int>{val: 77}}
    testing.AssertEqualInt(77, o.inner.val, "GenOuter<int>.inner.val")
}

// TestGenericMapScalarKeys guards comp_error.md #141 (map side): builtin
// map[K]V operations inside generic code hashed every erased i8* key with
// Skink_str_hash and compared with strcmp, so Skink_str_hash(inttoptr(7))
// dereferenced a non-pointer and segfaulted. Erased keys now route through
// reflect_hash/reflect_equals. (map[K]V may not appear in signatures
// instantiated with scalar K/V, so the map is built inside the generic
// function — the same erased-key code path.)
pub fn TestGenericMapScalarKeys() {
    testing.AssertEqualInt(42, genMapRoundTrip<int, int>(7, 42), "generic map put/get int key")
    testing.AssertFalse(genMapProbe<int, int>(7, 9), "generic map missing int key")
    testing.AssertEqualInt(2, genMapSize<int, int>(3, 5), "generic map len after puts")
    testing.AssertEqualInt(0, genMapAfterDelete<int, int>(6), "generic map delete")
    testing.AssertEqualInt(2, genMapKeyCount<int, int>(4, 8), "generic map key iteration")
}

// TestGenericMapStringKeys checks that erased string keys still hash and
// compare by content through the reflect path, not by pointer identity.
pub fn TestGenericMapStringKeys() {
    testing.AssertEqualInt(10, genMapRoundTrip<string, int>("k", 10), "generic map put/get string key")
    testing.AssertEqualInt(10, genMapLookup<string, int>("k", "k", 10), "generic map string key by content")
}

// TestGenericErasedEquality guards the == / != portion of comp_error.md
// #141: comparing two erased i8* values with strcmp crashed on scalar
// operands. Comparisons now route through reflect_equals.
pub fn TestGenericErasedEquality() {
    testing.AssertTrue(genEq<int>(7, 7), "genEq int equal")
    testing.AssertFalse(genEq<int>(7, 8), "genEq int unequal")
    testing.AssertTrue(genNe<int>(7, 8), "genNe int unequal")
    testing.AssertTrue(genEq<string>("x", "x"), "genEq string equal")
    testing.AssertFalse(genEq<string>("x", "y"), "genEq string unequal")
}

// === Functions: Multiple Returns ===

// TestMultipleReturn verifies function with multiple return values.
pub fn TestMultipleReturn() {
    a, b := swap(10, 20)
    testing.AssertEqualInt(20, a, "swap a")
    testing.AssertEqualInt(10, b, "swap b")
}

// TestMultipleReturnThree verifies function with three return values.
pub fn TestMultipleReturnThree() {
    a, b, c := three(1, 2, 3)
    testing.AssertEqualInt(3, a, "three a")
    testing.AssertEqualInt(2, b, "three b")
    testing.AssertEqualInt(1, c, "three c")
}

// TestMultipleReturnIgnored verifies ignoring second return with _.
pub fn TestMultipleReturnIgnored() {
    a, _ := swap(100, 200)
    testing.AssertEqualInt(200, a, "swap with ignored second")
}

// === Functions: Recursion ===

// TestRecursionFactorial verifies recursive factorial function.
pub fn TestRecursionFactorial() {
    testing.AssertEqualInt(1, factorial(0), "0!")
    testing.AssertEqualInt(1, factorial(1), "1!")
    testing.AssertEqualInt(2, factorial(2), "2!")
    testing.AssertEqualInt(6, factorial(3), "3!")
    testing.AssertEqualInt(24, factorial(4), "4!")
    testing.AssertEqualInt(120, factorial(5), "5!")
}

// TestRecursionFibonacci verifies recursive fibonacci function.
pub fn TestRecursionFibonacci() {
    testing.AssertEqualInt(0, fib(0), "fib(0)")
    testing.AssertEqualInt(1, fib(1), "fib(1)")
    testing.AssertEqualInt(1, fib(2), "fib(2)")
    testing.AssertEqualInt(5, fib(5), "fib(5)")
    testing.AssertEqualInt(55, fib(10), "fib(10)")
}

// === Functions: Default/empty ===

// TestFunctionNoReturn verifies void function modifies via slice.
pub fn TestFunctionNoReturn() {
    // Use a single-element slice as mutable storage since *ptr = val
    // dereference assignment is not supported by the emitter.
    arr := make([]int, 1)
    setArrVal(arr, 42)
    testing.AssertEqualInt(42, arr[0], "function modifies via slice")
}

// TestFunctionNoParams verifies function with no parameters.
pub fn TestFunctionNoParams() {
    testing.AssertEqualInt(42, return42(), "function with no params")
}

// === Extern functions ===

// TestExternFunction verifies extern C function call (strlen).
pub fn TestExternFunction() {
    // strlen is an extern C function
    s := "hello"
    n := strlen(s)
    testing.AssertEqualInt(5, n, "extern strlen")
}

// === Struct definitions for tests ===

struct Point {
    x: int
    y: int

    fn DistanceSq(self: Point) -> int {
        return self.x * self.x + self.y * self.y
    }

    fn Move(self: *Point, dx: int, dy: int) {
        self.x += dx
        self.y += dy
    }
}

struct Person {
    name: string
    age: int

    fn Describe(self: Person) -> string {
        return str.Concat(str.Concat(self.name, " ("), str.Concat(strconv.Itoa(self.age), ")"))
    }
}

struct IntList {
    items: []int
}

struct Outer {
    inner: Point
    label: string
}

struct Account {
    pub balance: int
}

struct IntBox {
    value: int

    fn Get(self: IntBox) -> int {
        return self.value
    }

    fn Set(self: *IntBox, v: int) {
        self.value = v
    }
}

struct StringBox {
    value: string

    fn Get(self: StringBox) -> string {
        return self.value
    }
}

enum Color {
    ColorRed
    ColorGreen
    ColorBlue
}

const TheAnswer = 42
const Zero = 0
const Greeting = "hello"
const EmptyConst = ""

const {
    FirstConst = 0
    SecondConst = 1
    ThirdConst = 2
}

type Score = int

fn MaxInt(a: int, b: int) -> int {
    if a > b {
        return a
    }
    return b
}

fn swap(a: int, b: int) -> (int, int) {
    return b, a
}

fn three(a: int, b: int, c: int) -> (int, int, int) {
    return c, b, a
}

fn factorial(n: int) -> int {
    if n <= 1 {
        return 1
    }
    return n * factorial(n - 1)
}

fn fib(n: int) -> int {
    if n <= 1 {
        return n
    }
    return fib(n - 1) + fib(n - 2)
}

// GenWrap is a generic struct exercising scalar field-type substitution
// on instantiated receivers (comp_error.md #142).
struct GenWrap<T> {
    v: T
}

// GenSliceBox exercises a []T field — only legal with pointer-sized
// instantiations under the erased-composite guard (comp_error.md #142).
struct GenSliceBox<T> {
    elems: []T
}

// GenInner/GenOuter exercise substitution through nested generic fields.
struct GenInner<T> {
    val: T
}

struct GenOuter<T> {
    inner: GenInner<T>
}

// genMapRoundTrip builds a builtin map[K]V inside generic code, stores
// k:v and reads it back — exercises erased-key hashing and comparison
// (comp_error.md #141).
fn genMapRoundTrip<K, V>(k: K, v: V) -> V {
    m := make(map[K]V)
    m[k] = v
    return m[k]
}

// genMapLookup stores want:v then reads back a second (equal-by-content)
// key — verifies erased string keys compare by content, not identity.
fn genMapLookup<K, V>(want: K, probe: K, v: V) -> V {
    m := make(map[K]V)
    m[want] = v
    return m[probe]
}

// genMapProbe stores at key `have` then two-value probes `want`, reporting
// whether the lookup found it — exercises the emitMapIndexOk path on
// erased keys (comp_error.md #141).
fn genMapProbe<K, V>(have: K, want: K) -> bool {
    m := make(map[K]V)
    var zero V
    m[have] = zero
    _, ok := m[want]
    return ok
}

// genMapSize returns len() of a generic map after two distinct puts.
fn genMapSize<K, V>(a: K, b: K) -> int {
    m := make(map[K]V)
    var zero V
    m[a] = zero
    m[b] = zero
    return len(m)
}

// genMapAfterDelete inserts and deletes a key inside generic code.
fn genMapAfterDelete<K, V>(k: K) -> int {
    m := make(map[K]V)
    var zero V
    m[k] = zero
    delete(m, k)
    return len(m)
}

// genMapKeyCount iterates a generic map's keys (comp_error.md #141).
fn genMapKeyCount<K, V>(a: K, b: K) -> int {
    m := make(map[K]V)
    var zero V
    m[a] = zero
    m[b] = zero
    n := 0
    for _ := range m {
        n = n + 1
    }
    return n
}

// genEq/genNe compare erased generic values (comp_error.md #141).
fn genEq<T>(a: T, b: T) -> bool {
    return a == b
}

fn genNe<T>(a: T, b: T) -> bool {
    return a != b
}

fn setArrVal(arr: []int, val: int) {
    arr[0] = val
}

fn return42() -> int {
    return 42
}

extern fn strlen(s: string) -> int
