module csv_file_test

import "testing"
import "std/csv"
import "std/fs"
import "std/str"

// TestFileRoundTrip verifies CSV file write then read returns same data.
pub fn TestFileRoundTrip() {
    path := "/tmp/skink_csv_test.csv"
    w, _ := csv.NewFileWriter(path)
    r := csv.NewRecord([]string{"name", "age"})
    w.Write(r)
    w.Write(csv.NewRecord([]string{"alice", "30"}))
    w.Flush()

    rd, rerr := csv.NewFileReader(path)
    testing.AssertTrue(rerr.message == "", "open reader")
    rec1, _ := rd.Read()
    testing.AssertEqualInt(2, rec1.Len(), "header fields")
    cols := rec1.Fields()
    testing.AssertEqualString("name", cols[0], "first field")
    rec2, _ := rd.Read()
    testing.AssertEqualString("alice", rec2.Fields()[0], "row 2 name")
    fs.Remove(path)
}
