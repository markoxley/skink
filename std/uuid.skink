// Project: Skink — A self-hosted, statically-typed programming language
//          targeting LLVM IR, designed for systems programming with
//          modern ergonomics and a Go-inspired syntax.
//
// File:    std/uuid.skink
// Purpose: Universally Unique Identifier (UUID) and Globally Unique
//          Identifier (GUID) generation, parsing, formatting, and
//          inspection per RFC 9562 (which obsoletes RFC 4122).
//
//          Supports all eight UUID versions:
//            v1  - date-time + MAC/node based
//            v2  - DCE Security (local domain + local identifier)
//            v3  - name-based, MD5
//            v4  - cryptographically random (OpenSSL RAND_bytes)
//            v5  - name-based, SHA-1
//            v6  - reordered Gregorian time (sortable v1)
//            v7  - Unix epoch milliseconds + random (sortable)
//            v8  - custom 122-bit payload
//          plus the Nil and Max sentinel values.
//
//          A GUID is the same 128-bit value as a UUID; the textual
//          representations are identical. The only difference is the
//          binary layout used by the Windows GUID/CLSID/IID struct,
//          which stores the first three fields little-endian — handled
//          by Bytes (RFC byte order) vs GUIDBytes (Windows struct order).
//
//          Textual forms accepted by Parse:
//            6ba7b810-9dad-11d1-80b4-00c04fd430c8   canonical
//            6BA7B810-9DAD-11D1-80B4-00C04FD430C8   uppercase
//            6ba7b8109dad11d180b400c04fd430c8       bare hex
//            {6ba7b810-9dad-11d1-80b4-00c04fd430c8} Microsoft braces
//            urn:uuid:6ba7b810-9dad-11d1-80b4-00c04fd430c8
//
// Example usage:
//
//   import "uuid"
//
//   id := uuid.New()                        // random v4
//   println(id.String())
//   k := uuid.NewV7()                       // time-sortable
//   n := uuid.NewV5(uuid.NamespaceURL(), "https://example.com/x")
//   u, err := uuid.Parse("{6ba7b810-9dad-11d1-80b4-00c04fd430c8}")
//
// Author:  Mark Oxley
// Created: 2026
//
