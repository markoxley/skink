module api_test

import "std/api"
import "testing"

// TestClientCreation verifies Client struct compiles.
pub fn TestClientCreation() {
    c := api.Client{timeoutMs: 1000}
    if c.timeoutMs != 1000 {
        Errorf("Client should store timeoutMs")
    }
}

// TestResponseCreation verifies Response struct compiles.
pub fn TestResponseCreation() {
    r := api.Response{status: 200, body: "ok"}
    if r.Status() != 200 {
        Errorf("Response should return stored status")
    }
    if r.Body() != "ok" {
        Errorf("Response should return stored body")
    }
}

// TestResponseEmptyBody verifies Response with empty body.
pub fn TestResponseEmptyBody() {
    r := api.Response{status: 404, body: ""}
    if r.Status() != 404 {
        Errorf("Response should return stored status for empty body")
    }
    if r.Body() != "" {
        Errorf("Response body should be empty")
    }
}

// TestClientPostSmoke verifies Client.Post compiles and returns.
pub fn TestClientPostSmoke() {
    c := api.Client{timeoutMs: 1000}
    resp, err := c.Post("http://127.0.0.1/", "text/plain", "hello")
    if err.message == "" && resp.status == 0 {
        Errorf("Post to localhost should not return zero status on success")
    }
}

// TestSimpleGetSmoke verifies SimpleGet compiles and returns.
pub fn TestSimpleGetSmoke() {
    resp, err := api.SimpleGet("http://127.0.0.1/")
    if err.message == "" && resp.status == 0 {
        Errorf("SimpleGet should not return zero status on success")
    }
}

// TestSimplePostSmoke verifies SimplePost compiles and returns.
pub fn TestSimplePostSmoke() {
    resp, err := api.SimplePost("http://127.0.0.1/", "data=1")
    if err.message == "" && resp.status == 0 {
        Errorf("SimplePost should not return zero status on success")
    }
}

// TestParseURLHTTP checks that HTTP URLs are parsed correctly.
pub fn TestParseURLHTTP() {
    host, path, port, useTLS := api.ParseURL("http://example.com/api/data")
    if host != "example.com" {
        Errorf("host should be example.com, got " + host)
    }
    if path != "/api/data" {
        Errorf("path should be /api/data, got " + path)
    }
    if port != 80 {
        Errorf("port should be 80 for HTTP")
    }
    if useTLS {
        Errorf("useTLS should be false for HTTP")
    }
}

// TestParseURLHTTPS checks that HTTPS URLs are parsed correctly.
pub fn TestParseURLHTTPS() {
    host, path, port, useTLS := api.ParseURL("https://example.com/secure")
    if host != "example.com" {
        Errorf("host should be example.com, got " + host)
    }
    if path != "/secure" {
        Errorf("path should be /secure, got " + path)
    }
    if port != 443 {
        Errorf("port should be 443 for HTTPS")
    }
    if !useTLS {
        Errorf("useTLS should be true for HTTPS")
    }
}

// TestParseURLCustomPort checks that explicit ports are parsed.
pub fn TestParseURLCustomPort() {
    host, path, port, useTLS := api.ParseURL("http://localhost:8080/test")
    if host != "localhost" {
        Errorf("host should be localhost, got " + host)
    }
    if path != "/test" {
        Errorf("path should be /test, got " + path)
    }
    if port != 8080 {
        Errorf("port should be 8080")
    }
    if useTLS {
        Errorf("useTLS should be false for HTTP")
    }
}

// TestParseURLHTTPSCustomPort checks HTTPS with explicit port.
pub fn TestParseURLHTTPSCustomPort() {
    host, _, port, useTLS := api.ParseURL("https://secure.example.com:8443/path")
    if host != "secure.example.com" {
        Errorf("host should be secure.example.com, got " + host)
    }
    if port != 8443 {
        Errorf("port should be 8443")
    }
    if !useTLS {
        Errorf("useTLS should be true for HTTPS")
    }
}

// TestParseURLRootPath checks that URLs without a path default to /.
pub fn TestParseURLRootPath() {
    _, path, _, _ := api.ParseURL("http://example.com")
    if path != "/" {
        Errorf("path should default to /, got " + path)
    }
}

// TestClientTimeoutUsed verifies that the timeoutMs field is stored and
// accessible (the actual socket timeout is set internally).
pub fn TestClientTimeoutUsed() {
    c := api.Client{timeoutMs: 5000}
    if c.timeoutMs != 5000 {
        Errorf("timeoutMs should be 5000")
    }
}
