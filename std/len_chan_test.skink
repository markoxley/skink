module len_chan_test

import "testing"

// TestLenChan verifies len() on buffered channel reports queue depth.
pub fn TestLenChan() {
    ch := make(chan<int>, 4)
    testing.AssertEqualInt(0, len(ch), "empty channel len 0")
    ch <- 1
    ch <- 2
    testing.AssertEqualInt(2, len(ch), "two buffered elements")
    _ = <-ch
    testing.AssertEqualInt(1, len(ch), "one after recv")
}

// chanHolder exercises len() on a channel stored in a struct field.
pub struct chanHolder {
    ch: chan<int>
}

// TestLenChanField verifies len() routes through Skink_chan_len when the
// channel is reached via a field expression (regression: field receivers
// previously read a slice header and returned garbage — issue #94).
pub fn TestLenChanField() {
    h := chanHolder{ch: make(chan<int>, 4)}
    testing.AssertEqualInt(0, len(h.ch), "empty field channel")
    h.ch <- 7
    h.ch <- 8
    testing.AssertEqualInt(2, len(h.ch), "two buffered via field")
    _ = <-h.ch
    testing.AssertEqualInt(1, len(h.ch), "one after recv via field")
}
