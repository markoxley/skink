module yaml

import "std/str"
import "std/errors"
import "std/reflect"
import "std/base64"

// Value is a dynamic YAML value that can represent scalar, sequence,
// or mapping types. Use the kind field to determine the active type.
pub struct Value {
    kind: int  // the kind
    strVal: string  // the string value
    numVal: float  // the number of value
    boolVal: bool  // the bool value
    arr: []Value  // the arr
    objKeys: []string  // the obj keys
    objVals: []Value  // the obj vals
}

// zeroValue returns a YAML Value initialized to the null kind.
fn zeroValue() -> Value {
    var emptyStr string
    var emptyArr []Value
    var emptyKeys []string
    var emptyVals []Value
    return Value{kind: 0, strVal: emptyStr, numVal: 0.0, boolVal: false, arr: emptyArr, objKeys: emptyKeys, objVals: emptyVals}
}

// Null creates a YAML Value representing a null/empty scalar.
pub fn Null() -> Value {
    return zeroValue()
}

// FromBool creates a YAML Value representing a boolean scalar.
pub fn FromBool(b: bool) -> Value {
    v := zeroValue()
    v.kind = 1
    v.boolVal = b
    return v
}

// FromNumber creates a YAML Value representing a numeric scalar.
pub fn FromNumber(n: float) -> Value {
    v := zeroValue()
    v.kind = 2
    v.numVal = n
    return v
}

// FromString creates a YAML Value representing a string scalar.
pub fn FromString(s: string) -> Value {
    v := zeroValue()
    v.kind = 3
    v.strVal = s
    return v
}

// FromArray creates a YAML Value representing a sequence of Values.
pub fn FromArray(arr: []Value) -> Value {
    v := zeroValue()
    v.kind = 4
    v.arr = arr
    return v
}

// FromObject creates a YAML Value representing a mapping with the given
// parallel key and value slices.
pub fn FromObject(keys: []string, vals: []Value) -> Value {
    v := zeroValue()
    v.kind = 5
    v.objKeys = keys
    v.objVals = vals
    return v
}

// IsNull returns true if the Value represents a YAML null.
pub fn IsNull(v: Value) -> bool {
    return v.kind == 0
}

// AsBool extracts the boolean value from a Value of kind 1.
pub fn AsBool(v: Value) -> bool {
    return v.boolVal
}

// AsNumber extracts the floating-point value from a Value of kind 2.
pub fn AsNumber(v: Value) -> float {
    return v.numVal
}

// AsString extracts the string value from a Value of kind 3.
pub fn AsString(v: Value) -> string {
    return v.strVal
}

// ArrayLen returns the number of elements in a YAML sequence Value.
pub fn ArrayLen(v: Value) -> int {
    return len(v.arr)
}

// ArrayGet returns the element at index i in a YAML sequence Value.
pub fn ArrayGet(v: Value, i: int) -> Value {
    return v.arr[i]
}

// ObjectLen returns the number of key-value pairs in a YAML mapping Value.
pub fn ObjectLen(v: Value) -> int {
    return len(v.objKeys)
}

// ObjectGet looks up a key in a YAML mapping Value, returning Null if not found.
pub fn ObjectGet(v: Value, key: string) -> Value {
    for i := 0; i < len(v.objKeys); i = i + 1 {
        if v.objKeys[i] == key {
            return v.objVals[i]
        }
    }
    // Key not found; return null sentinel
    return Null()
}

// ObjectGetByIndex returns the key and value at index i in a YAML mapping Value.
pub fn ObjectGetByIndex(v: Value, i: int) -> (string, Value) {
    return v.objKeys[i], v.objVals[i]
}

// --- Marshal ---

// MarshalValue serializes a Value into a YAML string with indentation.
pub fn MarshalValue(v: Value) -> string {
    return marshalValueInternal(v, 0)
}

// marshalValueInternal dispatches serialization by Value kind at the given indent.
fn marshalValueInternal(v: Value, indent: int) -> string {
    if v.kind == 0 {
        return "null"
    }
    if v.kind == 1 {
        if v.boolVal {
            return "true"
        }
        return "false"
    }
    if v.kind == 2 {
        return floatToString(v.numVal)
    }
    if v.kind == 3 {
        return v.strVal
    }
    if v.kind == 4 {
        return marshalArray(v.arr, indent)
    }
    if v.kind == 5 {
        return marshalObject(v.objKeys, v.objVals, indent)
    }
    return ""
}

// marshalArray serializes a sequence with "- " item prefixes at the given indent.
fn marshalArray(arr: []Value, indent: int) -> string {
    res := ""
    prefix := indentString(indent)
    n := len(arr)
    for i := 0; i < n; i = i + 1 {
        res = str.Concat(res, prefix)
        item := arr[i]
        if item.kind == 5 || item.kind == 4 {
            // Nested collection in a sequence: the parser cannot read
            // the inline "- key: v" mapping form, so break after the
            // dash and indent the child block instead.
            res = str.Concat(res, "-\n")
            res = str.Concat(res, marshalValueInternal(item, indent + 2))
        } else {
            res = str.Concat(res, "- ")
            res = str.Concat(res, marshalValueInternal(item, indent + 2))
        }
        res = str.Concat(res, "\n")
    }
    return res
}

// marshalObject serializes a mapping with "key: value" pairs at the given
// indent. Nested collections are placed on the following lines with deeper
// indentation.
fn marshalObject(keys: []string, vals: []Value, indent: int) -> string {
    res := ""
    prefix := indentString(indent)
    n := len(keys)
    for i := 0; i < n; i = i + 1 {
        res = str.Concat(res, prefix)
        res = str.Concat(res, keys[i])
        val := vals[i]
        if val.kind == 5 || val.kind == 4 {
            // Nested collection: "key:" alone (no trailing space — the
            // parser reads "- " sequence items as mappings otherwise),
            // newline, then the indented child block.
            res = str.Concat(res, ":")
            res = str.Concat(res, "\n")
            item := marshalValueInternal(val, indent + 2)
            res = str.Concat(res, item)
        } else {
            // Inline scalar value
            res = str.Concat(res, ": ")
            item := marshalValueInternal(val, 0)
            res = str.Concat(res, item)
        }
        res = str.Concat(res, "\n")
    }
    return res
}

// indentString returns a string of n space characters for YAML indentation.
fn indentString(n: int) -> string {
    res := ""
    for i := 0; i < n; i = i + 1 {
        res = str.Concat(res, " ")
    }
    return res
}

// floatToString converts a float to its YAML string representation.
fn floatToString(n: float) -> string {
    if n == 0.0 {
        return "0"
    }
    neg := false
    if n < 0.0 {
        neg = true
        n = -n
    }
    intPart := int(n)
    res := intToString(intPart)
    if neg {
        res = str.Concat("-", res)
    }
    return res
}

// intToString converts a non-negative integer to its decimal string form.
fn intToString(n: int) -> string {
    if n == 0 {
        return "0"
    }
    neg := false
    if n < 0 {
        neg = true
        n = -n
    }
    res := ""
    // Extract digits from least to most significant
    for n > 0 {
        d := n % 10
        res = str.Concat(charForDigit(d), res)
        n = n / 10
    }
    if neg {
        res = str.Concat("-", res)
    }
    return res
}

// charForDigit returns the single-character string for digit 0-9.
fn charForDigit(d: int) -> string {
    if d == 0 { return "0" }
    if d == 1 { return "1" }
    if d == 2 { return "2" }
    if d == 3 { return "3" }
    if d == 4 { return "4" }
    if d == 5 { return "5" }
    if d == 6 { return "6" }
    if d == 7 { return "7" }
    if d == 8 { return "8" }
    return "9"
}

// --- Unmarshal ---

// Unmarshal parses a YAML string into a Value. It supports scalars,
// sequences (lines starting with "-"), and mappings ("key: value").
// Returns an error if the input exceeds 100,000 lines (DoS protection).
pub fn Unmarshal(s: string) -> (Value, errors.Error) {
    lines := str.Split(s, "\n")
    n := len(lines)
    if n == 0 {
        return Null(), errors.New("")
    }
    // DoS protection: reject excessively many lines
    if n > 100000 {
        return Null(), errors.New("YAML input too large: exceeds 100000 lines")
    }
    // Check if first line looks like an array (starts with -)
    first := trimLeft(lines[0])
    if str.Len(first) > 0 && first[0] == 45 {
        return parseArrayLines(lines, 0, n, 0), errors.New("")
    }
    // If single line without a colon, treat as scalar
    if n == 1 {
        if str.Len(first) > 0 {
            // Check for a colon to distinguish scalar from mapping
            hasColon := false
            for j := 0; j < str.Len(first); j = j + 1 {
                if first[j] == 58 {
                    hasColon = true
                    break
                }
            }
            if !hasColon {
                return parseScalar(first), errors.New("")
            }
        } else {
            return Null(), errors.New("")
        }
    }
    return parseObjectLines(lines, 0, n, 0), errors.New("")
}

// trimLeft removes leading spaces and tabs from s.
fn trimLeft(s: string) -> string {
    i := 0
    for i < str.Len(s) && (s[i] == 32 || s[i] == 9) {
        i = i + 1
    }
    return str.Substr(s, i, str.Len(s) - i)
}

// countIndent returns the number of leading spaces and tabs in s.
fn countIndent(s: string) -> int {
    i := 0
    for i < str.Len(s) && (s[i] == 32 || s[i] == 9) {
        i = i + 1
    }
    return i
}

// parseScalar interprets a trimmed string as null, bool, number, or string.
fn parseScalar(s: string) -> Value {
    trimmed := trimLeft(s)
    // Null variants: "null", empty, or "~"
    if str.Equal(trimmed, "null") || str.Equal(trimmed, "") || str.Equal(trimmed, "~") {
        return Null()
    }
    // Boolean true variants (case-insensitive)
    if str.Equal(trimmed, "true") || str.Equal(trimmed, "True") || str.Equal(trimmed, "TRUE") {
        return FromBool(true)
    }
    // Boolean false variants (case-insensitive)
    if str.Equal(trimmed, "false") || str.Equal(trimmed, "False") || str.Equal(trimmed, "FALSE") {
        return FromBool(false)
    }
    // Try parse number
    n := parseInt(trimmed)
    if n != 0 || (str.Len(trimmed) > 0 && trimmed[0] == 48) {
        return FromNumber(float(n))
    }
    // Fall back to string
    return FromString(trimmed)
}

// parseInt parses a string of decimal digits (optionally prefixed with '-')
// into an int. Returns 0 if the string is not a valid integer.
fn parseInt(s: string) -> int {
    n := 0
    neg := false
    i := 0
    if i < str.Len(s) && s[i] == 45 {
        neg = true
        i = i + 1
    }
    for i < str.Len(s) {
        c := s[i]
        if c >= 48 && c <= 57 {
            n = n * 10 + int(c - 48)
            i = i + 1
        } else {
            // Non-digit encountered; not a valid integer
            return 0
        }
    }
    if neg {
        n = -n
    }
    return n
}

// parseArrayLines parses a YAML sequence from lines[start:end] at the given
// base indentation level. Items are lines whose trimmed content starts with "-".
fn parseArrayLines(lines: []string, start: int, end: int, baseIndent: int) -> Value {
    // DoS protection: limit nesting depth via indentation
    if baseIndent > 2000 {
        return FromArray([]Value{})
    }
    var arr []Value
    i := start
    for i < end {
        line := lines[i]
        indent := countIndent(line)
        // Stop when indentation decreases below the base level
        if indent < baseIndent && str.Len(trimLeft(line)) > 0 {
            break
        }
        // Skip blank lines
        if str.Len(trimLeft(line)) == 0 {
            i = i + 1
            continue
        }
        trimmed := trimLeft(line)
        if str.Len(trimmed) > 0 && trimmed[0] == 45 {
            // Array item: strip the "- " prefix
            itemStr := str.Substr(trimmed, 1, str.Len(trimmed) - 1)
            itemStr = trimLeft(itemStr)
            // Scan ahead for nested content belonging to this item —
            // only NON-BLANK deeper-indented lines count (blank lines
            // are skippable trivia, not nested content).
            j := i + 1
            hasNested := false
            for j < end {
                nextLine := lines[j]
                nextIndent := countIndent(nextLine)
                nextTrimmed := trimLeft(nextLine)
                if str.Len(nextTrimmed) == 0 {
                    j = j + 1
                    continue
                }
                // Deeper indentation means nested content
                if nextIndent <= baseIndent {
                    break
                }
                hasNested = true
                j = j + 1
            }
            if hasNested {
                // Multi-line value: parse as nested object
                val := parseObjectLines(lines, i + 1, j, baseIndent + 2)
                arr = append(arr, val)
            } else {
                // Single-line scalar item
                arr = append(arr, parseScalar(itemStr))
            }
            i = j
        } else {
            i = i + 1
        }
    }
    return FromArray(arr)
}

// parseObjectLines parses a YAML mapping from lines[start:end] at the given
// base indentation level. Keys are separated from values by ":".
fn parseObjectLines(lines: []string, start: int, end: int, baseIndent: int) -> Value {
    // DoS protection: limit nesting depth via indentation
    if baseIndent > 2000 {
        return FromObject([]string{}, []Value{})
    }
    var keys []string
    var vals []Value
    i := start
    for i < end {
        line := lines[i]
        indent := countIndent(line)
        trimmed := trimLeft(line)
        // Skip blank lines
        if str.Len(trimmed) == 0 {
            i = i + 1
            continue
        }
        // Stop when indentation decreases below the base level
        if indent < baseIndent {
            break
        }
        // Find the colon separating key from value
        colonIdx := -1
        for j := 0; j < str.Len(trimmed); j = j + 1 {
            if trimmed[j] == 58 {
                colonIdx = j
                break
            }
        }
        if colonIdx >= 0 {
            key := trimLeft(str.Substr(trimmed, 0, colonIdx))
            valStr := trimLeft(str.Substr(trimmed, colonIdx + 1, str.Len(trimmed) - colonIdx - 1))
            // Scan ahead for nested content belonging to this key —
            // blank lines are trivia, not nested content.
            j := i + 1
            hasNested := false
            for j < end {
                nextLine := lines[j]
                nextIndent := countIndent(nextLine)
                nextTrimmed := trimLeft(nextLine)
                if str.Len(nextTrimmed) == 0 {
                    j = j + 1
                    continue
                }
                if nextIndent <= baseIndent {
                    break
                }
                hasNested = true
                j = j + 1
            }
            if hasNested || (str.Len(valStr) == 0 && j > i) {
                // Nested value: determine if it's an array or object
                nextLine := ""
                if i + 1 < end {
                    nextLine = trimLeft(lines[i + 1])
                }
                if str.Len(nextLine) > 0 && nextLine[0] == 45 {
                    // Nested sequence
                    val := parseArrayLines(lines, i + 1, j, baseIndent + 2)
                    vals = append(vals, val)
                } else {
                    // Nested mapping
                    val := parseObjectLines(lines, i + 1, j, baseIndent + 2)
                    // If nested parse produced nothing, fall back to scalar
                    if ObjectLen(val) == 0 && ArrayLen(val) == 0 {
                        val = parseScalar(valStr)
                    }
                    vals = append(vals, val)
                }
                i = j
            } else {
                // Inline scalar value
                vals = append(vals, parseScalar(valStr))
                i = i + 1
            }
            keys = append(keys, key)
        } else {
            // No colon found; skip this line
            i = i + 1
        }
    }
    return FromObject(keys, vals)
}

// --- Legacy entry-based API ---

// Entry is a simple key-value pair used by the legacy entry-based YAML API.
pub struct Entry {
    key: string  // the key
    value: string  // the value

    // Key returns the entry's key string.
    pub fn Key(self: Entry) -> string {
        return self.key
    }

    // Value returns the entry's value string.
    pub fn Value(self: Entry) -> string {
        return self.value
    }
}

// MarshalEntries serializes parallel key and value slices into a YAML
// mapping string. Only the first n pairs are included.
pub fn MarshalEntries(keys: []string, values: []string, n: int) -> string {
    res := ""
    for i := 0; i < n; i = i + 1 {
        line := str.Concat(keys[i], ": ")
        line = str.Concat(line, values[i])
        line = str.Concat(line, "\n")
        res = str.Concat(res, line)
    }
    return res
}

// UnmarshalEntries parses a YAML mapping string into a slice of Entry pairs.
// Only string values are supported; non-string values yield empty strings.
pub fn UnmarshalEntries(s: string) -> ([]Entry, errors.Error) {
    v, err := Unmarshal(s)
    if err.message != "" {
        var empty []Entry
        return empty, err
    }
    var entries []Entry
    n := ObjectLen(v)
    for i := 0; i < n; i = i + 1 {
        k, val := ObjectGetByIndex(v, i)
        e := Entry{key: k, value: AsString(val)}
        entries = append(entries, e)
    }
    return entries, errors.New("")
}

// --- Struct marshal/unmarshal via reflect + [yaml] field tags ---
// Mirrors std/json's reflected struct support: the caller supplies a
// reflect.Type plus the struct address (int64(&obj)) and the same
// field-type matrix is supported — every integer width, float/double,
// bool, string, byte buffers (base64, like encoding/json), pointers
// (*T → null or dereferenced), slices (including []struct), and
// nested structs via the embedded reflect.Type metadata.

// yamlIntSize maps integer type names to their byte size, or 0 when
// typeName is not an integer type.
fn yamlIntSize(typeName: string) -> int {
    if str.Equal(typeName, "int") || str.Equal(typeName, "uint") || str.Equal(typeName, "int32") || str.Equal(typeName, "uint32") {
        return 4
    }
    if str.Equal(typeName, "int8") || str.Equal(typeName, "uint8") || str.Equal(typeName, "char") {
        return 1
    }
    if str.Equal(typeName, "int16") || str.Equal(typeName, "uint16") {
        return 2
    }
    if str.Equal(typeName, "int64") || str.Equal(typeName, "uint64") {
        return 8
    }
    return 0
}

// yamlBytesType reports whether typeName is a byte-buffer field type
// ([]int8/[]uint8/bytes), marshalled as base64 strings.
fn yamlBytesType(typeName: string) -> bool {
    return str.Equal(typeName, "[]int8") || str.Equal(typeName, "[]uint8") || str.Equal(typeName, "bytes")
}

// yamlFieldName resolves a field's YAML key: [yaml(name=x)] wins,
// otherwise the field name itself.
fn yamlFieldName(f: reflect.Field) -> string {
    if name, ok := reflect.TagKey(f.tag, "yaml", "name"); ok {
        return name
    }
    return f.name
}

// yamlUnsupportedFieldErr builds the field-type error shared by
// Marshal and UnmarshalInto.
fn yamlUnsupportedFieldErr(f: reflect.Field) -> errors.Error {
    return errors.New(str.Concat(str.Concat("yaml: unsupported field type \"", f.type_name), str.Concat("\" on field \"", str.Concat(f.name, "\" — supported: integers, float, bool, string, byte buffers, pointers, slices, nested structs"))))
}

// yamlIsEmptyValue reports whether the field on the struct at ptr holds
// its zero value — used by the [yaml(omitempty)] flag.
fn yamlIsEmptyValue(ptr: int64, f: reflect.Field) -> bool {
    addr := reflect.FieldAddr(ptr, f)
    if str.StartsWith(f.type_name, "*") {
        return reflect.ReadPtr(addr) == 0
    }
    if yamlBytesType(f.type_name) {
        return str.Len(reflect.ReadString(addr)) == 0
    }
    if str.StartsWith(f.type_name, "[]") {
        hdr := reflect.ReadPtr(addr)
        return hdr == 0 || reflect.ReadInt64(hdr + 8) == int64(0)
    }
    isz := yamlIntSize(f.type_name)
    if isz == 4 {
        return reflect.ReadInt(addr) == 0
    }
    if isz == 8 {
        return reflect.ReadInt64(addr) == int64(0)
    }
    if isz > 0 {
        return reflect.ReadInt16(addr) == 0 && reflect.ReadInt8(addr) == 0
    }
    if str.Equal(f.type_name, "string") {
        return str.Len(reflect.ReadString(addr)) == 0
    }
    if str.Equal(f.type_name, "float") || str.Equal(f.type_name, "double") {
        return reflect.ReadFloat(addr) == 0.0
    }
    if str.Equal(f.type_name, "bool") {
        return reflect.ReadBool(addr) == false
    }
    return false
}

// yamlElemField derives the element Field descriptor for pointer and
// slice fields — see json.skink's elemField for the mechanism.
fn yamlElemField(f: reflect.Field) -> reflect.Field {
    return reflect.Field{name: f.name, type_name: reflect.ElemType(f), offset: 0, tag: f.tag, typ: f.typ}
}

// yamlValSize returns the in-memory size of a value described by f —
// used for slice element strides and pointer-element allocation.
fn yamlValSize(f: reflect.Field) -> int {
    tn := f.type_name
    isz := yamlIntSize(tn)
    if isz > 0 {
        return isz
    }
    if str.Equal(tn, "float") || str.Equal(tn, "double") || str.Equal(tn, "string") {
        return 8
    }
    if str.Equal(tn, "bool") {
        return 1
    }
    if str.StartsWith(tn, "*") {
        return 8
    }
    if str.StartsWith(tn, "[]") {
        return 32
    }
    if str.Len(f.typ.name) > 0 {
        return f.typ.size
    }
    return 8
}

// yamlMarshalVal serializes the reflected value stored at addr into a
// YAML Value — the yaml counterpart of json.skink's marshalVal.
fn yamlMarshalVal(addr: int64, f: reflect.Field) -> (Value, errors.Error) {
    tn := f.type_name
    if str.StartsWith(tn, "*") {
        p := reflect.ReadPtr(addr)
        if p == 0 {
            return Null(), errors.None()
        }
        return yamlMarshalVal(p, yamlElemField(f))
    }
    if yamlBytesType(tn) {
        s := reflect.ReadString(addr)
        if s == nil {
            return FromString(""), errors.None()
        }
        return FromString(base64.Encode(s, str.Len(s))), errors.None()
    }
    if str.StartsWith(tn, "[]") {
        var vals []Value
        hdr := reflect.ReadPtr(addr)
        if hdr == 0 {
            return FromArray(vals), errors.None()
        }
        data := reflect.ReadInt64(hdr)
        n := int(reflect.ReadInt64(hdr + 8))
        ef := yamlElemField(f)
        esz := yamlValSize(ef)
        i := 0
        for i < n {
            ev, err := yamlMarshalVal(data + int64(i * esz), ef)
            if err.message != "" {
                return Null(), err
            }
            vals = append(vals, ev)
            i = i + 1
        }
        return FromArray(vals), errors.None()
    }
    nt, isStruct := reflect.NestedType(f)
    if isStruct {
        return yamlMarshalStructValue(nt, addr)
    }
    isz := yamlIntSize(tn)
    if isz == 4 {
        return FromNumber(float(reflect.ReadInt(addr))), errors.None()
    }
    if isz == 8 {
        return FromNumber(float(reflect.ReadInt64(addr))), errors.None()
    }
    if isz == 2 {
        return FromNumber(float(reflect.ReadInt16(addr))), errors.None()
    }
    if isz == 1 {
        return FromNumber(float(reflect.ReadInt8(addr))), errors.None()
    }
    if str.Equal(tn, "string") {
        return FromString(reflect.ReadString(addr)), errors.None()
    }
    if str.Equal(tn, "float") || str.Equal(tn, "double") {
        return FromNumber(reflect.ReadFloat(addr)), errors.None()
    }
    if str.Equal(tn, "bool") {
        return FromBool(reflect.ReadBool(addr)), errors.None()
    }
    return Null(), yamlUnsupportedFieldErr(f)
}

// yamlMarshalStructValue serializes the struct at addr into a YAML
// mapping Value — the recursion target shared by Marshal and nested
// fields.
fn yamlMarshalStructValue(t: reflect.Type, addr: int64) -> (Value, errors.Error) {
    var keys []string
    var vals []Value
    n := reflect.FieldCount(t)
    for i := 0; i < n; i = i + 1 {
        f := reflect.FieldByIndex(t, i)
        if reflect.TagHasFlag(f.tag, "yaml", "ignore") {
            continue
        }
        if reflect.TagHasFlag(f.tag, "yaml", "omitempty") && yamlIsEmptyValue(addr, f) {
            continue
        }
        v, err := yamlMarshalVal(reflect.FieldAddr(addr, f), f)
        if err.message != "" {
            return Null(), err
        }
        keys = append(keys, yamlFieldName(f))
        vals = append(vals, v)
    }
    return FromObject(keys, vals), errors.None()
}

// Marshal serializes the struct at ptr (pass int64(&obj)) to a YAML
// document string, reading fields through the reflected type t:
//
//   s, err := yaml.Marshal(reflect.TypeOf<Config>(c), int64(&c))
//
// Supports the same field matrix as json.Marshal (integers, floats,
// bool, string, base64 byte buffers, pointers, slices, nested
// structs). Field tags: [yaml(name=x)] renames the key, [yaml(ignore)]
// omits the field, [yaml(omitempty)] omits zero values.
pub fn Marshal(t: reflect.Type, ptr: int64) -> (string, errors.Error) {
    v, err := yamlMarshalStructValue(t, ptr)
    if err.message != "" {
        return "", err
    }
    return MarshalValue(v), errors.None()
}

// yamlUnmarshalVal writes one YAML value into the reflected storage at
// addr — the yaml counterpart of json.skink's unmarshalVal.
fn yamlUnmarshalVal(addr: int64, f: reflect.Field, v: Value) -> errors.Error {
    tn := f.type_name
    if str.StartsWith(tn, "*") {
        if IsNull(v) {
            reflect.WritePtr(addr, 0)
            return errors.None()
        }
        ef := yamlElemField(f)
        p := reflect.Alloc(int64(yamlValSize(ef)))
        reflect.WritePtr(addr, p)
        return yamlUnmarshalVal(p, ef, v)
    }
    if yamlBytesType(tn) {
        if v.kind != 3 {
            return errors.New(str.Concat(str.Concat("yaml: expected base64 string for field \"", f.name), "\""))
        }
        dec, derr := base64.Decode(AsString(v))
        if derr.message != "" {
            return derr
        }
        reflect.WriteString(addr, dec)
        return errors.None()
    }
    if str.StartsWith(tn, "[]") {
        if v.kind != 4 {
            return errors.New(str.Concat(str.Concat("yaml: expected sequence for field \"", f.name), "\""))
        }
        n := ArrayLen(v)
        ef := yamlElemField(f)
        esz := yamlValSize(ef)
        data := int64(0)
        if n > 0 {
            data = reflect.Alloc(int64(n * esz))
        }
        reflect.WritePtr(addr, reflect.MakeSlice(data, n))
        i := 0
        for i < n {
            err := yamlUnmarshalVal(data + int64(i * esz), ef, ArrayGet(v, i))
            if err.message != "" {
                return err
            }
            i = i + 1
        }
        return errors.None()
    }
    nt, isStruct := reflect.NestedType(f)
    if isStruct {
        return yamlUnmarshalStructValue(nt, addr, v)
    }
    isz := yamlIntSize(tn)
    if isz == 4 {
        reflect.WriteInt(addr, int(AsNumber(v)))
    } else if isz == 8 {
        reflect.WriteInt64(addr, int64(AsNumber(v)))
    } else if isz == 2 {
        reflect.WriteInt16(addr, int(AsNumber(v)))
    } else if isz == 1 {
        reflect.WriteInt8(addr, int(AsNumber(v)))
    } else if str.Equal(tn, "string") {
        reflect.WriteString(addr, AsString(v))
    } else if str.Equal(tn, "float") || str.Equal(tn, "double") {
        reflect.WriteFloat(addr, AsNumber(v))
    } else if str.Equal(tn, "bool") {
        reflect.WriteBool(addr, AsBool(v))
    } else {
        return yamlUnsupportedFieldErr(f)
    }
    return errors.None()
}

// yamlUnmarshalStructValue writes a YAML mapping Value into the struct
// at addr — the recursion target shared by UnmarshalInto and nested
// fields.
fn yamlUnmarshalStructValue(t: reflect.Type, addr: int64, v: Value) -> errors.Error {
    if v.kind != 5 {
        return errors.New("yaml: expected a mapping")
    }
    n := reflect.FieldCount(t)
    for i := 0; i < n; i = i + 1 {
        f := reflect.FieldByIndex(t, i)
        if reflect.TagHasFlag(f.tag, "yaml", "ignore") {
            continue
        }
        fv := ObjectGet(v, yamlFieldName(f))
        if IsNull(fv) {
            if str.StartsWith(f.type_name, "*") {
                err := yamlUnmarshalVal(reflect.FieldAddr(addr, f), f, fv)
                if err.message != "" {
                    return err
                }
            }
            continue
        }
        err := yamlUnmarshalVal(reflect.FieldAddr(addr, f), f, fv)
        if err.message != "" {
            return err
        }
    }
    return errors.None()
}

// UnmarshalInto parses s as a YAML document and writes each matching
// mapping key into the struct at ptr (pass int64(&obj)) using the
// reflected type t:
//
//   err := yaml.UnmarshalInto(data, reflect.TypeOf<Config>(c), int64(&c))
//
// (Named UnmarshalInto because yaml.Unmarshal is the existing Value-tree
// parser.) Absent keys leave fields unchanged; unknown keys are
// ignored; null values nil pointer fields and skip others. Honours
// [yaml(name=x)] and [yaml(ignore)].
pub fn UnmarshalInto(s: string, t: reflect.Type, ptr: int64) -> errors.Error {
    v, err := Unmarshal(s)
    if err.message != "" {
        return err
    }
    return yamlUnmarshalStructValue(t, ptr, v)
}
