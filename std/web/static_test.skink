// Tests for std/web/static. These guard the regression where FileServer's
// inner function literal captured the enclosing `rootDir` parameter —
// Skink closures cannot capture locals, so the emitted IR referenced a
// nonexistent @rootDir global and merely importing the module failed to
// compile. The handler now reads the module-level fileServerRoot instead.

module static_test

import "std/web/static"
import "std/web/types"
import "std/fs"
import "std/str"
import "testing"

// staticFixtureRoot is the temp directory populated by the tests.
const staticFixtureRoot = "/tmp/skink_static_test_root"

// makeStaticFixture writes a small fixture tree under staticFixtureRoot.
fn makeStaticFixture() {
    fs.Mkdir(staticFixtureRoot)
    fs.WriteAll(str.Concat(staticFixtureRoot, "/hello.txt"), "hello static")
    fs.WriteAll(str.Concat(staticFixtureRoot, "/index.html"), "<h1>home</h1>")
}

// removeStaticFixture deletes the fixture tree.
fn removeStaticFixture() {
    fs.Remove(str.Concat(staticFixtureRoot, "/hello.txt"))
    fs.Remove(str.Concat(staticFixtureRoot, "/index.html"))
    fs.Remove(staticFixtureRoot)
}

// get issues a GET for path against a FileServer rooted at
// staticFixtureRoot and returns the response writer.
// NOTE: `h` is declared with an explicit type because calling a local
// whose function type was inferred via := is not yet supported — the
// emitter only treats TK_FUNCTION-typed locals as indirect calls.
fn get(path: string) -> *types.ResponseWriter {
    var h types.Handler
    h = static.FileServer(staticFixtureRoot)
    headers := make(map[string]string)
    req := types.NewRequest("GET", path, "", headers, "")
    w := types.NewResponseWriter()
    h(req, w)
    return w
}

// TestFileServerServesFile verifies that an existing file under the root
// is served with status 200, its contents, and a text/plain Content-Type.
pub fn TestFileServerServesFile() {
    makeStaticFixture()
    defer removeStaticFixture()
    w := get("/hello.txt")
    if w.Status() != 200 {
        Errorf("FileServer should return 200 for an existing file")
    }
    if w.ResponseBody() != "hello static" {
        Errorf("FileServer body mismatch")
    }
}

// TestFileServerNotFound verifies that a missing file returns 404.
pub fn TestFileServerNotFound() {
    makeStaticFixture()
    defer removeStaticFixture()
    w := get("/missing.txt")
    if w.Status() != 404 {
        Errorf("FileServer should return 404 for a missing file")
    }
}

// TestFileServerIndexFallback verifies that a directory path falls back
// to index.html.
pub fn TestFileServerIndexFallback() {
    makeStaticFixture()
    defer removeStaticFixture()
    w := get("/")
    if w.Status() != 200 {
        Errorf("FileServer should serve index.html for /")
    }
    if w.ResponseBody() != "<h1>home</h1>" {
        Errorf("FileServer index.html body mismatch")
    }
}

// TestFileServerRejectsTraversal verifies that paths containing ".."
// are rejected with 403.
pub fn TestFileServerRejectsTraversal() {
    makeStaticFixture()
    defer removeStaticFixture()
    w := get("/../etc/passwd")
    if w.Status() != 403 {
        Errorf("FileServer should return 403 for traversal attempts")
    }
}

// TestFileServerRejectsDoubleSlash guards VULN-26: a "//etc/passwd"
// request path used to slip an absolute filesystem path past the
// one-slash strip when the root was "". It must now resolve inside the
// canonical root — 403 or 404, but never the file's contents.
pub fn TestFileServerRejectsDoubleSlash() {
    makeStaticFixture()
    defer removeStaticFixture()
    w := get("//etc/passwd")
    if w.Status() == 200 {
        Errorf("FileServer served //etc/passwd — absolute-path escape")
    }
    if str.Contains(w.ResponseBody(), "root:") {
        Errorf("FileServer leaked /etc/passwd contents via // path")
    }
}

// TestFileServerRejectsNestedTraversal guards VULN-26: traversal hidden
// mid-path ("/a/../..") must not escape the canonical root.
pub fn TestFileServerRejectsNestedTraversal() {
    makeStaticFixture()
    defer removeStaticFixture()
    w := get("/a/../../etc/passwd")
    if w.Status() == 200 {
        Errorf("FileServer served nested-traversal path")
    }
    if str.Contains(w.ResponseBody(), "root:") {
        Errorf("FileServer leaked /etc/passwd via nested traversal")
    }
}
