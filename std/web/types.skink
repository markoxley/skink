module types

import "std/errors"
import "std/json"
import "std/libc"
import "std/str"

extern fn Skink_mem_alloc(size: int64) -> string
extern fn Skink_mem_realloc(ptr: string, size: int64) -> string

// Request represents an incoming HTTP request with method, path, query,
// headers, and body. Header keys are stored lowercased; Header() performs
// a case-insensitive lookup. body holds the NUL-safe text view of the
// body; binary payloads may be truncated there — BodyBytes()/BodyLen()
// expose the raw bytes with an explicit length.
pub struct Request {
    method:  string  // the method
    path:    string  // the path
    query:   string  // the query
    proto:   string  // the proto
    headers: map[string]string  // the headers
    params:  map[string]string  // the params
    body:    string  // the body
    bodyBuf: string  // the body buffer
    bodyLen: int  // the body length

    // Method returns the HTTP method (GET, POST, etc.) of the request.
    pub fn Method(self: Request) -> string {
        return self.method
    }

    // Path returns the request path (without query string).
    pub fn Path(self: Request) -> string {
        return self.path
    }

    // Query returns the raw query string from the request URL.
    pub fn Query(self: Request) -> string {
        return self.query
    }

    // Proto returns the HTTP protocol version from the request line
    // (e.g. "HTTP/1.1").
    pub fn Proto(self: Request) -> string {
        return self.proto
    }

    // Header returns the value of a request header by key, or empty
    // string. HTTP field names are case-insensitive: the parser stores
    // keys lowercased, and this lookup tries the raw key first (for
    // caller-constructed maps) then the lowercased key
    // (comp_error.md #54).
    pub fn Header(self: Request, key: string) -> string {
        v := self.headers[key]
        if v == "" {
            v = self.headers[str.ToLower(key)]
        }
        return v
    }

    // Body returns the request body as a NUL-terminated string. For
    // binary payloads use BodyBytes()/BodyLen() — embedded NUL bytes
    // truncate this view (comp_error.md #51).
    pub fn Body(self: Request) -> string {
        return self.body
    }

    // BodyBytes returns a pointer to the raw request body, which may
    // contain embedded NUL bytes. Valid for BodyLen() bytes.
    pub fn BodyBytes(self: Request) -> string {
        return self.bodyBuf
    }

    // BodyLen returns the exact length of the raw request body in bytes.
    pub fn BodyLen(self: Request) -> int {
        return self.bodyLen
    }

    // URLParam returns a path parameter value by name. Parameters are
    // stored in a dedicated map populated by the router (comp_error.md
    // #59); they are also percent-decoded.
    pub fn URLParam(self: Request, key: string) -> string {
        return self.params[key]
    }

    // QueryParam returns the value of a query parameter by name.
    pub fn QueryParam(self: Request, key: string) -> string {
        return parseQueryParam(self.query, key)
    }

    // ParseJSON parses the request body as JSON.
    pub fn ParseJSON(self: Request) -> (json.Value, errors.Error) {
        return json.Unmarshal(self.body)
    }
}

// parseQueryParam extracts a single key's value from a URL-encoded query
// string. Keys and values are percent-decoded and '+' decodes to a space
// (comp_error.md #53).
fn parseQueryParam(query: string, key: string) -> string {
    if query == "" {
        return ""
    }
    // Split the query into key=value pairs separated by "&".
    pairs := str.Split(query, "&")
    for i := 0; i < len(pairs); i = i + 1 {
        pair := pairs[i]
        eq := str.IndexOf(pair, "=")
        if eq >= 0 {
            k := URLDecode(str.Substr(pair, 0, eq), true)
            if k == key {
                return URLDecode(str.Substr(pair, eq + 1, str.Len(pair) - eq - 1), true)
            }
        } else if URLDecode(pair, true) == key {
            // Key present with no value (e.g. "?flag").
            return ""
        }
    }
    return ""
}

// hexDigit converts an ASCII hex digit to its numeric value, or -1.
fn hexDigit(c: int) -> int {
    if c >= 48 && c <= 57 { return c - 48 }
    if c >= 65 && c <= 70 { return c - 55 }
    if c >= 97 && c <= 102 { return c - 87 }
    return -1
}

// URLDecode decodes percent-encoded %XX sequences in a URL component.
// When plusAsSpace is true (query strings), '+' also decodes to a space;
// in paths '+' is a literal character and must be preserved
// (comp_error.md #53). Invalid or truncated sequences pass through
// unchanged.
pub fn URLDecode(s: string, plusAsSpace: bool) -> string {
    if !str.Contains(s, "%") && !(plusAsSpace && str.Contains(s, "+")) {
        return s
    }
    n := str.Len(s)
    out := libc.malloc(n + 1)
    j := 0
    i := 0
    for i < n {
        c := s[i]
        if c == 37 && i + 2 < n { // '%'
            hi := hexDigit(s[i + 1])
            lo := hexDigit(s[i + 2])
            if hi >= 0 && lo >= 0 {
                out[j] = hi * 16 + lo
                j = j + 1
                i = i + 3
                continue
            }
        }
        if plusAsSpace && c == 43 { // '+'
            out[j] = 32
        } else {
            out[j] = c
        }
        j = j + 1
        i = i + 1
    }
    out[j] = 0
    return out
}

// ResponseWriter is used by handlers to build the HTTP response,
// including status code, headers, and body. The body has two channels:
// body holds the text set by JSON()/Text()/HTML(), and bodyBuf/bodyLen
// hold bytes appended by Write()/WriteBytes() — the wire body is body
// followed by the buffered bytes.
pub struct ResponseWriter {
    status:  int  // the status
    headers: map[string]string  // the headers
    body:    string  // the body
    bodyBuf: string  // the body buffer
    bodyLen: int  // the body length
    bodyCap: int  // the body capacity

    // WriteHeader sets the HTTP status code for the response.
    pub fn WriteHeader(self: *ResponseWriter, status: int) {
        self.status = status
    }

    // Write appends text data to the response body.
    pub fn Write(self: *ResponseWriter, data: string) {
        self.WriteBytes(data, str.Len(data))
    }

    // WriteBytes appends exactly n raw bytes to the response body. It is
    // binary-safe (embedded NULs are preserved) and amortized O(1) — the
    // buffer doubles as needed instead of re-copying the whole body on
    // every write (comp_error.md #52, #66).
    pub fn WriteBytes(self: *ResponseWriter, data: string, n: int) {
        if self.bodyLen + n > self.bodyCap {
            newCap := self.bodyCap
            if newCap < 4096 { newCap = 4096 }
            for self.bodyLen + n > newCap {
                newCap = newCap * 2
            }
            if self.bodyCap == 0 {
                self.bodyBuf = Skink_mem_alloc(int64(newCap))
            } else {
                self.bodyBuf = Skink_mem_realloc(self.bodyBuf, int64(newCap))
            }
            self.bodyCap = newCap
        }
        libc.memcpy(string(int64(self.bodyBuf) + int64(self.bodyLen)), data, n)
        self.bodyLen = self.bodyLen + n
    }

    // Header sets a response header key-value pair.
    pub fn Header(self: *ResponseWriter, key: string, value: string) {
        self.headers[key] = value
    }

    // resetBody implements the "set" semantics of the convenience methods:
    // it clears appended bytes so a following Write() starts the body
    // over.
    fn resetBody(self: *ResponseWriter, data: string) {
        self.bodyLen = 0
        self.body = data
    }

    // JSON sets the response status, Content-Type to application/json,
    // and the body to the provided JSON string.
    pub fn JSON(self: *ResponseWriter, status: int, data: string) {
        self.status = status
        self.headers["Content-Type"] = "application/json"
        self.resetBody(data)
    }

    // Text sets the response status, Content-Type to text/plain, and the
    // body to the provided string.
    pub fn Text(self: *ResponseWriter, status: int, data: string) {
        self.status = status
        self.headers["Content-Type"] = "text/plain"
        self.resetBody(data)
    }

    // JSONValue marshals a json.Value and writes it as a JSON response.
    pub fn JSONValue(self: *ResponseWriter, status: int, v: json.Value) {
        self.status = status
        self.headers["Content-Type"] = "application/json"
        self.resetBody(json.MarshalValue(v))
    }

    // HTML sets the response status, Content-Type to text/html, and the body.
    pub fn HTML(self: *ResponseWriter, status: int, data: string) {
        self.status = status
        self.headers["Content-Type"] = "text/html; charset=utf-8"
        self.resetBody(data)
    }

    // Status returns the currently set HTTP status code.
    pub fn Status(self: ResponseWriter) -> int {
        return self.status
    }

    // ResponseBody returns the accumulated response body as text —
    // buffered bytes written via Write/WriteBytes appended after the
    // set body. Binary bodies may appear truncated at a NUL byte.
    pub fn ResponseBody(self: ResponseWriter) -> string {
        if self.bodyLen == 0 {
            return self.body
        }
        tmp := libc.malloc(self.bodyLen + 1)
        libc.memcpy(tmp, self.bodyBuf, self.bodyLen)
        tmp[self.bodyLen] = 0
        out := str.Concat(self.body, tmp)
        libc.free(tmp)
        return out
    }

    // ResponseBodyBytes returns the raw buffered body pointer; valid for
    // BodyLen() bytes immediately following the text body.
    pub fn ResponseBodyBytes(self: ResponseWriter) -> string {
        return self.bodyBuf
    }

    // BodyLen returns the number of buffered body bytes (not counting
    // the text body).
    pub fn BodyLen(self: ResponseWriter) -> int {
        return self.bodyLen
    }
}

// NewRequest creates a Request from explicit fields for tests and handlers.
pub fn NewRequest(method: string, path: string, query: string, headers: map[string]string, body: string) -> Request {
    return Request{method: method, path: path, query: query, proto: "HTTP/1.1", headers: headers, params: make(map[string]string), body: body, bodyBuf: body, bodyLen: str.Len(body)}
}

// NewResponseWriter creates a fresh ResponseWriter pointer with default
// status 200 and empty headers/body.
pub fn NewResponseWriter() -> *ResponseWriter {
    return &ResponseWriter{status: 200, headers: make(map[string]string), body: "", bodyBuf: "", bodyLen: 0, bodyCap: 0}
}

// Handler is the function signature for HTTP handlers.
pub type Handler = fn(Request, *ResponseWriter)

// Middleware wraps a Handler, returning a new Handler with added behavior.
pub type Middleware = fn(Handler) -> Handler
