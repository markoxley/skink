module server_tls_live_test

import "std/fs"
import "std/libc"
import "std/net"
import "std/os"
import "std/str"
import "std/time"
import "std/web/router"
import "std/web/server"
import "std/web/types"
import "std/testing"

extern fn Skink_tls_client_connect_ex(fd: int, hostname: string, port: int, verify: int) -> int64
extern fn Skink_tls_read(ssl: int64, buf: string, len: int) -> int
extern fn Skink_tls_write_all(ssl: int64, buf: string, len: int) -> int
extern fn Skink_tls_close(ssl: int64)
extern fn Skink_tls_session_reused(ssl: int64) -> int
extern fn Skink_tls_get_alpn(ssl: int64) -> string
extern fn Skink_tls_peer_cert_cn(ssl: int64) -> string

// tlsClient bundles the socket and SSL handle for one connection.
struct tlsClient {
    conn: net.Connection
    ssl:  int64
}

// tlsDial opens a TCP connection and completes a TLS handshake with the
// given SNI hostname. Certificate verification is disabled — the test
// certs are self-signed.
fn tlsDial(port: int, sniHost: string) -> tlsClient {
    conn, err := net.Connect("127.0.0.1", port)
    if err.message != "" {
        return tlsClient{conn: conn, ssl: 0}
    }
    conn.SetTimeout(10000)
    ssl := Skink_tls_client_connect_ex(conn.fd, sniHost, port, 0)
    if ssl == 0 {
        conn.Close()
    }
    return tlsClient{conn: conn, ssl: ssl}
}

// tlsGet sends a Connection: close GET and reads the full response.
fn tlsGet(c: *tlsClient) -> string {
    req := "GET /hello HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n"
    Skink_tls_write_all(c.ssl, req, str.Len(req))
    buf := libc.malloc(8192)
    total := 0
    for total < 8000 {
        n := Skink_tls_read(c.ssl, string(int64(buf) + int64(total)), 8000 - total)
        if n <= 0 {
            break
        }
        total = total + n
    }
    buf[total] = 0
    resp := str.Substr(buf, 0, total)
    libc.free(buf)
    return resp
}

// tlsClose shuts down the TLS session (harvesting it into the client
// session cache) and closes the socket.
fn tlsClose(c: *tlsClient) {
    Skink_tls_close(c.ssl)
    c.conn.Close()
}

// tlsHello serves a fixed body over TLS.
fn tlsHello(req: types.Request, w: *types.ResponseWriter) {
    w.Text(200, "tls-hello")
}

// genCert runs openssl to create a self-signed cert/key pair for cn.
fn genCert(cn: string, certPath: string, keyPath: string) -> int {
    return os.Exec([]string{"openssl", "req", "-x509", "-newkey", "rsa:2048",
                            "-nodes", "-keyout", keyPath, "-out", certPath,
                            "-days", "1", "-subj", "/CN=" + cn})
}

// ensureCerts generates the two test certificates once.
fn ensureCerts() -> bool {
    if fs.Exists("/tmp/skink_tls_default.pem") {
        return true
    }
    rc := genCert("default.local", "/tmp/skink_tls_default.pem", "/tmp/skink_tls_default.key")
    if rc != 0 {
        return false
    }
    rc = genCert("sni.local", "/tmp/skink_tls_sni.pem", "/tmp/skink_tls_sni.key")
    return rc == 0
}

// TestLiveTLSBasic guards #67's baseline: a full HTTPS request/response
// over a real TLS socket.
pub fn TestLiveTLSBasic() {
    if !ensureCerts() {
        return
    }
    r := router.NewRouter()
    r.Get("/hello", tlsHello)
    s := server.NewServer(18130, &r)
    spawn tlsServe(&s, "/tmp/skink_tls_default.pem", "/tmp/skink_tls_default.key")

    // Retry until the listener is up.
    c := tlsClient{conn: net.Connection{fd: -1}, ssl: 0}
    i := 0
    for i < 50 {
        c = tlsDial(18130, "localhost")
        if c.ssl != 0 {
            break
        }
        time.SleepMs(100)
        i = i + 1
    }
    if c.ssl == 0 {
        testing.FailNow()
    }
    resp := tlsGet(&c)
    tlsClose(&c)
    testing.AssertContains(resp, "HTTP/1.1 200", "TLS status line")
    testing.AssertContains(resp, "tls-hello", "TLS body")
}

// TestLiveTLSALPN guards #67: the client offers http/1.1 via ALPN and
// the server selects it.
pub fn TestLiveTLSALPN() {
    if !ensureCerts() {
        return
    }
    r := router.NewRouter()
    r.Get("/hello", tlsHello)
    s := server.NewServer(18131, &r)
    spawn tlsServe(&s, "/tmp/skink_tls_default.pem", "/tmp/skink_tls_default.key")

    c := tlsClient{conn: net.Connection{fd: -1}, ssl: 0}
    i := 0
    for i < 50 {
        c = tlsDial(18131, "localhost")
        if c.ssl != 0 {
            break
        }
        time.SleepMs(100)
        i = i + 1
    }
    if c.ssl == 0 {
        testing.FailNow()
    }
    alpn := Skink_tls_get_alpn(c.ssl)
    testing.AssertEqualString("http/1.1", alpn, "negotiated ALPN protocol")
    tlsClose(&c)
}

// TestLiveTLSSNI guards #67: clients sending SNI "sni.local" receive
// the certificate registered for that hostname, while other names get
// the listener's default certificate.
pub fn TestLiveTLSSNI() {
    if !ensureCerts() {
        return
    }
    r := router.NewRouter()
    r.Get("/hello", tlsHello)
    s := server.NewServer(18132, &r)
    s.AddTLSCertificate("sni.local", "/tmp/skink_tls_sni.pem", "/tmp/skink_tls_sni.key")
    spawn tlsServe(&s, "/tmp/skink_tls_default.pem", "/tmp/skink_tls_default.key")

    c := tlsClient{conn: net.Connection{fd: -1}, ssl: 0}
    i := 0
    for i < 50 {
        c = tlsDial(18132, "sni.local")
        if c.ssl != 0 {
            break
        }
        time.SleepMs(100)
        i = i + 1
    }
    if c.ssl == 0 {
        testing.FailNow()
    }
    cn := Skink_tls_peer_cert_cn(c.ssl)
    testing.AssertEqualString("sni.local", cn, "SNI hostname selects its cert")
    tlsClose(&c)

    // An unmatched SNI name falls through to the default certificate.
    c2 := tlsDial(18132, "other.local")
    if c2.ssl == 0 {
        testing.FailNow()
    }
    cn2 := Skink_tls_peer_cert_cn(c2.ssl)
    testing.AssertEqualString("default.local", cn2, "unmatched SNI gets default cert")
    tlsClose(&c2)
}

// TestLiveTLSSessionResume guards #67: a second connection to the same
// host:port resumes the cached session instead of a full handshake.
pub fn TestLiveTLSSessionResume() {
    if !ensureCerts() {
        return
    }
    r := router.NewRouter()
    r.Get("/hello", tlsHello)
    s := server.NewServer(18133, &r)
    spawn tlsServe(&s, "/tmp/skink_tls_default.pem", "/tmp/skink_tls_default.key")

    c := tlsClient{conn: net.Connection{fd: -1}, ssl: 0}
    i := 0
    for i < 50 {
        c = tlsDial(18133, "localhost")
        if c.ssl != 0 {
            break
        }
        time.SleepMs(100)
        i = i + 1
    }
    if c.ssl == 0 {
        testing.FailNow()
    }
    // A full request/response must run so the TLS 1.3 session ticket
    // arrives before the session is harvested at close.
    resp := tlsGet(&c)
    tlsClose(&c)
    testing.AssertContains(resp, "tls-hello", "first TLS response")

    c2 := tlsDial(18133, "localhost")
    if c2.ssl == 0 {
        testing.FailNow()
    }
    reused := Skink_tls_session_reused(c2.ssl)
    tlsClose(&c2)
    testing.AssertEqualInt(1, reused, "second connection resumed the session")
}

// tlsServe is the spawned entry point for a TLS test server.
fn tlsServe(s: *server.Server, certFile: string, keyFile: string) {
    s.ListenAndServeTLS(certFile, keyFile)
}
