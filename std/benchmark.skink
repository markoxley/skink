module benchmark

import "std/time"
import "std/io"
import "std/strconv"
import "std/str"

// B holds benchmark state including the name, start/elapsed timestamps,
// and iteration count for a benchmark run.
pub struct B {
    name:    string
    start:   int64
    elapsed: int64
    n:       int

    // StartTimer records the current time as the benchmark start.
    pub fn StartTimer(self: *B) {
        self.start = time.NowUnixNano()
    }

    // StopTimer computes elapsed time since StartTimer.
    pub fn StopTimer(self: *B) {
        self.elapsed = time.NowUnixNano() - self.start
    }

    // N returns the iteration count.
    pub fn N(self: B) -> int {
        return self.n
    }

    // SetN sets the iteration count.
    pub fn SetN(self: *B, n: int) {
        self.n = n
    }

    // Elapsed returns the elapsed time in nanoseconds.
    pub fn Elapsed(self: B) -> int64 {
        return self.elapsed
    }

    // PerOp returns the nanoseconds per operation.
    pub fn PerOp(self: B) -> int64 {
        if self.n <= 0 {
            return self.elapsed // No iterations; return total elapsed
        }
        return self.elapsed / int64(self.n)
    }

    // Report prints the benchmark result in "name\telapsed_ns\titerations\tns/op" format.
    pub fn Report(self: B) {
        nsPerOp := self.PerOp()
        parts := []string{}
        parts = append(parts, self.name)
        parts = append(parts, "\t")
        parts = append(parts, strconv.Itoa(int(self.elapsed)))
        parts = append(parts, " ns\t")
        parts = append(parts, strconv.Itoa(self.n))
        parts = append(parts, " ops\t")
        parts = append(parts, strconv.Itoa(int(nsPerOp)))
        parts = append(parts, " ns/op")
        io.PrintLine(str.Join(parts, ""))
    }
}

// NewB creates a new benchmark with the given name.
pub fn NewB(name: string) -> B {
    return B{name: name, start: int64(0), elapsed: int64(0), n: 1}
}

// Run executes a function n times and reports the benchmark result.
// The function f is called n times, and the total elapsed time is measured.
pub fn Run(name: string, n: int, f: fn()) {
    b := NewB(name)
    b.SetN(n)
    b.StartTimer()
    i := 0
    for i < n {
        f()
        i = i + 1
    }
    b.StopTimer()
    b.Report()
}
