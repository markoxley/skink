// TestFuzzYAMLMalformed takes valid YAML and flips random bytes.
pub fn TestFuzzYAMLMalformed() {
    validYAMLs := []string{
        "key: value\nnum: 42\nlist:\n  - a\n  - b\n",
        "name: test\nnested:\n  inner: yes\n  deep:\n    deeper: ok\n",
        "items:\n  - name: foo\n    value: 1\n  - name: bar\n    value: 2\n",
    }
    for i := 0; i < fuzzIterations; i = i + 1 {
        base := validYAMLs[i % 3]
        flips := rand.Intn(10) + 1
        input := genMalformed(base, flips)
        _, err := yaml.Unmarshal(input)
        if err.message != "" {
            // Expected for malformed input.
        }
        
        libc.free(input)
    }
}

// TestFuzzCSVRandom feeds random byte strings to csv.NewReader.Read.
pub fn TestFuzzCSVRandom() {
    for i := 0; i < fuzzIterations; i = i + 1 {
        n := rand.Intn(256)
        input := genRandomString(n)
        r := csv.NewReader(input)
        for {
            _, err := r.Read()
            if err.message != "" {
                break
            }
            
        }
        libc.free(input)
    }
}

// TestFuzzCSVStructured feeds CSV data with random quoting and escaping.
pub fn TestFuzzCSVStructured() {
    for i := 0; i < fuzzIterations; i = i + 1 {
        rows := rand.Intn(20) + 1
        cols := rand.Intn(10) + 1
        input := genCSVWithQuotes(rows, cols)
        r := csv.NewReader(input)
        for {
            _, err := r.Read()
            if err.message != "" {
                break
            }
            
        }
        libc.free(input)
    }
}

// TestFuzzCSVUnclosedQuote feeds CSV with unclosed quotes.
pub fn TestFuzzCSVUnclosedQuote() {
    inputs := []string{
        "\"unclosed quote\n",
        "\"field1\",\"unclosed\n",
        "a,b,\"c,d,e",
    }
    for i := 0; i < len(inputs); i = i + 1 {
        r := csv.NewReader(inputs[i])
        _, err := r.Read()
        if err.message == "" {
            // Some parsers might accept this; that's OK too.
        }
        
    }
}

// TestFuzzRegexRandom compiles random regex patterns and matches them.
pub fn TestFuzzRegexRandom() {
    for i := 0; i < fuzzIterations; i = i + 1 {
        patLen := rand.Intn(20) + 1
        pattern := genRandomRegex(patLen)
        r, err := regex.Compile(pattern)
        if err.message == "" {
            textLen := rand.Intn(100)
            text := genRandomString(textLen)
            r.Match(text)
            r.MatchString(text)
            r.Find(text)
            r.FindAll(text)
            libc.free(text)
            r.Free()
        }
        libc.free(pattern)
    }
}

// TestFuzzRegexPathological feeds patterns that could cause exponential
// backtracking in naive regex engines. We use short text to avoid hanging.
pub fn TestFuzzRegexPathological() {
    patterns := []string{
        "(a+)+b",
        "(a|a)*b",
        "((((((((((a))))))))))",
    }
    // Keep text short (<= 20 chars) to avoid catastrophic backtracking.
    texts := []string{
        "aaaaaaaaaa",
        "aaaaaaaaaab",
        "",
        "a",
    }
    for i := 0; i < len(patterns); i = i + 1 {
        r, err := regex.Compile(patterns[i])
        if err.message != "" {
            continue
        }
        for j := 0; j < len(texts); j = j + 1 {
            r.Match(texts[j])
        }
        r.Free()
    }
}

// TestFuzzRegexMalformed compiles malformed regex patterns.
pub fn TestFuzzRegexMalformed() {
    patterns := []string{
        "(",
        ")",
        "[",
        "]",
        "*",
        "+abc",
        "\\",
        "[a-",
        "(((",
        ")))",
        "a{",
        "a{2,",
    }
    for i := 0; i < len(patterns); i = i + 1 {
        _, err := regex.Compile(patterns[i])
        if err.message == "" {
            // Some malformed patterns may compile; no crash is what matters.
        }
    }
}

// TestFuzzAllParsersEmpty feeds empty strings to all parsers.
pub fn TestFuzzAllParsersEmpty() {
    _, e1 := json.Unmarshal("")
    if e1.message == "" {
        // Empty string may or may not be valid; no crash is what matters.
    }
    
    _, e2 := xml.Unmarshal("")
    if e2.message == "" {
        // Same as above.
    }
    
    _, e3 := yaml.Unmarshal("")
    if e3.message == "" {
        // Same as above.
    }
    
    r := csv.NewReader("")
    _, e4 := r.Read()
    if e4.message == "" {
        // Same as above.
    }
    
}

// TestFuzzAllParsersLarge feeds a large random document to each parser.
pub fn TestFuzzAllParsersLarge() {
    input := genRandomString(4096)
    _, e1 := json.Unmarshal(input)
    if e1.message == "" {
        // Random data unlikely to be valid JSON.
    }
    
    _, e2 := xml.Unmarshal(input)
    if e2.message == "" {
        // Random data unlikely to be valid XML.
    }
    
    _, e3 := yaml.Unmarshal(input)
    if e3.message == "" {
        // Random data unlikely to be valid YAML.
    }
    
    r := csv.NewReader(input)
    for {
        _, err := r.Read()
        if err.message != "" {
            break
        }
        
    }
    libc.free(input)
}
