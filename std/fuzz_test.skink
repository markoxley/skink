module fuzz_test

import "std/json"
import "std/xml"
import "std/yaml"
import "std/csv"
import "std/regex"
import "std/rand"
import "std/str"
import "std/libc"
extern fn Skink_mem_write_byte(ptr: string, idx: int64, val: int)
import "testing"

// fuzzIterations is the number of random inputs to generate per parser.
// Kept modest to avoid excessive memory usage during testing.
const fuzzIterations = 100

// genRandomString generates a random string of length n using printable
// ASCII characters (32-126).
fn genRandomString(n: int) -> string {
    if n <= 0 {
        return ""
    }
    buf := libc.malloc(n + 1)
    for i := 0; i < n; i = i + 1 {
        b := rand.Intn(95) + 32
        Skink_mem_write_byte(buf, int64(i), b)
    }
    Skink_mem_write_byte(buf, int64(n), 0)
    return buf
}

// genDeepJSON generates a string with n nested brackets/braces.
fn genDeepJSON(n: int, useBraces: bool) -> string {
    openChar := 91   // '['
    closeChar := 93  // ']'
    if useBraces {
        openChar = 123  // '{'
        closeChar = 125 // '}'
    }
    buf := libc.malloc(n * 2 + 2)
    for i := 0; i < n; i = i + 1 {
        Skink_mem_write_byte(buf, int64(i), openChar)
    }
    Skink_mem_write_byte(buf, int64(n), 48) // '0'
    for i := 0; i < n; i = i + 1 {
        Skink_mem_write_byte(buf, int64(n + 1 + i), closeChar)
    }
    Skink_mem_write_byte(buf, int64(n * 2 + 1), 0)
    return buf
}

// genDeepXML generates deeply nested XML tags.
fn genDeepXML(n: int) -> string {
    total := n * 7 + 1
    buf := libc.malloc(total + 1)
    pos := 0
    for i := 0; i < n; i = i + 1 {
        Skink_mem_write_byte(buf, int64(pos), 60)     // '<'
        Skink_mem_write_byte(buf, int64(pos + 1), 97) // 'a'
        Skink_mem_write_byte(buf, int64(pos + 2), 62) // '>'
        pos = pos + 3
    }
    Skink_mem_write_byte(buf, int64(pos), 120) // 'x'
    pos = pos + 1
    for i := 0; i < n; i = i + 1 {
        Skink_mem_write_byte(buf, int64(pos), 60)      // '<'
        Skink_mem_write_byte(buf, int64(pos + 1), 47)  // '/'
        Skink_mem_write_byte(buf, int64(pos + 2), 97)  // 'a'
        Skink_mem_write_byte(buf, int64(pos + 3), 62)  // '>'
        pos = pos + 4
    }
    Skink_mem_write_byte(buf, int64(pos), 0)
    return buf
}

// genDeepYAML generates deeply nested YAML indentation.
fn genDeepYAML(n: int) -> string {
    total := 0
    for i := 0; i < n; i = i + 1 {
        total = total + i + 5
    }
    total = total + n + 3
    buf := libc.malloc(total + 1)
    pos := 0
    for i := 0; i < n; i = i + 1 {
        for j := 0; j < i; j = j + 1 {
            Skink_mem_write_byte(buf, int64(pos), 32)
            pos = pos + 1
        }
        Skink_mem_write_byte(buf, int64(pos), 107)     // 'k'
        Skink_mem_write_byte(buf, int64(pos + 1), 101) // 'e'
        Skink_mem_write_byte(buf, int64(pos + 2), 121) // 'y'
        Skink_mem_write_byte(buf, int64(pos + 3), 58)  // ':'
        Skink_mem_write_byte(buf, int64(pos + 4), 10)  // '\n'
        pos = pos + 5
    }
    for j := 0; j < n; j = j + 1 {
        Skink_mem_write_byte(buf, int64(pos), 32)
        pos = pos + 1
    }
    Skink_mem_write_byte(buf, int64(pos), 118)     // 'v'
    Skink_mem_write_byte(buf, int64(pos + 1), 97)  // 'a'
    Skink_mem_write_byte(buf, int64(pos + 2), 108) // 'l'
    pos = pos + 3
    Skink_mem_write_byte(buf, int64(pos), 0)
    return buf
}

// genMalformed takes a valid string and flips random bytes.
fn genMalformed(base: string, flips: int) -> string {
    n := str.Len(base)
    if n == 0 {
        return ""
    }
    buf := libc.malloc(n + 1)
    libc.memcpy(buf, base, n)
    Skink_mem_write_byte(buf, int64(n), 0)
    for i := 0; i < flips; i = i + 1 {
        pos := rand.Intn(n)
        Skink_mem_write_byte(buf, int64(pos), rand.Intn(128))
    }
    return buf
}

// genCSVWithQuotes generates CSV data with random quoting and escaping.
fn genCSVWithQuotes(rows: int, cols: int) -> string {
    // Worst case per field: 2 (surrounding quotes) + 19*2 (doubled quotes) = 40 bytes.
    // Plus comma separator (1) and newline (1) per row.
    maxLen := rows * (cols * 42 + 1) + 1
    buf := libc.malloc(maxLen + 1)
    pos := 0
    for r := 0; r < rows; r = r + 1 {
        for c := 0; c < cols; c = c + 1 {
            if c > 0 {
                Skink_mem_write_byte(buf, int64(pos), 44) // ','
                pos = pos + 1
            }
            if rand.Intn(3) == 0 {
                Skink_mem_write_byte(buf, int64(pos), 34) // '"'
                pos = pos + 1
                fieldLen := rand.Intn(20)
                for k := 0; k < fieldLen; k = k + 1 {
                    ch := rand.Intn(128)
                    if ch == 34 {
                        Skink_mem_write_byte(buf, int64(pos), 34)
                        Skink_mem_write_byte(buf, int64(pos + 1), 34)
                        pos = pos + 2
                    } else {
                        Skink_mem_write_byte(buf, int64(pos), ch)
                        pos = pos + 1
                    }
                }
                Skink_mem_write_byte(buf, int64(pos), 34) // '"'
                pos = pos + 1
            } else {
                fieldLen := rand.Intn(20)
                for k := 0; k < fieldLen; k = k + 1 {
                    ch := rand.Intn(128)
                    if ch != 44 && ch != 10 && ch != 13 && ch != 34 {
                        Skink_mem_write_byte(buf, int64(pos), ch)
                        pos = pos + 1
                    }
                }
            }
        }
        Skink_mem_write_byte(buf, int64(pos), 10) // '\n'
        pos = pos + 1
    }
    Skink_mem_write_byte(buf, int64(pos), 0)
    return buf
}

// genRandomRegex generates a random regex pattern from safe characters.
fn genRandomRegex(n: int) -> string {
    buf := libc.malloc(n + 1)
    chars := "abcdefghij0123456789.*+?()[]"
    clen := str.Len(chars)
    for i := 0; i < n; i = i + 1 {
        Skink_mem_write_byte(buf, int64(i), int(chars[rand.Intn(clen)]))
    }
    Skink_mem_write_byte(buf, int64(n), 0)
    return buf
}

// === Fuzz Tests ===

// TestFuzzJSONRandom feeds random byte strings to json.Unmarshal.
pub fn TestFuzzJSONRandom() {
    for i := 0; i < fuzzIterations; i = i + 1 {
        n := rand.Intn(256)
        input := genRandomString(n)
        _, err := json.Unmarshal(input)
        if err.message != "" {
            // Expected for random input; just verifying no crash.
        }
        
        libc.free(input)
    }
}

// TestFuzzJSONDeepNesting feeds deeply nested JSON to verify the depth
// limit prevents stack overflow.
pub fn TestFuzzJSONDeepNesting() {
    input := genDeepJSON(2000, true)
    _, err := json.Unmarshal(input)
    if err.message == "" {
        Errorf("Deeply nested JSON (2000 braces) should fail")
    }
    
    libc.free(input)

    input = genDeepJSON(2000, false)
    _, err = json.Unmarshal(input)
    if err.message == "" {
        Errorf("Deeply nested JSON (2000 brackets) should fail")
    }
    
    libc.free(input)

    // Just under the depth limit (999) should parse without error.
    input = genDeepJSON(999, false)
    _, err = json.Unmarshal(input)
    if err.message != "" {
        // May or may not error depending on parser strictness; no crash is what matters.
    }
    
    libc.free(input)
}

// TestFuzzJSONMalformed takes valid JSON and flips random bytes.
pub fn TestFuzzJSONMalformed() {
    validJSONs := []string{
        "{\"key\": \"value\", \"num\": 42, \"arr\": [1, 2, 3]}",
        "[true, false, null, 3.14, \"hello\"]",
        "{\"nested\": {\"a\": {\"b\": {\"c\": 1}}}}",
    }
    for i := 0; i < fuzzIterations; i = i + 1 {
        base := validJSONs[i % 3]
        flips := rand.Intn(10) + 1
        input := genMalformed(base, flips)
        _, err := json.Unmarshal(input)
        if err.message != "" {
            // Expected for malformed input; just verifying no crash.
        }
        
        libc.free(input)
    }
}

// TestFuzzJSONTruncated feeds truncated JSON at various positions.
pub fn TestFuzzJSONTruncated() {
    base := "{\"key\": \"value\", \"num\": 42, \"arr\": [1, 2, 3]}"
    n := str.Len(base)
    for i := 1; i < n; i = i + 1 {
        input := str.Substr(base, 0, i)
        _, err := json.Unmarshal(input)
        if err.message != "" {
            // Expected for truncated input.
        }
        
    }
}

