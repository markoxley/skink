// TestFuzzXMLDeepNesting feeds deeply nested XML to verify the depth limit.
pub fn TestFuzzXMLDeepNesting() {
    input := genDeepXML(2000)
    _, err := xml.Unmarshal(input)
    if err.message == "" {
        Errorf("Deeply nested XML (2000 levels) should fail")
    }
    
    libc.free(input)

    input = genDeepXML(999)
    _, err = xml.Unmarshal(input)
    if err.message != "" {
        // May error; no crash is what matters.
    }
    
    libc.free(input)
}

// TestFuzzXMLMalformed takes valid XML and flips random bytes.
pub fn TestFuzzXMLMalformed() {
    validXMLs := []string{
        "<root><child>text</child></root>",
        "<a x=\"1\" y=\"2\"><b/></a>",
        "<doc><item id=\"1\">hello</item><item id=\"2\">world</item></doc>",
    }
    for i := 0; i < fuzzIterations; i = i + 1 {
        base := validXMLs[i % 3]
        flips := rand.Intn(10) + 1
        input := genMalformed(base, flips)
        _, err := xml.Unmarshal(input)
        if err.message != "" {
            // Expected for malformed input.
        }
        
        libc.free(input)
    }
}

// TestFuzzXMLTruncated feeds truncated XML at various positions.
pub fn TestFuzzXMLTruncated() {
    base := "<root><child>text</child><sibling attr=\"val\"/></root>"
    n := str.Len(base)
    for i := 1; i < n; i = i + 1 {
        input := str.Substr(base, 0, i)
        _, err := xml.Unmarshal(input)
        if err.message != "" {
            // Expected for truncated input.
        }
        
    }
}

