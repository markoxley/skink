module i2c

import "std/errors"
import "std/libc"

// Bus represents an I2C bus connection to a single slave device.
//
//   - fd:         the kernel file descriptor for /dev/i2c-N (0 when closed).
//   - deviceAddr: the 7-bit slave address selected via I2C_SLAVE.
pub struct Bus {
    fd: int
    deviceAddr: int

    // Write sends len bytes of data to the currently selected slave.
    //
    // Backend behavior:
    //   - write(self.fd, data, len) returns the number of bytes written.
    //
    // The stub returns len unconditionally. A real backend should return the
    // byte count from write() (which may be less than len on a short write).
    pub fn Write(self: *Bus, data: string, len: int) -> int {
        // Real implementation: return write(self.fd, data, len)
        return len
    }

    // Read receives up to len bytes from the currently selected slave.
    //
    // Backend behavior:
    //   - buf := libc.malloc(len + 1)
    //   - n := read(self.fd, buf, len)
    //   - buf[n] = 0  (NUL terminator)
    //
    // The returned string is heap-allocated and must be freed with libc.free.
    // The stub fills nothing but still allocates a NUL-terminated buffer so
    // callers can exercise the ownership contract without hardware.
    pub fn Read(self: *Bus, len: int) -> (string, errors.Error) {
        buf := libc.malloc(len + 1)
        // Real implementation: n := read(self.fd, buf, len)
        buf[len] = 0
        return buf, errors.New("")
    }

    // WriteReg writes a single byte value to an 8-bit device register.
    //
    // Backend behavior:
    //   - ioctl(self.fd, I2C_SMBUS, &{write, reg, I2C_SMBUS_BYTE_DATA, val}).
    //
    // The stub returns a nil error. A real backend should return a non-empty
    // error when the ioctl fails (e.g. ACK missing from the slave).
    pub fn WriteReg(self: *Bus, reg: int, val: int) -> errors.Error {
        // Real implementation: i2c_smbus_write_byte_data(self.fd, reg, val)
        return errors.New("")
    }

    // ReadReg reads a single byte from an 8-bit device register.
    //
    // Backend behavior:
    //   - ioctl(self.fd, I2C_SMBUS, &{read, reg, I2C_SMBUS_BYTE_DATA}).
    //
    // The stub returns (0, nil). A real backend should return the byte read
    // (0..255) or a non-empty error when the ioctl fails.
    pub fn ReadReg(self: *Bus, reg: int) -> (int, errors.Error) {
        // Real implementation: return i2c_smbus_read_byte_data(self.fd, reg)
        return 0, errors.New("")
    }

    // WriteRegister is an alias for WriteReg, matching the book's
    // bus.WriteRegister(reg, val) usage.
    pub fn WriteRegister(self: *Bus, reg: int, val: int) -> errors.Error {
        return self.WriteReg(reg, val)
    }

    // ReadRegister is an alias for ReadReg.
    pub fn ReadRegister(self: *Bus, reg: int) -> (int, errors.Error) {
        return self.ReadReg(reg)
    }

    // Close releases the bus file descriptor. It is idempotent: calling Close
    // on an already-closed Bus returns a nil error and does nothing.
    //
    // Backend behavior:
    //   - close(self.fd) when fd != 0.
    pub fn Close(self: *Bus) -> errors.Error {
        if self.fd != 0 {
            // Real implementation: close(self.fd)
            self.fd = 0
        }
        return errors.New("")
    }

    // Address returns the 7-bit slave address this Bus was opened for.
    pub fn Address(self: Bus) -> int {
        return self.deviceAddr
    }

    // Fd returns the underlying kernel file descriptor, or 0 when closed.
    pub fn Fd(self: Bus) -> int {
        return self.fd
    }
}

// Open opens I2C bus busNumber and selects the slave at deviceAddr.
//
// Backend behavior:
//   - fd := open("/dev/i2c-{busNumber}", O_RDWR)
//   - ioctl(fd, I2C_SLAVE, deviceAddr)
//
// The stub returns a Bus with a non-zero fake fd so callers can exercise the
// API without hardware. A real backend should return fd <= 0 with a non-empty
// error when the device node cannot be opened or the address is out of range.
pub fn Open(busNumber: int, deviceAddr: int) -> (Bus, errors.Error) {
    // Real implementation: open("/dev/i2c-N", O_RDWR) + ioctl(fd, I2C_SLAVE, addr)
    return Bus{fd: 1, deviceAddr: deviceAddr}, errors.New("")
}

// Standard I2C clock speeds (Hz), for documentation and future SetSpeed support.
pub const SPEED_STANDARD = 100000   // 100 kHz
pub const SPEED_FAST = 400000       // 400 kHz
pub const SPEED_FAST_PLUS = 1000000 // 1 MHz

// I2C_SMBUS ioctl sub-commands for reference (values from <linux/i2c.h>).
pub const SMBUS_READ_BYTE = 1
pub const SMBUS_READ_BYTE_DATA = 2
pub const SMBUS_WRITE_BYTE_DATA = 3
pub const SMBUS_READ_WORD_DATA = 4
pub const SMBUS_WRITE_WORD_DATA = 5
