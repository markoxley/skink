module graph_sp_test

import "testing"
import "std/graph"
import "std/str"

// TestShortestPathDirect verifies direct edge shortest path.
pub fn TestShortestPathDirect() {
    g := graph.New()
    g.AddEdge("A", "B", 1.0)
    path, dist := g.ShortestPath("A", "B")
    testing.AssertEqualInt(2, len(path), "path length")
    testing.AssertEqualFloat(1.0, dist, "direct distance")
    testing.AssertEqualString("A", path[0], "path start")
    testing.AssertEqualString("B", path[1], "path end")
}

// TestShortestPathVia verifies shortest path picks cheaper route.
pub fn TestShortestPathVia() {
    g := graph.New()
    g.AddEdge("A", "C", 10.0)
    g.AddEdge("A", "B", 1.0)
    g.AddEdge("B", "C", 2.0)
    path, dist := g.ShortestPath("A", "C")
    testing.AssertEqualFloat(3.0, dist, "via B is cheaper")
    testing.AssertEqualInt(3, len(path), "path via B")
}

// TestShortestPathNoRoute verifies no route returns empty path.
pub fn TestShortestPathNoRoute() {
    g := graph.New()
    g.AddNode("X")
    g.AddNode("Y")
    path, dist := g.ShortestPath("X", "Y")
    testing.AssertEqualInt(0, len(path), "no route -> empty path")
    testing.AssertEqualFloat(0.0, dist, "no route -> 0")
}
